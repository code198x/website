{
	"name": "Code Like It's 198x - Retro Development Environment",
	"dockerComposeFile": "../docker-compose.yml",
	"service": "dev-workspace",
	"workspaceFolder": "/workspace",
	"shutdownAction": "stopCompose",

	// Configure tool-specific properties
	"customizations": {
		"vscode": {
			// Extensions to install
			"extensions": [
				// Assembly language support
				"13xforever.language-x86-64-assembly",
				"ms-vscode.cpptools",
				"davidanson.vscode-markdownlint",
				
				// Development tools
				"ms-vscode.makefile-tools",
				"eamodio.gitlens",
				"streetsidesoftware.code-spell-checker",
				
				// File support
				"ms-vscode.hexeditor",
				"redhat.vscode-yaml",
				
				// Themes and UI
				"github.github-vscode-theme",
				"vscode-icons-team.vscode-icons"
			],

			// VS Code settings
			"settings": {
				// Assembly file associations
				"files.associations": {
					"*.asm": "asm-intel-x86-generic",
					"*.s": "asm-intel-x86-generic", 
					"*.inc": "asm-intel-x86-generic",
					"*.cfg": "ini",
					"*.chr": "binary",
					"*.prg": "binary",
					"*.d64": "binary",
					"*.tap": "binary",
					"*.tzx": "binary",
					"*.nes": "binary",
					"*.adf": "binary"
				},

				// Editor settings for assembly
				"editor.tabSize": 4,
				"editor.insertSpaces": false,
				"editor.detectIndentation": false,
				"editor.rulers": [80],
				"editor.wordWrap": "off",
				"editor.fontFamily": "'Fira Code', 'Courier New', monospace",
				"editor.fontLigatures": true,
				"editor.fontSize": 14,

				// Assembly-specific formatting
				"[asm-intel-x86-generic]": {
					"editor.tabSize": 8,
					"editor.insertSpaces": false,
					"editor.wordBasedSuggestions": false,
					"editor.quickSuggestions": {
						"other": false,
						"comments": false,
						"strings": false
					}
				},

				// Terminal
				"terminal.integrated.defaultProfile.linux": "bash",
				"terminal.integrated.cwd": "/workspace",

				// File explorer
				"explorer.fileNesting.enabled": true,
				"explorer.fileNesting.patterns": {
					"*.asm": "${capture}.prg,${capture}.d64,${capture}.tap,${capture}.lst,${capture}.sym,${capture}.report.json",
					"*.s": "${capture},${capture}.adf,${capture}.lst,${capture}.report.json"
				},

				// Git
				"git.enableSmartCommit": true,
				"git.confirmSync": false,

				// Workbench
				"workbench.colorTheme": "GitHub Dark Default",
				"workbench.iconTheme": "vscode-icons",
				"workbench.startupEditor": "readme",

				// Spell checker
				"cSpell.words": [
					"ACME",
					"VASM",
					"SjASMPlus", 
					"NESASM",
					"Commodore",
					"Amiga",
					"Spectrum",
					"KERNAL",
					"PETSCII",
					"CHROUT",
					"assembler",
					"bitplane",
					"raster",
					"sprite",
					"blitter",
					"copper",
					"nametable",
					"charset"
				]
			}
		}
	},

	// Forward ports for potential web interfaces
	"forwardPorts": [3000, 8080],

	// Post-create command to set up the environment
	"postCreateCommand": "/workspace/setup.sh && echo '🕹️ Welcome to Code Like It\\'s 198x!' && tool-info",

	// Features to add to the dev container
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Mount the Docker socket for container access
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],

	// Set the user to avoid permission issues
	"remoteUser": "root",

	// Environment variables
	"remoteEnv": {
		"PATH": "/workspace/bin:${PATH}"
	}
}