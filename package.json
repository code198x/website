{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-vault-imagery.mjs && astro build && node scripts/mark-redirects-noindex.mjs && ([ -f ./tools/pagefind/pagefind ] && PAGEFIND_BINARY_PATH=./tools/pagefind/pagefind npx pagefind --site dist || npx pagefind --site dist)",
    "check:imagery": "node scripts/check-vault-imagery.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:a11y:sweep": "npm run build && A11Y_SWEEP=1 playwright test tests/a11y-sweep.spec.ts --project=desktop",
    "prose:sync": "mkdir -p .vale && vale sync",
    "prose:style": "vale src/content/curriculum src/content/vault",
    "prose:read": "node scripts/prose-report.mjs",
    "prose:check": "npm run prose:style && npm run prose:read",
    "surfaces:gaps": "node scripts/support-gaps.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.31.0",
    "astro": "^7.2.1",
    "leaflet": "^1.9.4",
    "shiki-highlight-api": "^1.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
