{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "scripts": {
    "ui:fetch": "./scripts/fetch-ui.sh",
    "predev": "npm run ui:fetch && node scripts/check-browser-player.mjs",
    "prebuild": "npm run ui:fetch",
    "dev": "astro dev",
    "build": "astro build && node scripts/mark-redirects-noindex.mjs && python3 scripts/check-page-frames.py && ([ -f ./tools/pagefind/pagefind ] && PAGEFIND_BINARY_PATH=./tools/pagefind/pagefind npx pagefind --site dist || npx pagefind --site dist)",
    "build:wasm": "node scripts/build-wasm.mjs",
    "postinstall": "node scripts/fetch-pagefind.mjs",
    "check:imagery": "node scripts/check-vault-imagery.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:a11y:sweep": "npm run build && A11Y_SWEEP=1 playwright test tests/a11y-sweep.spec.ts --project=desktop",
    "prose:sync": "mkdir -p .vale && vale sync",
    "prose:style": "vale src/content/curriculum src/content/vault",
    "prose:read": "node scripts/prose-report.mjs",
    "prose:check": "npm run prose:style && npm run prose:read",
    "surfaces:gaps": "node scripts/support-gaps.mjs",
    "check:platforms": "node scripts/check-vault-platform-balance.mjs",
    "check:links": "node scripts/check-vault-links.mjs",
    "check:sources": "node scripts/check-vault-sources.mjs",
    "check:prose-dates": "node scripts/check-vault-frontmatter-vs-prose.mjs",
    "check:dates": "node scripts/check-vault-dates.mjs",
    "check:duplicates": "node scripts/find-vault-duplicates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:player": "node scripts/build-browser-player.mjs",
    "build:nes-assembler": "node scripts/build-nes-assembler.mjs",
    "check:content": "node scripts/check-template-whitespace.mjs && node scripts/check-curriculum-routes.mjs && node scripts/check-vault-imagery.mjs && node scripts/check-vault-platform-balance.mjs && node scripts/check-vault-links.mjs",
    "check": "vitest run && npm run check:content && node scripts/check-nes-assembler.mjs && node scripts/check-browser-player.mjs",
    "check:release": "bash scripts/check-release.sh"
  },
  "dependencies": {
    "@asm198x/z80": "^0.3.0",
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@emu198x/zx-spectrum": "0.4.2",
    "@lucide/astro": "^1.31.0",
    "astro": "^7.2.9",
    "leaflet": "^1.9.4",
    "shiki-highlight-api": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "js-yaml": "^4.3.2",
    "pagefind": "^1.5.2",
    "vitest": "^4.1.11"
  }
}
