{
  "name": "new-code198x",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-vault-data.mjs",
    "build": "astro build",
    "build:analyze": "npm run build && npm run analyze:bundle",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-vault-data": "node scripts/generate-vault-data.mjs",
    "create-lesson": "node scripts/create-lesson.mjs",
    "create-tier": "node scripts/create-tier-lessons.mjs",
    "prepare-code": "node scripts/prepare-code-samples.mjs",
    "verify-code": "node scripts/verify-code-samples.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "analyze:size": "bundlesize",
    "analyze:performance": "node scripts/performance-report.mjs",
    "lighthouse": "lhci collect && lhci assert",
    "lighthouse:report": "lhci collect --config=lighthouserc.json",
    "performance:full": "npm run build && npm run analyze:bundle && npm run lighthouse",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:visual": "playwright test",
    "test:visual:headed": "playwright test --headed",
    "test:visual:debug": "playwright test --debug",
    "test:visual:report": "playwright show-report",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:chromium": "playwright test --project=chromium tests/visual",
    "test:visual:firefox": "playwright test --project=firefox tests/visual",
    "test:visual:webkit": "playwright test --project=webkit tests/visual",
    "test:a11y": "playwright test tests/accessibility",
    "test:a11y:headed": "playwright test tests/accessibility --headed",
    "test:a11y:debug": "playwright test tests/accessibility --debug",
    "test:a11y:report": "playwright show-report --reporter=html",
    "test:a11y:chromium": "playwright test --project=chromium tests/accessibility",
    "test:a11y:firefox": "playwright test --project=firefox tests/accessibility",
    "test:a11y:webkit": "playwright test --project=webkit tests/accessibility",
    "test:all": "npm run test:run && npm run test:visual && npm run test:a11y"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.5",
    "@astrojs/prism": "^3.3.0",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.13.8",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "bundlesize": "^0.18.2",
    "cssnano": "^7.1.1",
    "happy-dom": "^18.0.1",
    "jsdom": "^27.0.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "bundlesize": [
    {
      "path": "./dist/_astro/*.js",
      "maxSize": "200 kB",
      "compression": "gzip"
    },
    {
      "path": "./dist/_astro/*.css",
      "maxSize": "50 kB",
      "compression": "gzip"
    }
  ]
}
