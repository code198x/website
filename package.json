{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "scripts": {
    "ui:fetch": "./scripts/fetch-ui.sh",
    "predev": "npm run ui:fetch && npm run bundles && node scripts/check-browser-player.mjs",
    "prebuild": "npm run ui:fetch && npm run bundles",
    "dev": "astro dev",
    "build": "astro build && node scripts/check-game-studies.mjs && node scripts/mark-redirects-noindex.mjs && python3 scripts/check-page-frames.py && ([ -f ./tools/pagefind/pagefind ] && PAGEFIND_BINARY_PATH=./tools/pagefind/pagefind npx pagefind --site dist || npx pagefind --site dist)",
    "postinstall": "node scripts/fetch-pagefind.mjs",
    "check:imagery": "node scripts/check-vault-imagery.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:a11y:sweep": "npm run build && A11Y_SWEEP=1 playwright test tests/a11y-sweep.spec.ts --project=desktop",
    "prose:sync": "mkdir -p .vale && vale sync",
    "prose:style": "vale src/content/curriculum src/content/vault",
    "prose:read": "node scripts/prose-report.mjs",
    "prose:check": "npm run prose:style && npm run prose:read",
    "surfaces:gaps": "node scripts/support-gaps.mjs",
    "check:platforms": "node scripts/check-vault-platform-balance.mjs",
    "check:links": "node scripts/check-vault-links.mjs",
    "check:sources": "node scripts/check-vault-sources.mjs",
    "check:prose-dates": "node scripts/check-vault-frontmatter-vs-prose.mjs",
    "check:dates": "node scripts/check-vault-dates.mjs",
    "check:duplicates": "node scripts/find-vault-duplicates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:content": "node scripts/check-template-whitespace.mjs && node scripts/check-curriculum-routes.mjs && node scripts/check-vault-imagery.mjs && node scripts/check-vault-platform-balance.mjs && node scripts/check-vault-links.mjs",
    "check": "npm run bundles && vitest run && npm run check:types && npm run check:content && node scripts/check-nes-assembler.mjs && node scripts/check-browser-player.mjs",
    "check:types": "node --test scripts/type-baseline-keys.test.mjs && node scripts/check-types.mjs",
    "check:release": "bash scripts/check-release.sh",
    "css:routes": "node scripts/css-routes.mjs",
    "css:snapshot": "node scripts/css-snapshot.mjs",
    "css:diff": "node scripts/css-diff.mjs",
    "css:coverage": "node scripts/css-coverage.mjs",
    "css:size": "node scripts/css-size.mjs",
    "workbook:build": "node scripts/regenerate-first-workbook.mjs",
    "bundles": "node scripts/stage-bundles.mjs"
  },
  "dependencies": {
    "@asm198x/mos6502": "0.4.0",
    "@asm198x/z80": "0.4.0",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@emu198x/player": "0.39.0",
    "@emu198x/zx-spectrum": "0.7.0",
    "@lang198x/amos": "0.3.0",
    "@lucide/astro": "^1.59.0",
    "@play198x/web": "0.3.0",
    "astro": "^7.4.0",
    "leaflet": "^1.9.4",
    "shiki-highlight-api": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "js-yaml": "^5.5.0",
    "pagefind": "^1.5.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
