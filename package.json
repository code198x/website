{
  "name": "new-code198x",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:prose": "vale 'src/content/**/*.md'",
    "lint:prose:summary": "vale --output=line 'src/content/**/*.md'",
    "lint:prose:json": "vale --output=JSON 'src/content/**/*.md'",
    "lint:prose:fix": "vale sync && vale 'src/content/**/*.md'",
    "prose:check": "vale 'src/content/**/*.md' --minAlertLevel=warning",
    "prose:suggestions": "vale 'src/content/**/*.md' --minAlertLevel=suggestion"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^3.1.8",
    "@astrojs/rss": "^4.0.9",
    "astro": "^4.16.12",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "vale": "^3.7.1"
  }
}
