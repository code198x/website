{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "overrides": {
    "yauzl": "^3.2.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/mark-redirects-noindex.mjs && ([ -f ./tools/pagefind/pagefind ] && PAGEFIND_BINARY_PATH=./tools/pagefind/pagefind npx pagefind --site dist || npx pagefind --site dist)",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "prose:sync": "mkdir -p .vale && vale sync",
    "prose:style": "vale src/content/curriculum src/content/vault",
    "prose:read": "node scripts/prose-report.mjs",
    "prose:check": "npm run prose:style; npm run prose:read",
    "surfaces:gaps": "node scripts/support-gaps.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.2",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/pixelarticons": "^1.2.4",
    "@lucide/astro": "^1.22.0",
    "astro": "^7.1.3",
    "astro-icon": "^1.1.5",
    "leaflet": "^1.9.4",
    "shiki-highlight-api": "^1.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "pagefind": "^1.5.2"
  },
  "optionalDependencies": {
    "@pagefind/darwin-arm64": "^1.5.2"
  }
}
