{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "overrides": {
    "yauzl": "^3.2.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && ([ -f ./tools/pagefind/pagefind ] && PAGEFIND_BINARY_PATH=./tools/pagefind/pagefind npx pagefind --site dist || npx pagefind --site dist)",
    "preview": "astro preview",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:lh": "npm run build && lhci autorun",
    "prose:sync": "mkdir -p .vale && vale sync",
    "prose:style": "vale src/content/curriculum src/content/vault",
    "prose:read": "node scripts/prose-report.mjs",
    "prose:check": "npm run prose:style; npm run prose:read"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/pixelarticons": "^1.2.4",
    "@lucide/astro": "^0.577.0",
    "astro": "^6.0.4",
    "astro-icon": "^1.1.5",
    "leaflet": "^1.9.4",
    "remark-gfm": "^4.0.1",
    "remark-shiki-highlight-api": "^0.4.1",
    "shiki-highlight-api": "^1.1.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "pagefind": "^1.4.0"
  },
  "optionalDependencies": {
    "@pagefind/darwin-arm64": "^1.4.0"
  }
}
