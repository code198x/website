{
    // Assembly language configuration
    "files.associations": {
        "*.asm": "asm-intel-x86-generic",
        "*.s": "asm-intel-x86-generic",
        "*.inc": "asm-intel-x86-generic",
        "*.cfg": "ini",
        "*.chr": "binary",
        "*.prg": "binary", 
        "*.d64": "binary",
        "*.tap": "binary",
        "*.tzx": "binary",
        "*.sna": "binary",
        "*.nes": "binary",
        "*.adf": "binary"
    },

    // Code formatting for assembly
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.rulers": [40, 80],
    "editor.wordWrap": "off",
    
    // Assembly-specific settings
    "[asm-intel-x86-generic]": {
        "editor.tabSize": 8,
        "editor.insertSpaces": false,
        "editor.wordBasedSuggestions": false,
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
        },
        "editor.suggest.showWords": false
    },

    // File nesting for clean project view
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.asm": "${capture}.prg,${capture}.d64,${capture}.tap,${capture}.lst,${capture}.sym,${capture}.report.json",
        "*.s": "${capture},${capture}.adf,${capture}.lst,${capture}.report.json",
        "Makefile": "docker-compose.yml,Dockerfile*,.dockerignore",
        "README.md": "LICENSE,CONTRIBUTING.md,.gitignore"
    },

    // Spell checking for comments
    "cSpell.enabled": true,
    "cSpell.words": [
        "ACME", "VASM", "SjASMPlus", "NESASM", "Pasmo",
        "Commodore", "Amiga", "Spectrum", "Nintendo",
        "KERNAL", "PETSCII", "CHROUT", "BASIC",
        "assembler", "bitplane", "raster", "sprite", 
        "blitter", "copper", "nametable", "charset",
        "PPUCTRL", "PPUMASK", "PPUADDR", "PPUDATA",
        "OAMADDR", "OAMDATA", "OAMDMA",
        "DMACONR", "DMACON", "BLTCON", "BLTSIZE",
        "vblank", "vsync", "hsync", "interlace",
        "workbench", "kickstart", "autoconfig"
    ],

    // Search settings
    "search.exclude": {
        "**/build/**": true,
        "**/*.prg": true,
        "**/*.d64": true,
        "**/*.tap": true,
        "**/*.tzx": true,
        "**/*.sna": true,
        "**/*.nes": true,
        "**/*.adf": true,
        "**/*.chr": true
    },

    // Git settings
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,

    // Terminal settings
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.env.linux": {
        "TERM": "xterm-256color"
    }
}