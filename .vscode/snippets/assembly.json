{
    // Commodore 64 Snippets
    "C64 Basic Program Header": {
        "prefix": "c64-header",
        "body": [
            "; Commodore 64 Assembly Program",
            "; $0",
            "",
            "*=\\$0801             ; BASIC start address",
            "",
            "; BASIC stub: 10 SYS $1",
            ".byte \\$0c,\\$08,\\$0a,\\$00,\\$9e,\\$20,\\$32,\\$30,\\$36,\\$31,\\$00,\\$00,\\$00",
            "",
            "*=\\$080d             ; Start of ML program",
            "",
            "start:",
            "    $2",
            "    rts               ; Return to BASIC"
        ],
        "description": "C64 program header with BASIC stub"
    },

    "C64 KERNAL Output": {
        "prefix": "c64-print",
        "body": [
            "    ldx #0",
            "print_loop:",
            "    lda ${1:message},x",
            "    beq done",
            "    jsr \\$FFD2        ; CHROUT",
            "    inx",
            "    jmp print_loop",
            "done:",
            "    $0"
        ],
        "description": "C64 text output using KERNAL"
    },

    "C64 Sprite Setup": {
        "prefix": "c64-sprite",
        "body": [
            "    lda #${1:1}           ; Enable sprite ${2:0}",
            "    sta \\$D015",
            "    lda #${3:1}           ; Color",
            "    sta \\$D027+${2:0}",
            "    lda #${4:\\$80}        ; Sprite pointer",
            "    sta \\$07F8+${2:0}",
            "    $0"
        ],
        "description": "C64 sprite initialization"
    },

    // ZX Spectrum Snippets
    "Spectrum Program Header": {
        "prefix": "spectrum-header",
        "body": [
            "; ZX Spectrum Assembly Program",
            "; $0",
            "",
            "    org 32768         ; Standard address",
            "",
            "start:",
            "    $1",
            "    ret               ; Return to BASIC",
            "",
            "    end start"
        ],
        "description": "ZX Spectrum program header"
    },

    "Spectrum Screen Pixel": {
        "prefix": "spectrum-pixel",
        "body": [
            "    ; Calculate screen address for Y=${1:row}, X=${2:col}",
            "    ld a,${1:row}",
            "    and 7",
            "    add a,\\$40",
            "    ld h,a",
            "    ld a,${1:row}",
            "    rrca",
            "    rrca",
            "    rrca",
            "    and \\$e0",
            "    add a,${2:col}",
            "    ld l,a",
            "    $0"
        ],
        "description": "ZX Spectrum screen address calculation"
    },

    "Spectrum Border Color": {
        "prefix": "spectrum-border",
        "body": [
            "    ld a,${1:color}       ; 0-7",
            "    out (254),a           ; Set border",
            "    $0"
        ],
        "description": "ZX Spectrum border color"
    },

    // NES Snippets
    "NES Program Header": {
        "prefix": "nes-header",
        "body": [
            "; Nintendo Entertainment System Program",
            "; $0",
            "",
            ".segment \"HEADER\"",
            "    .byte \"NES\", \\$1a     ; iNES header",
            "    .byte ${1:2}              ; PRG-ROM banks",
            "    .byte ${2:1}              ; CHR-ROM banks", 
            "    .byte \\$00, \\$00        ; Mapper 0",
            "    .byte 0,0,0,0,0,0,0     ; Filler",
            "",
            ".segment \"CODE\"",
            "",
            "reset:",
            "    $3"
        ],
        "description": "NES program header with iNES header"
    },

    "NES PPU Setup": {
        "prefix": "nes-ppu",
        "body": [
            "    ; Load palette",
            "    lda \\$2002            ; Reset latch",
            "    lda #\\$3F",
            "    sta \\$2006",
            "    lda #\\$00",
            "    sta \\$2006            ; Palette address \\$3F00",
            "    ",
            "    ldx #\\$00",
            "load_pal:",
            "    lda ${1:palette_data},x",
            "    sta \\$2007",
            "    inx",
            "    cpx #32",
            "    bne load_pal",
            "    $0"
        ],
        "description": "NES PPU palette loading"
    },

    "NES Wait VBlank": {
        "prefix": "nes-vblank",
        "body": [
            "wait_vblank:",
            "    bit \\$2002",
            "    bpl wait_vblank",
            "    $0"
        ],
        "description": "NES wait for vblank"
    },

    // Amiga Snippets
    "Amiga Program Header": {
        "prefix": "amiga-header",
        "body": [
            "; Commodore Amiga Assembly Program",
            "; $0",
            "",
            "; Library offsets",
            "_LVOOpenLibrary     equ -552",
            "_LVOCloseLibrary    equ -414",
            "",
            "_ExecBase           equ 4",
            "",
            "    section code,code",
            "",
            "start:",
            "    movem.l d0-d7/a0-a6,-(sp)",
            "    $1",
            "    movem.l (sp)+,d0-d7/a0-a6",
            "    moveq   #0,d0",
            "    rts",
            "",
            "    end"
        ],
        "description": "Amiga program header with OS compliance"
    },

    "Amiga Open Library": {
        "prefix": "amiga-library",
        "body": [
            "    ; Open ${1:dos.library}",
            "    move.l  _ExecBase,a6",
            "    lea     ${2:dosname}(pc),a1",
            "    moveq   #0,d0",
            "    jsr     _LVOOpenLibrary(a6)",
            "    move.l  d0,${3:dosbase}",
            "    beq.s   .error",
            "    $0"
        ],
        "description": "Amiga library opening pattern"
    },

    "Amiga Blitter Fill": {
        "prefix": "amiga-blit",
        "body": [
            "    ; Wait for blitter",
            "wait_blit:",
            "    btst    #14,\\$DFF002",
            "    bne.s   wait_blit",
            "    ",
            "    ; Set up blitter fill",
            "    move.w  #\\$09F0,\\$DFF040   ; BLTCON0",
            "    move.w  #\\$0000,\\$DFF042   ; BLTCON1",
            "    $0"
        ],
        "description": "Amiga blitter setup"
    },

    // General Assembly Snippets
    "Assembly Comment Header": {
        "prefix": "asm-comment",
        "body": [
            "; ${1:Function/Section Name}",
            "; ${2:Description}",
            ";",
            "; Parameters: ${3:none}",
            "; Returns: ${4:none}",
            "; Destroys: ${5:none}",
            "",
            "$0"
        ],
        "description": "Assembly comment header block"
    },

    "Assembly Loop": {
        "prefix": "asm-loop",
        "body": [
            "    ${1:ldx} #${2:count}",
            "${3:loop}:",
            "    $4",
            "    ${5:dex}",
            "    ${6:bne} ${3:loop}",
            "    $0"
        ],
        "description": "Basic assembly loop structure"
    },

    "Assembly Data Block": {
        "prefix": "asm-data",
        "body": [
            "${1:data_name}:",
            "    ${2:.byte} ${3:values}",
            "    $0"
        ],
        "description": "Assembly data declaration"
    }
}