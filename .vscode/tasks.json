{
  "version": "2.0.0",
  "tasks": [
    // Commodore 64 Tasks
    {
      "label": "🟤 Build C64 PRG",
      "type": "shell",
      "command": "make",
      "args": ["build-c64", "PROJECT=${input:projectName}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\): Error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    },
    {
      "label": "🟤 Build C64 Disk",
      "type": "shell",
      "command": "make",
      "args": ["build-c64-disk", "PROJECT=${input:projectName}"],
      "group": "build"
    },
    {
      "label": "🟤 Create New C64 Project",
      "type": "shell",
      "command": "make",
      "args": ["new-c64", "NAME=${input:newProjectName}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },

    // ZX Spectrum Tasks
    {
      "label": "🌈 Build Spectrum TAP",
      "type": "shell",
      "command": "make",
      "args": ["build-spectrum", "PROJECT=${input:projectName}"],
      "group": "build",
      "problemMatcher": {
        "owner": "sjasmplus",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\): error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    },
    {
      "label": "🌈 Build Spectrum TZX",
      "type": "shell",
      "command": "make",
      "args": ["build-spectrum-tzx", "PROJECT=${input:projectName}"],
      "group": "build"
    },
    {
      "label": "🌈 Create New Spectrum Project",
      "type": "shell",
      "command": "make",
      "args": ["new-spectrum", "NAME=${input:newProjectName}"],
      "group": "build"
    },

    // NES Tasks
    {
      "label": "🎮 Build NES ROM",
      "type": "shell",
      "command": "make",
      "args": ["build-nes", "PROJECT=${input:projectName}"],
      "group": "build",
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\): Error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    },
    {
      "label": "🎮 Create New NES Project",
      "type": "shell",
      "command": "make",
      "args": ["new-nes", "NAME=${input:newProjectName}"],
      "group": "build"
    },

    // Amiga Tasks
    {
      "label": "🟦 Build Amiga Executable",
      "type": "shell",
      "command": "make",
      "args": ["build-amiga", "PROJECT=${input:projectName}"],
      "group": "build",
      "problemMatcher": {
        "owner": "vasm",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^error (\\d+) in line (\\d+) of \"(.+)\": (.*)$",
          "file": 3,
          "line": 2,
          "message": 4
        }
      }
    },
    {
      "label": "🟦 Build Amiga ADF",
      "type": "shell",
      "command": "make",
      "args": ["build-amiga-disk", "PROJECT=${input:projectName}"],
      "group": "build"
    },
    {
      "label": "🟦 Create New Amiga Project",
      "type": "shell",
      "command": "make",
      "args": ["new-amiga", "NAME=${input:newProjectName}"],
      "group": "build"
    },

    // Development Environment Tasks
    {
      "label": "🚀 Setup Development Environment",
      "type": "shell",
      "command": "make",
      "args": ["setup"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🧪 Test All Compilers",
      "type": "shell",
      "command": "make",
      "args": ["test-all"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "📋 Show Available Commands",
      "type": "shell",
      "command": "make",
      "args": ["help"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },

    // Shell Access Tasks
    {
      "label": "🟤 Open C64 Development Shell",
      "type": "shell",
      "command": "make",
      "args": ["shell-c64"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🌈 Open Spectrum Development Shell",
      "type": "shell",
      "command": "make",
      "args": ["shell-spectrum"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🎮 Open NES Development Shell",
      "type": "shell",
      "command": "make",
      "args": ["shell-nes"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🟦 Open Amiga Development Shell",
      "type": "shell",
      "command": "make",
      "args": ["shell-amiga"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },

    // Cleanup Tasks
    {
      "label": "🧹 Clean Project",
      "type": "shell",
      "command": "make",
      "args": ["clean", "PROJECT=${input:projectName}"],
      "group": "build"
    },
    {
      "label": "🧹 Clean Docker Images",
      "type": "shell",
      "command": "make",
      "args": ["clean-docker"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],

  "inputs": [
    {
      "id": "projectName",
      "description": "Project name to build (e.g., examples/commodore-64/01-hello-world/hello)",
      "type": "promptString"
    },
    {
      "id": "newProjectName",
      "description": "New project name",
      "type": "promptString"
    }
  ]
}
