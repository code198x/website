{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Development server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "name": "🟤 Run C64 Program in VICE",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-vice.js",
      "args": ["${input:c64Program}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🌈 Run Spectrum Program in Fuse",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-fuse.js",
      "args": ["${input:spectrumProgram}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🎮 Run NES ROM in Emulator",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-nes.js",
      "args": ["${input:nesProgram}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🟦 Run Amiga Program in UAE",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-uae.js",
      "args": ["${input:amigaProgram}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🔧 Debug Assembly Build Process",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug-build.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],

  "inputs": [
    {
      "id": "c64Program",
      "description": "C64 program to run (.prg file)",
      "type": "promptString"
    },
    {
      "id": "spectrumProgram",
      "description": "Spectrum program to run (.tap or .tzx file)",
      "type": "promptString"
    },
    {
      "id": "nesProgram",
      "description": "NES ROM to run (.nes file)",
      "type": "promptString"
    },
    {
      "id": "amigaProgram",
      "description": "Amiga program to run",
      "type": "promptString"
    }
  ]
}
