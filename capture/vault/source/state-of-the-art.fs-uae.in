# Substitute the three @...@ paths with local inputs; do not publish the disk or firmware.
[fs-uae]
amiga_model = A500
chip_memory = 1024
slow_memory = 0
fast_memory = 0
kickstart_file = @KICKSTART_13@
floppy_drive_0 = @DEMO_ADF@
base_dir = @WORK_DIR@/fs-uae
screenshots_output_dir = @WORK_DIR@
screenshots_output_mask = 1
fullscreen = 0
window_width = 768
window_height = 576
initial_input_grab = 0
automatic_input_grab = 0
volume = 0
floppy_drive_volume = 0
