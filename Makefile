# Building projects - Amiga
.PHONY: build-amiga
build-amiga:
	@if [ -z "$(PROJECT)" ]; then echo "❌ Error: PROJECT required. Use: make build-amiga PROJECT=myproject"; exit 1; fi
	@echo "🔧 Building Amiga project: $(PROJECT)"
	@$(DOCKER_COMPOSE) run --rm commodore-amiga-compiler /workspace/projects/$(AMIGA_DIR)/$(PROJECT)/$(PROJECT).s $(PROJECT) vasm exe
	@echo "✅ Built: $(PROJECT_DIR)/$(AMIGA_DIR)/$(PROJECT)/build/$(PROJECT)"

.PHONY: build-amiga-disk
build-amiga-disk:
