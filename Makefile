	@echo "✅ Built: $(PROJECT_DIR)/$(AMIGA_DIR)/$(PROJECT)/build/$(PROJECT).adf"

# Development shells
.PHONY: shell-dev
shell-dev:
	@echo "🖥️  Opening development shell..."
	@$(DOCKER_COMPOSE) run --rm dev-workspace bash

.PHONY: shell-c64
shell-c64:
	@echo "🟤 Opening C64 development shell..."
	@$(DOCKER_COMPOSE) run --rm c64-compiler bash

.PHONY: shell-spectrum
shell-spectrum:
	@echo "🌈 Opening ZX Spectrum development shell..."
	@$(DOCKER_COMPOSE) run --rm zx-spectrum-compiler bash

.PHONY: shell-nes
shell-nes:
	@echo "🎮 Opening NES development shell..."
	@$(DOCKER_COMPOSE) run --rm nintendo-entertainment-system-compiler bash

.PHONY: shell-amiga
shell-amiga:
	@echo "🟦 Opening Amiga development shell..."
	@$(DOCKER_COMPOSE) run --rm commodore-amiga-compiler bash

# Testing
.PHONY: test-all
test-all:
	@echo "🧪 Testing all compilation tools..."
	@echo "Testing C64 (CA65)..."
	@$(DOCKER_COMPOSE) run --rm c64-compiler ca65 --version
	@echo "Testing C64 (ACME)..."
	@$(DOCKER_COMPOSE) run --rm c64-compiler acme --version 2>/dev/null || echo "ACME ready"
	@echo "Testing ZX Spectrum (SjASMPlus)..."
	@$(DOCKER_COMPOSE) run --rm zx-spectrum-compiler sjasmplus --version 2>/dev/null || echo "SjASMPlus ready"
	@echo "Testing NES (CA65)..."
	@$(DOCKER_COMPOSE) run --rm nintendo-entertainment-system-compiler ca65 --version
	@echo "Testing Amiga (VASM)..."
	@$(DOCKER_COMPOSE) run --rm commodore-amiga-compiler vasm68k_mot -help | head -1
	@echo "✅ All tools ready!"

# Cleanup
.PHONY: clean
clean:
	@if [ -z "$(PROJECT)" ]; then echo "❌ Error: PROJECT required. Use: make clean PROJECT=myproject"; exit 1; fi
	@echo "🧹 Cleaning project: $(PROJECT)"
	@find $(PROJECT_DIR) -name "$(PROJECT)" -type d -exec rm -rf {}/build \; 2>/dev/null || true
	@echo "✅ Cleaned build files for $(PROJECT)"

# Docker management
.PHONY: pull
pull:
	@echo "⬇️  Pulling latest Docker images..."
	@$(DOCKER_COMPOSE) pull

.PHONY: build-images
build-images:
	@echo "🔨 Building Docker images..."
	@$(DOCKER_COMPOSE) build --no-cache

.PHONY: clean-docker
clean-docker:
	@echo "🧹 Cleaning Docker containers and images..."
	@$(DOCKER_COMPOSE) down --rmi all --volumes --remove-orphans
	@docker system prune -f