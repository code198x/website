---
import Layout from '../../layouts/Layout.astro';

// Game catalogue - 8 BASIC games
const games = [
  {
    number: 1,
    slug: 'game-01-number-hunter',
    name: 'Number Hunter',
    tagline: 'Number guessing game introducing BASIC fundamentals',
    units: 64,
    unitsAvailable: 0,
    skills: ['Variables', 'IF/THEN', 'FOR/NEXT', 'RND function'],
    status: 'coming-soon'
  },
  {
    number: 2,
    slug: 'game-02-cosmic-drift',
    name: 'Cosmic Drift',
    tagline: 'Character animation with screen memory POKEs',
    units: 64,
    unitsAvailable: 0,
    skills: ['Screen memory', 'Colour memory', 'PETSCII', 'Animation'],
    status: 'coming-soon'
  },
  {
    number: 3,
    slug: 'game-03-catcher',
    name: 'Catcher',
    tagline: 'Catch falling objects with real-time keyboard input',
    units: 64,
    unitsAvailable: 0,
    skills: ['GET statement', 'Game loop', 'Collision', 'Lives system'],
    status: 'coming-soon'
  },
  {
    number: 4,
    slug: 'game-04-maze-escape',
    name: 'Maze Escape',
    tagline: 'Navigate mazes using DATA statements',
    units: 64,
    unitsAvailable: 0,
    skills: ['DATA/READ', 'Level design', 'Wall collision', 'Multiple levels'],
    status: 'coming-soon'
  },
  {
    number: 5,
    slug: 'game-05-snake-trail',
    name: 'Snake Trail',
    tagline: 'Classic snake game with arrays and timing',
    units: 64,
    unitsAvailable: 0,
    skills: ['Arrays', 'TI timer', 'Self-collision', 'Growth mechanics'],
    status: 'coming-soon'
  },
  {
    number: 6,
    slug: 'game-06-space-dodge',
    name: 'Space Dodge',
    tagline: 'Vertical scrolling avoidance — meeting BASIC limits',
    units: 64,
    unitsAvailable: 0,
    skills: ['Simulated scrolling', 'Custom characters', 'Speed limits', 'High scores'],
    status: 'coming-soon'
  },
  {
    number: 7,
    slug: 'game-07-memory-match',
    name: 'Memory Match',
    tagline: 'Card matching puzzle with custom characters',
    units: 64,
    unitsAvailable: 0,
    skills: ['Custom characters', '2D arrays', 'Turn-based', 'Two-player'],
    status: 'coming-soon'
  },
  {
    number: 8,
    slug: 'game-08-platform-peril',
    name: 'Platform Peril',
    tagline: 'Platformer pushing BASIC to its limits',
    units: 64,
    unitsAvailable: 0,
    skills: ['Gravity', 'Jump physics', 'BASIC limitations', 'Transition prep'],
    status: 'coming-soon'
  }
];
---

<Layout
  title="Commodore 64 BASIC – Learn Programming Through Games"
  description="Learn C64 BASIC V2 by building complete games. A gateway curriculum preparing you for 6510 assembly."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #6666ff 0%, #9999ff 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      opacity: 0.6;
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--color-text-secondary);
      width: 3rem;
      text-align: center;
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .game-tagline {
      color: var(--color-text-secondary);
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-bg);
      color: var(--color-text-secondary);
      border-radius: 0.25rem;
    }

    .game-status {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    .next-step {
      background: var(--color-surface);
      border: 2px solid #6666ff;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-top: var(--space-8);
    }

    .next-step h3 {
      color: #6666ff;
      margin-bottom: var(--space-2);
    }

    @media (max-width: 768px) {
      .game-card {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .game-number { width: auto; }
      .game-skills { justify-content: center; }
    }
  </style>

  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">C64 BASIC V2</h1>
      <p class="system-subtitle">Gateway curriculum — learn programming fundamentals before assembly</p>
    </div>
  </section>

  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      8 complete games teaching BASIC fundamentals. Each game introduces new concepts while building something playable. Complete this curriculum to prepare for 6510 assembly.
    </p>

    <div class="game-grid">
      {games.map((game) => (
        <a href={`/commodore-64-basic/${game.slug}`} class="game-card">
          <div class="game-number">{game.number}</div>
          <div class="game-info">
            <div class="game-name">{game.name}</div>
            <div class="game-tagline">{game.tagline}</div>
            <div class="game-skills">
              {game.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          <span class="game-status">Coming Soon</span>
        </a>
      ))}
    </div>

    <div class="next-step">
      <h3>After BASIC</h3>
      <p>Complete these 8 games and you'll understand C64 memory layout, screen handling, and the limits of BASIC. Then move to <a href="/commodore-64">6510 Assembly</a> to unlock the full power of the machine.</p>
    </div>
  </section>
</Layout>
