---
import Layout from "../layouts/Layout.astro";

const breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Demo", href: "/layout-demo" },
  { text: "Layout Showcase", href: "/layout-demo" }
];

const sidebarContent = `
  <div style="background: var(--bg-surface); border-radius: var(--radius-lg); padding: var(--space-6); margin-bottom: var(--space-6);">
    <h3 style="margin-top: 0; color: var(--text-primary);">Table of Contents</h3>
    <ul style="list-style: none; padding: 0; margin: 0;">
      <li style="margin-bottom: var(--space-2);"><a href="#navigation" style="color: var(--text-link); text-decoration: none;">Navigation</a></li>
      <li style="margin-bottom: var(--space-2);"><a href="#responsive" style="color: var(--text-link); text-decoration: none;">Responsive Design</a></li>
      <li style="margin-bottom: var(--space-2);"><a href="#accessibility" style="color: var(--text-link); text-decoration: none;">Accessibility</a></li>
      <li style="margin-bottom: var(--space-2);"><a href="#footer" style="color: var(--text-link); text-decoration: none;">Footer</a></li>
    </ul>
  </div>
  
  <div style="background: var(--bg-surface); border-radius: var(--radius-lg); padding: var(--space-6);">
    <h4 style="margin-top: 0; color: var(--text-primary);">Quick Stats</h4>
    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <div style="display: flex; justify-content: space-between;">
        <span style="color: var(--text-secondary);">Breakpoints</span>
        <span style="font-weight: var(--font-semibold);">3</span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span style="color: var(--text-secondary);">WCAG Level</span>
        <span style="font-weight: var(--font-semibold);">AA</span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span style="color: var(--text-secondary);">Mobile First</span>
        <span style="font-weight: var(--font-semibold);">✓</span>
      </div>
    </div>
  </div>
`;
---

<Layout 
  title="Layout & Navigation Demo" 
  showBreadcrumb={true}
  showSidebar={true}
  sidebarContent={sidebarContent}
>
  <!-- Breadcrumb Slot -->
  <ol slot="breadcrumb">
    {breadcrumbs.map((crumb, index) => (
      <li>
        {index === breadcrumbs.length - 1 ? (
          <span class="current">{crumb.text}</span>
        ) : (
          <a href={crumb.href}>{crumb.text}</a>
        )}
      </li>
    ))}
  </ol>

  <!-- Main Content -->
  <div class="layout-demo">
    <div class="page-hero">
      <h1>Modern Layout & Navigation</h1>
      <p>Responsive, accessible, and beautiful design for the Code198x platform</p>
    </div>

    <div class="content-section">
      <h2 id="navigation">🧭 Navigation System</h2>
      <p>The new navigation system provides a modern, accessible experience across all devices:</p>
      
      <div class="cards-grid cards-grid--2" style="margin-top: var(--space-6);">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-6);">
          <h3 style="margin-top: 0; color: var(--retro-purple);">Desktop Navigation</h3>
          <ul style="color: var(--text-secondary); line-height: var(--leading-relaxed);">
            <li>Horizontal navigation bar with logo</li>
            <li>Active page indicators</li>
            <li>Search and theme toggle buttons</li>
            <li>Sticky positioning for easy access</li>
          </ul>
        </div>
        
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-6);">
          <h3 style="margin-top: 0; color: var(--retro-purple);">Mobile Navigation</h3>
          <ul style="color: var(--text-secondary); line-height: var(--leading-relaxed);">
            <li>Hamburger menu with smooth animations</li>
            <li>Slide-out panel with overlay</li>
            <li>Touch-friendly tap targets</li>
            <li>Automatic menu closing on navigation</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="content-section">
      <h2 id="responsive">📱 Responsive Design</h2>
      <p>Built mobile-first with three main breakpoints to ensure optimal experience on any device:</p>
      
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-8); margin-top: var(--space-6);">
        <div style="display: grid; gap: var(--space-6);">
          <div style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--bg-muted); border-radius: var(--radius-md);">
            <div style="width: 60px; height: 40px; background: var(--retro-cyan); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">📱</div>
            <div>
              <strong>Mobile (< 768px)</strong><br>
              <span style="color: var(--text-secondary);">Single column, stacked navigation, touch-optimized</span>
            </div>
          </div>
          
          <div style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--bg-muted); border-radius: var(--radius-md);">
            <div style="width: 60px; height: 40px; background: var(--retro-purple); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">💻</div>
            <div>
              <strong>Tablet (768px - 1024px)</strong><br>
              <span style="color: var(--text-secondary);">Two columns, horizontal navigation, balanced layout</span>
            </div>
          </div>
          
          <div style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--bg-muted); border-radius: var(--radius-md);">
            <div style="width: 60px; height: 40px; background: var(--retro-amber); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">🖥️</div>
            <div>
              <strong>Desktop (> 1024px)</strong><br>
              <span style="color: var(--text-secondary);">Full layout with optional sidebar, maximum content width</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="content-section">
      <h2 id="accessibility">♿ Accessibility Features</h2>
      <p>Built to WCAG AA standards with comprehensive accessibility support:</p>
      
      <div class="cards-grid cards-grid--3" style="margin-top: var(--space-6);">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-6);">
          <div style="font-size: 2rem; margin-bottom: var(--space-3);">⌨️</div>
          <h3 style="margin-top: 0;">Keyboard Navigation</h3>
          <p style="color: var(--text-secondary); margin-bottom: 0;">Full keyboard accessibility with visible focus indicators and logical tab order.</p>
        </div>
        
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-6);">
          <div style="font-size: 2rem; margin-bottom: var(--space-3);">🎨</div>
          <h3 style="margin-top: 0;">High Contrast</h3>
          <p style="color: var(--text-secondary); margin-bottom: 0;">All color combinations meet WCAG AA contrast requirements (4.5:1 minimum).</p>
        </div>
        
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-6);">
          <div style="font-size: 2rem; margin-bottom: var(--space-3);">📖</div>
          <h3 style="margin-top: 0;">Screen Readers</h3>
          <p style="color: var(--text-secondary); margin-bottom: 0;">Semantic HTML, ARIA labels, and proper heading hierarchy for assistive technology.</p>
        </div>
      </div>
      
      <div style="background: #E3F2FD; border-left: 4px solid var(--status-info); padding: var(--space-4); border-radius: var(--radius-md); margin-top: var(--space-6);">
        <strong style="color: var(--status-info);">Try it out:</strong> 
        <span style="color: var(--text-secondary);">Use Tab to navigate, press Enter on the hamburger menu (mobile), or try the skip link at the top.</span>
      </div>
    </div>

    <div class="content-section">
      <h2 id="footer">🦶 Footer Design</h2>
      <p>The footer provides comprehensive site navigation and information while maintaining visual hierarchy:</p>
      
      <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-6);">
        <div style="display: grid; gap: var(--space-4);">
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <div style="width: 8px; height: 8px; background: var(--retro-purple); border-radius: 50%;"></div>
            <span><strong>Brand section</strong> with social links and description</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <div style="width: 8px; height: 8px; background: var(--retro-cyan); border-radius: 50%;"></div>
            <span><strong>Organized navigation</strong> in logical groupings</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <div style="width: 8px; height: 8px; background: var(--retro-amber); border-radius: 50%;"></div>
            <span><strong>Legal links</strong> and copyright in footer bottom</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <div style="width: 8px; height: 8px; background: var(--retro-green); border-radius: 50%;"></div>
            <span><strong>Responsive grid</strong> that adapts from 1 to 4 columns</span>
          </div>
        </div>
      </div>
    </div>

    <div class="content-section">
      <h2>🎨 Visual Improvements</h2>
      <p>The new layout eliminates the "ugly" aspects with modern design principles:</p>
      
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-6);">
        <div style="display: flex; gap: var(--space-4); align-items: center; padding: var(--space-4); background: #E8F5E9; border-radius: var(--radius-md);">
          <div style="font-size: 1.5rem;">✨</div>
          <div>
            <strong style="color: var(--status-success);">Clean Typography</strong><br>
            <span style="color: var(--text-secondary);">Consistent spacing, proper hierarchy, and readable font sizes</span>
          </div>
        </div>
        
        <div style="display: flex; gap: var(--space-4); align-items: center; padding: var(--space-4); background: #E8F5E9; border-radius: var(--radius-md);">
          <div style="font-size: 1.5rem;">🎯</div>
          <div>
            <strong style="color: var(--status-success);">Better Visual Hierarchy</strong><br>
            <span style="color: var(--text-secondary);">Clear content organization with proper spacing and visual weight</span>
          </div>
        </div>
        
        <div style="display: flex; gap: var(--space-4); align-items: center; padding: var(--space-4); background: #E8F5E9; border-radius: var(--radius-md);">
          <div style="font-size: 1.5rem;">🌈</div>
          <div>
            <strong style="color: var(--status-success);">Consistent Color System</strong><br>
            <span style="color: var(--text-secondary);">Unified design tokens across all components and pages</span>
          </div>
        </div>
        
        <div style="display: flex; gap: var(--space-4); align-items: center; padding: var(--space-4); background: #E8F5E9; border-radius: var(--radius-md);">
          <div style="font-size: 1.5rem;">⚡</div>
          <div>
            <strong style="color: var(--status-success);">Smooth Interactions</strong><br>
            <span style="color: var(--text-secondary);">Subtle animations and hover states that enhance usability</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .layout-demo {
    max-width: none;
  }
  
  .page-hero {
    margin: calc(var(--space-8) * -1) calc(var(--space-8) * -1) var(--space-12);
    padding: var(--space-12) var(--space-8);
  }
  
  @media (max-width: 768px) {
    .page-hero {
      margin: calc(var(--space-6) * -1) calc(var(--space-4) * -1) var(--space-8);
      padding: var(--space-8) var(--space-4);
    }
  }
</style>