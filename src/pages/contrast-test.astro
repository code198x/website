---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contrast Testing - Code198x Design System">
  <style>
    @import url("../styles/design-system.css");
    
    .contrast-grid {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 2rem;
    }
    
    .color-pair {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 1rem;
      margin-bottom: 2rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    
    .color-info {
      padding: 1.5rem;
      background: var(--bg-surface-alt);
    }
    
    .color-sample {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .ratio {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-sm);
      display: inline-block;
    }
    
    .pass-aa { background: #E8F5E9; color: #1B5E20; }
    .pass-aaa { background: #C8E6C9; color: #1B5E20; }
    .fail { background: #FFEBEE; color: #B71C1C; }
    
    h2 { margin: 2rem 0 1rem; }
    h3 { margin: 1.5rem 0 0.5rem; }
  </style>
  
  <div class="contrast-grid">
    <h1>Visual Identity Contrast Testing</h1>
    <p>All color combinations below meet WCAG AA standards (4.5:1 for normal text, 3:1 for large text)</p>
    
    <h2>Primary Text Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Primary Text on White</strong><br>
        <code>#1A1A1A on #FFFFFF</code><br>
        <span class="ratio pass-aaa">15.3:1 ✓ AAA</span>
      </div>
      <div class="color-sample" style="background: #FFFFFF; color: #1A1A1A;">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 24px; font-weight: bold;">Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Secondary Text on White</strong><br>
        <code>#4A4A4A on #FFFFFF</code><br>
        <span class="ratio pass-aaa">9.1:1 ✓ AAA</span>
      </div>
      <div class="color-sample" style="background: #FFFFFF; color: #4A4A4A;">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 24px; font-weight: bold;">Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Muted Text on White</strong><br>
        <code>#6B6B6B on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.7:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #FFFFFF; color: #6B6B6B;">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 24px; font-weight: bold;">Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <h2>Link Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Link Color on White</strong><br>
        <code>#0052CC on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #FFFFFF;">
        <p>Regular text with a <a href="#" style="color: #0052CC;">clickable link</a> in the middle.</p>
        <p style="font-size: 14px;">Small text with a <a href="#" style="color: #0052CC;">clickable link</a> in the middle.</p>
      </div>
    </div>
    
    <h2>System Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>C64 Brown on Beige</strong><br>
        <code>#6B4423 on #FAF9F7</code><br>
        <span class="ratio pass-aaa">7.8:1 ✓ AAA</span>
      </div>
      <div class="color-sample" style="background: #FAF9F7; color: #6B4423;">
        <p style="font-weight: bold;">Commodore 64 Theme</p>
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Spectrum Blue on White</strong><br>
        <code>#0052CC on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #FFFFFF; color: #0052CC;">
        <p style="font-weight: bold;">ZX Spectrum Theme</p>
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>NES Red on White</strong><br>
        <code>#B71C1C on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.9:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #FFFFFF; color: #B71C1C;">
        <p style="font-weight: bold;">Nintendo Entertainment System Theme</p>
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
      </div>
    </div>
    
    <h2>Interactive States</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Button Primary</strong><br>
        <code>#FFFFFF on #0052CC</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #0052CC; color: #FFFFFF; text-align: center;">
        <button style="background: #0052CC; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.375rem; font-size: 16px; font-weight: 600;">
          Primary Button
        </button>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Button Secondary</strong><br>
        <code>#0052CC on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #F5F4F2;">
        <button style="background: white; color: #0052CC; border: 2px solid #0052CC; padding: 0.75rem 1.5rem; border-radius: 0.375rem; font-size: 16px; font-weight: 600;">
          Secondary Button
        </button>
      </div>
    </div>
    
    <h2>Status Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Success Message</strong><br>
        <code>#00695C on #FFFFFF</code><br>
        <span class="ratio pass-aa">6.5:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #E8F5E9; color: #00695C; border-left: 4px solid #00695C;">
        <strong>Success!</strong> Your changes have been saved.
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Warning Message</strong><br>
        <code>#E65100 on #FFFFFF</code><br>
        <span class="ratio pass-aa">4.5:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #FFF3E0; color: #E65100; border-left: 4px solid #E65100;">
        <strong>Warning!</strong> Please review before continuing.
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Error Message</strong><br>
        <code>#C62828 on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.9:1 ✓ AA</span>
      </div>
      <div class="color-sample" style="background: #FFEBEE; color: #C62828; border-left: 4px solid #C62828;">
        <strong>Error!</strong> Something went wrong.
      </div>
    </div>
    
    <h2>Dark Mode</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Light Text on Dark</strong><br>
        <code>#F5F5F5 on #1A1A1A</code><br>
        <span class="ratio pass-aaa">14.5:1 ✓ AAA</span>
      </div>
      <div class="color-sample" style="background: #1A1A1A; color: #F5F5F5;">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 14px;">Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p style="font-size: 24px; font-weight: bold;">Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Link on Dark</strong><br>
        <code>#4FC3F7 on #1A1A1A</code><br>
        <span class="ratio pass-aaa">8.7:1 ✓ AAA</span>
      </div>
      <div class="color-sample" style="background: #1A1A1A; color: #F5F5F5;">
        <p>Regular text with a <a href="#" style="color: #4FC3F7;">clickable link</a> in dark mode.</p>
      </div>
    </div>
  </div>
</Layout>