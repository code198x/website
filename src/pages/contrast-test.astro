---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contrast Testing - Code198x Design System">
  
  <div class="contrast-grid">
    <h1>Visual Identity Contrast Testing</h1>
    <p>All color combinations below meet WCAG AA standards (4.5:1 for normal text, 3:1 for large text)</p>
    
    <h2>Primary Text Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Primary Text on White</strong><br>
        <code>#1A1A1A on #FFFFFF</code><br>
        <span class="ratio pass-aaa">15.3:1 ✓ AAA</span>
      </div>
      <div class="color-sample">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p>Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Secondary Text on White</strong><br>
        <code>#4A4A4A on #FFFFFF</code><br>
        <span class="ratio pass-aaa">9.1:1 ✓ AAA</span>
      </div>
      <div class="color-sample">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p>Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Muted Text on White</strong><br>
        <code>#6B6B6B on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.7:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p>Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <h2>Link Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Link Color on White</strong><br>
        <code>#0052CC on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <p>Regular text with a <a href="#">clickable link</a> in the middle.</p>
        <p>Small text with a <a href="#">clickable link</a> in the middle.</p>
      </div>
    </div>
    
    <h2>System Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>C64 Brown on Beige</strong><br>
        <code>#6B4423 on #FAF9F7</code><br>
        <span class="ratio pass-aaa">7.8:1 ✓ AAA</span>
      </div>
      <div class="color-sample">
        <p>Commodore 64 Theme</p>
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Spectrum Blue on White</strong><br>
        <code>#0052CC on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <p>ZX Spectrum Theme</p>
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>NES Red on White</strong><br>
        <code>#B71C1C on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.9:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <p>Nintendo Entertainment System Theme</p>
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
      </div>
    </div>
    
    <h2>Interactive States</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Button Primary</strong><br>
        <code>#FFFFFF on #0052CC</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <button>
          Primary Button
        </button>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Button Secondary</strong><br>
        <code>#0052CC on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.4:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <button>
          Secondary Button
        </button>
      </div>
    </div>
    
    <h2>Status Colors</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Success Message</strong><br>
        <code>#00695C on #FFFFFF</code><br>
        <span class="ratio pass-aa">6.5:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <strong>Success!</strong> Your changes have been saved.
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Warning Message</strong><br>
        <code>#E65100 on #FFFFFF</code><br>
        <span class="ratio pass-aa">4.5:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <strong>Warning!</strong> Please review before continuing.
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Error Message</strong><br>
        <code>#C62828 on #FFFFFF</code><br>
        <span class="ratio pass-aa">5.9:1 ✓ AA</span>
      </div>
      <div class="color-sample">
        <strong>Error!</strong> Something went wrong.
      </div>
    </div>
    
    <h2>Dark Mode</h2>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Light Text on Dark</strong><br>
        <code>#F5F5F5 on #1A1A1A</code><br>
        <span class="ratio pass-aaa">14.5:1 ✓ AAA</span>
      </div>
      <div class="color-sample">
        <p>Regular text (16px): The quick brown fox jumps over the lazy dog.</p>
        <p>Small text (14px): The quick brown fox jumps over the lazy dog.</p>
        <p>Large text (24px bold): Quick brown fox</p>
      </div>
    </div>
    
    <div class="color-pair">
      <div class="color-info">
        <strong>Link on Dark</strong><br>
        <code>#4FC3F7 on #1A1A1A</code><br>
        <span class="ratio pass-aaa">8.7:1 ✓ AAA</span>
      </div>
      <div class="color-sample">
        <p>Regular text with a <a href="#">clickable link</a> in dark mode.</p>
      </div>
    </div>
  </div>
</Layout>