---
import Layout from '../layouts/Layout.astro';
import Emulator from '../components/Emulator.astro';
import VisualConcept from '../components/VisualConcept.astro';
import InteractiveExample from '../components/InteractiveExample.astro';
---

<Layout title="Emulator Demo - Code Like It's 198x">
  <div class="container mx-auto px-4 py-8">
    <!-- Hero Section -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">🚀 Interactive Emulator Demo</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Experience authentic vintage computing with WebAssembly emulators, visual learning concepts, 
        and interactive assembly programming for all our supported systems.
      </p>
    </div>

    <!-- Commodore 64 Demo -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-c64-brown">🟤 Commodore 64 - 6502 Assembly</h2>
      
      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Emulator -->
        <div>
          <h3 class="text-xl font-bold mb-4">VICE C64 Emulator</h3>
          <Emulator 
            system="commodore-64"
            code={`LDA #$41    ; Load 'A' into accumulator
STA $0400   ; Store to screen memory
LDA #$01    ; White color
STA $D800   ; Store to color RAM
RTS         ; Return`}
            autoStart={false}
            showControls={true}
            height="400px"
          />
        </div>
        
        <!-- Visual Concept -->
        <div>
          <h3 class="text-xl font-bold mb-4">Register State Visualization</h3>
          <VisualConcept 
            type="register-state"
            system="commodore-64"
            title="6502 Registers"
            interactive={true}
          />
        </div>
      </div>

      <!-- Interactive Example -->
      <InteractiveExample 
        system="commodore-64"
        title="Hello World in 6502 Assembly"
        description="Load a character into memory and display it on screen"
        code={`LDA #$48    ; Load 'H' (ASCII 72)
STA $0400   ; Store to top-left of screen
LDA #$45    ; Load 'E' (ASCII 69)  
STA $0401   ; Store to next position
LDA #$4C    ; Load 'L' (ASCII 76)
STA $0402   ; Store L
STA $0403   ; Store L again
LDA #$4F    ; Load 'O' (ASCII 79)
STA $0404   ; Store O`}
        concepts={["6502 registers", "Memory addressing", "Screen memory", "ASCII characters"]}
        visualType="memory-map"
      />
    </section>

    <!-- ZX Spectrum Demo -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-spectrum-red">🔴 ZX Spectrum - Z80 Assembly</h2>
      
      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Emulator -->
        <div>
          <h3 class="text-xl font-bold mb-4">JSSpeccy Emulator</h3>
          <Emulator 
            system="zx-spectrum"
            code={`LD A,2      ; Red border
OUT (254),A ; Set border color  
LD A,7      ; White on black
LD (23693),A ; Set permanent colors
HALT        ; Stop`}
            autoStart={false}
            showControls={true}
            height="400px"
          />
        </div>
        
        <!-- Visual Concept -->
        <div>
          <h3 class="text-xl font-bold mb-4">Z80 Instruction Flow</h3>
          <VisualConcept 
            type="instruction-flow"
            system="zx-spectrum"
            title="Z80 Execution"
            interactive={true}
          />
        </div>
      </div>

      <!-- Interactive Example -->
      <InteractiveExample 
        system="zx-spectrum"
        title="ZX Spectrum Border Colors"
        description="Change the border color using Z80 assembly and I/O ports"
        code={`LD A,1      ; Blue border
OUT (254),A ; Output to border port
LD A,2      ; Red border  
OUT (254),A ; Change border again
LD A,4      ; Green border
OUT (254),A ; Final border color`}
        concepts={["Z80 registers", "I/O ports", "Border colors", "OUT instruction"]}
        visualType="addressing-mode"
      />
    </section>

    <!-- Nintendo NES Demo -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-nes-red">🎮 Nintendo Entertainment System - 6502 Assembly</h2>
      
      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Emulator -->
        <div>
          <h3 class="text-xl font-bold mb-4">JSNES Emulator</h3>
          <Emulator 
            system="nintendo-entertainment-system"
            code={`LDA #$3F    ; PPU palette address high
STA $2006   ; PPU address register
LDA #$00    ; PPU palette address low
STA $2006   ; PPU address register  
LDA #$0F    ; Black color
STA $2007   ; PPU data register`}
            autoStart={false}
            showControls={true}
            height="400px"
          />
        </div>
        
        <!-- Visual Concept -->
        <div>
          <h3 class="text-xl font-bold mb-4">Memory Map</h3>
          <VisualConcept 
            type="memory-map"
            system="nintendo-entertainment-system"
            title="NES Memory Layout"
            interactive={true}
          />
        </div>
      </div>

      <!-- Interactive Example -->
      <InteractiveExample 
        system="nintendo-entertainment-system"
        title="NES PPU Color Control"
        description="Program the Picture Processing Unit to set background colors"
        code={`LDA #$3F    ; Palette memory high byte
STA $2006   ; Set PPU address
LDA #$00    ; Palette memory low byte  
STA $2006   ; Set PPU address
LDA #$30    ; Light blue color
STA $2007   ; Write to palette`}
        concepts={["PPU registers", "Memory-mapped I/O", "Color palettes", "NES graphics"]}
        visualType="stack-operation"
      />
    </section>

    <!-- Commodore Amiga Demo -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-amiga-blue">🔵 Commodore Amiga - 68000 Assembly</h2>
      
      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Emulator -->
        <div>
          <h3 class="text-xl font-bold mb-4">vAmiga Emulator</h3>
          <Emulator 
            system="commodore-amiga"
            code={`MOVE.L #$00FF0000,D0  ; Red color
MOVE.W D0,$DFF180       ; Set background color
MOVEQ #10,D1           ; Load immediate
ADD.L D1,D0            ; Add to D0
RTS                    ; Return`}
            autoStart={false}
            showControls={true}
            height="400px"
          />
        </div>
        
        <!-- Visual Concept -->
        <div>
          <h3 class="text-xl font-bold mb-4">68000 Register State</h3>
          <VisualConcept 
            type="register-state"
            system="commodore-amiga"
            title="68000 Registers"
            interactive={true}
          />
        </div>
      </div>

      <!-- Interactive Example -->
      <InteractiveExample 
        system="commodore-amiga"
        title="Amiga Custom Chip Programming"
        description="Program the custom chips to control graphics and colors"
        code={`MOVEQ #0,D0           ; Clear D0
MOVE.W #$0F00,D1       ; Blue color value
MOVE.W D1,$DFF180      ; Set background color
LEA $DFF000,A0         ; Load custom chip base
MOVE.W #$8200,(A0)     ; Enable copper`}
        concepts={["68000 architecture", "Custom chips", "32-bit registers", "Effective addressing"]}
        visualType="instruction-flow"
      />
    </section>

    <!-- Feature Overview -->
    <section class="bg-gray-50 rounded-xl p-8 mb-12">
      <h2 class="text-2xl font-bold mb-6 text-center">✨ Interactive Learning Features</h2>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-500 rounded-xl flex items-center justify-center text-white text-2xl mx-auto mb-4">
            🖥️
          </div>
          <h3 class="font-bold mb-2">Real Emulators</h3>
          <p class="text-sm text-gray-600">Authentic WebAssembly emulators running actual hardware code</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-500 rounded-xl flex items-center justify-center text-white text-2xl mx-auto mb-4">
            👁️
          </div>
          <h3 class="font-bold mb-2">Visual Learning</h3>
          <p class="text-sm text-gray-600">See registers, memory, and instruction flow in real-time</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-purple-500 rounded-xl flex items-center justify-center text-white text-2xl mx-auto mb-4">
            💻
          </div>
          <h3 class="font-bold mb-2">Interactive Code</h3>
          <p class="text-sm text-gray-600">Edit, run, and experiment with assembly code immediately</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-orange-500 rounded-xl flex items-center justify-center text-white text-2xl mx-auto mb-4">
            🎯
          </div>
          <h3 class="font-bold mb-2">Step-by-Step</h3>
          <p class="text-sm text-gray-600">Debug and step through code execution instruction by instruction</p>
        </div>
      </div>
    </section>

    <!-- Technical Notes -->
    <section class="bg-blue-50 border border-blue-200 rounded-xl p-6">
      <h3 class="text-lg font-bold text-blue-800 mb-3">🔧 Technical Implementation</h3>
      <div class="text-blue-700 space-y-2 text-sm">
        <p><strong>C64:</strong> Uses VICE WebAssembly port with 6502 assembler integration</p>
        <p><strong>ZX Spectrum:</strong> JSSpeccy 3 with Z80 assembly support and TAP file generation</p>
        <p><strong>NES:</strong> JSNES with iNES ROM creation and PPU register visualization</p>
        <p><strong>Amiga:</strong> vAmiga WebAssembly with 68000 assembler and custom chip access</p>
        <p><strong>Fallbacks:</strong> Canvas-based simple emulators ensure compatibility on all systems</p>
      </div>
    </section>
  </div>
</Layout>