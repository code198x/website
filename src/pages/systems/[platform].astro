---
import PlayerStage from '../../components/PlayerStage.astro';
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '@198x-ui/components/Eyebrow.astro';
import Tile from '@198x-ui/components/Tile.astro';
import { getCollection } from 'astro:content';
import { getAllPlatforms, getAllManufacturers } from '../../lib/platforms';
import { asmInstructionReference } from '../../lib/surfaces';
import { systemStatus } from '../../lib/system-directory';
import { stageWidth } from '../../lib/player-posters';

export async function getStaticPaths() {
  const platforms = await getAllPlatforms();
  const manufacturers = await getAllManufacturers();
  const makers = new Map(manufacturers.map(m => [m.id, m.data.shortName]));
  return platforms.filter(p => p.data.tier !== 'live').map(p => ({
    params: { platform: p.id }, props: { data: p.data, maker: makers.get(p.data.manufacturer) ?? p.data.manufacturer },
  }));
}
const { data, maker } = Astro.props;
const slug = Astro.params.platform!;
const lessons = (await getCollection('unit-pages')).filter(unit => unit.id.startsWith(`${slug}/`));
const status = systemStatus[lessons.length ? 'live' : data.tier ?? 'planned'];
const articles = (await getCollection('vault')).filter(entry => entry.data.platforms?.includes(slug))
  .sort((a, b) => Number(b.data.category === 'systems') - Number(a.data.category === 'systems') || a.data.title.localeCompare(b.data.title)).slice(0, 6);
const instructionRef = asmInstructionReference(data.cpuArchitecture);
const regions: Record<string, string> = { US: 'United States', UK: 'United Kingdom', USSR: 'Soviet Union' };
const facts = [
  { label: 'Manufacturer', value: maker }, { label: 'Introduced', value: data.year },
  { label: 'CPU', value: data.cpu }, { label: 'Type', value: data.type },
  { label: 'Region', value: regions[data.region] ?? data.region },
];
const name = data.shortName ?? data.name;
const heroStageMax = stageWidth(slug, name);
---
<Layout title={data.name} description={`${data.name}: curriculum availability, machine details and related Code198x reference material.`}>
  <article class="page">
    <div class="hero" style={heroStageMax ? `--stage-max: ${heroStageMax}px` : undefined}>
      <header>
        <Eyebrow>Systems · {status.label}</Eyebrow>
        <h1>{data.name}</h1>
        <p class="lead">{status.description}</p>
      </header>
      <PlayerStage system={slug} name={name} color={data.color}
        facts={[{ label: 'Released', value: data.year }, { label: 'CPU', value: data.cpu }]} />
    </div>
    <div class="columns">
      <section aria-labelledby="machine">
        <h2 id="machine">About the machine</h2>
        <dl>{facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
        <p>These details identify the system in the directory. Particular models, expansions
          and regional versions can differ; a development guide needs to name its target configuration.</p>
      </section>
      <section aria-labelledby="available">
        <h2 id="available">What you can explore now</h2>
        {lessons.length > 0 ? <ul>{lessons.map(lesson => <li><a href={`/systems/${lesson.id}`}>{lesson.data.title}</a></li>)}</ul> :
          <p>There are no published Code198x lessons for this system yet. You can explore
            related reference material below, or choose a machine with lessons from the{' '}
            <a href="/systems">Systems directory</a>.</p>}
        <p><a href="/foundations">Foundations</a> offers programming concepts in pseudocode,
          without choosing a machine. It is an optional starting point, not a requirement
          for a future track here.</p>
        {instructionRef && <p>The <a href={instructionRef}>{data.cpuArchitecture} instructions</a>{' '}
          on Asm198x provide a CPU reference. A CPU reference is not a complete
          setup guide or evidence that a program can be built and run on this system.</p>}
      </section>
    </div>
    <section aria-labelledby="related">
      <h2 id="related">Related reading</h2>
      {articles.length > 0 ? <ul class="articles">{articles.map(article => <li>
        <Tile href={`/vault/${article.id}/`} title={article.data.title} as="h3">In the Vault: {article.data.category}</Tile>
      </li>)}</ul> : <p>Browse the <a href="/vault">Vault</a> for computing history and technical
        context, or the <a href="/timeline">Timeline</a> for events across systems.</p>}
    </section>
    <section aria-labelledby="contributing">
      <h2 id="contributing">Help develop the material</h2>
      <p>A useful contribution might be a sourced correction, a small working example or
        a proposal for a game suited to this machine. Explain the target configuration,
        what the example teaches and what you have checked.</p>
      <p>Read the <a href="/contribute">contribution guide</a> and discuss a proposed track
        before starting a large set of lessons. The <a href="/standards">Sources &amp; Standards</a>{' '}
        page explains our approach to evidence. Published additions appear in{' '}
        <a href="/updates">What’s New</a>.</p>
    </section>
  </article>
</Layout>
<style>
  .page { max-width: var(--container-max-width); margin: auto; padding: calc(var(--h-cell) * 10) var(--gutter) calc(var(--h-cell) * 12); }
  .hero { display: grid; gap: calc(var(--h-cell) * 6); align-items: start; margin-bottom: calc(var(--h-cell) * 6); }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(20rem, 1fr) minmax(0, var(--stage-max, auto)); } }
  h1 {
    margin: calc(var(--h-cell) * 3) 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, var(--h-text-display));
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  h2 {
    margin: 0 0 calc(var(--h-cell) * 2);
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.5vw, var(--h-text-h3));
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--h-ink);
  }
  p { max-width: 68ch; color: var(--h-ink-body); }
  .lead { font-size: var(--h-text-lead); line-height: var(--h-lh-lead); }
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  section { margin-top: calc(var(--h-cell) * 8); }
  .columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--h-cell) * 6); }
  dl { margin: 0; padding: calc(var(--h-cell) * 2) calc(var(--h-cell) * 3); border: 1px solid var(--h-line); background: var(--h-ground); }
  dl > div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: calc(var(--h-cell) * 2); padding: var(--h-cell) 0; }
  dt { color: var(--h-ink-muted); } dd { margin: 0; overflow-wrap: anywhere; color: var(--h-ink); }
  .articles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: calc(var(--h-cell) * 2); margin: 0; padding: 0; list-style: none; }
  .articles li { display: flex; }
  .articles li > :global(.h-tile) { flex: 1; }
  @media (max-width: 760px) { .columns { grid-template-columns: minmax(0, 1fr); gap: 0; } }
</style>
