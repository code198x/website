---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const systems = await getCollection('systems');
  return systems.map((system) => ({
    params: { system: system.slug },
    props: { system },
  }));
}

const { system } = Astro.props;
const { Content } = await system.render();

// Get phases for this system
const allPhases = await getCollection('phases');
const systemPhases = allPhases
  .filter(phase => phase.data.system === system.slug)
  .sort((a, b) => a.data.phase_number - b.data.phase_number);
---

<Layout title={system.data.name}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{system.data.name}</h1>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <img 
            src={system.data.image} 
            alt={system.data.name}
            class="w-full rounded-lg shadow-lg"
          />
        </div>
        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-semibold mb-2">Technical Specifications</h3>
            <dl class="space-y-1 text-sm">
              <div class="flex"><dt class="font-medium w-24">CPU:</dt><dd>{system.data.cpu}</dd></div>
              <div class="flex"><dt class="font-medium w-24">RAM:</dt><dd>{system.data.ram}</dd></div>
              <div class="flex"><dt class="font-medium w-24">Released:</dt><dd>{system.data.release_date.global.toDateString()}</dd></div>
              <div class="flex"><dt class="font-medium w-24">Origin:</dt><dd>{system.data.country_of_origin}</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="prose max-w-none mb-12">
      <Content />
    </div>

    <div>
      <h2 class="text-3xl font-bold mb-6">Learning Phases</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {systemPhases.map((phase) => (
          <div class="border rounded-lg p-6 hover:shadow-lg transition-shadow">
            <h3 class="text-xl font-semibold mb-2">
              <a href={`/lessons/${system.slug}/phase-${phase.data.phase_number}`} class="hover:text-blue-600">
                Phase {phase.data.phase_number}: {phase.data.title}
              </a>
            </h3>
            <p class="text-gray-600 text-sm mb-4">{phase.data.description}</p>
            <div class="text-xs text-gray-500">
              <div>Duration: {phase.data.estimated_duration}</div>
              <div>Level: {phase.data.difficulty_level}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>