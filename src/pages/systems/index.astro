---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Separate systems into those with lessons and those without
const systemsWithLessons = systems.filter((system) => {
  return lessons.some((lesson) => lesson.id.startsWith(system.slug));
});

const systemsWithoutLessons = systems.filter((system) => {
  return !lessons.some((lesson) => lesson.id.startsWith(system.slug));
});

// Sort both groups by order
systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
systemsWithoutLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Systems - Code Like It's 198x">
  <Breadcrumb segments={[{ text: "Systems", href: "/systems" }]} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="text-center mb-12">
      <h1 class="text-5xl font-bold text-c64-brown mb-4" style="font-family: var(--font-heading)">
        Vintage Computer Systems
      </h1>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        Explore the revolutionary computers that defined the 1980s and early 1990s. Learn to program
        the machines that started the home computing revolution.
      </p>
    </header>

    <section class="mb-16">
      <h2
        class="text-3xl font-bold mt-8 mb-6 text-c64-brown"
        style="font-family: var(--font-heading)"
      >
        🚀 Early Access: Systems with Lessons
      </h2>
      <p class="text-slate-600 mb-6 text-lg">
        These systems have programming lessons available now (more coming soon).
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          systemsWithLessons.map((system) => (
            <a
              href={`/systems/${system.slug}/`}
              class="block p-6 bg-white/80 rounded-lg hover:bg-white/90 transition border border-c64-beige-darker shadow-md hover:shadow-lg"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="inline-block w-3 h-3 bg-green-500 rounded-full" />
                <span class="text-sm font-medium text-green-700">Available Now</span>
              </div>
              <h3
                class="text-xl font-bold mb-2 text-c64-dark-brown"
                style="font-family: var(--font-heading)"
              >
                {system.data.name}
              </h3>
              <p class="text-slate-600 mb-3">
                {system.data.manufacturer} • {system.data.cpu}
              </p>
              <img
                src={`/images/systems/${system.slug}.jpg`}
                alt={system.data.name}
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-16">
      <h2
        class="text-3xl font-bold mt-12 mb-6 text-c64-brown"
        style="font-family: var(--font-heading)"
      >
        🔮 Coming Soon: Planned System Releases
      </h2>
      <p class="text-slate-600 mb-8 text-lg">
        "Code Like It's 198x" will eventually cover <strong>32 systems total</strong>, released in
        manageable waves. Here's our roadmap spanning 1977-2001:
      </p>

      <div class="space-y-8">
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3 text-amber-800">
            📅 Wave 2: Next Release (+2 Systems)
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white p-4 rounded border">
              <h4 class="font-semibold text-slate-800">Apple II (1977)</h4>
              <p class="text-sm text-slate-600">6502 CPU • Business/education computing</p>
            </div>
            <div class="bg-white p-4 rounded border">
              <h4 class="font-semibold text-slate-800">BBC Micro (1981)</h4>
              <p class="text-sm text-slate-600">6502 CPU • Designed for education</p>
            </div>
          </div>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3 text-blue-800">
            📅 Wave 3: Major Expansion (+4 Systems)
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white p-4 rounded border">
              <h4 class="font-semibold text-slate-800">TRS-80 Color Computer (1980)</h4>
              <p class="text-sm text-slate-600">6809 CPU • Unique advanced 8-bit</p>
            </div>
            <div class="bg-white p-4 rounded border">
              <h4 class="font-semibold text-slate-800">Atari 2600 (1977)</h4>
              <p class="text-sm text-slate-600">6507 CPU • Ultimate optimization challenge</p>
            </div>
            <div class="bg-white p-4 rounded border">
              <h4 class="font-semibold text-slate-800">Atari 8-bit (1979)</h4>
              <p class="text-sm text-slate-600">6502 CPU • Advanced graphics/sound</p>
            </div>
            <div class="bg-white p-4 rounded border">
              <h4 class="font-semibold text-slate-800">MSX (1983)</h4>
              <p class="text-sm text-slate-600">Z80 CPU • International standard</p>
            </div>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
          <h3 class="text-xl font-bold mb-3 text-slate-800">📅 Future Waves: Long-term Plan</h3>
          <p class="text-slate-600 mb-4">
            Waves 4-10 will add the remaining 22 systems, including:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <h4 class="font-semibold text-slate-700 mb-2">Consoles & Handhelds</h4>
              <ul class="text-sm text-slate-600 space-y-1">
                <li>• Sega Master System</li>
                <li>• Game Boy</li>
                <li>• Sega Genesis</li>
                <li>• Super Nintendo</li>
                <li>• Game Boy Advance</li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-slate-700 mb-2">European Systems</h4>
              <ul class="text-sm text-slate-600 space-y-1">
                <li>• Amstrad CPC</li>
                <li>• Atari ST</li>
                <li>• Dragon 32/64</li>
                <li>• Enterprise 64/128</li>
                <li>• Oric-1/Atmos</li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-slate-700 mb-2">Vintage Commodore</h4>
              <ul class="text-sm text-slate-600 space-y-1">
                <li>• VIC-20</li>
                <li>• PET/CBM</li>
                <li>• Plus many more...</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <h2
        class="text-3xl font-bold mt-12 mb-6 text-c64-brown"
        style="font-family: var(--font-heading)"
      >
        📚 Historical Context Systems
      </h2>
      <p class="text-slate-600 mb-6 text-lg">
        These systems are included for historical context but don't currently have programming
        lessons.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          systemsWithoutLessons.map((system) => (
            <a
              href={`/systems/${system.slug}/`}
              class="block p-4 bg-c64-beige-dark rounded-lg hover:bg-c64-beige-darker transition border border-c64-beige-darker"
            >
              <h3 class="text-lg font-semibold mb-1 text-c64-dark-brown">{system.data.name}</h3>
              <p class="text-sm text-slate-600">
                {system.data.manufacturer} • {system.data.cpu}
              </p>
              <p class="text-xs text-slate-500 mt-1">
                Released: {system.data.release_date.global.getFullYear()}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
