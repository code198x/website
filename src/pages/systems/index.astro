---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Separate systems into those with lessons and those without
const systemsWithLessons = systems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

const systemsWithoutLessons = systems.filter(system => {
  return !lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort both groups by order
systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
systemsWithoutLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Systems - Code Like It's 198x">
  <Breadcrumb segments={[{ text: 'Systems', href: '/systems' }]} />
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="text-center mb-12">
      <h1 class="text-5xl font-bold text-c64-brown mb-4" style="font-family: var(--font-heading)">
        Vintage Computer Systems
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Explore the revolutionary computers that defined the 1980s and early 1990s. 
        Learn to program the machines that started the home computing revolution.
      </p>
    </header>
    
    <section class="mb-16">
      <h2 class="text-3xl font-bold mt-8 mb-6 text-c64-brown" style="font-family: var(--font-heading)">
        Systems with Programming Lessons
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {systemsWithLessons.map((system) => (
          <a href={`/systems/${system.slug}/`} class="block p-6 bg-white/80 rounded-lg hover:bg-white/90 transition border border-c64-beige-darker shadow-md hover:shadow-lg">
            <h3 class="text-xl font-bold mb-2 text-c64-dark-brown" style="font-family: var(--font-heading)">
              {system.data.name}
            </h3>
            <p class="text-gray-600 mb-3">
              {system.data.manufacturer} • {system.data.cpu}
            </p>
            {system.data.image && (
              <img src={system.data.image} alt={system.data.name} class="w-full h-48 object-cover rounded" />
            )}
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold mt-12 mb-6 text-c64-brown" style="font-family: var(--font-heading)">
        Historical Systems
      </h2>
      <p class="text-gray-600 mb-6 text-lg">
        These systems are included for historical context but don't currently have programming lessons.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {systemsWithoutLessons.map((system) => (
          <a href={`/systems/${system.slug}/`} class="block p-4 bg-c64-beige-dark rounded-lg hover:bg-c64-beige-darker transition border border-c64-beige-darker">
            <h3 class="text-lg font-semibold mb-1 text-c64-dark-brown">
              {system.data.name}
            </h3>
            <p class="text-sm text-gray-600">
              {system.data.manufacturer} • {system.data.cpu}
            </p>
            <p class="text-xs text-gray-500 mt-1">
              Released: {system.data.release_date.global.getFullYear()}
            </p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>