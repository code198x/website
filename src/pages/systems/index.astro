---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Separate systems into those with lessons and those without
const systemsWithLessons = systems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

const systemsWithoutLessons = systems.filter(system => {
  return !lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort both groups by order
systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
systemsWithoutLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Systems - Code Like It's 198x">
  <h1>Vintage Computer Systems</h1>
  
  <h2 class="text-2xl font-bold mt-8 mb-4">Systems with Programming Lessons</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {systemsWithLessons.map((system) => (
      <a href={`/systems/${system.slug}/`} class="block p-4 bg-green-50 rounded-lg hover:bg-green-100 transition">
        <h3 class="text-xl font-semibold mb-2">{system.data.name}</h3>
        <p class="text-gray-600">{system.data.manufacturer} • {system.data.cpu}</p>
        {system.data.image && (
          <img src={system.data.image} alt={system.data.name} class="w-full h-32 object-cover rounded mt-2" />
        )}
      </a>
    ))}
  </div>

  <h2 class="text-2xl font-bold mt-12 mb-4">Historical Systems</h2>
  <p class="text-gray-600 mb-4">These systems are included for historical context but don't currently have programming lessons.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {systemsWithoutLessons.map((system) => (
      <a href={`/systems/${system.slug}/`} class="block p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
        <h3 class="text-lg font-semibold mb-1">{system.data.name}</h3>
        <p class="text-sm text-gray-600">{system.data.manufacturer} • {system.data.cpu}</p>
        <p class="text-xs text-gray-500 mt-1">Released: {system.data.release_date.global.getFullYear()}</p>
      </a>
    ))}
  </div>
</Layout>