---
import Layout from '../../../../layouts/Layout.astro';
import CurriculumPosition from '../../../../components/CurriculumPosition.astro';
import Figure from '../../../../components/Figure.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#4a4dff';
// Only modules with published lessons are listed; planned games stay in the
// catalogue but are not presented as part of the course until they ship.
const games = (await getModulesWithAvailability('commodore-64', 'basic')).filter(g => g.unitsAvailable > 0);

const primer=games.find(g=>g.slug==='meet-c64-basic');
const specs = [
  { label: 'CPU', value: 'MOS 6510' },
  { label: 'RAM', value: '64 KB' },
  { label: 'Language', value: 'BASIC V2' },
];
---

<Layout
  title="Commodore 64 BASIC – Learn Programming Through Games"
  description="Learn C64 BASIC V2 by building complete games, using the Commodore 64's own screen, memory and sound."
  platformColor={platformColor}
>
  <section class="adopted-track-opening"><h1>Commodore 64<br/><em>BASIC.</em></h1><div><p>Learn programming on the machine's own BASIC</p><p class="track-facts">MOS 6510 · 64 KB · BASIC V2</p><a class="track-begin" href="/systems/commodore-64/basic/meet-c64-basic/unit-01/">Start with Unit 1</a><a href="#games">Explore the published games</a></div></section>
  {primer&&<section class="adopted-track-primer"><div><h2>{primer.name}</h2><p>{primer.tagline}</p><p>{primer.unitsAvailable} of {primer.units} units published</p><a href={`/systems/commodore-64/basic/${primer.slug}/`}>Explore the primer</a><details><summary>What you'll learn</summary><ul>{primer.skills.map(skill=><li>{skill}</li>)}</ul></details></div><div class="primer-capture"><Figure src={primer.thumbnail!} alt="Meet C64 BASIC screenshot from the Commodore 64 BASIC lessons" caption="Meet C64 BASIC · Commodore 64 BASIC."/></div></section>}

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <CurriculumPosition
      stage="Language and games"
      title="C64 BASIC turns the shared ideas into a real Commodore 64 program."
      body="This route starts with BASIC V2 and uses complete games to make variables, loops, screen memory, input, and simple state concrete on the C64 before you decide whether to go deeper into assembly."
      notes={[
        'No assembly knowledge is needed.',
        'If loops, variables or binary feel shaky, Foundations explains them; it is not required.',
        'The Craft and Pattern Library are supporting layers when a game introduces a reusable technique.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'The whole route' },
        { href: '/foundations', label: 'Foundations', note: 'If programming is new' },
        { href: '/systems/commodore-64/assembly', label: 'C64 Assembly', note: 'The deeper machine route' },
      ]}
    />

    <section class="content-section" id="games">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Build complete games while you learn the fundamentals — variables, loops, and the C64's screen and memory. Begin with Meet C64 BASIC, then work through the games in order.</p>
      <TrackGames games={games.filter(g=>g.slug!=='meet-c64-basic')} platform="commodore-64" track="basic" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <div class="next-step">
        <h3>After BASIC</h3>
        <p>These games teach C64 memory layout, screen handling and the limits of BASIC. <a href="/systems/commodore-64/assembly">6510 assembly</a> reaches the rest of the machine if you want to go further; it is another route, not a required next step.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .next-step { background: var(--color-surface); border: 3px solid var(--platform-color); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .next-step h3 { color: var(--ink); margin: 0 0 var(--space-2); font-size: 1.2rem; }
  .next-step p { margin: 0; color: var(--color-text-secondary); }
  .next-step a { color: var(--ink); font-weight: 700; }
</style>
