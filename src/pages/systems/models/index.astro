---
import Layout from '../../../layouts/Layout.astro';
import ModelIllustration from '../../../components/ModelIllustration.astro';
import { hardwareModels } from '../../../data/hardware-models';
const [featured, ...models] = hardwareModels;
---
<Layout title="Hardware illustrations" description="Explore Code198x’s rendered illustrations of classic computers and consoles, with close views of their cases, keyboards and controls.">
  <article class="model-gallery">
    <div class="gallery-opening">
      <header><h1>Meet the machines.</h1><p>Look closely at the cases, keyboards and controls of the machines we write about. These are our rendered illustrations, made from hardware references and carefully compared with the real things.</p>
        <nav aria-label="Models">{hardwareModels.map(model => <a href={`#${model.system}`}>{model.name}</a>)}</nav>
      </header>
      <section class="featured-model" id={featured.system} aria-labelledby={`${featured.system}-title`}>
        <ModelIllustration model={featured} priority showViews />
        <h2 id={`${featured.system}-title`}><a href={`/systems/${featured.system}/`}>{featured.name}</a></h2><p class="variant">{featured.variant}</p><p>{featured.description}</p>
      </section>
    </div>
    <div class="model-collection">{models.map(model => <section id={model.system} aria-labelledby={`${model.system}-title`}>
      <ModelIllustration model={model} showViews />
      <h2 id={`${model.system}-title`}><a href={`/systems/${model.system}/`}>{model.name}</a></h2><p class="variant">{model.variant}</p><p>{model.description}</p>
    </section>)}</div>
    <section class="about-models" aria-labelledby="about-models"><h2 id="about-models">About these illustrations</h2><p>These models help us explore the machines as physical objects. They are reconstructions, rather than photographs or manufacturing drawings: some proportions, artwork and small details are estimated. Different production models can vary.</p><p>For the history and hardware behind them, follow the system links into the <a href="/systems/">Systems directory</a> and the <a href="/vault/">Vault</a>.</p></section>
  </article>
</Layout>
<style>@layer blocks {
  .model-gallery { padding-block: 32px 64px; color: var(--h-ink); }
  .gallery-opening { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: 48px; align-items: start; }
  header { padding-top: 24px; }
  h1 { max-width: 12ch; margin: 0 0 24px; font: italic 900 clamp(3rem, 5.5vw, 5rem)/1.02 var(--h-font-mag); letter-spacing: -.025em; }
  p { max-width: 65ch; color: var(--h-ink-body); font: 1.125rem/1.65 var(--h-font-ui); }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 32px; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; font: 600 1rem/1.5 var(--h-font-ui); }
  .model-collection { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; row-gap: 64px; margin-top: 64px; }
  section { min-width: 0; scroll-margin-top: 96px; }
  h2 { margin: 24px 0 8px; color: var(--h-ink); font: 700 var(--heading-h3-size)/1.2 var(--h-font-ui); }
  .variant { margin: 0; font-weight: 600; }
  .about-models { margin-top: 80px; padding-top: 32px; border-top: 1px solid var(--h-line); } /* taste-skill-ignore: House section divider matches the existing Systems pages. */
  a { color: inherit; text-underline-offset: .2em; }
  a:hover { color: var(--h-spot-ink); }
  a:focus-visible { outline: 3px solid var(--h-spot); outline-offset: 4px; }
  @media (max-width: 900px) { .gallery-opening { grid-template-columns: 1fr; gap: 32px; } h1 { max-width: none; } }
  @media (max-width: 640px) { .model-collection { grid-template-columns: 1fr; gap: 48px; margin-top: 48px; } header { padding-top: 0; } }
}</style>
