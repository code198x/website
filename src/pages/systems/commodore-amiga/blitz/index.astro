---
import Layout from '../../../../layouts/Layout.astro';
import CurriculumPosition from '../../../../components/CurriculumPosition.astro';
import SystemHero from '../../../../components/SystemHero.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#ff6600';
// Only modules with published lessons are listed; planned games stay in the
// catalogue but are not presented as part of the course until they ship.
const games = (await getModulesWithAvailability('commodore-amiga', 'blitz')).filter(g => g.unitsAvailable > 0);

const specs = [
  { label: 'CPU', value: 'MC68000' },
  { label: 'RAM', value: '512 KB+' },
  { label: 'Language', value: 'Blitz BASIC 2' },
];
---

<Layout
  title="Amiga Blitz BASIC – Learn Programming Through Games"
  description="Learn Blitz BASIC 2 by building complete games. Compiled Amiga BASIC that runs at full speed and reaches the hardware — a fast, hardware-near alternative to AMOS."
  platformColor={platformColor}
>
  <SystemHero
    title="Amiga Blitz"
    subtitle="Compiled BASIC, full speed, close to the metal"
    kicker="Amiga · Blitz BASIC 2 · compiled"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <CurriculumPosition
      stage="Language and games"
      title="Blitz is the compiled BASIC route close to Amiga hardware."
      body="This route uses Blitz BASIC 2 to bridge high-level code and hardware-near thinking: bitmaps, frame loops, input, compiled speed, and games that start to feel like the assembly route without beginning in assembly."
      notes={[
        'No 68000 assembly knowledge is needed.',
        'AMOS and Blitz are parallel Amiga routes, not a strict sequence.',
        'Foundations gives a slower introduction to variables, loops, arrays and binary if you want one; it is not required.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'The whole route' },
        { href: '/systems/commodore-amiga/amos', label: 'Amiga AMOS', note: 'The immediate BASIC route' },
        { href: '/systems/commodore-amiga/assembly', label: 'Amiga Assembly', note: 'The hardware route' },
      ]}
    />

    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Start with the <strong>Meet Blitz</strong> primer: it takes you from your first compile to graphics that run at full speed. Blitz games will be listed here as their lessons are published.</p>
      <TrackGames games={games} platform="commodore-amiga" track="blitz" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <div class="next-step">
        <h3>Other ways into the Amiga</h3>
        <p>AMOS and Blitz are two ways into Amiga game-making — neither above the other, each stronger at some things. <a href="/systems/commodore-amiga/assembly">68000 assembly</a> is a third: total control and every byte yours. The habits you built in Blitz — bitmaps, the frame loop, reaching for the hardware — carry straight over if you try it.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .next-step { background: var(--color-surface); border: 3px solid var(--platform-color); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .next-step h3 { color: var(--ink); margin: 0 0 var(--space-2); font-size: 1.2rem; }
  .next-step p { margin: 0; color: var(--color-text-secondary); }
  .next-step a { color: var(--ink); font-weight: 700; }
</style>
