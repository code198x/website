---
import Layout from '../../../../layouts/Layout.astro';
import CurriculumPosition from '../../../../components/CurriculumPosition.astro';
import SystemHero from '../../../../components/SystemHero.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#ff6600';
const games = await getModulesWithAvailability('commodore-amiga', 'amos');

const specs = [
  { label: 'CPU', value: 'MC68000' },
  { label: 'RAM', value: '512 KB+' },
  { label: 'Language', value: 'AMOS BASIC' },
];
---

<Layout
  title="Amiga AMOS BASIC – Learn Programming Through Games"
  description="Learn AMOS BASIC by building complete games. A gateway curriculum preparing you for 68000 assembly."
  platformColor={platformColor}
>
  <SystemHero
    title="Amiga AMOS"
    subtitle="Immediate results before diving into assembly"
    kicker="Amiga · AMOS BASIC · gateway"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <CurriculumPosition
      stage="02 · Language primer and gateway route"
      title="AMOS gives you an immediate Amiga route before full hardware control."
      body="This route teaches Amiga game-making through AMOS: screens, sprites, BOBs, input, animation, and complete games that show what the machine can do from a high-level language."
      notes={[
        'No assembly knowledge is needed.',
        'If programming itself is new, Foundations gives you the shared ideas first.',
        'AMOS is a route into Amiga game-making, not a required step before Blitz or assembly.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'The whole route' },
        { href: '/foundations', label: 'Foundations', note: 'If programming is new' },
        { href: '/systems/commodore-amiga/assembly', label: 'Amiga Assembly', note: 'The hardware route' },
      ]}
    />

    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Build complete games while you learn AMOS — sprites, BOBs, and the Amiga's screen. Start with Game 1 and work through in order.</p>
      <TrackGames games={games} platform="commodore-amiga" track="amos" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <div class="next-step">
        <h3>After AMOS</h3>
        <p>Complete these 8 games and you'll understand sprites, BOBs, scrolling, and where AMOS struggles. Then move to <a href="/systems/commodore-amiga/assembly">68000 assembly</a> for Copper, Blitter, and full hardware control.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .next-step { background: var(--color-surface); border: 3px solid var(--platform-color); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .next-step h3 { color: var(--ink); margin: 0 0 var(--space-2); font-size: 1.2rem; }
  .next-step p { margin: 0; color: var(--color-text-secondary); }
  .next-step a { color: var(--ink); font-weight: 700; }
</style>
