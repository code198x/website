---
import Layout from '../../../../layouts/Layout.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#cc0000';

// Show authored material, not a fixed launch quota or an unshipped game plan.
const allGames = await getModulesWithAvailability('sinclair-zx-spectrum', 'basic');
const games = allGames.filter(g => g.unitsAvailable > 0);
const phaseSubtitles = {
  'Primer': 'Begin with four guided lessons: a greeting becomes a story.',
  'Reference': 'Individual language and machine explanations to consult when useful.',
  'First Programs': 'Short projects and games using text, input, colour, sound and movement.',
  'Patterns of State': 'Games using arrays, boards, maps and stored state.',
};

---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC through small programs and guided games. Start without prior programming experience and explore how the Spectrum works."
  platformColor={platformColor}
>
  <article class="page">
    <header>
      <p class="eyebrow">ZX Spectrum · 48K · BASIC</p>
      <h1>Sinclair BASIC</h1>
      <p class="lead">Enter an instruction, see what happens, and make it your own.
        Grow small programs into games while exploring the Spectrum’s keyboard,
        screen, colour and sound.</p>
      <p>No prior programming experience is needed. You can start here without
        completing <a href="/foundations">Foundations</a>, and BASIC is not a
        prerequisite for <a href="/systems/sinclair-zx-spectrum/assembly">assembly</a>.</p>
      <a class="start-link" href="/systems/sinclair-zx-spectrum/basic/meet-basic">Start Meet BASIC <span aria-hidden="true">→</span></a>
    </header>

    <section class="content-section">
      <h2 class="section-title">Begin with a story</h2>
      <p class="section-intro">The first four <a href="/systems/sinclair-zx-spectrum/basic/meet-basic">Meet BASIC lessons</a> are available now. Enter a greeting, store and edit a program, ask for words, then finish a story you can save and share. The revised number-guessing, Oracle Stone and movement sections are in development. Together they will lead towards <a href="/systems/sinclair-zx-spectrum/basic/bright-spark">Bright Spark</a> and <a href="/systems/sinclair-zx-spectrum/basic/touchdown">Touchdown</a>.</p>
    </section>

    <section class="content-section">
      <h2 class="section-title">Published lessons and games</h2>
      <p class="section-intro">Start with Meet BASIC, or explore the existing material below. The separate Story Builder lessons are the earlier version of that project. The groups describe what is available now; they are not a prerequisite checklist. A small story or guessing game is a worthwhile finished program in its own right.</p>
      <TrackGames appearance="house" games={games} platform="sinclair-zx-spectrum" track="basic" platformColor={platformColor} phaseSubtitles={phaseSubtitles} />
    </section>

    <section class="content-section">
      <h2 class="section-title">Explore an idea further</h2>
      <p><a href="/craft">The Craft</a> develops game-design questions such as feedback, challenge and player choices. <a href="/foundations">Foundations</a> explores programming concepts. <a href="/systems/sinclair-zx-spectrum/assembly">Z80 assembly</a> offers another way into the Spectrum, where you work directly with processor instructions and memory.</p>
    </section>
  </article>
</Layout>

<style>
  .page { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-10) var(--gutter) var(--space-16); }
  header { margin-bottom: var(--space-12); }
  .eyebrow { font-family: var(--font-family-sans); font-size: var(--h-text-small); color: var(--h-ink-muted); }
  h1 { font-family: var(--font-family-read); font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.08; color: var(--h-ink); margin: var(--space-3) 0 var(--space-6); text-wrap: balance; }
  .lead { font-size: 1.2rem; }
  p { font-family: var(--font-family-read); max-width: 70ch; line-height: 1.7; color: var(--h-ink-body); margin: var(--space-4) 0; }
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .start-link { display: inline-flex; gap: var(--space-3); align-items: center; min-height: 44px; font-family: var(--font-family-sans); font-weight: 600; }
  .content-section { margin-top: var(--space-12); }
  .section-title { font-family: var(--font-family-sans); color: var(--h-ink); font-size: 1.4rem; line-height: 1.3; margin-bottom: var(--space-4); }
  .section-intro { margin-bottom: var(--space-8); }
</style>
