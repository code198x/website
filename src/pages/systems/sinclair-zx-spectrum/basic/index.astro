---
import Layout from '../../../../layouts/Layout.astro';
import CurriculumPosition from '../../../../components/CurriculumPosition.astro';
import SystemHero from '../../../../components/SystemHero.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#cc0000';

// Show authored material, not a fixed launch quota or an unshipped game plan.
const allGames = await getModulesWithAvailability('sinclair-zx-spectrum', 'basic');
const games = allGames.filter(g => g.unitsAvailable > 0);
const phaseSubtitles = {
  'Primer': 'The current introduction to entering, running and changing Spectrum programs.',
  'First Programs': 'Short projects and games using text, input, colour, sound and movement.',
  'Patterns of State': 'Games using arrays, boards, maps and stored state.',
};

const specs = [
  { label: 'CPU', value: 'Zilog Z80' },
  { label: 'RAM', value: '48 KB' },
  { label: 'Language', value: 'Sinclair BASIC' },
];
---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC through small programs and guided games. Start without prior programming experience and explore how the Spectrum works."
  platformColor={platformColor}
>
  <SystemHero
    title="Sinclair BASIC"
    subtitle="Learn programming from scratch by building games"
    kicker="Spectrum · BASIC · games"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <CurriculumPosition
      stage="Programming and games"
      title="Make something, see what it does, and change it."
      body="Enter instructions, read their results and grow small programs into games. Learn Sinclair BASIC's syntax alongside the Spectrum's keyboard, screen, colour and sound."
      notes={[
        'No prior programming experience is assumed.',
        'Foundations explains programming ideas in pseudocode; use it whenever a fuller explanation would help.',
        'BASIC and assembly are independent choices. You do not need to finish either track to enter the other.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'Explore the curriculum' },
        { href: '/foundations', label: 'Foundations', note: 'Programming concepts' },
        { href: '/systems/sinclair-zx-spectrum/assembly', label: 'Spectrum Assembly', note: 'The Z80 route' },
      ]}
    />

    <section class="content-section">
      <h2 class="section-title">Start with Meet BASIC</h2>
      <p class="section-intro">The <a href="/systems/sinclair-zx-spectrum/basic/meet-basic">published Meet BASIC lessons</a> introduce the keyboard, language and machine. We are developing a revised introduction around a greeting that becomes <a href="/systems/sinclair-zx-spectrum/basic/story-builder">Story Builder</a>, a number-guessing game, <a href="/systems/sinclair-zx-spectrum/basic/oracle-stone">Oracle Stone</a> and a movement experiment. These shorter projects will lead into <a href="/systems/sinclair-zx-spectrum/basic/bright-spark">Bright Spark</a> and <a href="/systems/sinclair-zx-spectrum/basic/touchdown">Touchdown</a>. The revised lessons are not yet published.</p>
    </section>

    <section class="content-section">
      <h2 class="section-title">Published lessons and games</h2>
      <p class="section-intro">Explore the current material below. The groups describe what is available now; they are not a prerequisite checklist. A small story or guessing game is a worthwhile finished program in its own right.</p>
      <TrackGames games={games} platform="sinclair-zx-spectrum" track="basic" platformColor={platformColor} phaseSubtitles={phaseSubtitles} />
    </section>

    <section class="content-section">
      <div class="next-step">
        <h3>Explore an idea further</h3>
        <p><a href="/craft">The Craft</a> develops game-design questions such as feedback, challenge and player choices. <a href="/foundations">Foundations</a> explores programming concepts. <a href="/systems/sinclair-zx-spectrum/assembly">Z80 assembly</a> offers another way into the Spectrum, where you work directly with processor instructions and memory.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--gutter); max-width: var(--container-max-width); margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .next-step { background: var(--color-surface); border: 3px solid var(--platform-color); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .next-step h3 { color: var(--ink); margin: 0 0 var(--space-2); font-size: 1.2rem; }
  .next-step p { margin: 0; color: var(--color-text-secondary); }
  .next-step a { color: var(--ink); font-weight: 700; }
</style>
