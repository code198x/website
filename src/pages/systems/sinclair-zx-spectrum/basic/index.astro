---
import Layout from '../../../../layouts/Layout.astro';
import CurriculumPosition from '../../../../components/CurriculumPosition.astro';
import SystemHero from '../../../../components/SystemHero.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#cc0000';

// Volumes 1–2 (First Programs, Patterns of State) are the October launch scope.
// Volumes 3–4 (Worlds and Rules, Stories and Systems) remain in the catalogue
// (basic.yaml) but are out of scope for launch — add their phase names here to
// list them again. TrackGames groups whatever it's given by catalogue phase.
const LAUNCH_PHASES = ['Primer', 'First Programs', 'Patterns of State'];
const allGames = await getModulesWithAvailability('sinclair-zx-spectrum', 'basic');
const games = allGames.filter(g => LAUNCH_PHASES.includes(g.phase ?? ''));

// Per-phase descriptions (carried from the curated launch copy).
const phaseSubtitles = {
  'Primer': 'Before the games: learn to write, run, edit and debug Sinclair BASIC for real — and meet the screen, colour, sound and motion games are made of.',
  'First Programs': 'Learn the language by building eight small games. Each adds one dimension — colour, sound, screen control, strings, data — until your programs look like real Spectrum software.',
  'Patterns of State': 'Turn-based games built on structured data — arrays as boards and maps, DATA-driven levels, hidden state, and your first AI opponents. From word-guessing to a push puzzle.',
};

const specs = [
  { label: 'CPU', value: 'Zilog Z80' },
  { label: 'RAM', value: '48 KB' },
  { label: 'Language', value: 'Sinclair BASIC' },
];
---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC by building complete games. A gateway curriculum preparing you for Z80 assembly."
  platformColor={platformColor}
>
  <SystemHero
    title="Sinclair BASIC"
    subtitle="Learn programming from scratch by building games"
    kicker="Spectrum · BASIC · gateway"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <CurriculumPosition
      stage="02 · Language primer and gateway route"
      title="Sinclair BASIC is the beginner route into real programs on a real machine."
      body="This route turns the shared programming ideas into Spectrum code: printed text, colour, sound, input, arrays, DATA, state, and complete games that make the machine's limits visible."
      notes={[
        'No prior programming experience is assumed.',
        'Foundations are optional if you want the ideas explained before the Spectrum syntax.',
        'The assembly route is independent, but BASIC gives you a strong feel for the screen, colour model, and constraints.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'The whole route' },
        { href: '/foundations', label: 'Foundations', note: 'Plain-language on-ramp' },
        { href: '/systems/sinclair-zx-spectrum/assembly', label: 'Spectrum Assembly', note: 'The Z80 route' },
      ]}
    />

    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Sixteen complete games teaching Sinclair BASIC from absolute zero — from a number-guessing game to a Sokoban-style push puzzle. The first eight teach the language; the next eight build turn-based games around arrays, data, and state.</p>
      <TrackGames games={games} platform="sinclair-zx-spectrum" track="basic" platformColor={platformColor} phaseSubtitles={phaseSubtitles} />
    </section>

    <section class="content-section">
      <div class="next-step">
        <h3>After BASIC</h3>
        <p>BASIC isn't a prerequisite for assembly — the two tracks are independent. But these games give you a deep feel for the Spectrum's colour model, screen layout, and what BASIC can and can't do. Ready for raw speed? Try <a href="/systems/sinclair-zx-spectrum/assembly">Z80 assembly</a>.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--gutter); max-width: var(--container-max-width); margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .next-step { background: var(--color-surface); border: 3px solid var(--platform-color); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .next-step h3 { color: var(--ink); margin: 0 0 var(--space-2); font-size: 1.2rem; }
  .next-step p { margin: 0; color: var(--color-text-secondary); }
  .next-step a { color: var(--ink); font-weight: 700; }
</style>
