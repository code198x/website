---
import Layout from '../../../../layouts/Layout.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#cc0000';

const allGames = await getModulesWithAvailability('sinclair-zx-spectrum', 'basic');
const published = allGames.filter(g => g.unitsAvailable > 0);
const games = published.filter(g => !['Earlier games', 'Reference', 'Experiments'].includes(g.phase ?? ''));
const earlierGames = published.filter(g => g.phase === 'Earlier games');
const phaseSubtitles = {
  'First programs': 'Make small programs respond, then remember and repeat a sequence.',
  'Movement and control': 'Keep a ball in play, then control a falling craft.',
  'Boards and deduction': 'Read hidden positions and words, plan pushes, combine clues and examine an opponent’s decisions.',
  'Hidden worlds': 'Explore connected places, read a guard’s sight and manage choices that carry into later turns.',
  'Worlds that keep moving': 'Steer, aim and plan while the game continues around you.',
};

---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC through small programs and guided games. Start without prior programming experience and explore how the Spectrum works."
  platformColor={platformColor}
>
  <article class="page">
    <header>
      <p class="eyebrow">ZX Spectrum · 48K · BASIC</p>
      <h1>Sinclair BASIC</h1>
      <p class="lead">Enter an instruction, see what happens, and make it your own.
        Grow small programs into games while exploring the Spectrum’s keyboard,
        screen, colour and sound.</p>
      <p>No prior programming experience is needed. You can start here without
        completing <a href="/foundations">Foundations</a>, and BASIC is not a
        prerequisite for <a href="/systems/sinclair-zx-spectrum/assembly">assembly</a>.</p>
      <a class="start-link" href="/systems/sinclair-zx-spectrum/basic/meet-basic">Start Meet BASIC <span aria-hidden="true">→</span></a>
    </header>

    <section class="content-section">
      <h2 class="section-title">Begin with a story</h2>
      <p class="section-intro">The <a href="/systems/sinclair-zx-spectrum/basic/meet-basic">Meet BASIC lessons</a> grow through four small projects. Enter a greeting, store and edit a program, ask for words, then finish a story you can save and share. Build Lucky Number with clues, chance and another round; give Oracle Stone a rhythm and a shared routine; then compare two ways to steer a marker.</p>
    </section>

    <section class="content-section">
      <h2 class="section-title">The current course</h2>
      <p class="section-intro">Explore groups of related games, from first programs to moving and hidden worlds. Follow the games in order or join one that interests you; each explains the BASIC it uses. The groups organise related ideas without adding entry requirements. Story Builder, Lucky Number and Oracle Stone are part of Meet BASIC.</p>
      <TrackGames appearance="house" games={games} platform="sinclair-zx-spectrum" track="basic" platformColor={platformColor} phaseSubtitles={phaseSubtitles} />
    </section>

    <section class="content-section" id="reference">
      <h2 class="section-title">BASIC reference</h2>
      <p>Look up commands, graphics, sound, saving and debugging in the <a href="/systems/sinclair-zx-spectrum/basic/basic-reference/">Sinclair BASIC reference lessons</a>. Use them when a question arises; they are not an extra course to complete first.</p>
    </section>

    {earlierGames.length > 0 && (
    <section class="content-section" id="earlier-games">
      <h2 class="section-title">Earlier games</h2>
      <p>These existing lessons offer more games to explore. They belong to an earlier course and may refer to its sequence or assume earlier lessons. They are separate from the current course above.</p>
      <ul>
        {earlierGames.map(game => <li><a href={`/systems/sinclair-zx-spectrum/basic/${game.slug}/`}>{game.name}</a> — {game.tagline}</li>)}
      </ul>
    </section>

    )}

    <section class="content-section">
      <h2 class="section-title">Explore an idea further</h2>
      <p><a href="/craft/maths-for-games">Maths for Games</a> includes Dice Roller, a five-lesson probability experiment in Sinclair BASIC. Watch samples form and compare their counts and shares.</p>
      <p><a href="/craft">The Craft</a> develops game-design questions such as feedback, challenge and player choices. <a href="/foundations">Foundations</a> explores programming concepts. <a href="/systems/sinclair-zx-spectrum/assembly">Z80 assembly</a> offers another way into the Spectrum, where you work directly with processor instructions and memory.</p>
    </section>
  </article>
</Layout>

<style>
  .page { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-10) var(--gutter) var(--space-16); }
  header { margin-bottom: var(--space-12); }
  .eyebrow { font-family: var(--font-family-sans); font-size: var(--h-text-small); color: var(--h-ink-muted); }
  h1 { font-family: var(--font-family-read); font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.08; color: var(--h-ink); margin: var(--space-3) 0 var(--space-6); text-wrap: balance; }
  .lead { font-size: 1.2rem; }
  p { font-family: var(--font-family-read); max-width: 70ch; line-height: 1.7; color: var(--h-ink-body); margin: var(--space-4) 0; }
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .start-link { display: inline-flex; gap: var(--space-3); align-items: center; min-height: 44px; font-family: var(--font-family-sans); font-weight: 600; }
  .content-section { margin-top: var(--space-12); }
  .section-title { font-family: var(--font-family-sans); color: var(--h-ink); font-size: 1.4rem; line-height: 1.3; margin-bottom: var(--space-4); }
  li { font-family: var(--font-family-read); line-height: 1.7; margin-block: var(--space-3); }
  .section-intro { margin-bottom: var(--space-8); }
</style>
