---
import UnitLayout from '../../../../../layouts/UnitLayout.astro';
import ModuleOverviewLayout from '../../../../../layouts/ModuleOverviewLayout.astro';
export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const files = import.meta.glob('/src/drafts/volley/unit-*.mdx', { eager: true });
  const lessons = Object.entries(files).map(([path, entry]: [string, any]) => ({
    slug: path.split('/').pop()!.replace(/\.mdx$/, ''), entry,
  })).sort((a, b) => a.entry.frontmatter.unit - b.entry.frontmatter.unit);
  const base = '/systems/sinclair-zx-spectrum/basic/volley/review/';
  const paths = lessons.map(({ slug, entry }, i) => ({ params: { review: `review/${slug}` }, props: {
    entry, paths: lessons.map(l => base + l.slug + '/'),
    prev: i > 0 ? base + lessons[i - 1].slug + '/' : undefined,
    next: i + 1 < lessons.length ? base + lessons[i + 1].slug + '/' : undefined,
  }}));
  const overview = await import('/src/drafts/volley/index.mdx');
  return [...paths, ...[undefined, 'review', 'review/overview'].map(review => ({
    params: { review }, props: { entry: overview, overview: true },
  }))];
}
const { entry, paths, prev, next, overview } = Astro.props;
if (overview && Astro.params.review !== 'review/overview') {
  return Astro.redirect('/systems/sinclair-zx-spectrum/basic/volley/review/overview/');
}
const Content = entry.Content;
---
{overview ? <ModuleOverviewLayout {...entry.frontmatter} platformSlug="sinclair-zx-spectrum" track="basic" moduleSlug="volley"><Content /></ModuleOverviewLayout> : <UnitLayout {...entry.frontmatter} gameName="Volley" totalUnits={8}
  unitPaths={paths} prevLesson={prev} nextLesson={next}
  overviewHref="/systems/sinclair-zx-spectrum/basic/volley/review/overview/" overviewLabel="Volley lesson review">
  <Content />
</UnitLayout>}
