---
import UnitLayout from '../../../../../../layouts/UnitLayout.astro';

// Authoring preview only. Existing curriculum URLs keep their current meaning.
// Returning no production paths also keeps these drafts out of Pagefind/sitemaps.
export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const drafts = import.meta.glob('../../../../../../drafts/meet-basic/unit-*.mdx', { eager: true });
  const lessons = Object.entries(drafts).map(([path, draft]: [string, any]) => ({
    slug: path.split('/').pop()!.replace('.mdx', ''), title: draft.frontmatter.title,
  })).sort((a, b) => a.slug.localeCompare(b.slug));
  return Object.entries(drafts).map(([path, draft]: [string, any]) => ({
    params: { unit: path.split('/').pop()!.replace('.mdx', '') },
    props: { draft, lessons, totalUnits: Object.keys(drafts).length, unit: Number(path.match(/unit-(\d+)/)![1]) },
  }));
}
const { draft, lessons, unit, totalUnits } = Astro.props;
const Content = draft.default;
const reviewBase = '/systems/sinclair-zx-spectrum/basic/meet-basic/review/';
---
<UnitLayout {...draft.frontmatter} game={0} gameName="Meet BASIC — opening review" unit={unit} totalUnits={totalUnits}
  overviewHref="#review-lessons" overviewLabel="Review lessons"
  breadcrumbs={[
    { label: 'Published BASIC track', href: '/systems/sinclair-zx-spectrum/basic/' },
    { label: 'Meet BASIC review', href: '#review-lessons' },
    { label: `Unit ${unit}: ${draft.frontmatter.title}` },
  ]}
  nextLesson={unit < totalUnits ? `${reviewBase}unit-${String(unit + 1).padStart(2, "0")}/` : undefined}
  prevLesson={unit > 1 ? `${reviewBase}unit-${String(unit - 1).padStart(2, "0")}/` : undefined}>
  <aside aria-label="Draft review status">
    <strong>Authoring preview.</strong> Units 1–3 are approved. Unit 4 is ready for review.
    The remaining lessons are in development.
    <nav id="review-lessons" aria-label="Review lessons">
      <ol>
        {lessons.map((lesson) => <li><a href={`${reviewBase}${lesson.slug}/`}
          aria-current={lesson.slug === `unit-${String(unit).padStart(2, '0')}` ? 'page' : undefined}>{lesson.title}</a></li>)}
      </ol>
    </nav>

  </aside>
  <Content />
</UnitLayout>
