---
// Local review bookmarks now point to the published lessons. No production routes.
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ['unit-01-make-the-spectrum-answer', 'unit-02-remember-and-save',
    'unit-03-ask-and-use-the-answer', 'unit-04-a-story-worth-sharing'].map((slug, i) => ({
    params: { unit: `unit-${String(i + 1).padStart(2, '0')}` }, props: { slug },
  }));
}
return Astro.redirect(`/systems/sinclair-zx-spectrum/basic/meet-basic/${Astro.props.slug}/`);
---
