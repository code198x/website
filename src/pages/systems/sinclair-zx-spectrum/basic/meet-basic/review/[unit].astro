---
import UnitLayout from '../../../../../../layouts/UnitLayout.astro';

// Authoring preview only. Existing curriculum URLs keep their current meaning.
// Returning no production paths also keeps these drafts out of Pagefind/sitemaps.
export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const drafts = import.meta.glob('../../../../../../drafts/meet-basic/unit-*.mdx', { eager: true });
  return Object.entries(drafts).map(([path, draft]: [string, any]) => ({
    params: { unit: path.split('/').pop()!.replace('.mdx', '') },
    props: { draft, totalUnits: Object.keys(drafts).length, unit: Number(path.match(/unit-(\d+)/)![1]) },
  }));
}
const { draft, unit, totalUnits } = Astro.props;
const Content = draft.default;
---
<UnitLayout {...draft.frontmatter} game={0} gameName="Meet BASIC — opening review" unit={unit} totalUnits={totalUnits}
  nextLesson={unit < totalUnits ? `../unit-${String(unit + 1).padStart(2, "0")}/` : undefined}
  prevLesson={unit > 1 ? `../unit-${String(unit - 1).padStart(2, "0")}/` : undefined}>
  <aside aria-label="Draft review status">
    <strong>Authoring preview.</strong> These are proposed opening lessons, not the complete module.
    The desktop keyboard mappings have been checked in source; native interface operation remains unverified.
    {unit === 2 && <p>The saving section is incomplete: Emu198x exports a BASIC tape recording through MCP,
      but the desktop interface needs a learner-facing export command. Do not reset an unsaved session
      to follow this draft. Publication is blocked until the complete desktop save/reopen route is checked.</p>}
  </aside>
  <Content />
</UnitLayout>
