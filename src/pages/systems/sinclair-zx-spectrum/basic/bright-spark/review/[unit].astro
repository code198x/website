---
import UnitLayout from '../../../../../../layouts/UnitLayout.astro';

// Local authoring only: these paths do not exist in the production build.
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const drafts = import.meta.glob('../../../../../../drafts/bright-spark/unit-*.mdx', { eager: true });
  return Object.entries(drafts).map(([path, draft]: [string, any]) => ({
    params: { unit: path.split('/').pop()!.replace('.mdx', '') },
    props: { draft, unit: Number(path.match(/unit-(\d+)/)![1]) },
  }));
}
const { draft, unit } = Astro.props;
const Content = draft.default;
const root = '/systems/sinclair-zx-spectrum/basic/bright-spark/review';
const paths = [`${root}/unit-01/`, `${root}/unit-02/`];
---
<UnitLayout {...draft.frontmatter} game={6} gameName="Bright Spark — opening review"
  unit={unit} totalUnits={2} unitPaths={paths}
  overviewHref={paths[0]} overviewLabel="Opening review"
  breadcrumbs={[{ label: "Systems", href: "/systems/" },
    { label: "ZX Spectrum", href: "/systems/sinclair-zx-spectrum/" },
    { label: "BASIC", href: "/systems/sinclair-zx-spectrum/basic/" },
    { label: "Bright Spark review", href: paths[0] }]}
  nextLesson={unit === 1 ? paths[1] : undefined}
  prevLesson={unit === 2 ? paths[0] : undefined}>
  <aside aria-label="Draft review status">
    <strong>Authoring preview.</strong> Two replacement lesson drafts. These are not yet published.
  </aside>
  <Content />
</UnitLayout>
