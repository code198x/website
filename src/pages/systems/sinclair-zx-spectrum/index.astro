---
import SystemOverview from '../../../components/SystemOverview.astro';
const overview = {
  "slug": "sinclair-zx-spectrum",
  "introduction": "Make games in Sinclair BASIC or Z80 assembly, and explore how instructions become changes on the screen.",
  "focus": "The Spectrum connects drawing, colour, keyboard input and sound to a compact machine. Its screen and attribute memory offer concrete ways to investigate representation and the work needed to redraw a moving object.",
  "configuration": "Check the model named by the lesson. The 48K Spectrum is the starting configuration for the introductory material; 128K models and Spectrum Next have different facilities. A modern development tool does not add those facilities to a 48K target.",
  "tracks": [
    {
      "slug": "basic",
      "title": "Sinclair BASIC",
      "description": "Use the Spectrum’s keyword editor and build programs through runnable stages. Explore decisions, loops, drawing and game rules in the built-in language."
    },
    {
      "slug": "assembly",
      "title": "Z80 assembly",
      "description": "Start with Meet Assembly: eight browser experiments in instructions, memory, drawing, input, timing and debugging. Then build Meteor Storm, a timed dodging game, through 24 lessons. Edit and run real Z80 code without installing tools."
    }
  ],
  "references": [
    {
      "href": "/vault/systems/zx-spectrum",
      "title": "ZX Spectrum",
      "description": "The hardware, programming environment and history of the machine."
    },
    {
      "href": "/vault/techniques/attribute-aware-design",
      "title": "Designing with attributes",
      "description": "How colour cells affect the way a game is drawn."
    },
    {
      "href": "/vault/games/manic-miner",
      "title": "Manic Miner",
      "description": "A game to examine for movement, hazards and level design."
    },
    {
      "href": "/vault/magazines/crash-magazine",
      "title": "CRASH",
      "description": "The magazine and its place in Spectrum games culture."
    }
  ]
};
---
<SystemOverview {...overview} />
