---
import Layout from '../../../../layouts/Layout.astro';
import CurriculumPosition from '../../../../components/CurriculumPosition.astro';
import SystemHero from '../../../../components/SystemHero.astro';
import TrackGames from '../../../../components/TrackGames.astro';
import FeatureGrid from '../../../../components/FeatureGrid.astro';
import { getModulesWithAvailability } from '../../../../lib/modules';

const platformColor = '#cc0000';
const allGames = await getModulesWithAvailability('sinclair-zx-spectrum', 'assembly');
const games = allGames.filter(g => g.unitsAvailable > 0);

const specs = [
  { label: 'CPU', value: 'Zilog Z80' },
  { label: 'Speed', value: '3.5 MHz' },
  { label: 'RAM', value: '48 KB' },
  { label: 'Graphics', value: 'ULA' },
  { label: 'Sound', value: 'Beeper' },
];

const features = [
  { title: 'Attribute system', description: "Each 8×8 pixel cell shares INK and PAPER colours. Explore how that affects the shapes, backgrounds and movement you design." },
  { title: 'ULA graphics', description: 'Explore how the display reads bitmap and attribute memory, and why pixel rows are not stored in ordinary screen order.' },
  { title: 'Z80 assembly', description: 'Work with registers, instructions and memory. Z80 knowledge transfers to other Z80 systems; their display, sound and input interfaces need their own code.' },
  { title: 'Software sprites', description: 'Draw moving objects into screen memory. Explore the work needed to preserve a background, detect collisions and update the display in time.' },
];

const memory = [
  { addr: '$0000–$3FFF', desc: 'ROM (16 KB) — BASIC interpreter & system' },
  { addr: '$4000–$57FF', desc: 'Screen bitmap (6144 bytes)' },
  { addr: '$5800–$5AFF', desc: 'Screen attributes (768 bytes)' },
  { addr: '$5B00–$FFFF', desc: 'RAM above the display — shared with BASIC system data, buffers and the stack' },
];
---

<Layout
  title="ZX Spectrum – Learn Z80 Assembly Through Games"
  description="Learn ZX Spectrum Z80 assembly by building complete games. Master the ULA, the attribute system, and software sprites."
  platformColor={platformColor}
>
  <SystemHero
    title="ZX Spectrum assembly"
    subtitle="Learn Z80 assembly by building games"
    kicker="Spectrum · Assembly · Z80"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <CurriculumPosition
      stage="Processor instructions and games"
      title="Spectrum assembly is the concrete Z80 route through the machine."
      body="Write instructions for the Z80, build them into a program, and observe the result on the Spectrum. Games give a purpose to memory layout, graphics, input, sound and timing."
      notes={[
        'You can enter assembly directly; completing Sinclair BASIC is not required.',
        'The current lessons use variables, loops, branches and binary. Foundations offers fuller explanations of those ideas when useful.',
        'The Craft explores design choices such as movement, collision, feedback and challenge.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'Where this track sits' },
        { href: '/foundations', label: 'Foundations', note: 'Programming concepts' },
        { href: '/craft', label: 'The Craft', note: 'Game design' },
      ]}
    />

    <section class="content-section">
      <h2 class="section-title">Before you begin</h2>
      <p class="section-intro">Use an assembler on your host computer to turn source text into a program for the Spectrum target. An emulator lets you run and inspect it. This is cross-development; the setup guide explains the tools and required ROM.</p>
      <a href="/systems/sinclair-zx-spectrum/getting-started" class="btn btn-secondary">Set up your tools →</a>
    </section>

    <section class="content-section">
      <h2 class="section-title">Published lessons and games</h2>
      <p class="section-intro">Meet the Machine is the current introduction. The games below provide guided development sequences; use their descriptions to choose a starting point. Future game choices are still under review.</p>
      <TrackGames games={games} platform="sinclair-zx-spectrum" track="assembly" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">The machine behind the games</h2>
      <p class="section-intro">These are some of the connections between a game and the machine that runs it. Individual lessons develop the details as they become useful.</p>
      <FeatureGrid features={features} platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">Memory map</h2>
      <p class="section-intro">The 48K Spectrum has a 64 KB address space: 16 KB of ROM followed by 48 KB of RAM. The display occupies the first part of RAM; the rest is not automatically free for a program to overwrite.</p>
      <div class="memory-map">
        {memory.map(r => (
          <div class="memory-region"><span class="memory-address">{r.addr}</span><span class="memory-description">{r.desc}</span></div>
        ))}
      </div>
    </section>

    <section class="content-section center">
      <h2 class="section-title">Ready to start?</h2>
      <p class="section-intro">Meet the Machine begins with source code, an assembly step and a visible change to the border. Follow the current introduction, then explore a complete game such as <a href="/systems/sinclair-zx-spectrum/assembly/gloaming">Gloaming</a>.</p>
      <a href="/systems/sinclair-zx-spectrum/assembly/meet-the-machine/unit-01" class="btn btn-primary">Start: Meet the Machine →</a>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--gutter); max-width: var(--container-max-width); margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .content-section.center { text-align: center; }
  .content-section.center .section-intro { margin-left: auto; margin-right: auto; }
  .content-section.center .section-title::after { margin-left: auto; margin-right: auto; }

  .memory-map { display: flex; flex-direction: column; gap: var(--space-2); }
  .memory-region { display: flex; gap: var(--space-4); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--color-surface); border: 3px solid var(--color-border); border-left-width: 6px; border-left-color: var(--platform-color); }
  .memory-address { font-family: var(--font-family-mono); font-weight: 700; color: var(--ink); min-width: 11ch; }
  .memory-description { color: var(--color-text-secondary); }
</style>
