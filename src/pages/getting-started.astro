---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Hero from "../components/Hero.astro";
import JourneySteps from "../components/JourneySteps.astro";
import FAQ from "../components/FAQ.astro";
import Button from "../components/Button.astro";
---

<Layout title="Getting Started">
  <Breadcrumb segments={[{ text: "Getting Started", href: "/getting-started" }]} />

  <div class="container container--narrow">
    <Hero 
      title="Getting Started with Assembly Programming"
      description="Your journey from zero to assembly programmer in 3 simple steps"
      variant="centered"
    />

    <JourneySteps 
      steps={[
        {
          emoji: "1️⃣",
          title: "Setup Your Tools (15 minutes)",
          description: "Install an assembler to write code and an emulator to run it. We've made this painless with Docker or simple local installs.",
          action: {
            text: "🚀 Go to Setup Guide",
            href: "/setup/c64",
            color: "#8b5cf6"
          }
        },
        {
          emoji: "2️⃣",
          title: "Play with the Interactive Demo",
          description: "Understand how memory works by POKEing values directly into C64 screen memory. See immediate results!",
          action: {
            text: "🎮 Try Interactive Demo",
            href: "/#c64-demo",
            color: "#ec4899"
          }
        },
        {
          emoji: "3️⃣",
          title: "Write Your First Program",
          description: "Follow our step-by-step lesson to write, assemble, and run your first C64 program. Change colors, display text, take control!",
          action: {
            text: "📚 Start Lesson 1",
            href: "/lessons/commodore-64/phase-1/tier-1/01-hello-machine",
            color: "#3b82f6"
          }
        }
      ]}
      variant="vertical"
    />

    <div class="workflow-section">
      <h2 class="workflow-title">The Assembly Workflow</h2>
      
      <JourneySteps 
        steps={[
          {
            emoji: "📝",
            title: "Write",
            description: "Assembly code"
          },
          {
            emoji: "⚙️",
            title: "Assemble",
            description: "To machine code"
          },
          {
            emoji: "🎮",
            title: "Run",
            description: "In emulator"
          },
          {
            emoji: "🐛",
            title: "Debug",
            description: "Fix & improve"
          }
        ]}
        variant="workflow"
        showArrows={true}
      />
      
      <p class="workflow-note">
        Each lesson guides you through this cycle, building your skills progressively.
      </p>
    </div>

    <FAQ 
      title="Common Questions"
      items={[
        {
          question: "Do I need to know programming already?",
          answer: "Some programming experience helps, but isn't required. We start from the very beginning and explain everything. If you can follow instructions and type commands, you can learn assembly!"
        },
        {
          question: "Why not use an online emulator?",
          answer: "Local tools give you the authentic experience and full control. You'll learn the real workflow used by developers in the 1980s (with modern conveniences). However, we're working on browser-based options too!"
        },
        {
          question: "How long until I can make games?",
          answer: "You'll display graphics in Lesson 1 (30 minutes). Simple sprite movement by Lesson 3 (2 hours total). A basic playable game by Lesson 10 (1-2 weeks of evenings). The journey is as fun as the destination!"
        },
        {
          question: "Which system should I start with?",
          answer: "The Commodore 64 is our most complete course and the most beginner-friendly with great documentation and a huge community. We're actively developing lessons across all 8 phases, with new content added regularly. NES, ZX Spectrum, and Amiga content is coming soon!"
        }
      ]}
    />

    <div class="cta-banner">
      <h2 class="cta-banner__title">Ready to Start Your Journey?</h2>
      <p class="cta-banner__subtitle">
        Join thousands learning the fundamentals of computing through hands-on assembly programming.
      </p>
      <div class="btn-group btn-group--centered">
        <Button
          href="/setup/c64"
          variant="secondary"
          size="large"
          class="btn btn--primary btn--lg"
        >
          🚀 Setup Tools Now
        </Button>
        <Button
          href="/#c64-demo"
          variant="outline"
          size="large"
          class="btn btn--outline-white btn--lg"
        >
          🎮 Try Demo First
        </Button>
      </div>
    </div>
  </div>
</Layout>
