---
/**
 * Comprehensive test for all Code198x custom languages
 * Tests: C64 BASIC, 6502 Assembly, AMOS BASIC
 */
import { codeToHighlightHtml, codeToHtmlFallback } from 'shiki-highlight-api';

// C64 BASIC sample
const basicCode = `100 REM SPRITE DEMO
110 V=53248:REM VIC-II BASE
120 POKE V+21,1:REM ENABLE SPRITE 0
130 FOR I=0 TO 62
140 POKE 832+I,255:REM SOLID BLOCK
150 NEXT I
160 POKE 2040,13:REM SPRITE POINTER
170 POKE V,100:POKE V+1,100`;

// 6502 Assembly sample
const asm6502Code = `; Simple 6502 sprite setup
LDA #$01        ; Enable sprite 0
STA $D015       ; VIC-II sprite enable

LDA #$00        ; X position low byte
STA $D000
LDA #$00        ; Y position
STA $D001

LDA #$0F        ; White color
STA $D027       ; Sprite 0 color

LDX #$00
loop:
  LDA sprite_data,X
  STA $0340,X   ; Store to memory
  INX
  CPX #$3F
  BNE loop
  RTS

sprite_data:
  .byte $FF,$FF,$FF  ; Solid block pattern`;

// AMOS BASIC sample
const amosCode = `Rem ** Sprite movement demo **
Screen Open 0,320,256,32,Lowres
Curs Off : Cls 0 : Hide

Load "sprites.abk"
Get Sprite Palette

Sprite 0,160,128,1
X=160 : Y=128 : DX=2 : DY=1

Do
  Wait Vbl
  X=X+DX : Y=Y+DY
  If X<16 or X>304 Then DX=-DX
  If Y<16 or Y>240 Then DY=-DY
  Sprite 0,X,Y,1
Loop`;

// Generate all comparisons
const basicTraditional = await codeToHtmlFallback(basicCode, { lang: 'basic', theme: 'dark-plus' });
const basicHighlight = await codeToHighlightHtml(basicCode, { lang: 'basic', theme: 'dark-plus', blockId: 'test-basic' });

const asmTraditional = await codeToHtmlFallback(asm6502Code, { lang: '6502', theme: 'dark-plus' });
const asmHighlight = await codeToHighlightHtml(asm6502Code, { lang: '6502', theme: 'dark-plus', blockId: 'test-6502' });

const amosTraditional = await codeToHtmlFallback(amosCode, { lang: 'amos', theme: 'dark-plus' });
const amosHighlight = await codeToHighlightHtml(amosCode, { lang: 'amos', theme: 'dark-plus', blockId: 'test-amos' });

// Calculate stats
const basicTradNodes = (basicTraditional.match(/<span/g) || []).length;
const asmTradNodes = (asmTraditional.match(/<span/g) || []).length;
const amosTradNodes = (amosTraditional.match(/<span/g) || []).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Languages - CSS Custom Highlight API Test</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
      background: #1e1e1e;
      color: #d4d4d4;
    }
    h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    .subtitle {
      color: #888;
      margin-bottom: 2rem;
    }
    .language-section {
      margin-bottom: 3rem;
      border-top: 2px solid #333;
      padding-top: 2rem;
    }
    .language-section h2 {
      color: #569cd6;
      margin-bottom: 1.5rem;
    }
    .comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-bottom: 2rem;
    }
    .column {
      background: #252526;
      padding: 1.5rem;
      border-radius: 8px;
    }
    .column h3 {
      margin-top: 0;
      font-size: 1rem;
      color: #4ec9b0;
    }
    .stats {
      background: #2d2d30;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1rem;
      font-size: 0.85rem;
    }
    .stats-row {
      display: flex;
      justify-content: space-between;
      padding: 0.25rem 0;
    }
    .stats-label {
      color: #888;
    }
    .stats-value {
      font-weight: bold;
      color: #4ec9b0;
    }
    .highlight {
      color: #ce9178;
      font-weight: bold;
    }
    pre {
      background: #1e1e1e;
      padding: 1rem;
      border-radius: 4px;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.5;
      max-height: 400px;
    }
    code {
      font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    }
    .support-warning {
      background: #f4a900;
      color: #000;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 2rem;
      font-weight: bold;
    }
    .summary {
      background: #252526;
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 2rem;
    }
    .summary h2 {
      color: #4ec9b0;
      margin-top: 0;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-top: 1rem;
    }
    .summary-card {
      background: #2d2d30;
      padding: 1rem;
      border-radius: 4px;
      text-align: center;
    }
    .summary-card .lang-name {
      color: #569cd6;
      font-weight: bold;
      margin-bottom: 0.5rem;
    }
    .summary-card .reduction {
      font-size: 1.5rem;
      color: #ce9178;
      font-weight: bold;
    }
    @media (max-width: 900px) {
      .comparison {
        grid-template-columns: 1fr;
      }
      .summary-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <h1>All Languages - CSS Custom Highlight API Test</h1>
  <p class="subtitle">Testing all Code198x custom languages: C64 BASIC, 6502 Assembly, AMOS BASIC</p>

  <div id="support-check"></div>

  <div class="summary">
    <h2>Performance Summary</h2>
    <div class="summary-grid">
      <div class="summary-card">
        <div class="lang-name">C64 BASIC</div>
        <div class="reduction">{Math.round((1 - basicHighlight.stats.lines / basicTradNodes) * 100)}%</div>
        <div class="stats-label">reduction</div>
        <div class="stats-value">{basicTradNodes} → {basicHighlight.stats.lines} nodes</div>
      </div>
      <div class="summary-card">
        <div class="lang-name">6502 Assembly</div>
        <div class="reduction">{Math.round((1 - asmHighlight.stats.lines / asmTradNodes) * 100)}%</div>
        <div class="stats-label">reduction</div>
        <div class="stats-value">{asmTradNodes} → {asmHighlight.stats.lines} nodes</div>
      </div>
      <div class="summary-card">
        <div class="lang-name">AMOS BASIC</div>
        <div class="reduction">{Math.round((1 - amosHighlight.stats.lines / amosTradNodes) * 100)}%</div>
        <div class="stats-label">reduction</div>
        <div class="stats-value">{amosTradNodes} → {amosHighlight.stats.lines} nodes</div>
      </div>
    </div>
  </div>

  <!-- C64 BASIC Section -->
  <div class="language-section">
    <h2>C64 BASIC</h2>
    <div class="comparison">
      <div class="column">
        <h3>Traditional (Shiki)</h3>
        <div class="stats">
          <div class="stats-row">
            <span class="stats-label">DOM Nodes:</span>
            <span class="stats-value highlight">{basicTradNodes}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Lines:</span>
            <span class="stats-value">{basicCode.split('\n').length}</span>
          </div>
        </div>
        <Fragment set:html={basicTraditional} />
      </div>

      <div class="column">
        <h3>CSS Custom Highlight API</h3>
        <div class="stats">
          <div class="stats-row">
            <span class="stats-label">DOM Nodes:</span>
            <span class="stats-value highlight">{basicHighlight.stats.lines}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Lines:</span>
            <span class="stats-value">{basicCode.split('\n').length}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Tokens:</span>
            <span class="stats-value">{basicHighlight.stats.tokens}</span>
          </div>
        </div>
        <Fragment set:html={basicHighlight.html} />
      </div>
    </div>
  </div>

  <!-- 6502 Assembly Section -->
  <div class="language-section">
    <h2>6502 Assembly</h2>
    <div class="comparison">
      <div class="column">
        <h3>Traditional (Shiki)</h3>
        <div class="stats">
          <div class="stats-row">
            <span class="stats-label">DOM Nodes:</span>
            <span class="stats-value highlight">{asmTradNodes}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Lines:</span>
            <span class="stats-value">{asm6502Code.split('\n').length}</span>
          </div>
        </div>
        <Fragment set:html={asmTraditional} />
      </div>

      <div class="column">
        <h3>CSS Custom Highlight API</h3>
        <div class="stats">
          <div class="stats-row">
            <span class="stats-label">DOM Nodes:</span>
            <span class="stats-value highlight">{asmHighlight.stats.lines}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Lines:</span>
            <span class="stats-value">{asm6502Code.split('\n').length}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Tokens:</span>
            <span class="stats-value">{asmHighlight.stats.tokens}</span>
          </div>
        </div>
        <Fragment set:html={asmHighlight.html} />
      </div>
    </div>
  </div>

  <!-- AMOS BASIC Section -->
  <div class="language-section">
    <h2>AMOS BASIC</h2>
    <div class="comparison">
      <div class="column">
        <h3>Traditional (Shiki)</h3>
        <div class="stats">
          <div class="stats-row">
            <span class="stats-label">DOM Nodes:</span>
            <span class="stats-value highlight">{amosTradNodes}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Lines:</span>
            <span class="stats-value">{amosCode.split('\n').length}</span>
          </div>
        </div>
        <Fragment set:html={amosTraditional} />
      </div>

      <div class="column">
        <h3>CSS Custom Highlight API</h3>
        <div class="stats">
          <div class="stats-row">
            <span class="stats-label">DOM Nodes:</span>
            <span class="stats-value highlight">{amosHighlight.stats.lines}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Lines:</span>
            <span class="stats-value">{amosCode.split('\n').length}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">Tokens:</span>
            <span class="stats-value">{amosHighlight.stats.tokens}</span>
          </div>
        </div>
        <Fragment set:html={amosHighlight.html} />
      </div>
    </div>
  </div>

  <Fragment set:html={basicHighlight.css} />
  <Fragment set:html={basicHighlight.script} />
  <Fragment set:html={asmHighlight.css} />
  <Fragment set:html={asmHighlight.script} />
  <Fragment set:html={amosHighlight.css} />
  <Fragment set:html={amosHighlight.script} />

  <script define:vars={{
    basicTrad: basicTradNodes,
    basicHL: basicHighlight.stats.lines,
    asmTrad: asmTradNodes,
    asmHL: asmHighlight.stats.lines,
    amosTrad: amosTradNodes,
    amosHL: amosHighlight.stats.lines
  }}>
    // Check browser support
    const supportDiv = document.getElementById('support-check');
    if (!CSS.highlights) {
      supportDiv.innerHTML = `
        <div class="support-warning">
          ⚠️ Your browser doesn't support CSS Custom Highlight API.
          The right columns will not show syntax highlighting.
          Try Chrome 105+, Firefox 140+, or Safari 17.2+
        </div>
      `;
    }

    // Performance measurement
    console.group('Performance Comparison - All Languages');
    console.log('C64 BASIC:', basicTrad, '→', basicHL, 'nodes', '(' + Math.round((1-basicHL/basicTrad)*100) + '% reduction)');
    console.log('6502 ASM:', asmTrad, '→', asmHL, 'nodes', '(' + Math.round((1-asmHL/asmTrad)*100) + '% reduction)');
    console.log('AMOS:', amosTrad, '→', amosHL, 'nodes', '(' + Math.round((1-amosHL/amosTrad)*100) + '% reduction)');
    console.groupEnd();
  </script>
</body>
</html>
