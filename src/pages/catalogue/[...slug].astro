---
/**
 * The 198x-ui component catalogue, mounted for development only.
 *
 * The kit cannot render itself, so each site that wants to see its components
 * in every variant mounts the kit's Catalogue on a route of its own. This one
 * exists under `astro dev` and nowhere else: in a production build
 * getStaticPaths returns nothing, so no catalogue page reaches dist/, the
 * sitemap or the search index. Nothing links to it.
 *
 * It deliberately skips the site Layout. The catalogue shows kit components on
 * the site's tokens and fonts, which is what this document sets
 * up; the site's own nav and footer would only be noise around them.
 *
 * /catalogue/ is the index; /catalogue/<entry>/ is one entry alone, which the
 * index loads into its width-preset frames.
 */
import '@198x-ui/tokens.css';
import '@198x-ui/fonts.css';
import PageFrameSpecimen from '../../components/PageFrameSpecimen.astro';
import TimelineStories from '../../components/TimelineStories.astro';
import TimelineEvents from '../../components/TimelineEvents.astro';
import TrackGames from '../../components/TrackGames.astro';
import { getModulesWithCounts } from '../../lib/modules';
import { timelineEvents, resolveStories } from '../../lib/timeline';
import { timelineStories } from '../../data/timeline-stories';
import '../../styles/timeline.css';
import '../../styles/design-rollout.css';
import SetupBrowserStarts from '../../components/SetupBrowserStarts.astro';
import SetupToolInstall from '../../components/SetupToolInstall.astro';
import '../../styles/setup.css';
import PatternDirectory from '../../components/PatternDirectory.astro';
import PatternExample from '../../components/PatternExample.astro';
import '../../styles/pattern-library.css';
import Wordmark from '../../components/Wordmark.astro';
import BasicAndRun from '../../components/BasicAndRun.astro';
import HardwarePhoto from '../../components/HardwarePhoto.astro';
import VaultExplorer from '../../components/VaultExplorer.astro';
import VaultFeature from '../../components/VaultFeature.astro';
import VaultArticleConnections from '../../components/VaultArticleConnections.astro';
import VaultArticleHeader from '../../components/VaultArticleHeader.astro';
import VaultDirectory from '../../components/VaultDirectory.astro';
import VaultReadingPaths from '../../components/VaultReadingPaths.astro';
import { colourClashConnections, techniquePaths } from '../../data/vault-reading-paths';
import '../../styles/vault-inner.css';
import { getCollection } from 'astro:content';
import { vaultExploration, vaultFeatures } from '../../data/vault-features';
import { resolveVaultExploration, resolveVaultFeatures } from '../../lib/vault-features';
import { getVaultCategories } from '../../lib/categories';
import '../../styles/vault.css';
import '../../styles/site-tokens.css';
import Catalogue from '@198x-ui/catalogue/Catalogue.astro';
import { catalogueEntries } from '@198x-ui/catalogue/entries';

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return [
    { params: { slug: undefined } },
    { params: { slug: 'code-learning' } },
    { params: { slug: 'page-frame' } },
    { params: { slug: 'setup' } },
    { params: { slug: 'timeline' } },
    { params: { slug: 'vault-discovery' } },
    { params: { slug: 'vault-reading' } },
    { params: { slug: 'pattern-library' } },
    ...catalogueEntries.map((e) => ({ params: { slug: e.slug } })),
  ];
}

const { slug } = Astro.params;
const title = slug === 'page-frame' ? 'Page frame components' : slug === 'timeline' ? 'Timeline and game preview components' : slug === 'setup' ? 'Setup components' : slug === 'pattern-library' ? 'Pattern Library components' : slug === 'vault-reading' ? 'Vault reading components' : slug === 'vault-discovery' ? 'Vault discovery components' : slug === 'code-learning' ? 'Code198x learning components' : slug
  ? `${catalogueEntries.find((e) => e.slug === slug)?.title} · 198x-ui catalogue`
  : '198x-ui catalogue';
const vaultEntries = ['vault-discovery', 'vault-reading', 'timeline'].includes(slug ?? '') ? await getCollection('vault') : [];
const exploration = slug === 'vault-discovery' ? resolveVaultExploration(vaultExploration, vaultEntries) : undefined;
const feature = ['vault-discovery', 'vault-reading'].includes(slug ?? '') ? resolveVaultFeatures(vaultFeatures, vaultEntries)[0] : undefined;
const articleConnections = slug === 'vault-reading' ? resolveVaultExploration(colourClashConnections, vaultEntries).connections : [];
const readingEntries = vaultEntries.filter(entry => entry.data.category === 'techniques').sort((a, b) => a.data.title.localeCompare(b.data.title));
const readingPaths = techniquePaths.map(path => ({...path, title: vaultEntries.find(entry => entry.id === path.article)?.data.title ?? ''}));
const stories = slug === 'timeline' ? resolveStories(timelineStories, vaultEntries) : [];
const sampleEvents = slug === 'timeline' ? timelineEvents(vaultEntries, []).filter(event=>event.year===1985&&event.reviewed).slice(0,4) : [];
const previewGames = slug === 'timeline' ? (await getModulesWithCounts('sinclair-zx-spectrum','basic')).slice(0,2) : [];
const categories = slug === 'vault-discovery' ? (await getVaultCategories()).map(category => ({id: category.id, name: category.data.name})) : [];
---

<!DOCTYPE html>
<html lang="en-GB" data-project="code">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class:list={{'magazine':slug === 'timeline', 'code-catalogue':slug === 'page-frame' || slug === 'timeline' || slug === 'setup' || slug === 'pattern-library' || slug === 'code-learning' || slug === 'vault-discovery' || slug === 'vault-reading', 'vault-preview':slug === 'vault-discovery'}}>
    {slug === 'page-frame' ? <PageFrameSpecimen/> : slug === 'timeline' ? <main class="timeline-page"><h1>Timeline and game preview components</h1><p><a href="/catalogue/">Family components</a> · <a href="/timeline/">Timeline</a></p><TimelineStories stories={stories} compact/><section><h2>Chronology controls and events</h2><TimelineEvents events={sampleEvents} labels={{games:'Games',systems:'Systems'}}/></section><section><h2>Game previews</h2><TrackGames games={previewGames} platform="sinclair-zx-spectrum" track="basic" platformColor="#b33100" appearance="house"/></section></main> : slug === 'setup' ? <main class="setup-page"><header class="setup-header"><h1>Setup components</h1><p><a href="/catalogue/">Family components</a> · <a href="/setup/">Setup guide</a></p></header><div class="setup-content"><h2>Browser starts</h2><SetupBrowserStarts/><h2>Optional local installation</h2><SetupToolInstall tool="asm198x"/><SetupToolInstall tool="build198x"/></div></main> : slug === 'pattern-library' ? <main class="pattern-preview"><h1>Pattern Library components</h1><p><a href="/catalogue/">Family components</a> · <a href="/patterns/">Pattern Library</a></p><section><h2>Algorithm illustration</h2><PatternExample/></section><section><PatternDirectory/></section></main> : slug === 'vault-reading' && feature ? <main class="vault-reading-preview" data-vault-colour="craft">
      <p><a href="/catalogue/">Family components</a> · <a href="/vault/category/techniques/">Techniques category</a></p>
      <section><h2>Article opening with an original capture</h2><VaultArticleHeader title={feature.entry.data.title} subtitle={feature.entry.data.subtitle} summary={feature.entry.data.summary} category={{name:'Techniques', slug:'techniques'}} reviewed={true} image={feature.images.at(-1)}/></section>
      <section><h2>Explained article connections</h2><VaultArticleConnections connections={articleConnections}/></section>
      <section><h2>Question-led browsing</h2><VaultReadingPaths paths={readingPaths}/></section>
      <section><h2>Complete category directory</h2><VaultDirectory category="Techniques" entries={readingEntries}/></section>
    </main> : slug === 'vault-discovery' && exploration && feature ? <main class="vault-index">
      <h1>Vault discovery components</h1>
      <p><a href="/catalogue/">Family components</a> · <a href="/vault/">Vault homepage</a></p>
      <section><h2>Connected subject explorer</h2><VaultExplorer exploration={exploration} categories={categories}/></section>
      <section><h2>Article-owned captures and captions</h2><VaultFeature feature={feature} categoryName="Techniques"/></section>
    </main> : slug === 'code-learning' ? <main style="max-width:1200px;margin:auto;padding:24px">
      <h1>Code198x learning components</h1><p><a href="/catalogue/">Family components</a> · <a href="/">Website</a></p>
      <section><h2>Wordmark</h2><Wordmark/></section>
      <section><h2>Machine photograph and attribution</h2><div style="max-width:480px"><HardwarePhoto system="commodore-64"/></div></section>
      <section><h2>Editable BASIC and modal</h2><BasicAndRun src="sinclair-zx-spectrum/basic/meet-basic/opening/unit-01/steps/step-04.bas" name="greeting-preview"/></section>
      <section><h2>A second independent listing</h2><BasicAndRun src="sinclair-zx-spectrum/basic/meet-basic/opening/unit-01/steps/step-04.bas" name="second-preview" keypad/></section>
    </main> : <><p style="padding:16px"><a href="/catalogue/page-frame/">Page frames</a> · <a href="/catalogue/timeline/">Timeline and game previews</a> · <a href="/catalogue/setup/">Setup components</a> · <a href="/catalogue/pattern-library/">Pattern Library components</a> · <a href="/catalogue/code-learning/">Code198x learning components</a> · <a href="/catalogue/vault-discovery/">Vault discovery components</a> · <a href="/catalogue/vault-reading/">Vault reading components</a></p><Catalogue base="/catalogue" entry={slug} /></>}
  </body>
</html>

<style is:global>
.code-catalogue{margin:0;background:var(--h-page);color:var(--h-ink);font:1rem/1.6 var(--h-font-ui)}
.code-catalogue *{box-sizing:border-box}.code-catalogue main>p a{color:var(--h-spot-ink)}
.code-catalogue main>section{margin-top:48px}.code-catalogue main>h1{font:italic 900 3rem/1.1 var(--h-font-mag)}
</style>
