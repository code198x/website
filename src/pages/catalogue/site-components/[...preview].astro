---
/** Development-only, like the family catalogue; the production build emits no route. */
import Layout from '../../../layouts/Layout.astro';
import SiteComponentsSpecimen from '../../../components/SiteComponentsSpecimen.astro';
export function getStaticPaths() {
  return import.meta.env.PROD ? [] : [{ params: { preview: undefined } }];
}
---
<Layout title="Site components" masthead={false} noindex>
  <SiteComponentsSpecimen />
</Layout>
