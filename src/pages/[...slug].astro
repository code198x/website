---
/**
 * Catch-all route for content collection pages.
 *
 * Replaces 578 MDX files that were previously in src/pages/.
 * Computes layout, prev/next links, totalUnits, system, and gameName
 * from the entry's path instead of duplicating in frontmatter.
 */
import { getCollection, render } from 'astro:content';
import UnitLayout from '../layouts/UnitLayout.astro';
import ModuleLayout from '../layouts/ModuleLayout.astro';
import SectionIndexLayout from '../layouts/SectionIndexLayout.astro';
import GettingStartedLayout from '../layouts/GettingStartedLayout.astro';
import { getUnitsEntry } from '../lib/units';
import { getSection } from '../lib/sections';

type PageType = 'unit' | 'game' | 'getting-started';

interface PageEntry {
  type: PageType;
  entry: any;
  slug: string;
}

export async function getStaticPaths() {
  const [unitEntries, gameEntries, gettingStartedEntries] = await Promise.all([
    getCollection('unit-pages'),
    getCollection("module-pages"),
    getCollection('getting-started-pages'),
  ]);

  const paths: Array<{ params: { slug: string }; props: PageEntry }> = [];

  for (const entry of unitEntries) {
    paths.push({
      params: { slug: entry.id },
      props: { type: 'unit', entry, slug: entry.id },
    });
  }

  for (const entry of gameEntries) {
    // index.mdx: ID "commodore-64/assembly/game-01-starfield/index" → URL without /index
    const slug = entry.id.replace(/\/index$/, '');
    paths.push({
      params: { slug },
      props: { type: 'game', entry, slug },
    });
  }

  for (const entry of gettingStartedEntries) {
    paths.push({
      params: { slug: entry.id },
      props: { type: 'getting-started', entry, slug: entry.id },
    });
  }

  return paths;
}

const { type, entry, slug } = Astro.props;
const { Content } = await render(entry);

// Parse path segments
const pathParts = slug.split('/');
const platformSlug = pathParts[0] || '';
const trackPath = pathParts[1] || '';
const moduleSlug = pathParts[2] || '';

// Cross-platform sections (Foundations) are laid out one level shallower —
// {section}/{module}/unit-NN — so the module slug sits at index 1, and counts are
// derived straight from the unit pages rather than a units catalogue.
const section = getSection(platformSlug);
const sectionModuleSlug = trackPath; // {section}/{module}/...
const effectiveModuleSlug = section ? sectionModuleSlug : moduleSlug;

// Look up unit counts (for unit and game pages)
let totalUnits = 8; // fallback — total defined in curriculum
let availableUnits = 0; // how many have content (available: true)
// Ordered unit roster for a section index page (number, title, href).
let sectionUnits: Array<{ number: number; title: string; href: string }> = [];
if (section && (type === 'unit' || type === 'game')) {
  const allUnitPages = await getCollection('unit-pages');
  const prefix = `${platformSlug}/${effectiveModuleSlug}/unit-`;
  const inModule = allUnitPages.filter((u) => u.id.startsWith(prefix));
  totalUnits = inModule.length;
  availableUnits = inModule.length; // section content ships complete
  sectionUnits = inModule
    .map((u) => ({
      number: u.data.unit as number,
      title: u.data.title as string,
      href: `/${u.id}`,
    }))
    .sort((a, b) => a.number - b.number);
} else if ((type === 'unit' || type === 'game') && platformSlug && trackPath && moduleSlug) {
  const unitsEntry = await getUnitsEntry(
    platformSlug,
    trackPath as 'assembly' | 'basic' | 'amos' | 'blitz',
    moduleSlug
  );
  if (unitsEntry) {
    totalUnits = unitsEntry.data.units.length;
    availableUnits = unitsEntry.data.units.filter((u: { available?: boolean }) => u.available).length;
  }
}

// Compute prev/next navigation for unit pages
// Uses availableUnits (not totalUnits) so we never link to unpublished content
function computeUnitNav(unitNumber: number, available: number) {
  const basePath = slug.replace(/\/unit-\d+$/, '');
  const prevNum = unitNumber - 1;
  const nextNum = unitNumber + 1;

  return {
    prevLesson: prevNum >= 1
      ? `/${basePath}/unit-${String(prevNum).padStart(2, '0')}`
      : undefined,
    nextLesson: nextNum <= available
      ? `/${basePath}/unit-${String(nextNum).padStart(2, '0')}`
      : undefined,
  };
}

// "game-01-starfield" → "Starfield"; acronyms keep their casing ("meet-basic" → "Meet BASIC")
const MODULE_NAME_ACRONYMS: Record<string, string> = { basic: 'BASIC', amos: 'AMOS', nes: 'NES', zx: 'ZX' };
function formatModuleName(moduleSlug: string): string {
  return moduleSlug
    .replace(/^game-\d+-/, '')
    .split('-')
    .map(word => MODULE_NAME_ACRONYMS[word] ?? word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}
---

{type === 'unit' && (() => {
  const { prevLesson, nextLesson } = computeUnitNav(entry.data.unit, availableUnits);
  const gameName = formatModuleName(effectiveModuleSlug);
  return (
    <UnitLayout
      title={entry.data.title}
      description={entry.data.description}
      game={entry.data.game}
      gameName={gameName}
      unit={entry.data.unit}
      totalUnits={totalUnits}
      nextLesson={nextLesson}
      prevLesson={prevLesson}
      learningTime={entry.data.learningTime}
    >
      <Content />
    </UnitLayout>
  );
})()}

{type === 'game' && section && (
  <SectionIndexLayout
    title={entry.data.title}
    description={entry.data.description}
    units={sectionUnits}
  >
    <Content />
  </SectionIndexLayout>
)}

{type === 'game' && !section && (
  <ModuleLayout
    title={entry.data.title}
    description={entry.data.description}
    game={entry.data.game}
    gameName={entry.data.title}
    totalUnits={totalUnits}
    heroImage={entry.data.heroImage}
    heroAlt={entry.data.heroAlt}
    units={entry.data.units}
  >
    <Content />
  </ModuleLayout>
)}

{type === 'getting-started' && (
  <GettingStartedLayout
    frontmatter={{
      title: entry.data.title,
      description: entry.data.description,
      system: platformSlug,
      systemSlug: entry.data.systemSlug,
      accentColor: entry.data.accentColor,
    }}
  >
    <Content />
  </GettingStartedLayout>
)}
