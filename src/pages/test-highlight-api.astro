---
/**
 * Test page for CSS Custom Highlight API implementation
 * Compares traditional Shiki (DOM spans) vs Highlight API
 */
import { codeToHighlightHtml, codeToHtmlFallback } from 'shiki-highlight-api';

// Sample BASIC code (C64 BASIC)
const basicCode = `100 REM BULLET HELL SHOOTER
110 REM FAST ACTION WITH 50 BULLETS
120 DIM BX(50),BY(50),BVX(50),BVY(50),BA(50)
130 NB=0:REM NUMBER OF BULLETS
140 PX=20:PY=20:REM PLAYER POSITION
150 SC=0:LV=1:REM SCORE AND LEVEL
160 GOSUB 9000:REM INIT
170 REM MAIN LOOP
180 GOSUB 1000:REM INPUT
190 GOSUB 2000:REM UPDATE
200 GOSUB 3000:REM DRAW
210 GOTO 180

1000 REM INPUT
1010 K=PEEK(197)
1020 IF K=9 THEN PY=PY-1:IF PY<1 THEN PY=1
1030 IF K=41 THEN PY=PY+1:IF PY>24 THEN PY=24
1040 IF K=1 THEN PX=PX-1:IF PX<0 THEN PX=0
1050 IF K=2 THEN PX=PX+1:IF PX>39 THEN PX=39
1060 IF K=57 AND NB<50 THEN GOSUB 1100
1070 RETURN
1100 REM SPAWN BULLET
1110 NB=NB+1
1120 BX(NB)=PX:BY(NB)=PY-1
1130 BVX(NB)=0:BVY(NB)=-1
1140 BA(NB)=1:REM ACTIVE
1150 RETURN`;

// Generate traditional Shiki HTML
const traditionalHtml = await codeToHtmlFallback(basicCode, {
  lang: 'basic',
  theme: 'dark-plus',
});

// Generate Highlight API version
const highlightResult = await codeToHighlightHtml(basicCode, {
  lang: 'basic',
  theme: 'dark-plus',
  blockId: 'test-basic',
});

// Calculate DOM node count for traditional approach
const traditionalNodeCount = (traditionalHtml.match(/<span/g) || []).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CSS Custom Highlight API Test</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
      background: #1e1e1e;
      color: #d4d4d4;
    }
    h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    .subtitle {
      color: #888;
      margin-bottom: 2rem;
    }
    .comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-bottom: 2rem;
    }
    .column {
      background: #252526;
      padding: 1.5rem;
      border-radius: 8px;
    }
    .column h2 {
      margin-top: 0;
      font-size: 1.25rem;
      color: #569cd6;
    }
    .stats {
      background: #2d2d30;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1rem;
      font-size: 0.9rem;
    }
    .stats-row {
      display: flex;
      justify-content: space-between;
      padding: 0.25rem 0;
    }
    .stats-label {
      color: #888;
    }
    .stats-value {
      font-weight: bold;
      color: #4ec9b0;
    }
    .highlight {
      color: #ce9178;
      font-weight: bold;
    }
    pre {
      background: #1e1e1e;
      padding: 1rem;
      border-radius: 4px;
      overflow-x: auto;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    code {
      font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    }
    .support-warning {
      background: #f4a900;
      color: #000;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 2rem;
      font-weight: bold;
    }
    @media (max-width: 900px) {
      .comparison {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <h1>CSS Custom Highlight API Test</h1>
  <p class="subtitle">Comparing traditional DOM-based highlighting vs CSS Custom Highlight API (C64 BASIC sample)</p>

  <div id="support-check"></div>

  <div class="comparison">
    <div class="column">
      <h2>Traditional (Shiki with DOM spans)</h2>
      <div class="stats">
        <div class="stats-row">
          <span class="stats-label">DOM Nodes:</span>
          <span class="stats-value highlight">{traditionalNodeCount}</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Lines of Code:</span>
          <span class="stats-value">{basicCode.split('\n').length}</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Approach:</span>
          <span class="stats-value">Wrap each token in &lt;span&gt;</span>
        </div>
      </div>
      <Fragment set:html={traditionalHtml} />
    </div>

    <div class="column">
      <h2>CSS Custom Highlight API</h2>
      <div class="stats">
        <div class="stats-row">
          <span class="stats-label">DOM Nodes:</span>
          <span class="stats-value highlight">{highlightResult.stats.lines}</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Lines of Code:</span>
          <span class="stats-value">{basicCode.split('\n').length}</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Tokens:</span>
          <span class="stats-value">{highlightResult.stats.tokens}</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Unique Colors:</span>
          <span class="stats-value">{highlightResult.stats.uniqueStyles}</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Approach:</span>
          <span class="stats-value">Range objects + ::highlight()</span>
        </div>
        <div class="stats-row">
          <span class="stats-label">Reduction:</span>
          <span class="stats-value highlight">{Math.round((1 - highlightResult.stats.lines / traditionalNodeCount) * 100)}% fewer nodes</span>
        </div>
      </div>
      <Fragment set:html={highlightResult.html} />
    </div>
  </div>

  <Fragment set:html={highlightResult.css} />
  <Fragment set:html={highlightResult.script} />

  <script define:vars={{ traditionalNodeCount, highlightLines: highlightResult.stats.lines, reductionPct: Math.round((1 - highlightResult.stats.lines / traditionalNodeCount) * 100) }}>
    // Check browser support
    const supportDiv = document.getElementById('support-check');
    if (!CSS.highlights) {
      supportDiv.innerHTML = `
        <div class="support-warning">
          ⚠️ Your browser doesn't support CSS Custom Highlight API.
          The right column will not show syntax highlighting.
          Try Chrome 105+, Firefox 140+, or Safari 17.2+
        </div>
      `;
    }

    // Performance measurement
    console.group('Performance Comparison');
    console.log('Traditional approach: ' + traditionalNodeCount + ' DOM nodes');
    console.log('Highlight API: ' + highlightLines + ' DOM nodes');
    console.log('Reduction: ' + reductionPct + '%');
    console.groupEnd();
  </script>
</body>
</html>
