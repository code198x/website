---
import { getCollection, getEntry } from 'astro:content';
import LessonLayout from '../../../../../layouts/LessonLayout.astro';

export async function getStaticPaths() {
  // Get all lessons from the content collection that are Phase 0
  const allLessons = await getCollection('lessons');
  const phase0Lessons = allLessons.filter(lesson => 
    (lesson.data.phase === 0 || lesson.data.phase_number === 0) &&
    lesson.data.platform // Ensure it has a platform field (Phase 0 format)
  );
  
  // Also generate static paths for platforms that might not have content yet
  const platforms = [
    'c64', 'spectrum', 'amiga', 'bbcmicro', 'amstradcpc', 'appleii', 
    'atarist', 'atari800', 'ti994a', 'dragon', 'jupiterace'
  ];
  
  const staticPaths = [];
  
  // Add existing lessons from content collection
  phase0Lessons.forEach(lesson => {
    const platform = lesson.data.platform || lesson.data.system;
    const tier = lesson.data.tier || lesson.data.tier_number;
    const lessonNum = lesson.data.lesson || lesson.data.lesson_number;
    
    staticPaths.push({
      params: {
        system: platform,
        tier: `tier-${tier}`,
        lesson: `lesson-${String(lessonNum).padStart(2, '0')}`
      },
      props: {
        lesson,
        platform,
        tierNumber: tier,
        lessonNumber: lessonNum
      }
    });
  });
  
  // Generate placeholder paths for all platforms/tiers/lessons for development
  platforms.forEach(platform => {
    for (let tier = 1; tier <= 8; tier++) {
      for (let lesson = 1; lesson <= 16; lesson++) {
        const existingPath = staticPaths.find(path => 
          path.params.system === platform &&
          path.params.tier === `tier-${tier}` &&
          path.params.lesson === `lesson-${String(lesson).padStart(2, '0')}`
        );
        
        if (!existingPath) {
          staticPaths.push({
            params: {
              system: platform,
              tier: `tier-${tier}`,
              lesson: `lesson-${String(lesson).padStart(2, '0')}`
            },
            props: {
              lesson: null, // No content yet
              platform,
              tierNumber: tier,
              lessonNumber: lesson
            }
          });
        }
      }
    }
  });
  
  return staticPaths;
}

const { lesson, platform, tierNumber, lessonNumber } = Astro.props;

// Platform display names and configuration
const platformInfo = {
  'c64': { 
    name: 'Commodore 64', 
    lang: 'BASIC',
    color: 'border-c64-blue',
    bgColor: 'bg-c64-blue/10',
    textColor: 'text-c64-blue'
  },
  'spectrum': { 
    name: 'ZX Spectrum', 
    lang: 'BASIC',
    color: 'border-spectrum-blue',
    bgColor: 'bg-spectrum-blue/10', 
    textColor: 'text-spectrum-blue'
  },
  'amiga': { 
    name: 'Commodore Amiga', 
    lang: 'AMOS BASIC',
    color: 'border-amiga-orange',
    bgColor: 'bg-amiga-orange/10',
    textColor: 'text-amiga-orange'
  },
  'bbcmicro': { 
    name: 'BBC Micro', 
    lang: 'BBC BASIC',
    color: 'border-red-600',
    bgColor: 'bg-red-50',
    textColor: 'text-red-600'
  },
  'amstradcpc': { 
    name: 'Amstrad CPC', 
    lang: 'Locomotive BASIC',
    color: 'border-green-600',
    bgColor: 'bg-green-50',
    textColor: 'text-green-600'
  },
  'appleii': { 
    name: 'Apple II', 
    lang: 'Applesoft BASIC',
    color: 'border-blue-600',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-600'
  },
  'atarist': { 
    name: 'Atari ST', 
    lang: 'GFA BASIC',
    color: 'border-gray-600',
    bgColor: 'bg-gray-50',
    textColor: 'text-gray-600'
  },
  'atari800': { 
    name: 'Atari 800', 
    lang: 'Atari BASIC',
    color: 'border-red-700',
    bgColor: 'bg-red-50',
    textColor: 'text-red-700'
  },
  'ti994a': { 
    name: 'TI-99/4A', 
    lang: 'TI Extended BASIC',
    color: 'border-blue-700',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-700'
  },
  'dragon': { 
    name: 'Dragon 32/64', 
    lang: 'Dragon BASIC',
    color: 'border-yellow-700',
    bgColor: 'bg-yellow-50',
    textColor: 'text-yellow-700'
  },
  'jupiterace': { 
    name: 'Jupiter ACE', 
    lang: 'Forth',
    color: 'border-purple-600',
    bgColor: 'bg-purple-50',
    textColor: 'text-purple-600'
  }
};

const currentPlatform = platformInfo[platform as keyof typeof platformInfo] || {
  name: platform.toUpperCase(),
  lang: 'BASIC',
  color: 'border-gray-600',
  bgColor: 'bg-gray-50',
  textColor: 'text-gray-600'
};

// If we have actual lesson content, use it. Otherwise, create placeholder content.
let frontmatter, Content;

if (lesson) {
  // Actual lesson content from collection
  const rendered = await lesson.render();
  Content = rendered.Content;
  frontmatter = {
    title: lesson.data.title,
    platform: lesson.data.platform || lesson.data.system,
    phase: lesson.data.phase || lesson.data.phase_number,
    tier: lesson.data.tier || lesson.data.tier_number,
    lesson: lesson.data.lesson || lesson.data.lesson_number,
    description: lesson.data.description,
    ...lesson.data
  };
} else {
  // Placeholder content for development/preview
  const placeholderTitle = `Lesson ${String(lessonNumber).padStart(2, '0')} - Coming Soon`;
  
  frontmatter = {
    title: placeholderTitle,
    platform,
    phase: 0,
    tier: tierNumber,
    lesson: lessonNumber,
    description: `Lesson ${lessonNumber} for ${currentPlatform.name} Phase 0 Tier ${tierNumber}`,
    challenges: [
      "Try modifying the programs",
      "Create your own variations",
      "Experiment with different values"
    ],
    common_problems: [
      {
        problem: "Program won't run",
        solution: "Check you typed everything exactly as shown"
      }
    ],
    fun_fact: `The ${currentPlatform.name} was released in the 1980s and taught millions to program!`,
    download_links: [
      {
        name: `lesson${String(lessonNumber).padStart(3, '0')}`,
        url: `/downloads/${platform}/phase0/tier${tierNumber}/lesson${String(lessonNumber).padStart(3, '0')}.bas`,
        type: 'bas'
      }
    ]
  };
  
  // Create placeholder content component
  Content = () => null;
}

const title = `${frontmatter.title} | ${currentPlatform.name} Phase 0`;
---

<LessonLayout frontmatter={frontmatter}>
  {lesson ? (
    <Content />
  ) : (
    <!-- Placeholder content -->
    <div class="max-w-4xl mx-auto">
      <!-- ASCII Art Title Box -->
      <pre class="text-center text-green-400 bg-black p-4 rounded-lg mb-8 font-mono text-sm">
╔════════════════════════════════════════╗
║                                        ║
║   LESSON {String(lessonNumber).padStart(2, '0')}: COMING SOON           ║
║                                        ║
║   {currentPlatform.name.padEnd(26)} ║
║                                        ║
╚════════════════════════════════════════╝
      </pre>

      <p class="text-lg text-gray-600 mb-8 text-center">
        This lesson is being prepared and will be available soon. It will follow the classic Usborne style 
        with 6 complete programs that build your {currentPlatform.lang} programming skills.
      </p>

      <!-- Placeholder program structure -->
      <div class="space-y-8">
        <div class={`p-6 rounded-xl border-2 ${currentPlatform.color} ${currentPlatform.bgColor}`}>
          <h2 class={`text-xl font-bold ${currentPlatform.textColor} mb-4`}>What You'll Learn</h2>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h3 class="font-semibold mb-2">Program Types</h3>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>• Simple demonstrations</li>
                <li>• Interactive programs</li>
                <li>• Visual effects</li>
                <li>• Practical utilities</li>
              </ul>
            </div>
            <div>
              <h3 class="font-semibold mb-2">Key Concepts</h3>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>• {currentPlatform.lang} commands</li>
                <li>• Programming logic</li>
                <li>• Problem solving</li>
                <li>• Code structure</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Sample program structure preview -->
        <div class="bg-gray-50 rounded-xl p-6">
          <h2 class="text-xl font-bold text-gray-800 mb-4">Lesson Structure Preview</h2>
          <div class="grid md:grid-cols-3 gap-4">
            {Array.from({ length: 6 }, (_, i) => (
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <h3 class="font-semibold text-gray-700 mb-2">Program {i + 1}</h3>
                <div class="bg-gray-100 rounded p-3 font-mono text-sm text-gray-600">
                  <div>10 REM PROGRAM {i + 1}</div>
                  <div>20 PRINT "COMING SOON"</div>
                  <div>30 REM ...</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Development notice -->
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 text-center">
          <div class="text-4xl mb-3">🚧</div>
          <h3 class="text-xl font-bold text-blue-800 mb-3">Lesson in Development</h3>
          <p class="text-blue-700 mb-4">
            This lesson is currently being created following the authentic Usborne Computer Programming style.
            Each lesson will contain exactly 6 programs with detailed explanations.
          </p>
          <p class="text-blue-600 text-sm">
            Want to be notified when this lesson is ready? 
            <a href="/about#contact" class="underline hover:no-underline">Get in touch!</a>
          </p>
        </div>
      </div>
    </div>
  )}
</LessonLayout>