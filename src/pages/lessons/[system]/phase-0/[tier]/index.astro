---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  // For Phase 0, we generate static paths for all platforms and their 8 tiers
  const platforms = [
    'c64', 'spectrum', 'amiga', 'bbcmicro', 'amstradcpc', 'appleii', 
    'atarist', 'atari800', 'ti994a', 'dragon', 'jupiterace'
  ];
  
  const paths = [];
  
  for (const platform of platforms) {
    for (let tierNum = 1; tierNum <= 8; tierNum++) {
      paths.push({
        params: { 
          system: platform,
          tier: `tier-${tierNum}`
        },
        props: { 
          platform,
          tierNumber: tierNum
        }
      });
    }
  }
  
  return paths;
}

const { platform, tierNumber } = Astro.props;

// Platform display names and configuration
const platformInfo = {
  'c64': { 
    name: 'Commodore 64', 
    lang: 'BASIC',
    color: 'border-c64-blue',
    bgColor: 'bg-c64-blue/10',
    textColor: 'text-c64-blue',
    gradientFrom: 'from-c64-blue',
    gradientTo: 'to-c64-dark-blue',
    accent: 'bg-c64-blue'
  },
  'spectrum': { 
    name: 'ZX Spectrum', 
    lang: 'BASIC',
    color: 'border-spectrum-blue',
    bgColor: 'bg-spectrum-blue/10', 
    textColor: 'text-spectrum-blue',
    gradientFrom: 'from-spectrum-blue',
    gradientTo: 'to-spectrum-red',
    accent: 'bg-spectrum-blue'
  },
  'amiga': { 
    name: 'Commodore Amiga', 
    lang: 'AMOS BASIC',
    color: 'border-amiga-orange',
    bgColor: 'bg-amiga-orange/10',
    textColor: 'text-amiga-orange',
    gradientFrom: 'from-amiga-orange',
    gradientTo: 'to-amiga-red',
    accent: 'bg-amiga-orange'
  },
  'bbcmicro': { 
    name: 'BBC Micro', 
    lang: 'BBC BASIC',
    color: 'border-red-600',
    bgColor: 'bg-red-50',
    textColor: 'text-red-600',
    gradientFrom: 'from-red-600',
    gradientTo: 'to-red-800',
    accent: 'bg-red-600'
  },
  'amstradcpc': { 
    name: 'Amstrad CPC', 
    lang: 'Locomotive BASIC',
    color: 'border-green-600',
    bgColor: 'bg-green-50',
    textColor: 'text-green-600',
    gradientFrom: 'from-green-600',
    gradientTo: 'to-green-800',
    accent: 'bg-green-600'
  },
  'appleii': { 
    name: 'Apple II', 
    lang: 'Applesoft BASIC',
    color: 'border-blue-600',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-600',
    gradientFrom: 'from-blue-600',
    gradientTo: 'to-blue-800',
    accent: 'bg-blue-600'
  },
  'atarist': { 
    name: 'Atari ST', 
    lang: 'GFA BASIC',
    color: 'border-slate-600',
    bgColor: 'bg-slate-50',
    textColor: 'text-slate-600',
    gradientFrom: 'from-slate-600',
    gradientTo: 'to-slate-800',
    accent: 'bg-slate-600'
  },
  'atari800': { 
    name: 'Atari 800', 
    lang: 'Atari BASIC',
    color: 'border-red-700',
    bgColor: 'bg-red-50',
    textColor: 'text-red-700',
    gradientFrom: 'from-red-700',
    gradientTo: 'to-red-900',
    accent: 'bg-red-700'
  },
  'ti994a': { 
    name: 'TI-99/4A', 
    lang: 'TI Extended BASIC',
    color: 'border-blue-700',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-700',
    gradientFrom: 'from-blue-700',
    gradientTo: 'to-blue-900',
    accent: 'bg-blue-700'
  },
  'dragon': { 
    name: 'Dragon 32/64', 
    lang: 'Dragon BASIC',
    color: 'border-yellow-700',
    bgColor: 'bg-yellow-50',
    textColor: 'text-yellow-700',
    gradientFrom: 'from-yellow-700',
    gradientTo: 'to-yellow-900',
    accent: 'bg-yellow-700'
  },
  'jupiterace': { 
    name: 'Jupiter ACE', 
    lang: 'Forth',
    color: 'border-purple-600',
    bgColor: 'bg-purple-50',
    textColor: 'text-purple-600',
    gradientFrom: 'from-purple-600',
    gradientTo: 'to-purple-800',
    accent: 'bg-purple-600'
  }
};

const currentPlatform = platformInfo[platform as keyof typeof platformInfo] || {
  name: platform.toUpperCase(),
  lang: 'BASIC',
  color: 'border-slate-600',
  bgColor: 'bg-slate-50',
  textColor: 'text-slate-600',
  gradientFrom: 'from-slate-600',
  gradientTo: 'to-slate-800',
  accent: 'bg-slate-600'
};

// Generate lessons for this tier (16 lessons per tier)
const lessons = Array.from({ length: 16 }, (_, i) => ({
  number: i + 1,
  title: `Lesson ${String(i + 1).padStart(2, '0')}`,
  slug: `lesson-${String(i + 1).padStart(2, '0')}`,
  description: `Learn essential programming concepts on the ${currentPlatform.name}`,
  available: true // For Phase 0, all lessons are available
}));

// Tier descriptions based on programming progression
const getTierInfo = (tierNum: number, lang: string) => {
  const tierDescriptions = {
    1: {
      title: "First Programs",
      description: `Your very first steps in ${lang} programming. Learn to display text, do simple math, and understand how programs work.`,
      concepts: ["PRINT statements", "Line numbers", "RUN command", "Basic calculations", "Text display"],
      focus: "Getting comfortable with the computer and basic commands"
    },
    2: {
      title: "Variables & Input", 
      description: `Learn to store information and get input from users. Make your programs interactive!`,
      concepts: ["Variables", "INPUT command", "String vs numbers", "User interaction", "Simple calculations"],
      focus: "Making programs that respond to user input"
    },
    3: {
      title: "Loops & Repetition",
      description: `Master the power of loops to make things happen over and over. Create patterns and animations.`,
      concepts: ["FOR...NEXT loops", "Repetition", "Counting", "Simple animations", "Pattern creation"],
      focus: "Understanding repetition and creating dynamic programs"
    },
    4: {
      title: "Colors & Graphics",
      description: `Make your programs colorful and visual. Learn to control the screen and create simple graphics.`,
      concepts: ["Screen colors", "Background colors", "Text colors", "Simple graphics", "Visual effects"],
      focus: "Adding visual appeal to your programs"
    },
    5: {
      title: "Decisions & Logic",
      description: `Teach your programs to make decisions. Use IF statements to create smart, responsive programs.`,
      concepts: ["IF...THEN statements", "Comparisons", "Program flow", "Decision making", "Logic"],
      focus: "Creating programs that can make choices"
    },
    6: {
      title: "Sound & Music",
      description: `Add sound effects and music to your programs. Learn to use the computer's audio capabilities.`,
      concepts: ["Sound generation", "Musical notes", "Sound effects", "Audio programming", "Simple melodies"],
      focus: "Creating audio experiences"
    },
    7: {
      title: "Data & Lists",
      description: `Organize and work with collections of data. Learn to handle multiple pieces of information.`,
      concepts: ["Arrays", "Data storage", "Lists", "Data manipulation", "Sorting"],
      focus: "Managing multiple pieces of information"
    },
    8: {
      title: "First Game",
      description: `Put everything together to create your first complete game. A culmination of all your learning!`,
      concepts: ["Game loops", "User input", "Scoring", "Game logic", "Complete programs"],
      focus: "Creating a complete, playable game"
    }
  };
  
  return tierDescriptions[tierNum as keyof typeof tierDescriptions] || {
    title: `Tier ${tierNum}`,
    description: "Advanced programming concepts",
    concepts: ["Advanced topics"],
    focus: "Continuing your programming journey"
  };
};

const tierInfo = getTierInfo(tierNumber, currentPlatform.lang);

const title = `${currentPlatform.name} Phase 0 - Tier ${tierNumber}: ${tierInfo.title}`;
---

<Layout title={title}>
  <!-- Hero Section -->
  <div class={`bg-gradient-to-br ${currentPlatform.gradientFrom} ${currentPlatform.gradientTo} text-white relative`}>
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="container mx-auto px-4 py-12 relative z-10">
      <!-- Navigation breadcrumbs -->
      <nav class="text-sm mb-6 text-white/80">
        <a href="/lessons" class="hover:text-white">Lessons</a>
        <span class="mx-2">→</span>
        <a href={`/lessons/${platform}`} class="hover:text-white">{currentPlatform.name}</a>
        <span class="mx-2">→</span>
        <a href={`/lessons/${platform}/phase-0`} class="hover:text-white">Phase 0</a>
        <span class="mx-2">→</span>
        <span class="text-white">Tier {tierNumber}</span>
      </nav>
      
      <div class="flex items-center gap-6 mb-6">
        <div class={`w-20 h-20 bg-white/20 rounded-2xl flex items-center justify-center text-white font-bold text-lg shadow-2xl backdrop-blur-sm`}>
          T{tierNumber}
        </div>
        <div>
          <h1 class="text-4xl md:text-5xl font-bold mb-2">
            {tierInfo.title}
          </h1>
          <p class="text-xl text-white/90">
            {currentPlatform.name} • Phase 0 • Tier {tierNumber} of 8
          </p>
        </div>
      </div>
      
      <p class="text-xl text-white/90 mb-8 max-w-3xl leading-relaxed">
        {tierInfo.description}
      </p>
      
      <div class="flex flex-wrap gap-4 mb-6">
        <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
          <span>📚</span>
          <span class="text-sm font-medium">16 lessons</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
          <span>💻</span>
          <span class="text-sm font-medium">{currentPlatform.lang}</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
          <span>⏱️</span>
          <span class="text-sm font-medium">1-2 weeks</span>
        </div>
      </div>
      
      <!-- Progress indicator for the tier -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-white/80">Tier Progress</span>
          <span class="text-sm font-medium text-white/80">{tierNumber} of 8 Tiers</span>
        </div>
        <div class="w-full bg-white/20 rounded-full h-3">
          <div 
            class="bg-white h-3 rounded-full transition-all duration-300"
            style={`width: ${(tierNumber / 8) * 100}%`}
          ></div>
        </div>
      </div>
      
      <!-- Key concepts -->
      <div>
        <h3 class="text-lg font-semibold mb-3 text-white/90">You'll Learn:</h3>
        <div class="flex flex-wrap gap-2">
          {tierInfo.concepts.map((concept: string) => (
            <span class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-sm">
              {concept}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <!-- Focus Section -->
    <div class="mb-12 text-center">
      <div class={`inline-block p-6 rounded-xl border-2 ${currentPlatform.color} ${currentPlatform.bgColor} max-w-2xl mx-auto`}>
        <h2 class={`text-2xl font-bold ${currentPlatform.textColor} mb-3`}>Focus for This Tier</h2>
        <p class="text-slate-700 text-lg">
          {tierInfo.focus}
        </p>
      </div>
    </div>

    <!-- Lessons Grid -->
    <div>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">16 Lessons in Tier {tierNumber}</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Work through these Usborne-style lessons that build your {currentPlatform.lang} programming skills step by step. 
          Each lesson includes 6 complete programs with detailed explanations.
        </p>
      </div>
      
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {lessons.map((lesson) => {
          return (
            <a 
              href={`/lessons/${platform}/phase-0/tier-${tierNumber}/${lesson.slug}`}
              class={`group block p-4 rounded-xl border-2 ${currentPlatform.color} ${currentPlatform.bgColor} hover:shadow-lg transition-all duration-200`}
            >
              <div class="flex items-center gap-3 mb-3">
                <div class={`w-10 h-10 ${currentPlatform.accent} rounded-lg flex items-center justify-center text-white font-bold text-sm shadow-lg`}>
                  {lesson.number}
                </div>
                <div>
                  <h3 class={`font-bold ${currentPlatform.textColor} group-hover:underline`}>
                    Lesson {String(lesson.number).padStart(2, '0')}
                  </h3>
                </div>
              </div>
              
              <p class="text-slate-600 text-sm mb-4 leading-relaxed">
                {lesson.description}
              </p>
              
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full">
                    ✓ Available
                  </span>
                </div>
                <div class={`text-sm font-medium ${currentPlatform.textColor} group-hover:underline`}>
                  Start →
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Tier Navigation -->
    <div class="mt-16 flex justify-between items-center">
      <div>
        {tierNumber > 1 && (
          <a 
            href={`/lessons/${platform}/phase-0/tier-${tierNumber - 1}`}
            class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
          >
            ← Previous Tier
          </a>
        )}
      </div>
      
      <div>
        <a 
          href={`/lessons/${platform}/phase-0`}
          class="px-6 py-3 rounded-lg font-medium text-slate-600 bg-slate-100 border border-slate-300 hover:bg-slate-200 transition-colors"
        >
          Back to Phase 0 Overview
        </a>
      </div>
      
      <div>
        {tierNumber < 8 ? (
          <a 
            href={`/lessons/${platform}/phase-0/tier-${tierNumber + 1}`}
            class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
          >
            Next Tier →
          </a>
        ) : (
          <a 
            href={`/lessons/${platform}/phase-1`}
            class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
          >
            Begin Phase 1 →
          </a>
        )}
      </div>
    </div>

    <!-- Coming next preview -->
    {tierNumber < 8 && (
      <div class="mt-12 p-6 bg-slate-50 rounded-xl border border-slate-200">
        <h3 class="font-bold text-slate-700 mb-2">Coming Next: Tier {tierNumber + 1}</h3>
        <p class="text-slate-600">
          {getTierInfo(tierNumber + 1, currentPlatform.lang).title} - {getTierInfo(tierNumber + 1, currentPlatform.lang).focus}
        </p>
      </div>
    )}
  </div>
</Layout>

<style>
  /* Custom animations for progress indicators */
  .tier-progress {
    animation: fillProgress 1s ease-out forwards;
  }
  
  @keyframes fillProgress {
    from { width: 0; }
    to { width: var(--progress-width); }
  }
</style>