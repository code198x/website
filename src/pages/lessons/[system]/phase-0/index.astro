    setupLink: '/setup/appleii'
  },
  'atarist': { 
    name: 'Atari ST', 
    lang: 'GFA BASIC',
    description: 'The 16-bit powerhouse with built-in MIDI. Popular with musicians and artists.',
    year: '1985',
    memory: '512KB RAM',
    features: ['16-bit processor', 'Built-in MIDI', 'GEM desktop', 'Yamaha sound'],
    color: 'border-slate-600',
    bgColor: 'bg-slate-50',
    textColor: 'text-slate-600',
    gradientFrom: 'from-slate-600',
    gradientTo: 'to-slate-800',
    accent: 'bg-slate-600',
    setupLink: '/setup/atarist'
  },
  'atari800': { 
    name: 'Atari 800', 
    lang: 'Atari BASIC',
    description: 'Advanced graphics and sound capabilities made this a favorite for games and multimedia.',
    year: '1979',
    memory: '48KB RAM',
    features: ['ANTIC graphics', 'POKEY sound', 'Joystick ports', 'Cartridge slots'],
    color: 'border-red-700',
    bgColor: 'bg-red-50',
    textColor: 'text-red-700',
    gradientFrom: 'from-red-700',
