    features: ['Color graphics', 'SID sound chip', '8 sprites', 'BASIC 2.0'],
    color: 'border-c64-blue',
    bgColor: 'bg-c64-blue/10',
    textColor: 'text-c64-blue',
    gradientFrom: 'from-c64-blue',
    gradientTo: 'to-c64-dark-blue',
    accent: 'bg-c64-blue',
    setupLink: '/setup/c64'
  },
  'spectrum': { 
    name: 'ZX Spectrum', 
    lang: 'BASIC',
    description: 'The computer that launched a thousand bedrooms programmers in the UK. Famous for its colorful graphics.',
