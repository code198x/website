    year: '1982',
    memory: '32KB RAM',
    features: ['6809 processor', 'Semi-graphics', 'Sound generation', 'Cassette storage'],
    color: 'border-yellow-700',
    bgColor: 'bg-yellow-50',
    textColor: 'text-yellow-700',
    gradientFrom: 'from-yellow-700',
    gradientTo: 'to-yellow-900',
    accent: 'bg-yellow-700',
    setupLink: '/setup/dragon'
  },
  'jupiterace': { 
    name: 'Jupiter ACE', 
    lang: 'Forth',
    description: 'The unique computer that used Forth instead of BASIC. Learn stack-based programming!',
    year: '1982',
    memory: '3KB RAM',
    features: ['Forth language', 'Stack-based', 'Compact design', 'Unique architecture'],
    color: 'border-purple-600',
    bgColor: 'bg-purple-50',
    textColor: 'text-purple-600',
    gradientFrom: 'from-purple-600',
    gradientTo: 'to-purple-800',
    accent: 'bg-purple-600',
    setupLink: '/setup/jupiterace'
  }
};

const currentPlatform = platformInfo[platform as keyof typeof platformInfo] || {
  name: platform.toUpperCase(),
  lang: 'BASIC',
  description: 'Learn programming on this classic computer system.',
  year: '1980s',
  memory: 'Varies',
  features: ['Classic computing'],
  color: 'border-slate-600',
  bgColor: 'bg-slate-50',
  textColor: 'text-slate-600',
  gradientFrom: 'from-slate-600',
  gradientTo: 'to-slate-800',
  accent: 'bg-slate-600',
  setupLink: '/setup'
};

// Generate tiers info
const tiers = Array.from({ length: 8 }, (_, i) => {
  const tierNum = i + 1;
  const tierDescriptions = {
    1: {
      title: "First Programs",
      description: "Your very first steps in programming. Learn to display text and do simple math.",
      lessons: 16,
      concepts: ["PRINT statements", "Line numbers", "RUN command"]
    },
    2: {
      title: "Variables & Input", 
      description: "Learn to store information and get input from users.",
      lessons: 16,
      concepts: ["Variables", "INPUT command", "User interaction"]
    },
    3: {
      title: "Loops & Repetition",
      description: "Master the power of loops to create patterns and animations.",
      lessons: 16,
      concepts: ["FOR...NEXT loops", "Repetition", "Animations"]
    },
    4: {
      title: "Colors & Graphics",
      description: "Make your programs colorful and visual.",
      lessons: 16,
      concepts: ["Screen colors", "Graphics", "Visual effects"]
    },
    5: {
      title: "Decisions & Logic",
      description: "Teach your programs to make decisions with IF statements.",
      lessons: 16,
      concepts: ["IF...THEN", "Logic", "Program flow"]
    },
    6: {
      title: "Sound & Music",
      description: "Add sound effects and music to your programs.",
      lessons: 16,
      concepts: ["Sound generation", "Music", "Audio effects"]
    },
    7: {
      title: "Data & Lists",
      description: "Organize and work with collections of data.",
      lessons: 16,
      concepts: ["Arrays", "Data storage", "Lists"]
    },
    8: {
      title: "First Game",
      description: "Put everything together to create your first complete game!",
      lessons: 16,
      concepts: ["Game loops", "Scoring", "Complete programs"]
    }
  };
  
  return {
    number: tierNum,
    ...tierDescriptions[tierNum as keyof typeof tierDescriptions]
  };
});

const title = `${currentPlatform.name} - Phase 0: Foundation Programming`;
---

<Layout title={title}>
  <!-- Hero Section -->
  <div class={`bg-gradient-to-br ${currentPlatform.gradientFrom} ${currentPlatform.gradientTo} text-white relative`}>
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="container mx-auto px-4 py-16 relative z-10">
      <!-- Navigation breadcrumbs -->
      <nav class="text-sm mb-6 text-white/80">
        <a href="/lessons" class="hover:text-white">Lessons</a>
        <span class="mx-2">→</span>
        <a href={`/lessons/${platform}`} class="hover:text-white">{currentPlatform.name}</a>
        <span class="mx-2">→</span>
        <span class="text-white">Phase 0</span>
      </nav>
      
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center text-white font-bold text-xl shadow-2xl backdrop-blur-sm">
              0
            </div>
            <div>
              <h1 class="text-5xl md:text-6xl font-bold mb-2">
                Phase 0
              </h1>
              <p class="text-2xl text-white/90">
                Foundation Programming
              </p>
            </div>
          </div>
          
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            {currentPlatform.name}
          </h2>
          
          <p class="text-xl text-white/90 mb-8 leading-relaxed">
            {currentPlatform.description}
          </p>
          
          <!-- Platform specs -->
          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
              <div class="text-sm text-white/70 mb-1">Released</div>
              <div class="font-bold text-lg">{currentPlatform.year}</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
              <div class="text-sm text-white/70 mb-1">Memory</div>
              <div class="font-bold text-lg">{currentPlatform.memory}</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
              <div class="text-sm text-white/70 mb-1">Language</div>
              <div class="font-bold text-lg">{currentPlatform.lang}</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
              <div class="text-sm text-white/70 mb-1">Total Lessons</div>
              <div class="font-bold text-lg">128</div>
            </div>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href={`/lessons/${platform}/phase-0/tier-1`}
              class="px-8 py-4 bg-white text-slate-900 font-bold rounded-xl hover:bg-slate-100 transition-colors shadow-lg text-center"
            >
              Start Learning →
            </a>
            <a 
              href={currentPlatform.setupLink}
              class="px-8 py-4 bg-white/20 backdrop-blur-sm border-2 border-white/30 text-white font-bold rounded-xl hover:bg-white/30 transition-colors text-center"
            >
              Setup Guide
            </a>
          </div>
        </div>
        
        <!-- Platform features -->
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8">
          <h3 class="text-2xl font-bold mb-6 text-white">System Features</h3>
          <div class="space-y-3">
            {currentPlatform.features.map((feature: string) => (
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-white rounded-full"></div>
                <span class="text-white/90">{feature}</span>
              </div>
            ))}
          </div>
          
          <div class="mt-8 p-4 bg-white/10 rounded-lg">
            <h4 class="font-bold mb-2 text-white">What Makes This Special?</h4>
            <p class="text-white/80 text-sm leading-relaxed">
              Learn programming the authentic way - exactly as people did when these computers were new. 
              No modern shortcuts, just pure foundational programming skills.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16">
    <!-- Learning Path Overview -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6">Your Learning Journey</h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-8">
        Phase 0 contains <strong>128 lessons</strong> organized into <strong>8 tiers</strong> of 16 lessons each. 
        Follow the Usborne Computer Programming style that taught millions in the 1980s.
      </p>
      
      <!-- Progress overview -->
      <div class="grid md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="text-center">
          <div class={`w-16 h-16 ${currentPlatform.accent} rounded-2xl mx-auto mb-3 flex items-center justify-center text-white font-bold text-xl shadow-lg`}>
            8
          </div>
          <h3 class="font-bold text-lg mb-2">Tiers</h3>
          <p class="text-slate-600 text-sm">Each focusing on key concepts</p>
        </div>
        <div class="text-center">
          <div class={`w-16 h-16 ${currentPlatform.accent} rounded-2xl mx-auto mb-3 flex items-center justify-center text-white font-bold text-xl shadow-lg`}>
            16
          </div>
          <h3 class="font-bold text-lg mb-2">Lessons per Tier</h3>
          <p class="text-slate-600 text-sm">Bite-sized learning chunks</p>
        </div>
        <div class="text-center">
          <div class={`w-16 h-16 ${currentPlatform.accent} rounded-2xl mx-auto mb-3 flex items-center justify-center text-white font-bold text-xl shadow-lg`}>
            6
          </div>
          <h3 class="font-bold text-lg mb-2">Programs per Lesson</h3>
          <p class="text-slate-600 text-sm">Hands-on practice</p>
        </div>
        <div class="text-center">
          <div class={`w-16 h-16 ${currentPlatform.accent} rounded-2xl mx-auto mb-3 flex items-center justify-center text-white font-bold text-xl shadow-lg`}>
            768
          </div>
          <h3 class="font-bold text-lg mb-2">Total Programs</h3>
          <p class="text-slate-600 text-sm">Comprehensive practice</p>
        </div>
      </div>
    </div>

    <!-- Tiers -->
    <div>
      <h2 class="text-3xl font-bold text-center mb-12">8 Tiers of Learning</h2>
      
      <div class="grid gap-6 lg:grid-cols-2">
        {tiers.map((tier, index) => {
          const isEven = index % 2 === 1;
          return (
            <a 
              href={`/lessons/${platform}/phase-0/tier-${tier.number}`}
              class={`group block p-6 rounded-xl border-2 ${currentPlatform.color} ${currentPlatform.bgColor} hover:shadow-xl transition-all duration-200`}
            >
              <div class="flex items-start gap-4 mb-4">
                <div class={`w-14 h-14 ${currentPlatform.accent} rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-lg`}>
                  T{tier.number}
                </div>
                <div class="flex-1">
                  <h3 class={`text-xl font-bold ${currentPlatform.textColor} group-hover:underline mb-2`}>
                    Tier {tier.number}: {tier.title}
                  </h3>
                  <p class="text-slate-600 leading-relaxed mb-3">
                    {tier.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-3">
                    {tier.concepts.map((concept: string) => (
                      <span class="text-xs px-2 py-1 bg-white/80 text-slate-600 rounded-full">
                        {concept}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
              
              <div class="flex items-center justify-between">
                <div class="text-sm text-slate-500">
                  {tier.lessons} lessons
                </div>
                <div class={`text-sm font-medium ${currentPlatform.textColor} group-hover:underline`}>
                  Start Tier →
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Usborne Style Explanation -->
    <div class="mt-20 bg-gradient-to-r from-yellow-50 to-orange-50 border-2 border-orange-200 rounded-2xl p-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-orange-800 mb-4">The Usborne Way</h2>
        <p class="text-lg text-orange-700 max-w-3xl mx-auto">
          Our Phase 0 lessons follow the legendary Usborne Computer Programming books style that taught 
          millions of people to program in the 1980s and 1990s.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="text-4xl mb-3">📋</div>
          <h3 class="font-bold text-orange-800 mb-2">Step by Step</h3>
          <p class="text-orange-700 text-sm">
            Each lesson has exactly 6 programs that build on each other progressively.
          </p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-3">💡</div>
          <h3 class="font-bold text-orange-800 mb-2">Clear Explanations</h3>
          <p class="text-orange-700 text-sm">
            Every program is explained simply, with the "what" and "why" made clear.
          </p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-3">🎯</div>
          <h3 class="font-bold text-orange-800 mb-2">Immediate Results</h3>
          <p class="text-orange-700 text-sm">
            See your programs work immediately - that magical "wow, I made this!" moment.
          </p>
        </div>
      </div>
      
      <div class="mt-8 text-center">
        <div class="inline-block p-4 bg-white/60 rounded-lg">
          <p class="text-orange-800 font-medium mb-2">
            "The best way to learn programming is to start programming"
          </p>
          <p class="text-orange-600 text-sm">- The Usborne Philosophy</p>
        </div>
      </div>
    </div>

    <!-- Getting Started -->
    <div class="mt-16 text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Begin?</h2>
      <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
        Start with Tier 1 and work your way through all 8 tiers. Each tier builds on the previous one, 
        so don't skip ahead!
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`/lessons/${platform}/phase-0/tier-1`}
          class={`px-8 py-4 ${currentPlatform.accent} text-white font-bold rounded-xl hover:opacity-90 transition-opacity shadow-lg`}
        >
          Start with Tier 1 →
        </a>
        <a 
          href={currentPlatform.setupLink}
          class={`px-8 py-4 border-2 ${currentPlatform.color} ${currentPlatform.textColor} font-bold rounded-xl hover:${currentPlatform.bgColor} transition-colors`}
        >
          Setup Guide First
        </a>
      </div>
    </div>
  </div>
</Layout>