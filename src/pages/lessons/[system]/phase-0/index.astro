    year: '1981',
    memory: '32KB RAM',
    features: ['Mode 7 teletext', 'Excellent BASIC', 'Educational focus', 'Expansion options'],
    color: 'border-red-600',
    bgColor: 'bg-red-50',
    textColor: 'text-red-600',
    gradientFrom: 'from-red-600',
    gradientTo: 'to-red-800',
    accent: 'bg-red-600',
    setupLink: '/setup/bbcmicro'
  },
  'amstradcpc': { 
    name: 'Amstrad CPC', 
    lang: 'Locomotive BASIC',
    description: 'The complete system that came with monitor and tape deck. Popular across Europe.',
    year: '1984',
    memory: '64KB RAM',
    features: ['Built-in monitor', 'Colorful graphics', 'AY sound chip', 'Complete system'],
    color: 'border-green-600',
    bgColor: 'bg-green-50',
    textColor: 'text-green-600',
    gradientFrom: 'from-green-600',
    gradientTo: 'to-green-800',
    accent: 'bg-green-600',
    setupLink: '/setup/amstradcpc'
  },
  'appleii': { 
    name: 'Apple II', 
    lang: 'Applesoft BASIC',
    description: 'The computer that launched the personal computer revolution. Famous for its expansion and longevity.',
    year: '1977',
    memory: '48KB RAM',
    features: ['Color graphics', 'Sound generation', 'Expansion slots', 'Disk drives'],
    color: 'border-blue-600',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-600',
    gradientFrom: 'from-blue-600',
    gradientTo: 'to-blue-800',
