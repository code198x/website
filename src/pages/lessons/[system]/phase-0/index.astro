---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  // For Phase 0, we generate static paths for all supported platforms
  const platforms = [
    'c64', 'spectrum', 'amiga', 'bbcmicro', 'amstradcpc', 'appleii', 
    'atarist', 'atari800', 'ti994a', 'dragon', 'jupiterace'
  ];
  
  return platforms.map(platform => ({
    params: { system: platform },
    props: { platform }
  }));
}

const { platform } = Astro.props;

// Platform display names and configuration
const platformInfo = {
  'c64': { 
