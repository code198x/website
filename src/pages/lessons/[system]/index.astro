---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const systems = await getCollection("systems");
  const phases = await getCollection("phases");
  const lessons = await getCollection("lessons");
  
  // Get systems that have phases defined (which means they have lessons)
  const systemsWithPhases = systems.filter(system => {
    return phases.some(phase => phase.data.system === system.slug);
  });
  
  return systemsWithPhases.map((system) => ({
    params: { system: system.slug },
    props: { system, phases, lessons }
  }));
}

const { system, phases, lessons } = Astro.props;

// Get phases for this system
const systemPhases = phases.filter(phase => phase.data.system === system.id);
systemPhases.sort((a, b) => a.data.phase_number - b.data.phase_number);

// Check which phases have lessons
const phasesWithLessons = systemPhases.filter(phase => {
  return lessons.some(lesson => 
    lesson.id.startsWith(`${system.id}/phase-${phase.data.phase_number}`)
  );
});
---

<Layout title={`${system.data.name} Lessons - Code Like It's 198x`}>
  <h1>{system.data.name} Programming Course</h1>
  
  <div class="mb-8 p-6 bg-gray-100 rounded-lg">
    <p class="text-lg mb-4">{system.data.historical_significance}</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <span class="font-semibold">CPU:</span> {system.data.cpu}
      </div>
      <div>
        <span class="font-semibold">RAM:</span> {system.data.ram}
      </div>
      <div>
        <span class="font-semibold">Released:</span> {system.data.release_date.global.getFullYear()}
      </div>
      <div>
        <span class="font-semibold">Manufacturer:</span> {system.data.manufacturer}
      </div>
    </div>
  </div>

  <h2 class="text-2xl font-bold mb-4">Learning Phases</h2>
  
  {phasesWithLessons.length > 0 ? (
    <div class="space-y-6">
      {phasesWithLessons.map((phase) => (
        <a 
          href={`/lessons/${system.id}/phase-${phase.data.phase_number}/`}
          class="block p-6 bg-blue-50 rounded-lg hover:bg-blue-100 transition"
        >
          <h3 class="text-xl font-semibold mb-2">{phase.data.title}</h3>
          <p class="text-gray-700 mb-2">{phase.data.description}</p>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span>Difficulty: {phase.data.difficulty_level}</span>
            <span>Duration: {phase.data.estimated_duration}</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-gray-600">No lessons available for this system yet. Check back soon!</p>
  )}
</Layout>