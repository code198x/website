---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const systems = await getCollection("systems");
  const phases = await getCollection("phases");
  const lessons = await getCollection("lessons");
  
  // Get systems that have phases defined (which means they have lessons)
  const systemsWithPhases = systems.filter(system => {
    return phases.some(phase => phase.data.system === system.slug);
  });
  
  return systemsWithPhases.map((system) => ({
    params: { system: system.slug },
    props: { system, phases, lessons }
  }));
}

const { system, phases, lessons } = Astro.props;

// Get phases for this system
const systemPhases = phases.filter(phase => phase.data.system === system.slug);
systemPhases.sort((a, b) => a.data.phase_number - b.data.phase_number);

// Check which phases have lessons
const phasesWithLessons = systemPhases.filter(phase => {
  return lessons.some(lesson => 
    lesson.id.startsWith(`${system.slug}/phase-${phase.data.phase_number}`)
  );
});
---

<Layout title={`${system.data.name} Programming Course - Code Like It's 198x`}>
  <!-- Hero Section with System Image and Branding -->
  <div class="relative overflow-hidden">
    {(() => {
      // Define system-specific colors
      const getSystemColors = (slug) => {
        switch(slug) {
          case 'commodore-64':
            return { 
              bg: 'from-c64-brown to-c64-dark-brown', 
              accent: 'bg-c64-brown',
              text: 'text-c64-brown',
              border: 'border-c64-brown'
            };
          case 'zx-spectrum':
            return { 
              bg: 'from-spectrum-red to-spectrum-magenta', 
              accent: 'bg-spectrum-red',
              text: 'text-spectrum-red',
              border: 'border-spectrum-red'
            };
          case 'nintendo-entertainment-system':
            return { 
              bg: 'from-nes-red to-nes-dark-gray', 
              accent: 'bg-nes-red',
              text: 'text-nes-red',
              border: 'border-nes-red'
            };
          case 'commodore-amiga':
            return { 
              bg: 'from-amiga-blue to-amiga-orange', 
              accent: 'bg-amiga-blue',
              text: 'text-amiga-blue',
              border: 'border-amiga-blue'
            };
          default:
            return { 
              bg: 'from-gray-600 to-gray-800', 
              accent: 'bg-gray-600',
              text: 'text-gray-600',
              border: 'border-gray-600'
            };
        }
      };
      const colors = getSystemColors(system.slug);
      
      return (
        <div class={`bg-gradient-to-br ${colors.bg} text-white relative`}>
          <div class="absolute inset-0 bg-black/20"></div>
          <div class="container mx-auto px-4 py-12 relative z-10">
            <div class="grid md:grid-cols-2 gap-8 items-center">
              <div>
                <nav class="text-sm mb-4 text-white/80">
                  <a href="/lessons" class="hover:text-white">Lessons</a>
                  <span class="mx-2">→</span>
                  <span class="text-white">{system.data.name}</span>
                </nav>
                
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                  {system.data.name}
                  <span class="block text-2xl md:text-3xl font-normal mt-2 text-white/90">
                    Programming Course
                  </span>
                </h1>
                
                <p class="text-xl text-white/90 mb-6 leading-relaxed">
                  {system.data.historical_significance}
                </p>
                
                <div class="flex flex-wrap gap-3 mb-6">
                  <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm">
                    {system.data.cpu} CPU
                  </span>
                  <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm">
                    {system.data.ram} RAM
                  </span>
                  <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm">
                    {system.data.release_date.global.getFullYear()}
                  </span>
                </div>
                
                <div class="flex gap-4">
                  <a 
                    href={`/vault/systems/${system.slug}`}
                    class="px-6 py-3 bg-white/20 backdrop-blur-sm text-white font-medium rounded-lg hover:bg-white/30 transition-colors"
                  >
                    Technical Specs →
                  </a>
                </div>
              </div>
              
              <div class="relative">
                {system.data.image && (
                  <img 
                    src={system.data.image} 
                    alt={system.data.name}
                    class="w-full max-w-md mx-auto rounded-xl shadow-2xl transform rotate-3 hover:rotate-0 transition-transform duration-300"
                  />
                )}
              </div>
            </div>
          </div>
        </div>
      );
    })()}
  </div>

  <div class="container mx-auto px-4 py-12">
    <!-- Course Overview -->
    <div class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold mb-4">Course Structure</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          This course teaches {system.data.cpu} assembly programming through hands-on lessons. 
          Each phase builds upon previous knowledge with practical examples and exercises.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 mb-8">
        <div class="text-center p-6 bg-white/80 rounded-xl border border-c64-beige-darker">
          <div class="w-16 h-16 bg-brand-blue rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">📚</span>
          </div>
          <h3 class="font-bold mb-2">{phasesWithLessons.length} Phases</h3>
          <p class="text-sm text-gray-600">Structured learning progression</p>
        </div>
        
        <div class="text-center p-6 bg-white/80 rounded-xl border border-c64-beige-darker">
          <div class="w-16 h-16 bg-brand-amber rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">⚡</span>
          </div>
          <h3 class="font-bold mb-2">Assembly Programming</h3>
          <p class="text-sm text-gray-600">Hardware-level programming</p>
        </div>
        
        <div class="text-center p-6 bg-white/80 rounded-xl border border-c64-beige-darker">
          <div class="w-16 h-16 bg-brand-red rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🎯</span>
          </div>
          <h3 class="font-bold mb-2">Hands-on Practice</h3>
          <p class="text-sm text-gray-600">Interactive lessons and projects</p>
        </div>
      </div>
    </div>

    <!-- Learning Phases -->
    <div>
      <h2 class="text-3xl font-bold mb-8">Learning Phases</h2>
      
      {phasesWithLessons.length > 0 ? (
        <div class="space-y-6">
          {phasesWithLessons.map((phase, index) => {
            const colors = (() => {
              switch(system.slug) {
                case 'commodore-64': return 'bg-c64-brown hover:bg-c64-dark-brown';
                case 'zx-spectrum': return 'bg-spectrum-red hover:bg-spectrum-magenta';
                case 'nintendo-entertainment-system': return 'bg-nes-red hover:bg-nes-dark-gray';
                case 'commodore-amiga': return 'bg-amiga-blue hover:bg-amiga-orange';
                default: return 'bg-gray-600 hover:bg-gray-700';
              }
            })();
            
            const getDifficultyIcon = (level) => {
              switch(level?.toLowerCase()) {
                case 'beginner': return '🟢';
                case 'intermediate': return '🟡';
                case 'advanced': return '🔴';
                default: return '⚪';
              }
            };
            
            return (
              <a 
                href={`/lessons/${system.slug}/phase-${phase.data.phase_number}/`}
                class="group block bg-white/90 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 overflow-hidden border-2 border-transparent hover:border-gray-200"
              >
                <div class="flex">
                  <div class={`w-2 ${colors} group-hover:w-4 transition-all duration-200`}></div>
                  <div class="flex-1 p-8">
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex items-center gap-4">
                        <div class={`w-12 h-12 ${colors} rounded-xl flex items-center justify-center text-white font-bold text-lg`}>
                          {phase.data.phase_number}
                        </div>
                        <div>
                          <h3 class="text-2xl font-bold mb-1 group-hover:text-gray-900">
                            {phase.data.title}
                          </h3>
                          <div class="flex items-center gap-4 text-sm text-gray-500">
                            <span class="flex items-center gap-1">
                              {getDifficultyIcon(phase.data.difficulty_level)}
                              {phase.data.difficulty_level}
                            </span>
                            <span>⏱️ {phase.data.estimated_duration}</span>
                          </div>
                        </div>
                      </div>
                      
                      <div class="text-right">
                        <div class={`px-4 py-2 ${colors} text-white rounded-lg font-medium group-hover:scale-105 transition-transform`}>
                          Start Phase →
                        </div>
                      </div>
                    </div>
                    
                    <p class="text-gray-700 leading-relaxed mb-4">
                      {phase.data.description}
                    </p>
                    
                    <div class="flex items-center justify-between">
                      <div class="text-sm text-gray-500">
                        Phase {index + 1} of {phasesWithLessons.length}
                      </div>
                      <div class="flex items-center gap-2">
                        <div class="w-32 bg-gray-200 rounded-full h-2">
                          <div class="bg-green-500 h-2 rounded-full w-0"></div>
                        </div>
                        <span class="text-sm text-gray-500">0% complete</span>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16 bg-white/60 rounded-xl border border-c64-beige-darker">
          <div class="w-16 h-16 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🚧</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Course Under Development</h3>
          <p class="text-gray-600 mb-6">
            We're working hard to bring you comprehensive {system.data.name} programming lessons. 
            Check back soon!
          </p>
          <a 
            href={`/vault/systems/${system.slug}`}
            class="inline-block px-6 py-3 bg-brand-blue text-white font-medium rounded-lg hover:bg-brand-blue-dark transition-colors"
          >
            Learn About This System →
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>