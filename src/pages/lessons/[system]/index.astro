---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { getSystemColors, getDifficultyIcon } from "../../../utils/systemColors.js";

export async function getStaticPaths() {
  const systems = await getCollection("systems");
  const phases = await getCollection("phases");
  const lessons = await getCollection("lessons");
  
  // Get systems that have phases defined (which means they have lessons)
  const systemsWithPhases = systems.filter(system => {
    return phases.some(phase => phase.data.system === system.slug);
  });
  
  return systemsWithPhases.map((system) => ({
    params: { system: system.slug },
    props: { system, phases, lessons }
  }));
}

const { system, phases, lessons } = Astro.props;

// Get phases for this system
const systemPhases = phases.filter(phase => phase.data.system === system.slug);
systemPhases.sort((a, b) => a.data.phase_number - b.data.phase_number);

// Check which phases have lessons (for display purposes)
const phasesWithLessons = systemPhases.map(phase => {
  const hasLessons = lessons.some(lesson => 
    lesson.id.startsWith(`${system.slug}/phase-${phase.data.phase_number}`)
  );
  return { ...phase, hasLessons };
});

// Get system colors
const colors = getSystemColors(system.slug);
---

<Layout title={`${system.data.name} Programming Course - Code Like It's 198x`}>
  <!-- Hero Section with System Image and Branding -->
  <div class="system-hero">
      
    <div class={`system-hero-gradient ${colors.className}`}>
      <div class="system-hero-overlay"></div>
      <div class="system-hero-content">
        <div class="container">
          <div class="grid-2" style="align-items: center;">
            <div>
              <nav class="system-hero-nav">
                <a href="/lessons">Lessons</a>
                <span style="margin: 0 var(--space-sm);">→</span>
                <span style="color: white;">{system.data.name}</span>
              </nav>
                
              <h1 class="system-hero-title">
                {system.data.name}
                <span class="system-hero-subtitle">
                  Programming Course
                </span>
              </h1>
              
              <p style="font-size: 1.25rem; color: rgba(255, 255, 255, 0.9); margin-bottom: var(--space-xl); line-height: 1.75;">
                {system.data.historical_significance}
              </p>
              
              <div class="system-hero-specs">
                <span class="system-spec-badge">
                  {system.data.cpu} CPU
                </span>
                <span class="system-spec-badge">
                  {system.data.ram} RAM
                </span>
                <span class="system-spec-badge">
                  {system.data.release_date.global.getFullYear()}
                </span>
              </div>
              
              <div style="display: flex; gap: var(--space-lg);">
                <a 
                  href={`/vault/systems/${system.slug}`}
                  style="padding: var(--space-md) var(--space-xl); background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(4px); color: white; font-weight: 500; border-radius: var(--radius-lg); text-decoration: none; transition: background var(--transition-fast);"
                  onmouseover="this.style.background='rgba(255, 255, 255, 0.3)'"
                  onmouseout="this.style.background='rgba(255, 255, 255, 0.2)'"
                >
                  Technical Specs →
                </a>
              </div>
            </div>
              
            <div style="position: relative;">
              {system.data.image && (
                <img 
                  src={system.data.image} 
                  alt={system.data.name}
                  class="system-hero-image"
                />
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container" style="padding: var(--space-4xl) 0;">
    <!-- Course Overview -->
    <div style="margin-bottom: var(--space-4xl);">
      <div style="text-align: center; margin-bottom: var(--space-2xl);">
        <h2 style="font-size: 2rem; font-weight: 700; margin-bottom: var(--space-lg);">Course Structure</h2>
        <p style="font-size: 1.125rem; color: var(--text-muted); max-width: 40rem; margin: 0 auto;">
          This course teaches {system.data.cpu} assembly programming through hands-on lessons. 
          Each phase builds upon previous knowledge with practical examples and exercises.
        </p>
      </div>
      
      <div class="course-stats">
        <div class="course-stat-card">
          <div class="course-stat-icon blue">
            <span>📚</span>
          </div>
          <h3 style="font-weight: 700; margin-bottom: var(--space-sm);">{systemPhases.length} Phases</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted);">Structured learning progression</p>
        </div>
        
        <div class="course-stat-card">
          <div class="course-stat-icon amber">
            <span>⚡</span>
          </div>
          <h3 style="font-weight: 700; margin-bottom: var(--space-sm);">Assembly Programming</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted);">Hardware-level programming</p>
        </div>
        
        <div class="course-stat-card">
          <div class="course-stat-icon red">
            <span>🎯</span>
          </div>
          <h3 style="font-weight: 700; margin-bottom: var(--space-sm);">Hands-on Practice</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted);">Interactive lessons and projects</p>
        </div>
      </div>
    </div>

    <!-- Learning Phases -->
    <div>
      <h2 style="font-size: 2rem; font-weight: 700; margin-bottom: var(--space-2xl);">Learning Phases</h2>
      
      {systemPhases.length > 0 ? (
        <div class="phase-list">
          {phasesWithLessons.map((phase, index) => {
            const PhaseWrapper = phase.hasLessons ? 'a' : 'div';
            const wrapperProps = phase.hasLessons ? { href: `/lessons/${system.slug}/phase-${phase.data.phase_number}/` } : {};
            
            return (
              <PhaseWrapper 
                {...wrapperProps}
                class={`phase-card ${!phase.hasLessons ? 'phase-card-disabled' : ''}`}
                style={!phase.hasLessons ? 'cursor: default; opacity: 0.7;' : ''}
              >
                <div style="display: flex;">
                  <div class={`phase-card-accent ${colors.className}`}></div>
                  <div class="phase-card-content">
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-lg);">
                      <div style="display: flex; align-items: center; gap: var(--space-lg);">
                        <div class={`phase-card-number ${colors.className}`}>
                          {phase.data.phase_number}
                        </div>
                        <div>
                          <h3 class="phase-card-title">
                            {phase.data.title}
                          </h3>
                          <div class="phase-card-meta">
                            <span style="display: flex; align-items: center; gap: var(--space-xs);">
                              {getDifficultyIcon(phase.data.difficulty_level)}
                              {phase.data.difficulty_level.charAt(0).toUpperCase() + phase.data.difficulty_level.slice(1)}
                            </span>
                            <span>⏱️ {phase.data.estimated_duration}</span>
                          </div>
                        </div>
                      </div>
                      
                      <div style="text-align: right;">
                        {phase.hasLessons ? (
                          <div class={`phase-card-cta ${colors.className}`}>
                            Start Phase →
                          </div>
                        ) : (
                          <div style="background: var(--bg-secondary); color: var(--text-muted); padding: var(--space-sm) var(--space-lg); border-radius: var(--radius-lg); font-size: 0.875rem; font-weight: 500;">
                            Coming Soon
                          </div>
                        )}
                      </div>
                    </div>
                    
                    <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: var(--space-lg);">
                      {phase.data.description}
                    </p>
                    
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                      <div style="font-size: 0.875rem; color: var(--text-muted);">
                        Phase {index + 1} of {systemPhases.length}
                      </div>
                      <div style="display: flex; align-items: center; gap: var(--space-sm);">
                        {phase.hasLessons ? (
                          <>
                            <div style="width: 8rem; background: var(--bg-secondary); border-radius: var(--radius-full); height: 0.5rem;">
                              <div style="background: #10b981; height: 0.5rem; border-radius: var(--radius-full); width: 0;"></div>
                            </div>
                            <span style="font-size: 0.875rem; color: var(--text-muted);">0% complete</span>
                          </>
                        ) : (
                          <span style="font-size: 0.875rem; color: var(--text-muted); font-style: italic;">In development</span>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </PhaseWrapper>
            );
          })}
        </div>
      ) : (
        <div style="text-align: center; padding: var(--space-4xl); background: rgba(255, 255, 255, 0.6); border-radius: var(--radius-xl); border: 1px solid var(--c64-beige-darker);">
          <div style="width: 4rem; height: 4rem; background: var(--bg-secondary); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);">
            <span style="font-size: 1.5rem;">🚧</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: var(--space-sm);">Course Under Development</h3>
          <p style="color: var(--text-muted); margin-bottom: var(--space-xl);">
            We're working hard to bring you comprehensive {system.data.name} programming lessons. 
            Check back soon!
          </p>
          <a 
            href={`/vault/systems/${system.slug}`}
            class="btn btn-primary"
            style="display: inline-block;"
          >
            Learn About This System →
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>