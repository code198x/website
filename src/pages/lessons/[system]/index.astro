---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSystemColors, getDifficultyIcon } from "../../../utils/systemColors.js";

export async function getStaticPaths() {
  const systems = await getCollection("systems");
  const phases = await getCollection("phases");
  const lessons = await getCollection("lessons");

  // Get systems that have phases defined (which means they have lessons)
  const systemsWithPhases = systems.filter((system) => {
    return phases.some((phase) => phase.data.system === system.slug);
  });

  return systemsWithPhases.map((system) => ({
    params: { system: system.slug },
    props: { system, phases, lessons },
  }));
}

const { system, phases, lessons } = Astro.props;

// Get phases for this system
const systemPhases = phases.filter((phase) => phase.data.system === system.slug);
systemPhases.sort((a, b) => a.data.phase_number - b.data.phase_number);

// Check which phases have lessons (for display purposes)
const phasesWithLessons = systemPhases.map((phase) => {
  const hasLessons = lessons.some((lesson) =>
    lesson.id.startsWith(`${system.slug}/phase-${phase.data.phase_number}`)
  );
  return { ...phase, hasLessons };
});

// Separate BASIC (Phase 0) from Assembly phases (1-8)
const basicPhases = phasesWithLessons.filter(phase => phase.data.phase_number === 0);
const assemblyPhases = phasesWithLessons.filter(phase => phase.data.phase_number > 0);

// Get system colors
const colors = getSystemColors(system.slug);
---

<Layout title={`${system.data.name} Programming Course`}>
  <!-- Hero Section with System Image and Branding -->
  <div class="system-hero">
    <div class={`system-hero-gradient ${colors.className}`}>
      <div class="system-hero-overlay"></div>
      <div class="system-hero-content">
        <div class="container">
          <div class="grid-2">
            <div>
              <nav class="system-hero-nav">
                <a href="/lessons">Lessons</a>
                <span class="system-hero-nav-arrow">→</span>
                <span class="system-hero-nav-current">{system.data.name}</span>
              </nav>

              <h1 class="system-hero-title">
                {system.data.name}
                <span class="system-hero-subtitle"> Programming Course </span>
              </h1>

              <p class="system-hero-description">
                {system.data.historical_significance}
              </p>

              <div class="system-hero-specs">
                <span class="system-spec-badge">
                  {system.data.cpu} CPU
                </span>
                <span class="system-spec-badge">
                  {system.data.ram} RAM
                </span>
                <span class="system-spec-badge">
                  {system.data.release_date.global.getFullYear()}
                </span>
              </div>

              <div class="system-hero-actions">
                <a href={`/vault/hardware/${system.slug}`} class="system-hero-cta">
                  Technical Specs →
                </a>
              </div>
            </div>

            <div class="system-hero-image">
              <img
                src={`/images/systems/${system.slug}.jpg`}
                alt={system.data.name}
                width={600}
                height={400}
                loading="eager"
                class="system-hero-img"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container system-overview">
    <!-- Course Overview -->
    <div class="course-overview">
      <div class="course-overview-header">
        <h2 class="course-overview-title">Course Structure</h2>
        <p class="course-overview-description">
          {basicPhases.length > 0
            ? `Learn programming on the ${system.data.name} starting with BASIC fundamentals in Phase 0, then progressing to ${system.data.cpu} assembly programming. Each phase builds upon previous knowledge with practical examples and exercises.`
            : `Learn ${system.data.cpu} assembly programming on the ${system.data.name}. Progress through 8 comprehensive phases, from basic instructions to advanced techniques. Each phase builds upon previous knowledge with practical examples and exercises.`
          }
        </p>
      </div>

      <div class="course-stats">
        <div class="course-stat-card">
          <div class="course-stat-icon blue">
            <span>📚</span>
          </div>
          <h3 class="course-stat-title">
            {systemPhases.length} Phases
          </h3>
          <p class="course-stat-description">Structured learning progression</p>
        </div>

        <div class="course-stat-card">
          <div class="course-stat-icon amber">
            <span>⚡</span>
          </div>
          <h3 class="course-stat-title">{basicPhases.length > 0 ? "BASIC to Assembly" : "Assembly Programming"}</h3>
          <p class="course-stat-description">{basicPhases.length > 0 ? "From high-level to hardware programming" : "Direct hardware programming"}</p>
        </div>

        <div class="course-stat-card">
          <div class="course-stat-icon red">
            <span>🎯</span>
          </div>
          <h3 class="course-stat-title">Hands-on Practice</h3>
          <p class="course-stat-description">Interactive lessons and projects</p>
        </div>
      </div>
    </div>

    <!-- Learning Phases -->
    <div class="phases-section">
      <h2 class="phases-title">Learning Phases</h2>

      {
        systemPhases.length > 0 ? (
          <div>
            {/* BASIC Programming Phase (Phase 0) */}
            {basicPhases.length > 0 && (
              <div class="phase-section">
                <div class="phase-section-header">
                  <h3 class="phase-section-title">💻 BASIC Programming Foundation</h3>
                  <p class="phase-section-description">
                    Start your programming journey with {system.data.name} BASIC. Learn essential concepts like variables, loops, and conditional logic that will prepare you for assembly language.
                  </p>
                </div>
                <div class="phase-list">
                  {basicPhases.map((phase, index) => {
                    const PhaseWrapper = phase.hasLessons ? "a" : "div";
                    const wrapperProps = phase.hasLessons
                      ? { href: `/lessons/${system.slug}/phase-${phase.data.phase_number}/` }
                      : {};

                    return (
                      <PhaseWrapper
                        {...wrapperProps}
                        class={`phase-card ${!phase.hasLessons ? "phase-card-disabled" : ""}`}
                      >
                        <div class="phase-card-layout">
                          <div class={`phase-card-accent ${colors.className}`} />
                          <div class="phase-card-content">
                            <div class="phase-card-header">
                              <div class="phase-card-main">
                                <div class={`phase-card-number ${colors.className}`}>
                                  {phase.data.phase_number}
                                </div>
                                <div class="phase-card-info">
                                  <h3 class="phase-card-title">{phase.data.title}</h3>
                                  <div class="phase-card-meta">
                                    <span class="phase-card-difficulty-item">
                                      {getDifficultyIcon(phase.data.difficulty_level)}
                                      {phase.data.difficulty_level.charAt(0).toUpperCase() +
                                        phase.data.difficulty_level.slice(1)}
                                    </span>
                                    <span>⏱️ {phase.data.estimated_duration}</span>
                                  </div>
                                </div>
                              </div>

                              <div class="phase-card-action-right">
                                {phase.hasLessons ? (
                                  <div class={`phase-card-cta ${colors.className}`}>Start Phase →</div>
                                ) : (
                                  <div class="phase-card-coming-soon">Coming Soon</div>
                                )}
                              </div>
                            </div>

                            <p class="phase-card-description">{phase.data.description}</p>

                            <div class="phase-card-footer">
                              <div class="phase-card-phase-number">
                                BASIC Foundation
                              </div>
                              <div class="phase-card-progress-section">
                                {phase.hasLessons ? (
                                  <>
                                    <div class="phase-card-progress-bar">
                                      <div class="phase-card-progress-fill" />
                                    </div>
                                    <span class="phase-card-progress-text">0% complete</span>
                                  </>
                                ) : (
                                  <span class="phase-card-development-text">In development</span>
                                )}
                              </div>
                            </div>
                          </div>
                        </div>
                      </PhaseWrapper>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Assembly Programming Phases (Phases 1-8 for computers, all phases for consoles) */}
            {assemblyPhases.length > 0 && (
              <div class={`phase-section ${basicPhases.length === 0 ? 'phase-section-only' : ''}`}>
                {basicPhases.length > 0 && (
                  <div class="phase-section-header">
                    <h3 class="phase-section-title">⚙️ Assembly Programming Journey</h3>
                    <p class="phase-section-description">
                      Progress through {assemblyPhases.length} carefully structured assembly programming phases. Learn {system.data.cpu} assembly language, from basic instructions to advanced techniques like interrupt handling and graphics programming.
                    </p>
                  </div>
                )}
                <div class="phase-list">
                  {assemblyPhases.map((phase, index) => {
                    const PhaseWrapper = phase.hasLessons ? "a" : "div";
                    const wrapperProps = phase.hasLessons
                      ? { href: `/lessons/${system.slug}/phase-${phase.data.phase_number}/` }
                      : {};

                    return (
                      <PhaseWrapper
                        {...wrapperProps}
                        class={`phase-card ${!phase.hasLessons ? "phase-card-disabled" : ""}`}
                      >
                        <div class="phase-card-layout">
                          <div class={`phase-card-accent ${colors.className}`} />
                          <div class="phase-card-content">
                            <div class="phase-card-header">
                              <div class="phase-card-main">
                                <div class={`phase-card-number ${colors.className}`}>
                                  {phase.data.phase_number}
                                </div>
                                <div class="phase-card-info">
                                  <h3 class="phase-card-title">{phase.data.title}</h3>
                                  <div class="phase-card-meta">
                                    <span class="phase-card-difficulty-item">
                                      {getDifficultyIcon(phase.data.difficulty_level)}
                                      {phase.data.difficulty_level.charAt(0).toUpperCase() +
                                        phase.data.difficulty_level.slice(1)}
                                    </span>
                                    <span>⏱️ {phase.data.estimated_duration}</span>
                                  </div>
                                </div>
                              </div>

                              <div class="phase-card-action-right">
                                {phase.hasLessons ? (
                                  <div class={`phase-card-cta ${colors.className}`}>Start Phase →</div>
                                ) : (
                                  <div class="phase-card-coming-soon">Coming Soon</div>
                                )}
                              </div>
                            </div>

                            <p class="phase-card-description">{phase.data.description}</p>

                            <div class="phase-card-footer">
                              <div class="phase-card-phase-number">
                                {basicPhases.length > 0
                                  ? `Phase ${phase.data.phase_number} of 8`
                                  : `Phase ${index + 1} of ${assemblyPhases.length}`
                                }
                              </div>
                              <div class="phase-card-progress-section">
                                {phase.hasLessons ? (
                                  <>
                                    <div class="phase-card-progress-bar">
                                      <div class="phase-card-progress-fill" />
                                    </div>
                                    <span class="phase-card-progress-text">0% complete</span>
                                  </>
                                ) : (
                                  <span class="phase-card-development-text">In development</span>
                                )}
                              </div>
                            </div>
                          </div>
                        </div>
                      </PhaseWrapper>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        ) : (
          <div class="course-development">
            <div class="course-development-icon">
              <span class="course-development-icon-emoji">🚧</span>
            </div>
            <h3 class="course-development-title">Course Under Development</h3>
            <p class="course-development-description">
              We're working hard to bring you comprehensive {system.data.name} programming lessons.
              Check back soon!
            </p>
            <a href={`/vault/systems/${system.slug}`} class="course-development-cta">
              Learn About This System →
            </a>
          </div>
        )
      }
    </div>
  </div>
</Layout>
