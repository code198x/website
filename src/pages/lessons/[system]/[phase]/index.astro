---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import { getSystemColors, getDifficultyIcon } from '../../../../utils/systemColors.js';

export async function getStaticPaths() {
  const phases = await getCollection('phases');
  return phases.map((phase) => ({
    params: { 
      system: phase.data.system,
      phase: `phase-${phase.data.phase_number}`
    },
    props: { phase },
  }));
}

const { phase } = Astro.props;
const { Content } = await phase.render();

// Get system info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === phase.data.system);

// Get tiers for this phase
const allTiers = await getCollection('tiers');
const phaseTiers = allTiers
  .filter(tier => 
    tier.data.system === phase.data.system && 
    tier.data.phase_number === phase.data.phase_number
  )
  .sort((a, b) => a.data.tier_number - b.data.tier_number);

const colors = getSystemColors(phase.data.system);
---

<Layout title={`${system?.data.name} - Phase ${phase.data.phase_number}: ${phase.data.title}`}>
  <!-- Phase Header -->
  <div class={`lesson-header ${colors.className}`}>
    <div class="container">
      <!-- Breadcrumb inside header -->
      <nav class="lesson-breadcrumb">
        <div class="lesson-breadcrumb-list">
          <a href="/lessons" class="lesson-breadcrumb-link">Lessons</a>
          <span class="lesson-breadcrumb-separator">→</span>
          <a href={`/lessons/${phase.data.system}`} class="lesson-breadcrumb-link">
            {system?.data.name}
          </a>
          <span class="lesson-breadcrumb-separator">→</span>
          <span>Phase {phase.data.phase_number}</span>
        </div>
      </nav>
      <div class="lesson-header-content">
        <div class="lesson-header-badge large">
          {phase.data.phase_number}
        </div>
        <div class="lesson-header-info">
          <h1 class="lesson-header-title">
            {phase.data.title}
          </h1>
          <p class="lesson-header-subtitle">
            {phase.data.description}
          </p>
          <div class="lesson-header-meta">
            <span class="lesson-meta-badge">
              {getDifficultyIcon(phase.data.difficulty_level)} {phase.data.difficulty_level}
            </span>
            <span class="lesson-meta-badge">
              ⏱️ {phase.data.estimated_duration}
            </span>
            <span class="lesson-meta-badge">
              📚 {phaseTiers.length} tiers
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <!-- Phase Overview Content -->
    {Content && (
      <div style="margin-bottom: 3rem;">
        <div class="lesson-content-wrapper">
          <div class="lesson-prose">
            <Content />
          </div>
        </div>
      </div>
    )}

    <!-- Learning Path Section -->
    <div style="margin-bottom: 3rem;">
      <div style="text-align: center; margin-bottom: 2rem;">
        <h2 style="font-size: 2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">
          Learning Path
        </h2>
        <p style="font-size: 1.125rem; color: #64748b; max-width: 42rem; margin: 0 auto;">
          Progress through {phaseTiers.length} carefully structured tiers. Each tier builds upon the previous, 
          introducing new concepts and culminating in hands-on projects.
        </p>
      </div>
      
      <!-- Tier Cards -->
      <div style="display: grid; gap: 1.5rem;">
        {phaseTiers.map((tier, index) => (
          <a 
            href={`/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`}
            class={`lesson-card ${colors.className}`}
          >
            <div style="display: flex;">
              <div class="lesson-card-accent"></div>
              <div class="lesson-card-content">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem;">
                  <div style="display: flex; align-items: flex-start; gap: 1.5rem; flex: 1;">
                    <div class="lesson-card-number">
                      {tier.data.tier_number}
                    </div>
                    <div style="flex: 1;">
                      <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--system-primary); margin: 0 0 0.5rem 0;">
                        {tier.data.title}
                      </h3>
                      <p style="color: #475569; margin: 0 0 1rem 0; line-height: 1.6;">
                        {tier.data.description}
                      </p>
                      
                      <!-- Concepts -->
                      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
                        {tier.data.concepts_introduced.slice(0, 4).map((concept) => (
                          <span class="concept-pill">
                            {concept}
                          </span>
                        ))}
                        {tier.data.concepts_introduced.length > 4 && (
                          <span class="concept-pill">
                            +{tier.data.concepts_introduced.length - 4} more
                          </span>
                        )}
                      </div>
                      
                      <!-- Game Project -->
                      {tier.data.game_project && (
                        <div style="background: var(--system-light); border: 1px solid var(--system-primary); border-radius: 8px; padding: 1rem; margin-top: 1rem;">
                          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <span style="font-size: 1.5rem;">🎮</span>
                            <div>
                              <h4 style="font-size: 1rem; font-weight: 600; color: var(--system-primary); margin: 0 0 0.25rem 0;">
                                Project: {tier.data.game_project.name}
                              </h4>
                              <p style="font-size: 0.875rem; color: #475569; margin: 0;">
                                {tier.data.game_project.description}
                              </p>
                            </div>
                          </div>
                        </div>
                      )}
                      
                      <!-- Meta Info -->
                      <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1rem; color: #64748b; font-size: 0.875rem;">
                        <span>Tier {index + 1} of {phaseTiers.length}</span>
                        <span>•</span>
                        <span>{tier.data.estimated_duration}</span>
                      </div>
                    </div>
                  </div>
                  
                  <!-- CTA Button -->
                  <div style="flex-shrink: 0;">
                    <div class="lesson-nav-button primary" style="display: inline-block;">
                      Start Tier →
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>