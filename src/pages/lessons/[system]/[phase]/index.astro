---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const phases = await getCollection('phases');
  return phases.map((phase) => ({
    params: { 
      system: phase.data.system,
      phase: `phase-${phase.data.phase_number}`
    },
    props: { phase },
  }));
}

const { phase } = Astro.props;
const { Content } = await phase.render();

// Get system info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.data.slug === phase.data.system);

// Get tiers for this phase
const allTiers = await getCollection('tiers');
const phaseTiers = allTiers
  .filter(tier => 
    tier.data.system === phase.data.system && 
    tier.data.phase_number === phase.data.phase_number
  )
  .sort((a, b) => a.data.tier_number - b.data.tier_number);
---

<Layout title={`${system?.data.name} - Phase ${phase.data.phase_number}: ${phase.data.title}`}>
  <main class="container mx-auto px-4 py-8">
    <nav class="mb-6 text-sm">
      <a href={`/systems/${phase.data.system}`} class="text-blue-600 hover:underline">
        {system?.data.name}
      </a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">Phase {phase.data.phase_number}: {phase.data.title}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Phase {phase.data.phase_number}: {phase.data.title}</h1>
      <div class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-6">
        <p class="text-lg">{phase.data.description}</p>
        <div class="mt-4 grid md:grid-cols-3 gap-4 text-sm">
          <div>
            <strong>Duration:</strong> {phase.data.estimated_duration}
          </div>
          <div>
            <strong>Difficulty:</strong> {phase.data.difficulty_level}
          </div>
          <div>
            <strong>Tiers:</strong> {phaseTiers.length} tiers
          </div>
        </div>
      </div>
    </div>

    <div class="prose max-w-none mb-12">
      <Content />
    </div>

    <div>
      <h2 class="text-3xl font-bold mb-6">Tiers</h2>
      <div class="grid gap-6">
        {phaseTiers.map((tier) => (
          <div class="border rounded-lg p-6 hover:shadow-lg transition-shadow">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-semibold">
                <a 
                  href={`/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`}
                  class="hover:text-blue-600"
                >
                  Tier {tier.data.tier_number}: {tier.data.title}
                </a>
              </h3>
              {tier.data.game_project && (
                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">
                  Game Project
                </span>
              )}
            </div>
            <p class="text-gray-600 mb-4">{tier.data.description}</p>
            <div class="text-sm text-gray-500">
              <div class="mb-2">
                <strong>Concepts:</strong> {tier.data.concepts_introduced.join(', ')}
              </div>
              <div>
                <strong>Duration:</strong> {tier.data.estimated_duration}
              </div>
            </div>
            {tier.data.game_project && (
              <div class="mt-4 p-4 bg-green-50 rounded">
                <h4 class="font-semibold text-green-800">{tier.data.game_project.name}</h4>
                <p class="text-sm text-green-700">{tier.data.game_project.description}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>