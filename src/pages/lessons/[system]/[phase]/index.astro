---
import { getCollection } from "astro:content";
import PhaseLayout from "../../../../layouts/PhaseLayout.astro";
import LessonHeader from "../../../../components/LessonHeader.astro";
import type { BreadcrumbItem } from "../../../../components/Breadcrumb.astro";
import { getSystemColors, getDifficultyIcon } from "../../../../utils/systemColors.js";

export async function getStaticPaths() {
  const phases = await getCollection("phases");
  return phases.map((phase) => ({
    params: {
      system: phase.data.system,
      phase: `phase-${phase.data.phase_number}`,
    },
    props: { phase },
  }));
}

const { phase } = Astro.props;
const { Content } = await phase.render();

// Get system info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === phase.data.system);

// Get tiers for this phase
const allTiers = await getCollection("tiers");
const phaseTiers = allTiers
  .filter(
    (tier) =>
      tier.data.system === phase.data.system && tier.data.phase_number === phase.data.phase_number
  )
  .sort((a, b) => a.data.tier_number - b.data.tier_number);

// Get all lessons for progress calculation
const allLessons = await getCollection("lessons");

// Calculate progress for each tier
function calculateTierProgress(systemSlug, phaseNumber, tierNumber) {
  const tierLessons = allLessons.filter(lesson => {
    const [system, phase, tier] = lesson.id.split('/');
    return system === systemSlug &&
           phase === `phase-${phaseNumber}` &&
           tier === `tier-${tierNumber}`;
  });

  const publishedLessons = tierLessons.filter(lesson =>
    lesson.data.content_status === 'published'
  );

  const expectedTotal = phaseNumber === 0 ? 16 : 32; // Phase 0: 16 lessons per tier, Others: 32
  const percentage = Math.round((publishedLessons.length / expectedTotal) * 100);

  let status;
  if (percentage === 0) status = 'not-started';
  else if (percentage < 25) status = 'early-access';
  else if (percentage < 50) status = 'partial';
  else if (percentage < 100) status = 'near-complete';
  else status = 'complete';

  return { status, percentage, count: publishedLessons.length, total: expectedTotal };
}

// Calculate individual lesson progress for each tier
function calculateLessonProgress(systemSlug, phaseNumber, tierNumber) {
  const lessonProgress = [];
  const totalLessons = phaseNumber === 0 ? 16 : 32; // Phase 0 has 16 lessons per tier

  for (let lessonNum = 1; lessonNum <= totalLessons; lessonNum++) {
    const lesson = allLessons.find(l => {
      const [system, phase, tier] = l.id.split('/');
      return system === systemSlug &&
             phase === `phase-${phaseNumber}` &&
             tier === `tier-${tierNumber}` &&
             l.data.lesson_number === lessonNum;
    });

    let status;
    if (!lesson) {
      status = 'not-created';
    } else if (lesson.data.content_status === 'published') {
      status = 'published';
    } else if (lesson.data.content_status === 'draft') {
      status = 'draft';
    } else {
      status = 'template';
    }

    lessonProgress.push({ status, lessonNum });
  }

  return lessonProgress;
}

// Add progress to each tier
const tiersWithProgress = phaseTiers.map((tier) => ({
  ...tier,
  progress: calculateTierProgress(phase.data.system, phase.data.phase_number, tier.data.tier_number),
  lessonProgress: calculateLessonProgress(phase.data.system, phase.data.phase_number, tier.data.tier_number)
}));

const colors = getSystemColors(phase.data.system);

// Generate breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { label: "Lessons", href: "/lessons" },
  { label: system?.data.name || phase.data.system, href: `/lessons/${phase.data.system}` },
  { label: `Phase ${phase.data.phase_number}` },
];

// Prepare meta information
const metaInfo = [
  {
    icon: getDifficultyIcon(phase.data.difficulty_level),
    label: "Difficulty",
    value: phase.data.difficulty_level,
  },
  { icon: "⏱️", label: "Duration", value: phase.data.estimated_duration },
  { icon: "📚", label: "Tiers", value: `${phaseTiers.length} tiers` },
];
---

<PhaseLayout title={`${system?.data.name} - Phase ${phase.data.phase_number}: ${phase.data.title}`}>
  <!-- Phase Header -->
  <LessonHeader
    system={phase.data.system}
    systemName={system?.data.name}
    badge={{ number: phase.data.phase_number, size: "large" }}
    title={phase.data.title}
    description={phase.data.description}
    meta={metaInfo}
    breadcrumbs={breadcrumbs}
  />

  <!-- Phase Overview Content -->
  {
    Content && (
      <div class="lesson-content-wrapper">
        <div class="lesson-prose">
          <Content />
        </div>
      </div>
    )
  }

  <div class="container">
    <!-- Learning Path Section -->
    <div class="learning-path">
      <div class="learning-path-header">
        <h2 class="learning-path-title">Learning Path</h2>
        <p class="learning-path-description">
          {phase.data.phase_number === 0
            ? `Learn C64 BASIC programming through ${phaseTiers.length} structured tiers. Discover essential programming concepts before diving into assembly language.`
            : `Progress through ${phaseTiers.length} carefully structured assembly programming tiers. Each tier builds upon the previous, introducing new concepts and culminating in hands-on projects.`
          }
        </p>

        <!-- Tier Progress Indicators -->
        <div class="tier-progress-indicators">
          {tiersWithProgress.map((tier, index) => {
            const isClickable = tier.progress.count > 0;
            const TierElement = isClickable ? 'a' : 'div';
            const tierProps = isClickable ? {
              href: `/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`
            } : {};

            let tierClass = 'tier-indicator';
            if (tier.progress.status === 'complete') tierClass += ' tier-green';
            else if (tier.progress.status === 'near-complete' || tier.progress.status === 'partial') tierClass += ' tier-amber';
            else if (tier.progress.status === 'early-access') tierClass += ' tier-red';
            else tierClass += ' tier-grey';

            if (isClickable) tierClass += ' tier-clickable';

            return (
              <TierElement
                {...tierProps}
                class={tierClass}
                title={`Tier ${tier.data.tier_number}: ${tier.progress.count}/${tier.progress.total} lessons (${tier.progress.percentage}%)`}
              >
                <span class="tier-number">T{tier.data.tier_number}</span>
              </TierElement>
            );
          })}
        </div>
      </div>

      <!-- Phase Type Indicator for Phase 0 -->
      {phase.data.phase_number === 0 && (
        <div class="phase-type-indicator basic-phase">
          <div class="phase-type-header">
            <span class="phase-type-icon">💻</span>
            <div class="phase-type-info">
              <h3 class="phase-type-title">BASIC Programming Foundation</h3>
              <p class="phase-type-description">
                Start your programming journey with C64 BASIC. Learn essential concepts like variables, loops, and conditional logic that will prepare you for assembly language in later phases.
              </p>
            </div>
          </div>
        </div>
      )}

      <!-- Phase Type Indicator for Assembly Phases -->
      {phase.data.phase_number > 0 && (
        <div class="phase-type-indicator assembly-phase">
          <div class="phase-type-header">
            <span class="phase-type-icon">⚙️</span>
            <div class="phase-type-info">
              <h3 class="phase-type-title">Assembly Programming - Phase {phase.data.phase_number}</h3>
              <p class="phase-type-description">
                Low-level programming directly with the processor. Control every byte, optimize for speed, and discover how the hardware really works.
              </p>
            </div>
          </div>
        </div>
      )}

      <!-- Tier Cards -->
      <div class="tier-cards">
        {
          tiersWithProgress.map((tier, index) => {
            const hasContent = tier.progress.count > 0;
            const isClickable = hasContent;

            let progressClass = 'tier-progress-indicator';
            if (tier.progress.status === 'complete') progressClass += ' progress-green';
            else if (tier.progress.status === 'near-complete' || tier.progress.status === 'partial') progressClass += ' progress-amber';
            else if (tier.progress.status === 'early-access') progressClass += ' progress-red';
            else progressClass += ' progress-grey';

            const TierElement = isClickable ? 'a' : 'div';
            const tierProps = isClickable ? {
              href: `/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`
            } : {};

            return (
              <TierElement
                {...tierProps}
                class={`lesson-card ${colors.className} ${!isClickable ? 'lesson-card-disabled' : ''}`}
              >
                <div class="tier-card-layout">
                  <div class="lesson-card-accent" />
                  <div class="tier-card-content">
                    <div class="tier-card-header">
                      <div class="tier-card-main">
                        <div class="lesson-card-number">{tier.data.tier_number}</div>
                        <div class="tier-card-info">
                          <div class="tier-card-title-row">
                            <h3 class="tier-card-title">{tier.data.title}</h3>
                            <div class={progressClass} title={`${tier.progress.count}/${tier.progress.total} lessons (${tier.progress.percentage}%)`}>
                              <span class="progress-text">{tier.progress.count}/{tier.progress.total}</span>
                            </div>
                          </div>
                          <p class="tier-card-description">{tier.data.description}</p>

                          <div class="tier-card-concepts">
                            {tier.data.concepts_introduced.slice(0, 4).map((concept) => (
                              <span class="concept-pill">{concept}</span>
                            ))}
                            {tier.data.concepts_introduced.length > 4 && (
                              <span class="concept-pill">
                                +{tier.data.concepts_introduced.length - 4} more
                              </span>
                            )}
                          </div>

                          {tier.data.game_project && (
                            <div class="game-project">
                              <div class="game-project-header">
                                <span class="game-project-icon">🎮</span>
                                <div class="game-project-info">
                                  <h4 class="game-project-title">
                                    Project: {tier.data.game_project.name}
                                  </h4>
                                  <p class="game-project-description">
                                    {tier.data.game_project.description}
                                  </p>
                                </div>
                              </div>
                            </div>
                          )}

                          <div class="tier-card-footer">
                            <span>
                              Tier {index + 1} of {tiersWithProgress.length}
                            </span>
                            <span class="tier-card-separator">•</span>
                            <span>{tier.data.estimated_duration}</span>
                          </div>

                          {/* Lesson Progress Dots */}
                          <div class={`tier-card-lesson-progress ${phase.data.phase_number === 0 ? 'phase-0-lessons' : ''}`}>
                            {tier.lessonProgress.map((lesson) => {
                              let dotClass = 'lesson-dot';
                              if (lesson.status === 'published') dotClass += ' lesson-dot-green';
                              else if (lesson.status === 'draft') dotClass += ' lesson-dot-amber';
                              else if (lesson.status === 'template') dotClass += ' lesson-dot-red';
                              else dotClass += ' lesson-dot-grey';

                              return (
                                <div
                                  class={dotClass}
                                  data-lesson={lesson.lessonNum}
                                  title={`Lesson ${lesson.lessonNum}: ${lesson.status}`}
                                />
                              );
                            })}
                          </div>
                        </div>
                      </div>

                      <div class="tier-card-action">
                        {isClickable ? (
                          <div class="lesson-nav-button primary">Start Tier →</div>
                        ) : (
                          <div class="lesson-nav-button disabled">Coming Soon</div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </TierElement>
            );
          })
        }
      </div>
    </div>
  </div>
</PhaseLayout>
