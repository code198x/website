---
import { getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import LessonHeader from "../../../../components/LessonHeader.astro";
import type { BreadcrumbItem } from "../../../../components/Breadcrumb.astro";
import { getSystemColors, getDifficultyIcon } from "../../../../utils/systemColors.js";

export async function getStaticPaths() {
  const phases = await getCollection("phases");
  return phases.map((phase) => ({
    params: {
      system: phase.data.system,
      phase: `phase-${phase.data.phase_number}`,
    },
    props: { phase },
  }));
}

const { phase } = Astro.props;
const { Content } = await phase.render();

// Get system info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === phase.data.system);

// Get tiers for this phase
const allTiers = await getCollection("tiers");
const phaseTiers = allTiers
  .filter(
    (tier) =>
      tier.data.system === phase.data.system && tier.data.phase_number === phase.data.phase_number
  )
  .sort((a, b) => a.data.tier_number - b.data.tier_number);

const colors = getSystemColors(phase.data.system);

// Generate breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { label: "Lessons", href: "/lessons" },
  { label: system?.data.name || phase.data.system, href: `/lessons/${phase.data.system}` },
  { label: `Phase ${phase.data.phase_number}` }
];

// Prepare meta information
const metaInfo = [
  { icon: getDifficultyIcon(phase.data.difficulty_level), label: "Difficulty", value: phase.data.difficulty_level },
  { icon: "⏱️", label: "Duration", value: phase.data.estimated_duration },
  { icon: "📚", label: "Tiers", value: `${phaseTiers.length} tiers` }
];
---

<Layout title={`${system?.data.name} - Phase ${phase.data.phase_number}: ${phase.data.title}`}>
  <!-- Phase Header -->
  <LessonHeader
    system={phase.data.system}
    systemName={system?.data.name}
    badge={{ number: phase.data.phase_number, size: "large" }}
    title={phase.data.title}
    description={phase.data.description}
    meta={metaInfo}
    breadcrumbs={breadcrumbs}
  />

  <div class="container">
    <!-- Phase Overview Content -->
    {
      Content && (
        <div class="lesson-content-wrapper">
          <div class="lesson-prose">
            <Content />
          </div>
        </div>
      )
    }

    <!-- Learning Path Section -->
    <div class="learning-path">
      <div class="learning-path-header">
        <h2 class="learning-path-title">
          Learning Path
        </h2>
        <p class="learning-path-description">
          Progress through {phaseTiers.length} carefully structured tiers. Each tier builds upon the
          previous, introducing new concepts and culminating in hands-on projects.
        </p>
      </div>

      <!-- Tier Cards -->
      <div class="tier-cards">
        {
          phaseTiers.map((tier, index) => (
            <a
              href={`/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`}
              class={`lesson-card ${colors.className}`}
            >
              <div class="tier-card-layout">
                <div class="lesson-card-accent" />
                <div class="tier-card-content">
                  <div class="tier-card-header">
                    <div class="tier-card-main">
                      <div class="lesson-card-number">{tier.data.tier_number}</div>
                      <div class="tier-card-info">
                        <h3 class="tier-card-title">
                          {tier.data.title}
                        </h3>
                        <p class="tier-card-description">
                          {tier.data.description}
                        </p>

                        <div class="tier-card-concepts">
                          {tier.data.concepts_introduced.slice(0, 4).map((concept) => (
                            <span class="concept-pill">{concept}</span>
                          ))}
                          {tier.data.concepts_introduced.length > 4 && (
                            <span class="concept-pill">
                              +{tier.data.concepts_introduced.length - 4} more
                            </span>
                          )}
                        </div>

                        {tier.data.game_project && (
                          <div class="game-project">
                            <div class="game-project-header">
                              <span class="game-project-icon">🎮</span>
                              <div class="game-project-info">
                                <h4 class="game-project-title">
                                  Project: {tier.data.game_project.name}
                                </h4>
                                <p class="game-project-description">
                                  {tier.data.game_project.description}
                                </p>
                              </div>
                            </div>
                          </div>
                        )}

                        <div class="tier-card-footer">
                          <span>
                            Tier {index + 1} of {phaseTiers.length}
                          </span>
                          <span class="tier-card-separator">•</span>
                          <span>{tier.data.estimated_duration}</span>
                        </div>
                      </div>
                    </div>

                    <div class="tier-card-action">
                      <div class="lesson-nav-button primary">
                        Start Tier →
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
