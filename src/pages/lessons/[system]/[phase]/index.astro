---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const phases = await getCollection('phases');
  return phases.map((phase) => ({
    params: { 
      system: phase.data.system,
      phase: `phase-${phase.data.phase_number}`
    },
    props: { phase },
  }));
}

const { phase } = Astro.props;
const { Content } = await phase.render();

// Get system info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === phase.data.system);

// Get tiers for this phase
const allTiers = await getCollection('tiers');
const phaseTiers = allTiers
  .filter(tier => 
    tier.data.system === phase.data.system && 
    tier.data.phase_number === phase.data.phase_number
  )
  .sort((a, b) => a.data.tier_number - b.data.tier_number);
---

<Layout title={`${system?.data.name} - Phase ${phase.data.phase_number}: ${phase.data.title}`}>
  <!-- Hero Section with Phase Branding -->
  <div class="system-hero">
    {(() => {
      // Define system-specific colors
      const getSystemColors = (slug) => {
        switch(slug) {
          case 'commodore-64':
            return { 
              bg: 'from-c64-brown to-c64-dark-brown', 
              accent: 'bg-c64-brown',
              text: 'text-c64-brown',
              border: 'border-c64-brown'
            };
          case 'zx-spectrum':
            return { 
              bg: 'from-spectrum-red to-spectrum-magenta', 
              accent: 'bg-spectrum-red',
              text: 'text-spectrum-red',
              border: 'border-spectrum-red'
            };
          case 'nintendo-entertainment-system':
            return { 
              bg: 'from-nes-red to-nes-dark-gray', 
              accent: 'bg-nes-red',
              text: 'text-nes-red',
              border: 'border-nes-red'
            };
          case 'commodore-amiga':
            return { 
              bg: 'from-amiga-blue to-amiga-orange', 
              accent: 'bg-amiga-blue',
              text: 'text-amiga-blue',
              border: 'border-amiga-blue'
            };
          default:
            return { 
              bg: 'from-slate-600 to-slate-800', 
              accent: 'bg-slate-600',
              text: 'text-slate-600',
              border: 'border-slate-600'
            };
        }
      };
      const colors = getSystemColors(phase.data.system);
      
      const getDifficultyIcon = (level) => {
        switch(level?.toLowerCase()) {
          case 'beginner': return '🟢';
          case 'intermediate': return '🟡';
          case 'advanced': return '🔴';
          default: return '⚪';
        }
      };
      
      return (
        <div class={`system-hero-gradient ${colors.bg}`}>
          <div class="system-hero-overlay"></div>
          <div class="system-hero-content">
            <nav class="system-hero-nav">
              <a href="/lessons">Lessons</a>
              <span style="margin: 0 var(--space-sm);">→</span>
              <a href={`/lessons/${phase.data.system}`}>
                {system?.data.name}
              </a>
              <span style="margin: 0 var(--space-sm);">→</span>
              <span style="color: white;">Phase {phase.data.phase_number}</span>
            </nav>
            
            <div style="display: flex; align-items: center; gap: var(--space-xl); margin-bottom: var(--space-xl);">
              <div class={`phase-hero-number ${colors.accent}`}>
                {phase.data.phase_number}
              </div>
              <div>
                <h1 class="system-hero-title">
                  {phase.data.title}
                </h1>
                <p class="system-hero-subtitle">
                  {system?.data.name} Programming Course
                </p>
              </div>
            </div>
            
            <p style="font-size: 1.25rem; color: rgba(255, 255, 255, 0.9); margin-bottom: var(--space-2xl); max-width: 48rem; line-height: 1.75;">
              {phase.data.description}
            </p>
            
            <div class="system-hero-specs">
              <span class="system-spec-badge">
                {getDifficultyIcon(phase.data.difficulty_level)} {phase.data.difficulty_level}
              </span>
              <span class="system-spec-badge">
                ⏱️ {phase.data.estimated_duration}
              </span>
              <span class="system-spec-badge">
                📚 {phaseTiers.length} tiers
              </span>
            </div>
          </div>
        </div>
      );
    })()}
  </div>

  <div class="container" style="padding: var(--space-4xl) 0;">
    <!-- Phase Overview (only if content is substantial and non-repetitive) -->
    <div style="margin-bottom: var(--space-4xl);">
      <div style="max-width: 64rem; margin: 0 auto;">
        <div class="phase-content">
          <Content />
        </div>
      </div>
    </div>

    <!-- Learning Path -->
    <div>
      <div style="text-align: center; margin-bottom: var(--space-2xl);">
        <h2 style="font-size: 1.875rem; font-weight: 700; margin-bottom: var(--space-lg);">Learning Path</h2>
        <p style="font-size: 1.125rem; color: var(--text-muted); max-width: 32rem; margin: 0 auto;">
          Progress through {phaseTiers.length} carefully structured tiers. Each tier builds upon the previous, 
          introducing new concepts and culminating in hands-on projects.
        </p>
      </div>
      
      <div style="display: flex; flex-direction: column; gap: var(--space-xl);">
        {phaseTiers.map((tier, index) => {
          const colors = (() => {
            switch(phase.data.system) {
              case 'commodore-64': return { accent: 'c64', text: 'c64' };
              case 'zx-spectrum': return { accent: 'spectrum', text: 'spectrum' };
              case 'nintendo-entertainment-system': return { accent: 'nes', text: 'nes' };
              case 'commodore-amiga': return { accent: 'amiga', text: 'amiga' };
              default: return { accent: 'default', text: 'default' };
            }
          })();
          
          return (
            <a 
              href={`/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`}
              class="tier-card"
            >
              <div style="display: flex;">
                <div class={`tier-card-accent ${colors.accent}`}></div>
                <div class="tier-card-content">
                  <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-lg);">
                    <div style="display: flex; align-items: center; gap: var(--space-xl);">
                      <div class={`tier-card-number ${colors.accent}`}>
                        {tier.data.tier_number}
                      </div>
                      <div>
                        <h3 class={`tier-card-title ${colors.text}`}>
                          {tier.data.title}
                        </h3>
                        <p class="tier-card-description">
                          {tier.data.description}
                        </p>
                        <div class="tier-card-concepts">
                          {tier.data.concepts_introduced.slice(0, 4).map((concept) => (
                            <span class="tier-card-concept">
                              {concept}
                            </span>
                          ))}
                          {tier.data.concepts_introduced.length > 4 && (
                            <span class="tier-card-concept">
                              +{tier.data.concepts_introduced.length - 4} more
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                    
                    <div style="text-align: right;">
                      {tier.data.game_project && (
                        <div style="margin-bottom: var(--space-md);">
                          <span class="tier-card-badge">
                            🎮 Project
                          </span>
                        </div>
                      )}
                      <div class={`tier-card-cta ${colors.accent}`}>
                        Start Tier →
                      </div>
                    </div>
                  </div>
                  
                  {tier.data.game_project && (
                    <div class="tier-card-project">
                      <div style="display: flex; align-items: flex-start; gap: var(--space-md);">
                        <div class="tier-card-project-icon">
                          🎮
                        </div>
                        <div>
                          <h4 class="tier-card-project-name">{tier.data.game_project.name}</h4>
                          <p class="tier-card-project-description">{tier.data.game_project.description}</p>
                        </div>
                      </div>
                    </div>
                  )}
                  
                  <div class="tier-card-footer">
                    <div class="tier-card-meta">
                      Tier {index + 1} of {phaseTiers.length} • {tier.data.estimated_duration}
                    </div>
                    <div class="tier-card-progress">
                      <div class="tier-card-progress-bar">
                        <div class="tier-card-progress-fill"></div>
                      </div>
                      <span class="tier-card-progress-text">0% complete</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</Layout>