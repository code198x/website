---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const phases = await getCollection('phases');
  return phases.map((phase) => ({
    params: { 
      system: phase.data.system,
      phase: `phase-${phase.data.phase_number}`
    },
    props: { phase },
  }));
}

const { phase } = Astro.props;
const { Content } = await phase.render();

// Get system info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === phase.data.system);

// Get tiers for this phase
const allTiers = await getCollection('tiers');
const phaseTiers = allTiers
  .filter(tier => 
    tier.data.system === phase.data.system && 
    tier.data.phase_number === phase.data.phase_number
  )
  .sort((a, b) => a.data.tier_number - b.data.tier_number);
---

<Layout title={`${system?.data.name} - Phase ${phase.data.phase_number}: ${phase.data.title}`}>
  <!-- Hero Section with Phase Branding -->
  <div class="relative overflow-hidden">
    {(() => {
      // Define system-specific colors
      const getSystemColors = (slug) => {
        switch(slug) {
          case 'commodore-64':
            return { 
              bg: 'from-c64-brown to-c64-dark-brown', 
              accent: 'bg-c64-brown',
              text: 'text-c64-brown',
              border: 'border-c64-brown'
            };
          case 'zx-spectrum':
            return { 
              bg: 'from-spectrum-red to-spectrum-magenta', 
              accent: 'bg-spectrum-red',
              text: 'text-spectrum-red',
              border: 'border-spectrum-red'
            };
          case 'nintendo-entertainment-system':
            return { 
              bg: 'from-nes-red to-nes-dark-gray', 
              accent: 'bg-nes-red',
              text: 'text-nes-red',
              border: 'border-nes-red'
            };
          case 'commodore-amiga':
            return { 
              bg: 'from-amiga-blue to-amiga-orange', 
              accent: 'bg-amiga-blue',
              text: 'text-amiga-blue',
              border: 'border-amiga-blue'
            };
          default:
            return { 
              bg: 'from-gray-600 to-gray-800', 
              accent: 'bg-gray-600',
              text: 'text-gray-600',
              border: 'border-gray-600'
            };
        }
      };
      const colors = getSystemColors(phase.data.system);
      
      const getDifficultyIcon = (level) => {
        switch(level?.toLowerCase()) {
          case 'beginner': return '🟢';
          case 'intermediate': return '🟡';
          case 'advanced': return '🔴';
          default: return '⚪';
        }
      };
      
      return (
        <div class={`bg-gradient-to-br ${colors.bg} text-white relative`}>
          <div class="absolute inset-0 bg-black/20"></div>
          <div class="container mx-auto px-4 py-12 relative z-10">
            <nav class="text-sm mb-6 text-white/80">
              <a href="/lessons" class="hover:text-white">Lessons</a>
              <span class="mx-2">→</span>
              <a href={`/lessons/${phase.data.system}`} class="hover:text-white">
                {system?.data.name}
              </a>
              <span class="mx-2">→</span>
              <span class="text-white">Phase {phase.data.phase_number}</span>
            </nav>
            
            <div class="flex items-center gap-6 mb-6">
              <div class={`w-20 h-20 ${colors.accent} rounded-2xl flex items-center justify-center text-white font-bold text-3xl shadow-2xl`}>
                {phase.data.phase_number}
              </div>
              <div>
                <h1 class="text-4xl md:text-5xl font-bold mb-2">
                  {phase.data.title}
                </h1>
                <p class="text-xl text-white/90">
                  {system?.data.name} Programming Course
                </p>
              </div>
            </div>
            
            <p class="text-xl text-white/90 mb-8 max-w-3xl leading-relaxed">
              {phase.data.description}
            </p>
            
            <div class="flex flex-wrap gap-4">
              <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
                <span>{getDifficultyIcon(phase.data.difficulty_level)}</span>
                <span class="text-sm font-medium">{phase.data.difficulty_level}</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
                <span>⏱️</span>
                <span class="text-sm font-medium">{phase.data.estimated_duration}</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
                <span>📚</span>
                <span class="text-sm font-medium">{phaseTiers.length} tiers</span>
              </div>
            </div>
          </div>
        </div>
      );
    })()}
  </div>

  <div class="container mx-auto px-4 py-12">
    <!-- Phase Overview (only if content is substantial and non-repetitive) -->
    <div class="mb-16">
      <div class="max-w-4xl mx-auto">
        <div class="phase-content">
          <Content />
        </div>
      </div>
    </div>

    <!-- Learning Path -->
    <div>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Learning Path</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Progress through {phaseTiers.length} carefully structured tiers. Each tier builds upon the previous, 
          introducing new concepts and culminating in hands-on projects.
        </p>
      </div>
      
      <div class="space-y-6">
        {phaseTiers.map((tier, index) => {
          const colors = (() => {
            switch(phase.data.system) {
              case 'commodore-64': return { accent: 'bg-c64-brown', hover: 'hover:bg-c64-brown', text: 'text-c64-brown' };
              case 'zx-spectrum': return { accent: 'bg-spectrum-red', hover: 'hover:bg-spectrum-red', text: 'text-spectrum-red' };
              case 'nintendo-entertainment-system': return { accent: 'bg-nes-red', hover: 'hover:bg-nes-red', text: 'text-nes-red' };
              case 'commodore-amiga': return { accent: 'bg-amiga-blue', hover: 'hover:bg-amiga-blue', text: 'text-amiga-blue' };
              default: return { accent: 'bg-gray-600', hover: 'hover:bg-gray-600', text: 'text-gray-600' };
            }
          })();
          
          const isAvailable = tier.data.tier_number === 1;
          
          return (
            <div class={`group block rounded-xl shadow-lg transition-all duration-200 overflow-hidden border-2 ${
              isAvailable 
                ? 'bg-white/90 hover:shadow-xl border-transparent hover:border-gray-200 cursor-pointer' 
                : 'bg-gray-50 border-gray-200 cursor-not-allowed opacity-75'
            }`}
            >
              {isAvailable ? (
                <a 
                  href={`/lessons/${phase.data.system}/phase-${phase.data.phase_number}/tier-${tier.data.tier_number}`}
                  class="block"
                >
              ) : (
                <div class="block">
              )}
              <div class="flex">
                <div class={`w-2 ${colors.accent} group-hover:w-4 transition-all duration-200`}></div>
                <div class="flex-1 p-8">
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-6">
                      <div class={`w-16 h-16 ${colors.accent} rounded-xl flex items-center justify-center text-white font-bold text-xl shadow-lg`}>
                        {tier.data.tier_number}
                      </div>
                      <div>
                        <h3 class={`text-2xl font-bold mb-2 group-${colors.hover} transition-colors`}>
                          {tier.data.title}
                        </h3>
                        <p class="text-gray-600 leading-relaxed mb-3">
                          {tier.data.description}
                        </p>
                        <div class="flex flex-wrap gap-2">
                          {tier.data.concepts_introduced.slice(0, 4).map((concept) => (
                            <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
                              {concept}
                            </span>
                          ))}
                          {tier.data.concepts_introduced.length > 4 && (
                            <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
                              +{tier.data.concepts_introduced.length - 4} more
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                    
                    <div class="text-right">
                      {isAvailable && tier.data.game_project && (
                        <div class="mb-3">
                          <span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full">
                            🎮 Project
                          </span>
                        </div>
                      )}
                      {isAvailable ? (
                        <div class={`px-6 py-3 ${colors.accent} text-white rounded-lg font-medium group-hover:scale-105 transition-transform shadow-lg`}>
                          Start Tier →
                        </div>
                      ) : (
                        <div class="px-6 py-3 bg-gray-400 text-gray-600 rounded-lg font-medium shadow-lg">
                          Coming Soon
                        </div>
                      )}
                    </div>
                  </div>
                  
                  {isAvailable && tier.data.game_project && (
                    <div class="mt-6 p-4 bg-green-50 rounded-lg border border-green-200">
                      <div class="flex items-start gap-3">
                        <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                          🎮
                        </div>
                        <div>
                          <h4 class="font-bold text-green-800 mb-1">{tier.data.game_project.name}</h4>
                          <p class="text-sm text-green-700">{tier.data.game_project.description}</p>
                        </div>
                      </div>
                    </div>
                  )}
                  {!isAvailable && (
                    <div class="mt-6 p-4 bg-amber-50 rounded-lg border border-amber-200">
                      <div class="flex items-center gap-3">
                        <div class="text-2xl">🚧</div>
                        <div>
                          <h4 class="font-bold text-amber-800 mb-1">Coming Soon</h4>
                          <p class="text-sm text-amber-700">This tier will be available in a future update.</p>
                        </div>
                      </div>
                    </div>
                  )}
                  
                  <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-100">
                    <div class="text-sm text-gray-500">
                      Tier {index + 1} of {phaseTiers.length} • {tier.data.estimated_duration}
                    </div>
                    <div class="flex items-center gap-2">
                      <div class="w-32 bg-gray-200 rounded-full h-2">
                        <div class="bg-green-500 h-2 rounded-full w-0"></div>
                      </div>
                      <span class="text-sm text-gray-500">0% complete</span>
                    </div>
                  </div>
                </div>
              </div>
              {isAvailable ? (
                </a>
              ) : (
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</Layout>