---
import { getCollection } from "astro:content";
import Layout from "../../../../../layouts/Layout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: {
      system: lesson.data.system,
      phase: `phase-${lesson.data.phase_number}`,
      tier: `tier-${lesson.data.tier_number}`,
      lesson: `lesson-${lesson.data.lesson_number.toString().padStart(3, "0")}`,
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await lesson.render();

// Get system info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === lesson.data.system);

// Get adjacent lessons for navigation
const allLessons = await getCollection("lessons");
const tierLessons = allLessons
  .filter(
    (l) =>
      l.data.system === lesson.data.system &&
      l.data.phase_number === lesson.data.phase_number &&
      l.data.tier_number === lesson.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

const currentIndex = tierLessons.findIndex(
  (l) => l.data.lesson_number === lesson.data.lesson_number
);
const prevLesson = currentIndex > 0 ? tierLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < tierLessons.length - 1 ? tierLessons[currentIndex + 1] : null;

// Get difficulty icon
const getDifficultyIcon = (level: string | undefined) => {
  switch (level?.toLowerCase()) {
    case "easy":
    case "beginner":
      return "🟢";
    case "intermediate":
      return "🟡";
    case "hard":
    case "advanced":
      return "🔴";
    default:
      return "⚪";
  }
};
---

<Layout title={`${lesson.data.title} - ${system?.data.name} Lesson ${lesson.data.lesson_number}`}>
  <Breadcrumb
    segments={[
      { text: "Lessons", href: "/lessons" },
      { text: system?.data.name || "System", href: `/lessons/${lesson.data.system}` },
      {
        text: `Phase ${lesson.data.phase_number}`,
        href: `/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}`,
      },
      {
        text: `Tier ${lesson.data.tier_number}`,
        href: `/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`,
      },
      { text: `Lesson ${lesson.data.lesson_number}`, href: "#" },
    ]}
  />

  <!-- Lesson Header -->
  <div class={`lesson-header lesson-header--${lesson.data.system}`}>
    <div class="container">
      <div class="lesson-header__content">
        <div class="lesson-header__number">
          {lesson.data.lesson_number}
        </div>
        <div class="lesson-header__info">
          <h1 class="lesson-header__title">
            {lesson.data.title}
          </h1>
          <p class="lesson-header__description">
            {lesson.data.description}
          </p>
          <div class="lesson-header__meta">
            <span class="lesson-meta lesson-meta--difficulty">
              {getDifficultyIcon(lesson.data.difficulty)}
              {lesson.data.difficulty}
            </span>
            <span class="lesson-meta lesson-meta--duration">
              ⏱️ {lesson.data.estimated_duration}
            </span>
            {
              (lesson.data as any).requires_hardware && (
                <span class="lesson-meta lesson-meta--hardware">
                  🎮 Requires Hardware
                </span>
              )
            }
            {
              (lesson.data as any).requires_software && (
                <span class="lesson-meta lesson-meta--software">
                  💾 Requires Software
                </span>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Learning Objectives & Key Concepts -->
  <div class="container">
    <div class="lesson-cards">
      {
        lesson.data.learning_objectives && lesson.data.learning_objectives.length > 0 && (
          <div class="objectives-box">
            <div class="objectives-box__header">
              <span class="objectives-box__icon">🎯</span>
              <h2 class="objectives-heading">Learning Objectives</h2>
            </div>
            <ul class="objectives-list">
              {lesson.data.learning_objectives.map((objective: string) => (
                <li class="objectives-item">
                  <span class="objectives-bullet" />
                  {objective}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        lesson.data.concepts && lesson.data.concepts.length > 0 && (
          <div class="concepts-box">
            <div class="concepts-box__header">
              <span class="concepts-box__icon">🧠</span>
              <h2 class="concepts-heading">Key Concepts</h2>
            </div>
            <div class="concepts-tags">
              {lesson.data.concepts.map((concept: string) => (
                <span class="concept-tag">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <!-- Main Content -->
    <div class="lesson-content">
      <div class="prose lesson-prose">
        <Content />
      </div>
    </div>

    <!-- Navigation -->
    <div class="nav-divider">
      <div class="lesson-nav">
        {
          prevLesson ? (
            <a
              href={`/lessons/${prevLesson.data.system}/phase-${prevLesson.data.phase_number}/tier-${prevLesson.data.tier_number}/lesson-${prevLesson.data.lesson_number.toString().padStart(3, "0")}`}
              class={`lesson-nav__link lesson-nav__link--prev lesson-nav__link--${lesson.data.system}`}
            >
              <span>←</span>
              <div>
                <div class="lesson-nav__label">Previous</div>
                <div class="lesson-nav__title">{prevLesson.data.title}</div>
              </div>
            </a>
          ) : (
            <div />
          )
        }
        {
          nextLesson ? (
            <a
              href={`/lessons/${nextLesson.data.system}/phase-${nextLesson.data.phase_number}/tier-${nextLesson.data.tier_number}/lesson-${nextLesson.data.lesson_number.toString().padStart(3, "0")}`}
              class={`lesson-nav__link lesson-nav__link--next lesson-nav__link--${lesson.data.system}`}
            >
              <div>
                <div class="lesson-nav__label">Next</div>
                <div class="lesson-nav__title">{nextLesson.data.title}</div>
              </div>
              <span>→</span>
            </a>
          ) : (
            <a
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`}
              class="lesson-nav__link lesson-nav__link--complete"
            >
              <span>🎉</span>
              <div>
                <div class="lesson-nav__label">Tier Complete!</div>
                <div class="lesson-nav__title">Back to Tier Overview</div>
              </div>
            </a>
          )
        }
      </div>

      {
        lesson.data.external_resources && lesson.data.external_resources.length > 0 && (
          <div class="resources-section">
            <h2 class="resources-title">
              Additional Resources
            </h2>
            <div class="resources-list">
              {lesson.data.external_resources.map(
                (resource: { title: string; url: string; type: string }) => (
                  <a
                    href={resource.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="resource-link"
                  >
                    <div class="resource-info">
                      <span class="resource-icon">📖</span>
                      <div>
                        <div class="resource-title">{resource.title}</div>
                        <div class="resource-type">{resource.type}</div>
                      </div>
                    </div>
                    <span class="resource-arrow">↗</span>
                  </a>
                )
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>

</Layout>
