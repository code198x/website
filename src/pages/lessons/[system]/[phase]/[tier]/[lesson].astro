---
import { getCollection } from "astro:content";
import LessonLayout from "../../../../../layouts/LessonLayout.astro";
import LessonHeader from "../../../../../components/LessonHeader.astro";
import type { BreadcrumbItem } from "../../../../../components/Breadcrumb.astro";
import { getSystemColors, getDifficultyIcon } from "../../../../../utils/systemColors.js";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: {
      system: lesson.data.system,
      phase: `phase-${lesson.data.phase_number}`,
      tier: `tier-${lesson.data.tier_number}`,
      lesson: `lesson-${lesson.data.lesson_number.toString().padStart(3, "0")}`,
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await lesson.render();

// Get system info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === lesson.data.system);

// Get adjacent lessons for navigation
const allLessons = await getCollection("lessons");
const tierLessons = allLessons
  .filter(
    (l) =>
      l.data.system === lesson.data.system &&
      l.data.phase_number === lesson.data.phase_number &&
      l.data.tier_number === lesson.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

const currentIndex = tierLessons.findIndex(
  (l) => l.data.lesson_number === lesson.data.lesson_number
);
const prevLesson = currentIndex > 0 ? tierLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < tierLessons.length - 1 ? tierLessons[currentIndex + 1] : null;

const colors = getSystemColors(lesson.data.system);

// Generate breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { label: "Lessons", href: "/lessons" },
  { label: system?.data.name || lesson.data.system, href: `/lessons/${lesson.data.system}` },
  {
    label: `Phase ${lesson.data.phase_number}`,
    href: `/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}`,
  },
  {
    label: `Tier ${lesson.data.tier_number}`,
    href: `/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`,
  },
  { label: `Lesson ${lesson.data.lesson_number}` },
];

// Prepare meta information
const metaInfo: Array<{
  label: string;
  value: string | number;
  icon?: string;
  type?: "default" | "success" | "warning";
}> = [
  { icon: "⏱️", label: "Duration", value: lesson.data.estimated_duration },
  { icon: getDifficultyIcon(lesson.data.difficulty), label: "Difficulty", value: lesson.data.difficulty },
];

if ((lesson.data as any).requires_hardware) {
  metaInfo.push({ icon: "🎮", label: "Hardware", value: "Required", type: "warning" });
}
if ((lesson.data as any).requires_software) {
  metaInfo.push({ icon: "💾", label: "Software", value: "Required", type: "warning" });
}
---

<LessonLayout
  title={`${lesson.data.title} - ${system?.data.name} P${lesson.data.phase_number}T${lesson.data.tier_number}L${lesson.data.lesson_number}`}
>
  <!-- Lesson Header -->
  <LessonHeader
    system={lesson.data.system}
    systemName={system?.data.name}
    badge={{ number: lesson.data.lesson_number, size: "medium" }}
    title={lesson.data.title}
    description={lesson.data.description}
    meta={metaInfo}
    breadcrumbs={breadcrumbs}
    concepts={lesson.data.concepts}
  />

  <!-- Learning Objectives -->
  {
    lesson.data.learning_objectives && lesson.data.learning_objectives.length > 0 && (
      <div class="lesson-objectives-section">
        <div class="lesson-objectives-header">
          <span class="lesson-objectives-icon">🎯</span>
          <h2 class="lesson-objectives-title">Learning Objectives</h2>
        </div>
        <ul class="lesson-objectives-list">
          {lesson.data.learning_objectives.map((objective: string) => (
            <li class="lesson-objectives-item">{objective}</li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Main Content -->
  <div class="lesson-content-wrapper">
    <div class="lesson-prose">
      <Content />
    </div>
  </div>

  <!-- Navigation -->
  <div class="lesson-nav-section">
    <div class="lesson-nav">
        {
          prevLesson ? (
            <a
              href={`/lessons/${prevLesson.data.system}/phase-${prevLesson.data.phase_number}/tier-${prevLesson.data.tier_number}/lesson-${prevLesson.data.lesson_number.toString().padStart(3, "0")}`}
              class={`lesson-nav__link lesson-nav__link--prev lesson-nav__link--${lesson.data.system}`}
            >
              <span>←</span>
              <div>
                <div class="lesson-nav__label">Previous</div>
                <div class="lesson-nav__title">Lesson {prevLesson.data.lesson_number}: {prevLesson.data.title}</div>
              </div>
            </a>
          ) : (
            <div />
          )
        }
        {
          nextLesson ? (
            <a
              href={`/lessons/${nextLesson.data.system}/phase-${nextLesson.data.phase_number}/tier-${nextLesson.data.tier_number}/lesson-${nextLesson.data.lesson_number.toString().padStart(3, "0")}`}
              class={`lesson-nav__link lesson-nav__link--next lesson-nav__link--${lesson.data.system}`}
            >
              <div>
                <div class="lesson-nav__label">Next</div>
                <div class="lesson-nav__title">Lesson {nextLesson.data.lesson_number}: {nextLesson.data.title}</div>
              </div>
              <span>→</span>
            </a>
          ) : (
            <a
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`}
              class="lesson-nav__link lesson-nav__link--complete"
            >
              <span>🎉</span>
              <div>
                <div class="lesson-nav__label">Tier Complete!</div>
                <div class="lesson-nav__title">Back to Tier Overview</div>
              </div>
            </a>
          )
        }
      </div>

      {
        lesson.data.external_resources && lesson.data.external_resources.length > 0 && (
          <div class="resources-section">
            <h2 class="resources-title">Additional Resources</h2>
            <div class="resources-list">
              {lesson.data.external_resources.map(
                (resource: { title: string; url: string; type: string }) => (
                  <a
                    href={resource.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="resource-link"
                  >
                    <div class="resource-info">
                      <span class="resource-icon">📖</span>
                      <div>
                        <div class="resource-title">{resource.title}</div>
                        <div class="resource-type">{resource.type}</div>
                      </div>
                    </div>
                    <span class="resource-arrow">↗</span>
                  </a>
                )
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
</LessonLayout>
