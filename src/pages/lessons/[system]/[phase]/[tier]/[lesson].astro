---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { 
      system: lesson.data.system,
      phase: `phase-${lesson.data.phase_number}`,
      tier: `tier-${lesson.data.tier_number}`,
      lesson: `lesson-${lesson.data.lesson_number.toString().padStart(3, '0')}`
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await lesson.render();

// Get system, phase, and tier info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === lesson.data.system);

const allPhases = await getCollection('phases');
const phase = allPhases.find(p => 
  p.data.system === lesson.data.system && 
  p.data.phase_number === lesson.data.phase_number
);

const allTiers = await getCollection('tiers');
const tier = allTiers.find(t => 
  t.data.system === lesson.data.system && 
  t.data.phase_number === lesson.data.phase_number &&
  t.data.tier_number === lesson.data.tier_number
);

// Get adjacent lessons for navigation
const allLessons = await getCollection('lessons');
const tierLessons = allLessons
  .filter(l => 
    l.data.system === lesson.data.system && 
    l.data.phase_number === lesson.data.phase_number &&
    l.data.tier_number === lesson.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

const currentIndex = tierLessons.findIndex(l => l.data.lesson_number === lesson.data.lesson_number);
const prevLesson = currentIndex > 0 ? tierLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < tierLessons.length - 1 ? tierLessons[currentIndex + 1] : null;
---

<Layout title={`${system?.data.name} - Lesson ${lesson.data.lesson_number}: ${lesson.data.title}`}>
  <!-- Hero Section with Lesson Branding -->
  <div class="relative overflow-hidden">
    {(() => {
      // Define system-specific colors
      const getSystemColors = (slug) => {
        switch(slug) {
          case 'commodore-64':
            return { 
              bg: 'from-c64-brown to-c64-dark-brown', 
              accent: 'bg-c64-brown',
              text: 'text-c64-brown',
              border: 'border-c64-brown'
            };
          case 'zx-spectrum':
            return { 
              bg: 'from-spectrum-red to-spectrum-magenta', 
              accent: 'bg-spectrum-red',
              text: 'text-spectrum-red',
              border: 'border-spectrum-red'
            };
          case 'nintendo-entertainment-system':
            return { 
              bg: 'from-nes-red to-nes-dark-gray', 
              accent: 'bg-nes-red',
              text: 'text-nes-red',
              border: 'border-nes-red'
            };
          case 'commodore-amiga':
            return { 
              bg: 'from-amiga-blue to-amiga-orange', 
              accent: 'bg-amiga-blue',
              text: 'text-amiga-blue',
              border: 'border-amiga-blue'
            };
          default:
            return { 
              bg: 'from-gray-600 to-gray-800', 
              accent: 'bg-gray-600',
              text: 'text-gray-600',
              border: 'border-gray-600'
            };
        }
      };
      const colors = getSystemColors(lesson.data.system);
      
      const getDifficultyIcon = (level) => {
        switch(level?.toLowerCase()) {
          case 'beginner': return '🟢';
          case 'intermediate': return '🟡';
          case 'advanced': return '🔴';
          default: return '⚪';
        }
      };
      
      return (
        <div class={`bg-gradient-to-br ${colors.bg} text-white relative`}>
          <div class="absolute inset-0 bg-black/20"></div>
          <div class="container mx-auto px-4 py-8 relative z-10">
            <nav class="text-sm mb-6 text-white/80">
              <a href="/lessons" class="hover:text-white">Lessons</a>
              <span class="mx-2">→</span>
              <a href={`/lessons/${lesson.data.system}`} class="hover:text-white">
                {system?.data.name}
              </a>
              <span class="mx-2">→</span>
              <a href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}`} class="hover:text-white">
                Phase {lesson.data.phase_number}
              </a>
              <span class="mx-2">→</span>
              <a href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`} class="hover:text-white">
                Tier {lesson.data.tier_number}
              </a>
              <span class="mx-2">→</span>
              <span class="text-white">Lesson {lesson.data.lesson_number}</span>
            </nav>
            
            <div class="flex items-center gap-6 mb-6">
              <div class={`w-16 h-16 ${colors.accent} rounded-2xl flex items-center justify-center text-white font-bold shadow-2xl`}>
                {lesson.data.lesson_number}
              </div>
              <div>
                <h1 class="text-3xl md:text-4xl font-bold mb-2">
                  {lesson.data.title}
                </h1>
                <p class="text-lg text-white/90">
                  {system?.data.name} • Phase {lesson.data.phase_number} • Tier {lesson.data.tier_number}
                </p>
              </div>
            </div>
            
            <p class="text-lg text-white/90 mb-6 max-w-3xl leading-relaxed">
              {lesson.data.description}
            </p>
            
            <div class="flex flex-wrap gap-3">
              <div class="flex items-center gap-2 px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm">
                <span>{getDifficultyIcon(lesson.data.difficulty)}</span>
                <span>{lesson.data.difficulty}</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm">
                <span>⏱️</span>
                <span>{lesson.data.estimated_duration}</span>
              </div>
              {lesson.data.code_examples && (
                <div class="flex items-center gap-2 px-3 py-1 bg-blue-500/30 backdrop-blur-sm rounded-full text-sm">
                  <span>💻</span>
                  <span>Code Examples</span>
                </div>
              )}
              {lesson.data.practical_exercise && (
                <div class="flex items-center gap-2 px-3 py-1 bg-green-500/30 backdrop-blur-sm rounded-full text-sm">
                  <span>🛠️</span>
                  <span>Exercise</span>
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })()}
  </div>

  <div class="container mx-auto px-4 py-8">

    <!-- Learning Objectives & Key Concepts -->
    <div class="mb-12">
      <div class="grid md:grid-cols-2 gap-8">
        {lesson.data.learning_objectives.length > 0 && (
          <div class="bg-white/80 rounded-xl p-6 border border-green-200 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center text-white text-xl">
                🎯
              </div>
              <h2 class="text-xl font-bold text-green-800">Learning Objectives</h2>
            </div>
            <ul class="space-y-3">
              {lesson.data.learning_objectives.map((objective) => (
                <li class="flex items-start gap-3">
                  <div class="w-2 h-2 bg-green-500 rounded-full mt-2 flex-shrink-0"></div>
                  <span class="text-green-700">{objective}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {lesson.data.concepts.length > 0 && (
          <div class="bg-white/80 rounded-xl p-6 border border-blue-200 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center text-white text-xl">
                🧠
              </div>
              <h2 class="text-xl font-bold text-blue-800">Key Concepts</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              {lesson.data.concepts.map((concept) => (
                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Lesson Content -->
    <div class="mb-12">
      <div class="bg-white/60 rounded-xl p-8 border border-c64-beige-darker shadow-lg">
        <div class="lesson-content max-w-none">
          <Content />
        </div>
      </div>
    </div>

    {lesson.data.external_resources && lesson.data.external_resources.length > 0 && (
      <div class="mb-12">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold mb-2">📚 Additional Resources</h2>
          <p class="text-gray-600">Explore these curated resources to deepen your understanding</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {lesson.data.external_resources.map((resource) => (
            <a 
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block bg-white/80 rounded-xl p-6 border border-gray-200 shadow-lg hover:shadow-xl transition-all duration-200 hover:scale-105"
            >
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-lg group-hover:bg-gray-200 transition-colors">
                    📖
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors">{resource.title}</h3>
                    <span class="text-sm text-gray-500 capitalize">{resource.type}</span>
                  </div>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Lesson Navigation -->
    <div class="bg-white/60 rounded-xl p-6 border border-c64-beige-darker shadow-lg">
      <div class="flex items-center justify-between">
        <div class="flex-1">
          {prevLesson ? (
            <a 
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}/lesson-${prevLesson.data.lesson_number.toString().padStart(3, '0')}`}
              class="group flex items-center gap-3 px-6 py-3 bg-gray-600 text-white rounded-xl hover:bg-gray-700 transition-all duration-200 hover:scale-105 w-fit"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              <div class="text-left">
                <div class="text-sm text-gray-300">Previous</div>
                <div class="font-medium">{prevLesson.data.title}</div>
              </div>
            </a>
          ) : null}
        </div>
        
        <div class="flex-shrink-0 mx-6">
          <div class="text-center">
            <div class="text-sm text-gray-500 mb-1">Progress</div>
            <div class="text-lg font-bold">
              {currentIndex + 1} / {tierLessons.length}
            </div>
            <div class="w-32 bg-gray-200 rounded-full h-2 mt-2">
              <div 
                class="bg-green-500 h-2 rounded-full transition-all duration-300" 
                style={`width: ${((currentIndex + 1) / tierLessons.length) * 100}%`}
              ></div>
            </div>
          </div>
        </div>
        
        <div class="flex-1 flex justify-end">
          {nextLesson ? (
            <a 
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}/lesson-${nextLesson.data.lesson_number.toString().padStart(3, '0')}`}
              class={`group flex items-center gap-3 px-6 py-3 text-white rounded-xl transition-all duration-200 hover:scale-105 w-fit ${
                (() => {
                  switch(lesson.data.system) {
                    case 'commodore-64': return 'bg-c64-brown hover:bg-c64-dark-brown';
                    case 'zx-spectrum': return 'bg-spectrum-red hover:bg-spectrum-magenta';
                    case 'nintendo-entertainment-system': return 'bg-nes-red hover:bg-nes-dark-gray';
                    case 'commodore-amiga': return 'bg-amiga-blue hover:bg-amiga-orange';
                    default: return 'bg-blue-600 hover:bg-blue-700';
                  }
                })()
              }`}
            >
              <div class="text-right">
                <div class="text-sm text-white/80">Next</div>
                <div class="font-medium">{nextLesson.data.title}</div>
              </div>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          ) : (
            <a 
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`}
              class={`group flex items-center gap-3 px-6 py-3 text-white rounded-xl transition-all duration-200 hover:scale-105 w-fit ${
                (() => {
                  switch(lesson.data.system) {
                    case 'commodore-64': return 'bg-c64-brown hover:bg-c64-dark-brown';
                    case 'zx-spectrum': return 'bg-spectrum-red hover:bg-spectrum-magenta';
                    case 'nintendo-entertainment-system': return 'bg-nes-red hover:bg-nes-dark-gray';
                    case 'commodore-amiga': return 'bg-amiga-blue hover:bg-amiga-orange';
                    default: return 'bg-green-600 hover:bg-green-700';
                  }
                })()
              }`}
            >
              <div class="text-right">
                <div class="text-sm text-white/80">Complete</div>
                <div class="font-medium">Back to Tier</div>
              </div>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>