---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { 
      system: lesson.data.system,
      phase: `phase-${lesson.data.phase_number}`,
      tier: `tier-${lesson.data.tier_number}`,
      lesson: `lesson-${lesson.data.lesson_number.toString().padStart(3, '0')}`
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await lesson.render();

// Get system, phase, and tier info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.data.slug === lesson.data.system);

const allPhases = await getCollection('phases');
const phase = allPhases.find(p => 
  p.data.system === lesson.data.system && 
  p.data.phase_number === lesson.data.phase_number
);

const allTiers = await getCollection('tiers');
const tier = allTiers.find(t => 
  t.data.system === lesson.data.system && 
  t.data.phase_number === lesson.data.phase_number &&
  t.data.tier_number === lesson.data.tier_number
);

// Get adjacent lessons for navigation
const allLessons = await getCollection('lessons');
const tierLessons = allLessons
  .filter(l => 
    l.data.system === lesson.data.system && 
    l.data.phase_number === lesson.data.phase_number &&
    l.data.tier_number === lesson.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

const currentIndex = tierLessons.findIndex(l => l.data.lesson_number === lesson.data.lesson_number);
const prevLesson = currentIndex > 0 ? tierLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < tierLessons.length - 1 ? tierLessons[currentIndex + 1] : null;
---

<Layout title={`${system?.data.name} - Lesson ${lesson.data.lesson_number}: ${lesson.data.title}`}>
  <main class="container mx-auto px-4 py-8">
    <nav class="mb-6 text-sm">
      <a href={`/systems/${lesson.data.system}`} class="text-blue-600 hover:underline">
        {system?.data.name}
      </a>
      <span class="mx-2">/</span>
      <a href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}`} class="text-blue-600 hover:underline">
        Phase {lesson.data.phase_number}: {phase?.data.title}
      </a>
      <span class="mx-2">/</span>
      <a href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`} class="text-blue-600 hover:underline">
        Tier {lesson.data.tier_number}: {tier?.data.title}
      </a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">Lesson {lesson.data.lesson_number}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Lesson {lesson.data.lesson_number}: {lesson.data.title}</h1>
      
      <div class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-6">
        <p class="text-lg mb-4">{lesson.data.description}</p>
        <div class="grid md:grid-cols-4 gap-4 text-sm">
          <div>
            <strong>Duration:</strong> {lesson.data.estimated_duration}
          </div>
          <div>
            <strong>Difficulty:</strong> {lesson.data.difficulty}
          </div>
          <div>
            <strong>Code Examples:</strong> {lesson.data.code_examples ? 'Yes' : 'No'}
          </div>
          <div>
            <strong>Exercise:</strong> {lesson.data.practical_exercise ? 'Yes' : 'No'}
          </div>
        </div>
      </div>

      {lesson.data.learning_objectives.length > 0 && (
        <div class="bg-green-50 border-l-4 border-green-500 p-6 mb-6">
          <h2 class="text-lg font-semibold text-green-800 mb-3">🎯 Learning Objectives</h2>
          <ul class="list-disc list-inside text-green-700 space-y-1">
            {lesson.data.learning_objectives.map((objective) => (
              <li>{objective}</li>
            ))}
          </ul>
        </div>
      )}

      {lesson.data.concepts.length > 0 && (
        <div class="bg-yellow-50 border-l-4 border-yellow-500 p-6 mb-6">
          <h2 class="text-lg font-semibold text-yellow-800 mb-3">🧠 Key Concepts</h2>
          <div class="flex flex-wrap gap-2">
            {lesson.data.concepts.map((concept) => (
              <span class="bg-yellow-200 text-yellow-800 px-2 py-1 rounded text-sm">
                {concept}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="prose max-w-none mb-12">
      <Content />
    </div>

    {lesson.data.external_resources && lesson.data.external_resources.length > 0 && (
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-4">📚 Additional Resources</h2>
        <div class="grid gap-4">
          {lesson.data.external_resources.map((resource) => (
            <a 
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block border rounded-lg p-4 hover:shadow-lg transition-shadow"
            >
              <div class="flex justify-between items-center">
                <div>
                  <h3 class="font-semibold">{resource.title}</h3>
                  <span class="text-sm text-gray-500">{resource.type}</span>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Navigation -->
    <div class="flex justify-between items-center pt-8 border-t">
      {prevLesson ? (
        <a 
          href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}/lesson-${prevLesson.data.lesson_number.toString().padStart(3, '0')}`}
          class="flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <span>Previous: Lesson {prevLesson.data.lesson_number}</span>
        </a>
      ) : (
        <div></div>
      )}

      {nextLesson ? (
        <a 
          href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}/lesson-${nextLesson.data.lesson_number.toString().padStart(3, '0')}`}
          class="flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
        >
          <span>Next: Lesson {nextLesson.data.lesson_number}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      ) : (
        <div></div>
      )}
    </div>
  </main>
</Layout>