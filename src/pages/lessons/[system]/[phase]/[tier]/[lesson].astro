---
import { getCollection } from "astro:content";
import Layout from "../../../../../layouts/Layout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: {
      system: lesson.data.system,
      phase: `phase-${lesson.data.phase_number}`,
      tier: `tier-${lesson.data.tier_number}`,
      lesson: `lesson-${lesson.data.lesson_number.toString().padStart(3, "0")}`,
    },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await lesson.render();

// Get system info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === lesson.data.system);

// Get adjacent lessons for navigation
const allLessons = await getCollection("lessons");
const tierLessons = allLessons
  .filter(
    (l) =>
      l.data.system === lesson.data.system &&
      l.data.phase_number === lesson.data.phase_number &&
      l.data.tier_number === lesson.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

const currentIndex = tierLessons.findIndex(
  (l) => l.data.lesson_number === lesson.data.lesson_number
);
const prevLesson = currentIndex > 0 ? tierLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < tierLessons.length - 1 ? tierLessons[currentIndex + 1] : null;

// Get system colors
const getSystemColors = (slug) => {
  switch (slug) {
    case "commodore-64":
      return {
        primary: "#8B7355",
        secondary: "#6B5B47",
        light: "rgba(139, 115, 85, 0.1)",
        gradient: "linear-gradient(135deg, #8B7355 0%, #6B5B47 100%)",
      };
    case "zx-spectrum":
      return {
        primary: "#0000FF",
        secondary: "#FF00FF",
        light: "rgba(0, 0, 255, 0.1)",
        gradient: "linear-gradient(135deg, #0000FF 0%, #FF00FF 100%)",
      };
    case "nintendo-entertainment-system":
      return {
        primary: "#922B3E",
        secondary: "#373737",
        light: "rgba(146, 43, 62, 0.1)",
        gradient: "linear-gradient(135deg, #922B3E 0%, #373737 100%)",
      };
    case "commodore-amiga":
      return {
        primary: "#0055AA",
        secondary: "#FF8800",
        light: "rgba(0, 85, 170, 0.1)",
        gradient: "linear-gradient(135deg, #0055AA 0%, #FF8800 100%)",
      };
    default:
      return {
        primary: "#64748b",
        secondary: "#475569",
        light: "rgba(100, 116, 139, 0.1)",
        gradient: "linear-gradient(135deg, #64748b 0%, #475569 100%)",
      };
  }
};

const colors = getSystemColors(lesson.data.system);

// Get difficulty icon
const getDifficultyIcon = (level) => {
  switch (level?.toLowerCase()) {
    case "easy":
    case "beginner":
      return "🟢";
    case "intermediate":
      return "🟡";
    case "hard":
    case "advanced":
      return "🔴";
    default:
      return "⚪";
  }
};
---

<Layout title={`${lesson.data.title} - ${system?.data.name} Lesson ${lesson.data.lesson_number}`}>
  <Breadcrumb
    segments={[
      { text: "Lessons", href: "/lessons" },
      { text: system?.data.name || "System", href: `/lessons/${lesson.data.system}` },
      {
        text: `Phase ${lesson.data.phase_number}`,
        href: `/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}`,
      },
      {
        text: `Tier ${lesson.data.tier_number}`,
        href: `/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`,
      },
      { text: `Lesson ${lesson.data.lesson_number}`, href: "#" },
    ]}
  />

  <!-- Lesson Header -->
  <div
    style={`background: ${colors.gradient}; color: white; padding: 3rem 0; margin-bottom: 2rem;`}
  >
    <div class="container">
      <div style="display: flex; align-items: flex-start; gap: 2rem; flex-wrap: wrap;">
        <div
          style="background: rgba(255,255,255,0.2); width: 80px; height: 80px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; flex-shrink: 0;"
        >
          {lesson.data.lesson_number}
        </div>
        <div style="flex: 1; min-width: 300px;">
          <h1 style="font-size: 2rem; margin: 0 0 0.5rem 0; font-weight: 700;">
            {lesson.data.title}
          </h1>
          <p style="font-size: 1.125rem; opacity: 0.95; margin: 0 0 1rem 0; line-height: 1.6;">
            {lesson.data.description}
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            <span
              style="background: rgba(255,255,255,0.2); padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.875rem;"
            >
              {getDifficultyIcon(lesson.data.difficulty)}
              {lesson.data.difficulty}
            </span>
            <span
              style="background: rgba(255,255,255,0.2); padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.875rem;"
            >
              ⏱️ {lesson.data.estimated_duration}
            </span>
            {
              lesson.data.code_examples && (
                <span style="background: rgba(59, 130, 246, 0.3); padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.875rem;">
                  💻 Code Examples
                </span>
              )
            }
            {
              lesson.data.practical_exercise && (
                <span style="background: rgba(34, 197, 94, 0.3); padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.875rem;">
                  🛠️ Exercise
                </span>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <!-- Learning Objectives & Key Concepts -->
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;"
    >
      {
        lesson.data.learning_objectives && lesson.data.learning_objectives.length > 0 && (
          <div style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 12px; padding: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <span style="font-size: 1.5rem;">🎯</span>
              <h2 style="font-size: 1.25rem; margin: 0; color: #15803d;">Learning Objectives</h2>
            </div>
            <ul style="margin: 0; padding-left: 1.5rem; list-style: none;">
              {lesson.data.learning_objectives.map((objective) => (
                <li style="position: relative; padding-left: 1.5rem; margin-bottom: 0.5rem; color: #166534;">
                  <span style="position: absolute; left: 0; top: 0.5rem; width: 6px; height: 6px; background: #22c55e; border-radius: 50%;" />
                  {objective}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        lesson.data.concepts && lesson.data.concepts.length > 0 && (
          <div style="background: #eff6ff; border: 1px solid #93c5fd; border-radius: 12px; padding: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <span style="font-size: 1.5rem;">🧠</span>
              <h2 style="font-size: 1.25rem; margin: 0; color: #1e40af;">Key Concepts</h2>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              {lesson.data.concepts.map((concept) => (
                <span style="background: white; border: 1px solid #dbeafe; padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.875rem; color: #1e40af;">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <!-- Main Content -->
    <div style="max-width: 900px; margin: 0 auto 3rem auto;">
      <div class="prose" style="font-size: 1.125rem; line-height: 1.8; color: #334155;">
        <Content />
      </div>
    </div>

    <!-- Navigation -->
    <div style="border-top: 2px solid #e2e8f0; padding-top: 2rem; margin-top: 4rem;">
      <div
        style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;"
      >
        {
          prevLesson ? (
            <a
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}/lesson-${prevLesson.data.lesson_number.toString().padStart(3, "0")}`}
              style={`display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: ${colors.light}; color: ${colors.primary}; border: 2px solid ${colors.primary}; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.2s;`}
              onmouseover="this.style.background=this.dataset.color; this.style.color='white';"
              onmouseout={`this.style.background='${colors.light}'; this.style.color='${colors.primary}';`}
              data-color={colors.primary}
            >
              ← Previous: {prevLesson.data.title}
            </a>
          ) : (
            <div />
          )
        }

        {
          nextLesson ? (
            <a
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}/lesson-${nextLesson.data.lesson_number.toString().padStart(3, "0")}`}
              style={`display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: ${colors.primary}; color: white; border: 2px solid ${colors.primary}; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.2s;`}
              onmouseover={`this.style.background='${colors.secondary}'; this.style.borderColor='${colors.secondary}';`}
              onmouseout={`this.style.background='${colors.primary}'; this.style.borderColor='${colors.primary}';`}
            >
              Next: {nextLesson.data.title} →
            </a>
          ) : (
            <a
              href={`/lessons/${lesson.data.system}/phase-${lesson.data.phase_number}/tier-${lesson.data.tier_number}`}
              style={`display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #64748b; color: white; border: 2px solid #64748b; border-radius: 8px; text-decoration: none; font-weight: 600;`}
            >
              Back to Tier {lesson.data.tier_number} →
            </a>
          )
        }
      </div>
    </div>

    <!-- External Resources -->
    {
      lesson.data.external_resources && lesson.data.external_resources.length > 0 && (
        <div style="margin-top: 3rem; padding: 2rem; background: #f8fafc; border-radius: 12px;">
          <h2 style="font-size: 1.5rem; margin: 0 0 1rem 0; color: #334155;">
            📚 Additional Resources
          </h2>
          <div style="display: grid; gap: 1rem;">
            {lesson.data.external_resources.map((resource) => (
              <a
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
                style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: white; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; color: #334155; transition: all 0.2s;"
                onmouseover="this.style.borderColor='#3b82f6'; this.style.boxShadow='0 4px 6px rgba(0,0,0,0.1)';"
                onmouseout="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none';"
              >
                <div style="display: flex; align-items: center; gap: 1rem;">
                  <span style="font-size: 1.5rem;">📖</span>
                  <div>
                    <div style="font-weight: 600;">{resource.title}</div>
                    <div style="font-size: 0.875rem; color: #64748b;">{resource.type}</div>
                  </div>
                </div>
                <span style="color: #3b82f6;">↗</span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>

<style>
  /* Enhanced typography for lesson content */
  .prose h1 {
    font-size: 2rem;
    margin: 3rem 0 1.5rem 0;
    color: #0f172a;
    font-weight: 700;
  }
  .prose h2 {
    font-size: 1.75rem;
    margin: 3rem 0 1.25rem 0;
    color: #1e293b;
    font-weight: 600;
  }
  .prose h3 {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem 0;
    color: #334155;
    font-weight: 600;
  }
  .prose h4 {
    font-size: 1.25rem;
    margin: 2rem 0 1rem 0;
    color: #475569;
    font-weight: 600;
  }
  .prose p {
    margin: 1.5rem 0;
  }
  .prose ul,
  .prose ol {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }
  .prose li {
    margin: 0.5rem 0;
  }
  .prose pre {
    background: #1a202c;
    color: #e2e8f0;
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose code {
    background: #f1f5f9;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.875em;
    color: #e11d48;
  }
  .prose pre code {
    background: none;
    padding: 0;
    color: inherit;
  }
  .prose blockquote {
    border-left: 4px solid #3b82f6;
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #64748b;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem auto;
    display: block;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .prose th {
    background: #f8fafc;
    padding: 0.75rem;
    text-align: left;
    border-bottom: 2px solid #e2e8f0;
    font-weight: 600;
  }
  .prose td {
    padding: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .prose strong {
    font-weight: 600;
    color: #0f172a;
  }
  .prose em {
    font-style: italic;
  }
  .prose hr {
    border: none;
    border-top: 2px solid #e2e8f0;
    margin: 2rem 0;
  }
</style>
