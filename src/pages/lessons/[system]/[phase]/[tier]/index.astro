---
import { getCollection } from "astro:content";
import Layout from "../../../../../layouts/Layout.astro";
import { getSystemColors, getDifficultyIcon } from "../../../../../utils/systemColors.js";

export async function getStaticPaths() {
  const tiers = await getCollection("tiers");
  return tiers.map((tier) => ({
    params: {
      system: tier.data.system,
      phase: `phase-${tier.data.phase_number}`,
      tier: `tier-${tier.data.tier_number}`,
    },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await tier.render();

// Get system and phase info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === tier.data.system);

const allPhases = await getCollection("phases");
const phase = allPhases.find(
  (p) => p.data.system === tier.data.system && p.data.phase_number === tier.data.phase_number
);

// Get lessons for this tier
const allLessons = await getCollection("lessons");
const tierLessons = allLessons
  .filter(
    (lesson) =>
      lesson.data.system === tier.data.system &&
      lesson.data.phase_number === tier.data.phase_number &&
      lesson.data.tier_number === tier.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

const colors = getSystemColors(tier.data.system);
---

<Layout
  title={`${system?.data.name} - Phase ${tier.data.phase_number} Tier ${tier.data.tier_number}: ${tier.data.title}`}
>
  <!-- Tier Header -->
  <div class={`lesson-header ${colors.className}`}>
    <div class="container">
      <!-- Breadcrumb inside header -->
      <nav class="lesson-breadcrumb">
        <div class="lesson-breadcrumb-list">
          <a href="/lessons" class="lesson-breadcrumb-link">Lessons</a>
          <span class="lesson-breadcrumb-separator">→</span>
          <a href={`/lessons/${tier.data.system}`} class="lesson-breadcrumb-link">
            {system?.data.name}
          </a>
          <span class="lesson-breadcrumb-separator">→</span>
          <a
            href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}`}
            class="lesson-breadcrumb-link"
          >
            Phase {tier.data.phase_number}
          </a>
          <span class="lesson-breadcrumb-separator">→</span>
          <span>Tier {tier.data.tier_number}</span>
        </div>
      </nav>
      <div class="lesson-header-content">
        <div class="lesson-header-badge medium">
          T{tier.data.tier_number}
        </div>
        <div class="lesson-header-info">
          <h1 class="lesson-header-title">
            {tier.data.title}
          </h1>
          <p class="lesson-header-subtitle">
            {tier.data.description}
          </p>
          <div class="lesson-header-meta">
            <span class="lesson-meta-badge">
              ⏱️ {tier.data.estimated_duration}
            </span>
            <span class="lesson-meta-badge">
              📚 {tierLessons.length} lessons
            </span>
            {
              tier.data.game_project && (
                <span class="lesson-meta-badge success">🎮 Game Project</span>
              )
            }
          </div>
          <!-- Concepts -->
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
            {
              tier.data.concepts_introduced.map((concept) => (
                <span style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(2px); padding: 0.25rem 0.625rem; border-radius: 4px; font-size: 0.875rem;">
                  {concept}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <!-- Game Project Callout -->
    {
      tier.data.game_project && (
        <div style="background: linear-gradient(135deg, var(--system-light) 0%, white 100%); border: 2px solid var(--system-primary); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
          <div style="display: flex; align-items: flex-start; gap: 1.5rem;">
            <div style="background: var(--system-primary); color: white; width: 60px; height: 60px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; flex-shrink: 0;">
              🎮
            </div>
            <div style="flex: 1;">
              <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--system-primary); margin: 0 0 0.5rem 0;">
                Game Project: {tier.data.game_project.name}
              </h2>
              <p style="font-size: 1.125rem; color: #475569; margin: 0 0 1rem 0; line-height: 1.6;">
                {tier.data.game_project.description}
              </p>
              <div style="display: flex; align-items: center; gap: 1rem;">
                <span style="background: white; padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.875rem; color: #475569; border: 1px solid #e2e8f0;">
                  📅 {tier.data.game_project.tier_range}
                </span>
              </div>
            </div>
          </div>
        </div>
      )
    }

    <!-- Tier Content -->
    {
      Content && (
        <div style="margin-bottom: 3rem;">
          <div class="lesson-content-wrapper">
            <div class="lesson-prose">
              <Content />
            </div>
          </div>
        </div>
      )
    }

    <!-- Lessons Section -->
    <div style="margin-bottom: 3rem;">
      <div style="text-align: center; margin-bottom: 2rem;">
        <h2 style="font-size: 2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">
          Lessons in This Tier
        </h2>
        <p style="font-size: 1.125rem; color: #64748b; max-width: 42rem; margin: 0 auto;">
          Work through {tierLessons.length} carefully crafted lessons that build your understanding step
          by step. Each lesson includes practical examples and hands-on exercises.
        </p>
      </div>

      <!-- Lesson Cards -->
      <div style="display: grid; gap: 1rem;">
        {
          tierLessons.map((lesson, index) => (
            <a
              href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}/tier-${tier.data.tier_number}/lesson-${lesson.data.lesson_number.toString().padStart(3, "0")}`}
              class={`lesson-card ${colors.className}`}
            >
              <div style="display: flex;">
                <div class="lesson-card-accent" style="width: 4px;" />
                <div style="padding: 1.25rem; flex: 1;">
                  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem;">
                    <div style="display: flex; align-items: flex-start; gap: 1.25rem; flex: 1;">
                      <div style="background: var(--system-light); color: var(--system-primary); width: 50px; height: 50px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight: bold; flex-shrink: 0;">
                        {lesson.data.lesson_number}
                      </div>
                      <div style="flex: 1;">
                        <h3 style="font-size: 1.125rem; font-weight: 600; color: var(--system-primary); margin: 0 0 0.375rem 0;">
                          {lesson.data.title}
                        </h3>
                        <p style="color: #475569; margin: 0 0 0.75rem 0; font-size: 0.9375rem; line-height: 1.5;">
                          {lesson.data.description}
                        </p>

                        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                          <span class="concept-pill">⏱️ {lesson.data.estimated_duration}</span>
                          <span class="concept-pill">
                            {getDifficultyIcon(lesson.data.difficulty)} {lesson.data.difficulty}
                          </span>
                          {lesson.data.code_examples && (
                            <span style="background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.2); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8125rem;">
                              💻 Code Examples
                            </span>
                          )}
                          {lesson.data.practical_exercise && (
                            <span style="background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8125rem;">
                              🛠️ Exercise
                            </span>
                          )}
                        </div>

                        <div style="margin-top: 0.75rem; color: #94a3b8; font-size: 0.8125rem;">
                          Lesson {index + 1} of {tierLessons.length}
                        </div>
                      </div>
                    </div>

                    <div style="flex-shrink: 0;">
                      <div
                        class="lesson-nav-button primary"
                        style="padding: 0.5rem 1rem; font-size: 0.875rem;"
                      >
                        Start →
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
