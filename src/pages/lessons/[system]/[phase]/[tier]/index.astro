---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tiers = await getCollection('tiers');
  return tiers.map((tier) => ({
    params: { 
      system: tier.data.system,
      phase: `phase-${tier.data.phase_number}`,
      tier: `tier-${tier.data.tier_number}`
    },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await tier.render();

// Get system and phase info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.data.slug === tier.data.system);

const allPhases = await getCollection('phases');
const phase = allPhases.find(p => 
  p.data.system === tier.data.system && 
  p.data.phase_number === tier.data.phase_number
);

// Get lessons for this tier
const allLessons = await getCollection('lessons');
const tierLessons = allLessons
  .filter(lesson => 
    lesson.data.system === tier.data.system && 
    lesson.data.phase_number === tier.data.phase_number &&
    lesson.data.tier_number === tier.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);
---

<Layout title={`${system?.data.name} - Phase ${tier.data.phase_number} Tier ${tier.data.tier_number}: ${tier.data.title}`}>
  <main class="container mx-auto px-4 py-8">
    <nav class="mb-6 text-sm">
      <a href={`/systems/${tier.data.system}`} class="text-blue-600 hover:underline">
        {system?.data.name}
      </a>
      <span class="mx-2">/</span>
      <a href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}`} class="text-blue-600 hover:underline">
        Phase {tier.data.phase_number}: {phase?.data.title}
      </a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">Tier {tier.data.tier_number}: {tier.data.title}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Tier {tier.data.tier_number}: {tier.data.title}</h1>
      <div class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-6">
        <p class="text-lg">{tier.data.description}</p>
        <div class="mt-4 grid md:grid-cols-3 gap-4 text-sm">
          <div>
            <strong>Duration:</strong> {tier.data.estimated_duration}
          </div>
          <div>
            <strong>Lessons:</strong> {tierLessons.length} lessons
          </div>
          <div>
            <strong>Concepts:</strong> {tier.data.concepts_introduced.slice(0, 2).join(', ')}{tier.data.concepts_introduced.length > 2 ? '...' : ''}
          </div>
        </div>
      </div>

      {tier.data.game_project && (
        <div class="bg-green-50 border-l-4 border-green-500 p-6 mb-6">
          <h2 class="text-xl font-bold text-green-800 mb-2">🎮 Game Project: {tier.data.game_project.name}</h2>
          <p class="text-green-700">{tier.data.game_project.description}</p>
          <p class="text-sm text-green-600 mt-2">
            <strong>Completed during:</strong> {tier.data.game_project.tier_range}
          </p>
        </div>
      )}
    </div>

    <div class="prose max-w-none mb-12">
      <Content />
    </div>

    <div>
      <h2 class="text-3xl font-bold mb-6">Lessons</h2>
      <div class="grid gap-4">
        {tierLessons.map((lesson) => (
          <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="text-lg font-semibold mb-2">
                  <a 
                    href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}/tier-${tier.data.tier_number}/lesson-${lesson.data.lesson_number.toString().padStart(3, '0')}`}
                    class="hover:text-blue-600"
                  >
                    Lesson {lesson.data.lesson_number}: {lesson.data.title}
                  </a>
                </h3>
                <p class="text-gray-600 text-sm mb-2">{lesson.data.description}</p>
                <div class="flex gap-4 text-xs text-gray-500">
                  <span>⏱️ {lesson.data.estimated_duration}</span>
                  <span>📊 {lesson.data.difficulty}</span>
                  {lesson.data.code_examples && <span>💻 Code Examples</span>}
                  {lesson.data.practical_exercise && <span>🛠️ Exercise</span>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>