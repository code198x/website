---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tiers = await getCollection('tiers');
  return tiers.map((tier) => ({
    params: { 
      system: tier.data.system,
      phase: `phase-${tier.data.phase_number}`,
      tier: `tier-${tier.data.tier_number}`
    },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await tier.render();

// Get system and phase info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === tier.data.system);

const allPhases = await getCollection('phases');
const phase = allPhases.find(p => 
  p.data.system === tier.data.system && 
  p.data.phase_number === tier.data.phase_number
);

// Get lessons for this tier
const allLessons = await getCollection('lessons');
const tierLessons = allLessons
  .filter(lesson => 
    lesson.data.system === tier.data.system && 
    lesson.data.phase_number === tier.data.phase_number &&
    lesson.data.tier_number === tier.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);
---

<Layout title={`${system?.data.name} - Phase ${tier.data.phase_number} Tier ${tier.data.tier_number}: ${tier.data.title}`}>
  <!-- Hero Section with Tier Branding -->
  <div class="system-hero">
    {(() => {
      // Define system-specific colors
      const getSystemColors = (slug) => {
        switch(slug) {
          case 'commodore-64':
            return { 
              bg: 'from-c64-brown to-c64-dark-brown', 
              accent: 'bg-c64-brown',
              text: 'text-c64-brown',
              border: 'border-c64-brown'
            };
          case 'zx-spectrum':
            return { 
              bg: 'from-spectrum-red to-spectrum-magenta', 
              accent: 'bg-spectrum-red',
              text: 'text-spectrum-red',
              border: 'border-spectrum-red'
            };
          case 'nintendo-entertainment-system':
            return { 
              bg: 'from-nes-red to-nes-dark-gray', 
              accent: 'bg-nes-red',
              text: 'text-nes-red',
              border: 'border-nes-red'
            };
          case 'commodore-amiga':
            return { 
              bg: 'from-amiga-blue to-amiga-orange', 
              accent: 'bg-amiga-blue',
              text: 'text-amiga-blue',
              border: 'border-amiga-blue'
            };
          default:
            return { 
              bg: 'from-slate-600 to-slate-800', 
              accent: 'bg-slate-600',
              text: 'text-slate-600',
              border: 'border-slate-600'
            };
        }
      };
      const colors = getSystemColors(tier.data.system);
      
      return (
        <div class={`system-hero-gradient ${colors.bg}`}>
          <div class="system-hero-overlay"></div>
          <div class="system-hero-content">
            <nav class="system-hero-nav">
              <a href="/lessons">Lessons</a>
              <span style="margin: 0 var(--space-sm);">→</span>
              <a href={`/lessons/${tier.data.system}`}>
                {system?.data.name}
              </a>
              <span style="margin: 0 var(--space-sm);">→</span>
              <a href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}`}>
                Phase {tier.data.phase_number}
              </a>
              <span style="margin: 0 var(--space-sm);">→</span>
              <span style="color: white;">Tier {tier.data.tier_number}</span>
            </nav>
            
            <div style="display: flex; align-items: center; gap: var(--space-xl); margin-bottom: var(--space-xl);">
              <div class={`tier-hero-number ${colors.accent}`}>
                T{tier.data.tier_number}
              </div>
              <div>
                <h1 class="system-hero-title">
                  {tier.data.title}
                </h1>
                <p class="system-hero-subtitle">
                  {system?.data.name} • Phase {tier.data.phase_number} • Tier {tier.data.tier_number}
                </p>
              </div>
            </div>
            
            <p style="font-size: 1.25rem; color: rgba(255, 255, 255, 0.9); margin-bottom: var(--space-2xl); max-width: 48rem; line-height: 1.75;">
              {tier.data.description}
            </p>
            
            <div class="system-hero-specs" style="margin-bottom: var(--space-xl);">
              <span class="system-spec-badge">
                ⏱️ {tier.data.estimated_duration}
              </span>
              <span class="system-spec-badge">
                📚 {tierLessons.length} lessons
              </span>
              {tier.data.game_project && (
                <span class="system-spec-badge" style="background: rgba(34, 197, 94, 0.3);">
                  🎮 Game Project
                </span>
              )}
            </div>
            
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-sm);">
              {tier.data.concepts_introduced.map((concept) => (
                <span class="system-spec-badge" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(2px);">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        </div>
      );
    })()}
  </div>

  <div class="container" style="padding: var(--space-4xl) 0;">
    {/* Game Project Callout */}
    {tier.data.game_project && (
      <div class="game-project-callout">
        <div style="display: flex; align-items: flex-start; gap: var(--space-xl);">
          <div class="game-project-icon">
            🎮
          </div>
          <div>
            <h2 class="game-project-title">Game Project: {tier.data.game_project.name}</h2>
            <p class="game-project-description">
              {tier.data.game_project.description}
            </p>
            <div style="display: flex; align-items: center; gap: var(--space-lg);">
              <span class="game-project-meta">
                📅 {tier.data.game_project.tier_range}
              </span>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* Tier Content */}
    <div style="margin-bottom: var(--space-4xl);">
      <div style="max-width: 64rem; margin: 0 auto;">
        <div class="tier-content">
          <Content />
        </div>
      </div>
    </div>

    {/* Lessons */}
    <div>
      <div style="text-align: center; margin-bottom: var(--space-2xl);">
        <h2 style="font-size: 1.875rem; font-weight: 700; margin-bottom: var(--space-lg);">Lessons in This Tier</h2>
        <p style="font-size: 1.125rem; color: var(--text-muted); max-width: 32rem; margin: 0 auto;">
          Work through {tierLessons.length} carefully crafted lessons that build your understanding 
          step by step. Each lesson includes practical examples and hands-on exercises.
        </p>
      </div>
      
      <div class="lesson-list">
        {tierLessons.map((lesson, index) => {
          const colors = (() => {
            switch(tier.data.system) {
              case 'commodore-64': return { accent: 'c64', text: 'c64' };
              case 'zx-spectrum': return { accent: 'spectrum', text: 'spectrum' };
              case 'nintendo-entertainment-system': return { accent: 'nes', text: 'nes' };
              case 'commodore-amiga': return { accent: 'amiga', text: 'amiga' };
              default: return { accent: 'default', text: 'default' };
            }
          })();
          
          return (
            <a 
              href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}/tier-${tier.data.tier_number}/lesson-${lesson.data.lesson_number.toString().padStart(3, '0')}`}
              class="lesson-card-item"
            >
              <div style="display: flex;">
                <div class={`lesson-card-accent ${colors.accent}`}></div>
                <div class="lesson-card-content">
                  <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-lg);">
                    <div style="display: flex; align-items: center; gap: var(--space-lg);">
                      <div class={`lesson-card-number ${colors.accent}`}>
                        {lesson.data.lesson_number}
                      </div>
                      <div>
                        <h3 class={`lesson-card-item-title ${colors.text}`}>
                          {lesson.data.title}
                        </h3>
                        <p class="lesson-card-description">
                          {lesson.data.description}
                        </p>
                        <div class="lesson-card-tags">
                          <span class="lesson-card-tag">
                            ⏱️ {lesson.data.estimated_duration}
                          </span>
                          <span class="lesson-card-tag">
                            📊 {lesson.data.difficulty}
                          </span>
                          {lesson.data.code_examples && (
                            <span class="lesson-card-tag code">
                              💻 Code Examples
                            </span>
                          )}
                          {lesson.data.practical_exercise && (
                            <span class="lesson-card-tag exercise">
                              🛠️ Exercise
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                    
                    <div style="text-align: right;">
                      <div class={`lesson-card-item-cta ${colors.accent}`}>
                        Start Lesson →
                      </div>
                    </div>
                  </div>
                  
                  <div class="lesson-card-footer">
                    <div class="lesson-card-meta">
                      Lesson {index + 1} of {tierLessons.length}
                    </div>
                    <div class="lesson-card-progress">
                      <div class="lesson-card-progress-bar">
                        <div class="lesson-card-progress-fill"></div>
                      </div>
                      <span class="lesson-card-progress-text">0%</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      
      {/* End of Available Content Notice */}
      {tier.data.tier_number === 1 && (
        <div class="end-of-content">
          <div>
            <div class="end-of-content-icon">🚧</div>
            <h3 class="end-of-content-title">End of Tier 1 Preview</h3>
            <p class="end-of-content-description">
              You've reached the end of our Tier 1 preview content! These 32 lessons provide a solid 
              foundation in {system?.data.name} assembly programming.
            </p>
            <div class="end-of-content-features">
              <h4 style="grid-column: 1 / -1; font-size: 1.25rem; font-weight: 600; color: rgb(180, 83, 9); margin-bottom: var(--space-md);">What's Coming Next</h4>
              <div class="end-of-content-feature">
                <div class="end-of-content-feature-icon">📚</div>
                <div class="end-of-content-feature-title">Tiers 2-16</div>
                <div class="end-of-content-feature-text">Advanced topics & projects</div>
              </div>
              <div class="end-of-content-feature">
                <div class="end-of-content-feature-icon">🎮</div>
                <div class="end-of-content-feature-title">Complete Games</div>
                <div class="end-of-content-feature-text">Build full projects</div>
              </div>
              <div class="end-of-content-feature">
                <div class="end-of-content-feature-icon">🔬</div>
                <div class="end-of-content-feature-title">Phases 2-8</div>
                <div class="end-of-content-feature-text">Master-level programming</div>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: var(--space-lg); align-items: center;">
              <a href="/about" class="btn btn-primary" style="background: rgb(217, 119, 6); padding: var(--space-md) var(--space-xl);">
                Learn About the Full Course
              </a>
              <a href="/lessons" class="btn btn-secondary" style="border: 2px solid rgb(217, 119, 6); color: rgb(217, 119, 6); padding: var(--space-md) var(--space-xl);">
                Try Another System
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>