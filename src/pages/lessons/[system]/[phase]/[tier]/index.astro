---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tiers = await getCollection('tiers');
  return tiers.map((tier) => ({
    params: { 
      system: tier.data.system,
      phase: `phase-${tier.data.phase_number}`,
      tier: `tier-${tier.data.tier_number}`
    },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await tier.render();

// Get system and phase info
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === tier.data.system);

const allPhases = await getCollection('phases');
const phase = allPhases.find(p => 
  p.data.system === tier.data.system && 
  p.data.phase_number === tier.data.phase_number
);

// Get lessons for this tier
const allLessons = await getCollection('lessons');
const tierLessons = allLessons
  .filter(lesson => 
    lesson.data.system === tier.data.system && 
    lesson.data.phase_number === tier.data.phase_number &&
    lesson.data.tier_number === tier.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);
---

<Layout title={`${system?.data.name} - Phase ${tier.data.phase_number} Tier ${tier.data.tier_number}: ${tier.data.title}`}>
  <!-- Hero Section with Tier Branding -->
  <div class="relative overflow-hidden">
    {(() => {
      // Define system-specific colors
      const getSystemColors = (slug) => {
        switch(slug) {
          case 'commodore-64':
            return { 
              bg: 'from-c64-brown to-c64-dark-brown', 
              accent: 'bg-c64-brown',
              text: 'text-c64-brown',
              border: 'border-c64-brown'
            };
          case 'zx-spectrum':
            return { 
              bg: 'from-spectrum-red to-spectrum-magenta', 
              accent: 'bg-spectrum-red',
              text: 'text-spectrum-red',
              border: 'border-spectrum-red'
            };
          case 'nintendo-entertainment-system':
            return { 
              bg: 'from-nes-red to-nes-dark-gray', 
              accent: 'bg-nes-red',
              text: 'text-nes-red',
              border: 'border-nes-red'
            };
          case 'commodore-amiga':
            return { 
              bg: 'from-amiga-blue to-amiga-orange', 
              accent: 'bg-amiga-blue',
              text: 'text-amiga-blue',
              border: 'border-amiga-blue'
            };
          default:
            return { 
              bg: 'from-gray-600 to-gray-800', 
              accent: 'bg-gray-600',
              text: 'text-gray-600',
              border: 'border-gray-600'
            };
        }
      };
      const colors = getSystemColors(tier.data.system);
      
      return (
        <div class={`bg-gradient-to-br ${colors.bg} text-white relative`}>
          <div class="absolute inset-0 bg-black/20"></div>
          <div class="container mx-auto px-4 py-12 relative z-10">
            <nav class="text-sm mb-6 text-white/80">
              <a href="/lessons" class="hover:text-white">Lessons</a>
              <span class="mx-2">→</span>
              <a href={`/lessons/${tier.data.system}`} class="hover:text-white">
                {system?.data.name}
              </a>
              <span class="mx-2">→</span>
              <a href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}`} class="hover:text-white">
                Phase {tier.data.phase_number}
              </a>
              <span class="mx-2">→</span>
              <span class="text-white">Tier {tier.data.tier_number}</span>
            </nav>
            
            <div class="flex items-center gap-6 mb-6">
              <div class={`w-20 h-20 ${colors.accent} rounded-2xl flex items-center justify-center text-white font-bold text-lg shadow-2xl`}>
                T{tier.data.tier_number}
              </div>
              <div>
                <h1 class="text-4xl md:text-5xl font-bold mb-2">
                  {tier.data.title}
                </h1>
                <p class="text-xl text-white/90">
                  {system?.data.name} • Phase {tier.data.phase_number} • Tier {tier.data.tier_number}
                </p>
              </div>
            </div>
            
            <p class="text-xl text-white/90 mb-8 max-w-3xl leading-relaxed">
              {tier.data.description}
            </p>
            
            <div class="flex flex-wrap gap-4 mb-6">
              <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
                <span>⏱️</span>
                <span class="text-sm font-medium">{tier.data.estimated_duration}</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full">
                <span>📚</span>
                <span class="text-sm font-medium">{tierLessons.length} lessons</span>
              </div>
              {tier.data.game_project && (
                <div class="flex items-center gap-2 px-4 py-2 bg-green-500/30 backdrop-blur-sm rounded-full">
                  <span>🎮</span>
                  <span class="text-sm font-medium">Game Project</span>
                </div>
              )}
            </div>
            
            <div class="flex flex-wrap gap-2">
              {tier.data.concepts_introduced.map((concept) => (
                <span class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-sm">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        </div>
      );
    })()}
  </div>

  <div class="container mx-auto px-4 py-12">
    {/* Game Project Callout */}
    {tier.data.game_project && (
      <div class="mb-16">
        <div class="bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl p-8 text-white shadow-lg">
          <div class="flex items-start gap-6">
            <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center text-2xl">
              🎮
            </div>
            <div>
              <h2 class="text-2xl font-bold mb-3">Game Project: {tier.data.game_project.name}</h2>
              <p class="text-green-100 text-lg mb-4 leading-relaxed">
                {tier.data.game_project.description}
              </p>
              <div class="flex items-center gap-4 text-sm">
                <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full">
                  📅 {tier.data.game_project.tier_range}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* Tier Content */}
    <div class="mb-16">
      <div class="max-w-4xl mx-auto">
        <div class="tier-content">
          <Content />
        </div>
      </div>
    </div>

    {/* Lessons */}
    <div>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Lessons in This Tier</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Work through {tierLessons.length} carefully crafted lessons that build your understanding 
          step by step. Each lesson includes practical examples and hands-on exercises.
        </p>
      </div>
      
      <div class="grid gap-6">
        {tierLessons.map((lesson, index) => {
          const colors = (() => {
            switch(tier.data.system) {
              case 'commodore-64': return { accent: 'bg-c64-brown', hover: 'hover:bg-c64-brown', text: 'text-c64-brown' };
              case 'zx-spectrum': return { accent: 'bg-spectrum-red', hover: 'hover:bg-spectrum-red', text: 'text-spectrum-red' };
              case 'nintendo-entertainment-system': return { accent: 'bg-nes-red', hover: 'hover:bg-nes-red', text: 'text-nes-red' };
              case 'commodore-amiga': return { accent: 'bg-amiga-blue', hover: 'hover:bg-amiga-blue', text: 'text-amiga-blue' };
              default: return { accent: 'bg-gray-600', hover: 'hover:bg-gray-600', text: 'text-gray-600' };
            }
          })();
          
          return (
            <a 
              href={`/lessons/${tier.data.system}/phase-${tier.data.phase_number}/tier-${tier.data.tier_number}/lesson-${lesson.data.lesson_number.toString().padStart(3, '0')}`}
              class="group block bg-white/90 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 overflow-hidden border-2 border-transparent hover:border-gray-200"
            >
              <div class="flex">
                <div class={`w-2 ${colors.accent} group-hover:w-4 transition-all duration-200`}></div>
                <div class="flex-1 p-6">
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-4">
                      <div class={`w-12 h-12 ${colors.accent} rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-lg`}>
                        {lesson.data.lesson_number}
                      </div>
                      <div>
                        <h3 class={`text-xl font-bold mb-1 group-${colors.hover} transition-colors`}>
                          {lesson.data.title}
                        </h3>
                        <p class="text-gray-600 leading-relaxed mb-3">
                          {lesson.data.description}
                        </p>
                        <div class="flex flex-wrap gap-3">
                          <span class="flex items-center gap-1 px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
                            ⏱️ {lesson.data.estimated_duration}
                          </span>
                          <span class="flex items-center gap-1 px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded-full">
                            📊 {lesson.data.difficulty}
                          </span>
                          {lesson.data.code_examples && (
                            <span class="flex items-center gap-1 px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded-full">
                              💻 Code Examples
                            </span>
                          )}
                          {lesson.data.practical_exercise && (
                            <span class="flex items-center gap-1 px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full">
                              🛠️ Exercise
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                    
                    <div class="text-right">
                      <div class={`px-4 py-2 ${colors.accent} text-white rounded-lg font-medium group-hover:scale-105 transition-transform shadow-lg`}>
                        Start Lesson →
                      </div>
                    </div>
                  </div>
                  
                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <div class="text-sm text-gray-500">
                      Lesson {index + 1} of {tierLessons.length}
                    </div>
                    <div class="flex items-center gap-2">
                      <div class="w-24 bg-gray-200 rounded-full h-2">
                        <div class="bg-green-500 h-2 rounded-full w-0"></div>
                      </div>
                      <span class="text-sm text-gray-500">0%</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      
      {/* End of Available Content Notice */}
      {tier.data.tier_number === 1 && (
        <div class="mt-16 bg-gradient-to-r from-amber-50 to-orange-50 border-2 border-amber-200 rounded-xl p-8">
          <div class="text-center">
            <div class="text-4xl mb-4">🚧</div>
            <h3 class="text-2xl font-bold text-amber-800 mb-4">End of Tier 1 Preview</h3>
            <p class="text-lg text-amber-700 mb-6 max-w-2xl mx-auto">
              You've reached the end of our Tier 1 preview content! These 32 lessons provide a solid 
              foundation in {system?.data.name} assembly programming.
            </p>
            <div class="bg-white/60 backdrop-blur-sm rounded-lg p-6 mb-6">
              <h4 class="text-xl font-semibold text-amber-800 mb-3">What's Coming Next</h4>
              <div class="grid md:grid-cols-3 gap-4 text-sm">
                <div class="text-center">
                  <div class="text-2xl mb-2">📚</div>
                  <div class="font-medium text-amber-800">Tiers 2-16</div>
                  <div class="text-amber-600">Advanced topics & projects</div>
                </div>
                <div class="text-center">
                  <div class="text-2xl mb-2">🎮</div>
                  <div class="font-medium text-amber-800">Complete Games</div>
                  <div class="text-amber-600">Build full projects</div>
                </div>
                <div class="text-center">
                  <div class="text-2xl mb-2">🔬</div>
                  <div class="font-medium text-amber-800">Phases 2-8</div>
                  <div class="text-amber-600">Master-level programming</div>
                </div>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/about" class="px-6 py-3 bg-amber-600 text-white font-semibold rounded-lg hover:bg-amber-700 transition-colors">
                Learn About the Full Course
              </a>
              <a href="/lessons" class="px-6 py-3 border-2 border-amber-600 text-amber-600 font-semibold rounded-lg hover:bg-amber-600 hover:text-white transition-colors">
                Try Another System
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>