---
import { getCollection } from "astro:content";
import TierLayout from "../../../../../layouts/TierLayout.astro";
import LessonHeader from "../../../../../components/LessonHeader.astro";
import type { BreadcrumbItem } from "../../../../../components/Breadcrumb.astro";
import { getSystemColors, getDifficultyIcon } from "../../../../../utils/systemColors.js";

export async function getStaticPaths() {
  const tiers = await getCollection("tiers");
  return tiers.map((tier) => ({
    params: {
      system: tier.data.system,
      phase: `phase-${tier.data.phase_number}`,
      tier: `tier-${tier.data.tier_number}`,
    },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await tier.render();

// Get system and phase info
const allSystems = await getCollection("systems");
const system = allSystems.find((s) => s.slug === tier.data.system);

// Get lessons for this tier
const allLessons = await getCollection("lessons");
const tierLessons = allLessons
  .filter(
    (lesson) =>
      lesson.data.system === tier.data.system &&
      lesson.data.phase_number === tier.data.phase_number &&
      lesson.data.tier_number === tier.data.tier_number
  )
  .sort((a, b) => a.data.lesson_number - b.data.lesson_number);

// Calculate lesson progress status
function getLessonProgressStatus(lesson) {
  if (lesson.data.content_status === 'published') {
    return { status: 'published', isClickable: true };
  } else if (lesson.data.content_status === 'draft') {
    return { status: 'draft', isClickable: false };
  } else {
    return { status: 'template', isClickable: false };
  }
}

// Add progress info to each lesson
const lessonsWithProgress = tierLessons.map((lesson) => ({
  ...lesson,
  progress: getLessonProgressStatus(lesson)
}));

const colors = getSystemColors(tier.data.system);

// Generate breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { label: "Lessons", href: "/lessons" },
  { label: system?.data.name || tier.data.system, href: `/lessons/${tier.data.system}` },
  {
    label: `Phase ${tier.data.phase_number}`,
    href: `/lessons/${tier.data.system}/phase-${tier.data.phase_number}`,
  },
  { label: `Tier ${tier.data.tier_number}` },
];

// Prepare meta information
const metaInfo: Array<{
  label: string;
  value: string | number;
  icon?: string;
  type?: "default" | "success" | "warning";
}> = [
  { icon: "⏱️", label: "Duration", value: tier.data.estimated_duration },
  { icon: "📚", label: "Lessons", value: `${lessonsWithProgress.length} lessons` },
];

// Add game project badge if applicable
if (tier.data.game_project) {
  metaInfo.push({ icon: "🎮", label: "Game Project", value: "Included", type: "success" });
}
---

<TierLayout
  title={`${system?.data.name} - Phase ${tier.data.phase_number} Tier ${tier.data.tier_number}: ${tier.data.title}`}
>
  <!-- Tier Header -->
  <LessonHeader
    system={tier.data.system}
    systemName={system?.data.name}
    badge={{ text: `T${tier.data.tier_number}`, size: "medium" }}
    title={tier.data.title}
    description={tier.data.description}
    meta={metaInfo}
    breadcrumbs={breadcrumbs}
    concepts={tier.data.concepts_introduced}
  />

  <!-- Tier Content -->
  {
    Content && (
      <div class="lesson-content-wrapper">
        <div class="lesson-prose">
          <Content />
        </div>
      </div>
    )
  }

  <!-- Game Project Callout -->
  {
    tier.data.game_project && (
      <div class="tier-game-project">
        <div class="tier-game-project-layout">
          <div class="tier-game-project-icon">🎮</div>
          <div class="tier-game-project-info">
            <h2 class="tier-game-project-title">Game Project: {tier.data.game_project.name}</h2>
            <p class="tier-game-project-description">{tier.data.game_project.description}</p>
            <div class="tier-game-project-meta">
              <span class="tier-game-project-badge">📅 {tier.data.game_project.tier_range}</span>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <!-- Lessons Section -->
  <div class="tier-lessons-section">
    <div class="tier-lessons-header">
      <h2 class="tier-lessons-title">Lessons in This Tier</h2>
      <p class="tier-lessons-description">
        Work through {lessonsWithProgress.length} carefully crafted lessons that build your understanding step
        by step. Each lesson includes practical examples and hands-on exercises.
      </p>

      <!-- Lesson Progress Indicators Grid -->
      <div class="lesson-progress-grid">
        {Array.from({ length: 32 }, (_, i) => {
          const lessonNum = i + 1;
          const lesson = lessonsWithProgress.find(l => l.data.lesson_number === lessonNum);

          if (!lesson) {
            return (
              <div class="lesson-indicator lesson-grey" title={`Lesson ${lessonNum}: Not created`}>
                <span class="lesson-indicator-number">{lessonNum}</span>
              </div>
            );
          }

          const isClickable = lesson.progress.isClickable;
          const LessonElement = isClickable ? 'a' : 'div';
          const lessonProps = isClickable ? {
            href: `/lessons/${tier.data.system}/phase-${tier.data.phase_number}/tier-${tier.data.tier_number}/lesson-${lessonNum.toString().padStart(3, "0")}`
          } : {};

          let indicatorClass = 'lesson-indicator';
          if (lesson.progress.status === 'published') indicatorClass += ' lesson-green';
          else if (lesson.progress.status === 'draft') indicatorClass += ' lesson-amber';
          else indicatorClass += ' lesson-grey';

          if (isClickable) indicatorClass += ' lesson-clickable';

          return (
            <LessonElement
              {...lessonProps}
              class={indicatorClass}
              title={`Lesson ${lessonNum}: ${lesson.data.title} (${lesson.progress.status})`}
            >
              <span class="lesson-indicator-number">{lessonNum}</span>
            </LessonElement>
          );
        })}
      </div>
    </div>

    <!-- Lesson Cards -->
    <div class="tier-lesson-cards">
      {
        lessonsWithProgress.map((lesson, index) => {
          const LessonElement = lesson.progress.isClickable ? 'a' : 'div';
          const lessonProps = lesson.progress.isClickable ? {
            href: `/lessons/${tier.data.system}/phase-${tier.data.phase_number}/tier-${tier.data.tier_number}/lesson-${lesson.data.lesson_number.toString().padStart(3, "0")}`
          } : {};

          let progressClass = 'lesson-progress-indicator';
          if (lesson.progress.status === 'published') progressClass += ' progress-green';
          else if (lesson.progress.status === 'draft') progressClass += ' progress-amber';
          else progressClass += ' progress-grey';

          return (
            <LessonElement
              {...lessonProps}
              class={`tier-lesson-card ${colors.className} ${!lesson.progress.isClickable ? 'tier-lesson-card-disabled' : ''}`}
            >
            <div class="tier-lesson-card-layout">
              <div class="tier-lesson-card-accent" />
              <div class="tier-lesson-card-content">
                <div class="tier-lesson-card-header">
                  <div class="tier-lesson-card-main">
                    <div class="tier-lesson-card-number">{lesson.data.lesson_number}</div>
                    <div class="tier-lesson-card-info">
                      <div class="tier-lesson-card-title-row">
                        <h3 class="tier-lesson-card-title">{lesson.data.title}</h3>
                        <div class={progressClass} title={`Status: ${lesson.progress.status}`}>
                          <span class="progress-text">{lesson.progress.status}</span>
                        </div>
                      </div>
                      <p class="tier-lesson-card-description">{lesson.data.description}</p>

                      <div class="tier-lesson-card-badges">
                        <span class="tier-lesson-badge duration">
                          ⏱️ {lesson.data.estimated_duration}
                        </span>
                        <span class="tier-lesson-badge difficulty">
                          {getDifficultyIcon(lesson.data.difficulty)}{" "}
                          {lesson.data.difficulty.charAt(0).toUpperCase() +
                            lesson.data.difficulty.slice(1)}
                        </span>
                        {lesson.data.code_examples && (
                          <span class="tier-lesson-badge code">💻 Code Examples</span>
                        )}
                        {lesson.data.practical_exercise && (
                          <span class="tier-lesson-badge exercise">🛠️ Exercise</span>
                        )}
                      </div>

                      <div class="tier-lesson-card-footer">
                        Lesson {index + 1} of {lessonsWithProgress.length}
                      </div>
                    </div>
                  </div>

                  <div class="tier-lesson-card-action">
                    {lesson.progress.isClickable ? (
                      <div class="tier-lesson-start-button">Start →</div>
                    ) : (
                      <div class="tier-lesson-start-button disabled">Coming Soon</div>
                    )}
                  </div>
                </div>
              </div>
            </div>
            </LessonElement>
          );
        })
      }
    </div>
  </div>
</TierLayout>
