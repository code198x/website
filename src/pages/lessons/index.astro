---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSystemColors } from "../../utils/systemColors.js";
import Hero from "../../components/Hero.astro";
import Grid from "../../components/Grid.astro";
import Card from "../../components/Card.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter out vault systems and check which have lessons
const allSystems = systems
  .filter((system) => system.data.status !== "vault")
  .map((system) => {
    const hasLessons = lessons.some((lesson) => lesson.id.startsWith(system.slug));
    return { ...system, hasLessons };
  });

// Group systems by status and curriculum size
const activeSystems = allSystems.filter((s) => s.hasLessons);
const fullCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 4096
);
const advancedCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 2048
);
const extendedCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 1024
);
const focusedCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 512
);
const compactCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 256
);
const briefCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 128
);
const introCurriculumSystems = allSystems.filter(
  (s) => !s.hasLessons && s.data.total_lessons === 64
);

// Sort each group by order
activeSystems.sort((a, b) => a.data.order - b.data.order);
fullCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
advancedCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
extendedCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
focusedCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
compactCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
briefCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
introCurriculumSystems.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Programming Lessons - Code Like It's 198x">
  <div class="container" style="padding-top: var(--space-2xl);">
    <Hero 
      title="Programming Lessons"
      description="Learn vintage computer programming through structured courses. Each system offers hands-on assembly programming lessons that teach you to program at the hardware level."
      badge={{
        text: `${activeSystems.length} active • ${fullCurriculumSystems.length + advancedCurriculumSystems.length + extendedCurriculumSystems.length + focusedCurriculumSystems.length + compactCurriculumSystems.length + briefCurriculumSystems.length + introCurriculumSystems.length} planned`,
        color: "var(--color-green)"
      }}
      variant="centered"
    />

    <!-- Active Systems -->
    {
      activeSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-green);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-green); border-radius: 50%; margin-right: 8px;" />
            Available Now
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {activeSystems.map((system) => {
              const colors = getSystemColors(system.slug);
              const SystemWrapper = system.hasLessons ? "a" : "div";
              const wrapperProps = system.hasLessons ? { href: `/lessons/${system.slug}/` } : {};

              return (
                <SystemWrapper
                  {...wrapperProps}
                  class={`lesson-card ${colors.className} ${!system.hasLessons ? "lesson-card-disabled" : ""}`}
                  style={!system.hasLessons ? "cursor: default; opacity: 0.8;" : ""}
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div style="display: none; align-items: center; justify-content: center; height: 100%;">
                      <span style="font-size: 4rem; color: rgba(255, 255, 255, 0.8);">💻</span>
                    </Grid>
                    <div class="lesson-card-badge">Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">
                      {system.data.historical_significance || system.data.description}
                    </p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">
                        {system.hasLessons ? "Start Course →" : "Coming Soon"}
                      </Grid>
                    </Grid>
                  </Grid>
                </SystemWrapper>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Full Curriculum Systems (4,096 lessons) -->
    {
      fullCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-amber);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-amber); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Full Curriculum (4,096 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {fullCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Full Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Advanced Curriculum Systems (2048 lessons) -->
    {
      advancedCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-yellow);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-yellow); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Advanced Curriculum (2,048 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {advancedCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Advanced Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Extended Curriculum Systems (1024 lessons) -->
    {
      extendedCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-orange);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-orange); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Extended Curriculum (1,024 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {extendedCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Extended Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Focused Curriculum Systems (512 lessons) -->
    {
      focusedCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-blue);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-blue); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Focused Curriculum (512 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {focusedCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Focused Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Compact Curriculum Systems (256 lessons) -->
    {
      compactCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-purple);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-purple); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Compact Curriculum (256 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {compactCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Compact Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Brief Curriculum Systems (128 lessons) -->
    {
      briefCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-teal);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-teal); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Brief Curriculum (128 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {briefCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Brief Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Introductory Curriculum Systems (64 lessons) -->
    {
      introCurriculumSystems.length > 0 && (
        <div style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-bottom: var(--space-lg); color: var(--color-cyan);">
            <span style="display: inline-block; width: 12px; height: 12px; background: var(--color-cyan); border-radius: 50%; margin-right: 8px;" />
            Coming Soon • Introductory Curriculum (64 lessons each)
          </h2>
          <Grid columns={3} gap="large" variant="cards">
            {introCurriculumSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div
                  class={`lesson-card ${colors.className} lesson-card-disabled`}
                  style="cursor: default; opacity: 0.8;"
                >
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="lesson-card-badge">Intro Course</div>
                  </Grid>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </Grid>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </Grid>
                  </Grid>
                </Grid>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Info Section -->
    <div class="lessons-info">
      <div>
        <h2>Why Learn Assembly Programming?</h2>
        <p class="lessons-info-description">
          Assembly programming on vintage computers teaches fundamental concepts that modern
          high-level languages abstract away. You'll gain deep understanding of how computers
          actually work.
        </p>
      </div>

      <div class="lessons-features">
        <div class="lessons-feature">
          <div class="lessons-feature-icon blue">
            <span>🧠</span>
          </Grid>
          <h3>Deep Understanding</h3>
          <p>Learn how memory, CPU, and I/O actually work at the hardware level.</p>
        </div>

        <div class="lessons-feature">
          <div class="lessons-feature-icon red">
            <span>⚡</span>
          </Grid>
          <h3>Optimization Skills</h3>
          <p>Master resource constraints and efficient programming techniques.</p>
        </div>

        <div class="lessons-feature">
          <div class="lessons-feature-icon amber">
            <span>🎯</span>
          </Grid>
          <h3>Structured Learning</h3>
          <p>Progress through carefully designed phases and tiers at your own pace.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
