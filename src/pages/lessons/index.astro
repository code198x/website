---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter to only show systems that have lessons
const systemsWithLessons = systems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort systems by order
systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Lessons - Code Like It's 198x">
  <h1>Programming Lessons</h1>
  <p>Choose a system to begin your journey into vintage assembly programming:</p>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
    {systemsWithLessons.map((system) => (
      <a href={`/lessons/${system.slug}/`} class="block p-6 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
        <h2 class="text-2xl font-bold mb-2">{system.data.name}</h2>
        <p class="text-gray-600 mb-4">{system.data.manufacturer}</p>
        {system.data.image && (
          <img src={system.data.image} alt={system.data.name} class="w-full h-48 object-cover rounded mb-4" />
        )}
        <p class="text-sm">{system.data.description}</p>
      </a>
    ))}
  </div>
</Layout>