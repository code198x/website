---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSystemColors } from "../../utils/systemColors.js";
import Hero from "../../components/Hero.astro";
import Grid from "../../components/Grid.astro";
import FullWidthSection from "../../components/FullWidthSection.astro";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter out vault systems and check which have lessons
const allSystems = systems
  .filter((system) => system.data.status !== "vault")
  .map((system) => {
    const hasLessons = lessons.some((lesson) => lesson.id.startsWith(system.slug));
    return { ...system, hasLessons };
  });

// Group systems into two simple categories
const activeSystems = allSystems.filter((s) => s.hasLessons);
const comingSoonSystems = allSystems.filter((s) => !s.hasLessons);

// Sort by order
activeSystems.sort((a, b) => a.data.order - b.data.order);
comingSoonSystems.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Assembly Programming Courses">
  <div class="container">
    <Hero
      title="Master Assembly Programming on Real Hardware"
      description="Build games, demos, and utilities on authentic vintage systems. From the C64's SID chip to the NES PPU—learn how legends coded when every byte mattered."
      badge={{
        text: `${activeSystems.length} available • ${comingSoonSystems.length} coming soon`,
        color: "#10b981",
      }}
      variant="centered"
    />

    <!-- Active Systems -->
    {
      activeSystems.length > 0 && (
        <div>
          <h2>Available Now</h2>
          <Grid columns={3} gap="large" variant="cards">
            {activeSystems.map((system) => {
              const colors = getSystemColors(system.slug);
              const SystemWrapper = system.hasLessons ? "a" : "div";
              const wrapperProps = system.hasLessons ? { href: `/lessons/${system.slug}/` } : {};

              return (
                <SystemWrapper {...wrapperProps} class={`lesson-card ${colors.className}`}>
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      width={400}
                      height={300}
                      loading="lazy"
                      class="lesson-card-image"
                    />
                    <div class="lesson-card-badge">Full Course</div>
                  </div>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">
                      {system.data.historical_significance || system.data.description}
                    </p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </div>
                      <div class="lesson-card-cta">Start →</div>
                    </div>
                  </div>
                </SystemWrapper>
              );
            })}
          </Grid>
        </div>
      )
    }

    <!-- Coming Soon Systems -->
    {
      comingSoonSystems.length > 0 && (
        <div>
          <h2>Coming Soon</h2>
          <Grid columns={3} gap="large" variant="cards">
            {comingSoonSystems.map((system) => {
              const colors = getSystemColors(system.slug);

              return (
                <div class={`lesson-card ${colors.className} lesson-card-disabled`}>
                  <div class="lesson-card-header">
                    <img
                      src={`/images/systems/${system.slug}.jpg`}
                      alt={system.data.name}
                      width={400}
                      height={300}
                      loading="lazy"
                      class="lesson-card-image"
                    />
                    <div class="lesson-card-badge">Full Course</div>
                  </div>

                  <div class="lesson-card-body">
                    <h2 class="lesson-card-title">{system.data.name}</h2>
                    <p class="lesson-card-manufacturer">by {system.data.manufacturer}</p>
                    <p class="lesson-card-description">{system.data.description}</p>

                    <div class="lesson-card-footer">
                      <div class="lesson-card-specs">
                        <div>CPU: {system.data.cpu}</div>
                        <div>Released: {system.data.release_date.global.getFullYear()}</div>
                      </div>
                      <div class="lesson-card-cta">Coming Soon</div>
                    </div>
                  </div>
                </div>
              );
            })}
          </Grid>
        </div>
      )
    }
  </div>

  <!-- Why Learn Assembly Section -->
  <FullWidthSection
    variant="primary"
    title="Why Learn Assembly Programming?"
    description="Assembly programming on vintage computers teaches fundamental concepts that modern high-level languages abstract away. You'll gain deep understanding of how computers actually work—skills that translate directly to modern performance-critical programming."
    connectToFooter={true}
  >
    <div class="lessons-features">
      <div class="lessons-feature">
        <div class="lessons-feature-icon blue">
          <span>🧠</span>
        </div>
        <h3>Deep Understanding</h3>
        <p>Learn how memory, CPU, and I/O actually work at the hardware level.</p>
      </div>

      <div class="lessons-feature">
        <div class="lessons-feature-icon red">
          <span>⚡</span>
        </div>
        <h3>Optimization Skills</h3>
        <p>Master resource constraints and efficient programming techniques.</p>
      </div>

      <div class="lessons-feature">
        <div class="lessons-feature-icon amber">
          <span>🎯</span>
        </div>
        <h3>Complete Learning Journey</h3>
        <p>
          Every system gets the full treatment—8 phases, 4,096 lessons of comprehensive learning.
        </p>
      </div>
    </div>
  </FullWidthSection>
</Layout>
