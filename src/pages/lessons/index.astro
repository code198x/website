---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSystemColors } from "../../utils/systemColors.js";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter to only show systems that have lessons
const systemsWithLessons = systems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort systems by order
systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Programming Lessons - Code Like It's 198x">
  <div class="container" style="padding-top: var(--space-2xl);">
    <!-- Hero Section -->
    <div class="lessons-hero">
      <h1>Programming Lessons</h1>
      <p class="lessons-hero-description">
        Master vintage computer programming through structured courses. Each system offers 
        hands-on assembly programming lessons that teach you to program at the hardware level.
      </p>
      <div class="lessons-badge">
        <span class="lessons-badge-dot"></span>
        {systemsWithLessons.length} systems available
      </div>
    </div>

    <!-- Systems Grid -->
    <div class="lessons-grid">
      {systemsWithLessons.map((system) => {
        const colors = getSystemColors(system.slug);
        
        return (
          <a 
            href={`/lessons/${system.slug}/`} 
            class={`lesson-card ${colors.className}`}
          >
            <div class="lesson-card-header">
              {system.data.image ? (
                <img 
                  src={system.data.image} 
                  alt={system.data.name}
                />
              ) : (
                <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                  <span style="font-size: 4rem; color: rgba(255, 255, 255, 0.8);">💻</span>
                </div>
              )}
              <div class="lesson-card-badge">
                Course
              </div>
            </div>
            
            <div class="lesson-card-body">
              <h2 class="lesson-card-title">
                {system.data.name}
              </h2>
              <p class="lesson-card-manufacturer">
                by {system.data.manufacturer}
              </p>
              <p class="lesson-card-description">
                {system.data.historical_significance || system.data.description}
              </p>
              
              <div class="lesson-card-footer">
                <div class="lesson-card-specs">
                  <div>CPU: {system.data.cpu}</div>
                  <div>Released: {system.data.release_date.global.getFullYear()}</div>
                </div>
                <div class="lesson-card-cta">
                  Start Course →
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Info Section -->
    <div class="lessons-info">
      <div>
        <h2>Why Learn Assembly Programming?</h2>
        <p class="lessons-info-description">
          Assembly programming on vintage computers teaches fundamental concepts that modern 
          high-level languages abstract away. You'll gain deep understanding of how computers actually work.
        </p>
      </div>
      
      <div class="lessons-features">
        <div class="lessons-feature">
          <div class="lessons-feature-icon blue">
            <span>🧠</span>
          </div>
          <h3>Deep Understanding</h3>
          <p>
            Learn how memory, CPU, and I/O actually work at the hardware level.
          </p>
        </div>
        
        <div class="lessons-feature">
          <div class="lessons-feature-icon red">
            <span>⚡</span>
          </div>
          <h3>Optimization Skills</h3>
          <p>
            Master resource constraints and efficient programming techniques.
          </p>
        </div>
        
        <div class="lessons-feature">
          <div class="lessons-feature-icon amber">
            <span>🎯</span>
          </div>
          <h3>Structured Learning</h3>
          <p>
            Progress through carefully designed phases and tiers at your own pace.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>