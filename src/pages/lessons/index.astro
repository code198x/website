---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const systems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter to only show systems that have lessons
const systemsWithLessons = systems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort systems by order
systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Programming Lessons - Code Like It's 198x">
  <div class="container mx-auto px-4 py-8">
    <!-- Hero Section -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Programming Lessons</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
        Master vintage computer programming through structured courses. Each system offers 
        hands-on assembly programming lessons that teach you to program at the hardware level.
      </p>
      <div class="inline-flex items-center px-4 py-2 bg-c64-beige-dark rounded-full text-sm text-gray-600">
        <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
        {systemsWithLessons.length} systems available
      </div>
    </div>

    <!-- Systems Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {systemsWithLessons.map((system) => {
        // Define system-specific colors (same as homepage)
        const getSystemColors = (slug) => {
          switch(slug) {
            case 'commodore-64':
              return { bg: 'bg-c64-brown', accent: 'text-c64-brown', border: 'border-c64-brown' };
            case 'zx-spectrum':
              return { bg: 'bg-spectrum-red', accent: 'text-spectrum-red', border: 'border-spectrum-red' };
            case 'nintendo-entertainment-system':
              return { bg: 'bg-nes-red', accent: 'text-nes-red', border: 'border-nes-red' };
            case 'commodore-amiga':
              return { bg: 'bg-amiga-blue', accent: 'text-amiga-blue', border: 'border-amiga-blue' };
            default:
              return { bg: 'bg-gray-400', accent: 'text-gray-600', border: 'border-gray-400' };
          }
        };
        const colors = getSystemColors(system.slug);
        
        return (
          <a 
            href={`/lessons/${system.slug}/`} 
            class="group block bg-white/90 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 overflow-hidden hover:scale-105 border-2 border-transparent hover:border-opacity-30"
          >
            <div class={`h-48 ${colors.bg} relative overflow-hidden`}>
              {system.data.image ? (
                <img 
                  src={system.data.image} 
                  alt={system.data.name} 
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-200 mix-blend-multiply opacity-80"
                />
              ) : (
                <div class="flex items-center justify-center h-full">
                  <span class="text-6xl text-white/80">💻</span>
                </div>
              )}
              <div class="absolute top-4 right-4">
                <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-white text-sm font-medium">
                  Course
                </span>
              </div>
            </div>
            
            <div class="p-6">
              <h2 class={`text-2xl font-bold mb-2 group-hover:${colors.accent} transition-colors`}>
                {system.data.name}
              </h2>
              <p class="text-gray-600 mb-3">
                by {system.data.manufacturer}
              </p>
              <p class="text-sm text-gray-700 mb-4 line-clamp-3">
                {system.data.historical_significance || system.data.description}
              </p>
              
              <div class="flex items-center justify-between">
                <div class="text-xs text-gray-500">
                  <div>CPU: {system.data.cpu}</div>
                  <div>Released: {system.data.release_date.global.getFullYear()}</div>
                </div>
                <div class={`px-4 py-2 ${colors.bg} text-white rounded-lg font-medium group-hover:scale-105 transition-transform`}>
                  Start Course →
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Info Section -->
    <div class="mt-16 bg-white/60 rounded-xl p-8 border border-c64-beige-darker">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold mb-4">Why Learn Assembly Programming?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Assembly programming on vintage computers teaches fundamental concepts that modern 
          high-level languages abstract away. You'll gain deep understanding of how computers actually work.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div>
          <div class="w-12 h-12 bg-brand-blue rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-xl">🧠</span>
          </div>
          <h3 class="font-semibold mb-2">Deep Understanding</h3>
          <p class="text-sm text-gray-600">
            Learn how memory, CPU, and I/O actually work at the hardware level.
          </p>
        </div>
        
        <div>
          <div class="w-12 h-12 bg-brand-red rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-xl">⚡</span>
          </div>
          <h3 class="font-semibold mb-2">Optimization Skills</h3>
          <p class="text-sm text-gray-600">
            Master resource constraints and efficient programming techniques.
          </p>
        </div>
        
        <div>
          <div class="w-12 h-12 bg-brand-amber rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-xl">🎯</span>
          </div>
          <h3 class="font-semibold mb-2">Structured Learning</h3>
          <p class="text-sm text-gray-600">
            Progress through carefully designed phases and tiers at your own pace.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>