---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Community">
  <div class="container">
    <section class="community-hero">
      <h1 class="community-title">Join Our Community</h1>
      <p class="community-description">
        Connect with fellow retro programmers and share your 8-bit adventures
      </p>
    </section>

    <section class="community-channels">
      <div class="channel-card discord">
        <div class="channel-icon">💬</div>
        <h2>Discord Server</h2>
        <p>
          Join our active Discord community for real-time help, project sharing, and retro computing
          discussions.
        </p>
        <a href="https://discord.gg/AdmEYQKWZb" class="btn btn--primary" target="_blank">
          Join Discord →
        </a>
      </div>

      <div class="channel-card github">
        <div class="channel-icon">🐙</div>
        <h2>GitHub</h2>
        <p>
          Contribute to the project, report issues, or browse the source code for all our lessons
          and tools.
        </p>
        <a href="https://github.com/code198x" class="btn btn--secondary" target="_blank">
          View on GitHub →
        </a>
      </div>
    </section>

    <section class="community-section">
      <h2>Community Guidelines</h2>
      <div class="guidelines">
        <div class="guideline">
          <h3>🤝 Be Helpful</h3>
          <p>Share your knowledge and help others learn. We all started somewhere!</p>
        </div>
        <div class="guideline">
          <h3>🎯 Stay On Topic</h3>
          <p>Keep discussions focused on retro programming and classic systems.</p>
        </div>
        <div class="guideline">
          <h3>✨ Share Your Work</h3>
          <p>Show off your projects, demos, and experiments. We love seeing what you create!</p>
        </div>
        <div class="guideline">
          <h3>🚀 Have Fun</h3>
          <p>Remember, we're here because we love these classic machines!</p>
        </div>
      </div>
    </section>

    <section class="community-section">
      <h2>Featured Projects</h2>
      <p class="section-description">Amazing creations from our community members</p>
      <div class="projects-grid">
        <div class="project-placeholder">
          <p>Community projects coming soon!</p>
          <p>Share your creations on Discord to be featured here.</p>
        </div>
      </div>
    </section>

    <section class="community-section">
      <h2>Contributing</h2>
      <div class="contributing-info">
        <p>
          Code Like It's 198x is an open-source project, and we welcome contributions! Whether it's
          fixing typos, adding new lessons, or improving the tools, every contribution helps make
          retro programming more accessible.
        </p>
        <div class="contribute-actions">
          <a
            href="https://github.com/code198x/code198x/blob/main/CONTRIBUTING.md"
            class="btn btn--outline"
            target="_blank"
          >
            Contribution Guide
          </a>
          <a
            href="https://github.com/code198x/code198x/issues"
            class="btn btn--outline"
            target="_blank"
          >
            Report an Issue
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .community-hero {
    text-align: center;
    padding: 3rem 0;
  }

  .community-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .community-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
  }

  .community-channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin: 4rem 0;
  }

  .channel-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .channel-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .channel-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .channel-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .channel-card p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .community-section {
    margin: 4rem 0;
  }

  .community-section h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .section-description {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .guidelines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .guideline {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .guideline h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .guideline p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .projects-grid {
    margin-top: 2rem;
  }

  .project-placeholder {
    background: var(--card-bg);
    border: 2px dashed var(--border-color);
    border-radius: 8px;
    padding: 3rem;
    text-align: center;
    color: var(--text-secondary);
  }

  .contributing-info {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
  }

  .contributing-info p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .contribute-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-discord {
    background: #5865f2;
    color: white;
  }

  .btn-discord:hover {
    background: #4752c4;
    transform: translateY(-1px);
  }

  .btn-github {
    background: #24292e;
    color: white;
  }

  .btn-github:hover {
    background: #1a1e22;
    transform: translateY(-1px);
  }

  .btn-outline {
    border: 2px solid var(--border-color);
    color: var(--text-primary);
    background: transparent;
  }

  .btn-outline:hover {
    background: var(--card-bg);
    transform: translateY(-1px);
  }
</style>
