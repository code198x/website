---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import "../styles/community.css";
---

<Layout title="Community" description="Join our vibrant community of retro programmers, share your projects, and connect with fellow enthusiasts of classic computing systems.">
  <div class="community">
    <section class="community__hero">
      <div class="community__hero-content">
        <h1 class="community__title">Join Our Community</h1>
        <p class="community__description">
          Connect with fellow retro programmers, share your 8-bit adventures, and learn from
          the wisdom of bedroom coders who turned limitations into legendary games.
        </p>
      </div>
    </section>

    <section class="community__channels">
      <div class="community__channel community__channel--discord">
        <div class="community__channel-header">
          <div class="community__channel-icon">💬</div>
          <h2 class="community__channel-title">Discord Server</h2>
        </div>
        <p class="community__channel-description">
          Join our active Discord community for real-time help, project sharing, and retro computing
          discussions. Get instant feedback on your code and connect with like-minded enthusiasts.
        </p>
        <div class="community__channel-features">
          <div class="community__feature">🚀 Real-time help</div>
          <div class="community__feature">📱 Mobile & desktop</div>
          <div class="community__feature">🎮 Game showcases</div>
        </div>
        <a href="https://discord.gg/AdmEYQKWZb" class="community__btn community__btn--discord" target="_blank" rel="noopener">
          <Icon name="discord" size={20} />
          Join Discord
        </a>
      </div>

      <div class="community__channel community__channel--github">
        <div class="community__channel-header">
          <div class="community__channel-icon">🐙</div>
          <h2 class="community__channel-title">GitHub</h2>
        </div>
        <p class="community__channel-description">
          Contribute to the project, report issues, or browse the source code for all our lessons
          and tools. Every contribution makes retro programming more accessible.
        </p>
        <div class="community__channel-features">
          <div class="community__feature">🔧 Open source</div>
          <div class="community__feature">📚 All lessons included</div>
          <div class="community__feature">🐛 Issue tracking</div>
        </div>
        <a href="https://github.com/code198x" class="community__btn community__btn--github" target="_blank" rel="noopener">
          <Icon name="github" size={20} />
          View on GitHub
        </a>
      </div>
    </section>

    <section class="community__section community__section--guidelines">
      <div class="community__section-header">
        <h2 class="community__section-title">Community Guidelines</h2>
        <p class="community__section-description">
          Our community thrives on the spirit of collaboration that made the golden age of computing so special.
        </p>
      </div>
      <div class="community__guidelines">
        <div class="community__guideline community__guideline--helpful">
          <div class="community__guideline-icon">🤝</div>
          <h3 class="community__guideline-title">Be Helpful</h3>
          <p class="community__guideline-text">Share your knowledge and help others learn. Every expert was once a beginner with a rubber duck and a dream.</p>
        </div>
        <div class="community__guideline community__guideline--focused">
          <div class="community__guideline-icon">🎯</div>
          <h3 class="community__guideline-title">Stay Focused</h3>
          <p class="community__guideline-text">Keep discussions centred on retro programming, classic systems, and the art of squeezing magic from limited hardware.</p>
        </div>
        <div class="community__guideline community__guideline--creative">
          <div class="community__guideline-icon">✨</div>
          <h3 class="community__guideline-title">Share Your Work</h3>
          <p class="community__guideline-text">Show off your projects, demos, and experiments. Whether it's a simple sprite or a full game, we love seeing creativity in action.</p>
        </div>
        <div class="community__guideline community__guideline--fun">
          <div class="community__guideline-icon">🚀</div>
          <h3 class="community__guideline-title">Have Fun</h3>
          <p class="community__guideline-text">Remember, we're here because we love these classic machines and the magic they can create with just a few kilobytes!</p>
        </div>
      </div>
    </section>

    <section class="community__section community__section--projects">
      <div class="community__section-header">
        <h2 class="community__section-title">Featured Projects</h2>
        <p class="community__section-description">
          Amazing creations from our community members - proof that constraints breed creativity!
        </p>
      </div>
      <div class="community__projects-empty">
        <div class="community__projects-empty-content">
          <div class="community__projects-empty-icon">🚀</div>
          <h3 class="community__projects-empty-title">Be the First to Share!</h3>
          <p class="community__projects-empty-text">
            We're just getting started and can't wait to see what amazing projects our community creates.
            Whether it's a simple "Hello World" in assembly or a full game, every project inspires others.
          </p>
          <div class="community__projects-empty-actions">
            <a href="https://discord.gg/AdmEYQKWZb" class="community__btn community__btn--outline" target="_blank" rel="noopener">
              <Icon name="discord" size={20} />
              Share on Discord
            </a>
            <a href="/lessons" class="community__btn community__btn--outline">
              Start Learning
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="community__section community__section--contributing">
      <div class="community__section-header">
        <h2 class="community__section-title">Contributing</h2>
        <p class="community__section-description">
          Be part of preserving and sharing the art of retro programming with future generations.
        </p>
      </div>
      <div class="community__contributing">
        <div class="community__contributing-content">
          <p class="community__contributing-text">
            Code Like It's 198x is an open-source project built by the community, for the community.
            Whether you're fixing typos, adding new lessons, improving tools, or sharing your expertise,
            every contribution helps preserve the magic of retro computing for future bedroom coders.
          </p>
          <div class="community__contributing-ways">
            <div class="community__contributing-way">
              <div class="community__contributing-way-icon">📝</div>
              <h4 class="community__contributing-way-title">Write Lessons</h4>
              <p class="community__contributing-way-text">Share your expertise by creating new tutorials</p>
            </div>
            <div class="community__contributing-way">
              <div class="community__contributing-way-icon">🔧</div>
              <h4 class="community__contributing-way-title">Fix Bugs</h4>
              <p class="community__contributing-way-text">Help improve the platform for everyone</p>
            </div>
            <div class="community__contributing-way">
              <div class="community__contributing-way-icon">🎉</div>
              <h4 class="community__contributing-way-title">Share Projects</h4>
              <p class="community__contributing-way-text">Inspire others with your creative work</p>
            </div>
          </div>
        </div>
        <div class="community__contributing-actions">
          <a
            href="https://github.com/code198x/code198x/blob/main/CONTRIBUTING.md"
            class="community__btn community__btn--outline"
            target="_blank"
            rel="noopener"
          >
            <Icon name="info" size={20} />
            Contribution Guide
          </a>
          <a
            href="https://github.com/code198x/code198x/issues"
            class="community__btn community__btn--outline"
            target="_blank"
            rel="noopener"
          >
            <Icon name="warning" size={20} />
            Report an Issue
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
