---
import Layout from '../../layouts/Layout.astro';

// Game catalogue - 8 BASIC games
const games = [
  {
    number: 1,
    slug: 'game-01-guess-quest',
    name: 'Guess Quest',
    tagline: 'Number guessing with visual feedback',
    units: 64,
    unitsAvailable: 0,
    skills: ['Variables', 'IF/THEN/ELSE', 'FOR/NEXT', 'INK/PAPER'],
    status: 'coming-soon'
  },
  {
    number: 2,
    slug: 'game-02-pixel-rain',
    name: 'Pixel Rain',
    tagline: 'Falling pixels using PLOT command',
    units: 64,
    unitsAvailable: 0,
    skills: ['PLOT command', 'Coordinates', 'INK colours', 'Animation'],
    status: 'coming-soon'
  },
  {
    number: 3,
    slug: 'game-03-paddle-battle',
    name: 'Paddle Battle',
    tagline: 'Pong-style game with INKEY$ input',
    units: 64,
    unitsAvailable: 0,
    skills: ['INKEY$', 'DRAW command', 'Collision', 'Two-player'],
    status: 'coming-soon'
  },
  {
    number: 4,
    slug: 'game-04-dungeon-explorer',
    name: 'Dungeon Explorer',
    tagline: 'Navigate rooms with DATA statements',
    units: 64,
    unitsAvailable: 0,
    skills: ['DATA/READ', 'PRINT AT', 'Room data', 'Inventory'],
    status: 'coming-soon'
  },
  {
    number: 5,
    slug: 'game-05-snake-spectrum',
    name: 'Snake Spectrum',
    tagline: 'Classic snake with User-Defined Graphics',
    units: 64,
    unitsAvailable: 0,
    skills: ['Arrays', 'UDG characters', 'Self-collision', 'Growth'],
    status: 'coming-soon'
  },
  {
    number: 6,
    slug: 'game-06-asteroid-dodge',
    name: 'Asteroid Dodge',
    tagline: 'Space game encountering attribute clash',
    units: 64,
    unitsAvailable: 0,
    skills: ['Multiple objects', 'UDG sprites', 'Attribute clash', 'High scores'],
    status: 'coming-soon'
  },
  {
    number: 7,
    slug: 'game-07-pattern-match',
    name: 'Pattern Match',
    tagline: 'Memory puzzle with full UDG set',
    units: 64,
    unitsAvailable: 0,
    skills: ['Full UDG set', '2D arrays', 'PEEK timer', 'Two-player'],
    status: 'coming-soon'
  },
  {
    number: 8,
    slug: 'game-08-platform-jump',
    name: 'Platform Jump',
    tagline: 'Platformer pushing Sinclair BASIC to its limits',
    units: 64,
    unitsAvailable: 0,
    skills: ['Gravity', 'Jump physics', 'Attribute clash', 'BASIC limits'],
    status: 'coming-soon'
  }
];
---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC by building complete games. A gateway curriculum preparing you for Z80 assembly."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #444444 0%, #666666 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      opacity: 0.6;
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--color-text-secondary);
      width: 3rem;
      text-align: center;
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .game-tagline {
      color: var(--color-text-secondary);
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-bg);
      color: var(--color-text-secondary);
      border-radius: 0.25rem;
    }

    .game-status {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    .next-step {
      background: var(--color-surface);
      border: 2px solid #444444;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-top: var(--space-8);
    }

    .next-step h3 {
      color: #444444;
      margin-bottom: var(--space-2);
    }

    @media (max-width: 768px) {
      .game-card {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .game-number { width: auto; }
      .game-skills { justify-content: center; }
    }
  </style>

  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">SINCLAIR BASIC</h1>
      <p class="system-subtitle">Gateway curriculum — learn programming fundamentals before assembly</p>
    </div>
  </section>

  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      8 complete games teaching Sinclair BASIC. Rich built-in graphics commands (PLOT, DRAW, CIRCLE) make this an excellent starting point. Complete this curriculum to prepare for Z80 assembly.
    </p>

    <div class="game-grid">
      {games.map((game) => (
        <a href={`/sinclair-zx-spectrum-basic/${game.slug}`} class="game-card">
          <div class="game-number">{game.number}</div>
          <div class="game-info">
            <div class="game-name">{game.name}</div>
            <div class="game-tagline">{game.tagline}</div>
            <div class="game-skills">
              {game.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          <span class="game-status">Coming Soon</span>
        </a>
      ))}
    </div>

    <div class="next-step">
      <h3>After BASIC</h3>
      <p>Complete these 8 games and you'll understand the attribute system, UDGs, and BASIC's limits. Then move to <a href="/sinclair-zx-spectrum">Z80 Assembly</a> to unlock software sprites and smooth scrolling.</p>
    </div>
  </section>
</Layout>
