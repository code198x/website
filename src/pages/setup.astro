---
import Layout from '../layouts/Layout.astro';
import { Terminal, Monitor, Download, CheckCircle, Cpu, Package, Camera, Code } from '@lucide/astro';

const platforms = [
  {
    name: 'Commodore 64',
    slug: 'commodore-64',
    image: 'code198x/commodore-64',
    color: '#4a4dff',
    assembler: 'ACME',
    emulator: 'VICE (x64sc)',
    buildOutput: '.prg files',
    extras: ['petcat for BASIC', 'Screenshot capture']
  },
  {
    name: 'ZX Spectrum',
    slug: 'sinclair-zx-spectrum',
    image: 'code198x/sinclair-zx-spectrum',
    color: '#cc0000',
    assembler: 'pasmonext',
    emulator: 'Fuse',
    buildOutput: '.tap / .sna files',
    extras: ['zmakebas for BASIC', 'Screenshot capture']
  },
  {
    name: 'Commodore Amiga',
    slug: 'commodore-amiga',
    image: 'code198x/commodore-amiga',
    color: '#ff6600',
    assembler: 'vasm (68000)',
    emulator: 'FS-UAE',
    buildOutput: 'Executables / .adf disks',
    extras: ['amitools (xdftool)', 'Video capture', 'NDK 3.2']
  },
  {
    name: 'NES',
    slug: 'nintendo-entertainment-system',
    image: 'code198x/nintendo-entertainment-system',
    color: '#e30613',
    assembler: 'ca65 / ld65',
    emulator: 'FCEUX',
    buildOutput: '.nes ROM files',
    extras: ['cc65 C compiler', 'Screenshot capture']
  }
];
---

<Layout
  title="Setup"
  description="Get started with retro game development in 60 seconds. Our Docker toolchains include everything you need - no installation hassle."
>
  <div class="setup-page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-content">
        <Terminal size={48} class="hero-icon" />
        <h1>Start Coding in 60 Seconds</h1>
        <p class="hero-subtitle">Zero configuration. One command to build.</p>
        <p class="hero-description">
          Our Docker toolchains include cross-assemblers and build tools for every platform.
          No dependency management. No version conflicts. Just code.
        </p>
      </div>
    </section>

    <!-- Quick Start -->
    <section class="quick-start">
      <div class="container">
        <h2>Quick Start</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Install Docker Desktop</h3>
              <p>Free from <a href="https://www.docker.com/products/docker-desktop/" target="_blank" rel="noopener">docker.com</a> for Mac, Windows, and Linux</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Download the Toolchain</h3>
              <div class="code-block">
                <code>docker pull code198x/commodore-64</code>
              </div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Build Your Code</h3>
              <div class="code-block">
                <code>docker run -v ./code:/code code198x/commodore-64 acme game.asm -o game.prg</code>
              </div>
            </div>
          </div>
        </div>
        <p class="steps-note">Done! Your compiled program is ready. Install an emulator (VICE for C64, Fuse for Spectrum) to run it.</p>
      </div>
    </section>

    <!-- Platform Cards -->
    <section class="platforms-section">
      <div class="container">
        <h2>Available Toolchains</h2>
        <p class="section-description">Each toolchain is tailored for its platform with the right assembler, emulator, and development tools.</p>

        <div class="platforms-grid">
          {platforms.map(platform => (
            <div class="platform-card" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h3>{platform.name}</h3>
                <div class="platform-image">
                  <code>{platform.image}</code>
                </div>
              </div>
              <div class="platform-tools">
                <div class="tool-row">
                  <Code size={16} />
                  <span><strong>Assembler:</strong> {platform.assembler}</span>
                </div>
                <div class="tool-row">
                  <Monitor size={16} />
                  <span><strong>Recommended emulator:</strong> {platform.emulator}</span>
                </div>
                <div class="tool-row">
                  <Package size={16} />
                  <span><strong>Output:</strong> {platform.buildOutput}</span>
                </div>
              </div>
              <div class="platform-extras">
                <strong>Also includes:</strong>
                <ul>
                  {platform.extras.map(extra => (
                    <li><CheckCircle size={14} /> {extra}</li>
                  ))}
                </ul>
              </div>
              <a href={`/${platform.slug}/getting-started`} class="platform-link">
                View full setup guide
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What's Included -->
    <section class="included-section">
      <div class="container">
        <h2>The Workflow</h2>
        <div class="features-grid">
          <div class="feature">
            <Code size={32} class="feature-icon" />
            <h3>Build in Docker</h3>
            <p>Cross-assemblers run in containers. Consistent builds across macOS, Windows, and Linux with zero setup.</p>
          </div>
          <div class="feature">
            <Monitor size={32} class="feature-icon" />
            <h3>Test in Emulators</h3>
            <p>Run your compiled programs in VICE, Fuse, FS-UAE, or FCEUX. Native emulators give the smoothest experience.</p>
          </div>
          <div class="feature">
            <Camera size={32} class="feature-icon" />
            <h3>Automated Screenshots</h3>
            <p>Docker toolchains include headless screenshot capture for CI/CD and documentation.</p>
          </div>
          <div class="feature">
            <Cpu size={32} class="feature-icon" />
            <h3>VS Code Integration</h3>
            <p>Dev Container support for seamless IDE integration with syntax highlighting.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Alternative -->
    <section class="native-section">
      <div class="container">
        <p class="native-note">
          <strong>Prefer native tools?</strong> Each platform's getting started guide includes instructions for installing assemblers directly.
          You'll manage dependencies yourself, but <a href="/commodore-64/getting-started#native">it's documented</a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <h2>Ready to Build Something?</h2>
        <p>Pick a platform and start your first game.</p>
        <div class="cta-buttons">
          <a href="/commodore-64" class="btn btn-primary">Start with C64</a>
          <a href="https://github.com/code198x" class="btn btn-secondary" target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .setup-page {
    --accent-gradient: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  }

  /* Hero */
  .hero {
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--space-16) var(--space-4);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-icon {
    color: var(--color-success);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--color-success);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Quick Start */
  .quick-start {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .quick-start h2 {
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .steps {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .step-number {
    width: 40px;
    height: 40px;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .step-content p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .code-block {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
  }

  .code-block code {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    background: none;
    padding: 0;
    color: var(--color-success);
  }

  .steps-note {
    text-align: center;
    color: var(--color-text-secondary);
    margin-top: var(--space-6);
    font-style: italic;
  }

  /* Platforms Section */
  .platforms-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg-secondary);
  }

  .platforms-section h2 {
    text-align: center;
    margin: 0 0 var(--space-2) 0;
  }

  .section-description {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    max-width: 1200px;
    margin: 0 auto;
  }

  .platform-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--space-6);
    border-top: 4px solid var(--platform-color);
    transition: transform 0.2s ease, box-shadow 0.3s ease;
  }

  .platform-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 20px color-mix(in srgb, var(--platform-color) 25%, transparent),
      0 0 40px color-mix(in srgb, var(--platform-color) 15%, transparent),
      0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .platform-header {
    margin-bottom: var(--space-4);
  }

  .platform-header h3 {
    margin: 0 0 var(--space-2) 0;
    color: var(--platform-color);
  }

  .platform-image code {
    font-size: 0.8rem;
    background: var(--color-code-bg);
    color: var(--color-success);
    padding: var(--space-1) var(--space-2);
    border-radius: 0.25rem;
  }

  .platform-tools {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .tool-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .tool-row strong {
    color: var(--color-text);
  }

  .platform-extras {
    font-size: 0.875rem;
    margin-bottom: var(--space-4);
  }

  .platform-extras strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }

  .platform-extras ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .platform-extras li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
  }

  .platform-extras li :global(svg) {
    color: var(--color-success);
  }

  .platform-link {
    display: block;
    text-align: center;
    color: var(--platform-color);
    font-weight: 500;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-light);
  }

  .platform-link:hover {
    text-decoration: underline;
  }

  /* Included Section */
  .included-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .included-section h2 {
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin: 0 auto;
  }

  .feature {
    text-align: center;
    padding: var(--space-4);
  }

  .feature-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .feature h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .feature p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Native Section */
  .native-section {
    padding: var(--space-6) var(--space-4);
    background: var(--color-bg);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .native-note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .native-note strong {
    color: var(--color-text);
  }

  .native-note a {
    color: var(--color-primary);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-16) var(--space-4);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    color: white;
    text-align: center;
  }

  .cta-section h2 {
    margin: 0 0 var(--space-2) 0;
    color: white;
  }

  .cta-section p {
    margin: 0 0 var(--space-6) 0;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn-primary {
    background: white;
    color: var(--color-primary);
    border-color: white;
  }

  .cta-buttons .btn-primary:hover {
    background: #f1f5f9;
    color: var(--color-primary);
  }

  .cta-buttons .btn-secondary {
    background: transparent;
    color: white;
    border-color: white;
  }

  .cta-buttons .btn-secondary:hover {
    background: white;
    color: var(--color-primary);
  }

  /* Container */
  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .step {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .platforms-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
