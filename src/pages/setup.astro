---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="Development Setup - Code Like It's 198x">
	<Breadcrumb segments={[{ text: 'Setup', href: '/setup' }]} />
	
	<div class="max-w-6xl mx-auto px-4 py-8">
		<header class="text-center mb-12">
			<h1 class="text-4xl font-bold text-green-400 mb-4">
				Assembly Development Setup
			</h1>
			<p class="text-xl text-gray-300 max-w-4xl mx-auto">
				Get your development environment ready for authentic retro assembly programming. 
				Choose your system and follow the step-by-step setup guide.
			</p>
		</header>

		<!-- System Selection -->
		<div class="bg-gray-800 rounded-lg p-6 mb-8">
			<h2 class="text-2xl font-bold text-green-400 mb-4">Choose Your System</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
				<button class="system-btn bg-blue-600 hover:bg-blue-500 text-white p-4 rounded-lg transition-colors" data-system="c64">
					<div class="text-2xl mb-2">💾</div>
					<div class="font-bold">Commodore 64</div>
					<div class="text-sm opacity-75">6502 Assembly</div>
				</button>
				<button class="system-btn bg-purple-600 hover:bg-purple-500 text-white p-4 rounded-lg transition-colors" data-system="spectrum">
					<div class="text-2xl mb-2">🖥️</div>
					<div class="font-bold">ZX Spectrum</div>
					<div class="text-sm opacity-75">Z80 Assembly</div>
				</button>
				<button class="system-btn bg-red-600 hover:bg-red-500 text-white p-4 rounded-lg transition-colors" data-system="amiga">
					<div class="text-2xl mb-2">🎨</div>
					<div class="font-bold">Commodore Amiga</div>
					<div class="text-sm opacity-75">68000 Assembly</div>
				</button>
				<button class="system-btn bg-orange-600 hover:bg-orange-500 text-white p-4 rounded-lg transition-colors" data-system="nes">
					<div class="text-2xl mb-2">🎮</div>
					<div class="font-bold">Nintendo NES</div>
					<div class="text-sm opacity-75">6502 Assembly</div>
				</button>
			</div>
		</div>

		<!-- Setup Content -->
		<div id="setup-content">
			<!-- Default content -->
			<div class="text-center text-gray-400 py-12">
				<div class="text-4xl mb-4">👆</div>
				<p class="text-xl">Select a system above to see setup instructions</p>
			</div>
		</div>

		<!-- Commodore 64 Setup -->
		<div id="c64-setup" class="setup-section hidden">
			<div class="bg-blue-900 rounded-lg p-8 mb-8">
				<h2 class="text-3xl font-bold text-blue-200 mb-6">Commodore 64 Development Setup</h2>
				<p class="text-blue-100 text-lg mb-6">
					The C64 uses the 6502 processor. We'll use ACME as our primary assembler - it's free, cross-platform, and produces authentic C64 programs.
				</p>

				<!-- Quick Start -->
				<div class="bg-blue-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-blue-200 mb-4">🚀 Quick Start (Recommended)</h3>
					<div class="bg-black rounded-lg p-4 mb-4">
						<pre class="text-green-400 text-sm overflow-x-auto"><code># Windows (using Chocolatey)
choco install acme-crossassembler vice

# macOS (using Homebrew)
brew install acme vice

# Linux (Ubuntu/Debian)
sudo apt install acme vice</code></pre>
					</div>
					<p class="text-blue-100 text-sm">This installs ACME assembler and VICE emulator for testing your programs.</p>
				</div>

				<!-- Manual Installation -->
				<div class="bg-blue-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-blue-200 mb-4">📥 Manual Installation</h3>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-blue-200 mb-3">ACME Assembler</h4>
							<ol class="list-decimal list-inside space-y-2 text-blue-100 text-sm">
								<li>Download from <a href="https://sourceforge.net/projects/acme-crossdev/" class="text-blue-300 underline">ACME SourceForge</a></li>
								<li>Extract to <code class="bg-black px-2 py-1 rounded">C:\acme</code> (Windows) or <code class="bg-black px-2 py-1 rounded">/usr/local/bin</code> (Unix)</li>
								<li>Add to your system PATH</li>
								<li>Test: <code class="bg-black px-2 py-1 rounded">acme --version</code></li>
							</ol>
						</div>
						<div>
							<h4 class="font-bold text-blue-200 mb-3">VICE Emulator</h4>
							<ol class="list-decimal list-inside space-y-2 text-blue-100 text-sm">
								<li>Download from <a href="https://vice-emu.sourceforge.io/" class="text-blue-300 underline">VICE Official Site</a></li>
								<li>Install using the installer for your platform</li>
								<li>Test: Launch x64sc (accurate C64 emulator)</li>
								<li>Configure for development use</li>
							</ol>
						</div>
					</div>
				</div>

				<!-- First Program -->
				<div class="bg-blue-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-blue-200 mb-4">✍️ Your First C64 Program</h3>
					
					<div class="mb-4">
						<p class="text-blue-100 mb-3">Create a file called <code class="bg-black px-2 py-1 rounded">hello.asm</code>:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code>; hello.asm - Your first C64 assembly program
* = $0801

; BASIC stub to make program runnable
!byte $0c, $08, $0a, $00, $9e, $20, $32, $30, $36, $34, $00, $00, $00

; Main program starts here
start&#58;
    lda #$93        ; Clear screen character
    jsr $ffd2       ; Call KERNAL print routine
    
    ldx #0          ; Initialize index
print_loop&#58;
    lda message,x   ; Load character from message
    beq done        ; If zero, we're done
    jsr $ffd2       ; Print character
    inx             ; Next character
    jmp print_loop  ; Continue loop
    
done&#58;
    rts             ; Return to BASIC

message:
    !text "HELLO FROM ASSEMBLY!"
    !byte 0         ; String terminator</code></pre>
						</div>
					</div>
					
					<div class="mb-4">
						<p class="text-blue-100 mb-3">Assemble and run:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code># Assemble the program
acme -f cbm -o hello.prg hello.asm

# Run in VICE emulator
x64sc hello.prg

# In the emulator, type: RUN</code></pre>
						</div>
					</div>
					
					<div class="bg-blue-700 rounded p-4">
						<p class="text-blue-100 text-sm">
							<strong>Success!</strong> You should see "HELLO FROM ASSEMBLY!" printed on the C64 screen. 
							This program demonstrates loading values, calling KERNAL routines, and creating loops.
						</p>
					</div>
				</div>

				<!-- Development Workflow -->
				<div class="bg-blue-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-blue-200 mb-4">🔄 Development Workflow</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-blue-200 mb-3">Essential ACME Options</h4>
							<div class="bg-black rounded p-3 text-green-400 text-sm font-mono">
								<div>-f cbm     # Commodore format</div>
								<div>-o file.prg # Output filename</div>
								<div>-l file.lst # Create listing</div>
								<div>--msvc      # MSVC error format</div>
								<div>--vicelabels # VICE debugger labels</div>
							</div>
						</div>
						<div>
							<h4 class="font-bold text-blue-200 mb-3">VICE Debugging</h4>
							<div class="bg-black rounded p-3 text-green-400 text-sm font-mono">
								<div>Alt+H    # Monitor (debugger)</div>
								<div>x        # Exit monitor</div>
								<div>d $0801  # Disassemble memory</div>
								<div>m $0801  # View memory</div>
								<div>r        # Show registers</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- ZX Spectrum Setup -->
		<div id="spectrum-setup" class="setup-section hidden">
			<div class="bg-purple-900 rounded-lg p-8 mb-8">
				<h2 class="text-3xl font-bold text-purple-200 mb-6">ZX Spectrum Development Setup</h2>
				<p class="text-purple-100 text-lg mb-6">
					The ZX Spectrum uses the Z80 processor. We'll use z88dk as our primary toolchain - it includes assembler, C compiler, and extensive Spectrum libraries.
				</p>

				<!-- Quick Start -->
				<div class="bg-purple-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-purple-200 mb-4">🚀 Quick Start (Recommended)</h3>
					<div class="bg-black rounded-lg p-4 mb-4">
						<pre class="text-green-400 text-sm overflow-x-auto"><code># Windows: Download installer from z88dk.org
# Extract and run setup.exe

# macOS (using Homebrew)
brew install z88dk

# Linux (Ubuntu/Debian)
sudo apt install z88dk</code></pre>
					</div>
					<p class="text-purple-100 text-sm">Also install Fuse emulator for testing: <code class="bg-black px-2 py-1 rounded">brew install fuse-emulator</code></p>
				</div>

				<!-- Manual Installation -->
				<div class="bg-purple-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-purple-200 mb-4">📥 Manual Installation</h3>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-purple-200 mb-3">z88dk Toolchain</h4>
							<ol class="list-decimal list-inside space-y-2 text-purple-100 text-sm">
								<li>Download from <a href="https://z88dk.org/" class="text-purple-300 underline">z88dk.org</a></li>
								<li>Extract to <code class="bg-black px-2 py-1 rounded">C:\z88dk</code> (Windows) or <code class="bg-black px-2 py-1 rounded">/opt/z88dk</code> (Unix)</li>
								<li>Set environment variables (see documentation)</li>
								<li>Test: <code class="bg-black px-2 py-1 rounded">z88dk-z80asm --version</code></li>
							</ol>
						</div>
						<div>
							<h4 class="font-bold text-purple-200 mb-3">Fuse Emulator</h4>
							<ol class="list-decimal list-inside space-y-2 text-purple-100 text-sm">
								<li>Download from <a href="http://fuse-emulator.sourceforge.net/" class="text-purple-300 underline">Fuse Emulator Site</a></li>
								<li>Install using package manager or compile from source</li>
								<li>Test: Launch fuse and load a tape file</li>
								<li>Configure for 48K/128K Spectrum models</li>
							</ol>
						</div>
					</div>
				</div>

				<!-- First Program -->
				<div class="bg-purple-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-purple-200 mb-4">✍️ Your First Spectrum Program</h3>
					
					<div class="mb-4">
						<p class="text-purple-100 mb-3">Create a file called <code class="bg-black px-2 py-1 rounded">hello.asm</code>:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code>; hello.asm - Your first ZX Spectrum assembly program
    org 32768       ; Start address ($8000)

start&#58;
    ; Clear screen with black paper, white ink
    ld a, %00000111 ; White ink, black paper
    ld (23693), a   ; Store in ATTR_P (permanent attributes)
    call 3503       ; Call ROM routine CLS (clear screen)
    
    ; Print message
    ld hl, message  ; Point to message string
    ld bc, msg_end - message ; Length of message
    call print_string
    
    ; Wait for keypress then return to BASIC
    call wait_key
    ret

print_string&#58;
    ld a, (hl)      ; Get character
    rst 16          ; Print it (ROM routine)
    inc hl          ; Next character
    dec bc          ; Decrement counter
    ld a, b         ; Check if BC = 0
    or c
    jr nz, print_string
    ret

wait_key&#58;
    call 949        ; ROM routine WAIT_KEY
    ret

message&#58;
    defb "Hello from Z80 Assembly!"
msg_end&#58;</code></pre>
						</div>
					</div>
					
					<div class="mb-4">
						<p class="text-purple-100 mb-3">Assemble and run:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code># Assemble the program
z88dk-z80asm -b hello.asm

# Create TAP file for emulator
z88dk-appmake +zx -b hello.bin -o hello.tap --org 32768 --exec 32768

# Run in Fuse emulator
fuse hello.tap

# In emulator: LOAD "" then RUN</code></pre>
						</div>
					</div>
					
					<div class="bg-purple-700 rounded p-4">
						<p class="text-purple-100 text-sm">
							<strong>Success!</strong> You should see "Hello from Z80 Assembly!" on the Spectrum screen. 
							This program demonstrates memory addressing, ROM calls, and string handling.
						</p>
					</div>
				</div>

				<!-- Development Workflow -->
				<div class="bg-purple-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-purple-200 mb-4">🔄 Development Workflow</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-purple-200 mb-3">Essential z88dk Options</h4>
							<div class="bg-black rounded p-3 text-green-400 text-sm font-mono">
								<div>-b           # Binary output</div>
								<div>-l           # Create listing</div>
								<div>-m           # Create map file</div>
								<div>--list-opt   # Optimized listing</div>
							</div>
						</div>
						<div>
							<h4 class="font-bold text-purple-200 mb-3">Fuse Debugging</h4>
							<div class="bg-black rounded p-3 text-green-400 text-sm font-mono">
								<div>F10      # Debugger</div>
								<div>F7       # Step into</div>
								<div>F8       # Step over</div>
								<div>Ctrl+B   # Set breakpoint</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Amiga Setup -->
		<div id="amiga-setup" class="setup-section hidden">
			<div class="bg-red-900 rounded-lg p-8 mb-8">
				<h2 class="text-3xl font-bold text-red-200 mb-6">Commodore Amiga Development Setup</h2>
				<p class="text-red-100 text-lg mb-6">
					The Amiga uses the Motorola 68000 processor. We'll use VASM as our assembler - it's actively maintained and produces authentic Amiga executables.
				</p>

				<!-- Quick Start -->
				<div class="bg-red-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-red-200 mb-4">🚀 Quick Start (Recommended)</h3>
					<div class="bg-black rounded-lg p-4 mb-4">
						<pre class="text-green-400 text-sm overflow-x-auto"><code># Download VASM from official site
# http://sun.hasenbraten.de/vasm/

# macOS/Linux: Compile from source
make CPU=m68k SYNTAX=mot
sudo make install

# Windows: Download pre-compiled binaries</code></pre>
					</div>
					<p class="text-red-100 text-sm">Also install FS-UAE emulator for testing your programs.</p>
				</div>

				<!-- Manual Installation -->
				<div class="bg-red-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-red-200 mb-4">📥 Manual Installation</h3>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-red-200 mb-3">VASM Assembler</h4>
							<ol class="list-decimal list-inside space-y-2 text-red-100 text-sm">
								<li>Download from <a href="http://sun.hasenbraten.de/vasm/" class="text-red-300 underline">VASM Official Site</a></li>
								<li>Compile: <code class="bg-black px-2 py-1 rounded">make CPU=m68k SYNTAX=mot</code></li>
								<li>Install binary as <code class="bg-black px-2 py-1 rounded">vasmm68k_mot</code></li>
								<li>Test: <code class="bg-black px-2 py-1 rounded">vasmm68k_mot -version</code></li>
							</ol>
						</div>
						<div>
							<h4 class="font-bold text-red-200 mb-3">FS-UAE Emulator</h4>
							<ol class="list-decimal list-inside space-y-2 text-red-100 text-sm">
								<li>Download from <a href="https://fs-uae.net/" class="text-red-300 underline">FS-UAE Official Site</a></li>
								<li>Install using installer for your platform</li>
								<li>Obtain Amiga Kickstart ROMs (legally required)</li>
								<li>Configure for A500/A1200 development</li>
							</ol>
						</div>
					</div>
				</div>

				<!-- First Program -->
				<div class="bg-red-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-red-200 mb-4">✍️ Your First Amiga Program</h3>
					
					<div class="mb-4">
						<p class="text-red-100 mb-3">Create a file called <code class="bg-black px-2 py-1 rounded">hello.s</code>:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code>; hello.s - Your first Amiga assembly program
    
    INCLUDE "exec/exec_lib.i"
    
    SECTION code,CODE
    
start&#58;
    ; Open DOS library
    lea     dosname(pc), a1
    moveq   #0, d0
    move.l  4.w, a6
    jsr     -552(a6)        ; OpenLibrary
    move.l  d0, dosbase
    beq     exit
    
    ; Print message
    move.l  dosbase(pc), a6
    move.l  #message, d1
    jsr     -948(a6)        ; PutStr
    
    ; Close DOS library
    move.l  dosbase(pc), a1
    move.l  4.w, a6
    jsr     -414(a6)        ; CloseLibrary
    
exit:
    moveq   #0, d0
    rts

    SECTION data,DATA
    
message:
    dc.b    "Hello from 68000 Assembly!",10,0
    
dosname:
    dc.b    "dos.library",0
    
    SECTION bss,BSS
    
dosbase:
    ds.l    1</code></pre>
						</div>
					</div>
					
					<div class="mb-4">
						<p class="text-red-100 mb-3">Assemble and run:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code># Assemble the program
vasmm68k_mot -Felf -o hello.o hello.s

# Link to create executable
vc -o hello hello.o

# Run in FS-UAE emulator
# Copy hello to Amiga disk image and run from CLI</code></pre>
						</div>
					</div>
					
					<div class="bg-red-700 rounded p-4">
						<p class="text-red-100 text-sm">
							<strong>Success!</strong> You should see "Hello from 68000 Assembly!" in the Amiga CLI. 
							This program demonstrates AmigaOS library calls and proper program structure.
						</p>
					</div>
				</div>

				<!-- Development Workflow -->
				<div class="bg-red-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-red-200 mb-4">🔄 Development Workflow</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-red-200 mb-3">Essential VASM Options</h4>
							<div class="bg-black rounded p-3 text-green-400 text-sm font-mono">
								<div>-Felf        # ELF object format</div>
								<div>-Fhunkexe    # Amiga executable</div>
								<div>-L           # Create listing</div>
								<div>-showopt     # Show optimizations</div>
							</div>
						</div>
						<div>
							<h4 class="font-bold text-red-200 mb-3">FS-UAE Features</h4>
							<div class="bg-black rounded p-3 text-green-400 text-sm font-mono">
								<div>F12      # Settings</div>
								<div>F11      # Debugger</div>
								<div>Ctrl+F10 # Quit</div>
								<div>Ctrl+R   # Reset</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- NES Setup -->
		<div id="nes-setup" class="setup-section hidden">
			<div class="bg-orange-900 rounded-lg p-8 mb-8">
				<h2 class="text-3xl font-bold text-orange-200 mb-6">Nintendo Entertainment System Development Setup</h2>
				<p class="text-orange-100 text-lg mb-6">
					The NES uses a modified 6502 processor. We'll use cc65 as our toolchain - it includes ca65 assembler and ld65 linker specifically designed for NES development.
				</p>

				<!-- Quick Start -->
				<div class="bg-orange-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-orange-200 mb-4">🚀 Quick Start (Recommended)</h3>
					<div class="bg-black rounded-lg p-4 mb-4">
						<pre class="text-green-400 text-sm overflow-x-auto"><code># Windows: Download from cc65.github.io
# Extract and add to PATH

# macOS (using Homebrew)
brew install cc65

# Linux (Ubuntu/Debian)
sudo apt install cc65</code></pre>
					</div>
					<p class="text-orange-100 text-sm">Also install Mesen emulator for testing: <code class="bg-black px-2 py-1 rounded">brew install mesen</code></p>
				</div>

				<!-- Manual Installation -->
				<div class="bg-orange-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-orange-200 mb-4">📥 Manual Installation</h3>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<h4 class="font-bold text-orange-200 mb-3">cc65 Toolchain</h4>
							<ol class="list-decimal list-inside space-y-2 text-orange-100 text-sm">
								<li>Download from <a href="https://cc65.github.io/" class="text-orange-300 underline">cc65 Official Site</a></li>
								<li>Extract to <code class="bg-black px-2 py-1 rounded">C:\cc65</code> (Windows) or <code class="bg-black px-2 py-1 rounded">/usr/local/cc65</code> (Unix)</li>
								<li>Add bin directory to PATH</li>
								<li>Test: <code class="bg-black px-2 py-1 rounded">ca65 --version</code></li>
							</ol>
						</div>
						<div>
							<h4 class="font-bold text-orange-200 mb-3">Mesen Emulator</h4>
							<ol class="list-decimal list-inside space-y-2 text-orange-100 text-sm">
								<li>Download from <a href="https://mesen.ca/" class="text-orange-300 underline">Mesen Official Site</a></li>
								<li>Install using installer for your platform</li>
								<li>Test: Launch Mesen and load a ROM file</li>
								<li>Configure for NES development debugging</li>
							</ol>
						</div>
					</div>
				</div>

				<!-- First Program -->
				<div class="bg-orange-800 rounded-lg p-6 mb-8">
					<h3 class="text-xl font-bold text-orange-200 mb-4">✍️ Your First NES Program</h3>
					
					<div class="mb-4">
						<p class="text-orange-100 mb-3">Create files <code class="bg-black px-2 py-1 rounded">hello.s</code> and <code class="bg-black px-2 py-1 rounded">hello.cfg</code>:</p>
						<div class="bg-black rounded-lg p-4 mb-4">
							<p class="text-orange-200 text-sm mb-2">hello.s:</p>
							<pre class="text-green-400 text-sm overflow-x-auto"><code>; hello.s - Your first NES assembly program

.segment "HEADER"
.byte "NES", $1A    ; NES file signature
.byte $02           ; PRG ROM size (32K)
.byte $01           ; CHR ROM size (8K)
.byte $00           ; Mapper 0, horizontal mirroring
.byte $00           ; No additional features

.segment "CODE"
RESET&#58;
    ; Initialize the NES
    sei             ; Disable interrupts
    cld             ; Clear decimal mode
    ldx #$FF
    txs             ; Set up stack
    
    ; Clear RAM
    lda #$00
    ldx #$00
clear_ram&#58;
    sta $0000,x
    sta $0100,x
    sta $0200,x
    sta $0300,x
    sta $0400,x
    sta $0500,x
    sta $0600,x
    sta $0700,x
    inx
    bne clear_ram
    
    ; Wait for PPU to be ready
    bit $2002
vblankwait1&#58;
    bit $2002
    bpl vblankwait1
vblankwait2&#58;
    bit $2002
    bpl vblankwait2
    
    ; Set background color
    lda #$3F
    sta $2006       ; PPU address high
    lda #$00
    sta $2006       ; PPU address low
    lda #$30        ; Light blue
    sta $2007       ; Write to PPU
    
    ; Enable rendering
    lda #%10000000  ; Enable NMI
    sta $2000
    lda #%00001000  ; Enable background
    sta $2001
    
infinite_loop&#58;
    jmp infinite_loop

NMI&#58;
IRQ&#58;
    rti

.segment "VECTORS"
.word NMI
.word RESET
.word IRQ

.segment "CHR"
.incbin "hello.chr"  ; 8K of CHR data (can be all zeros for this test)</code></pre>
						</div>
						<div class="bg-black rounded-lg p-4">
							<p class="text-orange-200 text-sm mb-2">hello.cfg:</p>
							<pre class="text-green-400 text-sm overflow-x-auto"><code>MEMORY {
    ZP:     start = $00,    size = $0100, type = rw, file = "";
    RAM:    start = $0200,  size = $0600, type = rw, file = "";
    HDR:    start = $0000,  size = $0010, type = ro, file = %O, fill = yes;
    PRG:    start = $8000,  size = $8000, type = ro, file = %O, fill = yes;
    CHR:    start = $0000,  size = $2000, type = ro, file = %O, fill = yes;
}

SEGMENTS {
    HEADER:   load = HDR, type = ro;
    CODE:     load = PRG, type = ro, start = $8000;
    VECTORS:  load = PRG, type = ro, start = $FFFA;
    CHR:      load = CHR, type = ro;
}</code></pre>
						</div>
					</div>
					
					<div class="mb-4">
						<p class="text-orange-100 mb-3">Assemble and run:</p>
						<div class="bg-black rounded-lg p-4">
							<pre class="text-green-400 text-sm overflow-x-auto"><code># Create empty CHR file
dd if=/dev/zero of=hello.chr bs=8192 count=1

# Assemble the program
ca65 hello.s -o hello.o

# Link to create NES ROM
ld65 -C hello.cfg hello.o -o hello.nes

# Run in Mesen emulator
mesen hello.nes</code></pre>
						</div>
					</div>
					
