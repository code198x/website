<script>
	// System selection functionality
	document.addEventListener('DOMContentLoaded', function() {
		const systemButtons = document.querySelectorAll('.system-btn');
		const setupSections = document.querySelectorAll('.setup-section');
		const setupContent = document.getElementById('setup-content');

		systemButtons.forEach(button => {
			button.addEventListener('click', function() {
				const system = this.dataset.system;
				
				// Hide all sections
				setupSections.forEach(section => {
					section.classList.add('hidden');
				});
				
				// Hide default content
				setupContent.style.display = 'none';
				
				// Show selected section
				const selectedSection = document.getElementById(`${system}-setup`);
				if (selectedSection) {
					selectedSection.classList.remove('hidden');
				}
				
				// Update button states
				systemButtons.forEach(btn => {
					btn.classList.remove('ring-2', 'ring-white');
				});
				this.classList.add('ring-2', 'ring-white');
			});
		});
	});
</script>