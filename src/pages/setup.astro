---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

// Get all setup guides
const setupGuides = await getCollection('setup');
const sortedSetupGuides = setupGuides.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Development Setup - Code Like It's 198x">
	<Breadcrumb segments={[{ text: 'Setup', href: '/setup' }]} />
	
	<div class="max-w-6xl mx-auto px-4 py-8">
		<header class="text-center mb-12">
			<h1 class="text-4xl font-bold text-green-400 mb-4">
				Development Environment Setup
			</h1>
			<p class="text-xl text-gray-300 max-w-4xl mx-auto">
				Get your development environment ready for authentic retro assembly programming. 
				Choose your system and follow our comprehensive Docker-based setup guide.
			</p>
		</header>

		<!-- System Selection -->
		<div class="bg-gray-800 rounded-lg p-6 mb-8">
			<h2 class="text-2xl font-bold text-green-400 mb-4">Choose Your System</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
				{sortedSetupGuides.map((guide) => (
					<button 
						class="system-btn bg-blue-600 hover:bg-blue-500 text-white p-4 rounded-lg transition-colors" 
						data-system={guide.data.system}
					>
						<div class="text-2xl mb-2">
							{guide.data.system === 'commodore-64' && '💾'}
							{guide.data.system === 'zx-spectrum' && '🖥️'}
							{guide.data.system === 'commodore-amiga' && '🎨'}
							{guide.data.system === 'nintendo-entertainment-system' && '🎮'}
						</div>
						<div class="font-bold">{guide.data.title.replace(' Development Setup', '')}</div>
						<div class="text-sm opacity-75">
							{guide.data.system === 'commodore-64' && '6502 Assembly'}
							{guide.data.system === 'zx-spectrum' && 'Z80 Assembly'}
							{guide.data.system === 'commodore-amiga' && '68000 Assembly'}
							{guide.data.system === 'nintendo-entertainment-system' && '6502 Assembly'}
						</div>
					</button>
				))}
			</div>
		</div>

		<!-- Setup Content -->
		<div id="setup-content">
			<!-- Default content -->
			<div class="text-center text-gray-400 py-12">
				<div class="text-4xl mb-4">👆</div>
				<p class="text-xl">Select a system above to see setup instructions</p>
			</div>
		</div>

		<!-- Dynamic Setup Guides -->
		{sortedSetupGuides.map(async (guide) => {
			const { Content } = await guide.render();
			const systemClass = guide.data.system === 'commodore-64' ? 'bg-blue-900' : 
							   guide.data.system === 'zx-spectrum' ? 'bg-purple-900' :
							   guide.data.system === 'commodore-amiga' ? 'bg-red-900' : 'bg-orange-900';
			
			return (
				<div id={`${guide.data.system}-setup`} class="setup-section hidden">
					<div class={`${systemClass} rounded-lg p-8 mb-8`}>
						<div class="prose prose-lg max-w-none prose-invert">
							<Content />
						</div>
					</div>
				</div>
			);
		})}

		<!-- Quick Links -->
		<div class="bg-green-900 rounded-lg p-8">
			<h2 class="text-2xl font-bold text-green-200 mb-4">Start Learning</h2>
			<p class="text-green-100 mb-6">
				Once you've set up your development environment, you're ready to start learning!
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
				<a href="/lessons/commodore-64/phase-1/tier-1" class="bg-blue-600 hover:bg-blue-500 text-white p-4 rounded-lg transition-colors text-center">
					<div class="text-2xl mb-2">💾</div>
					<div class="font-bold">C64 Lessons</div>
					<div class="text-sm opacity-75">Start Phase 1</div>
				</a>
				<a href="/lessons/zx-spectrum/phase-1/tier-1" class="bg-purple-600 hover:bg-purple-500 text-white p-4 rounded-lg transition-colors text-center">
					<div class="text-2xl mb-2">🖥️</div>
					<div class="font-bold">ZX Spectrum Lessons</div>
					<div class="text-sm opacity-75">Start Phase 1</div>
				</a>
				<a href="/lessons/commodore-amiga/phase-1/tier-1" class="bg-red-600 hover:bg-red-500 text-white p-4 rounded-lg transition-colors text-center">
					<div class="text-2xl mb-2">🎨</div>
					<div class="font-bold">Amiga Lessons</div>
					<div class="text-sm opacity-75">Start Phase 1</div>
				</a>
				<a href="/lessons/nintendo-entertainment-system/phase-1/tier-1" class="bg-orange-600 hover:bg-orange-500 text-white p-4 rounded-lg transition-colors text-center">
					<div class="text-2xl mb-2">🎮</div>
					<div class="font-bold">NES Lessons</div>
					<div class="text-sm opacity-75">Start Phase 1</div>
				</a>
			</div>
		</div>
	</div>
</Layout>

<script>
	// System selection functionality
	document.addEventListener('DOMContentLoaded', function() {
		const systemButtons = document.querySelectorAll('.system-btn');
		const setupSections = document.querySelectorAll('.setup-section');
		const setupContent = document.getElementById('setup-content');

		systemButtons.forEach(button => {
			button.addEventListener('click', function() {
				const system = this.dataset.system;
				
				// Hide all sections
				setupSections.forEach(section => {
					section.classList.add('hidden');
				});
				
				// Hide default content
				setupContent.style.display = 'none';
				
				// Show selected section
				const selectedSection = document.getElementById(system + '-setup');
				if (selectedSection) {
					selectedSection.classList.remove('hidden');
				}
				
				// Update button states
				systemButtons.forEach(btn => {
					btn.classList.remove('ring-2', 'ring-white');
				});
				this.classList.add('ring-2', 'ring-white');
			});
		});
	});
</script>