---
/**
 * Who this is for — /who-this-is-for
 *
 * An honest audience router. Code Like It's 198x means something different to a
 * complete beginner, a seasoned engineer chasing the metal, a teacher, or someone
 * here purely for the romance of the era. This page sorts those readers into
 * recognisable doorways, each pointing at a real path — or honestly marked as a
 * door we're still building. Visible gaps are deliberate: we'd rather show the
 * gap than fabricate a destination. Honest-gap cards use the dashed "soon"
 * treatment (the family's not-ready idiom, also on the fleet stub pages).
 */
import Layout from '../layouts/Layout.astro';

interface DoorLink {
  href: string;
  label: string;
  primary?: boolean;
}
interface Door {
  audiences: string;
  title: string;
  body: string;
  links?: DoorLink[];
  soon?: string;
  gap?: boolean;
}

const doors: Door[] = [
  {
    audiences: 'Absolute beginners · lapsed coders',
    title: 'Never written a line of code',
    body:
      "You don't need to know anything yet. We start with the ideas every program is built " +
      'from — instructions in order, a variable that remembers, a loop, a decision — in plain ' +
      'terms first, then running on a real Spectrum. Wrote a little BASIC decades ago and lost ' +
      "it? Pick the thread back up; it comes back faster than you'd think.",
    links: [
      { href: '/curriculum', label: 'See the whole map', primary: true },
      { href: '/foundations', label: 'Then start with the foundations' },
      { href: '/craft', label: 'Then learn the game craft' },
      { href: '/sinclair-zx-spectrum/basic', label: 'Then a BASIC machine' },
    ],
  },
  {
    audiences: 'Experienced developers · the abstraction-curious',
    title: 'You know how to code — show me the machine',
    body:
      'You can already build things. Now meet the hardware with nothing in the way — registers, ' +
      'memory maps, the raster racing down the screen. Assembly, on a machine small enough to ' +
      'hold in your head.',
    links: [
      { href: '/from-the-metal', label: 'Read From the Metal', primary: true },
      { href: '/sinclair-zx-spectrum/assembly', label: 'ZX Spectrum · Z80' },
      { href: '/commodore-64/assembly', label: 'Commodore 64 · 6502' },
      { href: '/systems', label: 'Every machine' },
    ],
  },
  {
    audiences: 'CS students · the self-taught',
    title: 'The fundamentals school skipped',
    body:
      'The stack, addressing, what a pointer really is, why a loop costs what it costs — the ' +
      'groundwork that makes everything built on top of it make sense. Taught from the machine ' +
      'up, not the framework down.',
    links: [
      { href: '/curriculum', label: 'See the whole map', primary: true },
      { href: '/foundations', label: 'Start with the foundations' },
      { href: '/craft', label: 'Then the cross-machine craft' },
    ],
  },
  {
    audiences: 'Performance-aware · embedded engineers',
    title: 'Every cycle counts',
    body:
      "When you care exactly where the time goes, there's no sterner teacher than a 3.5 MHz " +
      'machine that punishes every wasted cycle. The instincts you build here transfer straight ' +
      'to anything tight and modern.',
    links: [
      { href: '/from-the-metal', label: 'From the Metal — count the cycles', primary: true },
      { href: '/systems', label: 'Then pick a machine' },
    ],
  },
  {
    audiences: 'Indie developers · the demoscene',
    title: 'Constraint is the craft',
    body:
      'Limits are the point. A fixed palette, a handful of sprites, a few kilobytes — constraint ' +
      'is what makes the work sing, and these machines have it in abundance. Learn the assembly, ' +
      'then raid the pattern library for techniques worked out the hard way.',
    links: [
      { href: '/demoscene', label: 'Into the demoscene', primary: true },
      { href: '/craft', label: 'Learn the cross-machine craft' },
      { href: '/systems', label: 'Pick a machine, learn the assembly' },
      { href: '/patterns', label: 'Raid the pattern library' },
    ],
  },
  {
    audiences: 'Retro enthusiasts',
    title: 'For the romance of the era',
    body:
      "Maybe you're not here to write code at all — you're here for the machines, the people, and " +
      'the world that made them. The Vault is the connective tissue; the Timeline sets it all ' +
      'against everything else that was happening.',
    links: [
      { href: '/vault', label: 'Open the Vault', primary: true },
      { href: '/timeline', label: 'Walk the Timeline' },
    ],
  },
  {
    audiences: 'Parents · educators',
    title: 'For parents and teachers',
    body:
      'Sitting beside a curious child, or bringing a classroom along? You don\'t need to be a ' +
      'programmer either. Here\'s what a learner actually does, why it\'s substance not screen-filler, ' +
      'and an honest word on what setting up involves.',
    links: [
      { href: '/teaching', label: 'The guide for parents and teachers', primary: true },
      { href: '/curriculum', label: 'See the curriculum map' },
      { href: '/foundations', label: 'Start from nothing, together' },
    ],
  },
  {
    audiences: 'Schools · institutions',
    title: 'For schools and institutions',
    body:
      'Everything here is free, and openly licensed — Creative Commons for the prose, MIT for the ' +
      'code. Use it, fork it, build on it. The teaching guide covers the real curriculum structure, ' +
      'how to sequence it, and an honest statement of what exists to adopt today.',
    links: [
      { href: '/teaching#institutions', label: 'Adopting it for a course', primary: true },
      { href: '/curriculum', label: 'See the curriculum map' },
      { href: '/about', label: 'The licences and the why' },
      { href: '/contribute', label: 'How the work happens' },
    ],
  },
  {
    audiences: 'Funders · press',
    title: 'For funders and press',
    body:
      'One person, an enormous ambition, built entirely in the open. The About page tells the ' +
      'why; the family page shows the wider toolchain this sits inside.',
    links: [
      { href: '/press', label: 'The press brief', primary: true },
      { href: '/about', label: 'Read the story' },
      { href: '/family', label: 'The 198x family' },
    ],
  },
];
---

<Layout
  title="Who this is for"
  description="Find your way in. Code Like It's 198x means something different to a complete beginner, a seasoned engineer, a teacher, or someone here for the romance of the era — this is the honest router that points each one at the right door."
>
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Find your way in</p>
      <h1>Who this is for.</h1>
      <div class="herorule"></div>
      <p class="lede">Code Like It's 198x means something different depending on who's reading. A
        complete beginner, a seasoned engineer chasing the metal, a teacher, someone here purely for
        the romance of the era — all welcome, by different doors. Find the <span class="mk">one that
        sounds like you</span> — each leads somewhere real. If you want the route before the
        door, start with the <a href="/curriculum">Curriculum Map</a>.</p>
    </div>

    <div class="doors">
      {doors.map((d) => (
        <div class={`door${d.gap ? ' gap' : ''}`}>
          {d.gap && <span class="soon-badge">Coming soon</span>}
          <p class="aud">{d.audiences}</p>
          <h2>{d.title}</h2>
          <p class="body">{d.body}</p>
          {d.links && d.links.length > 0 && (
            <div class="acts">
              {d.links.map((l) => (
                <a href={l.href} class={`act${l.primary ? ' primary' : ''}`}>{l.label} →</a>
              ))}
            </div>
          )}
          {d.soon && <p class="note">{d.soon}</p>}
        </div>
      ))}
    </div>

    <p class="foot">Or skip the doors and <a href="/curriculum">open the curriculum map</a>, then <a href="/systems">browse the machines</a> directly — by era, region, maker or readiness. Still not sure? <a href="/about">Read the longer story</a>, or <a href="/contribute">come and help build the doors that aren't open yet</a>.</p>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }

  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .lede a { color: var(--ink); font-weight: 700; }

  .doors { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .door {
    position: relative;
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .door:hover, .door:focus-within { transform: translate(-4px, -4px); box-shadow: var(--shadow-chunky-hi); }
  /* Honest gap: dashed border + muted surface — the "soon"/not-ready idiom. */
  .door.gap { border-style: dashed; border-color: var(--color-border); box-shadow: none; background: var(--color-bg-secondary); }
  .door.gap:hover, .door.gap:focus-within { transform: none; box-shadow: none; }

  .soon-badge {
    position: absolute; top: var(--space-4); right: var(--space-4);
    font-family: var(--font-family-mono); font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 2px solid var(--color-border); padding: 3px 7px;
  }

  .aud { font-family: var(--font-family-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; padding-right: 6rem; }
  .door h2 { font-family: var(--font-family-script); font-weight: 700; font-size: 1.85rem; line-height: 0.98; margin: var(--space-2) 0 0; color: var(--color-text); }
  .door .body { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: var(--space-3) 0 0; }

  .acts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: auto; padding-top: var(--space-4); }
  .act { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; border-bottom: 2px solid transparent; transition: color var(--transition-base), border-color var(--transition-base); }
  .act:hover, .act:focus-visible { color: var(--color-house-2); border-bottom-color: var(--color-house-2); }
  .act.primary { color: var(--ink); font-weight: 800; }
  .act.primary:hover, .act.primary:focus-visible { color: var(--color-house-2); border-bottom-color: var(--color-house-2); }

  .note { margin: var(--space-4) 0 0; padding-top: var(--space-3); border-top: 1px dashed var(--color-border); font-size: 0.78rem; font-style: italic; color: var(--color-text-muted); }
  .door.gap .note { border-top: 0; padding-top: var(--space-4); margin-top: auto; }

  .foot { margin-top: var(--space-12); font-size: 0.92rem; color: var(--color-text-secondary); }
  .foot a { color: var(--ink); font-weight: 600; }

  @media (max-width: 860px) { .doors { grid-template-columns: 1fr; } }
</style>
