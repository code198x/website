---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const patternEntries = await getCollection('patterns');

  return patternEntries.map((entry) => {
    return {
      params: { slug: entry.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Platform display names and colours
const platformInfo = {
  'commodore-64': { name: 'Commodore 64', color: 'var(--c64-blue)' },
  'sinclair-zx-spectrum': { name: 'ZX Spectrum', color: 'var(--zx-magenta)' },
  'commodore-amiga': { name: 'Commodore Amiga', color: 'var(--amiga-orange)' },
  'nintendo-nes': { name: 'NES', color: 'var(--nes-red)' },
  'cross-platform': { name: 'Cross-Platform', color: 'var(--color-primary)' },
};

// Category display names
const categoryInfo = {
  rendering: { name: 'Rendering' },
  input: { name: 'Input' },
  audio: { name: 'Audio' },
  physics: { name: 'Physics' },
  ai: { name: 'AI' },
  framework: { name: 'Framework' },
};

// Difficulty badges
const difficultyInfo = {
  beginner: { label: 'Beginner', color: 'var(--color-success, #22c55e)' },
  intermediate: { label: 'Intermediate', color: 'var(--color-warning, #f59e0b)' },
  advanced: { label: 'Advanced', color: 'var(--color-error, #ef4444)' },
};

const platform = platformInfo[entry.data.platform];
const category = categoryInfo[entry.data.category];
const difficulty = difficultyInfo[entry.data.difficulty];
---

<Layout title={`${entry.data.title} | Pattern Library`} description={entry.data.summary}>
  <article class="pattern-entry">
    <a href="/patterns" class="back-link">← Back to Pattern Library</a>

    <header class="header">
      <div class="meta-row">
        <a href={`/patterns/platform/${entry.data.platform}`} class="platform-badge" style={`--platform-color: ${platform.color}`}>
          {platform.name}
        </a>
        <a href={`/patterns/category/${entry.data.category}`} class="category-badge">
          {category.name}
        </a>
        <a href={`/patterns/difficulty/${entry.data.difficulty}`} class="difficulty-badge" style={`--difficulty-color: ${difficulty.color}`}>
          {difficulty.label}
        </a>
      </div>

      <h1 class="title">{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>

      <div class="tags">
        {entry.data.taught_in && (
          <span class="tag taught">Taught in {entry.data.taught_in}</span>
        )}
        {entry.data.tags?.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </header>

    <div class="content">
      <Content />
    </div>
  </article>

  <style define:vars={{ platformColor: platform.color }}>
    .pattern-entry {
      max-width: 900px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .back-link {
      display: inline-block;
      margin-bottom: var(--space-6);
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--color-primary); }

    .header {
      margin-bottom: var(--space-8);
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--color-border);
    }

    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }

    .platform-badge {
      display: inline-flex;
      align-items: center;
      padding: var(--space-1) var(--space-3);
      background: color-mix(in oklab, var(--platform-color) 15%, var(--color-surface) 85%);
      border: 1px solid var(--platform-color);
      color: var(--platform-color);
      border-radius: 0.25rem;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: all var(--transition-base);
    }

    .platform-badge:hover {
      background: color-mix(in oklab, var(--platform-color) 25%, var(--color-surface) 75%);
    }

    .category-badge {
      display: inline-flex;
      align-items: center;
      padding: var(--space-1) var(--space-3);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      font-size: 0.8rem;
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: all var(--transition-base);
    }

    .category-badge:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    .difficulty-badge {
      display: inline-flex;
      align-items: center;
      padding: var(--space-1) var(--space-3);
      background: color-mix(in oklab, var(--difficulty-color) 15%, var(--color-surface) 85%);
      border: 1px solid var(--difficulty-color);
      color: var(--difficulty-color);
      border-radius: 0.25rem;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: all var(--transition-base);
    }

    .difficulty-badge:hover {
      background: color-mix(in oklab, var(--difficulty-color) 25%, var(--color-surface) 75%);
    }

    .title {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      margin: 0 0 var(--space-3) 0;
      line-height: 1.2;
    }

    .summary {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-4) 0;
      line-height: 1.6;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .tag {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      padding: var(--space-1) var(--space-3);
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    .tag.taught {
      background: color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%);
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    /* Content styling */
    .content :global(h2) {
      font-size: 1.5rem;
      margin-top: var(--space-8);
      margin-bottom: var(--space-4);
      color: var(--color-text);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-2);
    }

    .content :global(h3) {
      font-size: 1.125rem;
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
    }

    .content :global(p) {
      margin-bottom: var(--space-4);
      line-height: 1.7;
    }

    .content :global(pre) {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--platformColor);
      border-radius: 0.5rem;
      padding: var(--space-4);
      overflow-x: auto;
      margin: var(--space-4) 0;
      font-size: 0.875rem;
    }

    .content :global(code) {
      font-family: var(--font-family-mono);
      font-size: 0.9em;
    }

    .content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--space-4) 0;
    }

    .content :global(th),
    .content :global(td) {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      text-align: left;
    }

    .content :global(th) {
      background: var(--color-surface);
      font-weight: 600;
    }

    .content :global(strong) {
      color: var(--color-text);
    }

    .content :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
    }

    .content :global(a:hover) {
      color: var(--color-accent);
    }

    @media (max-width: 768px) {
      .pattern-entry { padding: var(--space-6) var(--space-4); }
    }
  </style>
</Layout>
