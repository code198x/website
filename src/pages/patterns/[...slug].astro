---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPlatformsForPatternLibrary } from '../../lib/platforms';
import Chip from '@198x-ui/components/Chip.astro';

export async function getStaticPaths() {
  const patternEntries = await getCollection('patterns');

  return patternEntries.map((entry) => {
    return {
      params: { slug: entry.id },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Build platform lookup from collection
const platformsList = await getPlatformsForPatternLibrary();
const platformInfo = Object.fromEntries(
  platformsList.map(p => [p.slug, { name: p.name, color: p.color }])
);

// Category display names
const categoryInfo = {
  rendering: { name: 'Rendering' },
  input: { name: 'Input' },
  audio: { name: 'Audio' },
  physics: { name: 'Physics' },
  ai: { name: 'AI' },
  framework: { name: 'Framework' },
};

// Difficulty labels. No colour: a chip never takes one of its own (the kit's
// Chip, family-visual-identity.md §3 and §7), so the word carries the level.
const difficultyInfo = {
  beginner: { label: 'Beginner' },
  intermediate: { label: 'Intermediate' },
  advanced: { label: 'Advanced' },
};

const platform = platformInfo[entry.data.platform];
const category = categoryInfo[entry.data.category];
const difficulty = difficultyInfo[entry.data.difficulty];

// Custom breadcrumbs
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Patterns', href: '/patterns' },
  { label: platform.name, href: `/patterns/platform/${entry.data.platform}` },
  { label: category.name, href: `/patterns/category/${entry.data.category}` },
  { label: entry.data.title }
];
---

<Layout title={`${entry.data.title} | Pattern Library`} description={entry.data.summary} breadcrumbs={breadcrumbs}>
  <!-- Hero Section -->
  <div class="directory-heading">
    <PageHeader title={entry.data.title} description={entry.data.summary}>
      <ul class="meta-row" aria-label="About this pattern">
        <li><Chip href={`/patterns/platform/${entry.data.platform}`}>{platform.name}</Chip></li>
        <li><Chip href={`/patterns/category/${entry.data.category}`}>{category.name}</Chip></li>
        <li><Chip href={`/patterns/difficulty/${entry.data.difficulty}`}>{difficulty.label}</Chip></li>
      </ul>
      {entry.data.taught_in && (
        <p class="taught-in">Taught in {entry.data.taught_in}</p>
      )}
      {entry.data.tags?.length > 0 && (
        <ul class="hero-tags" aria-label="Tags">
          {entry.data.tags.map((t) => (
            <li><Chip>{t}</Chip></li>
          ))}
        </ul>
      )}
    </PageHeader>
  </div>

  <article class="pattern-entry">
    <div class="content">
      <Content />
    </div>
  </article>

  <style define:vars={{ platformColor: platform.color }}>
    /* Hero Section */

    /* Hero Effects Container */

    /* Animated Floating Shapes */
    .hero-shape {
      position: absolute;
      border-radius: 50%;
      background: var(--accent-color);
      opacity: 0.15;
      filter: blur(40px);
    }

    /* Grid Overlay */

    /* Scanlines */

    /* Animated Beam */

    @media (prefers-reduced-motion: reduce) {
      .hero-shape,
      .hero-beam {
        animation: none;
      }
    }

    /* The pattern's platform, category and level, then its tags: the kit's
       Chip, which follows the paper theme. */
    .meta-row,
    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--h-cell);
      margin: var(--space-4) 0;
      padding: 0;
      list-style: none;
    }

    .taught-in {
      margin: 0 0 var(--space-4);
      color: var(--h-ink-body);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-micro);
      line-height: var(--h-lh-micro);
    }

    /* Article Content */
    .pattern-entry {
      max-width: 900px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4) var(--space-12);
    }

    /* Content styling */
    .content :global(h2) {
      font-size: 1.5rem;
      margin-top: var(--space-8);
      margin-bottom: var(--space-4);
      color: var(--color-text);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-2);
    }

    .content :global(h2:first-child) {
      margin-top: 0;
    }

    .content :global(h3) {
      font-size: 1.125rem;
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
    }

    .content :global(p) {
      margin-bottom: var(--space-4);
      line-height: 1.7;
    }

    .content :global(pre) {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--platformColor);
      border-radius: 0;
      padding: var(--space-4);
      overflow-x: auto;
      margin: var(--space-4) 0;
      font-size: 0.875rem;
    }

    .content :global(code) {
      font-family: var(--font-family-mono);
      font-size: 0.9em;
    }

    .content :global(ul),
    .content :global(ol) {
      margin-bottom: var(--space-4);
      padding-left: var(--space-6);
    }

    .content :global(li) {
      margin-bottom: var(--space-2);
      line-height: 1.6;
    }

    .content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--space-4) 0;
    }

    .content :global(th),
    .content :global(td) {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      text-align: left;
    }

    .content :global(th) {
      background: var(--color-surface);
      font-weight: 600;
    }

    .content :global(strong) {
      color: var(--color-text);
    }

    .content :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
    }

    .content :global(a:hover) {
      color: var(--color-accent);
    }

    @media (max-width: 768px) {
      .pattern-entry {
        padding: var(--space-6) var(--space-4);
      }
    }

    /* --- synthesis hero override (paper/ink, no neon decoration) --- */
    .hero-subtitle, .hero-description { color: var(--color-text-secondary); opacity: 1; }
    .stat-value { color: var(--color-house-2); }
    .stat-label { color: var(--color-text-secondary); opacity: 1; }
  </style>
</Layout>
