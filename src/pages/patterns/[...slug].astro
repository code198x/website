---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PatternExample from '../../components/PatternExample.astro';
import { getPlatformsForPatternLibrary, getPlatformBySlug, getSpotColour } from '../../lib/platforms';
import { getPatternCategories } from '../../lib/categories';
import '../../styles/pattern-library.css';
export async function getStaticPaths() {
  return (await getCollection('patterns')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const platform=(await getPlatformsForPatternLibrary()).find(p=>p.slug===entry.data.platform)!;
const category=(await getPatternCategories()).find(c=>c.id===entry.data.category)!;
const machine=await getPlatformBySlug(entry.data.platform==='nintendo-nes'?'nintendo-entertainment-system':entry.data.platform);
const language=entry.id.includes('/assembly/')?'Assembly':entry.id.includes('/basic/')?'BASIC':'Shared technique';
const progressBar=entry.id==='sinclair-zx-spectrum/basic/rendering/progress-bar';
const breadcrumbs=[{label:'Home',href:'/'},{label:'Patterns',href:'/patterns/'},{label:platform.name,href:`/patterns/platform/${platform.slug}/`},{label:entry.data.title}];
---
<Layout title={`${entry.data.title} | Pattern Library`} description={entry.data.summary} breadcrumbs={breadcrumbs} spotColor={getSpotColour(machine)} masthead={false}>
  <div class="pattern-reading">
    <header class:list={['pattern-reading-header',{'with-example':progressBar}]}>
      <div><h1>{entry.data.title}</h1><p class="pattern-summary">{entry.data.summary}</p><ul class="pattern-reading-meta"><li><a href={`/patterns/platform/${platform.slug}/`}>{platform.name}</a></li><li>{language}</li><li><a href={`/patterns/category/${category.id}/`}>{category.data.name}</a></li><li><a href={`/patterns/difficulty/${entry.data.difficulty}/`}>{entry.data.difficulty}</a></li></ul></div>
      {progressBar && <PatternExample/>}
    </header>
    <div class="pattern-reading-grid">
      <aside class="pattern-contents"><TableOfContents selector=".pattern-prose" platformColor="var(--h-spot-ink)"/></aside>
      <article class="pattern-prose"><Content/></article>
      <aside class="pattern-reading-notes"><h2>Using this pattern</h2><p>Read the requirements and trade-offs before fitting the code into your game.</p>{language==='Assembly' && <p><a href="https://github.com/asm198x/asm198x">Asm198x</a> is our assembler and disassembler. These examples use different source dialects; check the listing’s syntax and your <a href="/setup/">machine’s setup guide</a>.</p>}<p><a href={`/patterns/platform/${platform.slug}/`}>More {platform.name} patterns</a></p><p><a href="/start-here/">Build a complete game with the lessons</a></p></aside>
    </div>
  </div>
</Layout>
