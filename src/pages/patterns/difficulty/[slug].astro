---
import Layout from '../../../layouts/Layout.astro';
import PatternDirectory from '../../../components/PatternDirectory.astro';
import { getPatternDifficulties } from '../../../lib/categories';

import '../../../styles/pattern-library.css';
export async function getStaticPaths() {
  return (await getPatternDifficulties()).map(item => ({ params: { slug: item.id }, props: { name: item.data.name } }));
}
const {slug} = Astro.params;
const {name} = Astro.props;
const spotColor = undefined;
const breadcrumbs = [{label:'Home',href:'/'},{label:'Patterns',href:'/patterns/'},{label:name}];
---
<Layout title={`${name} patterns`} description={`Explore ${name} patterns and narrow your search by machine, subject and difficulty.`} breadcrumbs={breadcrumbs} spotColor={spotColor} masthead={false}>
  <div class="pattern-library">
    <header class="pattern-facet-heading"><h1>{name} patterns.</h1><p>Find a technique, check its conditions, and adapt it to your game.</p><a href="/patterns/">Back to the Pattern Library</a></header>
    <PatternDirectory difficulty={slug}/>
  </div>
</Layout>
