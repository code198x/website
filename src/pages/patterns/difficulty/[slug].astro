---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DynamicIcon from '../../../components/DynamicIcon.astro';
import { getPlatformsForPatternLibrary } from '../../../lib/platforms';
import { getPatternCategories, getPatternDifficulties } from '../../../lib/categories';
import { inkStyle } from '../../../lib/contrast';

// Get data from collections
const difficultiesData = await getPatternDifficulties();
const categoriesData = await getPatternCategories();
const platforms = await getPlatformsForPatternLibrary();

// Map to format expected by template
const difficulties = difficultiesData.map(d => ({
  slug: d.id,
  name: d.data.name,
  desc: d.data.description,
  icon: d.data.icon,
  color: d.data.color,
}));

const categories = categoriesData.map(c => ({
  slug: c.id,
  name: c.data.name,
}));

export async function getStaticPaths() {
  const { getPatternDifficulties } = await import('../../../lib/categories');
  const difficulties = await getPatternDifficulties();
  return difficulties.map(d => ({ params: { slug: d.id } }));
}

const { slug } = Astro.params;
const difficulty = difficulties.find(d => d.slug === slug);

if (!difficulty) {
  return Astro.redirect('/patterns');
}

// Get all patterns at this difficulty
const allPatterns = await getCollection('patterns');
const difficultyPatterns = allPatterns.filter(p => p.data.difficulty === slug);

// Group by platform
const patternsByPlatform = difficultyPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof difficultyPatterns>);

// Sort patterns within each platform by category, then title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category.localeCompare(b.data.category);
    }
    return a.data.title.localeCompare(b.data.title);
  });
});

const difficultyIcon = difficulty.icon;

// Custom breadcrumbs
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Patterns', href: '/patterns' },
  { label: difficulty.name }
];
---

<Layout
  title={`${difficulty.name} Patterns`}
  description={`${difficulty.desc} — production-ready code patterns for retro game development.`}
  breadcrumbs={breadcrumbs}
>
  <style define:vars={{ difficultyColor: difficulty.color }}>
    /* Hero Animations */

    /* Hero Section */

    /* Animated shapes container */

    /* Grid overlay */

    /* Scanlines effect */

    /* Animated beam effect */

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--difficultyColor);
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Reduced motion support */

    /* Content Section */
    .content-section {
      padding: var(--space-8) var(--space-4) var(--space-12);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    /* Platform Sections */
    .platform-section {
      margin-bottom: var(--space-10);
    }

    .platform-header {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .platform-name {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: 700;
    }

    .platform-count {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    /* Pattern Grid */
    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-4);
    }

    .pattern-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      position: relative;
      overflow: hidden;
    }

    .pattern-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--platform-color, var(--color-primary));
      transform: scaleX(0);
      transition: transform var(--transition-base);
    }

    .pattern-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-chunky);
      border-color: var(--platform-color, var(--color-primary));
    }

    .pattern-card:hover::before {
      transform: scaleX(1);
    }

    .pattern-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-3);
    }

    .pattern-platform {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pattern-category {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0;
      color: var(--color-text-secondary);
    }

    .pattern-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .pattern-summary {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0;
      padding: var(--space-12);
      text-align: center;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Other Difficulties */
    .other-difficulties {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .other-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .difficulty-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--space-4);
    }

    .difficulty-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .difficulty-link:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-chunky);
    }

    .difficulty-link .diff-icon {
      flex-shrink: 0;
    }

    .difficulty-link .diff-info {
      flex: 1;
    }

    .difficulty-link .diff-name {
      font-weight: 600;
      display: block;
    }

    .difficulty-link .diff-count {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .pattern-grid {
        grid-template-columns: 1fr;
      }

      .difficulty-grid {
        grid-template-columns: 1fr;
      }
    }

    /* --- synthesis hero override (paper/ink, no neon decoration) --- */
    .hero-subtitle, .hero-description { color: var(--color-text-secondary); opacity: 1; }
    .stat-value { color: var(--color-house-2); }
    .stat-label { color: var(--color-text-secondary); opacity: 1; }
  </style>

  <!-- Hero -->
  <div class="directory-heading">
    <PageHeader title={`${difficulty.name} Patterns`} description={difficulty.desc}>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{difficultyPatterns.length}</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{Object.keys(patternsByPlatform).length}</div>
          <div class="stat-label">Platforms</div>
        </div>
      </div>
    </PageHeader>
  </div>

  <section class="content-section">
    {difficultyPatterns.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {difficulty.name} patterns yet</h2>
        <p class="empty-text">
          Patterns are being extracted from the curriculum. Check back soon or explore other difficulty levels.
        </p>
      </div>
    ) : (
      <>
        {platforms.map(platform => {
          const patterns = patternsByPlatform[platform.slug] || [];
          if (patterns.length === 0) return null;

          return (
            <section class="platform-section" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h2 class="platform-name" style={`${inkStyle(platform.color)} color: var(--ink);`}>{platform.name}</h2>
                <span class="platform-count">{patterns.length} pattern{patterns.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="pattern-grid">
                {patterns.map(pattern => (
                  <a href={`/patterns/${pattern.id}`} class="pattern-card" style={`--platform-color: ${platform.color}`}>
                    <div class="pattern-meta">
                      <span class="pattern-platform">{platform.name}</span>
                      <span class="pattern-category">
                        {categories.find(c => c.slug === pattern.data.category)?.name}
                      </span>
                    </div>
                    <h3 class="pattern-title">{pattern.data.title}</h3>
                    <p class="pattern-summary">{pattern.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </>
    )}

    <!-- Other Difficulties -->
    <div class="other-difficulties">
      <h2 class="other-title">Other Skill Levels</h2>
      <div class="difficulty-grid">
        {difficulties.filter(d => d.slug !== slug).map(diff => {
          const DiffIcon = diff.icon;
          const count = allPatterns.filter(p => p.data.difficulty === diff.slug).length;
          return (
            <a href={`/patterns/difficulty/${diff.slug}`} class="difficulty-link" style={`border-color: ${diff.color}; ${inkStyle(diff.color)}`}>
              <span class="diff-icon" style={`color: ${diff.color}`}><DiffIcon size={24} /></span>
              <span class="diff-info">
                {/* The raw difficulty colour is a chrome/border colour — as text it
                    measured 2.09-2.22:1. --ink is the theme-corrected shade. */}
                <span class="diff-name" style="color: var(--ink)">{diff.name}</span>
                <span class="diff-count">{count} pattern{count !== 1 ? 's' : ''}</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
