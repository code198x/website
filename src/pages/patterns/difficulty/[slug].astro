---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { GraduationCap, TrendingUp, Flame } from '@lucide/astro';
import { getPlatformsForPatternLibrary } from '../../../lib/platforms';

// Difficulty metadata
const difficulties = [
  { slug: 'beginner', name: 'Beginner', desc: 'Foundational patterns for those starting their retro dev journey', icon: GraduationCap, color: 'var(--color-success, #22c55e)' },
  { slug: 'intermediate', name: 'Intermediate', desc: 'More advanced techniques building on the basics', icon: TrendingUp, color: 'var(--color-warning, #f59e0b)' },
  { slug: 'advanced', name: 'Advanced', desc: 'Expert-level patterns pushing hardware to its limits', icon: Flame, color: 'var(--color-error, #ef4444)' },
];

const platforms = await getPlatformsForPatternLibrary();

const categories = [
  { slug: 'rendering', name: 'Rendering' },
  { slug: 'input', name: 'Input' },
  { slug: 'audio', name: 'Audio' },
  { slug: 'physics', name: 'Physics' },
  { slug: 'ai', name: 'AI' },
  { slug: 'framework', name: 'Framework' },
];

export async function getStaticPaths() {
  const difficulties = ['beginner', 'intermediate', 'advanced'];
  return difficulties.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const difficulty = difficulties.find(d => d.slug === slug);

if (!difficulty) {
  return Astro.redirect('/patterns');
}

// Get all patterns at this difficulty
const allPatterns = await getCollection('patterns');
const difficultyPatterns = allPatterns.filter(p => p.data.difficulty === slug);

// Group by platform
const patternsByPlatform = difficultyPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof difficultyPatterns>);

// Sort patterns within each platform by category, then title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category.localeCompare(b.data.category);
    }
    return a.data.title.localeCompare(b.data.title);
  });
});

const IconComponent = difficulty.icon;

// Custom breadcrumbs
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Patterns', href: '/patterns' },
  { label: difficulty.name }
];
---

<Layout
  title={`${difficulty.name} Patterns`}
  description={`${difficulty.desc} — production-ready code patterns for retro game development.`}
  breadcrumbs={breadcrumbs}
>
  <style define:vars={{ difficultyColor: difficulty.color }}>
    /* Hero Animations */
    @keyframes float-1 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(15px, -20px) rotate(5deg); }
      50% { transform: translate(-10px, -35px) rotate(-3deg); }
      75% { transform: translate(20px, -15px) rotate(8deg); }
    }

    @keyframes float-2 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(-20px, 15px) rotate(-8deg); }
      50% { transform: translate(15px, 25px) rotate(5deg); }
      75% { transform: translate(-25px, 10px) rotate(-5deg); }
    }

    @keyframes float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(25px, -20px) scale(1.1); }
      66% { transform: translate(-15px, 15px) scale(0.95); }
    }

    @keyframes float-4 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      50% { transform: translate(-30px, -25px) rotate(180deg); }
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.7; }
    }

    @keyframes scanline-beam {
      0% { top: -10%; }
      100% { top: 110%; }
    }

    /* Hero Section */
    .hero {
      min-height: 300px;
      background: linear-gradient(135deg,
        color-mix(in oklab, var(--difficultyColor) 20%, #1a1a2e 80%) 0%,
        color-mix(in oklab, var(--difficultyColor) 30%, #16213e 70%) 50%,
        color-mix(in oklab, var(--difficultyColor) 25%, #0f3460 75%) 100%
      );
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Animated shapes container */
    .hero-shapes {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .shape {
      position: absolute;
      opacity: 0.4;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    .shape-1 {
      top: 15%;
      left: 8%;
      width: 50px;
      height: 50px;
      border: 3px solid var(--difficultyColor);
      box-shadow: 0 0 15px var(--difficultyColor);
      animation: float-1 12s infinite, pulse-glow 4s infinite;
    }

    .shape-2 {
      top: 20%;
      right: 12%;
      width: 40px;
      height: 40px;
      border: 3px solid var(--difficultyColor);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--difficultyColor);
      animation: float-2 15s infinite, pulse-glow 5s infinite 1s;
    }

    .shape-3 {
      bottom: 20%;
      left: 15%;
      width: 35px;
      height: 35px;
      border: 3px solid var(--difficultyColor);
      transform: rotate(45deg);
      box-shadow: 0 0 12px var(--difficultyColor);
      animation: float-3 18s infinite, pulse-glow 6s infinite 2s;
    }

    .shape-4 {
      bottom: 25%;
      right: 10%;
      width: 0;
      height: 0;
      border-left: 20px solid transparent;
      border-right: 20px solid transparent;
      border-bottom: 35px solid var(--difficultyColor);
      filter: drop-shadow(0 0 10px var(--difficultyColor));
      animation: float-4 20s infinite, pulse-glow 7s infinite;
    }

    /* Grid overlay */
    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 1;
    }

    /* Scanlines effect */
    .hero-scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
      );
      pointer-events: none;
      z-index: 2;
    }

    /* Animated beam effect */
    .hero-beam {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        color-mix(in oklab, var(--difficultyColor) 10%, transparent 90%) 20%,
        color-mix(in oklab, var(--difficultyColor) 30%, transparent 70%) 50%,
        color-mix(in oklab, var(--difficultyColor) 10%, transparent 90%) 80%,
        transparent 100%
      );
      animation: scanline-beam 8s linear infinite;
      pointer-events: none;
      z-index: 3;
    }

    .hero-content {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 5;
      color: white;
      padding: var(--space-16) var(--space-4);
    }

    .hero-icon {
      color: var(--difficultyColor);
      margin-bottom: var(--space-4);
      filter: drop-shadow(0 0 8px var(--difficultyColor));
    }

    .hero-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: -0.02em;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3), 0 0 20px color-mix(in oklab, var(--difficultyColor) 30%, transparent 70%);
    }

    .hero-subtitle {
      font-size: 1.125rem;
      opacity: 0.9;
      margin-bottom: var(--space-4);
      text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--difficultyColor);
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
      .shape {
        animation: none;
      }

      .hero-beam {
        animation: none;
        opacity: 0;
      }
    }

    @media (max-width: 768px) {
      .shape {
        opacity: 0.25;
      }

      .shape-1 { width: 35px; height: 35px; }
      .shape-2 { width: 28px; height: 28px; }
      .shape-3 { width: 25px; height: 25px; }
      .shape-4 {
        border-left-width: 15px;
        border-right-width: 15px;
        border-bottom-width: 25px;
      }
    }

    /* Content Section */
    .content-section {
      padding: var(--space-8) var(--space-4) var(--space-12);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    /* Platform Sections */
    .platform-section {
      margin-bottom: var(--space-10);
    }

    .platform-header {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .platform-name {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: 700;
    }

    .platform-count {
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    /* Pattern Grid */
    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-4);
    }

    .pattern-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      position: relative;
      overflow: hidden;
    }

    .pattern-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--platform-color, var(--color-primary));
      transform: scaleX(0);
      transition: transform var(--transition-base);
    }

    .pattern-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--platform-color, var(--color-primary));
    }

    .pattern-card:hover::before {
      transform: scaleX(1);
    }

    .pattern-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-3);
    }

    .pattern-platform {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pattern-category {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      color: var(--color-text-secondary);
    }

    .pattern-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .pattern-summary {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-12);
      text-align: center;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Other Difficulties */
    .other-difficulties {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .other-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .difficulty-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--space-4);
    }

    .difficulty-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .difficulty-link:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .difficulty-link .diff-icon {
      flex-shrink: 0;
    }

    .difficulty-link .diff-info {
      flex: 1;
    }

    .difficulty-link .diff-name {
      font-weight: 600;
      display: block;
    }

    .difficulty-link .diff-count {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .pattern-grid {
        grid-template-columns: 1fr;
      }

      .difficulty-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- Hero -->
  <section class="hero">
    <!-- Animated background shapes -->
    <div class="hero-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
      <div class="shape shape-4"></div>
    </div>

    <!-- Grid overlay -->
    <div class="hero-grid"></div>

    <!-- Scanline effect -->
    <div class="hero-scanlines"></div>

    <!-- Animated beam -->
    <div class="hero-beam"></div>

    <div class="hero-content">
      <div class="hero-icon"><IconComponent size={48} /></div>
      <h1 class="hero-title">{difficulty.name} Patterns</h1>
      <p class="hero-subtitle">{difficulty.desc}</p>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{difficultyPatterns.length}</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{Object.keys(patternsByPlatform).length}</div>
          <div class="stat-label">Platforms</div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section">
    {difficultyPatterns.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {difficulty.name} patterns yet</h2>
        <p class="empty-text">
          Patterns are being extracted from the curriculum. Check back soon or explore other difficulty levels.
        </p>
      </div>
    ) : (
      <>
        {platforms.map(platform => {
          const patterns = patternsByPlatform[platform.slug] || [];
          if (patterns.length === 0) return null;

          return (
            <section class="platform-section" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h2 class="platform-name" style={`color: ${platform.color}`}>{platform.name}</h2>
                <span class="platform-count">{patterns.length} pattern{patterns.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="pattern-grid">
                {patterns.map(pattern => (
                  <a href={`/patterns/${pattern.slug}`} class="pattern-card" style={`--platform-color: ${platform.color}`}>
                    <div class="pattern-meta">
                      <span class="pattern-platform">{platform.name}</span>
                      <span class="pattern-category">
                        {categories.find(c => c.slug === pattern.data.category)?.name}
                      </span>
                    </div>
                    <h3 class="pattern-title">{pattern.data.title}</h3>
                    <p class="pattern-summary">{pattern.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </>
    )}

    <!-- Other Difficulties -->
    <div class="other-difficulties">
      <h2 class="other-title">Other Skill Levels</h2>
      <div class="difficulty-grid">
        {difficulties.filter(d => d.slug !== slug).map(diff => {
          const DiffIcon = diff.icon;
          const count = allPatterns.filter(p => p.data.difficulty === diff.slug).length;
          return (
            <a href={`/patterns/difficulty/${diff.slug}`} class="difficulty-link" style={`border-color: ${diff.color}`}>
              <span class="diff-icon" style={`color: ${diff.color}`}><DiffIcon size={24} /></span>
              <span class="diff-info">
                <span class="diff-name" style={`color: ${diff.color}`}>{diff.name}</span>
                <span class="diff-count">{count} pattern{count !== 1 ? 's' : ''}</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
