---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { GraduationCap, TrendingUp, Flame } from '@lucide/astro';

// Difficulty metadata
const difficulties = [
  { slug: 'beginner', name: 'Beginner', desc: 'Foundational patterns for those starting their retro dev journey', icon: GraduationCap, color: 'var(--color-success, #22c55e)' },
  { slug: 'intermediate', name: 'Intermediate', desc: 'More advanced techniques building on the basics', icon: TrendingUp, color: 'var(--color-warning, #f59e0b)' },
  { slug: 'advanced', name: 'Advanced', desc: 'Expert-level patterns pushing hardware to its limits', icon: Flame, color: 'var(--color-error, #ef4444)' },
];

const platforms = [
  { slug: 'commodore-64', name: 'Commodore 64', color: 'var(--c64-blue)' },
  { slug: 'sinclair-zx-spectrum', name: 'ZX Spectrum', color: 'var(--zx-magenta)' },
  { slug: 'commodore-amiga', name: 'Commodore Amiga', color: 'var(--amiga-orange)' },
  { slug: 'nintendo-nes', name: 'NES', color: 'var(--nes-red)' },
  { slug: 'cross-platform', name: 'Cross-Platform', color: 'var(--color-primary)' },
];

const categories = [
  { slug: 'rendering', name: 'Rendering' },
  { slug: 'input', name: 'Input' },
  { slug: 'audio', name: 'Audio' },
  { slug: 'physics', name: 'Physics' },
  { slug: 'ai', name: 'AI' },
  { slug: 'framework', name: 'Framework' },
];

export async function getStaticPaths() {
  const difficulties = ['beginner', 'intermediate', 'advanced'];
  return difficulties.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const difficulty = difficulties.find(d => d.slug === slug);

if (!difficulty) {
  return Astro.redirect('/patterns');
}

// Get all patterns at this difficulty
const allPatterns = await getCollection('patterns');
const difficultyPatterns = allPatterns.filter(p => p.data.difficulty === slug);

// Group by platform
const patternsByPlatform = difficultyPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof difficultyPatterns>);

// Sort patterns within each platform by category, then title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category.localeCompare(b.data.category);
    }
    return a.data.title.localeCompare(b.data.title);
  });
});

const IconComponent = difficulty.icon;
---

<Layout
  title={`${difficulty.name} Patterns`}
  description={`${difficulty.desc} — production-ready code patterns for retro game development.`}
>
  <style define:vars={{ difficultyColor: difficulty.color }}>
    /* Hero Section */
    .hero {
      min-height: 250px;
      background: linear-gradient(135deg,
        color-mix(in oklab, var(--difficultyColor) 20%, #1a1a2e 80%) 0%,
        color-mix(in oklab, var(--difficultyColor) 30%, #16213e 70%) 50%,
        color-mix(in oklab, var(--difficultyColor) 25%, #0f3460 75%) 100%
      );
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(circle at 30% 50%, color-mix(in oklab, var(--difficultyColor) 10%, transparent 90%) 0%, transparent 50%),
        radial-gradient(circle at 70% 50%, color-mix(in oklab, var(--difficultyColor) 10%, transparent 90%) 0%, transparent 50%);
      pointer-events: none;
    }

    .hero-content {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
      color: white;
      padding: var(--space-8) var(--space-4);
    }

    .hero-icon {
      color: var(--difficultyColor);
      margin-bottom: var(--space-4);
    }

    .hero-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: -0.02em;
    }

    .hero-subtitle {
      font-size: 1.125rem;
      opacity: 0.9;
      margin-bottom: var(--space-4);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--difficultyColor);
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Breadcrumb */
    .breadcrumb {
      padding: var(--space-4) var(--space-4);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .breadcrumb a {
      color: var(--color-text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .breadcrumb span {
      color: var(--color-text-muted);
    }

    /* Content Section */
    .content-section {
      padding: var(--space-8) var(--space-4) var(--space-12);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    /* Platform Sections */
    .platform-section {
      margin-bottom: var(--space-10);
    }

    .platform-header {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .platform-name {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: 700;
    }

    .platform-count {
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    /* Pattern Grid */
    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-4);
    }

    .pattern-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      position: relative;
      overflow: hidden;
    }

    .pattern-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--platform-color, var(--color-primary));
      transform: scaleX(0);
      transition: transform var(--transition-base);
    }

    .pattern-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--platform-color, var(--color-primary));
    }

    .pattern-card:hover::before {
      transform: scaleX(1);
    }

    .pattern-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-3);
    }

    .pattern-platform {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pattern-category {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      color: var(--color-text-secondary);
    }

    .pattern-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .pattern-summary {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-12);
      text-align: center;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Other Difficulties */
    .other-difficulties {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .other-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .difficulty-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--space-4);
    }

    .difficulty-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .difficulty-link:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .difficulty-link .diff-icon {
      flex-shrink: 0;
    }

    .difficulty-link .diff-info {
      flex: 1;
    }

    .difficulty-link .diff-name {
      font-weight: 600;
      display: block;
    }

    .difficulty-link .diff-count {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .pattern-grid {
        grid-template-columns: 1fr;
      }

      .difficulty-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-icon"><IconComponent size={48} /></div>
      <h1 class="hero-title">{difficulty.name} Patterns</h1>
      <p class="hero-subtitle">{difficulty.desc}</p>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{difficultyPatterns.length}</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{Object.keys(patternsByPlatform).length}</div>
          <div class="stat-label">Platforms</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/patterns">Pattern Library</a>
    <span> / </span>
    <span>{difficulty.name}</span>
  </nav>

  <section class="content-section">
    {difficultyPatterns.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {difficulty.name} patterns yet</h2>
        <p class="empty-text">
          Patterns are being extracted from the curriculum. Check back soon or explore other difficulty levels.
        </p>
      </div>
    ) : (
      <>
        {platforms.map(platform => {
          const patterns = patternsByPlatform[platform.slug] || [];
          if (patterns.length === 0) return null;

          return (
            <section class="platform-section" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h2 class="platform-name" style={`color: ${platform.color}`}>{platform.name}</h2>
                <span class="platform-count">{patterns.length} pattern{patterns.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="pattern-grid">
                {patterns.map(pattern => (
                  <a href={`/patterns/${pattern.slug}`} class="pattern-card" style={`--platform-color: ${platform.color}`}>
                    <div class="pattern-meta">
                      <span class="pattern-platform">{platform.name}</span>
                      <span class="pattern-category">
                        {categories.find(c => c.slug === pattern.data.category)?.name}
                      </span>
                    </div>
                    <h3 class="pattern-title">{pattern.data.title}</h3>
                    <p class="pattern-summary">{pattern.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </>
    )}

    <!-- Other Difficulties -->
    <div class="other-difficulties">
      <h2 class="other-title">Other Skill Levels</h2>
      <div class="difficulty-grid">
        {difficulties.filter(d => d.slug !== slug).map(diff => {
          const DiffIcon = diff.icon;
          const count = allPatterns.filter(p => p.data.difficulty === diff.slug).length;
          return (
            <a href={`/patterns/difficulty/${diff.slug}`} class="difficulty-link" style={`border-color: ${diff.color}`}>
              <span class="diff-icon" style={`color: ${diff.color}`}><DiffIcon size={24} /></span>
              <span class="diff-info">
                <span class="diff-name" style={`color: ${diff.color}`}>{diff.name}</span>
                <span class="diff-count">{count} pattern{count !== 1 ? 's' : ''}</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
