---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Get all patterns from content collection
const allPatterns = await getCollection('patterns');

// Group patterns by platform
const patternsByPlatform = allPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof allPatterns>);

// Sort patterns within each platform by category, then by title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category.localeCompare(b.data.category);
    }
    return a.data.title.localeCompare(b.data.title);
  });
});

const platforms = [
  { slug: 'commodore-64', name: 'Commodore 64', color: '#4a4dff' },
  { slug: 'sinclair-zx-spectrum', name: 'ZX Spectrum', color: '#cc0000' },
  { slug: 'commodore-amiga', name: 'Commodore Amiga', color: '#ff6600' },
  { slug: 'nintendo-nes', name: 'NES', color: '#e30613' },
  { slug: 'cross-platform', name: 'Cross-Platform', color: '#00d9ff' },
];

const categories = [
  { slug: 'rendering', name: 'Rendering', icon: '🎨', desc: 'Sprites, scrolling, screen effects' },
  { slug: 'input', name: 'Input', icon: '🕹️', desc: 'Joystick, keyboard, mouse handling' },
  { slug: 'audio', name: 'Audio', icon: '🔊', desc: 'Music playback, sound effects' },
  { slug: 'physics', name: 'Physics', icon: '⚡', desc: 'Collision, movement, gravity' },
  { slug: 'ai', name: 'AI', icon: '🤖', desc: 'Enemy behaviour, pathfinding' },
  { slug: 'framework', name: 'Framework', icon: '🔧', desc: 'Game loops, state machines, interrupts' },
];

const difficultyColors = {
  beginner: '#22c55e',
  intermediate: '#f59e0b',
  advanced: '#ef4444',
};

const categoryIcons = Object.fromEntries(categories.map(c => [c.slug, c.icon]));
---

<Layout
  title="Pattern Library"
  description="Production-ready code patterns for retro game development. Copy, adapt, and use in your own projects."
>
  <style>
    .pattern-hero {
      min-height: 300px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .pattern-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 40px,
          rgba(255, 255, 255, 0.02) 40px,
          rgba(255, 255, 255, 0.02) 41px
        ),
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 40px,
          rgba(255, 255, 255, 0.02) 40px,
          rgba(255, 255, 255, 0.02) 41px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      background: linear-gradient(135deg, #00d9ff 0%, #00ff88 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .pattern-count {
      margin-top: var(--space-4);
      font-size: 0.9rem;
      opacity: 0.7;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      line-height: 1.6;
    }

    /* Platform Sections */
    .platform-section {
      margin-bottom: var(--space-12);
    }

    .platform-header {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid var(--platform-color, var(--color-border));
    }

    .platform-name {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--platform-color);
    }

    .platform-count {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-4);
    }

    .pattern-card {
      display: block;
      padding: var(--space-5);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--platform-color, var(--color-primary));
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .pattern-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--platform-color, var(--color-primary));
    }

    .pattern-meta {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-bottom: var(--space-2);
    }

    .pattern-category {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    .pattern-difficulty {
      font-size: 0.7rem;
      padding: 0.1rem 0.4rem;
      border-radius: 0.25rem;
      font-weight: 600;
    }

    .pattern-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .pattern-summary {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* Category Grid */
    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .category-card {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-5);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
    }

    .category-icon {
      font-size: 1.75rem;
      line-height: 1;
    }

    .category-info h3 {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .category-info p {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin: 0;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
      margin-bottom: var(--space-8);
    }

    .empty-badge {
      display: inline-block;
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-3);
      background: var(--color-primary);
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
      margin-bottom: var(--space-4);
      text-transform: uppercase;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
    }

    /* What's the Difference */
    .difference-section {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .difference-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
      margin-top: var(--space-6);
    }

    .difference-card {
      text-align: center;
      padding: var(--space-6);
    }

    .difference-card h4 {
      font-size: 1.125rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .difference-card p {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .difference-card a {
      color: var(--color-primary);
      text-decoration: none;
    }

    .difference-card a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .difference-grid {
        grid-template-columns: 1fr;
      }

      .pattern-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- Hero -->
  <section class="pattern-hero">
    <div class="hero-content">
      <h1 class="hero-title">Pattern Library</h1>
      <p class="hero-subtitle">
        Production-ready code patterns from the curriculum. Copy, adapt, and use in your own retro game projects.
      </p>
      <p class="pattern-count">{allPatterns.length} patterns available</p>
    </div>
  </section>

  <section class="content-section">
    {allPatterns.length === 0 ? (
      <!-- Empty State -->
      <div class="empty-notice">
        <span class="empty-badge">Coming Soon</span>
        <h2 class="empty-title">Patterns are being extracted from the curriculum</h2>
        <p class="empty-text">
          As units are completed, reusable patterns will appear here. In the meantime, explore the curriculum or browse the Vault.
        </p>
      </div>
    ) : (
      <!-- Patterns by Platform -->
      <>
        {platforms.map(platform => {
          const patterns = patternsByPlatform[platform.slug] || [];
          if (patterns.length === 0) return null;

          return (
            <section class="platform-section" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h2 class="platform-name" style={`color: ${platform.color}`}>{platform.name}</h2>
                <span class="platform-count">{patterns.length} pattern{patterns.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="pattern-grid">
                {patterns.map(pattern => (
                  <a href={`/patterns/${pattern.slug}`} class="pattern-card" style={`--platform-color: ${platform.color}`}>
                    <div class="pattern-meta">
                      <span class="pattern-category">
                        {categoryIcons[pattern.data.category]} {categories.find(c => c.slug === pattern.data.category)?.name}
                      </span>
                      <span
                        class="pattern-difficulty"
                        style={`background: ${difficultyColors[pattern.data.difficulty]}20; color: ${difficultyColors[pattern.data.difficulty]}`}
                      >
                        {pattern.data.difficulty}
                      </span>
                    </div>
                    <h3 class="pattern-title">{pattern.data.title}</h3>
                    <p class="pattern-summary">{pattern.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </>
    )}

    <!-- Browse by Category -->
    <h2 class="section-title">Browse by Category</h2>
    <p class="section-intro">
      Patterns are organised by what they do, making it easy to find the right code for your game.
    </p>

    <div class="category-grid">
      {categories.map(cat => (
        <div class="category-card">
          <span class="category-icon">{cat.icon}</span>
          <div class="category-info">
            <h3>{cat.name}</h3>
            <p>{cat.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- What's the Difference -->
    <div class="difference-section">
      <h2 class="section-title">Patterns vs Units vs Vault</h2>
      <div class="difference-grid">
        <div class="difference-card">
          <h4>Curriculum Units</h4>
          <p>Step-by-step tutorials that teach you how to build games from scratch.</p>
          <a href="/commodore-64">Start learning</a>
        </div>
        <div class="difference-card">
          <h4>Pattern Library</h4>
          <p>Production-ready code snippets to copy and adapt for your own projects.</p>
          <span style="color: var(--color-text-secondary); font-size: 0.875rem;">You're here</span>
        </div>
        <div class="difference-card">
          <h4>The Vault</h4>
          <p>Historical context, hardware deep-dives, and the stories behind the era.</p>
          <a href="/vault">Explore</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
