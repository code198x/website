---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DynamicIcon from '../../components/DynamicIcon.astro';
import { getPlatformsForPatternLibrary } from '../../lib/platforms';
import { getPatternCategories, getPatternDifficulties } from '../../lib/categories';

// Get all patterns from content collection
const allPatterns = await getCollection('patterns');

// Group patterns by platform
const patternsByPlatform = allPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof allPatterns>);

// Sort patterns within each platform by category, then by title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category.localeCompare(b.data.category);
    }
    return a.data.title.localeCompare(b.data.title);
  });
});

const platforms = await getPlatformsForPatternLibrary();
const categoriesData = await getPatternCategories();
const difficultiesData = await getPatternDifficulties();

const categories = categoriesData.map(c => ({ slug: c.id, name: c.data.name, desc: c.data.description, icon: c.data.icon }));
const difficulties = difficultiesData.map(d => ({ slug: d.id, name: d.data.name, desc: d.data.description, icon: d.data.icon, color: d.data.color }));
---

<Layout title="Pattern Library" description="Production-ready code patterns for retro game development, extracted from the curriculum.">
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Production-ready code · extracted from the curriculum</p>
      <h1>Pattern library.</h1>
      <div class="herorule"></div>
      <p class="lede">Reusable patterns pulled straight out of the lessons — copy, adapt, and drop them
        into your own projects. From sprite handling to sound effects, the tricks that make retro
        games work.</p>
      <p class="summary"><b>{allPatterns.length}</b> patterns · <b>{categories.length}</b> categories · <b>{platforms.filter(p => p.slug !== 'cross-platform').length}</b> platforms</p>
    </div>

    {allPatterns.length === 0 ? (
      <div class="empty-notice">
        <span class="empty-badge">Coming soon</span>
        <h2 class="empty-title">Patterns are being extracted from the curriculum</h2>
        <p class="empty-text">As units are completed, reusable patterns will appear here. In the meantime, explore the curriculum or browse the Vault.</p>
      </div>
    ) : (
      <>
        <section class="browse">
          <div class="cat-head"><h2>Browse by platform</h2></div>
          <p class="cat-intro">Each platform has its own constraints and tricks. Find patterns tailored to your target machine.</p>
          <div class="platform-grid">
            {platforms.map(platform => {
              const patternCount = (patternsByPlatform[platform.slug] || []).length;
              return (
                <a href={`/patterns/platform/${platform.slug}`} class="platform-card" style={`--pc: ${platform.color}`}>
                  <span class="platform-bar"></span>
                  <h3 class="platform-name">{platform.name}</h3>
                  <span class="platform-count">{patternCount} pattern{patternCount !== 1 ? 's' : ''}</span>
                </a>
              );
            })}
          </div>
        </section>

        <section class="browse">
          <div class="cat-head"><h2>Browse by category</h2></div>
          <p class="cat-intro">Patterns organised by what they do — from rendering to audio to game logic.</p>
          <div class="card-grid">
            {categories.map(cat => {
              const patternCount = allPatterns.filter(p => p.data.category === cat.slug).length;
              return (
                <a href={`/patterns/category/${cat.slug}`} class="browse-card">
                  <div class="bc-icon"><DynamicIcon name={cat.icon} size={24} /></div>
                  <h3>{cat.name}</h3>
                  <p>{cat.desc}</p>
                  <span class="bc-count">{patternCount} pattern{patternCount !== 1 ? 's' : ''}</span>
                </a>
              );
            })}
          </div>
        </section>

        <section class="browse">
          <div class="cat-head"><h2>Browse by skill level</h2></div>
          <p class="cat-intro">Find patterns that match your experience, from foundational to expert.</p>
          <div class="card-grid">
            {difficulties.map(diff => {
              const patternCount = allPatterns.filter(p => p.data.difficulty === diff.slug).length;
              return (
                <a href={`/patterns/difficulty/${diff.slug}`} class="browse-card diff" style={`--pc: ${diff.color}`}>
                  <div class="bc-icon"><DynamicIcon name={diff.icon} size={28} /></div>
                  <h3>{diff.name}</h3>
                  <p>{diff.desc}</p>
                  <span class="bc-count">{patternCount} pattern{patternCount !== 1 ? 's' : ''}</span>
                </a>
              );
            })}
          </div>
        </section>
      </>
    )}

    <section class="compare">
      <div class="cat-head"><h2>Patterns vs Units vs Vault</h2></div>
      <div class="compare-grid">
        <div class="compare-card">
          <h4>Curriculum units</h4>
          <p>Step-by-step tutorials that teach you how to build games from scratch.</p>
          <a href="/systems/commodore-64">Start learning →</a>
        </div>
        <div class="compare-card current">
          <h4>Pattern library</h4>
          <p>Production-ready code snippets to copy and adapt for your own projects.</p>
          <span class="current-label">You're here</span>
        </div>
        <div class="compare-card">
          <h4>The Vault</h4>
          <p>Historical context, hardware deep-dives, and the stories behind the era.</p>
          <a href="/vault">Explore →</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-5) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }

  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3.4rem, 8vw, 5.25rem); line-height: 0.84;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 260px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 70ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .summary { font-family: var(--font-family-mono); font-size: 0.75rem; color: var(--color-text-secondary); margin-top: var(--space-3); }
  .summary b { color: var(--color-text); }

  .browse, .compare { margin-top: var(--space-10); }
  .cat-head { border-bottom: 3px solid var(--color-text); padding-bottom: var(--space-2); margin-bottom: var(--space-2); }
  .cat-head h2 { font-size: 1.5rem; font-weight: 800; margin: 0; }
  .cat-intro { color: var(--color-text-secondary); margin: 0 0 var(--space-5); }

  .platform-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-4); }
  .platform-card { display: flex; flex-direction: column; background: var(--color-surface); border: 3px solid var(--color-border); text-decoration: none; color: var(--color-text); padding: 0 var(--space-4) var(--space-4); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
  .platform-card:hover, .platform-card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--pc); border-color: var(--pc); }
  .platform-bar { display: block; height: 8px; margin: 0 calc(-1 * var(--space-4)) var(--space-4); background: var(--pc); }
  .platform-name { font-size: 1.2rem; font-weight: 700; margin: 0; }
  .platform-count { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); margin-top: var(--space-1); }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); }
  .browse-card { display: block; background: var(--color-surface); border: 3px solid var(--color-border); padding: var(--space-5); text-decoration: none; color: var(--color-text); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); --pc: var(--color-house-2); }
  .browse-card:hover, .browse-card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--pc); border-color: var(--pc); }
  .bc-icon { display: inline-flex; color: var(--pc); margin-bottom: var(--space-2); }
  .browse-card h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 var(--space-1); }
  .browse-card p { font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0 0 var(--space-3); }
  .bc-count { font-family: var(--font-family-mono); font-size: 0.68rem; color: var(--color-text-secondary); }

  .compare-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .compare-card { background: var(--color-surface); border: 3px solid var(--color-border); padding: var(--space-5); }
  .compare-card.current { border-color: var(--color-house-2); box-shadow: var(--shadow-chunky); }
  .compare-card h4 { font-size: 1.05rem; font-weight: 800; margin: 0 0 var(--space-2); }
  .compare-card p { font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0 0 var(--space-3); }
  .compare-card a { color: var(--color-house-2); font-weight: 700; font-family: var(--font-family-mono); font-size: 0.78rem; text-decoration: none; }
  .current-label { font-family: var(--font-family-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-house-2); }

  .empty-notice { background: var(--color-surface); border: 3px dashed var(--color-border); padding: var(--space-12); text-align: center; margin-top: var(--space-8); }
  .empty-badge { font-family: var(--font-family-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-house-2); border: 2px solid var(--color-house-2); padding: 2px 8px; }
  .empty-title { font-size: 1.25rem; margin: var(--space-4) 0 var(--space-3); }
  .empty-text { color: var(--color-text-secondary); max-width: 500px; margin: 0 auto; line-height: 1.6; }

  @media (max-width: 760px) { .compare-grid { grid-template-columns: 1fr; } }
</style>
