---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Monitor, Gamepad2, Volume2, Move, Bot, Layers, Puzzle, GraduationCap, TrendingUp, Flame } from '@lucide/astro';
import { getPlatformsForPatternLibrary } from '../../lib/platforms';

// Get all patterns from content collection
const allPatterns = await getCollection('patterns');

// Group patterns by platform
const patternsByPlatform = allPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof allPatterns>);

// Sort patterns within each platform by category, then by title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category.localeCompare(b.data.category);
    }
    return a.data.title.localeCompare(b.data.title);
  });
});

const platforms = await getPlatformsForPatternLibrary();

const categories = [
  { slug: 'rendering', name: 'Rendering', desc: 'Sprites, scrolling, screen effects', icon: Monitor },
  { slug: 'input', name: 'Input', desc: 'Joystick, keyboard, mouse handling', icon: Gamepad2 },
  { slug: 'audio', name: 'Audio', desc: 'Music playback, sound effects', icon: Volume2 },
  { slug: 'physics', name: 'Physics', desc: 'Collision, movement, gravity', icon: Move },
  { slug: 'ai', name: 'AI', desc: 'Enemy behaviour, pathfinding', icon: Bot },
  { slug: 'framework', name: 'Framework', desc: 'Game loops, state machines, interrupts', icon: Layers },
];

const difficultyColors = {
  beginner: 'var(--color-success, #22c55e)',
  intermediate: 'var(--color-warning, #f59e0b)',
  advanced: 'var(--color-error, #ef4444)',
};

const difficulties = [
  { slug: 'beginner', name: 'Beginner', desc: 'Foundational patterns for those starting out', icon: GraduationCap, color: '#22c55e' },
  { slug: 'intermediate', name: 'Intermediate', desc: 'Building on the basics with more advanced techniques', icon: TrendingUp, color: '#f59e0b' },
  { slug: 'advanced', name: 'Advanced', desc: 'Expert-level patterns pushing hardware limits', icon: Flame, color: '#ef4444' },
];
---

<Layout
  title="Pattern Library"
  description="Production-ready code patterns for retro game development. Copy, adapt, and use in your own projects."
>
  <style>
    /* Hero Animations */
    @keyframes float-1 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(15px, -20px) rotate(5deg); }
      50% { transform: translate(-10px, -35px) rotate(-3deg); }
      75% { transform: translate(20px, -15px) rotate(8deg); }
    }

    @keyframes float-2 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(-20px, 15px) rotate(-8deg); }
      50% { transform: translate(15px, 25px) rotate(5deg); }
      75% { transform: translate(-25px, 10px) rotate(-5deg); }
    }

    @keyframes float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(25px, -20px) scale(1.1); }
      66% { transform: translate(-15px, 15px) scale(0.95); }
    }

    @keyframes float-4 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      50% { transform: translate(-30px, -25px) rotate(180deg); }
    }

    @keyframes float-5 {
      0%, 100% { transform: translate(0, 0) rotate(45deg); }
      25% { transform: translate(10px, -15px) rotate(50deg); }
      50% { transform: translate(-5px, -25px) rotate(40deg); }
      75% { transform: translate(15px, -10px) rotate(55deg); }
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.7; }
    }

    @keyframes scanline-beam {
      0% { top: -10%; }
      100% { top: 110%; }
    }

    /* Hero Section */
    .hero {
      --accent-color: #06b6d4;
      min-height: 420px;
      background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 50%, #3d7ab5 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Animated shapes container */
    .hero-shapes {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .shape {
      position: absolute;
      opacity: 0.35;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    /* Shape 1: Square - top left */
    .shape-1 {
      top: 15%;
      left: 8%;
      width: 60px;
      height: 60px;
      border: 3px solid var(--accent-color);
      box-shadow: 0 0 20px var(--accent-color), inset 0 0 10px rgba(255, 255, 255, 0.1);
      animation: float-1 12s infinite, pulse-glow 4s infinite;
    }

    /* Shape 2: Circle - top right */
    .shape-2 {
      top: 20%;
      right: 12%;
      width: 50px;
      height: 50px;
      border: 3px solid var(--accent-color);
      border-radius: 50%;
      box-shadow: 0 0 15px var(--accent-color);
      animation: float-2 15s infinite, pulse-glow 5s infinite 1s;
    }

    /* Shape 3: Diamond - bottom left */
    .shape-3 {
      bottom: 20%;
      left: 15%;
      width: 45px;
      height: 45px;
      border: 3px solid var(--accent-color);
      transform: rotate(45deg);
      box-shadow: 0 0 15px var(--accent-color);
      animation: float-3 18s infinite, pulse-glow 6s infinite 2s;
    }

    /* Shape 4: Triangle - bottom right */
    .shape-4 {
      bottom: 25%;
      right: 10%;
      width: 0;
      height: 0;
      border-left: 25px solid transparent;
      border-right: 25px solid transparent;
      border-bottom: 45px solid var(--accent-color);
      filter: drop-shadow(0 0 12px var(--accent-color));
      animation: float-4 20s infinite, pulse-glow 7s infinite;
    }

    /* Shape 5: Small square - center right */
    .shape-5 {
      top: 40%;
      right: 20%;
      width: 30px;
      height: 30px;
      border: 2px solid var(--accent-color);
      box-shadow: 0 0 10px var(--accent-color);
      animation: float-5 14s infinite, pulse-glow 5s infinite 0.5s;
    }

    /* Grid overlay */
    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 1;
    }

    /* Scanlines effect */
    .hero-scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
      );
      pointer-events: none;
      z-index: 2;
    }

    /* Animated beam effect */
    .hero-beam {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(6, 182, 212, 0.1) 20%,
        rgba(6, 182, 212, 0.3) 50%,
        rgba(6, 182, 212, 0.1) 80%,
        transparent 100%
      );
      animation: scanline-beam 8s linear infinite;
      pointer-events: none;
      z-index: 3;
    }

    .hero-content {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 5;
      color: white;
      padding: var(--space-12) var(--space-4);
    }

    .hero-icon {
      color: var(--accent-color);
      margin-bottom: var(--space-4);
      filter: drop-shadow(0 0 8px var(--accent-color));
    }

    .hero-title {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: -0.02em;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3), 0 0 30px rgba(6, 182, 212, 0.3);
    }

    .hero-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
      font-style: italic;
      text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
    }

    .hero-description {
      font-size: 1rem;
      line-height: 1.7;
      opacity: 0.9;
      margin-bottom: var(--space-6);
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
      .shape {
        animation: none;
      }

      .hero-beam {
        animation: none;
        opacity: 0;
      }
    }

    @media (max-width: 768px) {
      .shape {
        opacity: 0.2;
      }

      .shape-1 { width: 45px; height: 45px; }
      .shape-2 { width: 35px; height: 35px; }
      .shape-3 { width: 30px; height: 30px; }
      .shape-4 {
        border-left-width: 18px;
        border-right-width: 18px;
        border-bottom-width: 32px;
      }
      .shape-5 { display: none; }
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Content Section */
    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .browse-sections {
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
    }

    .browse-section {
      /* Wrapper for each browse block */
    }

    .section-title {
      font-size: 1.75rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
      max-width: 600px;
      line-height: 1.6;
    }

    /* Platform Grid */
    .platform-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
    }

    .platform-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-6) var(--space-4);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      text-align: center;
    }

    .platform-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px color-mix(in oklab, var(--platform-color) 25%, transparent 75%);
      border-color: var(--platform-color);
    }

    .platform-badge {
      width: 48px;
      height: 8px;
      border-radius: 4px;
      box-shadow: 0 0 12px var(--platform-color);
    }

    .platform-card .platform-name {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .platform-card .platform-count {
      font-size: 0.8rem;
      color: var(--color-text-muted);
    }

    /* Category Grid */
    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .category-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .category-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    .category-card .category-icon {
      color: var(--color-primary);
      margin-bottom: var(--space-3);
    }

    .category-card h3 {
      display: block;
      font-size: 1.125rem;
      font-weight: 600;
      margin: 0 0 var(--space-2) 0;
      color: var(--color-text);
    }

    .category-card p {
      display: block;
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-3) 0;
      line-height: 1.5;
    }

    .category-card .category-count {
      display: block;
      font-size: 0.75rem;
      color: var(--color-primary);
      font-weight: 600;
    }

    /* Difficulty Grid */
    .difficulty-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .difficulty-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--diff-color);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      text-align: center;
    }

    .difficulty-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px color-mix(in oklab, var(--diff-color) 30%, transparent 70%);
    }

    .difficulty-card .difficulty-icon {
      color: var(--diff-color);
      margin-bottom: var(--space-3);
    }

    .difficulty-card h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 var(--space-2) 0;
      color: var(--diff-color);
    }

    .difficulty-card p {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-3) 0;
      line-height: 1.5;
    }

    .difficulty-card .difficulty-count {
      display: block;
      font-size: 0.8rem;
      color: var(--diff-color);
      font-weight: 600;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-12);
      text-align: center;
      margin-bottom: var(--space-8);
    }

    .empty-badge {
      display: inline-block;
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-3);
      background: var(--color-primary);
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
      margin-bottom: var(--space-4);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Comparison Section */
    .comparison-section {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .comparison-grid {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: var(--space-4);
      margin-top: var(--space-6);
    }

    .comparison-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-align: center;
    }

    .comparison-card.current {
      border-color: var(--color-primary);
    }

    .comparison-card h4 {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      margin: 0 0 var(--space-2) 0;
      color: var(--color-text);
    }

    .comparison-card p {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin: 0 0 var(--space-3) 0;
    }

    .comparison-card a {
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.875rem;
    }

    .comparison-card a:hover {
      text-decoration: underline;
    }

    .comparison-card .current-label {
      display: block;
      font-size: 0.75rem;
      color: var(--color-primary);
      font-weight: 500;
    }

    @media (max-width: 900px) {
      .comparison-grid {
        grid-template-columns: 1fr !important;
      }

      .platform-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .category-grid {
        grid-template-columns: 1fr;
      }

      .difficulty-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 500px) {
      .platform-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- Hero -->
  <section class="hero">
    <!-- Animated background shapes -->
    <div class="hero-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
      <div class="shape shape-4"></div>
      <div class="shape shape-5"></div>
    </div>

    <!-- Grid overlay -->
    <div class="hero-grid"></div>

    <!-- Scanline effect -->
    <div class="hero-scanlines"></div>

    <!-- Animated beam -->
    <div class="hero-beam"></div>

    <div class="hero-content">
      <div class="hero-icon"><Puzzle size={48} /></div>
      <h1 class="hero-title">Pattern Library</h1>
      <p class="hero-subtitle">Production-ready code for retro games</p>
      <p class="hero-description">
        Reusable patterns extracted from the curriculum. Copy, adapt, and use in your own projects — from sprite handling to sound effects.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{allPatterns.length}</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{categories.length}</div>
          <div class="stat-label">Categories</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{platforms.filter(p => p.slug !== 'cross-platform').length}</div>
          <div class="stat-label">Platforms</div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section">
    {allPatterns.length === 0 ? (
      <!-- Empty State -->
      <div class="empty-notice">
        <span class="empty-badge">Coming Soon</span>
        <h2 class="empty-title">Patterns are being extracted from the curriculum</h2>
        <p class="empty-text">
          As units are completed, reusable patterns will appear here. In the meantime, explore the curriculum or browse the Vault.
        </p>
      </div>
    ) : (
      <!-- Navigation Hub -->
      <div class="browse-sections">
        <!-- Browse by Platform -->
        <div class="browse-section">
          <h2 class="section-title">Browse by Platform</h2>
          <p class="section-intro">
            Each platform has its own constraints and tricks. Find patterns tailored to your target machine.
          </p>
          <div class="platform-grid">
            {platforms.map(platform => {
              const patternCount = (patternsByPlatform[platform.slug] || []).length;
              return (
                <a href={`/patterns/platform/${platform.slug}`} class="platform-card" style={`--platform-color: ${platform.color}`}>
                  <div class="platform-badge" style={`background: ${platform.color}`}></div>
                  <h3 class="platform-name">{platform.name}</h3>
                  <span class="platform-count">{patternCount} pattern{patternCount !== 1 ? 's' : ''}</span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Browse by Category -->
        <div class="browse-section">
          <h2 class="section-title">Browse by Category</h2>
          <p class="section-intro">
            Patterns organised by what they do — from rendering to audio to game logic.
          </p>
          <div class="category-grid">
            {categories.map(cat => {
              const IconComponent = cat.icon;
              const patternCount = allPatterns.filter(p => p.data.category === cat.slug).length;
              return (
                <a href={`/patterns/category/${cat.slug}`} class="category-card">
                  <div class="category-icon"><IconComponent size={24} /></div>
                  <h3>{cat.name}</h3>
                  <p>{cat.desc}</p>
                  <span class="category-count">{patternCount} pattern{patternCount !== 1 ? 's' : ''}</span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Browse by Skill Level -->
        <div class="browse-section">
          <h2 class="section-title">Browse by Skill Level</h2>
          <p class="section-intro">
            Find patterns that match your experience, from foundational to expert.
          </p>
          <div class="difficulty-grid">
            {difficulties.map(diff => {
              const IconComponent = diff.icon;
              const patternCount = allPatterns.filter(p => p.data.difficulty === diff.slug).length;
              return (
                <a href={`/patterns/difficulty/${diff.slug}`} class="difficulty-card" style={`--diff-color: ${diff.color}`}>
                  <div class="difficulty-icon"><IconComponent size={28} /></div>
                  <h3>{diff.name}</h3>
                  <p>{diff.desc}</p>
                  <span class="difficulty-count">{patternCount} pattern{patternCount !== 1 ? 's' : ''}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    )}

    <!-- Comparison Section -->
    <div class="comparison-section">
      <h2 class="section-title">Patterns vs Units vs Vault</h2>
      <div class="comparison-grid">
        <div class="comparison-card">
          <h4>Curriculum Units</h4>
          <p>Step-by-step tutorials that teach you how to build games from scratch.</p>
          <a href="/commodore-64">Start learning →</a>
        </div>
        <div class="comparison-card current">
          <h4>Pattern Library</h4>
          <p>Production-ready code snippets to copy and adapt for your own projects.</p>
          <span class="current-label">You're here</span>
        </div>
        <div class="comparison-card">
          <h4>The Vault</h4>
          <p>Historical context, hardware deep-dives, and the stories behind the era.</p>
          <a href="/vault">Explore →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
