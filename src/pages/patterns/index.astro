---
import Layout from '../../layouts/Layout.astro';

const platforms = [
  {
    name: 'Commodore 64',
    slug: 'commodore-64',
    color: '#4a4dff',
    categories: ['Rendering', 'Input', 'Audio', 'Physics', 'Framework']
  },
  {
    name: 'ZX Spectrum',
    slug: 'sinclair-zx-spectrum',
    color: '#ff00ff',
    categories: ['Rendering', 'Input', 'Audio', 'Physics', 'Framework']
  },
  {
    name: 'Commodore Amiga',
    slug: 'commodore-amiga',
    color: '#ff8800',
    categories: ['Rendering', 'Input', 'Audio', 'Physics', 'Framework']
  },
  {
    name: 'NES',
    slug: 'nintendo-nes',
    color: '#ff0000',
    categories: ['Rendering', 'Input', 'Audio', 'Physics', 'Framework']
  }
];

const categories = [
  { name: 'Rendering', icon: '🎨', desc: 'Sprites, scrolling, screen effects' },
  { name: 'Input', icon: '🕹️', desc: 'Joystick, keyboard, mouse handling' },
  { name: 'Audio', icon: '🔊', desc: 'Music playback, sound effects' },
  { name: 'Physics', icon: '⚡', desc: 'Collision, movement, gravity' },
  { name: 'AI', icon: '🤖', desc: 'Enemy behaviour, pathfinding' },
  { name: 'Framework', icon: '🔧', desc: 'Game loops, state machines, interrupts' }
];
---

<Layout
  title="Pattern Library"
  description="Production-ready code patterns for retro game development. Copy, adapt, and use in your own projects."
>
  <style>
    .pattern-hero {
      min-height: 300px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .pattern-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 40px,
          rgba(255, 255, 255, 0.02) 40px,
          rgba(255, 255, 255, 0.02) 41px
        ),
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 40px,
          rgba(255, 255, 255, 0.02) 40px,
          rgba(255, 255, 255, 0.02) 41px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      background: linear-gradient(135deg, #00d9ff 0%, #00ff88 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      line-height: 1.6;
    }

    /* Coming Soon Notice */
    .coming-soon-notice {
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, var(--color-primary) 5%, var(--color-surface) 95%) 100%);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .coming-soon-badge {
      display: inline-block;
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-3);
      background: var(--color-primary);
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
      margin-bottom: var(--space-4);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .coming-soon-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .coming-soon-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto var(--space-6);
      line-height: 1.6;
    }

    .coming-soon-cta {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-primary);
      color: var(--color-primary);
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      transition: all var(--transition-base);
    }

    .coming-soon-cta:hover {
      background: var(--color-primary);
      color: white;
    }

    /* Category Grid */
    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .category-card {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-5);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .category-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .category-icon {
      font-size: 1.75rem;
      line-height: 1;
    }

    .category-info h3 {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .category-info p {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin: 0;
    }

    /* Platform Grid */
    .platform-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--space-4);
    }

    .platform-card {
      display: block;
      padding: var(--space-5);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      text-align: center;
    }

    .platform-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .platform-name {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
    }

    .platform-count {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    /* Cross-Platform Section */
    .cross-platform-section {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-top: var(--space-8);
    }

    .cross-platform-section h3 {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .cross-platform-section p {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
      line-height: 1.6;
    }

    .cross-platform-examples {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .example-tag {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    /* What's the Difference */
    .difference-section {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .difference-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
      margin-top: var(--space-6);
    }

    .difference-card {
      text-align: center;
      padding: var(--space-6);
    }

    .difference-card h4 {
      font-size: 1.125rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .difference-card p {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .difference-card a {
      color: var(--color-primary);
      text-decoration: none;
    }

    .difference-card a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .difference-grid {
        grid-template-columns: 1fr;
      }

      .platform-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>

  <!-- Hero -->
  <section class="pattern-hero">
    <div class="hero-content">
      <h1 class="hero-title">Pattern Library</h1>
      <p class="hero-subtitle">
        Production-ready code patterns from the curriculum. Copy, adapt, and use in your own retro game projects.
      </p>
    </div>
  </section>

  <section class="content-section">
    <!-- Coming Soon Notice -->
    <div class="coming-soon-notice">
      <span class="coming-soon-badge">Coming Soon</span>
      <h2 class="coming-soon-title">Patterns are being extracted from the curriculum</h2>
      <p class="coming-soon-text">
        As units are completed, reusable patterns will appear here. In the meantime, explore the curriculum or browse the Vault.
      </p>
      <a href="/vault" class="coming-soon-cta">Browse the Vault</a>
    </div>

    <!-- Browse by Category -->
    <h2 class="section-title">Browse by Category</h2>
    <p class="section-intro">
      Patterns are organised by what they do, making it easy to find the right code for your game.
    </p>

    <div class="category-grid">
      {categories.map(cat => (
        <div class="category-card">
          <span class="category-icon">{cat.icon}</span>
          <div class="category-info">
            <h3>{cat.name}</h3>
            <p>{cat.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Browse by Platform -->
    <h2 class="section-title">Browse by Platform</h2>
    <p class="section-intro">
      Each platform has its own implementation. Same concept, different hardware.
    </p>

    <div class="platform-grid">
      {platforms.map(platform => (
        <div
          class="platform-card"
          style={`border-color: ${platform.color}20; --platform-color: ${platform.color}`}
        >
          <h3 class="platform-name" style={`color: ${platform.color}`}>{platform.name}</h3>
          <p class="platform-count">Patterns coming soon</p>
        </div>
      ))}
    </div>

    <!-- Cross-Platform -->
    <div class="cross-platform-section">
      <h3>Cross-Platform Comparisons</h3>
      <p>
        See how the same concept is implemented differently across platforms. Understand why the C64 uses hardware sprites while the Spectrum uses software rendering, or how collision detection varies by architecture.
      </p>
      <div class="cross-platform-examples">
        <span class="example-tag">Sprite Collision</span>
        <span class="example-tag">Game Loop</span>
        <span class="example-tag">Scrolling</span>
        <span class="example-tag">Input Handling</span>
        <span class="example-tag">Sound Effects</span>
      </div>
    </div>

    <!-- What's the Difference -->
    <div class="difference-section">
      <h2 class="section-title">Patterns vs Units vs Vault</h2>
      <div class="difference-grid">
        <div class="difference-card">
          <h4>Curriculum Units</h4>
          <p>Step-by-step tutorials that teach you how to build games from scratch.</p>
          <a href="/commodore-64">Start learning</a>
        </div>
        <div class="difference-card">
          <h4>Pattern Library</h4>
          <p>Production-ready code snippets to copy and adapt for your own projects.</p>
          <span style="color: var(--color-text-secondary); font-size: 0.875rem;">You're here</span>
        </div>
        <div class="difference-card">
          <h4>The Vault</h4>
          <p>Historical context, hardware deep-dives, and the stories behind the era.</p>
          <a href="/vault">Explore</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
