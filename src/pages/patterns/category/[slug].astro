---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DynamicIcon from '../../../components/DynamicIcon.astro';
import { getPlatformsForPatternLibrary } from '../../../lib/platforms';
import { inkStyle } from '../../../lib/contrast';
import { getPopulatedPatternCategories, getPatternDifficulties } from '../../../lib/categories';

// Get data from collections
const categoriesData = await getPopulatedPatternCategories();
const difficultiesData = await getPatternDifficulties();
const platforms = await getPlatformsForPatternLibrary();

// Map to format expected by template
const categories = categoriesData.map(c => ({
  slug: c.id,
  name: c.data.name,
  desc: c.data.description,
  icon: c.data.icon,
}));

// Build difficulty colors lookup
const difficultyColors = Object.fromEntries(
  difficultiesData.map(d => [d.id, d.data.color])
);

export async function getStaticPaths() {
  const { getPopulatedPatternCategories } = await import('../../../lib/categories');
  const categories = await getPopulatedPatternCategories();
  return categories.map(c => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const category = categories.find(c => c.slug === slug);

if (!category) {
  return Astro.redirect('/patterns');
}

// Get all patterns in this category
const allPatterns = await getCollection('patterns');
const categoryPatterns = allPatterns.filter(p => p.data.category === slug);

// Group by platform
const patternsByPlatform = categoryPatterns.reduce((acc, pattern) => {
  const platform = pattern.data.platform;
  if (!acc[platform]) acc[platform] = [];
  acc[platform].push(pattern);
  return acc;
}, {} as Record<string, typeof categoryPatterns>);

// Sort patterns within each platform by title
Object.keys(patternsByPlatform).forEach(platform => {
  patternsByPlatform[platform].sort((a, b) => a.data.title.localeCompare(b.data.title));
});

const categoryIcon = category.icon;

// Custom breadcrumbs
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Patterns', href: '/patterns' },
  { label: category.name }
];
---

<Layout
  title={`${category.name} Patterns`}
  description={`${category.desc} — production-ready code patterns for retro game development.`}
  breadcrumbs={breadcrumbs}
>
  <style>
    /* Hero Animations */

    /* Hero Section */

    /* Animated shapes container */

    /* Grid overlay */

    /* Scanlines effect */

    /* Animated beam effect */

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--ink);
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Reduced motion support */

    /* Content Section */
    .content-section {
      padding: var(--space-8) var(--space-4) var(--space-12);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    /* Platform Sections */
    .platform-section {
      margin-bottom: var(--space-10);
    }

    .platform-header {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .platform-name {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: 700;
    }

    .platform-count {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    /* Pattern Grid */
    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-4);
    }

    .pattern-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      position: relative;
      overflow: hidden;
    }

    .pattern-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--platform-color, var(--color-primary));
      transform: scaleX(0);
      transition: transform var(--transition-base);
    }

    .pattern-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-chunky);
      border-color: var(--platform-color, var(--color-primary));
    }

    .pattern-card:hover::before {
      transform: scaleX(1);
    }

    .pattern-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-3);
    }

    .pattern-platform {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pattern-difficulty {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      border-radius: 0;
      font-weight: 600;
      text-transform: capitalize;
    }

    .pattern-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .pattern-summary {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0;
      padding: var(--space-12);
      text-align: center;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Other Categories */
    .other-categories {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .other-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
    }

    .category-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .category-link:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-chunky);
    }

    .category-link .cat-icon {
      color: var(--color-primary);
    }

    .category-link .cat-name {
      font-weight: 600;
    }

    @media (max-width: 768px) {
      .pattern-grid {
        grid-template-columns: 1fr;
      }

      .category-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* --- synthesis hero override (paper/ink, no neon decoration) --- */
    .hero-subtitle, .hero-description { color: var(--color-text-secondary); opacity: 1; }
    .stat-value { color: var(--color-house-2); }
    .stat-label { color: var(--color-text-secondary); opacity: 1; }
  </style>

  <!-- Hero -->
  <div class="directory-heading">
    <PageHeader title={`${category.name} Patterns`} description={category.desc}>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{categoryPatterns.length}</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{Object.keys(patternsByPlatform).length}</div>
          <div class="stat-label">Platforms</div>
        </div>
      </div>
    </PageHeader>
  </div>

  <section class="content-section">
    {categoryPatterns.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {category.name} patterns yet</h2>
        <p class="empty-text">
          Patterns are being extracted from the curriculum. Check back soon or explore other categories.
        </p>
      </div>
    ) : (
      <>
        {platforms.map(platform => {
          const patterns = patternsByPlatform[platform.slug] || [];
          if (patterns.length === 0) return null;

          return (
            <section class="platform-section" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h2 class="platform-name" style={`${inkStyle(platform.color)} color: var(--ink);`}>{platform.name}</h2>
                <span class="platform-count">{patterns.length} pattern{patterns.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="pattern-grid">
                {patterns.map(pattern => (
                  <a href={`/patterns/${pattern.id}`} class="pattern-card" style={`--platform-color: ${platform.color}`}>
                    <div class="pattern-meta">
                      <span class="pattern-platform">{platform.name}</span>
                      <span
                        class="pattern-difficulty"
                        style={`background: color-mix(in oklab, ${difficultyColors[pattern.data.difficulty]} 15%, var(--color-surface) 85%); color: ${difficultyColors[pattern.data.difficulty]}`}
                      >
                        {pattern.data.difficulty}
                      </span>
                    </div>
                    <h3 class="pattern-title">{pattern.data.title}</h3>
                    <p class="pattern-summary">{pattern.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </>
    )}

    <!-- Other Categories -->
    <div class="other-categories">
      <h2 class="other-title">Other Categories</h2>
      <div class="category-grid">
        {categories.filter(c => c.slug !== slug).map(cat => (
          <a href={`/patterns/category/${cat.slug}`} class="category-link">
            <span class="cat-icon"><DynamicIcon name={cat.icon} size={20} /></span>
            <span class="cat-name">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
