---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Monitor, Gamepad2, Volume2, Move, Bot, Layers } from '@lucide/astro';

// Platform metadata
const platforms = [
  { slug: 'commodore-64', name: 'Commodore 64', color: 'var(--c64-blue)', gradient: 'linear-gradient(135deg, #3b3b8f 0%, #5555bb 50%, #7777dd 100%)' },
  { slug: 'sinclair-zx-spectrum', name: 'ZX Spectrum', color: 'var(--zx-magenta)', gradient: 'linear-gradient(135deg, #8f3b5f 0%, #bb5577 50%, #dd7799 100%)' },
  { slug: 'commodore-amiga', name: 'Commodore Amiga', color: 'var(--amiga-orange)', gradient: 'linear-gradient(135deg, #cc5200 0%, #ff6600 50%, #ff8833 100%)' },
  { slug: 'nintendo-nes', name: 'NES', color: 'var(--nes-red)', gradient: 'linear-gradient(135deg, #b30613 0%, #e30613 50%, #ff4444 100%)' },
  { slug: 'cross-platform', name: 'Cross-Platform', color: 'var(--color-primary)', gradient: 'linear-gradient(135deg, #1e3a5f 0%, #2d5a87 50%, #3d7ab5 100%)' },
];

const categories = [
  { slug: 'rendering', name: 'Rendering', icon: Monitor },
  { slug: 'input', name: 'Input', icon: Gamepad2 },
  { slug: 'audio', name: 'Audio', icon: Volume2 },
  { slug: 'physics', name: 'Physics', icon: Move },
  { slug: 'ai', name: 'AI', icon: Bot },
  { slug: 'framework', name: 'Framework', icon: Layers },
];

const difficultyColors = {
  beginner: 'var(--color-success, #22c55e)',
  intermediate: 'var(--color-warning, #f59e0b)',
  advanced: 'var(--color-error, #ef4444)',
};

export async function getStaticPaths() {
  const platforms = ['commodore-64', 'sinclair-zx-spectrum', 'commodore-amiga', 'nintendo-nes', 'cross-platform'];
  return platforms.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const platform = platforms.find(p => p.slug === slug);

if (!platform) {
  return Astro.redirect('/patterns');
}

// Get all patterns for this platform
const allPatterns = await getCollection('patterns');
const platformPatterns = allPatterns.filter(p => p.data.platform === slug);

// Group by category
const patternsByCategory = platformPatterns.reduce((acc, pattern) => {
  const category = pattern.data.category;
  if (!acc[category]) acc[category] = [];
  acc[category].push(pattern);
  return acc;
}, {} as Record<string, typeof platformPatterns>);

// Sort patterns within each category by title
Object.keys(patternsByCategory).forEach(category => {
  patternsByCategory[category].sort((a, b) => a.data.title.localeCompare(b.data.title));
});
---

<Layout
  title={`${platform.name} Patterns`}
  description={`Production-ready code patterns for ${platform.name} game development.`}
>
  <style define:vars={{ platformColor: platform.color }}>
    /* Hero Section */
    .hero {
      min-height: 250px;
      background: var(--hero-gradient);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          45deg,
          transparent,
          transparent 10px,
          rgba(255, 255, 255, 0.03) 10px,
          rgba(255, 255, 255, 0.03) 20px
        );
      pointer-events: none;
    }

    .hero-content {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
      color: white;
      padding: var(--space-8) var(--space-4);
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: -0.02em;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .hero-subtitle {
      font-size: 1.125rem;
      opacity: 0.9;
      margin-bottom: var(--space-4);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Breadcrumb */
    .breadcrumb {
      padding: var(--space-4) var(--space-4);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .breadcrumb a {
      color: var(--color-text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .breadcrumb span {
      color: var(--color-text-muted);
    }

    /* Content Section */
    .content-section {
      padding: var(--space-8) var(--space-4) var(--space-12);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    /* Category Sections */
    .category-section {
      margin-bottom: var(--space-10);
    }

    .category-header {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .category-icon {
      color: var(--platformColor);
    }

    .category-name {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .category-count {
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    /* Pattern Grid */
    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-4);
    }

    .pattern-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      position: relative;
      overflow: hidden;
    }

    .pattern-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--platformColor);
      transform: scaleX(0);
      transition: transform var(--transition-base);
    }

    .pattern-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--platformColor);
    }

    .pattern-card:hover::before {
      transform: scaleX(1);
    }

    .pattern-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-3);
    }

    .pattern-category {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pattern-difficulty {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      border-radius: 0.25rem;
      font-weight: 600;
      text-transform: capitalize;
    }

    .pattern-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .pattern-summary {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-12);
      text-align: center;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Other Platforms */
    .other-platforms {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .other-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .platform-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
    }

    .platform-link {
      display: block;
      padding: var(--space-4);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      text-align: center;
      transition: all var(--transition-base);
    }

    .platform-link:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .platform-link .plat-name {
      font-family: var(--font-family-mono);
      font-weight: 700;
      display: block;
      margin-bottom: var(--space-1);
    }

    .platform-link .plat-count {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .pattern-grid {
        grid-template-columns: 1fr;
      }

      .platform-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>

  <!-- Hero -->
  <section class="hero" style={`--hero-gradient: ${platform.gradient}`}>
    <div class="hero-content">
      <h1 class="hero-title">{platform.name}</h1>
      <p class="hero-subtitle">Production-ready patterns for {platform.name} development</p>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{platformPatterns.length}</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{Object.keys(patternsByCategory).length}</div>
          <div class="stat-label">Categories</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/patterns">Pattern Library</a>
    <span> / </span>
    <span>{platform.name}</span>
  </nav>

  <section class="content-section">
    {platformPatterns.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {platform.name} patterns yet</h2>
        <p class="empty-text">
          Patterns are being extracted from the curriculum. Check back soon or explore other platforms.
        </p>
      </div>
    ) : (
      <>
        {categories.map(cat => {
          const patterns = patternsByCategory[cat.slug] || [];
          if (patterns.length === 0) return null;
          const IconComponent = cat.icon;

          return (
            <section class="category-section">
              <div class="category-header">
                <span class="category-icon"><IconComponent size={24} /></span>
                <h2 class="category-name">{cat.name}</h2>
                <span class="category-count">{patterns.length} pattern{patterns.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="pattern-grid">
                {patterns.map(pattern => (
                  <a href={`/patterns/${pattern.slug}`} class="pattern-card">
                    <div class="pattern-meta">
                      <span class="pattern-category">{cat.name}</span>
                      <span
                        class="pattern-difficulty"
                        style={`background: color-mix(in oklab, ${difficultyColors[pattern.data.difficulty]} 15%, var(--color-surface) 85%); color: ${difficultyColors[pattern.data.difficulty]}`}
                      >
                        {pattern.data.difficulty}
                      </span>
                    </div>
                    <h3 class="pattern-title">{pattern.data.title}</h3>
                    <p class="pattern-summary">{pattern.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </>
    )}

    <!-- Other Platforms -->
    <div class="other-platforms">
      <h2 class="other-title">Other Platforms</h2>
      <div class="platform-grid">
        {platforms.filter(p => p.slug !== slug).map(plat => {
          const count = allPatterns.filter(p => p.data.platform === plat.slug).length;
          return (
            <a href={`/patterns/platform/${plat.slug}`} class="platform-link" style={`border-color: ${plat.color}`}>
              <span class="plat-name" style={`color: ${plat.color}`}>{plat.name}</span>
              <span class="plat-count">{count} pattern{count !== 1 ? 's' : ''}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
