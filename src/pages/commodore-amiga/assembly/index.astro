---
import Layout from '../../../layouts/Layout.astro';
import SystemHero from '../../../components/SystemHero.astro';
import TrackGames from '../../../components/TrackGames.astro';
import FeatureGrid from '../../../components/FeatureGrid.astro';
import { getModulesWithAvailability } from '../../../lib/modules';

const platformColor = '#ff6600';
const games = await getModulesWithAvailability('commodore-amiga', 'assembly');

const specs = [
  { label: 'CPU', value: 'MC68000' },
  { label: 'Speed', value: '7.16 MHz' },
  { label: 'RAM', value: '512 KB+' },
  { label: 'Graphics', value: 'Agnus/Denise' },
  { label: 'Sound', value: 'Paula' },
];

const features = [
  { title: 'Copper programming', description: 'Program the co-processor to change colours mid-frame, create gradient skies, and achieve effects impossible on other machines. The Copper runs in parallel with the CPU.' },
  { title: 'Blitter operations', description: 'Hardware-accelerated graphics: copy, fill, and combine bitmaps at speed. Understand DMA, channels, and how the Amiga achieves smooth scrolling and sprite movement.' },
  { title: '68000 assembly', description: 'The instruction set that powered Amiga, Atari ST, Sega Genesis, and early Macintosh. Clean orthogonal design with 32-bit registers and flexible addressing modes.' },
  { title: 'Paula audio', description: '4-channel 8-bit PCM audio at 28 kHz. Mix samples, create tracker music, and achieve sound quality that made the Amiga legendary.' },
];

const chipset = [
  { name: 'Agnus', desc: 'Blitter + Copper + DMA controller' },
  { name: 'Denise', desc: 'Video processing + sprites + playfields' },
  { name: 'Paula', desc: '4-channel audio + disk + serial I/O' },
  { name: 'Gary', desc: 'Memory management + chip select' },
];
---

<Layout
  title="Commodore Amiga – Learn 68000 Assembly Through Games"
  description="Learn Amiga 68000 assembly by building complete games. Master the custom chipset (Agnus, Denise, Paula) and the architecture that powered the ultimate 16-bit games machine."
  platformColor={platformColor}
>
  <SystemHero
    title="Amiga assembly"
    subtitle="Learn 68000 assembly by building games"
    kicker="Amiga · Assembly · 68000"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <section class="content-section">
      <h2 class="section-title">Before you begin</h2>
      <p class="section-intro">You'll need an assembler and an emulator. Both are free and take five minutes to install.</p>
      <a href="/commodore-amiga/getting-started" class="btn btn-secondary">Set up your tools →</a>
    </section>

    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Each game teaches new skills while building something you'll want to play. Start with Game 1 and work through in order — each builds on what came before.</p>
      <TrackGames games={games} platform="commodore-amiga" track="assembly" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">What you'll master</h2>
      <p class="section-intro">By the time you've built all the games, you'll have deep knowledge of Amiga hardware and 68000 assembly.</p>
      <FeatureGrid features={features} platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">Custom chipset</h2>
      <p class="section-intro">The Amiga's custom chips work in parallel, giving you hardware-accelerated graphics, sound, and I/O. This is what made the Amiga the ultimate games machine.</p>
      <div class="chipset-map">
        {chipset.map(c => (
          <div class="chipset-item"><span class="chipset-name">{c.name}</span><span class="chipset-description">{c.desc}</span></div>
        ))}
      </div>
    </section>

    <section class="content-section center">
      <h2 class="section-title">Ready to start?</h2>
      <p class="section-intro">Game 1 starts with the Copper — a coloured display built from a Copper list. By the end of Unit 1, you'll have gradient bands on screen controlled entirely by the custom chipset.</p>
      <a href="/commodore-amiga/assembly/game-01-exodus/unit-01" class="btn btn-primary">Start Game 1: Exodus →</a>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .content-section.center { text-align: center; }
  .content-section.center .section-intro { margin-left: auto; margin-right: auto; }
  .content-section.center .section-title::after { margin-left: auto; margin-right: auto; }

  .chipset-map { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
  .chipset-item { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4); background: var(--color-surface); border: 3px solid var(--color-border); border-top-width: 6px; border-top-color: var(--platform-color); }
  .chipset-name { font-family: var(--font-family-mono); font-weight: 700; font-size: 1.1rem; color: var(--ink); }
  .chipset-description { color: var(--color-text-secondary); font-size: 0.9rem; }
</style>
