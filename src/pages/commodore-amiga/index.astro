---
import Layout from '../../layouts/Layout.astro';
import { Binary, BookOpen, Terminal } from '@lucide/astro';
---

<Layout
  title="Commodore Amiga – Learn Programming Through Games"
  description="Learn Amiga programming by building complete games. Choose between AMOS BASIC for beginners or 68000 assembly for the full experience."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(180deg,
        #cc5200 0%,
        #ff6600 15%,
        #ff8833 30%,
        #ffaa55 45%,
        #ff8833 55%,
        #ff6600 70%,
        #cc5200 85%,
        #993d00 100%
      );
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Copper bar effect - iconic Amiga demo scene technique */
    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          180deg,
          transparent 0px,
          transparent 4px,
          rgba(255, 255, 255, 0.08) 4px,
          rgba(255, 255, 255, 0.08) 8px
        );
      pointer-events: none;
    }

    /* Subtle horizontal bands suggesting the Copper co-processor */
    .system-hero::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background:
        linear-gradient(180deg,
          transparent 0%,
          rgba(255, 255, 255, 0.05) 25%,
          transparent 50%,
          rgba(0, 0, 0, 0.1) 75%,
          transparent 100%
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-6);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-4);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    /* Path Cards */
    .path-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .path-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .path-card:hover {
      border-color: #ff6600;
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(255, 102, 0, 0.2);
    }

    /* Assembly path - technical appearance with subtle grid pattern */
    .path-card.recommended {
      border-color: #ff6600;
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, #ff6600 3%, var(--color-surface) 97%) 100%);
    }

    .path-card.recommended::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(90deg, rgba(255, 102, 0, 0.03) 1px, transparent 1px),
        linear-gradient(rgba(255, 102, 0, 0.03) 1px, transparent 1px);
      background-size: 20px 20px;
      pointer-events: none;
    }

    /* AMOS path - warmer, friendlier appearance */
    .path-card:not(.recommended) {
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%) 100%);
    }

    .path-badge {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-3);
      background: #ff6600;
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
    }

    .path-icon {
      color: #ff6600;
      margin-bottom: var(--space-3);
    }

    .path-title {
      font-family: var(--font-family-mono);
      font-size: 1.75rem;
      font-weight: 900;
      color: #ff6600;
      margin-bottom: var(--space-2);
    }

    .path-subtitle {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
    }

    .path-description {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: var(--space-6);
      flex-grow: 1;
    }

    .path-stats {
      display: flex;
      gap: var(--space-6);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }

    .path-stat {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 1.5rem;
      font-weight: 900;
      color: #ff6600;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      text-transform: uppercase;
    }

    .path-cta {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: #ff6600;
      color: white;
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      margin-top: var(--space-4);
      text-align: center;
    }

    .path-card:not(.recommended) .path-cta {
      background: var(--color-surface);
      border: 2px solid #ff6600;
      color: #ff6600;
    }

    /* Vault Section */
    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .vault-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
    }

    .vault-title {
      font-size: 1.5rem;
      color: var(--color-text);
    }

    .vault-link {
      color: #ff6600;
      text-decoration: none;
      font-weight: 500;
    }

    .vault-link:hover {
      text-decoration: underline;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .vault-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .vault-card:hover {
      border-color: #ff6600;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .vault-kicker {
      display: block;
      font-size: 0.7rem;
      color: #ff6600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-bottom: var(--space-1);
    }

    .vault-name {
      display: block;
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .vault-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* About Section */
    .about-section {
      padding: var(--space-10) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .about-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .about-text {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: var(--space-4);
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }

    /* Setup Callout */
    .setup-callout {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      padding: var(--space-4) var(--space-4);
      margin-top: var(--space-8);
    }

    .setup-content {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: var(--space-4);
      flex-wrap: wrap;
      justify-content: center;
    }

    .setup-icon {
      color: #22c55e;
      display: flex;
    }

    .setup-text {
      color: #cbd5e1;
      font-size: 0.95rem;
    }

    .setup-text strong {
      color: white;
    }

    .setup-text code {
      background: rgba(255, 255, 255, 0.1);
      padding: var(--space-1) var(--space-2);
      border-radius: 0.25rem;
      font-size: 0.875rem;
      margin-left: var(--space-2);
    }

    .setup-link {
      color: #22c55e;
      font-weight: 500;
      font-size: 0.95rem;
    }

    .setup-link:hover {
      color: #4ade80;
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }

      .system-specs {
        gap: var(--space-4);
      }

      .vault-header {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">COMMODORE AMIGA</h1>
      <p class="system-subtitle">Learn programming by building games</p>
      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">MC68000</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">7.16 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">512 KB+</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Graphics</div>
          <div class="spec-value">Agnus/Denise</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Sound</div>
          <div class="spec-value">Paula</div>
        </div>
      </div>
    </div>
  </section>

  <!-- About This System -->
  <section class="about-section">
    <h2 class="about-title">Why the Commodore Amiga?</h2>
    <div class="about-text">
      <p>
        The Amiga was years ahead of its time. When Commodore launched it in 1985, its custom chipset — Agnus, Denise, and Paula working in harmony — delivered capabilities that PCs wouldn't match for nearly a decade: 4096 colours, four channels of sampled audio, hardware sprites, and a preemptive multitasking operating system.
      </p>
      <p>
        Learning the Amiga means mastering the Motorola 68000, one of the most elegant processors ever designed. The same architecture powered Macintosh, Atari ST, and countless arcade machines. The Amiga's demo scene pushed the hardware to legendary extremes, and the techniques developed there — copper effects, blitter tricks, and sample-based music — remain relevant to anyone interested in graphics programming, game engines, or understanding how computers really work.
      </p>
    </div>
  </section>

  <!-- Quick Setup -->
  <section class="setup-callout">
    <div class="setup-content">
      <div class="setup-icon"><Terminal size={24} /></div>
      <div class="setup-text">
        <strong>Zero-config setup:</strong>
        <code>docker pull code198x/commodore-amiga</code>
      </div>
      <a href="/setup" class="setup-link">Full setup guide →</a>
    </div>
  </section>

  <!-- Choose Your Path -->
  <section class="content-section">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-intro">
      Two ways to learn Amiga game development. Start with AMOS if you want quick results, or dive straight into 68000 assembly for the full experience.
    </p>

    <div class="path-grid">
      <a href="/commodore-amiga/assembly" class="path-card recommended">
        <span class="path-badge">Recommended</span>
        <div class="path-icon"><Binary size={32} /></div>
        <h3 class="path-title">68000 Assembly</h3>
        <p class="path-subtitle">Full hardware control</p>
        <p class="path-description">
          Master the custom chipset: Copper for display magic, Blitter for fast graphics, and Paula for 4-channel sampled audio. This is how the best Amiga games were made.
        </p>
        <div class="path-stats">
          <div class="path-stat">
            <div class="stat-value">16</div>
            <div class="stat-label">Games</div>
          </div>
          <div class="path-stat">
            <div class="stat-value">1,920</div>
            <div class="stat-label">Units</div>
          </div>
        </div>
        <span class="path-cta">Start Assembly Path</span>
      </a>

      <a href="/commodore-amiga/amos" class="path-card">
        <div class="path-icon"><BookOpen size={32} /></div>
        <h3 class="path-title">AMOS BASIC</h3>
        <p class="path-subtitle">Gateway curriculum</p>
        <p class="path-description">
          Built-in sprite handling, BOBs, and sampled audio make impressive games achievable quickly. Build 8 complete games while understanding the custom chipset — then graduate to assembly.
        </p>
        <div class="path-stats">
          <div class="path-stat">
            <div class="stat-value">8</div>
            <div class="stat-label">Games</div>
          </div>
          <div class="path-stat">
            <div class="stat-value">512</div>
            <div class="stat-label">Units</div>
          </div>
        </div>
        <span class="path-cta">Start AMOS Path</span>
      </a>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <div class="vault-header">
        <h2 class="vault-title">From the Vault</h2>
        <a href="/vault" class="vault-link">View all articles</a>
      </div>
      <div class="vault-grid">
        <a href="/vault/systems/commodore-amiga" class="vault-card">
          <span class="vault-kicker">Hardware</span>
          <span class="vault-name">Commodore Amiga</span>
          <span class="vault-desc">Custom chips that changed multimedia computing - Agnus, Denise, and Paula working in harmony.</span>
        </a>
        <a href="/vault/culture/demo-scene-101" class="vault-card">
          <span class="vault-kicker">Culture</span>
          <span class="vault-name">Demo Scene 101</span>
          <span class="vault-desc">Art, music, and code pushed to the limit - where the Amiga truly shone.</span>
        </a>
        <a href="/vault/people/jeff-minter" class="vault-card">
          <span class="vault-kicker">People</span>
          <span class="vault-name">Jeff Minter</span>
          <span class="vault-desc">Llamas, psychedelia, and light synthesizers - from the C64 to Amiga and beyond.</span>
        </a>
        <a href="/vault/games/tempest-2000" class="vault-card">
          <span class="vault-kicker">Games</span>
          <span class="vault-name">Tempest 2000</span>
          <span class="vault-desc">Minter's masterpiece that defined what retro-inspired gaming could achieve.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
