---
import Layout from '../../layouts/Layout.astro';
import SystemHero from '../../components/SystemHero.astro';
import PathCard from '../../components/PathCard.astro';
import VaultCard from '../../components/VaultCard.astro';
import SetupCallout from '../../components/SetupCallout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { Binary, BookOpen, Zap } from '@lucide/astro';

const platformColor = '#ff6600';

const specs = [
  { label: 'CPU', value: 'MC68000' },
  { label: 'Speed', value: '7.16 MHz' },
  { label: 'RAM', value: '512 KB+' },
  { label: 'Graphics', value: 'Agnus/Denise' },
  { label: 'Sound', value: 'Paula' },
];

const assemblyStats = [
  { value: '16', label: 'Games' },
  { value: '1,920', label: 'Units' },
];

const amosStats = [
  { value: '8', label: 'Games' },
  { value: '512', label: 'Units' },
];

const blitzStats = [
  { value: '3', label: 'Games' },
  { value: '15', label: 'Primer units' },
];

const vaultArticles = [
  {
    href: '/vault/systems/commodore-amiga',
    kicker: 'Hardware',
    title: 'Commodore Amiga',
    description: 'Custom chips that changed multimedia computing - Agnus, Denise, and Paula working in harmony.',
  },
  {
    href: '/vault/communities/demo-scene-101',
    kicker: 'Culture',
    title: 'Demo Scene 101',
    description: 'Art, music, and code pushed to the limit - where the Amiga truly shone.',
  },
  {
    href: '/vault/people/jeff-minter',
    kicker: 'People',
    title: 'Jeff Minter',
    description: 'Llamas, psychedelia, and light synthesizers - from the C64 to Amiga and beyond.',
  },
  {
    href: '/vault/games/shadow-of-the-beast',
    kicker: 'Games',
    title: 'Shadow of the Beast',
    description: "Psygnosis's parallax showcase — layer upon layer of scrolling that announced what the Amiga could do.",
  },
];
---

<Layout
  title="Commodore Amiga – Learn Programming Through Games"
  description="Learn Amiga programming by building complete games. Start with AMOS or Blitz BASIC for quick results, or dive into 68000 assembly for full hardware control."
  platformColor={platformColor}
>
  <style>
    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .path-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .path-icon {
      color: var(--ink);
      margin-bottom: var(--space-3);
    }

    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .about-section {
      padding: var(--space-10) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .about-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .about-text {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: var(--space-4);
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <SystemHero
    title="Commodore Amiga"
    subtitle="A decade ahead of its time"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <!-- About This System -->
  <section class="about-section">
    <h2 class="about-title">Why the Commodore Amiga?</h2>
    <div class="about-text">
      <p>
        The Amiga was years ahead of its time. When Commodore launched it in 1985, its custom
        chipset — Agnus, Denise, and Paula working in harmony — delivered capabilities that PCs
        wouldn't match for nearly a decade: 4096 colours, four channels of sampled audio, hardware
        sprites, and a preemptive multitasking operating system.
      </p>
      <p>
        Learning the Amiga means mastering the Motorola 68000, one of the most elegant processors
        ever designed. The same architecture powered Macintosh, Atari ST, and countless arcade
        machines. The Amiga's demo scene pushed the hardware to legendary extremes, and the
        techniques developed there — copper effects, blitter tricks, and sample-based music — remain
        relevant to anyone interested in graphics programming, game engines, or understanding how
        computers really work.
      </p>
    </div>
  </section>

  <!-- Quick Setup -->
  <SetupCallout dockerImage="ghcr.io/code198x/commodore-amiga" />

  <!-- Choose Your Path -->
  <section class="content-section">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-intro">
      Three ways to learn Amiga game development. Start with AMOS or Blitz BASIC if you want quick
      results, or dive straight into 68000 assembly for the full experience.
    </p>

    <div class="path-grid">
      <PathCard
        href="/commodore-amiga/assembly"
        title="68000 Assembly"
        subtitle="Full hardware control"
        description="Master the custom chipset: Copper for display magic, Blitter for fast graphics, and Paula for 4-channel sampled audio. This is how the best Amiga games were made."
        stats={assemblyStats}
        platformColor={platformColor}
        isRecommended
        ctaText="Start Assembly Path"
      >
        <Binary size={32} class="path-icon" slot="icon" />
      </PathCard>

      <PathCard
        href="/commodore-amiga/amos"
        title="AMOS BASIC"
        subtitle="Immediate, batteries-included"
        description="Built-in sprite handling, BOBs, and sampled audio make impressive games achievable fast — interpreted and immediate. The Meet AMOS primer is complete; games follow. A peer path to Blitz, picked by temperament, not rank."
        stats={amosStats}
        platformColor={platformColor}
        ctaText="Start AMOS Path"
      >
        <BookOpen size={32} class="path-icon" slot="icon" />
      </PathCard>

      <PathCard
        href="/commodore-amiga/blitz"
        title="Blitz BASIC"
        subtitle="Compiled speed, close to the metal"
        description="Compiled Amiga BASIC that runs at full speed. Build from bitmaps, shapes and the Blitter, scroll worlds wider than the screen, and reach the chips directly — a fast, hardware-near alternative to AMOS, and the language Worms began in."
        stats={blitzStats}
        platformColor={platformColor}
        ctaText="Start Blitz Path"
      >
        <Zap size={32} class="path-icon" slot="icon" />
      </PathCard>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <SectionHeader
        title="From the Vault"
        linkHref="/vault"
        linkText="View all articles"
        platformColor={platformColor}
      />
      <div class="vault-grid">
        {vaultArticles.map((article) => (
          <VaultCard
            href={article.href}
            kicker={article.kicker}
            title={article.title}
            description={article.description}
            platformColor={platformColor}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
