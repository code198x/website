---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Commodore Amiga - Learn 68000 Assembly">
  <style>
    .system-hero {
      min-height: 400px;
      background: linear-gradient(135deg, #ff8800 0%, #ff4400 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background:
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.1) 2px,
          rgba(255, 255, 255, 0.1) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.4);
    }

    .system-subtitle {
      font-size: 1.5rem;
      margin-bottom: var(--space-6);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-6);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-16) var(--space-4);
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .coming-soon-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
      margin: var(--space-8) auto;
      max-width: 600px;
    }

    .coming-soon-icon {
      font-size: 4rem;
      margin-bottom: var(--space-4);
    }

    .coming-soon-title {
      font-size: 1.5rem;
      color: var(--color-text);
      margin-bottom: var(--space-3);
    }

    .coming-soon-text {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      color: #ff8800;
      margin-bottom: var(--space-3);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .custom-chips {
      background: var(--color-surface);
      border: 2px solid #ff8800;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
    }

    .chip-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--space-4);
      margin-top: var(--space-4);
    }

    .chip-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      padding: var(--space-3);
      text-align: center;
    }

    .chip-name {
      font-family: var(--font-family-mono);
      font-weight: bold;
      color: #ff8800;
      margin-bottom: var(--space-1);
    }

    .chip-function {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    .memory-map {
      background: var(--color-surface);
      border: 2px solid #ff8800;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
      font-family: var(--font-family-mono);
    }

    .memory-region {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .memory-region:last-child {
      border-bottom: none;
    }

    .memory-address {
      color: #ff8800;
      font-weight: bold;
    }

    .memory-description {
      color: var(--color-text-secondary);
    }

    .copper-demo {
      background: linear-gradient(
        180deg,
        #001a33 0%,
        #003366 25%,
        #0066cc 50%,
        #3399ff 75%,
        #66ccff 100%
      );
      height: 100px;
      border-radius: 0.5rem;
      margin: var(--space-4) 0;
      position: relative;
      overflow: hidden;
    }

    .copper-demo::after {
      content: 'Copper gradient effect';
      position: absolute;
      bottom: var(--space-2);
      left: 50%;
      transform: translateX(-50%);
      color: white;
      font-size: 0.875rem;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }

    @media (max-width: 768px) {
      .system-specs {
        gap: var(--space-4);
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .chip-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">COMMODORE AMIGA</h1>
      <p class="system-subtitle">The multimedia powerhouse of the 16-bit era</p>

      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">MC68000</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">7.14 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">512 KB+</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Released</div>
          <div class="spec-value">1985</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Notice -->
  <section class="content-section">
    <div class="coming-soon-card">
      <div class="coming-soon-icon">🚧</div>
      <h2 class="coming-soon-title">Lessons Coming Soon</h2>
      <p class="coming-soon-text">
        We're currently building the Amiga assembly course. Soon you'll be mastering the copper,
        blitting graphics, playing samples, and creating demo effects in 68000 assembly.
        Watch the repository for updates!
      </p>
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="content-section">
    <h2 class="section-title">What You'll Learn</h2>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">68000 Assembly</h3>
        <p class="feature-description">
          Master the powerful Motorola 68000 processor with its 32-bit registers,
          rich addressing modes, and elegant instruction set.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Copper Programming</h3>
        <p class="feature-description">
          Control the copper coprocessor for raster effects, colour gradients,
          and display tricks impossible on other platforms.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Blitter Operations</h3>
        <p class="feature-description">
          Use the blitter for lightning-fast graphics operations. Copy, fill,
          line drawing, and the famous "bobs" (blitter objects).
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Paula Audio</h3>
        <p class="feature-description">
          Four-channel digital audio with DMA playback. Create tracker music,
          play samples, and achieve CD-quality sound.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Dual Playfield</h3>
        <p class="feature-description">
          Master the dual playfield mode for parallax scrolling and
          independent background/foreground graphics layers.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Demo Effects</h3>
        <p class="feature-description">
          Create the legendary Amiga demo effects: plasma, rotozooms,
          vector balls, and unlimited bobs.
        </p>
      </div>
    </div>
  </section>

  <!-- Custom Chips -->
  <section class="content-section">
    <h2 class="section-title">The Famous Custom Chips</h2>

    <div class="custom-chips">
      <p style="text-align: center; margin-bottom: var(--space-4); color: var(--color-text-secondary);">
        The Amiga's custom chipset gave it capabilities far beyond its competitors
      </p>

      <div class="chip-grid">
        <div class="chip-card">
          <div class="chip-name">AGNUS</div>
          <div class="chip-function">Blitter & Copper</div>
        </div>
        <div class="chip-card">
          <div class="chip-name">DENISE</div>
          <div class="chip-function">Display Controller</div>
        </div>
        <div class="chip-card">
          <div class="chip-name">PAULA</div>
          <div class="chip-function">Audio & I/O</div>
        </div>
      </div>

      <p style="text-align: center; margin-top: var(--space-4); font-size: 0.875rem;">
        Example: Copper gradient effect (no CPU usage!)
      </p>
      <div class="copper-demo"></div>
    </div>
  </section>

  <!-- Memory Map Preview -->
  <section class="content-section">
    <h2 class="section-title">Amiga Memory Map</h2>

    <div class="memory-map">
      <div class="memory-region">
        <span class="memory-address">$000000-$07FFFF</span>
        <span class="memory-description">Chip RAM (512K)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$C00000-$DFFFFF</span>
        <span class="memory-description">Fast RAM (expansion)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$DFF000-$DFFFFF</span>
        <span class="memory-description">Custom Chip Registers</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$F80000-$FFFFFF</span>
        <span class="memory-description">Kickstart ROM</span>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Code Like It's 1985?</h2>
    <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6);">
      Follow the project on GitHub to be notified when Amiga lessons are available.
    </p>
    <a href="https://github.com/code198x"
       style="display: inline-block; padding: var(--space-3) var(--space-6);
              background: linear-gradient(135deg, #ff8800 0%, #ff4400 100%);
              color: white; border-radius: 0.5rem;
              text-decoration: none; font-weight: 600;">
      Watch on GitHub
    </a>
  </section>
</Layout>