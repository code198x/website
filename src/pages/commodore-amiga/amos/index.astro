---
import Layout from '../../../layouts/Layout.astro';
import { getGames } from '../../../lib/games';

const games = await getGames('commodore-amiga', 'amos');
---

<Layout
  title="Amiga AMOS BASIC – Learn Programming Through Games"
  description="Learn AMOS BASIC by building complete games. A gateway curriculum preparing you for 68000 assembly."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #ff9933 0%, #ffbb66 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      opacity: 0.6;
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--color-text-secondary);
      width: 3rem;
      text-align: center;
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .game-tagline {
      color: var(--color-text-secondary);
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-bg);
      color: var(--color-text-secondary);
      border-radius: 0.25rem;
    }

    .game-status {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    .next-step {
      background: var(--color-surface);
      border: 2px solid #ff9933;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-top: var(--space-8);
    }

    .next-step h3 {
      color: #ff9933;
      margin-bottom: var(--space-2);
    }

    @media (max-width: 768px) {
      .game-card {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .game-number { width: auto; }
      .game-skills { justify-content: center; }
    }
  </style>

  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">AMOS BASIC</h1>
      <p class="system-subtitle">Gateway curriculum — immediate results before diving into assembly</p>
    </div>
  </section>

  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      8 complete games with AMOS BASIC. Built-in sprite handling, BOBs, and sampled audio make impressive games achievable quickly. Complete this curriculum to prepare for 68000 assembly.
    </p>

    <div class="game-grid">
      {games.map((game) => (
        <a href={`/commodore-amiga/amos/${game.slug}`} class="game-card">
          <div class="game-number">{game.number}</div>
          <div class="game-info">
            <div class="game-name">{game.name}</div>
            <div class="game-tagline">{game.tagline}</div>
            <div class="game-skills">
              {game.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          <span class="game-status">Coming Soon</span>
        </a>
      ))}
    </div>

    <div class="next-step">
      <h3>After AMOS</h3>
      <p>Complete these 8 games and you'll understand sprites, BOBs, scrolling, and where AMOS struggles. Then move to <a href="/commodore-amiga/assembly">68000 Assembly</a> for Copper, Blitter, and full hardware control.</p>
    </div>
  </section>
</Layout>
