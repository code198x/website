---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 1,
    title: "Hello, Amiga World",
    description: "Open a screen, set colours, and display text using AMOS Professional.",
    status: "available"
  }
];
---

<Layout
  title="Tier 1: Discovery - Phase 0 - Amiga"
  description="Learn Amiga programming in AMOS Professional. Master screen management, colour palettes, and text display. Build programs that showcase the Amiga's legendary custom chipset."
>
  <style>
    .course-hero {
      background: linear-gradient(135deg, #ff6600 0%, #cc5200 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #ff6600;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #ff6600;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #ff6600;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(255, 102, 0, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #ff6600 0%, #cc5200 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(255, 102, 0, 0.1);
      color: #ff6600;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #ff6600 0%, #cc5200 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 102, 0, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #ff6600;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #ff6600;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .wip-notice {
      background: #fff3cd;
      border: 2px solid #ffc107;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-bottom: var(--space-8);
      color: #856404;
    }

    .wip-notice h3 {
      color: #856404;
      margin-bottom: var(--space-2);
      font-size: 1.25rem;
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 1: DISCOVERY</h1>
    <p class="course-subtitle">Phase 0 - AMOS Gateway</p>

    <p class="course-description">
      The Amiga boots into Workbench, but AMOS Professional is your gateway to game development. Learn how to open screens with multiple resolutions, control the custom chipset's colour palettes, and display text with proportional fonts. Master the blitter, copper, and Paula from structured BASIC.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Lesson (So Far)</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–25</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">AMOS</div>
        <div class="stat-label">Professional</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-amiga/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <div class="wip-notice">
      <h3>🚧 Work In Progress</h3>
      <p>
        Amiga lessons are being added incrementally. More lessons coming soon! Each lesson includes working AMOS code you can type directly into AMOS Professional or load from disk.
      </p>
    </div>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 1 introduces Amiga programming through AMOS Professional, a game-focused BASIC with built-in sprite and music editors. Unlike BASIC on other machines, AMOS is designed specifically for the Amiga's custom chipset. These lessons teach:
      </p>

      <ul>
        <li><strong>Screen Management:</strong> Screen Open with resolution, colour depth, and mode control</li>
        <li><strong>Display Modes:</strong> Lowres (320×256), Hires (640×256), HAM (4096 colours)</li>
        <li><strong>Colour Palettes:</strong> 32 colours per screen, customizable with Colour command</li>
        <li><strong>Text Display:</strong> Proportional fonts, Centre, Locate, Print commands</li>
        <li><strong>Multiple Screens:</strong> Layered screens (0-7) with independent properties</li>
        <li><strong>Bitplanes:</strong> Understanding how 1-5 bitplanes control colour depth</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 1 Goal:</strong> Master AMOS Professional's screen system and understand how the Amiga's custom chipset handles multiple displays, colour palettes, and proportional text. You'll learn why the Amiga's architecture made it the ultimate games machine of the late 80s.
      </div>

      <p>
        <strong>Prerequisites:</strong> None! Zero prior programming experience required. You'll need AMOS Professional (bundled with most Amiga emulators like FS-UAE or WinUAE). The structured BASIC syntax is beginner-friendly but powerful enough for commercial games.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-amiga/phase-0/tier-1/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Boot your Amiga (or launch FS-UAE/WinUAE), load AMOS Professional from disk, and let's write your first Amiga program!
      </p>
      <a href="/commodore-amiga/phase-0/tier-1/lesson-001" class="start-button">
        Start Lesson 1: Hello, Amiga World
      </a>
    </section>
  </div>
</Layout>
