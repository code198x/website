---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const lastUpdated = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<Layout
  title="Terms of Service"
  description="Terms of Service for Code Like It's 198x - educational platform for learning retro computing and assembly programming."
>
  <div class="legal-page">
    <div class="container">
      <SectionHeader
        title="Terms of Service"
        subtitle={`Last updated: ${lastUpdated}`}
        variant="centered"
      />

      <div class="legal-content">
        <section class="legal-section">
          <h2 class="legal-section__title">1. Acceptance of Terms</h2>
          <p class="legal-section__text">
            By accessing and using Code Like It's 198x ("the website"), you accept and agree to be
            bound by the terms and provisions of this agreement. If you do not agree to these terms,
            please do not use this website.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">2. Educational Purpose</h2>
          <p class="legal-section__text">
            This website provides educational content about retro computing, assembly programming,
            and vintage computer systems. All content is provided for learning purposes and should
            be used responsibly.
          </p>
          <p class="legal-section__text">
            The content is designed for educational use and may not be suitable for production
            environments without proper testing and validation.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">3. Open Source License</h2>
          <p class="legal-section__text">
            Unless otherwise specified, all code examples and educational content are provided under
            the MIT License. You are free to:
          </p>
          <ul class="legal-section__list">
            <li>Use the code for personal or commercial projects</li>
            <li>Modify the code to suit your needs</li>
            <li>Distribute the code with proper attribution</li>
            <li>Include the code in your own projects</li>
          </ul>
          <p class="legal-section__text">
            Please review the specific license file in our repository for complete terms.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">4. User Conduct</h2>
          <p class="legal-section__text">
            When using our website and community resources, you agree to:
          </p>
          <ul class="legal-section__list">
            <li>Use the content for lawful purposes only</li>
            <li>Respect intellectual property rights of others</li>
            <li>Not distribute malicious code or harmful content</li>
            <li>Be respectful and constructive in community interactions</li>
            <li>Follow community guidelines when participating in discussions</li>
            <li>Not attempt to access restricted areas of the website</li>
            <li>Not use automated tools to scrape or download bulk content</li>
          </ul>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">5. Intellectual Property</h2>
          <p class="legal-section__text">
            The website design, logos, and original content are property of Code Like It's 198x.
            Historical system names, logos, and trademarks mentioned in educational content remain
            the property of their respective owners and are used for educational purposes only.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">6. Disclaimer</h2>
          <p class="legal-section__text">
            The educational content on this website is provided for general information purposes
            only. Whilst we endeavour to keep the information up to date and correct, we make no
            representations or warranties of any kind about the completeness, accuracy, reliability,
            or suitability of the information.
          </p>
          <p class="legal-section__text">
            Any reliance you place on such information is strictly at your own risk. We will not be
            liable for any loss or damage including without limitation, indirect or consequential
            loss or damage arising from use of this website.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">7. Limitation of Liability</h2>
          <p class="legal-section__text">
            To the extent permitted by applicable law, we exclude all conditions, warranties,
            representations or other terms which may apply to our website or any content on it,
            whether express or implied.
          </p>
          <p class="legal-section__text">
            We will not be liable to any user for any loss or damage, whether in contract, tort
            (including negligence), breach of statutory duty, or otherwise, even if foreseeable,
            arising under or in connection with:
          </p>
          <ul class="legal-section__list">
            <li>Use of, or inability to use, our website</li>
            <li>Use of or reliance on any content displayed on our website</li>
            <li>Loss of profits, sales, business, or revenue</li>
            <li>Loss of anticipated savings</li>
            <li>Loss of goodwill or business reputation</li>
            <li>Any indirect or consequential loss or damage</li>
          </ul>
          <p class="legal-section__text">
            Nothing in these terms excludes or limits our liability for death or personal injury
            arising from our negligence, or our fraud or fraudulent misrepresentation, or any other
            liability that cannot be excluded or limited by English law.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">8. External Links</h2>
          <p class="legal-section__text">
            This website may contain links to external websites and resources. We are not
            responsible for:
          </p>
          <ul class="legal-section__list">
            <li>The content or accuracy of external websites</li>
            <li>The privacy practices of external sites</li>
            <li>Any damages or losses caused by external sites</li>
          </ul>
          <p class="legal-section__text">
            The inclusion of any link does not imply endorsement of the linked site.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">9. Contributions</h2>
          <p class="legal-section__text">
            If you contribute code, documentation, or other content to the project through GitHub or
            other means, you agree to:
          </p>
          <ul class="legal-section__list">
            <li>License your contributions under the project's open source license</li>
            <li>Warrant that you have the right to make such contributions</li>
            <li>Ensure your contributions do not infringe on any third-party rights</li>
          </ul>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">10. Privacy and Data Protection</h2>
          <p class="legal-section__text">
            Your use of this website is also governed by our <a
              href="/privacy"
              class="legal-section__link">Privacy Policy</a
            >, which describes how we collect, use, and protect your information in accordance with
            the UK General Data Protection Regulation (UK GDPR) and the Data Protection Act 2018.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">11. Modifications to Terms</h2>
          <p class="legal-section__text">
            We reserve the right to modify these terms at any time. Changes will be effective
            immediately upon posting to the website. Your continued use of the website after any
            changes constitutes acceptance of the new terms.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">12. Your Rights</h2>
          <p class="legal-section__text">
            As a consumer, you have legal rights in relation to digital content that is faulty or
            not as described. Advice about your legal rights is available from your local Citizens'
            Advice Bureau or Trading Standards office. Nothing in these terms will affect these
            legal rights.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">13. Governing Law and Jurisdiction</h2>
          <p class="legal-section__text">
            These terms of use are governed by and construed in accordance with the laws of England
            and Wales. You agree that the courts of England and Wales shall have exclusive
            jurisdiction to resolve any dispute which may arise in connection with these terms.
          </p>
        </section>

        <section class="legal-section">
          <h2 class="legal-section__title">14. Contact Information</h2>
          <p class="legal-section__text">For questions about these Terms of Service, please:</p>
          <ul class="legal-section__list">
            <li>
              Open an issue on our <a
                href="https://github.com/code198x"
                target="_blank"
                rel="noopener noreferrer"
                class="legal-section__link">GitHub repository</a
              >
            </li>
            <li>
              Join our <a href="/community" class="legal-section__link">community discussion</a>
            </li>
          </ul>
        </section>
      </div>

      <div class="legal-footer">
        <p class="legal-footer__text">
          By using Code Like It's 198x, you acknowledge that you have read, understood, and agree to
          be bound by these Terms of Service.
        </p>
        <nav class="legal-footer__nav">
          <a href="/privacy" class="legal-footer__link">Privacy Policy</a>
          <span class="legal-footer__separator">•</span>
          <a href="/sitemap" class="legal-footer__link">Sitemap</a>
          <span class="legal-footer__separator">•</span>
          <a href="/" class="legal-footer__link">Home</a>
        </nav>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ============================================
     Legal Page Styles (BEM)
     ============================================ */

  .legal-page {
    padding: var(--space-2xl) 0;
    min-height: 100vh;
    background: var(--color-bg);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .legal-content {
    margin: var(--space-2xl) 0;
  }

  /* Section Styles */
  .legal-section {
    margin-bottom: var(--space-3xl);
    position: relative;
  }

  .legal-section:not(:last-of-type)::after {
    content: "";
    display: block;
    width: 100px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-border-light) 0%, transparent 100%);
    margin: var(--space-2xl) auto;
  }

  .legal-section__title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-primary-lighter);
    position: relative;
  }

  .legal-section__title::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--color-primary);
    border-radius: var(--radius-full);
  }

  .legal-section__text {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .legal-section__text:last-child {
    margin-bottom: 0;
  }

  /* List Styles */
  .legal-section__list {
    margin: var(--space-lg) 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .legal-section__list li {
    position: relative;
    padding: var(--space-md);
    padding-left: var(--space-2xl);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-base);
    border: 1px solid var(--color-border-light);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    transition: var(--transition-base);
  }

  .legal-section__list li:hover {
    background: var(--color-surface);
    border-color: var(--color-primary-lighter);
    transform: translateX(4px);
  }

  .legal-section__list li::before {
    content: "✓";
    position: absolute;
    left: var(--space-md);
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
  }

  /* Link Styles */
  .legal-section__link {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: var(--transition-base);
  }

  .legal-section__link:hover {
    border-bottom-color: var(--color-primary);
  }

  .legal-section__link[target="_blank"]::after {
    content: " ↗";
    font-size: var(--font-size-sm);
    opacity: 0.7;
  }

  /* Footer Styles */
  .legal-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 2px solid var(--color-border);
    text-align: center;
  }

  .legal-footer__text {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }

  .legal-footer__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .legal-footer__link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: var(--transition-base);
  }

  .legal-footer__link:hover {
    color: var(--color-primary);
  }

  .legal-footer__separator {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
  }

  /* Dark Mode */
  .dark-mode .legal-section__title {
    border-bottom-color: var(--color-border);
  }

  .dark-mode .legal-section__title::after {
    background: var(--color-primary-light);
  }

  .dark-mode .legal-section__list li {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .dark-mode .legal-section__list li:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-primary-lighter);
  }

  .dark-mode .legal-section__list li::before {
    color: var(--color-primary-light);
  }

  .dark-mode .legal-footer {
    border-top-color: var(--color-border);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .container {
      padding: 0 var(--space-md);
    }

    .legal-section__title {
      font-size: var(--font-size-lg);
    }

    .legal-section__list {
      margin-left: var(--space-lg);
    }

    .legal-footer__nav {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .legal-footer__separator {
      display: none;
    }
  }
</style>
