---
/**
 * Field Notes — the hub.
 *
 * First-person narrative dev-diary: the bugs, wrong turns, and lessons from
 * building the curriculum + emulator. Data-driven cards from the `field-notes`
 * collection, sorted by `order`, each carrying its per-post platform accent.
 * Same drip gate as From the Metal.
 */
import Grid from '../../components/layout/Grid.astro';
import Layout from '../../layouts/Layout.astro';
import PageFrame from '../../components/PageFrame.astro';
import FieldNotesOpening from '../../components/FieldNotesOpening.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('field-notes')).filter((n) => !n.data.draft);
const notes = all
  .filter((n) => n.data.pubDate <= new Date())
  .sort((a, b) => a.data.order - b.data.order);
const upcoming = all.length - notes.length;
---

<Layout
  title="Field Notes"
 
  description="Stories from building Code Like It's 198x — the bugs, the wrong turns, and what the machine taught back. Long-form dispatches from the curriculum and the emulator."
>
  <FieldNotesOpening />
  <PageFrame class="wrap" opening="none">
    <Grid min="20rem" id="field-notes-stories" class="grid" style="--grid-space: var(--space-5)">
      {notes.map((n) => (
        <a class="card" href={`/field-notes/${n.id}`} style={`--accent: ${n.data.accent}`}>
          <span class="bar"></span>
          <p class="cat">{n.data.kicker}</p>
          <h2>{n.data.title}</h2>
          <p class="dek">{n.data.dek}</p>
          <p class="teaser">{n.data.teaser}</p>
          <span class="read">Read →</span>
        </a>
      ))}
    </Grid>

    {upcoming > 0 && (
      <p class="cadence">// {upcoming} more in the drafts — new notes as the build throws them up //</p>
    )}
  </PageFrame>
</Layout>

<style>@layer blocks {
  :global(main#main-content[data-site-frame]:has(> .field-notes-opening)) { max-width: none; }
  :global(main#main-content[data-site-frame]:has(> .field-notes-opening) > .wrap) {
    max-width: var(--site-frame-width); margin-inline: auto;
  }
  .grid { scroll-margin-top: 1.5rem; }
  .card {
    position: relative; display: flex; flex-direction: column;
    border: 3px solid var(--h-ink); background: var(--h-ground);    padding: var(--h-space-6) var(--space-5) var(--space-5); text-decoration: none; color: var(--h-ink);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    /* Contrast-safe accent for the "Read" label (text); bar/shadow keep raw --accent. */
    --accent-ink: color-mix(in srgb, var(--accent) 66%, black);
  }
  .card .bar { position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--accent); }
  .card:hover, .card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .cat { font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--h-ink-muted); margin: 0; }
  .card h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: 1.65rem; line-height: 1.02; letter-spacing: 0; margin: var(--h-space-2) 0 0; color: var(--h-ink); overflow-wrap: anywhere; }
  .dek { font-style: italic; font-size: 0.92rem; line-height: 1.4; color: var(--h-ink-muted); margin: var(--h-space-2) 0 0; }
  .teaser { font-size: 0.9rem; line-height: 1.5; color: var(--h-ink); margin: var(--h-space-3) 0 0; flex: 1; }
  .read { font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; color: var(--h-ink-body); margin-top: var(--h-space-4); }

  .cadence { font-family: var(--h-font-ui); font-size: 0.8125rem; letter-spacing: normal; color: var(--h-ink-muted); margin: var(--h-space-8) 0 0; font-weight: 400; }
}
</style>
