---
/**
 * Field Notes — the hub.
 *
 * First-person narrative dev-diary: the bugs, wrong turns, and lessons from
 * building the curriculum + emulator. Data-driven cards from the `field-notes`
 * collection, sorted by `order`, each carrying its per-post platform accent.
 * Same drip gate as From the Metal.
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('field-notes')).filter((n) => !n.data.draft);
const notes = all
  .filter((n) => n.data.pubDate <= new Date())
  .sort((a, b) => a.data.order - b.data.order);
const upcoming = all.length - notes.length;
---

<Layout
  title="Field Notes"
  description="Stories from building Code Like It's 198x — the bugs, the wrong turns, and what the machine taught back. Long-form dispatches from the curriculum and the emulator."
>
  <div class="wrap">
    <header class="vhead">
      <p class="eyebrow">// FIELD NOTES //</p>
      <h1>Stories from building it.</h1>
      <div class="herorule"></div>
      <p class="lede">The curriculum and the emulator get built in the open, and the
        building is where the good stories are — a race condition that turns out to be a
        sheep sliding off a hay bale, a game that can't be won because a jump is one pixel
        short, a camera that lies. These are the <span class="mk">field notes</span>: the
        bugs, the wrong turns, and what the machine taught back.</p>
    </header>

    <div class="grid">
      {notes.map((n) => (
        <a class="card" href={`/field-notes/${n.id}`} style={`--accent: ${n.data.accent}`}>
          <span class="bar"></span>
          <p class="cat">{n.data.kicker}</p>
          <h2>{n.data.title}</h2>
          <p class="dek">{n.data.dek}</p>
          <p class="teaser">{n.data.teaser}</p>
          <span class="read">Read →</span>
        </a>
      ))}
    </div>

    {upcoming > 0 && (
      <p class="cadence">// {upcoming} more in the drafts — new notes as the build throws them up //</p>
    )}
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; color: var(--color-house-2); }
  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-5); }
  .card {
    position: relative; display: flex; flex-direction: column;
    border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
    padding: var(--space-6) var(--space-5) var(--space-5); text-decoration: none; color: var(--color-text);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    /* Contrast-safe accent for the "Read" label (text); bar/shadow keep raw --accent. */
    --accent-ink: color-mix(in srgb, var(--accent) 72%, black);
  }
  :global(:root[data-theme="dark"]) .card { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .card { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  }
  .card .bar { position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--accent); }
  .card:hover, .card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .cat { font-family: var(--font-family-mono); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .card h2 { font-family: var(--font-family-read); font-weight: 700; font-size: 1.65rem; line-height: 1.02; letter-spacing: 0; margin: var(--space-2) 0 0; color: var(--color-text); }
  .dek { font-style: italic; font-size: 0.92rem; line-height: 1.4; color: var(--color-text-secondary); margin: var(--space-2) 0 0; }
  .teaser { font-size: 0.9rem; line-height: 1.5; color: var(--color-text); margin: var(--space-3) 0 0; flex: 1; }
  .read { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; color: var(--accent-ink); margin-top: var(--space-4); }

  .cadence { font-family: var(--font-family-mono); font-size: 0.78rem; letter-spacing: 0.08em; color: var(--color-text-secondary); margin: var(--space-8) 0 0; }
</style>
