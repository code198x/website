---
import { getCollection } from 'astro:content';
import FieldNotesLayout from '../../layouts/FieldNotesLayout.astro';

export async function getStaticPaths() {
  // Same drip gate as From the Metal: a future-dated note gets no page until a
  // rebuild on or after its pubDate.
  const entries = (await getCollection('field-notes'))
    .filter((entry) => entry.data.pubDate <= new Date());
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<FieldNotesLayout entry={entry} />
