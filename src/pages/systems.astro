---
/**
 * Systems - Platform overview and comparison page
 *
 * Consolidates all platform information into one destination with:
 * - Platform cards grid
 * - Quick comparison table
 * - "Which should I start with?" recommendations
 * - CPU architecture families
 * - Timeline view
 * - Coming soon platforms
 */
import Layout from '../layouts/Layout.astro';
import SystemCard from '../components/SystemCard.astro';
import {
  getActivePlatforms,
  getComingSoonPlatforms,
  getPlatformsByCpuArchitecture,
  getPlatformsByRegion,
  getPlatformsByManufacturer,
  getAllArchitectures,
  getAllManufacturers,
  getManufacturerById,
} from '../lib/platforms';

const platforms = await getActivePlatforms();
const comingSoonPlatforms = await getComingSoonPlatforms();
const byArchitecture = await getPlatformsByCpuArchitecture();
const byRegion = await getPlatformsByRegion();
const byManufacturer = await getPlatformsByManufacturer();
const architectures = await getAllArchitectures();
const manufacturers = await getAllManufacturers();

// Get all platforms for manufacturer sections
const allPlatforms = [...platforms, ...comingSoonPlatforms];

// Region display names and order
const regionInfo: Record<string, { name: string; order: number }> = {
  'US': { name: 'United States', order: 1 },
  'UK': { name: 'United Kingdom', order: 2 },
  'Japan': { name: 'Japan', order: 3 },
  'Europe': { name: 'Europe', order: 4 },
};

// Sort regions by order
const sortedRegions = Array.from(byRegion.entries())
  .sort((a, b) => (regionInfo[a[0]]?.order ?? 99) - (regionInfo[b[0]]?.order ?? 99));

// Build manufacturer data with platforms
const manufacturerData = await Promise.all(
  manufacturers.map(async (m) => {
    const mfgPlatforms = allPlatforms.filter(p => p.data.manufacturer === m.id);
    return {
      ...m,
      platforms: mfgPlatforms.sort((a, b) => a.data.year - b.data.year),
    };
  })
);

// Filter to manufacturers with platforms and sort by platform count
const activeManufacturers = manufacturerData
  .filter(m => m.platforms.length > 0)
  .sort((a, b) => b.platforms.length - a.platforms.length);

// Transform to the shape expected by SystemCard
const systems = platforms.map(p => ({
  href: `/${p.id}`,
  name: p.data.shortName.toUpperCase(),
  year: String(p.data.year),
  chip: p.data.cpu,
  tagline: p.data.tagline,
  platformColor: p.data.color,
  status: p.data.curriculumStatus ?? '',
}));

const taggedRecommendations = platforms
  .filter(platform => platform.data.recommendationTag)
  .map(platform => ({
    title: platform.data.recommendationTag ?? '',
    reason: platform.data.tagline,
    platform: {
      name: platform.data.shortName,
      color: platform.data.color,
      href: `/${platform.id}`,
    },
  }))
  .slice(0, 4);

const usedPlatformIds = new Set<string>();
const pickRecommendation = (
  title: string,
  predicate: (platform: typeof platforms[number]) => boolean
) => {
  const match = platforms.find(platform => !usedPlatformIds.has(platform.id) && predicate(platform));
  if (!match) return null;
  usedPlatformIds.add(match.id);
  return {
    title,
    reason: match.data.tagline,
    platform: {
      name: match.data.shortName,
      color: match.data.color,
      href: `/${match.id}`,
    },
  };
};

const recommendationsWithPlatforms = taggedRecommendations.length > 0
  ? taggedRecommendations
  : [
      pickRecommendation('Easiest to Learn', platform => platform.data.bits === '8' && platform.data.type === 'computer'),
      pickRecommendation('UK Heritage', platform => platform.data.region === 'UK'),
      pickRecommendation('Console Development', platform => platform.data.type === 'console'),
      pickRecommendation('Ready for a Challenge', platform => platform.data.bits !== '8'),
    ].filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation));

// Timeline data - include all platforms (active + coming-soon)
const allPlatformsForTimeline = [...platforms, ...comingSoonPlatforms];
const allYears = [...new Set(allPlatformsForTimeline.map(p => p.data.year))].sort((a, b) => a - b);
const timelineYears = allYears.map(year => ({
  year,
  platforms: allPlatformsForTimeline.filter(p => p.data.year === year),
}));

---

<Layout
  title="Systems"
  description="Compare retro gaming platforms and find the right system to start your assembly programming journey."
>
  <div class="systems-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Choose Your System</h1>
        <p class="hero-subtitle">60+ platforms. Three decades of computing history. One curriculum.</p>
        <p class="hero-intro">
          From the Altair 8800 to the PlayStation 2, from 8-bit home computers to 128-bit consoles.
          Each system shaped a generation of programmers — and we're building curricula for all of them.
        </p>
      </div>
    </section>

    <!-- Platform Cards Grid -->
    <section class="platforms-section">
      <div class="container">
        <div class="systems-grid">
          {systems.map((system, i) => (
            <SystemCard {...system} style={`animation-delay: ${i * 0.1}s`} />
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Comparison Table -->
    <section class="comparison-section">
      <div class="container">
        <h2>Quick Comparison</h2>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th></th>
                {platforms.map(p => (
                  <th style={`color: ${p.data.color}`}>{p.data.shortName}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Year</td>
                {platforms.map(p => <td>{p.data.year}</td>)}
              </tr>
              <tr>
                <td>CPU</td>
                {platforms.map(p => <td><code>{p.data.cpu}</code></td>)}
              </tr>
              <tr>
                <td>Architecture</td>
                {platforms.map(p => <td>{p.data.bits}-bit</td>)}
              </tr>
              <tr>
                <td>Region</td>
                {platforms.map(p => <td>{p.data.region}</td>)}
              </tr>
              <tr>
                <td>Assembly</td>
                {platforms.map(p => <td><code>{p.data.cpuArchitecture}</code></td>)}
              </tr>
              <tr>
                <td>Assembler</td>
                {platforms.map(p => <td>{p.data.assembler}</td>)}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Which Should I Start With? -->
    <section class="recommendations-section">
      <div class="container">
        <h2>Which Should I Start With?</h2>
        <p class="section-intro">Different platforms suit different goals. Here's our take:</p>
        <div class="recommendations-grid">
          {recommendationsWithPlatforms.map(rec => rec.platform && (
            <a href={rec.platform.href} class="recommendation-card" style={`--card-color: ${rec.platform.color}`}>
              <span class="rec-title">{rec.title}</span>
              <span class="rec-platform">{rec.platform.name}</span>
              <p class="rec-reason">{rec.reason}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore Tabs -->
    <section class="explore-section">
      <div class="container">
        <h2>Explore Platforms</h2>
        <p class="section-intro">Browse 60+ platforms by architecture, region, manufacturer, or timeline.</p>

        <!-- Tab Navigation -->
        <div class="tabs-nav" role="tablist">
          <button class="tab-btn active" role="tab" aria-selected="true" data-tab="architecture">
            Architecture
          </button>
          <button class="tab-btn" role="tab" aria-selected="false" data-tab="region">
            Region
          </button>
          <button class="tab-btn" role="tab" aria-selected="false" data-tab="manufacturer">
            Manufacturer
          </button>
          <button class="tab-btn" role="tab" aria-selected="false" data-tab="timeline">
            Timeline
          </button>
          <button class="tab-btn" role="tab" aria-selected="false" data-tab="roadmap">
            Roadmap
          </button>
        </div>

        <!-- Tab Panels -->
        <div class="tabs-content">
          <!-- Architecture Tab -->
          <div class="tab-panel active" id="tab-architecture" role="tabpanel">
            <p class="tab-intro">
              Learn one chip, and your skills transfer to others in the same family.
            </p>
            <div class="architecture-grid">
              {architectures.map(arch => {
                const archPlatforms = byArchitecture.get(arch.id) || [];
                return archPlatforms.length > 0 && (
                  <div class="architecture-card">
                    <h3>{arch.data.name}</h3>
                    <p class="arch-description">{arch.data.description}</p>
                    <ul class="arch-platforms">
                      {archPlatforms.map(p => (
                        <li>
                          <a
                            href={p.data.status === 'active' ? `/${p.id}` : undefined}
                            style={`color: ${p.data.color}`}
                            class={p.data.status === 'coming-soon' ? 'coming-soon' : ''}
                          >
                            {p.data.name}
                          </a>
                          <span class="chip-name">({p.data.cpu})</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Region Tab -->
          <div class="tab-panel" id="tab-region" role="tabpanel">
            <p class="tab-intro">
              The golden age of computing happened differently around the world.
            </p>
            <div class="region-grid">
              {sortedRegions.map(([region, regionPlatforms]) => (
                <div class="region-card">
                  <h3>{regionInfo[region]?.name ?? region}</h3>
                  <span class="region-count">{regionPlatforms.length} platforms</span>
                  <ul class="region-platforms">
                    {regionPlatforms.slice(0, 8).map(p => (
                      <li>
                        <a
                          href={p.data.status === 'active' ? `/${p.id}` : undefined}
                          style={`color: ${p.data.color}`}
                          class={p.data.status === 'coming-soon' ? 'coming-soon' : ''}
                        >
                          {p.data.shortName}
                        </a>
                      </li>
                    ))}
                    {regionPlatforms.length > 8 && (
                      <li class="more-count">+{regionPlatforms.length - 8} more</li>
                    )}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <!-- Manufacturer Tab -->
          <div class="tab-panel" id="tab-manufacturer" role="tabpanel">
            <p class="tab-intro">
              From garage startups to global giants — every platform has a story.
            </p>

            <!-- World Map (Leaflet) -->
            <div class="world-map-container">
              <div id="manufacturer-map"></div>
              <p class="map-caption">Click markers for details. Scroll to zoom, drag to pan.</p>
            </div>

            <div id="manufacturer-data" data-manufacturers={JSON.stringify(activeManufacturers.map(m => ({
              name: m.data.name,
              shortName: m.data.shortName,
              city: m.data.city,
              country: m.data.country,
              lat: m.data.coordinates.lat,
              lng: m.data.coordinates.lng,
              color: m.data.color || '#4a9eff',
              platformCount: m.platforms.length,
              platforms: m.platforms.slice(0, 6).map(p => ({
                name: p.data.shortName,
                color: p.data.color,
                url: p.data.status === 'active' ? `/${p.id}` : null
              }))
            })))} style="display: none;" />

            <!-- Manufacturer Cards Grid -->
            <div class="manufacturer-grid">
              {activeManufacturers.slice(0, 12).map(m => (
                <div class="manufacturer-card" style={`--mfg-color: ${m.data.color || 'var(--color-primary)'}`}>
                  <div class="mfg-header">
                    <h3>{m.data.shortName}</h3>
                    <span class="mfg-location">{m.data.city}, {m.data.country}</span>
                  </div>
                  <div class="mfg-platforms">
                    {m.platforms.slice(0, 6).map(p => (
                      <a
                        href={p.data.status === 'active' ? `/${p.id}` : undefined}
                        class={`mfg-platform ${p.data.status === 'coming-soon' ? 'coming-soon' : ''}`}
                        style={`--platform-color: ${p.data.color}`}
                      >
                        {p.data.shortName}
                      </a>
                    ))}
                    {m.platforms.length > 6 && (
                      <span class="mfg-more">+{m.platforms.length - 6}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
            {activeManufacturers.length > 12 && (
              <p class="more-manufacturers">
                Plus {activeManufacturers.length - 12} more manufacturers on the roadmap.
              </p>
            )}
          </div>

          <!-- Timeline Tab -->
          <div class="tab-panel" id="tab-timeline" role="tabpanel">
            <div class="timeline">
              {timelineYears.map(({ year, platforms: yearPlatforms }) => yearPlatforms.length > 0 && (
                <div class="timeline-year">
                  <span class="year-label">{year}</span>
                  <div class="year-platforms">
                    {yearPlatforms.map(p => (
                      <a
                        href={p.data.status === 'active' ? `/${p.id}` : undefined}
                        class={`timeline-platform ${p.data.status === 'coming-soon' ? 'coming-soon' : ''}`}
                        style={`--platform-color: ${p.data.color}`}
                      >
                        <span class="platform-name">{p.data.shortName}</span>
                        <span class="platform-region">{p.data.region}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Roadmap Tab -->
          <div class="tab-panel" id="tab-roadmap" role="tabpanel">
            <p class="tab-intro">Future platforms we're planning to support:</p>
            <div class="coming-soon-grid">
              {comingSoonPlatforms.map(platform => (
                <div class="coming-soon-card">
                  <span class="cs-name">{platform.data.name}</span>
                  <span class="cs-meta">{platform.data.year} · {platform.data.region}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="/scripts/manufacturer-map.js" defer></script>
  <script>
    // Tab switching logic
    document.addEventListener('DOMContentLoaded', () => {
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tabId = btn.dataset.tab;

          // Update buttons
          tabBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          // Update panels
          tabPanels.forEach(panel => {
            panel.classList.remove('active');
          });
          const targetPanel = document.getElementById(`tab-${tabId}`);
          if (targetPanel) {
            targetPanel.classList.add('active');
          }

          // Fix map rendering when manufacturer tab is shown
          if (tabId === 'manufacturer') {
            setTimeout(() => {
              const mapEl = document.getElementById('manufacturer-map');
              if (mapEl && mapEl._leafletMap) {
                mapEl._leafletMap.invalidateSize();
              }
            }, 100);
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .systems-page {
    padding-bottom: var(--space-16);
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Hero */
  .hero {
    padding: var(--space-16) var(--space-4) var(--space-12);
    text-align: center;
    background: linear-gradient(
      180deg,
      var(--color-bg-secondary) 0%,
      var(--color-bg) 100%
    );
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: 3rem;
    font-weight: 900;
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6);
    font-style: italic;
  }

  .hero-intro {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Platform Cards Grid */
  .platforms-section {
    padding: var(--space-8) 0;
  }

  .systems-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 1024px) {
    .systems-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .systems-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Section Headings */
  section h2 {
    font-size: 2rem;
    margin: 0 0 var(--space-4);
    text-align: center;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }

  /* Comparison Table */
  .comparison-section {
    padding: var(--space-12) 0;
    background: var(--color-surface);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .comparison-section table {
    width: 100%;
    min-width: 600px;
  }

  .comparison-section th:first-child,
  .comparison-section td:first-child {
    text-align: left;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .comparison-section th:not(:first-child),
  .comparison-section td:not(:first-child) {
    text-align: center;
  }

  .comparison-section th:not(:first-child) {
    font-weight: 700;
    font-size: 1.1rem;
  }

  /* Recommendations */
  .recommendations-section {
    padding: var(--space-12) 0;
  }

  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .recommendations-grid {
      grid-template-columns: 1fr;
    }
  }

  .recommendation-card {
    display: block;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all var(--transition-base);
    border-left: 4px solid var(--card-color);
  }

  .recommendation-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--card-color);
  }

  .rec-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .rec-platform {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--card-color);
    margin-bottom: var(--space-3);
  }

  .rec-reason {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Explore Tabs Section */
  .explore-section {
    padding: var(--space-12) 0;
    background: var(--color-bg-secondary);
  }

  .tabs-nav {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .tab-btn {
    padding: var(--space-3) var(--space-6);
    background: transparent;
    border: 2px solid var(--color-border);
    border-radius: 2rem;
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .tab-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tab-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .tabs-content {
    min-height: 400px;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tab-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }

  @media (max-width: 600px) {
    .tab-btn {
      padding: var(--space-2) var(--space-4);
      font-size: 0.85rem;
    }
  }

  /* Architecture Grid */
  .architecture-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 1200px) {
    .architecture-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .architecture-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .architecture-grid {
      grid-template-columns: 1fr;
    }
  }

  .architecture-card {
    background: var(--color-surface);
    padding: var(--space-6);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .architecture-card h3 {
    font-size: 1.25rem;
    margin: 0 0 var(--space-3);
    font-family: var(--font-family-mono);
  }

  .arch-description {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }

  .arch-platforms {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .arch-platforms li {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-border-light);
  }

  .arch-platforms a {
    font-weight: 600;
  }

  .arch-platforms a.coming-soon {
    opacity: 0.5;
    cursor: default;
  }

  .chip-name {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-left: var(--space-2);
  }

  /* Timeline */
  .timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    padding-left: 100px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 80px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-year {
    position: relative;
    padding: var(--space-6) 0;
  }

  .timeline-year::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    background: var(--color-primary);
    border-radius: 50%;
    border: 3px solid var(--color-bg);
  }

  .year-label {
    position: absolute;
    left: -100px;
    top: 50%;
    transform: translateY(-50%);
    font-weight: 800;
    font-size: 1.25rem;
    font-family: var(--font-family-mono);
    color: var(--color-text-muted);
  }

  .year-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .timeline-platform {
    display: inline-flex;
    flex-direction: column;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 2px solid var(--platform-color);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .timeline-platform:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--platform-color) 30%, transparent);
  }

