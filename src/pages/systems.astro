---
/**
 * The Fleet — /systems/
 *
 * Synthesis rebuild from docs/design/synthesis/fleet.html. The density test:
 * every machine we mean to teach, honestly tiered. Status is the primary visual
 * language; system colour appears only on active (live/next) machines, tying
 * "has colour" to "has content". Three lenses over one dataset — decade, maker,
 * tier — prove the "views, not templates" decision. Nothing here ever 404s.
 *
 * Data comes from the platforms manifest (+ the new `tier` field) and the
 * manufacturers collection for maker display names. The board is rendered
 * client-side from a serialised fleet array so the three lenses are a live toggle.
 */
import Layout from '../layouts/Layout.astro';
import { getAllPlatforms, getAllManufacturers } from '../lib/platforms';

const platforms = await getAllPlatforms();
const manufacturers = await getAllManufacturers();

const makerName = new Map(manufacturers.map(m => [m.id, m.data.shortName]));

const REGION_CODE: Record<string, string> = {
  US: 'US', UK: 'UK', Japan: 'JP', Europe: 'EU', Netherlands: 'NL',
};
const KIND: Record<string, string> = {
  computer: 'home', console: 'console', handheld: 'handheld',
};

// [year, slug, name, kind, maker, tier, country, color]
const fleet = platforms
  .map(p => [
    p.data.year,
    p.id,
    p.data.shortName,
    KIND[p.data.type] ?? p.data.type,
    makerName.get(p.data.manufacturer) ?? p.data.manufacturer,
    p.data.tier ?? 'planned',
    REGION_CODE[p.data.region] ?? p.data.region,
    p.data.color,
  ] as const)
  .sort((a, b) => a[0] - b[0]);

const tierCount = (t: string) => fleet.filter(e => e[5] === t).length;
const counts = {
  total: fleet.length,
  live: tierCount('live'),
  next: tierCount('next'),
  planned: tierCount('planned'),
  edge: tierCount('edge'),
  beyond: tierCount('beyond'),
};
---

<Layout
  title="The Fleet"
  description="Every machine we mean to teach, honestly tiered. The methodology proves out on the Spectrum, generalises across the home-computer fleet, and breaks honestly outside its domain."
>
  <div class="wrap">
    <div class="eyebrow">The whole runway · 1975 → 2005</div>
    <h1>The fleet.</h1>
    <div class="herorule"></div>
    <p class="intro">Every machine we mean to teach, eventually. The methodology proves out on
      <b>the Spectrum</b>, generalises cleanly across the home-computer fleet, strains at the
      vector and 3D-first edges, and breaks honestly outside its domain. Nothing here ever 404s —
      a machine with no lessons yet is a real page with a date and a subscribe box.</p>
    <p class="summary" set:html={
      `<b>${counts.total}</b> machines · <b>${counts.live}</b> live · <b>${counts.next}</b> next · ` +
      `<b>${counts.planned}</b> planned · <b>${counts.edge}</b> edge · <b>${counts.beyond}</b> beyond`
    } />

    <div class="controls">
      <div class="legend">
        <span class="sw"><i class="live"></i> Live</span>
        <span class="sw"><i class="next"></i> Next</span>
        <span class="sw"><i class="planned"></i> Planned</span>
        <span class="sw"><i class="edge"></i> Edge of domain</span>
        <span class="sw"><i class="beyond"></i> Beyond</span>
      </div>
      <div class="tabs">
        <button data-view="decade" class="on">By decade</button>
        <button data-view="maker">By maker</button>
        <button data-view="tier">By tier</button>
      </div>
    </div>

    <div class="board decade" id="board"></div>

    <div class="foot">
      <span>{counts.live} live · the rest honestly tiered</span>
      <span>Free · open source · forever</span>
    </div>
  </div>

  <script is:inline define:vars={{ fleet }}>
    const SYS_TIERS = new Set(['live', 'next']);
    const STAMP = { live: 'LIVE', next: 'NEXT' };

    function pill(e) {
      const [year, slug, name, kind, maker, tier, ctry, color] = e;
      const active = SYS_TIERS.has(tier) && color;
      const d = document.createElement('a');
      d.className = 'pill ' + tier + (active ? ' active' : '');
      d.href = '/' + slug;
      if (active) d.style.borderLeftColor = color;
      d.innerHTML =
        (STAMP[tier] ? `<span class="stamp ${tier === 'next' ? 'next' : ''}">${STAMP[tier]}</span>` : '') +
        `<div class="top"><span>${year} · ${maker}</span><span class="ctry">${ctry}</span></div>` +
        `<div class="name">${name}</div><div class="kind">${kind}</div>`;
      return d;
    }
    function column(title, sub, items, blurb) {
      const c = document.createElement('div'); c.className = 'col';
      const h = document.createElement('div'); h.className = 'chead';
      h.innerHTML = `<span class="t">${title}</span><span class="n">${sub}</span>` + (blurb ? `<span class="blurb">${blurb}</span>` : '');
      const s = document.createElement('div'); s.className = 'stack';
      items.forEach(e => s.appendChild(pill(e)));
      c.appendChild(h); c.appendChild(s); return c;
    }
    function render(view) {
      const board = document.getElementById('board');
      if (!board) return;
      board.className = 'board ' + view; board.innerHTML = '';
      if (view === 'decade') {
        const decs = [['1975–79', 1975, 1979, 'genesis'], ['1980–84', 1980, 1984, 'home-computer boom'],
          ['1985–89', 1985, 1989, 'where the curriculum lives'], ['1990–94', 1990, 1994, '16-bit · the bridge'],
          ['1995–99', 1995, 1999, 'edge of the canon'], ['2000–05', 2000, 2005, 'the strain test']];
        decs.forEach(([lbl, lo, hi, bl]) => {
          const items = fleet.filter(e => e[0] >= lo && e[0] <= hi);
          board.appendChild(column(lbl, items.length, items, bl));
        });
      } else if (view === 'tier') {
        const tiers = [['live', 'Live', 'shipping now'], ['next', 'Next', 'validated, in build'],
          ['planned', 'Planned', 'skeleton + subscribe'], ['edge', 'Edge', 'strains the method'], ['beyond', 'Beyond', 'outside the canon']];
        tiers.forEach(([st, lbl, bl]) => {
          const items = fleet.filter(e => e[5] === st).sort((a, b) => a[0] - b[0]);
          board.appendChild(column(lbl, items.length, items, bl));
        });
      } else { // maker
        const makers = [...new Set(fleet.map(e => e[4]))]
          .map(m => [m, fleet.filter(e => e[4] === m).sort((a, b) => a[0] - b[0])])
          .sort((a, b) => b[1].length - a[1].length);
        makers.forEach(([m, items]) => board.appendChild(column(m, items.length, items)));
      }
    }
    function viewFromUrl() {
      const v = new URLSearchParams(location.search).get('by');
      return (v === 'maker' || v === 'tier') ? v : 'decade';
    }
    function setActive(tabs, view) {
      tabs.forEach(x => x.classList.toggle('on', x.dataset.view === view));
    }
    function wire() {
      const tabs = document.querySelectorAll('.tabs button');
      if (!tabs.length) return;
      tabs.forEach(b => b.addEventListener('click', () => {
        const view = b.dataset.view;
        setActive(tabs, view);
        render(view);
        // Keep the view in the URL so a lens is linkable/shareable (IA v3 §6).
        const url = view === 'decade' ? location.pathname : `${location.pathname}?by=${view}`;
        history.replaceState(null, '', url);
      }));
      const initial = viewFromUrl();
      setActive(tabs, initial);
      render(initial);
    }
    document.addEventListener('astro:page-load', wire);
  </script>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-5) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .wrap h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(3.2rem, 8vw, 4.6rem); line-height: 0.86; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 240px; background: var(--color-house); position: relative; margin-top: var(--space-2); }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .intro { font-size: 0.95rem; max-width: 78ch; margin: var(--space-3) 0 0; color: var(--color-text); }
  .intro b { color: var(--color-house-2); }
  .summary { font-family: var(--font-family-mono); font-size: 0.75rem; color: var(--color-text-secondary); margin-top: var(--space-2); letter-spacing: 0.03em; }
  .summary b { color: var(--color-text); }

  /* legend + view toggle */
  .controls { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-4); padding-bottom: var(--space-3); border-bottom: 3px solid var(--color-text); }
  .legend { display: flex; gap: var(--space-3); flex-wrap: wrap; font-family: var(--font-family-mono); font-size: 0.66rem; letter-spacing: 0.04em; color: var(--color-text-secondary); align-items: center; }
  .legend .sw { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 16px; height: 12px; display: inline-block; border: 2px solid var(--color-text); background: var(--color-surface); }
  .legend i.live { box-shadow: 2px 2px 0 rgb(0 0 0 / 0.2); }
  .legend i.next { background: var(--color-house-tint); }
  .legend i.planned { border-color: var(--color-border); }
  .legend i.edge { border-style: dashed; border-color: var(--color-text-secondary); opacity: 0.7; }
  .legend i.beyond { border-style: dashed; border-color: var(--color-text-muted); opacity: 0.5; }
  .tabs { margin-left: auto; display: flex; gap: 0; }
  .tabs button { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 8px 13px; border: 3px solid var(--color-text); background: var(--color-surface); color: var(--color-text); cursor: pointer; border-right-width: 0; }
  .tabs button:last-child { border-right-width: 3px; }
  .tabs button.on { background: var(--color-house); color: #f6efe2; }

  /* board */
  .board { display: grid; gap: var(--space-4); margin-top: var(--space-4); align-items: start; }
  .board.decade { grid-template-columns: repeat(6, 1fr); }
  .board.tier { grid-template-columns: repeat(5, 1fr); }
  .board.maker { grid-template-columns: repeat(auto-fill, minmax(185px, 1fr)); }
  /* Column + pill rules live in the global block below (#board …) because the
     board is rendered client-side; Astro-scoped selectors don't match
     JS-created elements. */

  .foot { margin-top: var(--space-8); border-top: 3px solid var(--color-text); padding-top: var(--space-4); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);
    font-family: var(--font-family-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); }

  @media (max-width: 1000px) { .board.decade { grid-template-columns: repeat(3, 1fr); } .board.tier { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .board.decade, .board.tier { grid-template-columns: repeat(2, 1fr); } .wrap h1 { font-size: 3rem; } }
</style>

<!-- Board internals are rendered client-side, so they can't use Astro-scoped
     styles. Namespaced under the unique #board id to avoid leaking generic
     class names (.pill, .col, .stack) to other pages. -->
<style is:global>
  #board .col .chead { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; border-bottom: 2px solid var(--color-text); padding-bottom: 4px; margin-bottom: 8px; }
  #board .col .chead .t { font-family: var(--font-family-script); font-weight: 700; font-size: 1.5rem; line-height: 1; }
  #board .col .chead .n { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); }
  #board .col .chead .blurb { font-family: var(--font-family-mono); font-size: 0.56rem; letter-spacing: 0.06em; color: var(--color-text-secondary); text-transform: uppercase; width: 100%; margin-top: 2px; }
  #board .stack { display: flex; flex-direction: column; gap: 7px; }

  #board .pill { border: 2px solid var(--color-text); background: var(--color-surface); padding: 6px 8px 7px; position: relative; text-decoration: none; color: var(--color-text); display: block; transition: transform var(--transition-base), box-shadow var(--transition-base); }
  #board .pill:hover, #board .pill:focus-visible { transform: translate(-2px, -2px); box-shadow: var(--shadow-chunky); }
  #board .pill .top { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-family-mono); font-size: 0.56rem; color: var(--color-text-secondary); }
  #board .pill .ctry { background: rgb(26 24 20 / 0.08); padding: 0 4px; letter-spacing: 0.05em; }
  #board .pill .name { font-weight: 700; font-size: 0.84rem; line-height: 1.05; margin-top: 2px; }
  #board .pill .kind { font-family: var(--font-family-mono); font-size: 0.5rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin-top: 2px; }
  #board .pill.live { border-width: 3px; box-shadow: var(--shadow-chunky); }
  #board .pill.next { background: var(--color-house-tint); }
  #board .pill.planned { border-color: var(--color-border); }
  #board .pill.edge { border-style: dashed; border-color: var(--color-text-secondary); }
  #board .pill.beyond { border-style: dashed; border-color: var(--color-border); }
  #board .pill.edge .name, #board .pill.beyond .name { color: var(--color-text-secondary); font-weight: 600; }
  #board .pill.active { border-left-width: 6px; }   /* system colour only on live/next */
  #board .pill .stamp { position: absolute; top: -9px; right: -5px; font-family: var(--font-family-mono); font-size: 0.5rem; font-weight: 700; letter-spacing: 0.1em;
    padding: 1px 5px; border: 2px solid var(--color-text); background: var(--color-surface); transform: rotate(5deg); }
  #board .pill .stamp.next { border-color: var(--color-house-2); color: var(--color-house-2); transform: rotate(-5deg); }
</style>
