---
import Layout from '../layouts/Layout.astro';
import FleetBoard from '../components/FleetBoard.astro';
import SystemsOpening from '../components/SystemsOpening.astro';
---

<Layout
 
  title="Systems"
  description="Browse Code198x systems, find available lessons, and explore planned coverage and reference material."
>
  <SystemsOpening />
  <FleetBoard view="decade" showOpening={false} />
</Layout>

<style>@layer blocks {
  :global(main#main-content[data-site-frame]:has(> .systems-opening)) { max-width: none; }
  :global(main#main-content[data-site-frame]:has(> .systems-opening) > .systems-directory) {
    max-width: var(--site-frame-width); margin-inline: auto;
  }
}
</style>
