---
import Layout from '../../layouts/Layout.astro';
import SystemHero from '../../components/SystemHero.astro';
import VaultCard from '../../components/VaultCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { getModulesWithCounts } from '../../lib/modules';
import { getPlatformBySlug } from '../../lib/platforms';

const platformColor = '#cc0000';
const SPECTRUM = 'sinclair-zx-spectrum';

// Every number on this page derives from the catalogues (modules + units +
// vault collections) so the event page can't drift from what is actually live.
// See decisions/state-lives-in-catalogues.md.
const assembly = await getModulesWithCounts(SPECTRUM, 'assembly');
const basic = await getModulesWithCounts(SPECTRUM, 'basic');
const isComplete = (m: { status: string }) => m.status === 'complete';
const isGame = (m: { kind: string }) => m.kind === 'game';
const assemblyLive = assembly.filter(isComplete);
const basicLive = basic.filter(isComplete);
const gamesLive = [...assemblyLive, ...basicLive].filter(isGame).length;
const unitsLive = [...assemblyLive, ...basicLive].reduce((sum, m) => sum + m.unitsAvailable, 0);
const gamesComing = [...assembly, ...basic].filter((m) => !isComplete(m)).length;
const vaultCount = (await getCollection('vault')).length;
const fmt = (n: number) => n.toLocaleString('en-GB');

const specs = [
  { label: 'PLATFORM', value: 'ZX Spectrum' },
  { label: 'GAMES LIVE', value: String(gamesLive) },
  { label: 'UNITS LIVE', value: String(unitsLive) },
  { label: 'VAULT', value: `${fmt(vaultCount)} entries` },
  { label: 'LAUNCH', value: 'October 2026' },
];

// The games wall: one tile per complete Spectrum module. Where the catalogue
// carries no thumbnail, the final unit's screenshot stands in.
const fallbackShot: Record<string, string> = {
  'bright-spark': '/images/sinclair-zx-spectrum/basic/bright-spark/unit-06/screenshot.png',
  cipher: '/images/sinclair-zx-spectrum/basic/cipher/unit-06/screenshot.png',
  crates: '/images/sinclair-zx-spectrum/basic/crates/unit-06/screenshot.png',
  'dice-roller': '/images/sinclair-zx-spectrum/basic/dice-roller/unit-05/screenshot.png',
  'hi-lo': '/images/sinclair-zx-spectrum/basic/hi-lo/unit-06/screenshot.png',
  locksmith: '/images/sinclair-zx-spectrum/basic/locksmith/unit-06/screenshot.png',
  'quiz-master': '/images/sinclair-zx-spectrum/basic/quiz-master/unit-06/screenshot.png',
  reflex: '/images/sinclair-zx-spectrum/basic/reflex/unit-06/screenshot.png',
  sonar: '/images/sinclair-zx-spectrum/basic/sonar/unit-06/screenshot.png',
  'story-builder': '/images/sinclair-zx-spectrum/basic/story-builder/unit-07/screenshot.png',
  'the-caverns': '/images/sinclair-zx-spectrum/basic/the-caverns/unit-06/screenshot.png',
  'three-in-a-row': '/images/sinclair-zx-spectrum/basic/three-in-a-row/unit-06/screenshot.png',
  touchdown: '/images/sinclair-zx-spectrum/basic/touchdown/unit-08/screenshot.png',
  yearfall: '/images/sinclair-zx-spectrum/basic/yearfall/unit-06/screenshot.png',
  shadowkeep: '/images/sinclair-zx-spectrum/assembly/shadowkeep/unit-19/step-01-title.png',
};
const tile = (track: 'assembly' | 'basic') => (m: (typeof assembly)[number]) => ({
  href: `/${SPECTRUM}/${track}/${m.slug}`,
  title: m.name,
  track: isGame(m)
    ? (track === 'assembly' ? 'Z80' : 'BASIC')
    : `Primer · ${track === 'assembly' ? 'Z80' : 'BASIC'}`,
  units: m.unitsAvailable,
  shot: m.thumbnail ?? fallbackShot[m.slug],
});
const wall = [...assemblyLive.map(tile('assembly')), ...basicLive.map(tile('basic'))];

// The family strip: the four live machines, Spectrum first, each with its
// first complete game on screen and its shipped-module count.
const familyDefs = [
  { slug: SPECTRUM, game: 'Gloaming', shot: '/images/sinclair-zx-spectrum/assembly/gloaming/unit-19/step-01-title.png' },
  { slug: 'commodore-64', game: 'Starfield', shot: '/images/commodore-64/assembly/starfield/unit-15/screenshot.png' },
  { slug: 'nintendo-entertainment-system', game: 'Dash', shot: '/images/nintendo-entertainment-system/assembly/dash/unit-17/screenshot.png' },
  { slug: 'commodore-amiga', game: 'Flock', shot: '/images/commodore-amiga/assembly/flock/unit-18/screenshot.png' },
];
// Complete *games* per platform — the same unit the hero counts, so the two
// figures can't appear to contradict each other.
const allModuleEntries = await getCollection('modules');
const countFor = (platform: string, pick: (m: { kind: string }) => boolean) =>
  allModuleEntries
    .filter((e) => e.data.platform === platform)
    .reduce((n, e) => n + e.data.modules.filter((m) => isComplete(m) && pick(m)).length, 0);

const family = await Promise.all(
  familyDefs.map(async (d) => {
    const p = await getPlatformBySlug(d.slug);
    if (!p) throw new Error(`crash-live: unknown platform ${d.slug}`);
    return {
      ...d,
      href: `/${d.slug}`,
      name: p.data.name,
      cpu: p.data.cpu,
      color: p.data.color,
      games: countFor(d.slug, isGame),
      primers: countFor(d.slug, (m) => !isGame(m)),
    };
  })
);

const tools = [
  {
    href: 'https://emu198x.github.io/',
    kicker: 'Emu198x',
    title: 'Thirty systems, one emulator suite',
    description: 'Rust emulators for 30 machines, six with a native window. Scriptable, headless capture, an MCP server on every one. Every screenshot and clip on this site came out of it.',
  },
  {
    href: 'https://asm198x.github.io/',
    kicker: 'Asm198x',
    title: 'One assembler, the dialects you know',
    description: 'A single binary that assembles and disassembles twenty-odd CPUs and speaks acme, ca65, pasmo, sjasmplus, vasm and lwasm, validated byte-for-byte. There is a playground in your browser.',
  },
];

const vaultPicks = [
  {
    href: '/vault/magazines/crash-magazine',
    kicker: 'Magazines',
    title: 'CRASH',
    description: "Newsfield's flagship Spectrum monthly — the voice this project's writing was calibrated against.",
  },
  {
    href: '/vault/people/oliver-frey',
    kicker: 'People',
    title: 'Oliver Frey',
    description: 'Swiss-born British illustrator whose CRASH and Zzap!64 covers gave the 8-bit era its visual identity.',
  },
  {
    href: '/vault/people/tim-follin',
    kicker: 'People',
    title: 'Tim Follin',
    description: 'Composer who made the Spectrum beeper sound like prog rock. Stormlord, Cybernoid II, Black Lamp.',
  },
  {
    href: '/vault/companies/newsfield',
    kicker: 'Companies',
    title: 'Newsfield Publications',
    description: "Roger Kean and Oliver Frey's Ludlow magazine publisher — CRASH, Zzap!64, Amtix!.",
  },
  {
    href: '/vault/phenomena/bedroom-coder',
    kicker: 'Culture',
    title: 'The Bedroom Coder',
    description: 'How a generation of British teenagers shipped commercial games from their bedrooms — the model this project revives.',
  },
  {
    href: '/vault/culture/poke-culture',
    kicker: 'Culture',
    title: 'POKE Culture',
    description: 'The reverse-engineering pastime CRASH Tips and YS Tipshop turned into community ritual.',
  },
];
---

<Layout
  title="Code Like It's 198x — Welcome from CRASH! Live"
  description={`Code Like It's 198x teaches ZX Spectrum game development on the platform itself: ${gamesLive} complete games across BASIC and Z80 assembly, ${unitsLive} units live, and a ${fmt(vaultCount)}-entry reference Vault. Welcome to the project's CRASH! Live launch.`}
  platformColor={platformColor}
>
  <style>
    /* Spectrum-red event landing, in the house style: square corners, 3px
       borders, chunky offset shadows. Colours come from the theme tokens so it
       works light and dark; the fixed red is the event's own accent. */
    .crash-live-page { --platform-color: #cc0000; --accent-fg: #cc0000; }
    /* Small red text (kickers, CTAs, links) is only 2.75:1 on the dark cards in dark
       mode — brighten it there so it clears AA. */
    :global(:root[data-theme="dark"]) .crash-live-page { --accent-fg: #ef6b66; }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme])) .crash-live-page { --accent-fg: #ef6b66; }
    }

    .chunky-btn {
      display: inline-block; font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 12px 18px; border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky); text-decoration: none;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
    }
    .chunky-btn.primary { background: var(--platform-color); color: #fff; }
    .chunky-btn.secondary { background: var(--color-surface); color: var(--color-text); }
    .chunky-btn:hover, .chunky-btn:focus-visible { transform: translate(-3px, -3px); box-shadow: 7px 7px 0 var(--color-text); }

    .kicker {
      font-family: var(--font-family-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-fg);
    }

    /* welcome */
    .scan-note { max-width: 820px; margin: var(--space-10) auto var(--space-6); padding: 0 var(--space-4); text-align: center; }
    .scan-note .scan-label {
      display: inline-block; padding: 5px 12px; margin-bottom: var(--space-4);
      border: 3px solid var(--color-text); background: var(--platform-color); color: #fff;
      box-shadow: var(--shadow-chunky);
      font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    }
    .scan-note h2 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(2rem, 5vw, 3rem); line-height: 0.95; margin: 0 0 var(--space-4); color: var(--color-text); }
    .scan-note p { color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.7; margin: 0 auto var(--space-3); max-width: 68ch; }
    .scan-note strong { color: var(--color-text); }

    /* the clip */
    .clip-section { padding: var(--space-6) var(--space-4) var(--space-10); max-width: 1100px; margin: 0 auto; }
    .clip-frame {
      display: grid; grid-template-columns: 3fr 2fr; gap: var(--space-6); align-items: center;
      padding: var(--space-6);
      border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
    }
    .clip-frame video { width: 100%; height: auto; display: block; border: 3px solid var(--color-text); background: #000; image-rendering: pixelated; }
    .clip-text h3 { font-family: var(--font-family-script); font-weight: 700; font-size: 1.9rem; margin: var(--space-2) 0 var(--space-3); color: var(--color-text); }
    .clip-text p { color: var(--color-text-secondary); margin: 0 0 var(--space-4); line-height: 1.7; }
    .clip-text .chunky-btn + .chunky-btn { margin-left: var(--space-2); }

    /* the games wall */
    .wall-section { padding: var(--space-10) var(--space-4); background: var(--color-bg-secondary); border-top: 3px solid var(--color-text); border-bottom: 3px solid var(--color-text); }
    .wall-inner { max-width: 1100px; margin: 0 auto; }
    .wall-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-4); margin-top: var(--space-6); }
    .wall-tile {
      display: flex; flex-direction: column;
      border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
      text-decoration: none; color: inherit; transition: transform var(--transition-base), box-shadow var(--transition-base);
    }
    .wall-tile:hover, .wall-tile:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--platform-color); outline: none; }
    .wall-tile img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; background: #000; border-bottom: 3px solid var(--color-text); image-rendering: pixelated; }
    .wall-meta { display: flex; flex-direction: column; gap: 2px; padding: var(--space-3); }
    .wall-title { font-size: 1rem; font-weight: 800; color: var(--color-text); margin: 0; }
    .wall-units { font-family: var(--font-family-mono); font-size: 0.72rem; color: var(--color-text-secondary); }
    .wall-note { margin: var(--space-6) 0 0; text-align: center; color: var(--color-text-secondary); }

    /* the family strip */
    .family-section { padding: var(--space-10) var(--space-4); max-width: 1100px; margin: 0 auto; }
    .family-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); margin-top: var(--space-6); }
    .family-tile {
      --pc: var(--platform-color);
      display: flex; flex-direction: column;
      border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
      text-decoration: none; color: inherit; transition: transform var(--transition-base), box-shadow var(--transition-base);
    }
    .family-tile:hover, .family-tile:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--pc); outline: none; }
    .family-tile img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; background: #000; border-bottom: 3px solid var(--color-text); image-rendering: pixelated; }
    .family-band { height: 8px; background: var(--pc); border-bottom: 3px solid var(--color-text); }
    .family-meta { display: flex; flex-direction: column; gap: 2px; padding: var(--space-3); }
    .family-name { font-size: 1.05rem; font-weight: 800; color: var(--color-text); margin: 0; }
    .family-line { font-family: var(--font-family-mono); font-size: 0.72rem; color: var(--color-text-secondary); }
    .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4); margin-top: var(--space-4); }
    .tool-card {
      display: flex; flex-direction: column; gap: var(--space-2);
      padding: var(--space-5); border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
      text-decoration: none; color: inherit; transition: transform var(--transition-base), box-shadow var(--transition-base);
    }
    .tool-card:hover, .tool-card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--platform-color); outline: none; }
    .tool-title { font-size: 1.2rem; font-weight: 800; color: var(--color-text); margin: 0; }
    .tool-description { color: var(--color-text-secondary); font-size: 0.92rem; line-height: 1.55; margin: 0; }
    .tool-cta { font-family: var(--font-family-mono); color: var(--accent-fg); font-weight: 700; font-size: 0.8rem; }
    .tool-cta::after { content: ' →'; }

    /* why */
    .why-section { padding: var(--space-10) var(--space-4); max-width: 800px; margin: 0 auto; }
    .why-section h2 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0 0 var(--space-4); color: var(--color-text); text-align: center; }
    .why-section .why-body { color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.8; }
    .why-section .why-body p { margin: 0 0 var(--space-4); }
    .why-section .why-body p:last-child { margin-bottom: 0; }
    .why-section .why-body a { color: var(--accent-fg); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

    /* vault picks */
    .vault-section { padding: var(--space-10) var(--space-4); background: var(--color-bg-secondary); border-top: 3px solid var(--color-text); }
    .vault-container { max-width: 1100px; margin: 0 auto; }
    .vault-intro { color: var(--color-text-secondary); margin: 0 auto var(--space-6); max-width: 700px; text-align: center; }
    .vault-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-4); }

    /* footer cta */
    .footer-cta { padding: var(--space-12) var(--space-4); max-width: 800px; margin: 0 auto; text-align: center; }
    .footer-cta h2 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 var(--space-3); color: var(--color-text); }
    .footer-cta p { color: var(--color-text-secondary); margin: 0 0 var(--space-6); line-height: 1.7; }
    .footer-cta-buttons { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }

    @media (max-width: 768px) {
      .clip-frame { grid-template-columns: 1fr; }
      .clip-text .chunky-btn { margin: 0 var(--space-2) var(--space-2) 0; }
      .clip-text .chunky-btn + .chunky-btn { margin-left: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .chunky-btn, .wall-tile, .family-tile, .tool-card { transition: none; }
    }
  </style>

  <div class="crash-live-page">
    <!-- Hero -->
    <SystemHero
      title="Code Like It's 198x"
      subtitle="Bedroom coding, brought back"
      platformColor={platformColor}
      specs={specs}
      variant="dark"
      rainbowStripe
    />

    <!-- Welcome -->
    <section class="scan-note">
      <span class="scan-label">Welcome from CRASH! Live</span>
      <h2>The Spectrum is back. So is the bar.</h2>
      <p>
        Code Like It's 198x teaches ZX Spectrum game development on the platform itself,
        the way CRASH, Your Sinclair and the Usborne books did: type it in, change it,
        understand it, ship a complete game. Everything on this page is live today and free.
      </p>
      <p>
        <strong>{gamesLive} complete games</strong> across BASIC and Z80 assembly,{' '}
        <strong>{unitsLive} units</strong> you can start right now, and the{' '}
        <strong>Vault</strong>, {fmt(vaultCount)} illustrated entries on the people, games,
        magazines and machines behind them.
      </p>
    </section>

    <!-- The clip -->
    <section class="clip-section" aria-labelledby="clip-heading">
      <div class="clip-frame">
        <div>
          <video
            id="hero-clip"
            src="/videos/sinclair-zx-spectrum/assembly/gloaming/unit-19/begins.mp4"
            poster="/images/sinclair-zx-spectrum/assembly/gloaming/unit-19/step-01-title.png"
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Gloaming running on a ZX Spectrum: the title screen gives way to the first night"
          ></video>
        </div>
        <div class="clip-text">
          <span class="kicker">Z80 assembly · the first game you finish</span>
          <h3 id="clip-heading">Gloaming</h3>
          <p>
            Light every lamp before the dark wins. Twenty-one units from a blank screen to
            a complete game, built on the Z80 on-ramp of Meet the Machine and captured here
            straight out of the project's own emulator.
          </p>
          <p>
            Then the ramp keeps going: The Long Night and Shadowkeep, the flagship, are
            built on the same engine.
          </p>
          <a href="/sinclair-zx-spectrum/assembly/gloaming" class="chunky-btn primary">Build Gloaming</a>
          <a href="/sinclair-zx-spectrum/assembly/shadowkeep" class="chunky-btn secondary">See Shadowkeep</a>
        </div>
      </div>
    </section>

    <!-- The games wall -->
    <section class="wall-section">
      <div class="wall-inner">
        <SectionHeader
          title="Everything you can build today"
          linkHref="/sinclair-zx-spectrum"
          linkText="See the full Spectrum landing"
          platformColor={platformColor}
        />
        <div class="wall-grid">
          {wall.map((g) => (
            <a href={g.href} class="wall-tile">
              <img src={g.shot} alt={`${g.title} running on a ZX Spectrum`} loading="lazy" width="512" height="384" />
              <div class="wall-meta">
                <span class="kicker">{g.track}</span>
                <h3 class="wall-title">{g.title}</h3>
                <span class="wall-units">{g.units} units</span>
              </div>
            </a>
          ))}
        </div>
        <p class="wall-note">
          {gamesLive} complete games and {wall.length - gamesLive} primers, with {gamesComing} more games
          scaffolded and on the way. Nothing above is a mock-up: every screen was captured from the finished code.
        </p>
      </div>
    </section>

    <!-- The family -->
    <section class="family-section">
      <SectionHeader
        title="One project, four machines, two tools"
        linkHref="/systems"
        linkText="Every machine in scope"
        platformColor={platformColor}
      />
      <div class="family-grid">
        {family.map((p) => (
          <a href={p.href} class="family-tile" style={`--pc: ${p.color};`}>
            <div class="family-band"></div>
            <img src={p.shot} alt={`${p.game} running on a ${p.name}`} loading="lazy" width="512" height="384" />
            <div class="family-meta">
              <h3 class="family-name">{p.name}</h3>
              <span class="family-line">{p.cpu} · first game: {p.game}</span>
              <span class="family-line">
                {p.games} complete {p.games === 1 ? 'game' : 'games'}
                {p.primers > 0 && ` · ${p.primers} ${p.primers === 1 ? 'primer' : 'primers'}`}
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="tools-grid">
        {tools.map((t) => (
          <a href={t.href} class="tool-card" rel="noopener">
            <span class="kicker">{t.kicker}</span>
            <h3 class="tool-title">{t.title}</h3>
            <p class="tool-description">{t.description}</p>
            <span class="tool-cta">Visit {t.kicker}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Why Spectrum -->
    <section class="why-section">
      <h2>Why the Spectrum, in 2026?</h2>
      <div class="why-body">
        <p>
          The Spectrum stopped selling new in 1992 and never came back. But the platform
          is still here. The hardware still works. The emulators are excellent.
          A generation of British teenagers learned what software was by typing
          listings from <a href="/vault/magazines/crash-magazine">CRASH</a>,
          <a href="/vault/magazines/your-sinclair">Your Sinclair</a>, and
          <a href="/vault/books/usborne-computing-books">Usborne books</a> on
          this machine, in this BASIC, with this beeper.
        </p>
        <p>
          We think that pedagogy still works. The Spectrum's constraints make programming
          legible: every byte counts, every clock cycle is felt, every design decision shows
          up on the screen. A learner who finishes Shadowkeep has built something concrete
          and shippable on real 1982 hardware. The Commodore 64, NES and Amiga tracks are
          live too, but the Spectrum is where we launch, on the platform that started Britain.
        </p>
      </div>
    </section>

    <!-- Vault Picks -->
    <section class="vault-section">
      <div class="vault-container">
        <SectionHeader
          title="From the Vault"
          linkHref="/vault"
          linkText="Browse all entries"
          platformColor={platformColor}
        />
        <p class="vault-intro">
          The Vault is the reference work the curriculum draws from: people, magazines, companies, culture, hardware. Six picks below; {fmt(vaultCount)} entries in all.
        </p>
        <div class="vault-grid">
          {vaultPicks.map((article) => (
            <VaultCard
              href={article.href}
              kicker={article.kicker}
              title={article.title}
              description={article.description}
              platformColor={platformColor}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="footer-cta">
      <h2>Pick a starting line.</h2>
      <p>
        New to programming? Start with BASIC.
        Ready for the metal? Start with Meet the Machine.
        Want the toolchain first? The setup guide takes you from a fresh laptop to a built game in one command.
      </p>
