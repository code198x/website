---
import Layout from '../../layouts/Layout.astro';
import Grid from '../../components/layout/Grid.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import Cluster from '../../components/layout/Cluster.astro';
import VaultCard from '../../components/VaultCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CodeFromFile from '../../components/CodeFromFile.astro';
import { getCollection } from 'astro:content';
import { getModulesWithCounts } from '../../lib/modules';
import { crashTypeins } from '../../lib/crash-typeins';

// The approved Spectrum primary: screen red (decisions/family-visual-identity.md).
const platformColor = '#C20000';
const SPECTRUM = 'sinclair-zx-spectrum';

// Every number on this page derives from the catalogues (modules + units +
// vault collections) so the event page can't drift from what is actually live.
// See decisions/state-lives-in-catalogues.md.
const assembly = await getModulesWithCounts(SPECTRUM, 'assembly');
const basic = await getModulesWithCounts(SPECTRUM, 'basic');
const isComplete = (m: { status: string }) => m.status === 'complete';
const isGame = (m: { kind: string }) => m.kind === 'game';
// Published assembly modules whose place in the course is undecided are left
// off the event page, and out of its counts, until the owner decides.
const withheld = new Set(['gloaming', 'the-long-night', 'shadowkeep']);
const assemblyLive = assembly.filter(isComplete).filter((m) => !withheld.has(m.slug));
const basicLive = basic.filter(isComplete);
const gamesLive = [...assemblyLive, ...basicLive].filter(isGame).length;
const unitsLive = [...assemblyLive, ...basicLive].reduce((sum, m) => sum + m.unitsAvailable, 0);
const vaultCount = (await getCollection('vault')).length;
const fmt = (n: number) => n.toLocaleString('en-GB');

const unitsOf = (list: typeof basic, slug: string) => list.find((m) => m.slug === slug)?.unitsAvailable;

// Three ways in, one per kind of visitor. The same three close the page.
const doors = [
  {
    href: '/systems/sinclair-zx-spectrum/basic/meet-basic/unit-01-make-the-spectrum-answer/',
    ask: 'Never programmed?', name: 'Meet BASIC',
    text: `Type one line and the Spectrum answers. ${unitsOf(basic, 'meet-basic')} short lessons, starting with PRINT.`,
    shot: '/images/sinclair-zx-spectrum/basic/meet-basic/opening/immediate.png',
    alt: 'Spectrum screen showing Hello, then the report 0 OK, 0:1',
  },
  {
    href: '/systems/sinclair-zx-spectrum/basic/touchdown/unit-01-let-the-craft-fall/',
    ask: "Typed listings in the '80s?", name: 'Touchdown',
    text: `Make a craft fall, then steer it over a ridge onto the pad. Sinclair BASIC, ${unitsOf(basic, 'touchdown')} lessons.`,
    shot: '/images/sinclair-zx-spectrum/basic/touchdown/teaching/flight.png',
    alt: 'Touchdown on the ZX Spectrum: a lander above green hills and a yellow landing pad',
  },
  {
    href: '/systems/sinclair-zx-spectrum/assembly/meet-assembly/unit-01',
    ask: 'Curious about Z80?', name: 'Meet Assembly',
    text: 'Turn the border red with your first instruction, then build Meteor Storm. No programming experience needed.',
    shot: '/images/sinclair-zx-spectrum/assembly/meteor-storm/flight.png',
    alt: 'Meteor Storm on the ZX Spectrum: a ship below falling red meteors',
  },
];

// The printed cards, grouped by the theme on each card's chip, in its colours.
const cardGroups = [
  { name: 'Start here', bg: '#00d700', ink: '#000', cards: [
    [2, 'Three keys. One landing.', doors[1].href],
    [3, 'From one pixel to a finished tape.', doors[2].href],
    [6, 'Never written a program?', doors[0].href],
    [9, 'Fifteen games. Pick one.', '/systems/sinclair-zx-spectrum/basic/'],
  ] },
  { name: 'Type it in', bg: '#0000d7', ink: '#fff', cards: [
    [1, "We've all been here.", '#spectrum-circles'],
    [4, 'Type this in 1982. Scan it in 2026.', '#spectrum-qr'],
    [7, 'Fly straight through the meteors.', '/vault/culture/poke-culture/'],
    [11, 'Give your game a fuel gauge.', '/patterns/sinclair-zx-spectrum/basic/rendering/progress-bar/'],
  ] },
  { name: 'How it works', bg: '#b400b4', ink: '#fff', cards: [
    [5, 'How do numbers become pictures?', '/foundations/counting-in-twos/'],
    [10, 'Why did the red turn green?', '/vault/techniques/colour-clash/'],
    [15, 'One bit. Three voices.', '/vault/people/tim-follin/'],
  ] },
  { name: 'Vault', bg: '#d70000', ink: '#fff', cards: [
    [8, 'The magazine is in the archive.', '/vault/magazines/crash-magazine/'],
    [12, 'They were teenagers. They shipped games.', '/vault/phenomena/bedroom-coder/'],
    [13, 'Started in a dining room. Scored 94%.', '/vault/companies/graftgold/'],
    [14, 'The Oliver Twins on Dizzy.', '/vault/people/oliver-twins/'],
    [16, 'A Spectrum game on the national news.', '/vault/companies/gremlin-graphics/'],
  ] },
] as const;
const cardTypeins = crashTypeins.filter((program) => 'card' in program);

// The games wall: one tile per complete Spectrum module. Where the catalogue
// carries no thumbnail, the final unit's screenshot stands in.
const fallbackShot: Record<string, string> = {
  'bright-spark': '/images/sinclair-zx-spectrum/basic/bright-spark/unit-06/screenshot.png',
  cipher: '/images/sinclair-zx-spectrum/basic/cipher/unit-06/screenshot.png',
  crates: '/images/sinclair-zx-spectrum/basic/crates/unit-06/screenshot.png',
  locksmith: '/images/sinclair-zx-spectrum/basic/locksmith/unit-06/screenshot.png',
  sonar: '/images/sinclair-zx-spectrum/basic/sonar/unit-06/screenshot.png',
  'the-caverns': '/images/sinclair-zx-spectrum/basic/the-caverns/unit-06/screenshot.png',
  'three-in-a-row': '/images/sinclair-zx-spectrum/basic/three-in-a-row/unit-06/screenshot.png',
  touchdown: '/images/sinclair-zx-spectrum/basic/touchdown/unit-08/screenshot.png',
  yearfall: '/images/sinclair-zx-spectrum/basic/yearfall/unit-06/screenshot.png',
};
const tile = (track: 'assembly' | 'basic') => (m: (typeof assembly)[number]) => ({
  href: `/systems/${SPECTRUM}/${track}/${m.slug}`,
  title: m.name,
  track: isGame(m)
    ? (track === 'assembly' ? 'Z80' : 'BASIC')
    : `Primer · ${track === 'assembly' ? 'Z80' : 'BASIC'}`,
  units: m.unitsAvailable,
  shot: m.thumbnail ?? fallbackShot[m.slug],
});
const wall = [...assemblyLive.map(tile('assembly')), ...basicLive.map(tile('basic'))];

const vaultPicks = [
  {
    href: '/vault/magazines/crash-magazine',
    kicker: 'Magazines',
    title: 'CRASH',
    description: "Newsfield's Spectrum monthly: 98 issues from 1984 to 1992, every major game reviewed by at least three players.",
  },
  {
    href: '/vault/people/oliver-frey',
    kicker: 'People',
    title: 'Oliver Frey',
    description: 'Swiss-born British illustrator whose CRASH and Zzap!64 covers gave the 8-bit era its visual identity.',
  },
  {
    href: '/vault/people/tim-follin',
    kicker: 'People',
    title: 'Tim Follin',
    description: 'At 16, his three-channel sound routine for the 48K Spectrum’s one-bit beeper was printed as a type-in in Your Sinclair.',
  },
  {
    href: '/vault/companies/newsfield',
    kicker: 'Companies',
    title: 'Newsfield Publications',
    description: "Roger Kean and Oliver Frey's Ludlow magazine publisher — CRASH, Zzap!64, Amtix!.",
  },
  {
    href: '/vault/phenomena/bedroom-coder',
    kicker: 'Culture',
    title: 'The Bedroom Coder',
    description: 'How teenagers wrote and sold commercial games in the 1980s, and why the name only came in the 1990s.',
  },
  {
    href: '/vault/culture/poke-culture',
    kicker: 'Culture',
    title: 'POKE Culture',
    description: 'The reverse-engineering pastime CRASH Tips and YS Tipshop turned into community ritual.',
  },
];
---

<Layout
  title="Welcome from CRASH! Live 2026"
  description={`Code Like It's 198x teaches ZX Spectrum game development on the platform itself: ${gamesLive} complete games across BASIC and Z80 assembly, ${unitsLive} units live, and a ${fmt(vaultCount)}-entry reference Vault. Welcome to the project's CRASH! Live 2026 launch.`}
  platformColor={platformColor}
>
  <style>@layer blocks {
    /* Spectrum-red event landing, in the house style: square corners, 3px
       borders, chunky offset shadows. Colours come from the theme tokens so it
       works light and dark; the fixed red is the event's own accent. */
    .crash-live-page { --platform-color: #C20000; --accent-fg: #C20000; }

    /* Controls are flat at rest; lift is for hover and focus. */
    .chunky-btn {
      display: inline-flex; align-items: center; min-height: 44px; font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none;
      padding: 10px 18px; border: 3px solid var(--h-ink); text-decoration: none;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
    }
    .chunky-btn.primary { background: var(--platform-color); color: #fff; }
    .chunky-btn.secondary { background: var(--h-ground); color: var(--h-ink); }
    .chunky-btn:hover, .chunky-btn:focus-visible { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--h-ink); }

    .kicker {
      font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--h-ink-muted);
    }

    /* The masthead: the magazine voice, and the machine typing its own welcome. */
    .masthead { position: relative; background: #17120d; color: #f6efe2; padding: var(--space-10) var(--gutter) calc(var(--space-10) + 10px); }
    .masthead::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 10px;
      background: linear-gradient(90deg, #ff0000 0 25%, #ffff00 25% 50%, #00ff00 50% 75%, #00ffff 75% 100%);
    }
    .masthead-inner { max-width: var(--site-frame-width); margin: 0 auto; align-items: center; }
    .event-label { font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--h-mag-yellow); margin: 0 0 var(--h-space-3); }
    .masthead h1 { font-family: var(--h-font-mag); font-weight: 900; font-style: italic; font-size: clamp(2.6rem, 5vw, 4rem); line-height: 0.98; letter-spacing: -0.01em; margin: 0; color: #f6efe2; text-wrap: balance; }
    .masthead-sub { font-size: 1.15rem; line-height: 1.6; color: #cbb8a6; max-width: 46ch; margin: var(--h-space-4) 0 var(--h-space-6); }
    .masthead-screen { margin: 0; }
    .masthead-screen .bezel { background: #0b0a09; padding: 10px; border-radius: 14px; border: 1px solid rgb(239 231 214 / 0.14); }
    .masthead-screen video { display: block; width: 100%; height: auto; image-rendering: pixelated; border-radius: 4px; background: #000; }
    .masthead-screen figcaption { font-style: italic; font-size: 0.9rem; line-height: 1.5; color: #cbb8a6; margin-top: var(--h-space-3); max-width: 60ch; }

    /* Three ways in. */
    .doors, .finder { max-width: var(--site-frame-width); margin: 0 auto; padding: var(--space-10) var(--gutter) var(--h-space-4); scroll-margin-top: 5rem; }
    .doors h2, .finder h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0; color: var(--h-ink); }
    .doors-sub, .finder-intro { color: var(--h-ink-muted); margin: var(--h-space-2) 0 var(--h-space-6); max-width: 65ch; }
    .door { container-type: inline-size; display: flex; flex-direction: column; border: 3px solid var(--h-ink); background: var(--h-ground); color: inherit; text-decoration: none; transition: transform var(--transition-base), box-shadow var(--transition-base); }
    .door:hover, .door:focus-visible { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--platform-color); }
    .door:focus-visible { outline: 3px solid var(--platform-color); outline-offset: 3px; }
    /* A capture is 352 x 296. A door at least that wide scales it up with
       sharp pixels; a narrower one scales it down smoothly, since pixelated
       scaling below 1:1 drops whole rows and columns and breaks text and
       lines. content-box keeps the border out of the capture's shape. */
    .door img { display: block; box-sizing: content-box; width: 100%; height: auto; aspect-ratio: 352 / 296; image-rendering: pixelated; background: #000; border-bottom: 3px solid var(--h-ink); }
    @container (width < 352px) { .door img { image-rendering: auto; } }
    .door-body { display: flex; flex-direction: column; gap: var(--h-space-2); padding: var(--h-space-4); flex: 1; }
    .door-name { font-family: var(--h-font-ui); font-size: 1.6rem; font-weight: 700; line-height: 1.15; color: var(--h-ink); }
    .door-text { color: var(--h-ink-muted); line-height: 1.55; }
    .door-go { margin-top: auto; padding-top: var(--h-space-2); font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--platform-color); }

    /* Got a card? Grouped as the cards' own chips group them. */
    .card-chip { display: inline-block; font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; padding: 4px 8px; margin: 0 0 var(--h-space-2); }
    .finder ol { list-style: none; margin: 0; padding: 0; }
    .finder li a { display: flex; gap: var(--h-space-3); align-items: baseline; min-height: 44px; padding: 10px 0; border-top: 1px solid var(--h-line); color: var(--h-ink); text-decoration: none; }
    .finder li a:hover, .finder li a:focus-visible { text-decoration: underline; text-decoration-color: var(--platform-color); text-underline-offset: 3px; }
    .finder .num { font-family: var(--h-font-ui); font-weight: 600; color: var(--platform-color); min-width: 2.5ch; }

    /* The type-ins from cards 1 and 4. */
    .code-section { padding: var(--h-space-6) var(--gutter) var(--space-10); max-width: var(--site-frame-width); margin: 0 auto; }
    .code-section > h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.4rem); margin: var(--h-space-6) 0 0; color: var(--h-ink); }
    .code-section > p { color: var(--h-ink-muted); max-width: 65ch; }
    .code-frame { margin-top: var(--h-space-6); padding: var(--h-space-6); border: 3px solid var(--h-ink); background: var(--h-ground); }
    .typein { scroll-margin-top: 6rem; min-width: 0; }
    .typein details { margin-top: var(--space-5); min-width: 0; }
    .typein summary { cursor: pointer; padding: var(--h-space-3) 0; min-height: 44px; font-weight: 700; }
    .typein :global(.copy-button) { opacity: 1; min-height: 44px; }
    .typein :global(pre) { padding-top: 4rem; }
    .typein > p a { color: var(--accent-fg); text-underline-offset: 3px; }
    .code-result { align-items: center; }
    /* 256 x 192 at exactly 1:1 inside its 3 px border. */
    .code-result img { box-sizing: content-box; width: 256px; max-width: calc(100% - 6px); height: auto; display: block; border: 3px solid var(--h-ink); background: #000; image-rendering: pixelated; }
    .code-result p { color: var(--h-ink-muted); font-size: 1rem; line-height: 1.6; margin: 0 0 var(--h-space-4); max-width: 65ch; }
    .code-result h3 { font-family: var(--h-font-ui); font-weight: 700; font-size: 1.6rem; margin: var(--h-space-1) 0 var(--h-space-2); color: var(--h-ink); }

    /* the games wall */
    .wall-section { padding: var(--space-10) var(--h-space-4); background: var(--h-ground); border-top: 3px solid var(--h-ink); border-bottom: 3px solid var(--h-ink); }
    .wall-inner { max-width: 1100px; margin: 0 auto; }
    .wall-grid { margin-top: var(--h-space-6); }
    .wall-tile {
      display: flex; flex-direction: column;
      border: 3px solid var(--h-ink); background: var(--h-ground);
      text-decoration: none; color: inherit; transition: transform var(--transition-base), box-shadow var(--transition-base);
    }
    .wall-tile:hover, .wall-tile:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--platform-color); outline: none; }
    /* Tiles are always narrower than a 352 px capture, so they scale down
       smoothly and keep the capture's own shape rather than cropping to 4:3. */
    .wall-tile img { box-sizing: content-box; width: 100%; height: auto; aspect-ratio: 352 / 296; object-fit: contain; display: block; background: #000; border-bottom: 3px solid var(--h-ink); }
    .wall-meta { display: flex; flex-direction: column; gap: 2px; padding: var(--h-space-3); }
    .wall-title { font-size: 1rem; font-weight: 800; color: var(--h-ink); margin: 0; }
    .wall-units { font-family: var(--h-font-ui); font-size: 0.8125rem; color: var(--h-ink-muted); font-weight: 600; }
    .wall-note { margin: var(--h-space-6) 0 0; text-align: center; color: var(--h-ink-muted); }

    /* why */
    .why-section { padding: var(--space-10) var(--h-space-4); max-width: 800px; margin: 0 auto; }
    .why-section h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0 0 var(--h-space-4); color: var(--h-ink); text-align: center; }
    .why-section .why-body { color: var(--h-ink-muted); font-size: 1.05rem; line-height: 1.8; max-width: 65ch; margin: 0 auto; }
    .why-section .why-body p { margin: 0 0 var(--h-space-4); }
    .why-section .why-body p:last-child { margin-bottom: 0; }
    .why-section .why-body a { color: var(--accent-fg); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

    /* vault picks */
    .vault-section { padding: var(--space-10) var(--h-space-4); background: var(--h-ground); border-top: 3px solid var(--h-ink); }
    .vault-container { max-width: 1100px; margin: 0 auto; }
    .vault-intro { color: var(--h-ink-muted); margin: 0 auto var(--h-space-6); max-width: 65ch; text-align: center; }

    /* footer cta */
    .footer-cta { padding: var(--h-space-12) var(--h-space-4); max-width: 800px; margin: 0 auto; text-align: center; }
    .footer-cta h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 var(--h-space-3); color: var(--h-ink); }
    .footer-cta p { color: var(--h-ink-muted); margin: 0 0 var(--h-space-6); line-height: 1.7; }

    @media (max-width: 640px) {
      .wall-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--h-space-3); }
      .wall-meta { padding: var(--h-space-2); }
      .wall-title { font-size: 0.9rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .chunky-btn, .wall-tile { transition: none; }
    }
}
  </style>

  <div class="crash-live-page">
    <!-- Masthead: the welcome, typed by the machine itself -->
    <header class="masthead">
      <Sidebar class="masthead-inner" side="right" sideWidth="704px" contentMin="32.25%" space={8}>
        <div>
          <p class="event-label">Welcome from CRASH! Live 2026</p>
          <h1>Make a game for your Spectrum.</h1>
          <p class="masthead-sub">Free lessons in Sinclair BASIC and Z80 assembly, with a 48K Spectrum running in your browser. Start from scratch, or pick up where you left off.</p>
          <a class="chunky-btn primary" href="#ways-in">Pick your way in</a>
        </div>
        <figure class="masthead-screen">
          <div class="bezel">
            <video src="/videos/crash-live/welcome.mp4" poster="/images/crash-live/welcome-poster.png"
              controls playsinline preload="none" width="704" height="592"
              aria-label="A 48K Spectrum typing this page's welcome into BASIC, then running it"></video>
          </div>
          <figcaption>Press play: a 48K types this welcome itself, one keypress per keyword, then runs it. The typing runs at four times speed; the colour cycle afterwards is its real rhythm.</figcaption>
        </figure>
      </Sidebar>
    </header>

    <!-- Three ways in -->
    <section id="ways-in" class="doors" aria-labelledby="doors-heading">
      <h2 id="doors-heading">Pick your way in.</h2>
      <p class="doors-sub">Every lesson runs in your browser. Nothing to install.</p>
      <Grid class="door-grid" min="260px" maxColumns={3} style="--grid-space: var(--space-5)">
        {doors.map((door) => (
          <a class="door" href={door.href}>
            <img src={door.shot} alt={door.alt} width="352" height="296" loading="lazy" />
            <div class="door-body">
              <span class="kicker">{door.ask}</span>
              <span class="door-name">{door.name}</span>
              <span class="door-text">{door.text}</span>
              <span class="door-go">Start lesson 1</span>
            </div>
          </a>
        ))}
      </Grid>
    </section>

    <!-- Got a card? -->
    <section class="finder" aria-labelledby="cards-heading">
      <h2 id="cards-heading">Got a card? Find yours.</h2>
      <p class="finder-intro">Each card's QR code goes straight to its page. These are the same links, grouped by the coloured chip on the card.</p>
      <Grid class="finder-groups" min="240px" maxColumns={4} space={8} rowSpace={6}>
        {cardGroups.map((group) => (
          <div>
            <p class="card-chip" style={`background:${group.bg};color:${group.ink}`}>{group.name}</p>
            <ol>
              {group.cards.map(([n, headline, href]) => (
                <li value={n}><a href={href}><span class="num">{n}</span><span>{headline}</span></a></li>
              ))}
            </ol>
          </div>
        ))}
      </Grid>
    </section>

    <section class="code-section" aria-labelledby="typeins-heading">
      <h2 id="typeins-heading">Type in a listing.</h2>
      <p>The Spectrum BASIC programs from cards 1 and 4, ready to copy or download.
        Type them on the original machine or in an emulator, then enter RUN.</p>
      {cardTypeins.map((program) => (
        <article id={program.id} class="code-frame typein">
          <Sidebar class="code-result" sideWidth="262px" contentMin="56.65%" style="--sidebar-space: var(--space-5)">
            <div class="code-shot"><img src={`/images/crash-live/${program.id}.png`} alt={program.alt}
              width={program.width} height={program.height} loading="lazy" /></div>
            <div>
              <span class="kicker">Card {program.card} · Sinclair BASIC</span>
              <h3>{program.cardHeadline}</h3>
              <p>{program.note}</p>
              <a class="chunky-btn secondary" href={`/crash-live/${program.id}.bas`} download>Download BASIC listing</a>
            </div>
          </Sidebar>
          <details>
            <summary>Read and copy the listing</summary>
            <CodeFromFile src={program.source} lang={program.lang} />
          </details>
          <p><a href={program.next}>Find your next project</a></p>
        </article>
      ))}
    </section>

    <!-- The games wall -->
    <section class="wall-section">
      <div class="wall-inner">
        <SectionHeader
          title="Everything you can build today"
          linkHref="/systems/sinclair-zx-spectrum"
          linkText="See the full Spectrum landing"
          platformColor={platformColor}
        />
        <Grid class="wall-grid" min="200px">
          {wall.map((g) => (
            <a href={g.href} class="wall-tile">
              <img src={g.shot} alt={`${g.title} running on a ZX Spectrum`} loading="lazy" width="352" height="296" />
              <div class="wall-meta">
                <span class="kicker">{g.track}</span>
                <h3 class="wall-title">{g.title}</h3>
                <span class="wall-units">{g.units} units</span>
              </div>
            </a>
          ))}
        </Grid>
        <p class="wall-note">
          {gamesLive} complete games and {wall.length - gamesLive} primers.
          Choose BASIC or assembly; each has its own starting point.
        </p>
      </div>
    </section>

    <!-- Why Spectrum -->
    <section class="why-section">
      <h2>Why the Spectrum, in 2026?</h2>
      <div class="why-body">
        <p>
          A short program can put something on the screen that you can see, change and explain.
          That makes the Spectrum a useful place to learn: its pixels, colours and sound
          give you something concrete to investigate.
        </p>
        <p>
          If you remember typing listings from <a href="/vault/magazines/crash-magazine">CRASH</a>{' '}
          or <a href="/vault/books/usborne-computing-books">Usborne books</a>, you can pick up
          that curiosity again. If this is your first program, you're welcome too.
          You don't need to own a Spectrum to begin.
        </p>
      </div>
    </section>

    <!-- Vault Picks -->
    <section class="vault-section">
      <div class="vault-container">
        <SectionHeader
          title="From the Vault"
          linkHref="/vault"
          linkText="Browse all entries"
          platformColor={platformColor}
        />
        <p class="vault-intro">
          The Vault is the reference work the curriculum draws from: people, magazines, companies, culture, hardware. Six picks below; {fmt(vaultCount)} entries in all.
        </p>
        <Grid class="vault-grid" min="280px">
          {vaultPicks.map((article) => (
            <VaultCard
              href={article.href}
              kicker={article.kicker}
              title={article.title}
              description={article.description}
              platformColor={platformColor}
            />
          ))}
        </Grid>
      </div>
    </section>

    <!-- Footer CTA: the same three ways in -->
    <section class="footer-cta">
      <h2>Pick a starting line.</h2>
      <p>Every lesson runs in your browser, with a 48K Spectrum on the page. Nothing to install.</p>
      <Cluster class="footer-cta-buttons" space={3} justify="center" align="stretch">
        {doors.map((door) => (
          <a href={door.href} class="chunky-btn secondary">{door.ask} {door.name}</a>
        ))}
      </Cluster>
    </section>
  </div>


</Layout>
