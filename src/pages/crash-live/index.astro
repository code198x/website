  <script>
    // Autoplay the hero clip only for visitors who have not asked for reduced
    // motion. Those who have keep the poster frame and get controls, so the
    // clip is still theirs to watch on demand rather than withheld.
    const clip = document.getElementById('hero-clip') as HTMLVideoElement | null;
    if (clip) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        clip.controls = true;
      } else {
        clip.play().catch(() => { clip.controls = true; });
      }
    }
  </script>
