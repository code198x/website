---
import Layout from '../../layouts/Layout.astro';
import SystemHero from '../../components/SystemHero.astro';
import VaultCard from '../../components/VaultCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { Binary, BookOpen, Library, Cog } from '@lucide/astro';

const platformColor = '#cc0000';

const specs = [
  { label: 'PLATFORM', value: 'ZX Spectrum' },
  { label: 'TRACKS', value: 'BASIC + Z80' },
  { label: 'VOICE', value: 'CRASH/YS' },
  { label: 'BAR', value: 'Hewson 1987' },
  { label: 'STATUS', value: 'October 2026' },
];

// Four featured cards — the launch artefacts.
const artefacts = [
  {
    href: '/sinclair-zx-spectrum/assembly',
    icon: Binary,
    kicker: 'Z80 assembly',
    title: 'The assembly track',
    description: 'A gentle ramp in three stages: Meet the Machine eases you onto the Z80, Gloaming is the first complete game you finish, and Shadowkeep is the flagship we are still building. Fifty-one units, all free.',
    cta: 'Start at Meet the Machine',
  },
  {
    href: '/sinclair-zx-spectrum/basic',
    icon: BookOpen,
    kicker: 'On-ramp',
    title: 'BASIC track',
    description: 'Eight complete games at the Usborne 1984 bar, with more on the way. Type-in listings the way Sinclair Programs and Your Computer published them. No prior experience required.',
    cta: 'Browse BASIC games',
  },
  {
    href: '/vault',
    kicker: 'Reference',
    icon: Library,
    title: 'The Vault',
    description: 'Over 1,200 illustrated entries — the people, places, games, magazines, hardware, and culture every unit draws from, across every machine in scope. Browse it, or follow the unit links.',
    cta: 'Open the Vault',
  },
  {
    href: '/setup/sinclair-zx-spectrum/native',
    icon: Cog,
    kicker: 'Setup',
    title: 'Get the toolchain',
    description: 'Docker image, pasmonext assembler, Fuse emulator, Spectrum Next loader, the lot. One command from "fresh laptop" to "ready to build Shadowkeep."',
    cta: 'See setup guide',
  },
];

const vaultPicks = [
  {
    href: '/vault/magazines/crash-magazine',
    kicker: 'Magazines',
    title: 'CRASH',
    description: "Newsfield's flagship Spectrum monthly — the voice this project's writing was calibrated against.",
  },
  {
    href: '/vault/people/oliver-frey',
    kicker: 'People',
    title: 'Oliver Frey',
    description: "Swiss-born British illustrator whose CRASH and Zzap!64 covers gave the 8-bit era its visual identity.",
  },
  {
    href: '/vault/people/tim-follin',
    kicker: 'People',
    title: 'Tim Follin',
    description: 'Composer who made the Spectrum beeper sound like prog rock. Stormlord, Cybernoid II, Black Lamp.',
  },
  {
    href: '/vault/companies/newsfield',
    kicker: 'Companies',
    title: 'Newsfield Publications',
    description: "Roger Kean and Oliver Frey's Ludlow magazine publisher — CRASH, Zzap!64, Amtix!.",
  },
  {
    href: '/vault/culture/bedroom-coder',
    kicker: 'Culture',
    title: 'The Bedroom Coder',
    description: 'How a generation of British teenagers shipped commercial games from their bedrooms — the model this project revives.',
  },
  {
    href: '/vault/culture/poke-culture',
    kicker: 'Culture',
    title: 'POKE Culture',
    description: 'The reverse-engineering pastime CRASH Tips and YS Tipshop turned into community ritual.',
  },
];
---

<Layout
  title="Code Like It's 198x — Welcome from CRASH! Live"
  description="Code Like It's 198x is a present-tense revival of the British bedroom-coder pedagogy — teaching Spectrum game development on the platform itself, at the bar of 1987 Hewson Consultants. Welcome to the project's CRASH! Live launch."
  platformColor={platformColor}
>
  <style>
    .crash-live-page {
      --platform-color: #cc0000;
    }

    .scan-note {
      max-width: 800px;
      margin: var(--space-8) auto var(--space-4);
      padding: 0 var(--space-4);
      text-align: center;
    }

    .scan-note .scan-label {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink);
      margin-bottom: var(--space-3);
    }

    .scan-note h2 {
      font-size: 1.6rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .scan-note p {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .vertical-slice {
      padding: var(--space-12) var(--space-4);
      max-width: 1100px;
      margin: 0 auto;
    }

    .slice-frame {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: center;
      margin-top: var(--space-6);
      padding: var(--space-6);
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }

    .slice-frame img {
      width: 100%;
      height: auto;
      border-radius: 4px;
      display: block;
      background: #000;
    }

    .slice-text h3 {
      font-size: 1.4rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .slice-text p {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
      line-height: 1.7;
    }

    .slice-text audio {
      width: 100%;
      margin-bottom: var(--space-4);
    }

    .slice-cta {
      display: inline-block;
      padding: var(--space-3) var(--space-5);
      background: var(--platform-color);
      color: white;
      text-decoration: none;
      font-weight: 700;
      border-radius: 4px;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }

    .slice-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(204, 0, 0, 0.3);
    }

    .artefacts-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .artefacts-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .artefacts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--space-4);
      margin-top: var(--space-6);
    }

    .artefact-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.1s ease, border-color 0.1s ease;
    }

    .artefact-card:hover {
      transform: translateY(-2px);
      border-color: var(--platform-color);
    }

    .artefact-icon {
      color: var(--ink);
      margin-bottom: var(--space-2);
    }

    .artefact-kicker {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .artefact-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 0;
    }

    .artefact-description {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.5;
      flex-grow: 1;
    }

    .artefact-cta {
      color: var(--ink);
      font-weight: 700;
      font-size: 0.9rem;
      margin-top: var(--space-2);
    }

    .artefact-cta::after {
      content: ' →';
    }

    .why-section {
      padding: var(--space-12) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
    }

    .why-section h2 {
      font-size: 1.6rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
      text-align: center;
    }

    .why-section .why-body {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .why-section .why-body p {
      margin-bottom: var(--space-4);
    }

    .why-section .why-body p:last-child {
      margin-bottom: 0;
    }

    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .footer-cta {
      padding: var(--space-12) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .footer-cta h2 {
      font-size: 1.6rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .footer-cta p {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
      line-height: 1.7;
    }

    .footer-cta-buttons {
      display: flex;
      gap: var(--space-3);
      justify-content: center;
      flex-wrap: wrap;
    }

    .footer-cta-buttons a {
      display: inline-block;
      padding: var(--space-3) var(--space-5);
      text-decoration: none;
      font-weight: 700;
      border-radius: 4px;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }

    .footer-cta-buttons a.primary {
      background: var(--platform-color);
      color: white;
    }

    .footer-cta-buttons a.secondary {
      background: transparent;
      color: var(--color-text);
      border: 2px solid var(--color-border);
    }

    .footer-cta-buttons a:hover {
      transform: translateY(-2px);
    }

    .footer-cta-buttons a.primary:hover {
      box-shadow: 0 4px 16px rgba(204, 0, 0, 0.3);
    }

    @media (max-width: 768px) {
      .slice-frame {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="crash-live-page">
    <!-- Hero -->
    <SystemHero
      title="Code Like It's 198x"
      subtitle="Bedroom coding, brought back"
      platformColor={platformColor}
      specs={specs}
      variant="dark"
      rainbowStripe
    />

    <!-- Welcome -->
    <section class="scan-note">
      <span class="scan-label">Welcome from CRASH! Live</span>
      <h2>The Spectrum is back. So is the bar.</h2>
      <p>
        Code Like It's 198x is a present-tense revival of the British bedroom-coder pedagogy —
        teaching ZX Spectrum game development on the platform itself, at the editorial
        and technical bar of 1987 Hewson Consultants. Type in the listings, modify them,
        understand them, ship a complete commercial-quality game.
      </p>
      <p>
        We launch in October 2026 with a complete <strong>Z80 assembly opening</strong> —
        an on-ramp (Meet the Machine), the first game you finish (Gloaming), and the
        Shadowkeep flagship, fifty-one units in all; <strong>eight complete BASIC games</strong>
        at the Usborne 1984 bar, with more in progress; the <strong>Vault</strong>, over
        1,200 illustrated reference entries; and the <strong>Spectrum landing page</strong>
        you came in through. Everything linked here is real, shipped, and free.
      </p>
    </section>

    <!-- The Flagship -->
    <section class="vertical-slice">
      <SectionHeader title="The Flagship" platformColor={platformColor} />
      <div class="slice-frame">
        <div>
          <img
            src="/images/sinclair-zx-spectrum/assembly/shadowkeep/unit-13/screenshot.png"
            alt="Shadowkeep running on a ZX Spectrum — a pillared chamber in the keep, the hero lit at its centre"
          />
        </div>
        <div class="slice-text">
          <h3>Shadowkeep</h3>
          <p>
            Sixteen units in, and growing. A darkened keep explored room by room —
            atmosphere, light, and sound — built on the very engine you complete in
            Gloaming. It's the most ambitious game in the assembly track, and the one
            we're still building toward its full shape.
          </p>
          <p>
            Want to <em>finish</em> something first? Gloaming is the complete game the
            ramp lands you on: light every lamp before the dark wins, twenty units,
            done.
          </p>
          <a
            href="/sinclair-zx-spectrum/assembly/shadowkeep"
            class="slice-cta"
          >
            Follow Shadowkeep →
          </a>
        </div>
      </div>
    </section>

    <!-- Launch Artefacts -->
    <section class="artefacts-section">
      <div class="artefacts-inner">
        <SectionHeader
          title="What we're shipping"
          linkHref="/sinclair-zx-spectrum"
          linkText="See the full Spectrum landing"
          platformColor={platformColor}
        />
        <div class="artefacts-grid">
          {artefacts.map((a) => {
            const Icon = a.icon;
            return (
              <a href={a.href} class="artefact-card">
                <Icon size={28} class="artefact-icon" />
                <span class="artefact-kicker">{a.kicker}</span>
                <h3 class="artefact-title">{a.title}</h3>
                <p class="artefact-description">{a.description}</p>
                <span class="artefact-cta">{a.cta}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Why Spectrum -->
    <section class="why-section">
      <h2>Why the Spectrum, in 2026?</h2>
      <div class="why-body">
        <p>
          The Spectrum stopped selling new in 1992 and never came back. But the platform
          is still here. The hardware still works. The emulators are excellent.
          A generation of British teenagers learned what software *was* by typing
          listings from <a href="/vault/magazines/crash-magazine">CRASH</a>,
          <a href="/vault/magazines/your-sinclair">Your Sinclair</a>, and
          <a href="/vault/culture/usborne-computing-books">Usborne books</a> on
          this machine, in this BASIC, with this beeper.
        </p>
        <p>
          We think that pedagogy still works. Better, probably, than most of what
          replaced it. The Spectrum's constraints make programming legible — every
          byte counts; every clock cycle is felt; every design decision shows up on
          the screen. A learner who builds a complete Shadowkeep-tier game has done
          something concrete, finished, and shippable on real 1982 hardware.
        </p>
        <p>
          The full curriculum extends to the Commodore 64, NES, and Amiga — each
          already has a complete first game (Starfield, Exodus, Dash) you can build
          today. But the Spectrum is where we launch, on the platform that started
          Britain.
        </p>
      </div>
    </section>

    <!-- Vault Picks -->
    <section class="vault-section">
      <div class="vault-container">
        <SectionHeader
          title="From the Vault"
          linkHref="/vault"
          linkText="Browse all entries"
          platformColor={platformColor}
        />
        <p style="color: var(--color-text-secondary); margin: 0 auto var(--space-6); max-width: 700px; text-align: center;">
          The Vault is the reference work the curriculum draws from — people, magazines, companies, culture, hardware. Six picks below; over 1,200 more inside.
        </p>
        <div class="vault-grid">
          {vaultPicks.map((article) => (
            <VaultCard
              href={article.href}
              kicker={article.kicker}
              title={article.title}
              description={article.description}
              platformColor={platformColor}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="footer-cta">
      <h2>Pick a starting line.</h2>
      <p>
        New to programming? Start with BASIC.
        Ready for the metal? Start with Meet the Machine.
        Just here to read? The Vault has over 1,200 entries.
      </p>
      <div class="footer-cta-buttons">
        <a href="/sinclair-zx-spectrum/assembly" class="primary">Start the assembly track</a>
        <a href="/sinclair-zx-spectrum/basic" class="secondary">Browse BASIC games</a>
        <a href="/vault" class="secondary">Open the Vault</a>
      </div>
    </section>
  </div>
</Layout>
