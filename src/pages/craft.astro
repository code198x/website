---
import Layout from '../layouts/Layout.astro';
import CurriculumPosition from '../components/CurriculumPosition.astro';
import { getCollection } from 'astro:content';
import { getSection } from '../lib/sections';
import { getSectionModules } from '../lib/modules';

const section = getSection('craft');

// Order is catalogue data, not a list in a page. See
// Code198x docs/decisions/state-lives-in-catalogues.md
const ORDER = (await getSectionModules('craft')).map((m) => m.slug);
const modules = (await getCollection('module-pages'))
  .filter((e) => e.id.startsWith('craft/'))
  .map((e) => ({
    slug: e.id.replace(/\/index$/, '').replace(/^craft\//, ''),
    title: e.data.title,
    description: e.data.description ?? '',
  }))
  .sort((a, b) => {
    const ia = ORDER.indexOf(a.slug);
    const ib = ORDER.indexOf(b.slug);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.title.localeCompare(b.title);
  });

const accent = section?.color ?? '#be185d';

const layers = [
  {
    title: 'Foundations',
    href: '/foundations',
    body: 'The ideas every programmer needs before a machine or language matters: sequence, variables, loops, numbers, bits, source, interpreters, compilers, and assemblers.',
  },
  {
    title: 'Language primers',
    href: '/systems',
    body: 'The first real vocabulary for a chosen language or machine: how this BASIC, assembly, AMOS, Blitz, or other route says the general ideas in its own terms.',
  },
  {
    title: 'The Craft',
    href: '/craft',
    body: 'Transferable game-making techniques: movement, timing, collision, chance, game feel, state, data, and the practical tradeoffs slow machines force into the open.',
  },
  {
    title: 'Machine tracks',
    href: '/systems',
    body: 'The actual application: registers, ROM calls, screen memory, sound chips, frame timing, toolchains, and complete games built under one machine’s constraints.',
  },
  {
    title: 'Pattern Library',
    href: '/patterns',
    body: 'The reference shelf: short recipes and distilled patterns you can return to once the idea has been taught somewhere in the curriculum.',
  },
];

const candidates = [
  'Timing & game loops',
  'Movement & control feel',
  'Collision',
  'State machines',
  'Randomness & procedural tricks',
  'Lookup tables',
  'Actors, sprites & object pools',
  'Animation',
  'Sound as feedback',
  'Ports & adaptation',
];
---

<Layout
  title="The Craft | Code Like It's 198x"
  description="Cross-machine game-making techniques taught once, then used everywhere: movement, maths, timing, game feel, structure, and the cheap answers old machines need."
  platformColor={accent}
>
  <div class="wrap" style={`--sys: ${accent};`}>
    <section class="hero">
      <div class="ghost" aria-hidden="true"><span>Craft</span></div>
      <div class="in">
        <p class="eyebrow">The Craft</p>
        <h1>The techniques every game shares.</h1>
        <div class="rule"></div>
        <p class="lede">
          Some lessons belong to a machine. Others belong to the work of making games at all:
          movement, timing, chance, game feel, collision, structure, and the art of finding the
          cheap answer a slow machine can afford. The Craft teaches those cross-machine ideas as
          courses, then the machine tracks turn them into real routines.
        </p>
        <p class="fit">
          Best read after <a href="/foundations/numbers-and-bits">Numbers & Bits</a>, and before
          or alongside your first <a href="/systems">machine track</a>.
        </p>
      </div>
    </section>

    <CurriculumPosition
      stage="03 · The Craft"
      title="Transferable technique before the machine-specific version."
      body="Craft modules explain game-making ideas once: timing, motion, collision, chance, state, feel, and cheap tricks that survive tight hardware. Machine tracks then show the exact version that fits one CPU, screen layout, sound chip, and frame budget."
      accentColor={accent}
      notes={[
        'Best after the Foundations if the programming ideas are new.',
        'Read beside a machine route when a game introduces a technique you want to understand more deeply.',
      ]}
      links={[
        { href: '/curriculum', label: 'Curriculum Map', note: 'Where Craft sits' },
        { href: '/foundations', label: 'Foundations', note: 'Backfill the basics' },
        { href: '/patterns', label: 'Pattern Library', note: 'Use the compact recipes' },
      ]}
    />

    <section class="split">
      <div>
        <p class="eyebrow">Theory with dirty hands</p>
        <h2>Craft teaches the idea before a chip makes it weird.</h2>
        <p>
          Craft is allowed to be theoretical, but only where the theory earns its keep. A Craft
          module explains the transferable idea, the tradeoff, and the shape of the solution; the
          machine and language tracks show the actual version that runs on real hardware.
        </p>
      </div>
      <div class="example">
        <span>Example</span>
        <strong>Craft explains fixed-point movement.</strong>
        <p>Spectrum Z80, C64 BASIC, NES 6502, and Amiga Blitz each turn that same idea into different code.</p>
      </div>
    </section>

    <section class="layers">
      <div class="section-head">
        <p class="eyebrow">Where everything sits</p>
        <h2>One curriculum, different kinds of lesson.</h2>
      </div>
      <div class="layer-grid">
        {layers.map((layer) => (
          <a class="layer-card" href={layer.href}>
            <h3>{layer.title}</h3>
            <p>{layer.body}</p>
          </a>
        ))}
      </div>
      <p class="note">
        The machine and language-specific primers remain the first bridge into each route. As a
        track deepens, mid-language modules can appear where a game needs new vocabulary: not a
        restart, but a focused return to the language before the next real application.
      </p>
    </section>

    <section class="split reference">
      <div>
        <p class="eyebrow">Course, not reference shelf</p>
        <h2>Craft sits beside the Pattern Library.</h2>
        <p>
          The Pattern Library stays a dip-in reference: concrete recipes and distilled patterns
          you can reuse. Craft is sequenced teaching. When a concept appears in both places, the
          Craft module teaches it front-to-back and the pattern entry remains the quick reference.
        </p>
      </div>
      <a class="reference-link" href="/patterns">
        <span>Open the Pattern Library</span>
        <strong>Reference entries stay there →</strong>
      </a>
    </section>

    <section class="candidates">
      <div class="section-head">
        <p class="eyebrow">What belongs here</p>
        <h2>Reusable techniques with proof behind them.</h2>
        <p>
          A topic belongs in Craft when it can be taught once, backed by runnable examples, and
          then applied differently on several machines. If the lesson depends on a register, chip,
          ROM routine, assembler, screen layout, or memory map, it belongs in a machine track or
          the Pattern Library instead.
        </p>
      </div>
      <ul class="candidate-list">
        {candidates.map((candidate) => <li>{candidate}</li>)}
      </ul>
    </section>

    <ol class="grid">
      {modules.map((module, index) => (
        <li>
          <a class="card" href={`/craft/${module.slug}`}>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <h2>{module.title}</h2>
            <p class="desc">{module.description}</p>
            <span class="go">Start →</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .wrap {
    --accent: var(--sys);
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-16);
  }
  :global(:root[data-theme="dark"]) .wrap { --accent: color-mix(in srgb, var(--sys) 64%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .wrap { --accent: color-mix(in srgb, var(--sys) 64%, white); }
  }
  .hero { position: relative; overflow: hidden; margin-top: var(--space-4); padding: var(--space-8) 0 var(--space-8); }
  .ghost { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; pointer-events: none; overflow: hidden; z-index: 0; }
  .ghost span {
    font-family: var(--font-family-read);
    font-weight: 700;
    font-size: clamp(120px, 24vw, 280px);
    line-height: 0.7;
    color: var(--accent);
    opacity: 0.08;
    transform: rotate(-4deg);
    margin-right: -8px;
    white-space: nowrap;
  }
  .hero .in { position: relative; z-index: 1; }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .hero h1 {
    font-family: var(--font-family-read);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 0.92;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
    margin: var(--space-2) 0 0;
    color: var(--color-text);
    max-width: 18ch;
  }
  .rule { height: 9px; width: 200px; max-width: 70%; background: var(--accent); position: relative; margin: var(--space-3) 0 0; }
  .rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 22%; background: var(--color-text); opacity: 0.22; }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 74ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .fit { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; line-height: 1.6; margin: var(--space-4) 0 0; color: var(--color-text-secondary); }
  .fit a { color: var(--accent); }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.45fr);
    gap: var(--space-6);
    align-items: center;
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6);
    margin: var(--space-4) 0 var(--space-6);
  }
  .split h2 { font-size: 1.35rem; margin: var(--space-2) 0 var(--space-2); color: var(--color-text); }
  .split p { color: var(--color-text-secondary); line-height: 1.6; margin: 0; }
  .example {
    border: 3px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-5);
  }
  .example span { font-family: var(--font-family-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); }
  .example strong { display: block; margin-top: var(--space-2); color: var(--accent); }
  .example p { margin-top: var(--space-2); }
  .section-head { max-width: 70ch; }
  .section-head h2 { font-size: 1.5rem; margin: var(--space-2) 0 var(--space-2); color: var(--color-text); }
  .section-head p { color: var(--color-text-secondary); line-height: 1.6; margin: 0; }
  .layers,
  .candidates {
    margin: var(--space-8) 0;
  }
  .layer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .layer-card {
    border: 3px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }
  .layer-card:hover,
  .layer-card:focus-visible {
    border-color: var(--color-text);
    box-shadow: var(--shadow-chunky);
    transform: translate(-3px, -3px);
    outline: none;
  }
  .layer-card h3 { font-size: 1.1rem; margin: 0; }
  .layer-card p { color: var(--color-text-secondary); font-size: 0.86rem; line-height: 1.5; margin: var(--space-2) 0 0; }
  .note {
    border-left: 8px solid var(--accent);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-5) 0 0;
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    line-height: 1.6;
  }
  .reference { margin-top: var(--space-8); }
  .candidate-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-8);
    padding: 0;
  }
  .candidate-list li {
    border: 3px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .reference-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 3px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-text);
  }
  .reference-link span { font-family: var(--font-family-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); }
  .reference-link strong { color: var(--accent); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-5); }
  .card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 3px solid var(--color-text);
    box-shadow: var(--shadow-chunky);
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .card:hover, .card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .num { font-family: var(--font-family-read); font-weight: 700; font-size: 2.4rem; line-height: 0.8; color: var(--accent); }
  .card h2 { font-size: 1.4rem; margin: var(--space-2) 0 var(--space-2); color: var(--color-text); }
  .desc { font-size: 0.95rem; line-height: 1.55; color: var(--color-text-secondary); margin: 0 0 var(--space-4); flex: 1; }
  .go { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; color: var(--accent); }
  @media (max-width: 780px) {
    .split { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .wrap { padding: var(--space-4) var(--space-4) var(--space-12); }
  }
</style>
