---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Design Showcase - Code198x Visual Identity">
  <style>
    @import url("../styles/design-system.css");
    
    .showcase {
      max-width: var(--container-xl);
      margin: 0 auto;
      padding: var(--space-8);
    }
    
    .section {
      margin-bottom: var(--space-16);
    }
    
    .grid {
      display: grid;
      gap: var(--space-6);
      margin-top: var(--space-8);
    }
    
    .grid-2 {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
    
    .grid-3 {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
    
    .grid-4 {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    
    /* Component Styles */
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      transition: all var(--transition-base);
    }
    
    .card:hover {
      box-shadow: var(--shadow-lg);
      transform: translateY(-2px);
    }
    
    .card-title {
      font-size: var(--text-xl);
      font-weight: var(--font-bold);
      color: var(--text-primary);
      margin-bottom: var(--space-2);
    }
    
    .card-description {
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    
    .btn {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      border-radius: var(--radius-md);
      font-weight: var(--font-semibold);
      transition: all var(--transition-fast);
      cursor: pointer;
      border: 2px solid transparent;
      text-decoration: none;
    }
    
    .btn-primary {
      background: var(--retro-purple);
      color: var(--text-inverse);
    }
    
    .btn-primary:hover {
      background: var(--retro-purple-dark);
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }
    
    .btn-secondary {
      background: var(--bg-surface);
      color: var(--retro-purple);
      border-color: var(--retro-purple);
    }
    
    .btn-secondary:hover {
      background: var(--retro-purple);
      color: var(--text-inverse);
    }
    
    .btn-c64 {
      background: var(--c64-brown);
      color: var(--text-inverse);
    }
    
    .btn-spectrum {
      background: var(--spectrum-blue);
      color: var(--text-inverse);
    }
    
    .btn-nes {
      background: var(--nes-red);
      color: var(--text-inverse);
    }
    
    .btn-amiga {
      background: var(--amiga-blue);
      color: var(--text-inverse);
    }
    
    .badge {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
    }
    
    .badge-success {
      background: #E8F5E9;
      color: var(--status-success);
    }
    
    .badge-warning {
      background: #FFF3E0;
      color: var(--status-warning);
    }
    
    .badge-error {
      background: #FFEBEE;
      color: var(--status-error);
    }
    
    .badge-info {
      background: #E3F2FD;
      color: var(--status-info);
    }
    
    .alert {
      padding: var(--space-4);
      border-radius: var(--radius-lg);
      border-left: 4px solid;
      margin-bottom: var(--space-4);
    }
    
    .alert-success {
      background: #E8F5E9;
      color: var(--status-success);
      border-color: var(--status-success);
    }
    
    .alert-warning {
      background: #FFF3E0;
      color: var(--status-warning);
      border-color: var(--status-warning);
    }
    
    .alert-error {
      background: #FFEBEE;
      color: var(--status-error);
      border-color: var(--status-error);
    }
    
    .system-card {
      background: var(--bg-surface);
      border-radius: var(--radius-xl);
      overflow: hidden;
      transition: all var(--transition-base);
    }
    
    .system-card-header {
      padding: var(--space-8);
      color: var(--text-inverse);
      text-align: center;
    }
    
    .system-card-body {
      padding: var(--space-6);
    }
    
    .c64-header {
      background: linear-gradient(135deg, var(--c64-brown), var(--c64-accent));
    }
    
    .spectrum-header {
      background: linear-gradient(135deg, var(--spectrum-blue), var(--spectrum-accent));
    }
    
    .nes-header {
      background: linear-gradient(135deg, var(--nes-red), var(--nes-accent));
    }
    
    .amiga-header {
      background: linear-gradient(135deg, var(--amiga-blue), var(--amiga-accent));
    }
    
    .color-swatch {
      height: 100px;
      border-radius: var(--radius-lg);
      display: flex;
      align-items: flex-end;
      padding: var(--space-3);
      color: white;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: var(--font-semibold);
    }
    
    h1 {
      font-size: var(--text-5xl);
      margin-bottom: var(--space-4);
      background: linear-gradient(135deg, var(--retro-purple), var(--retro-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    h2 {
      font-size: var(--text-3xl);
      margin-bottom: var(--space-6);
      color: var(--text-primary);
    }
    
    .subtitle {
      font-size: var(--text-xl);
      color: var(--text-secondary);
      margin-bottom: var(--space-12);
    }
  </style>
  
  <div class="showcase">
    <h1>Code198x Visual Identity</h1>
    <p class="subtitle">A modern retro design system with WCAG AA compliance</p>
    
    <!-- Color Palette -->
    <section class="section">
      <h2>Brand Colors</h2>
      <div class="grid grid-4">
        <div class="color-swatch" style="background: var(--retro-amber);">
          Retro Amber
        </div>
        <div class="color-swatch" style="background: var(--retro-green);">
          Terminal Green
        </div>
        <div class="color-swatch" style="background: var(--retro-cyan);">
          Classic Cyan
        </div>
        <div class="color-swatch" style="background: var(--retro-purple);">
          Modern Purple
        </div>
      </div>
    </section>
    
    <!-- System Colors -->
    <section class="section">
      <h2>System-Specific Themes</h2>
      <div class="grid grid-2">
        <div class="system-card">
          <div class="system-card-header c64-header">
            <h3>Commodore 64</h3>
          </div>
          <div class="system-card-body">
            <p>Warm browns and beige tones reminiscent of the classic breadbin design.</p>
            <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4);">
              <div style="width: 40px; height: 40px; background: var(--c64-brown); border-radius: var(--radius-md);"></div>
              <div style="width: 40px; height: 40px; background: var(--c64-accent); border-radius: var(--radius-md);"></div>
            </div>
          </div>
        </div>
        
        <div class="system-card">
          <div class="system-card-header spectrum-header">
            <h3>ZX Spectrum</h3>
          </div>
          <div class="system-card-body">
            <p>Bold primary colors from the iconic rubber-keyed computer.</p>
            <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4);">
              <div style="width: 40px; height: 40px; background: var(--spectrum-blue); border-radius: var(--radius-md);"></div>
              <div style="width: 40px; height: 40px; background: var(--spectrum-accent); border-radius: var(--radius-md);"></div>
            </div>
          </div>
        </div>
        
        <div class="system-card">
          <div class="system-card-header nes-header">
            <h3>Nintendo NES</h3>
          </div>
          <div class="system-card-body">
            <p>Classic red and gray from the legendary 8-bit console.</p>
            <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4);">
              <div style="width: 40px; height: 40px; background: var(--nes-red); border-radius: var(--radius-md);"></div>
              <div style="width: 40px; height: 40px; background: var(--nes-accent); border-radius: var(--radius-md);"></div>
            </div>
          </div>
        </div>
        
        <div class="system-card">
          <div class="system-card-header amiga-header">
            <h3>Commodore Amiga</h3>
          </div>
          <div class="system-card-body">
            <p>Distinctive blue and orange from the multimedia powerhouse.</p>
            <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4);">
              <div style="width: 40px; height: 40px; background: var(--amiga-blue); border-radius: var(--radius-md);"></div>
              <div style="width: 40px; height: 40px; background: var(--amiga-accent); border-radius: var(--radius-md);"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Buttons -->
    <section class="section">
      <h2>Button Styles</h2>
      <div style="display: flex; flex-wrap: wrap; gap: var(--space-4);">
        <button class="btn btn-primary">Primary Button</button>
        <button class="btn btn-secondary">Secondary Button</button>
        <button class="btn btn-c64">C64 Theme</button>
        <button class="btn btn-spectrum">Spectrum Theme</button>
        <button class="btn btn-nes">NES Theme</button>
        <button class="btn btn-amiga">Amiga Theme</button>
      </div>
    </section>
    
    <!-- Cards -->
    <section class="section">
      <h2>Card Components</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3 class="card-title">Lesson Card</h3>
          <p class="card-description">Interactive lessons teaching assembly programming fundamentals with hands-on examples.</p>
          <div style="margin-top: var(--space-4);">
            <span class="badge badge-success">Beginner</span>
          </div>
        </div>
        
        <div class="card">
          <h3 class="card-title">System Card</h3>
          <p class="card-description">Explore the hardware architecture and capabilities of classic computing systems.</p>
          <div style="margin-top: var(--space-4);">
            <span class="badge badge-info">32 Systems</span>
          </div>
        </div>
        
        <div class="card">
          <h3 class="card-title">Project Card</h3>
          <p class="card-description">Build real programs from scratch using authentic development tools and techniques.</p>
          <div style="margin-top: var(--space-4);">
            <span class="badge badge-warning">Advanced</span>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Alerts -->
    <section class="section">
      <h2>Status Messages</h2>
      <div class="alert alert-success">
        <strong>Success!</strong> Your code compiled without errors. Ready to run!
      </div>
      <div class="alert alert-warning">
        <strong>Warning:</strong> This instruction uses undocumented opcodes.
      </div>
      <div class="alert alert-error">
        <strong>Error:</strong> Syntax error at line 42. Expected comma after operand.
      </div>
    </section>
    
    <!-- Typography -->
    <section class="section">
      <h2>Typography Scale</h2>
      <div style="background: var(--bg-surface); padding: var(--space-8); border-radius: var(--radius-xl);">
        <h1 style="font-size: var(--text-5xl); background: none; -webkit-text-fill-color: var(--text-primary);">Heading 1</h1>
        <h2 style="font-size: var(--text-4xl);">Heading 2</h2>
        <h3 style="font-size: var(--text-3xl);">Heading 3</h3>
        <h4 style="font-size: var(--text-2xl);">Heading 4</h4>
        <p style="font-size: var(--text-lg); color: var(--text-primary);">
          Large body text for emphasis and introductions.
        </p>
        <p style="color: var(--text-secondary);">
          Regular body text with secondary color for standard content.
        </p>
        <p style="font-size: var(--text-sm); color: var(--text-muted);">
          Small text for captions and metadata.
        </p>
        <p style="font-family: var(--font-mono); background: var(--bg-muted); padding: var(--space-2); border-radius: var(--radius-sm);">
          LDA #$00  ; Monospace for code
        </p>
      </div>
    </section>
    
    <!-- Badges -->
    <section class="section">
      <h2>Badge Variants</h2>
      <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
        <span class="badge badge-success">Easy</span>
        <span class="badge badge-warning">Medium</span>
        <span class="badge badge-error">Hard</span>
        <span class="badge badge-info">New</span>
        <span class="badge" style="background: var(--bg-muted); color: var(--text-secondary);">Draft</span>
        <span class="badge" style="background: var(--retro-purple); color: white;">Featured</span>
      </div>
    </section>
  </div>
</Layout>