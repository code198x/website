---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getSection } from '../lib/sections';

const section = getSection('meet-assembly');

const ORDER = ['z80', '6502', '68000', '6809', '8080'];
const courses = (await getCollection('module-pages'))
  .filter((e) => e.id.startsWith('meet-assembly/'))
  .map((e) => ({
    slug: e.id.replace(/\/index$/, '').replace(/^meet-assembly\//, ''),
    title: e.data.title,
    description: e.data.description ?? '',
  }))
  .sort((a, b) => {
    const ia = ORDER.indexOf(a.slug);
    const ib = ORDER.indexOf(b.slug);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.title.localeCompare(b.title);
  });

const accent = section?.color ?? '#78716c';
---

<Layout
  title="Meet Assembly | Code Like It's 198x"
  description="One instruction set, every machine that runs it. Learn a processor's assembly once — by CPU, not by machine — and it serves every computer built on it."
  platformColor={accent}
>
  <div class="wrap">
    <header class="mhead">
      <p class="eyebrow">Meet Assembly</p>
      <h1>Learn the processor, not the machine.</h1>
      <div class="rule"></div>
      <p class="lede">A Z80 is a Z80 whether it sits in a Spectrum, an Amstrad CPC or an
        MSX — the instructions are the chip's, not the computer's. So assembly is taught
        once <em>per processor</em>, on one home machine, and that course serves every
        machine built on the same CPU. What differs between them — the screen, the sound,
        the memory map — lives in each machine's own briefing, not here.</p>
    </header>

    <ol class="grid">
      {courses.map((c) => (
        <li>
          <a class="card" href={`/meet-assembly/${c.slug}`}>
            <span class="chip">{c.slug.toUpperCase()}</span>
            <h2>{c.title}</h2>
            <p class="desc">{c.description}</p>
            <span class="go">Open →</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style define:vars={{ accent }}>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .mhead { margin-bottom: var(--space-10); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .mhead h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.04; margin: var(--space-2) 0 0; color: var(--color-text); max-width: 18ch; }
  .rule { height: 6px; width: 160px; max-width: 70%; background: var(--accent); margin: var(--space-3) 0 0; }
  .lede { font-size: 1.05rem; max-width: 70ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-5); }
  .card { display: block; height: 100%; padding: var(--space-5); background: var(--color-surface); border: 2px solid var(--color-border); border-left: 6px solid var(--accent); text-decoration: none; transition: border-color var(--transition-base), transform var(--transition-base); }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .chip { font-family: var(--font-family-mono); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; color: var(--accent); }
  .card h2 { font-size: 1.4rem; margin: var(--space-1) 0 var(--space-2); color: var(--color-text); }
  .desc { font-size: 0.95rem; color: var(--color-text-secondary); margin: 0 0 var(--space-4); }
  .go { font-family: var(--font-family-mono); font-size: 0.8rem; font-weight: 600; color: var(--accent); }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
