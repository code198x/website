---
/**
 * Start Here — /start-here
 *
 * An honest audience router. Renamed from "Who this is for" on 2026-09-03: the
 * nav had said START HERE all along, and a page whose job is to be the first
 * thing you click should agree with the thing you clicked.
 *
 * Each card carries ONE action. The earlier version offered up to four links a
 * card, twenty-nine across the page, which asks a reader who has just admitted
 * they do not know where to start to make another choice. Code Like It's 198x means something different to a
 * complete beginner, a seasoned engineer chasing the metal, a teacher, or someone
 * here purely for the romance of the era. This page sorts those readers into
 * recognisable doorways, each pointing at a real path — or honestly marked as a
 * door we're still building. Visible gaps are deliberate: we'd rather show the
 * gap than fabricate a destination. Honest-gap cards use the dashed "soon"
 * treatment (the family's not-ready idiom, also on the fleet stub pages).
 */
import Layout from '../layouts/Layout.astro';

interface Door {
  /** Drives the card's accent, so a reader can see the three kinds apart before reading them. */
  level: 'new' | 'coder' | 'curious' | 'teaching';
  audiences: string;
  title: string;
  body: string;
  action: { href: string; label: string };
  soon?: string;
  gap?: boolean;
}

const doors: Door[] = [
  {
    level: 'new',
    audiences: 'Absolute beginners · lapsed coders',
    title: 'Never written a line of code',
    body:
      "You don't need to know anything yet. We start with the ideas every program is built " +
      'from — instructions in order, a variable that remembers, a loop, a decision — in plain ' +
      'terms first, then running on a real Spectrum.',
    action: { href: '/foundations/general-programming', label: 'Start with General Programming' },
  },
  {
    level: 'coder',
    audiences: 'Experienced developers · the abstraction-curious',
    title: 'You know how to code — show me the machine',
    body:
      'You can already build things. Now meet the hardware with nothing in the way — registers, ' +
      'memory maps, the raster racing down the screen.',
    action: { href: '/from-the-metal', label: 'Read From the Metal' },
  },
  {
    level: 'coder',
    audiences: 'CS students · the self-taught',
    title: 'The fundamentals school skipped',
    body:
      'The stack, addressing, what a pointer really is, why a loop costs what it costs. Taught ' +
      'from the machine up, not the framework down.',
    action: { href: '/foundations', label: 'Start with the foundations' },
  },
  {
    level: 'coder',
    audiences: 'Performance-aware · embedded engineers',
    title: 'Every cycle counts',
    body:
      "There's no sterner teacher than a 3.5 MHz machine that punishes every wasted cycle. The " +
      'instincts you build here transfer straight to anything tight and modern.',
    action: { href: '/from-the-metal', label: 'Count the cycles' },
  },
  {
    level: 'coder',
    audiences: 'Indie developers · the demoscene',
    title: 'Constraint is the craft',
    body:
      'Limits are the point. A fixed palette, a handful of sprites, a few kilobytes — constraint ' +
      'is what makes the work sing, and these machines have it in abundance.',
    action: { href: '/demoscene', label: 'Into the demoscene' },
  },
  {
    level: 'curious',
    audiences: 'Retro enthusiasts',
    title: 'For the romance of the era',
    body:
      "Maybe you're not here to write code at all — you're here for the machines, the people, " +
      'and the world that made them.',
    action: { href: '/vault', label: 'Open the Vault' },
  },
  {
    level: 'teaching',
    audiences: 'Parents · educators',
    title: 'For parents and teachers',
    body:
      "Sitting beside a curious child, or bringing a classroom along? You don't need to be a " +
      'programmer either.',
    action: { href: '/teaching', label: 'The guide for parents and teachers' },
  },
  {
    level: 'teaching',
    audiences: 'Schools · institutions',
    title: 'For schools and institutions',
    body:
      'Everything here is free and openly licensed — Creative Commons for the prose, MIT for ' +
      'the code. Use it, fork it, build on it.',
    action: { href: '/teaching#institutions', label: 'Adopting it for a course' },
  },
  {
    level: 'teaching',
    audiences: 'Funders · press',
    title: 'For funders and press',
    body: 'One person, an enormous ambition, built entirely in the open.',
    action: { href: '/press', label: 'The press brief' },
  },
];
---

<Layout
  title="Start Here"
  description="Find your way in. Code Like It's 198x means something different to a complete beginner, a seasoned engineer, a teacher, or someone here for the romance of the era — this is the honest router that points each one at the right door."
>
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Find your way in</p>
      <h1>Start here.</h1>
      <div class="herorule"></div>
      <p class="lede">Code Like It's 198x means something different depending on who's reading — a
        complete beginner, an engineer chasing the metal, a teacher, someone here purely for the
        romance of the era. Find the <span class="mk">one that sounds like you</span> and take the
        one link on it. Every card leads somewhere real.</p>
    </div>

    <div class="doors">
      {doors.map((d) => (
        <div class={`door ${d.level}${d.gap ? ' gap' : ''}`}>
          {d.gap && <span class="soon-badge">Coming soon</span>}
          <p class="aud">{d.audiences}</p>
          <h2>{d.title}</h2>
          <p class="body">{d.body}</p>
          <a href={d.action.href} class="act primary">{d.action.label} →</a>
          {d.soon && <p class="note">{d.soon}</p>}
        </div>
      ))}
    </div>

    <p class="foot">None of them quite you? <a href="/systems">Browse the machines</a> by era, region or maker, <a href="/about">read the longer story</a>, or <a href="/contribute">help build the door that is missing</a>.</p>
  </div>
</Layout>

<style>
  /* The card's kind, shown before it is read: who is new, who already codes,
     who is here for the era, and who is bringing someone else along. */
  .door.new      { border-top: 6px solid var(--color-house); }
  .door.coder    { border-top: 6px solid var(--color-house-2); }
  .door.curious  { border-top: 6px solid #0f766e; }
  .door.teaching { border-top: 6px solid #7c3aed; }

  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }

  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .lede a { color: var(--ink); font-weight: 700; }

  .doors { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .door {
    position: relative;
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .door:hover, .door:focus-within { transform: translate(-4px, -4px); box-shadow: var(--shadow-chunky-hi); }
  /* Honest gap: dashed border + muted surface — the "soon"/not-ready idiom. */
  .door.gap { border-style: dashed; border-color: var(--color-border); box-shadow: none; background: var(--color-bg-secondary); }
  .door.gap:hover, .door.gap:focus-within { transform: none; box-shadow: none; }

  .soon-badge {
    position: absolute; top: var(--space-4); right: var(--space-4);
    font-family: var(--font-family-mono); font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 2px solid var(--color-border); padding: 3px 7px;
  }

  .aud { font-family: var(--font-family-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; padding-right: 6rem; }
  .door h2 { font-family: var(--font-family-read); font-weight: 700; font-size: 1.85rem; line-height: 0.98; margin: var(--space-2) 0 0; color: var(--color-text); }
  .door .body { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: var(--space-3) 0 0; }

  .acts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: auto; padding-top: var(--space-4); }
  .act { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; border-bottom: 2px solid transparent; transition: color var(--transition-base), border-color var(--transition-base); }
  .act:hover, .act:focus-visible { color: var(--color-house-2); border-bottom-color: var(--color-house-2); }
  .act.primary { color: var(--ink); font-weight: 800; }
  .act.primary:hover, .act.primary:focus-visible { color: var(--color-house-2); border-bottom-color: var(--color-house-2); }

  .note { margin: var(--space-4) 0 0; padding-top: var(--space-3); border-top: 1px dashed var(--color-border); font-size: 0.78rem; font-style: italic; color: var(--color-text-secondary); }
  .door.gap .note { border-top: 0; padding-top: var(--space-4); margin-top: auto; }

  .foot { margin-top: var(--space-12); font-size: 0.92rem; color: var(--color-text-secondary); }
  .foot a { color: var(--ink); font-weight: 600; }

  @media (max-width: 860px) { .doors { grid-template-columns: 1fr; } }
</style>
