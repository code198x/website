---
import Layout from '../layouts/Layout.astro';

interface Door {
  /** Drives the card's accent, so a reader can see the three kinds apart before reading them. */
  level: 'new' | 'coder' | 'curious' | 'teaching';
  audiences: string;
  title: string;
  body: Array<string | { text: string; href: string }>;
  action: { href: string; label: string };
  soon?: string;
  gap?: boolean;
}

const doors: Door[] = [
  {
    level: 'new', audiences: 'Make a game', title: 'Choose a machine and start building',
    body: ["Browse the systems with lessons available and choose a language route. You can start here as a beginner; completing ", {"text": "Foundations", "href": "/foundations"}, " or another system track is not a prerequisite."],
    action: { href: '/systems', label: 'Find a system with lessons' },
  },
  {
    level: 'new', audiences: 'Explore programming ideas', title: 'Start with the programming concepts',
    body: [{"text": "Foundations", "href": "/foundations"}, " uses pseudocode to explain instructions, variables, decisions and loops without choosing a machine or language. Follow its guided examples, or return when a lesson raises a question."],
    action: { href: '/foundations/basics', label: 'Explore The Basics' },
  },
  {
    level: 'coder', audiences: 'Understand how programs run', title: 'Look beneath the language',
    body: [{"text": "From the Metal", "href": "/from-the-metal"}, " explores programming choices through concrete machine behaviour. See why an approach helps, what it costs and where comparisons with modern systems have limits."],
    action: { href: '/from-the-metal', label: 'Read the programming essays' },
  },
  {
    level: 'coder', audiences: 'Explore game-making ideas', title: 'Connect maths and game design',
    body: [{"text": "The Craft", "href": "/craft"}, " is developing shared explanations for game-making. Its current ", {"text": "Maths for Games", "href": "/craft/maths-for-games"}, " and ", {"text": "Game Feel", "href": "/craft/game-feel"}, " pages outline the planned material; they are not complete lesson sequences yet."],
    action: { href: '/craft', label: 'Explore The Craft outlines' },
  },
  {
    level: 'curious', audiences: 'Explore computing history', title: 'Follow the machines and their stories',
    body: [{"text": "The Vault", "href": "/vault"}, " connects computers, games, people, companies and culture. You can explore it without following a programming course."],
    action: { href: '/vault', label: 'Browse the encyclopaedia' },
  },
  {
    level: 'teaching', audiences: 'Parents and teachers', title: 'Help someone else learn',
    body: ["Find guidance for working through the material together, choosing a starting point and supporting questions and experiments."],
    action: { href: '/teaching', label: 'Read the teaching guide' },
  },
];
---

<Layout
  title="Start Here"
  description="Choose a starting point: build a game, explore programming concepts, investigate a machine, read computing history or help someone learn."
>
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Find your way in</p>
      <h1>Start here.</h1>
      <div class="herorule"></div>
      <p class="lede">You can begin with a machine, a programming idea or a question.
        Choose what you want to do. The shared explanations are here when you need them;
        you do not have to complete them before starting a system track.</p>
    </div>

    <div class="doors">
      {doors.map((d) => (
        <div class={`door ${d.level}${d.gap ? ' gap' : ''}`}>
          {d.gap && <span class="soon-badge">Coming soon</span>}
          <p class="aud">{d.audiences}</p>
          <h2>{d.title}</h2>
          <p class="body">{d.body.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>)}</p>
          <a href={d.action.href} class="act primary">{d.action.label} →</a>
          {d.soon && <p class="note">{d.soon}</p>}
        </div>
      ))}
    </div>

    <p class="foot">Want to see how these fit together? <a href="/curriculum">Explore the curriculum map</a>, <a href="/about">read the longer story</a>, or <a href="/contribute">help build the door that is missing</a>.</p>
  </div>
</Layout>

<style>
  .door .body a { text-decoration: underline; text-underline-offset: 0.15em; }
  /* The card's kind, shown before it is read: who is new, who already codes,
     who is here for the era, and who is bringing someone else along. */
  .door.new      { border-top: 6px solid var(--color-house); }
  .door.coder    { border-top: 6px solid var(--color-house-2); }
  .door.curious  { border-top: 6px solid #0f766e; }
  .door.teaching { border-top: 6px solid #7c3aed; }

  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--gutter) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }

  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .lede a { color: var(--ink); font-weight: 700; }

  .doors { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .door {
    position: relative;
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .door:hover, .door:focus-within { transform: translate(-4px, -4px); box-shadow: var(--shadow-chunky-hi); }
  /* Honest gap: dashed border + muted surface — the "soon"/not-ready idiom. */
  .door.gap { border-style: dashed; border-color: var(--color-border); box-shadow: none; background: var(--color-bg-secondary); }
  .door.gap:hover, .door.gap:focus-within { transform: none; box-shadow: none; }

  .soon-badge {
    position: absolute; top: var(--space-4); right: var(--space-4);
    font-family: var(--font-family-mono); font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 2px solid var(--color-border); padding: 3px 7px;
  }

  .aud { font-family: var(--font-family-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; padding-right: 0; }
  .door h2 { font-family: var(--font-family-read); font-weight: 700; font-size: 1.85rem; line-height: 0.98; margin: var(--space-2) 0 0; color: var(--color-text); }
  .door .body { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: var(--space-3) 0 0; }

  .acts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: auto; padding-top: var(--space-4); }
  .act { display: inline-flex; align-items: center; min-height: 44px; margin-top: auto; padding-top: var(--space-4); font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; border-bottom: 2px solid transparent; transition: color var(--transition-base), border-color var(--transition-base); }
  .act:hover, .act:focus-visible { color: var(--color-house-2); border-bottom-color: var(--color-house-2); }
  .act.primary { color: var(--ink); font-weight: 800; }
  .act.primary:hover, .act.primary:focus-visible { color: var(--color-house-2); border-bottom-color: var(--color-house-2); }

  .note { margin: var(--space-4) 0 0; padding-top: var(--space-3); border-top: 1px dashed var(--color-border); font-size: 0.78rem; font-style: italic; color: var(--color-text-secondary); }
  .door.gap .note { border-top: 0; padding-top: var(--space-4); margin-top: auto; }

  .foot { margin-top: var(--space-12); font-size: 0.92rem; color: var(--color-text-secondary); }
  .foot a { color: var(--ink); font-weight: 600; }

  @media (max-width: 860px) { .doors { grid-template-columns: 1fr; } }
</style>
