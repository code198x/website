---
/**
 * What's New — the project changelog.
 *
 * Short, dated milestones from the `updates` collection, newest first. Data, not
 * essays (those are Field Notes). The homepage shows the latest few; this is the
 * full run. Each entry carries an optional platform accent and a link to the
 * thing it's about.
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const updates = (await getCollection('updates'))
  .filter((u) => !u.data.draft && u.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="What's New"
  description="Recently shipped on Code Like It's 198x — new complete games, fixes, and milestones from building the curriculum and the emulator in the open."
>
  <div class="wrap">
    <header class="vhead">
      <p class="eyebrow">// WHAT'S NEW //</p>
      <h1>What's new.</h1>
      <div class="herorule"></div>
      <p class="lede">The curriculum and the emulator get built in the open. This is the
        short version — new complete games, fixes worth knowing about, the odd milestone.
        The <a href="/field-notes">field notes</a> have the longer stories; the{' '}
        <a href="https://www.patreon.com/c/code_like_its_198x" target="_blank" rel="noopener">Patreon</a>{' '}
        and <a href="https://code198x.substack.com/" target="_blank" rel="noopener">newsletter</a>{' '}
        carry them further.</p>
    </header>

    <ol class="feed">
      {updates.map((u) => (
        <li style={u.data.accent ? `--accent: ${u.data.accent}` : ''}>
          <a class="entry" href={`/updates/${u.id}`}>
            <span class="bar"></span>
            <time class="date" datetime={u.data.pubDate.toISOString()}>{fmt(u.data.pubDate)}</time>
            <h2>{u.data.title}</h2>
            <p class="summary">{u.data.summary}</p>
            <span class="go">Read →</span>
          </a>
        </li>
      ))}
    </ol>

    {updates.length === 0 && (
      <p class="empty">// nothing posted yet — check back //</p>
    )}
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--gutter) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; color: var(--color-house-2); }
  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 68ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .lede a { color: var(--color-house-2); font-weight: 600; }

  .feed { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); --accent: var(--color-house-2); }
  .feed li { margin: 0; }
  .entry {
    position: relative; display: block; text-decoration: none; color: var(--color-text);
    border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
    padding: var(--space-5) var(--space-6) var(--space-5) var(--space-8);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    --accent-ink: color-mix(in srgb, var(--accent) 72%, black);
  }
  :global(:root[data-theme="dark"]) .entry { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .entry { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  }
  .entry:hover, .entry:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .entry .bar { position: absolute; top: 0; left: 0; bottom: 0; width: 7px; background: var(--accent); }
  .date { font-family: var(--font-family-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); }
  .entry h2 { font-family: var(--font-family-read); font-weight: 700; font-size: 1.7rem; line-height: 1.02; margin: var(--space-1) 0 0; color: var(--color-text); }
  .summary { font-size: 0.95rem; line-height: 1.5; color: var(--color-text-secondary); margin: var(--space-2) 0 0; }
  .go { display: inline-block; font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; color: var(--h-ink-body); margin-top: var(--space-3); }
  .empty { font-family: var(--font-family-mono); font-size: 0.8rem; color: var(--color-text-secondary); }

  @media (max-width: 560px) {
    .entry { padding-left: var(--space-6); }
  }
</style>
