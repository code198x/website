---
import UpdatesOpening from '../../components/UpdatesOpening.astro';
/**
 * What's New — the project changelog.
 *
 * Short, dated milestones from the `updates` collection, newest first. Data, not
 * essays (those are Field Notes). The homepage shows the latest few; this is the
 * full run. Each entry carries an optional platform accent and a link to the
 * thing it's about.
 */
import Layout from '../../layouts/Layout.astro';
import PageFrame from '../../components/PageFrame.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const updates = (await getCollection('updates'))
  .filter((u) => !u.data.draft && u.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="What's New"
  description="Recently shipped on Code Like It's 198x — new complete games, fixes, and milestones from building the curriculum and the emulator in the open."
>
  <UpdatesOpening />
  <PageFrame class="wrap" opening="compact">
    <p class="lede">The curriculum and the emulator get built in the open. This is the
        short version — new complete games, fixes worth knowing about, the odd milestone.
        The <a href="/field-notes">field notes</a> have the longer stories; the{' '}
        <a href="https://www.patreon.com/c/code_like_its_198x" target="_blank" rel="noopener">Patreon</a>{' '}
        and <a href="https://code198x.substack.com/" target="_blank" rel="noopener">newsletter</a>{' '}
        carry them further.</p>

    <ol class="feed">
      {updates.map((u) => (
        <li style={u.data.accent ? `--accent: ${u.data.accent}` : ''}>
          <a class="entry" href={`/updates/${u.id}`}>
            <span class="bar"></span>
            <time class="date" datetime={u.data.pubDate.toISOString()}>{fmt(u.data.pubDate)}</time>
            <h2>{u.data.title}</h2>
            <p class="summary">{u.data.summary}</p>
            <span class="go">Read →</span>
          </a>
        </li>
      ))}
    </ol>

    {updates.length === 0 && (
      <p class="empty">// nothing posted yet — check back //</p>
    )}
  </PageFrame>
</Layout>

<style>@layer blocks {
  .eyebrow { font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; color: var(--h-spot-ink); }
  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--h-font-ui); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--h-space-1) 0 0; color: var(--h-ink); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--h-spot-ink); position: relative; margin: var(--h-space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--h-spot-ink); }
  .lede { font-size: 1.05rem; max-width: 68ch; margin: var(--h-space-4) 0 0; color: var(--h-ink); }
  .lede a { color: var(--h-spot-ink); font-weight: 600; }

  .feed { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); --accent: var(--h-spot-ink); }
  .feed li { margin: 0; }
  .entry {
    position: relative; display: block; text-decoration: none; color: var(--h-ink);
    border: 3px solid var(--h-ink); background: var(--h-ground);    padding: var(--space-5) var(--h-space-6) var(--space-5) var(--h-space-8);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    --accent-ink: color-mix(in srgb, var(--accent) 66%, black);
  }
  .entry:hover, .entry:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .entry .bar { position: absolute; top: 0; left: 0; bottom: 0; width: 7px; background: var(--accent); }
  .date { font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--h-ink-muted); }
  .entry h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: 1.7rem; line-height: 1.02; margin: var(--h-space-1) 0 0; color: var(--h-ink); }
  .summary { font-size: 0.95rem; line-height: 1.5; color: var(--h-ink-muted); margin: var(--h-space-2) 0 0; }
  .go { display: inline-block; font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; color: var(--h-ink-body); margin-top: var(--h-space-3); }
  .empty { font-family: var(--h-font-ui); font-size: 0.8125rem; color: var(--h-ink-muted); font-weight: 400; }

  @media (max-width: 560px) {
    .entry { padding-left: var(--h-space-6); }
  }
}
</style>

<style>@layer blocks {
:global(main#main-content[data-site-frame]:has(> .updates-opening)) { max-width: none; }
}
</style>

<style>@layer blocks {
:global(main#main-content[data-site-frame]:has(> .updates-opening) > .wrap) { max-width: var(--site-frame-width); margin-inline: auto; min-width: 0; overflow-wrap: anywhere; }
}
</style>

<style>@layer blocks {
.lede { margin-bottom: 2rem; }
}
</style>

<style>@layer blocks {
.feed > li, .entry { min-width: 0; overflow-wrap: anywhere; }
}
</style>
