---
import { getCollection } from 'astro:content';
import UpdatesLayout from '../../layouts/UpdatesLayout.astro';

export async function getStaticPaths() {
  // Published-only, like the other writing sections: a future-dated entry gets
  // no page until a rebuild on or after its pubDate.
  const entries = (await getCollection('updates'))
    .filter((entry) => !entry.data.draft && entry.data.pubDate <= new Date());
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<UpdatesLayout entry={entry} />
