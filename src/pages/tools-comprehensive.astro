---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import "../styles/tools.css";

// Comprehensive toolchain data for all 12 processor families
const processorFamilies = [
  {
    name: "6502 Family",
    description: "The heart of 8-bit computing - Commodore, Apple, Atari, Nintendo",
    tools: [
      {
        name: "cc65",
        subtitle: "Complete development system",
        description: "C compiler and ca65 assembler. Industry standard for NES development.",
        systems: ["NES", "C64", "Apple II", "Atari 2600"],
        example: `; Hello World for NES
.segment "CODE"
main:
  lda #$01       ; Load color
  sta $2001      ; Enable rendering
  jmp main       ; Loop forever`,
        buildCmd: "ca65 hello.s && ld65 hello.o -t nes"
      },
      {
        name: "ACME",
        subtitle: "Cross-platform macro assembler",
        description: "Flexible syntax with powerful macro support. Perfect for C64 demos.",
        systems: ["C64", "C128", "PET", "Plus/4"],
        example: `; C64 Border color flash
*=$0801
!byte $0c,$08,$00,$00,$9e,$20,$32,$30,$36,$34,$00,$00,$00
*=$0810
loop:
  inc $d020      ; Increment border color
  jmp loop`,
        buildCmd: "acme -o demo.prg demo.asm"
      }
    ]
  },
  {
    name: "Z80 Family",
    description: "Powering UK gaming history - Spectrum, Amstrad, MSX",
    tools: [
      {
        name: "sjasmplus",
        subtitle: "Modern Z80 assembler",
        description: "Advanced features with ZX Spectrum focus. Supports all Z80 variants.",
        systems: ["ZX Spectrum", "ZX81", "MSX", "Amstrad CPC"],
        example: `; Spectrum border effect
        ORG 32768
start:  ld a,2         ; Red border
        out (254),a
        ld a,6         ; Yellow border
        out (254),a
        jr start`,
        buildCmd: "sjasmplus demo.asm --lst --tap"
      },
      {
        name: "z80asm",
        subtitle: "Traditional Z80 assembler",
        description: "Clean, standard Z80 syntax. Great for learning fundamentals.",
        systems: ["Sam Coupé", "Game Gear", "Master System"],
        example: `; Clear screen routine
        ld hl,$4000    ; Screen memory
        ld de,$4001
        ld bc,$17FF
        ld (hl),0
        ldir           ; Fast fill
        ret`,
        buildCmd: "z80asm -b demo.asm"
      }
    ]
  },
  {
    name: "68000 Family",
    description: "16/32-bit powerhouse - Amiga, Genesis, Neo Geo, Atari ST",
    tools: [
      {
        name: "vasm",
        subtitle: "Professional 68k assembler",
        description: "Industry-standard assembler with Motorola and Devpac syntax support.",
        systems: ["Amiga 500/1200", "Sega Genesis", "Neo Geo", "Atari ST"],
        example: `; Amiga copper bar
        lea     $dff000,a6
        move.w  #$7fff,dmacon(a6)
        move.w  #$7fff,intena(a6)
loop:
        move.w  #$0f00,color00(a6)
        bra.s   loop`,
        buildCmd: "vasm -Fhunkexe -o demo demo.s"
      },
      {
        name: "gcc-m68k",
        subtitle: "GNU C/C++ cross-compiler",
        description: "Full C development for 68000 systems with inline assembly support.",
        systems: ["X68000", "Genesis 32X"],
        example: `/* C with inline asm */
void setColor(int col) {
    __asm__ volatile(
        "move.w %0,0xdff180"
        : : "d"(col)
    );
}`,
        buildCmd: "m68k-elf-gcc -o demo demo.c"
      }
    ]
  },
  {
    name: "8080/8085 Family",
    description: "The first personal computers - Altair, IMSAI",
    tools: [
      {
        name: "asm8080",
        subtitle: "Intel 8080 assembler",
        description: "Authentic Intel syntax assembler for the original microprocessor.",
        systems: ["Altair 8800", "IMSAI 8080", "Intel SDK-80"],
        example: `; Altair front panel lights
        ORG 0
start:  MVI A,055H     ; Pattern
        OUT 0FFH       ; To lights
        CMA            ; Complement
        OUT 0FFH       ; Show inverse
        JMP start`,
        buildCmd: "asm8080 -o demo.hex demo.asm"
      }
    ]
  },
  {
    name: "6809 Family",
    description: "Advanced 8-bit architecture - Dragon, TRS-80 Color Computer",
    tools: [
      {
        name: "lwasm",
        subtitle: "6809/6309 cross-assembler",
        description: "Part of LWTOOLS, supports all 6809 variants and extensions.",
        systems: ["Dragon 32/64", "TRS-80 CoCo", "Vectrex"],
        example: `; Dragon 32 color cycle
        ORG $4000
start:  lda #$00
loop:   sta $FFB0      ; Set palette
        inca
        bra loop`,
        buildCmd: "lwasm -o demo.bin demo.asm"
      }
    ]
  },
  {
    name: "MIPS Family",
    description: "32-bit RISC revolution - PlayStation, Nintendo 64",
    tools: [
      {
        name: "gcc-mips",
        subtitle: "GNU MIPS toolchain",
        description: "Complete C/C++ development with PSn00bSDK for PlayStation.",
        systems: ["PlayStation", "Nintendo 64", "PSP"],
        example: `/* PlayStation GPU command */
.text
.global _start
_start:
    li $t0, 0x1F801810
    li $t1, 0xE1000200
    sw $t1, 0($t0)`,
        buildCmd: "mips-linux-gnu-gcc -o demo demo.s"
      }
    ]
  },
  {
    name: "ARM Family",
    description: "Modern 32-bit gaming - GBA, Nintendo DS, 3DO",
    tools: [
      {
        name: "gcc-arm-none-eabi",
        subtitle: "ARM embedded toolchain",
        description: "Industry-standard ARM development with full thumb support.",
        systems: ["Game Boy Advance", "Nintendo DS", "3DO"],
        example: `@ GBA Mode 3 pixel
.text
.global _start
_start:
    mov r0, #0x04000000
    mov r1, #0x0400
    orr r1, #0x0003
    strh r1, [r0]`,
        buildCmd: "arm-none-eabi-gcc -o demo.elf demo.s"
      }
    ]
  },
  {
    name: "SuperH Family",
    description: "Sega's 32-bit choice - Saturn, Dreamcast",
    tools: [
      {
        name: "sh-elf-gcc",
        subtitle: "SuperH cross-compiler",
        description: "GNU toolchain for Hitachi/Renesas SuperH processors.",
        systems: ["Sega Saturn", "Sega Dreamcast", "32X (secondary)"],
        example: `! Saturn VDP1 command
.text
.global _start
_start:
    mov.l vdp1_addr,r0
    mov #0x0000,r1
    mov.w r1,@r0`,
        buildCmd: "sh-elf-as -o demo.o demo.s"
      }
    ]
  },
  {
    name: "x86 Family",
    description: "PC heritage - DOS era and Japanese computers",
    tools: [
      {
        name: "NASM",
        subtitle: "Netwide Assembler",
        description: "Modern x86 assembler with Intel syntax. Perfect for DOS demos.",
        systems: ["FM Towns", "PC-98", "DOS machines"],
        example: `; VGA Mode 13h setup
[BITS 16]
mov ax, 0x0013
int 0x10        ; Set 320x200x256
mov ax, 0xA000
mov es, ax      ; Video segment`,
        buildCmd: "nasm -f bin demo.asm -o demo.com"
      }
    ]
  },
  {
    name: "V30 Family",
    description: "NEC's x86 variant - WonderSwan portable gaming",
    tools: [
      {
        name: "NASM",
        subtitle: "V30 compatible assembler",
        description: "V30 uses x86 instructions with custom extensions.",
        systems: ["Bandai WonderSwan", "WonderSwan Color"],
        example: `; WonderSwan sprite setup
mov ax, 0x2000
mov ds, ax
mov byte [0x00], 0x01  ; Enable sprite`,
        buildCmd: "nasm -f bin ws.asm -o ws.bin"
      }
    ]
  },
  {
    name: "TLCS-900H Family",
    description: "Toshiba's Z80 successor - Neo Geo Pocket",
    tools: [
      {
        name: "AS (Alfred Arnold's)",
        subtitle: "Macro cross-assembler",
        description: "Supports TLCS-900/900L and 75+ other CPU families. The Swiss Army knife of assemblers.",
        systems: ["Neo Geo Pocket", "Neo Geo Pocket Color"],
        example: `; NGP tile setup
        CPU TLCS-900
        ORG 0x200000
start:  LD.B (0x8000),0x40
        LD.W (0x8002),0x1234
        JR start`,
        buildCmd: "asl -cpu TLCS-900 demo.s && p2bin demo.p"
      },
      {
        name: "ngdis",
        subtitle: "NGP disassembler",
        description: "Specialized tool for analyzing Neo Geo Pocket ROMs.",
        systems: ["Neo Geo Pocket"],
        example: "ngdis game.ngp > disassembly.s"
      }
    ]
  },
  {
    name: "Specialized Processors",
    description: "Unique architectures for specific systems",
    tools: [
      {
        name: "dasm",
        subtitle: "6507 assembler for Atari 2600",
        description: "The de facto standard for VCS/2600 development.",
        systems: ["Atari 2600"],
        example: `; Draw playfield
    processor 6502
    org $F000
    lda #$FF
    sta COLUPF`,
        buildCmd: "dasm demo.asm -f3 -odemo.bin"
      },
      {
        name: "wla-dx",
        subtitle: "Multi-architecture assembler",
        description: "Supports many 8/16-bit systems with powerful linking.",
        systems: ["Game Boy", "SNES", "Genesis"],
        example: `; Game Boy header
.MEMORYMAP
SLOTSIZE $4000
DEFAULTSLOT 0
SLOT 0 $0000
.ENDME`,
        buildCmd: "wla-gb -o demo.o demo.s"
      }
    ]
  }
];
---

<Layout
  title="Development Tools - Complete Toolchain Reference"
  description="All 64 systems, 12 processor families, real assemblers and compilers. Complete guide with examples and build instructions for retro game development."
>
  <div class="tools">
    <section class="tools__hero">
      <div class="tools__hero-content">
        <h1 class="tools__title">Complete Development Toolchains</h1>
        <p class="tools__description">
          <strong>Version 1.0.0 Ready!</strong> All 64 gaming systems across 12 processor families now have
          real, functional development tools. No placeholders, no compromises - just professional-grade
          assemblers and compilers ready for creating retro software.
        </p>
        <div class="tools__hero-stats">
          <div class="tools__stat">
            <span class="tools__stat-number">64</span>
            <span class="tools__stat-label">Systems</span>
          </div>
          <div class="tools__stat">
            <span class="tools__stat-number">12</span>
            <span class="tools__stat-label">CPU Families</span>
          </div>
          <div class="tools__stat">
            <span class="tools__stat-number">100%</span>
            <span class="tools__stat-label">Real Tools</span>
          </div>
        </div>
      </div>
    </section>

    {processorFamilies.map((family) => (
      <section class="tools__family-section">
        <div class="tools__family-header">
          <h2 class="tools__family-title">{family.name}</h2>
          <p class="tools__family-description">{family.description}</p>
        </div>

        <div class="tools__toolchain-grid">
          {family.tools.map((tool) => (
            <div class="tools__toolchain-card">
              <div class="tools__toolchain-header">
                <h3 class="tools__toolchain-name">{tool.name}</h3>
                <span class="tools__toolchain-subtitle">{tool.subtitle}</span>
              </div>

              <p class="tools__toolchain-description">{tool.description}</p>

              <div class="tools__toolchain-systems">
                <strong>Systems:</strong>
                <div class="tools__system-tags">
                  {tool.systems.map((system) => (
                    <span class="tools__system-tag">{system}</span>
                  ))}
                </div>
              </div>

              {tool.example && (
                <div class="tools__example">
                  <div class="tools__example-header">
                    <span class="tools__example-title">Example Code:</span>
                    {tool.buildCmd && (
                      <span class="tools__build-cmd">Build: <code>{tool.buildCmd}</code></span>
                    )}
                  </div>
                  <pre class="tools__example-code"><code>{tool.example}</code></pre>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="tools__docker-section">
      <div class="tools__docker-header">
        <h2 class="tools__docker-title">🐳 Docker Development Environment</h2>
        <p class="tools__docker-description">
          Every tool listed above is pre-installed and configured in our Docker containers.
          Version 1.0.0 provides stable, versioned images for educational use.
        </p>
      </div>

      <div class="tools__docker-examples">
        <h3>Quick Start Examples</h3>

        <div class="tools__docker-example">
          <h4>Commodore 64 Development</h4>
          <pre><code>{`docker pull ghcr.io/code198x/commodore-64:v2.0.0
docker run -it -v $(pwd):/workspace ghcr.io/code198x/commodore-64:v2.0.0
# Inside container:
acme -o demo.prg demo.asm
x64sc demo.prg  # Run in VICE emulator`}</code></pre>
        </div>

        <div class="tools__docker-example">
          <h4>Neo Geo Pocket Development</h4>
          <pre><code>{`docker pull ghcr.io/code198x/snk-neogeo-pocket:v2.0.0
docker run -it -v $(pwd):/workspace ghcr.io/code198x/snk-neogeo-pocket:v2.0.0
# Inside container:
asl -cpu TLCS-900 game.s
p2bin game.p game.ngp`}</code></pre>
        </div>

        <div class="tools__docker-example">
          <h4>PlayStation Development</h4>
          <pre><code>{`docker pull ghcr.io/code198x/sony-playstation:v2.0.0
docker run -it -v $(pwd):/workspace ghcr.io/code198x/sony-playstation:v2.0.0
# Inside container:
mips-linux-gnu-gcc -o demo.elf demo.c
elf2x demo.elf demo.exe`}</code></pre>
        </div>
      </div>

      <div class="tools__docker-features">
        <div class="tools__feature">
          <Icon name="check-circle" size={24} />
          <div>
            <h4>All Tools Included</h4>
            <p>Every assembler, compiler, and utility pre-installed</p>
          </div>
        </div>

        <div class="tools__feature">
          <Icon name="check-circle" size={24} />
          <div>
            <h4>Version Stability</h4>
            <p>Tagged releases ensure consistent environments</p>
          </div>
        </div>

        <div class="tools__feature">
          <Icon name="check-circle" size={24} />
          <div>
            <h4>Cross-Platform</h4>
            <p>Identical experience on Windows, macOS, and Linux</p>
          </div>
        </div>

        <div class="tools__feature">
          <Icon name="check-circle" size={24} />
          <div>
            <h4>Educational Focus</h4>
            <p>Designed for learning with examples and documentation</p>
          </div>
        </div>
      </div>

      <div class="tools__cta">
        <a href="https://github.com/code198x/development-environment" class="tools__btn tools__btn--primary">
          <Icon name="github" size={20} />
          View on GitHub
        </a>
        <a href="/getting-started" class="tools__btn tools__btn--secondary">
          <Icon name="arrow-right" size={20} />
          Get Started
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
/* Additional styles for comprehensive layout */
.tools__hero-stats {
  display: flex;
  gap: 2rem;
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.tools__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tools__stat-number {
  font-size: 2.5rem;
  font-weight: bold;
  color: var(--color-primary);
}

.tools__stat-label {
  font-size: 0.875rem;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.tools__family-section {
  margin: 4rem 0;
  padding: 2rem;
  background: var(--color-surface);
  border-radius: 8px;
}

.tools__family-header {
  margin-bottom: 2rem;
}

.tools__family-title {
  font-size: 1.75rem;
  color: var(--color-heading);
  margin-bottom: 0.5rem;
}

.tools__family-description {
  color: var(--color-text-muted);
}

.tools__toolchain-grid {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
}

.tools__toolchain-card {
  background: var(--color-background);
  padding: 1.5rem;
  border-radius: 6px;
  border: 1px solid var(--color-border);
}

.tools__toolchain-header {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 1rem;
}

.tools__toolchain-name {
  font-size: 1.25rem;
  font-weight: bold;
  color: var(--color-primary);
}

.tools__toolchain-subtitle {
  font-size: 0.875rem;
  color: var(--color-text-muted);
}

.tools__toolchain-systems {
  margin: 1rem 0;
  font-size: 0.875rem;
}

.tools__system-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.tools__system-tag {
  padding: 0.25rem 0.5rem;
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 500;
}

.tools__example {
  margin-top: 1rem;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  overflow: hidden;
}

.tools__example-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 1rem;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
}

.tools__example-title {
  font-weight: 500;
  font-size: 0.875rem;
}

.tools__build-cmd {
  font-size: 0.75rem;
  color: var(--color-text-muted);
}

.tools__build-cmd code {
  background: var(--color-background);
  padding: 0.125rem 0.25rem;
  border-radius: 2px;
}

.tools__example-code {
  margin: 0;
  padding: 1rem;
  background: var(--color-code-bg);
  overflow-x: auto;
  font-family: var(--font-mono);
  font-size: 0.875rem;
  line-height: 1.5;
}

.tools__docker-section {
  margin-top: 4rem;
  padding: 3rem;
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-surface) 100%);
  border-radius: 12px;
}

.tools__docker-examples {
  margin: 2rem 0;
}

.tools__docker-example {
  margin: 1.5rem 0;
}

.tools__docker-example h4 {
  margin-bottom: 0.5rem;
  color: var(--color-heading);
}

.tools__docker-example pre {
  background: var(--color-code-bg);
  padding: 1rem;
  border-radius: 6px;
  overflow-x: auto;
}

.tools__docker-features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin: 2rem 0;
}

.tools__feature {
  display: flex;
  gap: 1rem;
}

.tools__feature h4 {
  margin: 0 0 0.25rem 0;
  font-size: 1rem;
}

.tools__feature p {
  margin: 0;
  font-size: 0.875rem;
  color: var(--color-text-muted);
}

.tools__cta {
  display: flex;
  gap: 1rem;
  margin-top: 2rem;
}

.tools__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
}

.tools__btn--primary {
  background: var(--color-primary);
  color: white;
}

.tools__btn--primary:hover {
  background: var(--color-primary-dark);
}

.tools__btn--secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.tools__btn--secondary:hover {
  background: var(--color-background);
}
</style>