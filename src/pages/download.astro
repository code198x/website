---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="Download Development Environment - Code Like It's 198x">
	<Breadcrumb segments={[{ text: 'Download', href: '/download' }]} />
	
	<div class="max-w-4xl mx-auto px-4 py-8">
		<header class="text-center mb-12">
			<h1 class="text-4xl font-bold text-green-400 mb-4">
				Professional Retro Development Environment
			</h1>
			<p class="text-xl text-gray-300 max-w-3xl mx-auto">
				Get a complete, professional-grade development setup for Commodore 64, ZX Spectrum, 
				Nintendo Entertainment System, and Commodore Amiga assembly programming.
			</p>
		</header>

		<!-- Quick Start Section -->
		<section class="bg-gray-800 rounded-lg p-8 mb-12">
			<h2 class="text-2xl font-bold text-green-400 mb-6 flex items-center">
				<span class="text-3xl mr-3">🚀</span>
				30-Second Setup
			</h2>
			
			<div class="bg-black rounded-lg p-6 mb-6">
				<pre class="text-green-400 text-sm overflow-x-auto"><code># 1. Clone the repository
git clone https://github.com/code198x/dev-environment.git
cd dev-environment

# 2. Open in VS Code
code code198x.code-workspace

# 3. When prompted, click "Reopen in Container"
# 4. When prompted, click "Install Recommended Extensions"  
# 5. Start coding retro assembly! 🕹️</code></pre>
			</div>

			<div class="text-center">
				<a href="https://github.com/code198x/dev-environment" 
				   class="inline-flex items-center px-8 py-4 bg-green-600 hover:bg-green-500 text-white font-bold rounded-lg text-lg transition-colors">
					<span class="text-2xl mr-3">⬇️</span>
					Download from GitHub
				</a>
			</div>
		</section>

		<!-- What's Included -->
		<section class="mb-12">
			<h2 class="text-3xl font-bold text-green-400 mb-8 text-center">
				What's Included
			</h2>
			
			<div class="grid md:grid-cols-2 gap-8">
				<!-- Development Tools -->
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-blue-400 mb-4 flex items-center">
						<span class="text-2xl mr-3">🛠️</span>
						Professional Assemblers
					</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• <strong>CA65</strong> - 6502 assembly (C64, NES)</li>
						<li>• <strong>ACME</strong> - Alternative C64 assembler</li>
						<li>• <strong>SjASMPlus</strong> - Z80 assembly (ZX Spectrum)</li>
						<li>• <strong>VASM</strong> - 68000 assembly (Amiga)</li>
						<li>• <strong>NESASM3</strong> - Specialized NES assembler</li>
					</ul>
				</div>

				<!-- VS Code Integration -->
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-purple-400 mb-4 flex items-center">
						<span class="text-2xl mr-3">💻</span>
						VS Code Integration
					</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• Assembly syntax highlighting</li>
						<li>• One-click build commands</li>
						<li>• Integrated emulator launching</li>
						<li>• Code snippets & templates</li>
						<li>• Error detection & debugging</li>
					</ul>
				</div>

				<!-- Example Programs -->
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-yellow-400 mb-4 flex items-center">
						<span class="text-2xl mr-3">📚</span>
						16 Example Programs
					</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• Hello World programs</li>
						<li>• Graphics & color effects</li>
						<li>• Sprite animation</li>
						<li>• Sound & music generation</li>
						<li>• Hardware-specific features</li>
					</ul>
				</div>

				<!-- Docker Environment -->
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-red-400 mb-4 flex items-center">
						<span class="text-2xl mr-3">🐳</span>
						Docker Environment
					</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• Complete isolated environment</li>
						<li>• No software conflicts</li>
						<li>• Works on Windows, Mac, Linux</li>
						<li>• Zero configuration required</li>
						<li>• Professional build toolchain</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Supported Systems -->
		<section class="mb-12">
			<h2 class="text-3xl font-bold text-green-400 mb-8 text-center">
				Supported Systems
			</h2>
			
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
				<div class="bg-yellow-900 bg-opacity-50 rounded-lg p-6 text-center">
					<div class="text-4xl mb-3">🟤</div>
					<h3 class="font-bold text-yellow-400 mb-2">Commodore 64</h3>
					<p class="text-sm text-gray-300">6502 Assembly<br>CA65 & ACME</p>
				</div>
				
				<div class="bg-purple-900 bg-opacity-50 rounded-lg p-6 text-center">
					<div class="text-4xl mb-3">🌈</div>
					<h3 class="font-bold text-purple-400 mb-2">ZX Spectrum</h3>
					<p class="text-sm text-gray-300">Z80 Assembly<br>SjASMPlus & Pasmo</p>
				</div>
				
				<div class="bg-red-900 bg-opacity-50 rounded-lg p-6 text-center">
					<div class="text-4xl mb-3">🎮</div>
					<h3 class="font-bold text-red-400 mb-2">Nintendo NES</h3>
					<p class="text-sm text-gray-300">6502 Assembly<br>CA65 & NESASM</p>
				</div>
				
				<div class="bg-blue-900 bg-opacity-50 rounded-lg p-6 text-center">
					<div class="text-4xl mb-3">🟦</div>
					<h3 class="font-bold text-blue-400 mb-2">Commodore Amiga</h3>
					<p class="text-sm text-gray-300">68000 Assembly<br>VASM</p>
				</div>
			</div>
		</section>

		<!-- Requirements -->
		<section class="mb-12">
			<h2 class="text-3xl font-bold text-green-400 mb-8 text-center">
				System Requirements
			</h2>
			
			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-green-400 mb-4">💻 Hardware</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• 8GB RAM (recommended)</li>
						<li>• 5GB free disk space</li>
						<li>• 64-bit processor</li>
						<li>• Internet connection (setup)</li>
					</ul>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-blue-400 mb-4">🖥️ Software</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• Docker Desktop</li>
						<li>• VS Code</li>
						<li>• Git</li>
						<li>• Modern operating system</li>
					</ul>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-yellow-400 mb-4">🕹️ Optional</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• VICE (C64 emulator)</li>
						<li>• Fuse (Spectrum emulator)</li>
						<li>• FCEux (NES emulator)</li>
						<li>• FS-UAE (Amiga emulator)</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Quick Start Guide -->
		<section class="mb-12">
			<h2 class="text-3xl font-bold text-green-400 mb-8 text-center">
				Getting Started
			</h2>
			
			<div class="space-y-6">
				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-green-400 mb-4">Step 1: Install Prerequisites</h3>
					<div class="grid md:grid-cols-3 gap-4">
						<div>
							<h4 class="font-bold text-blue-400 mb-2">Docker Desktop</h4>
							<p class="text-sm text-gray-300 mb-2">Download from docker.com</p>
							<a href="https://www.docker.com/products/docker-desktop/" 
							   class="text-blue-400 hover:text-blue-300 text-sm">
								→ Download Docker
							</a>
						</div>
						<div>
							<h4 class="font-bold text-purple-400 mb-2">VS Code</h4>
							<p class="text-sm text-gray-300 mb-2">Free code editor</p>
							<a href="https://code.visualstudio.com/" 
							   class="text-purple-400 hover:text-purple-300 text-sm">
								→ Download VS Code
							</a>
						</div>
						<div>
							<h4 class="font-bold text-red-400 mb-2">Git</h4>
							<p class="text-sm text-gray-300 mb-2">Version control</p>
							<a href="https://git-scm.com/downloads" 
							   class="text-red-400 hover:text-red-300 text-sm">
								→ Download Git
							</a>
						</div>
					</div>
				</div>

				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-green-400 mb-4">Step 2: Download Environment</h3>
					<div class="bg-black rounded-lg p-4">
						<pre class="text-green-400 text-sm"><code>git clone https://github.com/code198x/dev-environment.git
cd dev-environment</code></pre>
					</div>
				</div>

				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-green-400 mb-4">Step 3: Open in VS Code</h3>
					<div class="bg-black rounded-lg p-4 mb-4">
						<pre class="text-green-400 text-sm"><code>code code198x.code-workspace</code></pre>
					</div>
					<p class="text-gray-300">VS Code will detect the dev container and prompt you to reopen. Click "Reopen in Container".</p>
				</div>

				<div class="bg-gray-800 rounded-lg p-6">
					<h3 class="text-xl font-bold text-green-400 mb-4">Step 4: Start Coding!</h3>
					<ul class="space-y-2 text-gray-300">
						<li>• Press <code class="bg-gray-700 px-2 py-1 rounded">Ctrl+Shift+P</code> to open Command Palette</li>
						<li>• Type "Tasks: Run Task" and select "🟤 Create New C64 Project"</li>
						<li>• Enter a project name like "hello"</li>
						<li>• Start writing assembly code!</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Learning Path -->
		<section class="mb-12">
			<h2 class="text-3xl font-bold text-green-400 mb-8 text-center">
				Recommended Learning Path
			</h2>
			
			<div class="grid md:grid-cols-2 gap-8">
				<div class="space-y-4">
					<h3 class="text-xl font-bold text-yellow-400">🎯 Beginners</h3>
					<ol class="space-y-3 text-gray-300">
						<li class="flex items-start">
							<span class="bg-green-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">1</span>
							<div>
								<strong>Start with C64 Hello World</strong><br>
								<span class="text-sm">Learn basic assembly structure</span>
							</div>
						</li>
						<li class="flex items-start">
							<span class="bg-green-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">2</span>
							<div>
								<strong>Try color and graphics examples</strong><br>
								<span class="text-sm">Understand memory mapping</span>
							</div>
						</li>
						<li class="flex items-start">
							<span class="bg-green-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">3</span>
							<div>
								<strong>Explore other systems</strong><br>
								<span class="text-sm">Compare different architectures</span>
							</div>
						</li>
					</ol>
				</div>
				
				<div class="space-y-4">
					<h3 class="text-xl font-bold text-blue-400">🚀 Advanced</h3>
					<ol class="space-y-3 text-gray-300">
						<li class="flex items-start">
							<span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">1</span>
							<div>
								<strong>Study hardware-specific examples</strong><br>
								<span class="text-sm">Copper lists, Blitter, PPU</span>
							</div>
						</li>
						<li class="flex items-start">
							<span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">2</span>
							<div>
								<strong>Create your own projects</strong><br>
								<span class="text-sm">Build games, demos, tools</span>
							</div>
						</li>
						<li class="flex items-start">
							<span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">3</span>
							<div>
								<strong>Test on real hardware</strong><br>
								<span class="text-sm">Use generated files on actual machines</span>
							</div>
						</li>
					</ol>
				</div>
			</div>
		</section>

		<!-- Features Highlight -->
		<section class="mb-12">
			<h2 class="text-3xl font-bold text-green-400 mb-8 text-center">
				Why This Environment?
			</h2>
			
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				<div class="bg-gray-800 rounded-lg p-6 text-center">
					<div class="text-4xl mb-4">⚡</div>
					<h3 class="font-bold text-green-400 mb-2">Instant Setup</h3>
					<p class="text-gray-300 text-sm">No manual configuration. Everything works out of the box.</p>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6 text-center">
					<div class="text-4xl mb-4">🎯</div>
					<h3 class="font-bold text-blue-400 mb-2">Professional Tools</h3>
					<p class="text-gray-300 text-sm">Same assemblers used by retro developers and demoscene.</p>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6 text-center">
					<div class="text-4xl mb-4">📚</div>
					<h3 class="font-bold text-yellow-400 mb-2">Learn by Example</h3>
					<p class="text-gray-300 text-sm">16 documented examples from basic to advanced.</p>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6 text-center">
					<div class="text-4xl mb-4">🔄</div>
					<h3 class="font-bold text-purple-400 mb-2">Cross-Platform</h3>
					<p class="text-gray-300 text-sm">Works identically on Windows, Mac, and Linux.</p>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6 text-center">
					<div class="text-4xl mb-4">💰</div>
					<h3 class="font-bold text-red-400 mb-2">Completely Free</h3>
					<p class="text-gray-300 text-sm">Open source. No licenses, no subscriptions.</p>
				</div>
				
				<div class="bg-gray-800 rounded-lg p-6 text-center">
					<div class="text-4xl mb-4">🚀</div>
					<h3 class="font-bold text-green-400 mb-2">Modern IDE</h3>
					<p class="text-gray-300 text-sm">1980s tools with 2024 development experience.</p>
				</div>
			</div>
		</section>

		<!-- Support -->
		<section class="bg-gray-800 rounded-lg p-8 text-center">
			<h2 class="text-2xl font-bold text-green-400 mb-4">
				Need Help?
			</h2>
			<p class="text-gray-300 mb-6">
				Check out the comprehensive documentation and community resources.
			</p>
			
			<div class="flex flex-wrap justify-center gap-4">
				<a href="https://github.com/code198x/dev-environment/blob/main/VSCODE_QUICKSTART.md" 
				   class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors">
					📖 Quick Start Guide
				</a>
				<a href="https://github.com/code198x/dev-environment/issues" 
				   class="inline-flex items-center px-6 py-3 bg-gray-600 hover:bg-gray-500 text-white rounded-lg transition-colors">
					🐛 Report Issues
				</a>
				<a href="https://github.com/code198x/dev-environment/discussions" 
				   class="inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-500 text-white rounded-lg transition-colors">
					💬 Community
				</a>
			</div>
		</section>
	</div>
</Layout>

<style>
	code {
		@apply bg-gray-700 px-2 py-1 rounded text-sm;
	}
</style>