---
import Layout from '../../layouts/Layout.astro';

// Game catalogue - this will grow as we add games
const games = [
  {
    number: 1,
    slug: 'game-01-neon-nexus',
    name: 'Neon Nexus',
    tagline: 'Fixed-screen action in a neon arena',
    units: 64,
    unitsAvailable: 16,
    skills: ['PPU graphics', 'Sprite management', 'NMI handling', 'Controller input'],
    status: 'in-progress'
  },
  {
    number: 2,
    slug: 'game-02-crate-escape',
    name: 'Crate Escape',
    tagline: 'Single-screen platformer with jump physics',
    units: 64,
    unitsAvailable: 0,
    skills: ['Gravity', 'Jump physics', 'Platform collision', 'Player animation'],
    status: 'coming-soon'
  },
  {
    number: 3,
    slug: 'game-03-stellar-barrage',
    name: 'Stellar Barrage',
    tagline: 'Fixed-screen space shooter with enemy waves',
    units: 64,
    unitsAvailable: 0,
    skills: ['Projectiles', 'Enemy formations', 'Collision types', 'Wave progression'],
    status: 'coming-soon'
  }
];

const systemColor = '#e30613';
---

<Layout
  title="Nintendo Entertainment System – Learn 6502 Assembly Through Games"
  description="Learn NES 6502 assembly by building complete games. Master the PPU, APU, and the processor that powered the console revolution."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #e30613 0%, #ff4444 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          45deg,
          transparent,
          transparent 10px,
          rgba(255, 255, 255, 0.1) 10px,
          rgba(255, 255, 255, 0.1) 20px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.3);
      letter-spacing: -0.02em;
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-6);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-4);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .status-strip {
      background: var(--color-surface);
      border: 2px solid #e30613;
      border-radius: 0.75rem;
      padding: var(--space-4);
      margin: var(--space-6) auto 0;
      max-width: 900px;
      text-align: center;
    }

    .status-strip a {
      color: #e30613;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 1px solid #e3061340;
      padding-bottom: 2px;
    }

    .status-strip small {
      display: block;
      color: var(--color-text-secondary);
      margin-top: var(--space-2);
    }

    /* Game Cards */
    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .game-card:hover {
      border-color: #e30613;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(227, 6, 19, 0.15);
    }

    .game-card.coming-soon {
      opacity: 0.6;
      cursor: default;
    }

    .game-card.coming-soon:hover {
      transform: none;
      box-shadow: none;
      border-color: var(--color-border);
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: #e30613;
      width: 3rem;
      text-align: center;
    }

    .game-card.coming-soon .game-number {
      color: var(--color-text-secondary);
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .game-tagline {
      color: var(--color-text-secondary);
      font-size: 1rem;
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: rgba(227, 6, 19, 0.1);
      color: #e30613;
      border-radius: 0.25rem;
      font-weight: 500;
    }

    .game-card.coming-soon .skill-tag {
      background: var(--color-bg);
      color: var(--color-text-secondary);
    }

    .game-progress {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      gap: var(--space-2);
      min-width: 100px;
    }

    .progress-bar {
      width: 100px;
      height: 6px;
      background: var(--color-border);
      border-radius: 3px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: #e30613;
      border-radius: 3px;
    }

    .progress-text {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-family: var(--font-family-mono);
    }

    .game-status {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    /* Features */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.125rem;
      color: #e30613;
      margin-bottom: var(--space-2);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* Memory Map */
    .memory-map {
      background: var(--color-surface);
      border: 2px solid #e30613;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-6) 0;
      font-family: var(--font-family-mono);
    }

    .memory-region {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .memory-region:last-child {
      border-bottom: none;
    }

    .memory-address {
      color: #e30613;
      font-weight: bold;
    }

    .memory-description {
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .game-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .game-number {
        width: auto;
      }

      .game-progress {
        align-items: center;
      }

      .game-skills {
        justify-content: center;
      }

      .system-specs {
        gap: var(--space-4);
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">NINTENDO ENTERTAINMENT SYSTEM</h1>
      <p class="system-subtitle">Learn 6502 assembly by building games</p>
      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">Ricoh 2A03</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">1.79 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">2 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Graphics</div>
          <div class="spec-value">PPU</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Sound</div>
          <div class="spec-value">APU</div>
        </div>
      </div>
    </div>
  </section>

  <div class="status-strip">
    <div><a href="/nintendo-entertainment-system/game-01-neon-nexus/unit-01">Neon Nexus</a> units 01–16 are live.</div>
    <small>Crate Escape and Stellar Barrage coming soon.</small>
  </div>

  <!-- Getting Started -->
  <section class="content-section">
    <h2 class="section-title">Before You Begin</h2>
    <p class="section-intro">
      You'll need an assembler and an emulator. Both are free and take five minutes to install.
    </p>
    <a
      href="/nintendo-entertainment-system/getting-started"
      style="display: inline-block; padding: var(--space-3) var(--space-6);
             background: var(--color-surface); border: 2px solid #e30613;
             color: #e30613; border-radius: 0.5rem;
             text-decoration: none; font-weight: 600;"
    >
      Set Up Your Tools →
    </a>
  </section>

  <!-- Games Catalogue -->
  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      Each game teaches new skills while building something you'll want to play. Start with Game 1 and work through in order — each builds on what came before.
    </p>

    <div class="game-grid">
      {games.map((game) => (
        <a
          href={`/nintendo-entertainment-system/${game.slug}`}
          class={`game-card ${game.status === 'coming-soon' ? 'coming-soon' : ''}`}
        >
          <div class="game-number">{game.number}</div>
          <div class="game-info">
            <div class="game-name">{game.name}</div>
            <div class="game-tagline">{game.tagline}</div>
            <div class="game-skills">
              {game.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          <div class="game-progress">
            {game.status === 'coming-soon' ? (
              <span class="game-status">Coming Soon</span>
            ) : (
              <>
                <div class="progress-bar">
                  <div class="progress-fill" style={`width: ${(game.unitsAvailable / game.units) * 100}%`}></div>
                </div>
                <span class="progress-text">{game.unitsAvailable} / {game.units} units</span>
              </>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- What You'll Master -->
  <section class="content-section">
    <h2 class="section-title">What You'll Master</h2>
    <p class="section-intro">
      By the time you've built all the games, you'll have deep knowledge of NES hardware and 6502 assembly.
    </p>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">PPU Graphics</h3>
        <p class="feature-description">
          Master the Picture Processing Unit: tiles, sprites, nametables, and the scrolling techniques that defined a generation.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">APU Sound</h3>
        <p class="feature-description">
          Program the Audio Processing Unit's five channels: two pulse waves, triangle, noise, and DMC for authentic 8-bit music.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">6502 Assembly</h3>
        <p class="feature-description">
          The instruction set that powered the console revolution. Zero page, indexed addressing, and cycle-counted code.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Mapper Magic</h3>
        <p class="feature-description">
          Understand cartridge mappers and how they expanded the NES beyond its limits. Bank switching and advanced techniques.
        </p>
      </div>
    </div>
  </section>

  <!-- Memory Map -->
  <section class="content-section">
    <h2 class="section-title">Memory Map</h2>
    <p class="section-intro">
      The NES has a compact but powerful memory layout — just 2KB of RAM, with memory-mapped I/O for PPU and APU.
    </p>

    <div class="memory-map">
      <div class="memory-region">
        <span class="memory-address">$0000-$07FF</span>
        <span class="memory-description">RAM (2KB, mirrored to $1FFF)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$2000-$2007</span>
        <span class="memory-description">PPU Registers</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$4000-$4017</span>
        <span class="memory-description">APU & I/O Registers</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$8000-$FFFF</span>
        <span class="memory-description">PRG-ROM (cartridge code)</span>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Start?</h2>
    <p class="section-intro" style="margin-left: auto; margin-right: auto;">
      Game 1 starts with the PPU — setting up palettes and drawing to the screen. By the end of Unit 1, you'll have a coloured background rendered by real NES hardware.
    </p>
    <a
      href="/nintendo-entertainment-system/game-01-neon-nexus"
      style="display: inline-block; padding: var(--space-3) var(--space-6);
             background: #e30613; color: white; border-radius: 0.5rem;
             text-decoration: none; font-weight: 600; font-size: 1.1rem;"
    >
      Start Game 1: Neon Nexus →
    </a>
  </section>
</Layout>
