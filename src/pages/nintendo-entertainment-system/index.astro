---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Nintendo Entertainment System - Learn 6502 Assembly">
  <style>
    .system-hero {
      min-height: 400px;
      background: linear-gradient(135deg, #ff0000 0%, #ff6b6b 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          45deg,
          transparent,
          transparent 10px,
          rgba(255, 255, 255, 0.1) 10px,
          rgba(255, 255, 255, 0.1) 20px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.3);
      letter-spacing: -0.02em;
    }

    .system-subtitle {
      font-size: 1.5rem;
      margin-bottom: var(--space-6);
      text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.3);
    }

    .system-specs {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-6);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-16) var(--space-4);
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .coming-soon-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
      margin: var(--space-8) auto;
      max-width: 600px;
    }

    .coming-soon-icon {
      font-size: 4rem;
      margin-bottom: var(--space-4);
    }

    .coming-soon-title {
      font-size: 1.5rem;
      color: var(--color-text);
      margin-bottom: var(--space-3);
    }

    .coming-soon-text {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      color: #ff0000;
      margin-bottom: var(--space-3);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .ppu-demo {
      background: var(--color-surface);
      border: 2px solid #ff0000;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
    }

    .tile-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 4px;
      margin: var(--space-4) 0;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    .tile {
      aspect-ratio: 1;
      background: linear-gradient(45deg, #ff0000 25%, transparent 25%, transparent 75%, #ff0000 75%, #ff0000),
                  linear-gradient(45deg, #ff0000 25%, transparent 25%, transparent 75%, #ff0000 75%, #ff0000);
      background-size: 8px 8px;
      background-position: 0 0, 4px 4px;
      opacity: 0.3;
      border: 1px solid var(--color-border);
    }

    .memory-map {
      background: var(--color-surface);
      border: 2px solid #ff0000;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
      font-family: var(--font-family-mono);
    }

    .memory-region {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .memory-region:last-child {
      border-bottom: none;
    }

    .memory-address {
      color: #ff0000;
      font-weight: bold;
    }

    .memory-description {
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .system-specs {
        gap: var(--space-4);
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">NINTENDO ENTERTAINMENT SYSTEM</h1>
      <p class="system-subtitle">Pure 6502 assembly—no BASIC, just the metal</p>
      <p style="font-style: italic; opacity: 0.9;">Write code that runs on real hardware. Tier 1 beginning now.</p>

      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">Ricoh 2A03</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">1.79 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">2 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Released</div>
          <div class="spec-value">1983</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Course Paths -->
  <section class="content-section">
    <h2 class="section-title">Learning Path</h2>

    <div class="feature-grid" style="margin-top: var(--space-6);">
      <div class="feature-card" style="border: 2px solid #e30613;">
        <h3 class="feature-title">⚙️ 6502 Assembly (Phase 1)</h3>
        <p class="feature-description" style="margin-bottom: var(--space-4);">
          The NES has no BASIC interpreter—you write assembly code that talks directly to the hardware.
          Master the iNES ROM format, PPU (Picture Processing Unit) initialization, VBlank timing, palette RAM,
          and interrupt vectors. Build working ROMs that run on FCEUX, Mesen, or real hardware via flash cart.
        </p>
        <p style="margin-bottom: var(--space-3);"><strong>Tier 1 Complete • 32 lessons available</strong></p>
        <ul style="list-style: none; padding: 0; color: var(--color-text-secondary); font-size: 0.9rem;">
          <li>✅ Tier 1: Complete Pong Game — iNES header, 6502 basics, PPU initialization, OAM sprites, controller input, collision detection, ball physics, scoring system, 2-player gameplay, APU sound effects, game states — Complete!</li>
          <li style="margin-top: var(--space-3);">→ 32 comprehensive lessons building a complete 60fps Pong game in 6502 assembly</li>
        </ul>
        <a href="/nintendo-entertainment-system/phase-1"
           style="display: inline-block; margin-top: var(--space-4); padding: var(--space-2) var(--space-4);
                  background: #e30613; color: white; border-radius: 0.375rem;
                  text-decoration: none; font-weight: 600; font-size: 0.9rem;">
          Start Learning Assembly →
        </a>
      </div>

      <div class="feature-card" style="border: 2px solid var(--color-border); opacity: 0.7;">
        <h3 class="feature-title">🎮 Advanced NES Programming</h3>
        <p class="feature-description" style="margin-bottom: var(--space-4);">
          Master sprites, nametables, scrolling, CHR-ROM, mappers, and sound (APU). Learn advanced techniques
          like sprite multiplexing, raster effects, and bank switching. Build complete games that rival
          commercial releases from the 1980s.
        </p>
        <p style="margin-bottom: var(--space-3);"><strong>Coming soon: Advanced phases with sprites and sound</strong></p>
        <div style="display: inline-block; margin-top: var(--space-4); padding: var(--space-2) var(--space-4);
                    background: var(--color-surface); color: var(--color-text-secondary); border: 2px solid var(--color-border); border-radius: 0.375rem;
                    font-weight: 600; font-size: 0.9rem;">
          In Development
        </div>
      </div>
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="content-section">
    <h2 class="section-title">What You'll Learn</h2>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">PPU Programming</h3>
        <p class="feature-description">
          Master the Picture Processing Unit: tiles, sprites, nametables,
          and the famous scrolling techniques that defined a generation.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">APU Sound</h3>
        <p class="feature-description">
          Program the Audio Processing Unit's five channels: two pulse waves,
          triangle, noise, and DMC for authentic 8-bit music.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Mapper Magic</h3>
        <p class="feature-description">
          Understand cartridge mappers and how they expanded the NES beyond
          its limits. Bank switching and advanced techniques.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Controller Input</h3>
        <p class="feature-description">
          Read the iconic NES controller. Implement responsive controls
          and special button combinations for your games.
        </p>
      </div>
    </div>
  </section>

  <!-- PPU Pattern Tables Demo -->
  <section class="content-section">
    <h2 class="section-title">8×8 Pixel Tiles: The Building Blocks</h2>

    <div class="ppu-demo">
      <p style="text-align: center; margin-bottom: var(--space-4); color: var(--color-text-secondary);">
        Every NES graphic is built from 8×8 pixel tiles stored in pattern tables
      </p>

      <div class="tile-grid">
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
        <div class="tile"></div>
      </div>

      <p style="text-align: center; margin-top: var(--space-4); font-size: 0.875rem; color: var(--color-text-secondary);">
        Combine these tiles to create characters, backgrounds, and entire worlds
      </p>
    </div>
  </section>

  <!-- Memory Map Preview -->
  <section class="content-section">
    <h2 class="section-title">NES Memory Map</h2>

    <div class="memory-map">
      <div class="memory-region">
        <span class="memory-address">$0000-$07FF</span>
        <span class="memory-description">RAM (2KB, mirrored)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$2000-$2007</span>
        <span class="memory-description">PPU Registers</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$4000-$4017</span>
        <span class="memory-description">APU & I/O Registers</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$4020-$FFFF</span>
        <span class="memory-description">Cartridge Space</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$8000-$FFFF</span>
        <span class="memory-description">PRG-ROM</span>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Program the NES?</h2>
    <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 600px; margin-left: auto; margin-right: auto;">
      Install ca65/ld65, boot your emulator, and write your first NES ROM. No BASIC interpreter, no frameworks—just
      you, the 6502, and direct hardware control. Build something that runs on real hardware.
    </p>
    <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
      <a href="/nintendo-entertainment-system/phase-1"
         style="display: inline-block; padding: var(--space-3) var(--space-6);
                background: #e30613; color: white; border-radius: 0.5rem;
                text-decoration: none; font-weight: 600;">
        Start Coding →
      </a>
      <a href="https://github.com/code198x"
         style="display: inline-block; padding: var(--space-3) var(--space-6);
                background: transparent; color: #e30613; border: 2px solid #e30613; border-radius: 0.5rem;
                text-decoration: none; font-weight: 600;">
        View on GitHub
      </a>
    </div>
  </section>
</Layout>