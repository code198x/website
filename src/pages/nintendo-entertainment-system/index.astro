---
import Layout from '../../layouts/Layout.astro';
import SystemHero from '../../components/SystemHero.astro';
import PathCard from '../../components/PathCard.astro';
import VaultCard from '../../components/VaultCard.astro';
import SetupCallout from '../../components/SetupCallout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { Binary } from '@lucide/astro';

const platformColor = '#e30613';

const specs = [
  { label: 'CPU', value: 'Ricoh 2A03' },
  { label: 'Speed', value: '1.79 MHz' },
  { label: 'RAM', value: '2 KB' },
  { label: 'Graphics', value: 'PPU' },
  { label: 'Sound', value: 'APU' },
];

const assemblyStats = [
  { value: '18', label: 'Games' },
  { value: '1,408', label: 'Units' },
];

const vaultArticles = [
  {
    href: '/vault/systems/nes',
    kicker: 'Hardware',
    title: 'Nintendo Entertainment System',
    description: 'The 8-bit console that revived home gaming and defined a generation of players.',
  },
  {
    href: '/vault/culture/bedroom-coder',
    kicker: 'Culture',
    title: 'The Bedroom Coder',
    description: 'How teenagers with cassette decks built a multi-billion pound industry.',
  },
  {
    href: '/vault/techniques/cassette-loading',
    kicker: 'Technique',
    title: 'Cassette Loading',
    description: 'How magnetic tape became playable games - the technology behind the loading screen.',
  },
];
---

<Layout
  title="Nintendo Entertainment System – Learn 6502 Assembly Through Games"
  description="Learn NES 6502 assembly by building complete games. Master the PPU, APU, and the processor that powered the console revolution."
  platformColor={platformColor}
>
  <style>
    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .path-container {
      max-width: 500px;
      margin: var(--space-8) auto 0;
    }

    .path-icon {
      color: var(--platform-color, #e30613);
      margin-bottom: var(--space-3);
    }

    .console-note {
      text-align: center;
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      margin-top: var(--space-8);
      padding: var(--space-4);
      background: var(--color-surface);
      border-radius: 0.5rem;
      border: 1px solid var(--color-border);
    }

    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .about-section {
      padding: var(--space-10) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .about-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .about-text {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: var(--space-4);
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }
  </style>

  <!-- System Hero -->
  <SystemHero
    title="NINTENDO ENTERTAINMENT SYSTEM"
    subtitle="The console that saved gaming"
    platformColor={platformColor}
    specs={specs}
    variant="stripes"
  />

  <!-- About This System -->
  <section class="about-section">
    <h2 class="about-title">Why the Nintendo Entertainment System?</h2>
    <div class="about-text">
      <p>
        The NES didn't just revive the video game industry after the crash of 1983 — it defined what
        console gaming could be. Nintendo's strict quality control created a library of legendary
        titles: Super Mario Bros, The Legend of Zelda, Metroid, Mega Man. These weren't just fun
        games; they were masterclasses in design and programming efficiency.
      </p>
      <p>
        With just 2 KB of RAM and a 1.79 MHz processor, NES developers achieved remarkable things
        through clever use of the PPU (Picture Processing Unit) and APU (Audio Processing Unit).
        Learning NES development teaches you to think in tiles and sprites, to squeeze every cycle
        from limited hardware, and to understand the console architecture that shaped an entire
        industry. The homebrew community remains active, with new games still being released on
        original cartridges.
      </p>
    </div>
  </section>

  <!-- Quick Setup -->
  <SetupCallout dockerImage="code198x/nintendo-entertainment-system" />

  <!-- Single Path -->
  <section class="content-section">
    <h2 class="section-title">The Assembly Path</h2>
    <p class="section-intro">
      The NES has no built-in programming language — everything is assembly. Master the PPU, APU,
      and the 6502 processor that powered the console revolution.
    </p>

    <div class="path-container">
      <PathCard
        href="/nintendo-entertainment-system/assembly"
        title="6502 Assembly"
        subtitle="Full hardware control"
        description="Learn the architecture behind Super Mario Bros, The Legend of Zelda, and Mega Man. Master the PPU for tiles and sprites, the APU for iconic 8-bit sound, and cartridge mappers for games that pushed beyond the hardware limits."
        stats={assemblyStats}
        platformColor={platformColor}
        isRecommended
        ctaText="Start Building Games"
      >
        <Binary size={32} class="path-icon" slot="icon" />
      </PathCard>
    </div>

    <p class="console-note">
      Unlike home computers of the era, the NES was a dedicated games console with no built-in
      BASIC. All NES development is in assembly — and that's what made it special.
    </p>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <SectionHeader
        title="From the Vault"
        linkHref="/vault"
        linkText="View all articles"
        platformColor={platformColor}
      />
      <div class="vault-grid">
        {vaultArticles.map((article) => (
          <VaultCard
            href={article.href}
            kicker={article.kicker}
            title={article.title}
            description={article.description}
            platformColor={platformColor}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
