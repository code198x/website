---
import Layout from '../../../layouts/Layout.astro';
import SystemHero from '../../../components/SystemHero.astro';
import TrackGames from '../../../components/TrackGames.astro';
import FeatureGrid from '../../../components/FeatureGrid.astro';
import { getModulesWithAvailability } from '../../../lib/modules';

const platformColor = '#e30613';
const games = await getModulesWithAvailability('nintendo-entertainment-system', 'assembly');

const specs = [
  { label: 'CPU', value: 'Ricoh 2A03' },
  { label: 'Speed', value: '1.79 MHz' },
  { label: 'RAM', value: '2 KB' },
  { label: 'Graphics', value: 'PPU' },
  { label: 'Sound', value: 'APU' },
];

const features = [
  { title: 'PPU graphics', description: 'Master the Picture Processing Unit: tiles, sprites, nametables, and the scrolling techniques that defined a generation.' },
  { title: 'APU sound', description: "Program the Audio Processing Unit's five channels: two pulse waves, triangle, noise, and DMC for authentic 8-bit music." },
  { title: '6502 assembly', description: 'The instruction set that powered the console revolution. Zero page, indexed addressing, and cycle-counted code.' },
  { title: 'Mapper magic', description: 'Understand cartridge mappers and how they expanded the NES beyond its limits. Bank switching and advanced techniques.' },
];

const memory = [
  { addr: '$0000–$07FF', desc: 'RAM (2 KB, mirrored to $1FFF)' },
  { addr: '$2000–$2007', desc: 'PPU registers' },
  { addr: '$4000–$4017', desc: 'APU & I/O registers' },
  { addr: '$8000–$FFFF', desc: 'PRG-ROM (cartridge code)' },
];
---

<Layout
  title="Nintendo Entertainment System – Learn 6502 Assembly Through Games"
  description="Learn NES 6502 assembly by building complete games. Master the PPU, APU, and the processor that powered the console revolution."
  platformColor={platformColor}
>
  <SystemHero
    title="NES assembly"
    subtitle="Learn 6502 assembly by building games"
    kicker="NES · Assembly · 6502"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <section class="content-section">
      <h2 class="section-title">Before you begin</h2>
      <p class="section-intro">You'll need an assembler and an emulator. Both are free and take five minutes to install.</p>
      <a href="/nintendo-entertainment-system/getting-started" class="btn btn-secondary">Set up your tools →</a>
    </section>

    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Each game teaches new skills while building something you'll want to play. Start with Game 1 and work through in order — each builds on what came before.</p>
      <TrackGames games={games} platform="nintendo-entertainment-system" track="assembly" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">What you'll master</h2>
      <p class="section-intro">By the time you've built all the games, you'll have deep knowledge of NES hardware and 6502 assembly.</p>
      <FeatureGrid features={features} platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">Memory map</h2>
      <p class="section-intro">The NES has a compact but powerful memory layout — just 2 KB of RAM, with memory-mapped I/O for the PPU and APU.</p>
      <div class="memory-map">
        {memory.map(r => (
          <div class="memory-region"><span class="memory-address">{r.addr}</span><span class="memory-description">{r.desc}</span></div>
        ))}
      </div>
    </section>

    <section class="content-section center">
      <h2 class="section-title">Ready to start?</h2>
      <p class="section-intro">Game 1 starts with the PPU — building a complete NES cartridge from scratch. By the end of Unit 1, you'll have a sprite on screen drawn by real NES hardware.</p>
      <a href="/nintendo-entertainment-system/assembly/dash/unit-01" class="btn btn-primary">Start Game 1: Dash →</a>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .content-section.center { text-align: center; }
  .content-section.center .section-intro { margin-left: auto; margin-right: auto; }
  .content-section.center .section-title::after { margin-left: auto; margin-right: auto; }

  .memory-map { display: flex; flex-direction: column; gap: var(--space-2); }
  .memory-region { display: flex; gap: var(--space-4); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--color-surface); border: 3px solid var(--color-border); border-left-width: 6px; border-left-color: var(--platform-color); }
  .memory-address { font-family: var(--font-family-mono); font-weight: 700; color: var(--ink); min-width: 11ch; }
  .memory-description { color: var(--color-text-secondary); }
</style>
