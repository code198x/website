---
import Layout from '../../layouts/Layout.astro';
import BrowseFacet from '../../components/BrowseFacet.astro';
import { getAllPlatforms, getAllManufacturers } from '../../lib/platforms';

const platforms = await getAllPlatforms();
const manufacturers = await getAllManufacturers();
const makerName = new Map(manufacturers.map(m => [m.id, m.data.shortName]));
const REGION: Record<string, string> = { US: 'US', UK: 'UK', Japan: 'JP', Europe: 'EU', Netherlands: 'NL' };
const toSys = (p: typeof platforms[number]) => ({
  slug: p.id, name: p.data.shortName, year: p.data.year,
  maker: makerName.get(p.data.manufacturer) ?? p.data.manufacturer,
  tier: p.data.tier ?? 'planned', country: REGION[p.data.region] ?? p.data.region, color: p.data.color,
});

const DECADES: Array<[string, number, number, string]> = [
  ['1975–79', 1975, 1979, 'Genesis'],
  ['1980–84', 1980, 1984, 'Home-computer boom'],
  ['1985–89', 1985, 1989, 'Where the curriculum lives'],
  ['1990–94', 1990, 1994, '16-bit · the bridge'],
  ['1995–99', 1995, 1999, 'Edge of the canon'],
  ['2000–05', 2000, 2005, 'The strain test'],
];
const groups = DECADES.map(([label, lo, hi, sublabel]) => ({
  label, sublabel,
  systems: platforms.filter(p => p.data.year >= lo && p.data.year <= hi).sort((a, b) => a.data.year - b.data.year).map(toSys),
})).filter(g => g.systems.length > 0);
---

<Layout title="Browse by era" description="The fleet across four decades, decade by decade.">
  <BrowseFacet
    crumb={['Browse', 'By era']}
    title="Four decades."
    intro="Computing 1975 → 2005, grouped by decade. The curriculum's centre of gravity sits in the mid-80s home-computer boom; the edges strain earlier and later."
    groups={groups}
  />
</Layout>
