---
/**
 * Browse hub — /browse/
 *
 * Discovery that cuts sideways across the system-first curriculum (IA v3 §10).
 * Six axes; platform/era/region are data-driven from the manifest today, the
 * remaining three are honest scaffolds that fill in as content gets tagged.
 */
import Layout from '../../layouts/Layout.astro';
import { getAllPlatforms, getPlatformsByRegion } from '../../lib/platforms';

const systems = await getAllPlatforms();
const byRegion = await getPlatformsByRegion();

const axes = [
  { href: '/browse/by-platform', name: 'By platform', desc: 'Every machine, 1975 → 2005', count: String(systems.length), live: true },
  { href: '/browse/by-era', name: 'By era', desc: 'Six decades — the curriculum lives mid-80s', count: '6', live: true },
  { href: '/browse/by-region', name: 'By region', desc: 'UK · US · Japan · Europe and beyond', count: String(byRegion.size), live: true },
  { href: '/browse/by-genre', name: 'By genre', desc: 'Platformer · shooter · puzzle · adventure', count: null, live: false },
  { href: '/browse/by-technique', name: 'By technique', desc: 'Multiplexing · scrolling · collision', count: null, live: false },
  { href: '/browse/by-difficulty', name: 'By difficulty', desc: 'Foundation → Capstone', count: null, live: false },
];

const prompts = [
  { label: 'Machines that came out of Britain', href: '/browse/by-region' },
  { label: 'What shipped in 1986', href: '/browse/by-era' },
  { label: 'Every machine we teach', href: '/systems' },
  { label: 'The whole timeline', href: '/timeline' },
];
---

<Layout title="Browse" description="Cut sideways across the curriculum — by platform, era, region, genre, technique, or difficulty.">
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Cut across</p>
      <h1>Browse the curriculum sideways.</h1>
      <div class="herorule"></div>
      <p class="lede">The curriculum is system-first. But sometimes you want every shoot-'em-up, every
        1986 machine, every British micro in one place. These are the cuts.</p>
    </div>

    <div class="axes">
      {axes.map(a => (
        <a href={a.href} class={`axis ${a.live ? '' : 'soon'}`}>
          <div class="axis-n">{a.count ?? '··'}<span class="axis-cuts">{a.live ? 'cuts' : 'soon'}</span></div>
          <h2>{a.name}</h2>
          <p>{a.desc}</p>
        </a>
      ))}
    </div>

    <p class="eyebrow prompts-head">Try one of these</p>
    <div class="prompts">
      {prompts.map(p => <a href={p.href} class="prompt">{p.label}</a>)}
    </div>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-5) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 68ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  .axes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .axis { display: block; background: var(--color-surface); border: 3px solid var(--color-border); padding: var(--space-5); text-decoration: none; color: var(--color-text); min-height: 150px; transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
  .axis:hover, .axis:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--color-house-2); border-color: var(--color-house-2); }
  .axis.soon { border-style: dashed; }
  .axis-n { font-family: var(--font-family-script); font-weight: 700; font-size: 2.4rem; line-height: 1; color: var(--color-house-2); display: flex; align-items: baseline; gap: 6px; }
  .axis-cuts { font-family: var(--font-family-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); }
  .axis h2 { font-size: 1.3rem; font-weight: 800; margin: var(--space-2) 0 0; }
  .axis p { font-size: 0.85rem; color: var(--color-text-secondary); margin: var(--space-1) 0 0; }

  .prompts-head { margin-top: var(--space-10); }
  .prompts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .prompt { font-family: var(--font-family-mono); font-size: 0.78rem; padding: 6px 10px; border: 2px solid var(--color-border); background: var(--color-surface); color: var(--color-text); text-decoration: none; }
  .prompt:hover { border-color: var(--color-house-2); color: var(--color-house-2); }

  @media (max-width: 860px) { .axes { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .axes { grid-template-columns: 1fr; } }
</style>
