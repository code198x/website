---
import Layout from '../../layouts/Layout.astro';
import BrowseFacet from '../../components/BrowseFacet.astro';
import { getAllPlatforms, getAllManufacturers } from '../../lib/platforms';

const platforms = await getAllPlatforms();
const manufacturers = await getAllManufacturers();
const makerName = new Map(manufacturers.map(m => [m.id, m.data.shortName]));
const REGION: Record<string, string> = { US: 'US', UK: 'UK', Japan: 'JP', Europe: 'EU', Netherlands: 'NL' };
const toSys = (p: typeof platforms[number]) => ({
  slug: p.id, name: p.data.shortName, year: p.data.year,
  maker: makerName.get(p.data.manufacturer) ?? p.data.manufacturer,
  tier: p.data.tier ?? 'planned', country: REGION[p.data.region] ?? p.data.region, color: p.data.color,
});

// Region display order + flavour. Geography is a facet (IA v3 §"Geography").
const REGIONS: Array<[string, string, string]> = [
  ['UK', 'United Kingdom', 'Bedroom coders · BASIC · Crash · Acorn'],
  ['US', 'United States', 'Microcomputers · the crash · 16-bit'],
  ['Japan', 'Japan', 'Famicom era · consoles · handhelds'],
  ['Europe', 'Continental Europe', 'Atari ST · CPC · demoscene strongholds'],
  ['Netherlands', 'Netherlands', 'Philips and the CD-i experiment'],
];
const groups = REGIONS.map(([region, label, sublabel]) => ({
  label, sublabel,
  systems: platforms.filter(p => p.data.region === region).sort((a, b) => a.data.year - b.data.year).map(toSys),
})).filter(g => g.systems.length > 0);
---

<Layout title="Browse by region" description="Where the machines came from — the fleet by geography.">
  <BrowseFacet
    title="Where they came from."
    intro="Computing's centre of gravity moved across the four decades. The fleet by geography — the deeper regional stories live in the Vault, when someone writes them."
    groups={groups}
  />
</Layout>
