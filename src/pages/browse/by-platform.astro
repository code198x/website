---
import Layout from '../../layouts/Layout.astro';
import BrowseFacet from '../../components/BrowseFacet.astro';
import { getAllPlatforms, getAllManufacturers } from '../../lib/platforms';

const platforms = await getAllPlatforms();
const manufacturers = await getAllManufacturers();
const makerName = new Map(manufacturers.map(m => [m.id, m.data.shortName]));
const REGION: Record<string, string> = { US: 'US', UK: 'UK', Japan: 'JP', Europe: 'EU', Netherlands: 'NL' };
const toSys = (p: typeof platforms[number]) => ({
  slug: p.id, name: p.data.shortName, year: p.data.year,
  maker: makerName.get(p.data.manufacturer) ?? p.data.manufacturer,
  tier: p.data.tier ?? 'planned', country: REGION[p.data.region] ?? p.data.region, color: p.data.color,
});

const KINDS: Array<[string, string, string]> = [
  ['computer', 'Home computers', 'Keyboards, BASIC, the bedroom'],
  ['console', 'Consoles', 'Cartridges and the living-room TV'],
  ['handheld', 'Handhelds', 'Games in your pocket'],
];
const groups = KINDS.map(([type, label, sublabel]) => ({
  label, sublabel,
  systems: platforms.filter(p => p.data.type === type).sort((a, b) => a.data.year - b.data.year || a.id.localeCompare(b.id)).map(toSys),
})).filter(g => g.systems.length > 0);
---

<Layout title="Browse by platform" description="Every machine in the fleet, grouped by form factor.">
  <BrowseFacet
    title="Every machine."
    intro="The whole fleet by form factor — home computers, consoles, handhelds. Colour and a stamp mark what's live or next; everything else is a real page, waiting for its lessons."
    groups={groups}
  />
</Layout>
