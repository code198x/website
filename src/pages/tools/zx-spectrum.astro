---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/tools.css";
---

<Layout
  title="ZX Spectrum Development Tools"
  description="Complete guide to ZX Spectrum development with sjasmplus, z88dk, and Fuse. Learn Z80 assembly, create demos, and build games for the computer that defined British gaming."
>
  <div class="system-tools">
    <section class="system-tools__hero">
      <div class="system-tools__hero-content">
        <div class="system-tools__breadcrumb">
          <a href="/tools">Tools</a> / <span>ZX Spectrum</span>
        </div>
        <h1 class="system-tools__title">
          <span class="system-tools__icon">🌈</span>
          ZX Spectrum Development
        </h1>
        <p class="system-tools__description">
          Sir Clive Sinclair's ZX Spectrum brought affordable computing to millions of homes
          worldwide. With its distinctive rubber keyboard, color clash graphics, and legendary
          beeper sound, the Speccy created an entire generation of bedroom coders and spawned
          a thriving demo and games scene that continues today.
        </p>
        <div class="system-tools__specs">
          <div class="system-tools__spec">
            <strong>CPU:</strong> Zilog Z80A @ 3.5 MHz
          </div>
          <div class="system-tools__spec">
            <strong>RAM:</strong> 16/48/128 KB
          </div>
          <div class="system-tools__spec">
            <strong>Graphics:</strong> 256×192, 15 colors, attribute clash
          </div>
          <div class="system-tools__spec">
            <strong>Sound:</strong> Beeper (48K) / AY-3-8912 (128K)
          </div>
        </div>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>Available Toolchains</h2>

      <div class="toolchain-detail">
        <h3>sjasmplus - Modern Z80 Cross-Assembler</h3>
        <p class="toolchain-detail__description">
          sjasmplus is a powerful Z80 cross-assembler with many extensions specifically
          designed for ZX Spectrum development. It supports modern features like Lua scripting,
          conditional assembly, and direct TAP/TZX/SNA output generation.
        </p>
        <pre class="code-example"><code># Pull the Docker image
docker pull ghcr.io/code198x/zx-spectrum-tools:v2.0.0

# Run interactive development environment
docker run -it -v $(pwd):/workspace ghcr.io/code198x/zx-spectrum-tools:v2.0.0 bash

# Assemble Z80 code to TAP file
sjasmplus --lst=program.lst --tap=program.tap main.asm

# Create snapshot for instant loading
sjasmplus --sna=program.sna main.asm</code></pre>
      </div>

      <div class="toolchain-detail">
        <h3>z88dk - C Compiler & Libraries</h3>
        <p class="toolchain-detail__description">
          z88dk is a complete development kit for Z80-based computers, including extensive
          libraries for the ZX Spectrum. It allows you to write programs in C while still
          having access to inline assembly for performance-critical sections.
        </p>
        <pre class="code-example"><code># Compile C program for ZX Spectrum
zcc +zx -create-app -o program.tap main.c

# Compile with optimization and custom origin
zcc +zx -O3 -zorg=32768 -create-app main.c

# Mix C and assembly
zcc +zx -create-app main.c graphics.asm sound.asm</code></pre>
      </div>

      <div class="toolchain-detail">
        <h3>pasmo - Portable Z80 Assembler</h3>
        <p class="toolchain-detail__description">
          pasmo is a simple, portable Z80 cross-assembler with support for undocumented
          opcodes and direct TAP file generation. It's perfect for smaller projects and
          learning Z80 assembly.
        </p>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>Memory Map</h2>
      <div class="memory-map">
        <table class="memory-map__table">
          <thead>
            <tr>
              <th>Address Range</th>
              <th>Description</th>
              <th>Size</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>$0000-$3FFF</code></td>
              <td>ROM (BASIC interpreter and OS)</td>
              <td>16 KB</td>
            </tr>
            <tr>
              <td><code>$4000-$57FF</code></td>
              <td>Screen display file (bitmap)</td>
              <td>6 KB</td>
            </tr>
            <tr>
              <td><code>$5800-$5AFF</code></td>
              <td>Screen attributes (colors)</td>
              <td>768 bytes</td>
            </tr>
            <tr>
              <td><code>$5B00-$5BFF</code></td>
              <td>Printer buffer</td>
              <td>256 bytes</td>
            </tr>
            <tr>
              <td><code>$5C00-$5CBF</code></td>
              <td>System variables</td>
              <td>192 bytes</td>
            </tr>
            <tr>
              <td><code>$5CC0-$5CCA</code></td>
              <td>Reserved</td>
              <td>11 bytes</td>
            </tr>
            <tr>
              <td><code>$5CCB-$FF57</code></td>
              <td>User programs and data</td>
              <td>~42 KB</td>
            </tr>
            <tr>
              <td><code>$FF58-$FFFF</code></td>
              <td>Reserved (system use)</td>
              <td>168 bytes</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="memory-map__note">
        <strong>128K Models:</strong> Additional RAM banks 0-7 can be paged into $C000-$FFFF.
        Screen can be switched between banks 5 and 7.
      </p>
    </section>

    <section class="system-tools__section">
      <h2>Important I/O Ports</h2>
      <div class="registers-table">
        <table>
          <thead>
            <tr>
              <th>Port</th>
              <th>Bits</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>$FE</code></td>
              <td><code>0-2</code></td>
              <td>Border color (0-7)</td>
            </tr>
            <tr>
              <td><code>$FE</code></td>
              <td><code>3</code></td>
              <td>MIC output (tape save)</td>
            </tr>
            <tr>
              <td><code>$FE</code></td>
              <td><code>4</code></td>
              <td>Speaker output (beeper)</td>
            </tr>
            <tr>
              <td><code>$FE</code> (read)</td>
              <td><code>0-4</code></td>
              <td>Keyboard input (row selected by high byte)</td>
            </tr>
            <tr>
              <td><code>$FE</code> (read)</td>
              <td><code>6</code></td>
              <td>EAR input (tape load)</td>
            </tr>
            <tr>
              <td><code>$7FFD</code></td>
              <td><code>0-2</code></td>
              <td>RAM bank select (128K)</td>
            </tr>
            <tr>
              <td><code>$7FFD</code></td>
              <td><code>3</code></td>
              <td>Screen select (128K)</td>
            </tr>
            <tr>
              <td><code>$7FFD</code></td>
              <td><code>4</code></td>
              <td>ROM select (128K)</td>
            </tr>
            <tr>
              <td><code>$7FFD</code></td>
              <td><code>5</code></td>
              <td>Paging disable (128K)</td>
            </tr>
            <tr>
              <td><code>$FFFD</code></td>
              <td>-</td>
              <td>AY-3-8912 register select (128K)</td>
            </tr>
            <tr>
              <td><code>$BFFD</code></td>
              <td>-</td>
              <td>AY-3-8912 data read/write (128K)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>Complete Development Workflow</h2>

      <div class="workflow-steps">
        <div class="workflow-step">
          <h3>1. Set Up Development Environment</h3>
          <pre class="code-example"><code># Create project directory
mkdir spectrum-game && cd spectrum-game

# Pull the development container
docker pull ghcr.io/code198x/zx-spectrum-tools:v2.0.0

# Start development environment
docker run -it -v $(pwd):/workspace ghcr.io/code198x/zx-spectrum-tools:v2.0.0 bash</code></pre>
        </div>

        <div class="workflow-step">
          <h3>2. Write Your Code</h3>
          <p>Create <code>main.asm</code> with your Z80 assembly:</p>
          <pre class="code-example"><code>; ZX Spectrum "Hello World" with colors
        ORG     32768           ; Program starts at 32768

start:
        ; Clear screen
        ld      a, 2            ; Channel 2 (screen)
        call    $1601           ; Open channel
        ld      a, 12           ; Clear screen control code
        rst     $10             ; Print it

        ; Set colors (bright cyan on blue)
        ld      a, 22           ; AT control
        rst     $10
        ld      a, 10           ; Row 10
        rst     $10
        ld      a, 11           ; Column 11
        rst     $10

        ld      a, 16           ; INK control
        rst     $10
        ld      a, 5            ; Cyan
        rst     $10

        ld      a, 17           ; PAPER control
        rst     $10
        ld      a, 1            ; Blue
        rst     $10

        ld      a, 19           ; BRIGHT control
        rst     $10
        ld      a, 1            ; Bright on
        rst     $10

        ; Print message
        ld      de, message
print:  ld      a, (de)
        or      a
        ret     z
        rst     $10
        inc     de
        jr      print

message:
        defb    "HELLO SPECTRUM!"
        defb    0

        END     start</code></pre>
        </div>

        <div class="workflow-step">
          <h3>3. Assemble to TAP File</h3>
          <pre class="code-example"><code># Using sjasmplus
sjasmplus --lst=main.lst --tap=main.tap main.asm

# Or using pasmo
pasmo --tap main.asm main.tap

# Check the generated files
ls -la *.tap</code></pre>
        </div>

        <div class="workflow-step">
          <h3>4. Test in Emulator</h3>
          <pre class="code-example"><code># Using Fuse emulator (if installed locally)
fuse main.tap

# Or transfer to real hardware via audio or DivMMC</code></pre>
        </div>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>Example Projects</h2>

      <div class="example-project">
        <h3>Rainbow Border Effect</h3>
        <p>Classic Spectrum demo effect using precise timing:</p>
        <pre class="code-example"><code>        ORG     32768

        ; Disable interrupts for precise timing
        di

        ; Main loop
loop:   ld      b, 255          ; Wait for vertical retrace
wait:   djnz    wait

        ; Cycle through border colors
        ld      c, 8            ; 8 colors
        ld      hl, colors
cycle:  ld      a, (hl)
        out     ($FE), a        ; Set border color

        ; Delay for visible stripe
        ld      b, 20
delay:  djnz    delay

        inc     hl
        dec     c
        jr      nz, cycle

        jr      loop            ; Repeat forever

colors: defb    0, 1, 2, 3, 4, 5, 6, 7

        END     32768</code></pre>
      </div>

      <div class="example-project">
        <h3>Sprite Routine (Character Graphics)</h3>
        <p>Display an 8x8 sprite using the Spectrum's unique display layout:</p>
        <pre class="code-example"><code>        ORG     32768

        ; Draw 8x8 sprite at position (X=10, Y=10)
        ld      de, $4000       ; Screen start
        ld      a, 10           ; Y position
        call    calcscreen      ; Calculate screen address
        ld      b, 0
        ld      c, 10           ; X position (bytes)
        add     hl, bc          ; Add X offset

        ; Draw sprite
        ld      de, sprite_data
        ld      b, 8            ; 8 lines
draw:   ld      a, (de)
        ld      (hl), a         ; Write to screen
        inc     de
        inc     h               ; Next screen line
        djnz    draw
        ret

        ; Calculate screen address from Y coordinate
calcscreen:
        ld      l, a
        ld      h, 0
        add     hl, hl          ; *2
        add     hl, hl          ; *4
        add     hl, hl          ; *8
        add     hl, hl          ; *16
        add     hl, hl          ; *32
        ld      de, $4000
        add     hl, de
        ret

sprite_data:
        defb    %00111100
        defb    %01111110
        defb    %11011011
        defb    %11111111
        defb    %11111111
        defb    %10111101
        defb    %01000010
        defb    %00111100

        END     32768</code></pre>
      </div>

      <div class="example-project">
        <h3>AY Chip Music (128K)</h3>
        <p>Play a simple tune using the AY-3-8912 sound chip:</p>
        <pre class="code-example"><code>        ORG     49152           ; Above BASIC for 128K

        ; Initialize AY chip
        ld      bc, $FFFD       ; AY register port
        ld      de, $BFFD       ; AY data port

        ; Set up channel A
        ld      a, 0            ; Register 0 - Channel A fine tune
        out     (c), a
        ld      a, 200          ; Frequency value
        out     (e), a

        ld      a, 1            ; Register 1 - Channel A coarse tune
        out     (c), a
        ld      a, 1
        out     (e), a

        ; Set volume
        ld      a, 8            ; Register 8 - Channel A volume
        out     (c), a
        ld      a, 15           ; Maximum volume
        out     (e), a

        ; Enable channel
        ld      a, 7            ; Register 7 - Mixer control
        out     (c), a
        ld      a, %11111110    ; Enable tone on channel A
        out     (e), a

        ; Play for a while
        ld      bc, 65535
delay:  dec     bc
        ld      a, b
        or      c
        jr      nz, delay

        ; Silence
        ld      a, 8
        out     ($FFFD), a
        ld      a, 0
        out     ($BFFD), a
        ret

        END     49152</code></pre>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>Screen Layout & Attributes</h2>
      <p>
        The ZX Spectrum's screen memory has a unique non-linear layout that can be
        confusing at first. Understanding it is key to efficient graphics programming.
      </p>

      <div class="info-box">
        <h3>Display File Structure</h3>
        <ul>
          <li><strong>Bitmap:</strong> 256×192 pixels = 6144 bytes ($4000-$57FF)</li>
          <li><strong>Attributes:</strong> 32×24 cells = 768 bytes ($5800-$5AFF)</li>
          <li>Each byte in bitmap represents 8 horizontal pixels</li>
          <li>Screen is divided into three thirds, each with 8 character rows</li>
        </ul>
      </div>

      <div class="info-box">
        <h3>Attribute Format (1 byte per 8×8 cell)</h3>
        <pre class="code-example"><code>Bit:  7   6   5   4   3   2   1   0
      F   B   P2  P2  P1  I2  I1  I0

F  = Flash (0=off, 1=on)
B  = Bright (0=normal, 1=bright)
P  = Paper color (background) 0-7
I  = Ink color (foreground) 0-7

Colors: 0=Black, 1=Blue, 2=Red, 3=Magenta,
        4=Green, 5=Cyan, 6=Yellow, 7=White</code></pre>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>Advanced Techniques</h2>

      <div class="technique-card">
        <h3>Multicolor Graphics</h3>
        <p>
          Overcome attribute clash using careful design and timing tricks.
          Techniques include using sprites that align to character boundaries,
          choosing colors that work well together, and using the border for
          additional visual elements.
        </p>
      </div>

      <div class="technique-card">
        <h3>Floating Bus Trick</h3>
        <p>
          Read from unconnected ports to detect the exact beam position,
          enabling precise raster effects without counting cycles.
          Essential for advanced demo effects.
        </p>
      </div>

      <div class="technique-card">
        <h3>Contended Memory</h3>
        <p>
          The ULA steals cycles when accessing screen memory ($4000-$7FFF).
          Place time-critical code in uncontended memory ($8000+) for
          consistent timing.
        </p>
      </div>

      <div class="technique-card">
        <h3>Stack Abuse</h3>
        <p>
          Use the stack pointer for fast memory copying. Set SP to source
          data and use POP instructions to read 2 bytes per instruction.
          Essential for full-screen effects.
        </p>
      </div>
    </section>

    <section class="system-tools__section">
      <h2>TAP File Format</h2>
      <p>
        TAP files are the standard format for Spectrum software distribution.
        Understanding the format helps with creating custom loaders.
      </p>
      <pre class="code-example"><code>TAP File Structure:
+--------+--------+------------------------+
| Length | Flag   | Data Block             |
| 2 bytes| 1 byte | Length-2 bytes         |
+--------+--------+------------------------+

Flag values:
$00 = Header block
$FF = Data block

Header block format (17 bytes):
Type | Filename | Length | Param1 | Param2
1    | 10       | 2      | 2      | 2

Type: 0=Program, 1=Number array, 2=Character array, 3=Code

For Code blocks:
Param1 = Start address
Param2 = 32768 (unused)</code></pre>
    </section>

    <section class="system-tools__section">
      <h2>Resources & References</h2>

      <div class="resources-grid">
        <div class="resource-card">
          <h3>Documentation</h3>
          <ul>
            <li><a href="https://worldofspectrum.org/">World of Spectrum</a> - The definitive archive</li>
            <li><a href="https://skoolkid.github.io/rom/">Spectrum ROM Disassembly</a> - Complete ROM documentation</li>
            <li><a href="http://z80.info/">Z80 Info</a> - CPU documentation and resources</li>
            <li><a href="https://spectrumcomputing.co.uk/">Spectrum Computing</a> - Games, utilities, and documentation</li>
          </ul>
        </div>

        <div class="resource-card">
          <h3>Development Tools</h3>
          <ul>
            <li><a href="https://github.com/z00m128/sjasmplus">sjasmplus</a> - Modern Z80 assembler</li>
            <li><a href="https://github.com/z88dk/z88dk">z88dk</a> - C compiler and libraries</li>
            <li><a href="http://pasmo.speccy.org/">pasmo</a> - Simple Z80 assembler</li>
            <li><a href="https://damieng.com/typography/zx-origins/">ZX Origins</a> - Spectrum fonts</li>
          </ul>
        </div>

        <div class="resource-card">
          <h3>Emulators</h3>
          <ul>
            <li><a href="http://fuse-emulator.sourceforge.net/">Fuse</a> - Accurate Unix Spectrum emulator</li>
            <li><a href="https://www.spectaculator.com/">Spectaculator</a> - Windows/Mac emulator</li>
            <li><a href="https://github.com/chernandezba/zesarux">ZEsarUX</a> - Multi-platform emulator</li>
            <li><a href="https://jsspeccy.zxdemo.org/">JSSpeccy</a> - Browser-based emulator</li>
          </ul>
        </div>

        <div class="resource-card">
          <h3>Community</h3>
          <ul>
            <li><a href="https://spectrumcomputing.co.uk/forums/">Spectrum Computing Forums</a></li>
            <li><a href="https://www.worldofspectrum.org/forums/">WoS Forums</a></li>
            <li><a href="https://discord.gg/speccy">Speccy Discord</a></li>
            <li><a href="https://zxart.ee/">ZX Art</a> - Graphics and music</li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .system-tools {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .system-tools__hero {
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    color: white;
    padding: 3rem;
    border-radius: 12px;
    margin-bottom: 3rem;
  }

  .system-tools__breadcrumb {
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .system-tools__breadcrumb a {
    color: white;
    text-decoration: none;
  }

  .system-tools__title {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .system-tools__icon {
    font-size: 4rem;
  }

  .system-tools__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .system-tools__spec {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }

  .system-tools__section {
    margin-bottom: 3rem;
  }

  .system-tools__section h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }

  .toolchain-detail {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .toolchain-detail h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .code-example {
    background: var(--color-code-bg);
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .code-example code {
    color: var(--color-code-text);
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .memory-map__table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .memory-map__table th,
  .memory-map__table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .memory-map__table th {
    background: var(--color-primary);
    color: white;
  }

  .memory-map__table code {
    background: var(--color-inline-code-bg);
    padding: 0.125rem 0.25rem;
    border-radius: 3px;
  }

  .registers-table table {
    width: 100%;
    border-collapse: collapse;
  }

  .registers-table th,
  .registers-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .registers-table th {
    background: var(--color-primary);
    color: white;
  }

  .workflow-step {
    background: var(--color-surface);
    padding: 1.5rem;
    border-left: 4px solid var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .workflow-step h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .example-project {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .example-project h3 {
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .info-box {
    background: var(--color-info-bg);
    border: 1px solid var(--color-info-border);
    padding: 1.5rem;
    border-radius: 6px;
    margin: 1.5rem 0;
  }

  .info-box h3 {
    color: var(--color-info-text);
    margin-bottom: 1rem;
  }

  .technique-card {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .technique-card h3 {
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .resource-card {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: 8px;
  }

  .resource-card h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .resource-card ul {
    list-style: none;
    padding: 0;
  }

  .resource-card li {
    margin-bottom: 0.5rem;
  }

  .resource-card a {
    color: var(--color-link);
    text-decoration: none;
  }

  .resource-card a:hover {
    text-decoration: underline;
  }
</style>