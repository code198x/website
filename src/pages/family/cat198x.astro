---
import Layout from '../../layouts/Layout.astro';
import { Database, ArrowRight, ArrowLeft } from '@lucide/astro';
import GithubIcon from '@components/GithubIcon.astro';

// Illustrative commands, verified against the cat198x subcommand set (2026-06-03).
const snippets = [
  {
    label: 'Scan your ROM directories (identified by content hash)',
    code: 'cat198x scan',
  },
  {
    label: 'See what you have, what’s missing or misnamed',
    code: 'cat198x status "Nintendo - Game Boy" --detailed',
  },
  {
    label: 'Plan a tidy-up, preview it, then apply (rollback-able)',
    code: 'cat198x plan\ncat198x apply --dry-run   # show exactly what would change\ncat198x apply             # do it (cat198x apply --rollback to undo)',
  },
];
---

<Layout
  title="Cat198x — the 198x family"
  description="Cat198x catalogues, verifies, and reorganises a retro ROM collection safely — content-hash inventory against reference DATs, with a reviewable plan and rollback. Part of the 198x family."
>
  <div class="explainer">
    <section class="hero">
      <a class="back" href="/family"><ArrowLeft size={15} /> The 198x family</a>
      <div class="hero-badge">// 198x FAMILY · CAT198X</div>
      <h1>Cat198x</h1>
      <p class="hero-subtitle">Catalogue, verify &amp; reorganise a retro collection</p>
    </section>

    <div class="prose">
      <p class="lead">
        Cat198x is the family's <a href="/family">asset-cataloguing tool</a>. It scans your
        ROM directories, matches every file by content hash against reference
        <strong>DAT</strong> databases (No-Intro, Redump, MAME, FinalBurn Neo), and tells you
        exactly what you have, what's missing, and what's misnamed or duplicated — then, when
        you want to tidy up, it generates a <strong>plan you can inspect</strong> before
        anything moves.
      </p>

      <h2>Why it exists</h2>
      <p>
        Retro collections drift: files get renamed, re-compressed, half-downloaded, and
        duplicated across drives, while the reference DATs that define a "correct" set keep
        getting updated. Verifying a large collection by hand is tedious and error-prone, and
        most tools either mutate files in place without a safety net or assume one rigid
        layout. Cat198x separates <strong>knowing</strong> from <strong>changing</strong>:
        nothing touches disk until you say so, every apply is transactional with a rollback
        log, and nothing is ever silently lost. Think of it as Terraform for ROMs.
      </p>

      <h2>How it's used</h2>
      <p>
        A single self-contained binary. The loop is scan → review → plan → apply. A few
        illustrative commands (the full command set is on GitHub):
      </p>

      {snippets.map((s) => (
        <div class="snippet">
          <p class="snippet-label">{s.label}</p>
          <pre tabindex="0"><code>{s.code}</code></pre>
        </div>
      ))}

      <h2>Why it's in the family</h2>
      <p>
        The curriculum asks you to bring your own ROMs — the C64 and Amiga lessons need their
        original Cloanto system ROMs, for instance — and Cat198x is what keeps that collection
        verified and organised. The same verified assets are what Emu198x boots. It's its own
        project with its own roadmap, not a Code198x component.
      </p>
    </div>

    <div class="cta">
      <span class="status"><Database size={16} /> Active</span>
      <a class="cta-link" href="https://github.com/cat198x" target="_blank" rel="noopener">
        <GithubIcon size={16} /> View on GitHub <ArrowRight size={15} />
      </a>
      <p class="cta-note">Full command reference and the safety model live on GitHub.</p>
    </div>
  </div>
</Layout>

<style>
  .explainer {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }

  /* Hero */
  .hero {
    padding: var(--space-10) 0 var(--space-8);
    text-align: center;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }

  .back:hover {
    text-decoration: underline;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-house-2);
    letter-spacing: 0.2em;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-house-2);
    background: var(--color-surface);
  }

  .hero h1 {
    font-family: var(--font-family-read);
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 0.9;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    color: var(--color-text-secondary);
    margin: 0;
    font-family: var(--font-family-mono);
    letter-spacing: 0.08em;
  }

  /* Prose */
  .prose .lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
  }

  .prose h2 {
    font-size: 1.4rem;
    color: var(--color-text);
    margin: var(--space-8) 0 var(--space-3) 0;
  }

  .prose p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-4) 0;
  }

  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose code {
    font-family: var(--font-family-mono);
    font-size: 0.88em;
    background: color-mix(in oklab, var(--color-text) 8%, transparent);
    padding: 0.1em 0.3em;
    border-radius: 0.2em;
  }

  /* Snippets */
  .snippet {
    margin: 0 0 var(--space-4) 0;
  }

  .snippet-label {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2) 0;
  }

  .snippet pre {
    margin: 0;
    padding: var(--space-4);
    background: var(--color-code-bg);
    color: var(--color-code-text);
    border-radius: 0.25rem;
    overflow-x: auto;
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .snippet pre:focus-visible {
    outline: 2px solid var(--color-house-2);
    outline-offset: 2px;
  }

  /* CTA */
  .cta {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #166534;
    border: 1px solid currentColor;
    padding: 0.2rem 0.6rem;
    margin-bottom: var(--space-4);
  }

  :global(:root[data-theme="dark"]) .status {
    color: #4ade80;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .status {
      color: #4ade80;
    }
  }

  .cta-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    transition: gap var(--transition-base);
  }

  .cta-link:hover {
    gap: var(--space-3);
  }

  .cta-note {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin: var(--space-3) 0 0 0;
  }
</style>
