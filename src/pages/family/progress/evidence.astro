---
import Layout from '../../../layouts/Layout.astro';
import PageFrame from '../../../components/PageFrame.astro';
import snapshot from '../../../data/project-progress.json';
import { validateProgressSnapshot } from '../../../lib/project-progress.mjs';
import '../../../styles/project-progress.css';
const progress = validateProgressSnapshot(snapshot);
---
<Layout title="Progress evidence — the 198x family" description="Inspect the configurations, versions, source freshness and measurements behind the project overview.">
  <PageFrame as="article" class="project-progress">
    <header class="progress-opening">
      <a href="/family/progress">Back to project progress</a>
      <h1>The supporting evidence.</h1>
      <p class="lead">Inspect the checks behind the project overview.</p>
      <p>Five selected programming patterns have retained execution records. <strong>{progress.verified_count} have passing checks whose declared inputs matched at the snapshot date.</strong> This is a small part of the family’s capabilities.</p>
      <p class="progress-note">Snapshot checked <time datetime={progress.checked_on}>{progress.checked_on}</time>. Each result keeps its original run date and tested versions. These are retained observations, not fresh tests run by this website.</p>
      <nav aria-label="Evidence results">{progress.capabilities.map(c => <a href={`#${c.id}`}>{c.title}</a>)}</nav>
    </header>
    <p>Independent assembly, independent execution and original-hardware observation are separate claims. A source or requested-tool change requires revalidation; a failed required check remains failed.</p>
    {progress.capabilities.map(c => (
      <section class="progress-project progress-result" id={c.id} aria-labelledby={`${c.id}-heading`}>
        <div class="progress-result-heading"><h2 id={`${c.id}-heading`}>{c.title}</h2><span>{c.state_label}</span></div>
        <p class="progress-purpose">{c.configuration}</p>
        {c.issues.map(issue => <p class="progress-alert">{issue}</p>)}
        <p>{c.checks}</p>
        <ul class="progress-metrics">{Object.entries(c.metrics).map(([name, value]) => <li><strong>{Number(value).toLocaleString('en-GB')}</strong> {name}</li>)}</ul>
        <p><strong>Validation method.</strong> {c.reference}</p>
        <p><strong>Still outside this result.</strong> {c.remaining}</p>
        <p><a href={c.run_url}>Inspect the hosted run</a> · <a href={c.recipe_url}>Source and reproduction instructions</a></p>
        <p class="progress-note">Recorded <time datetime={c.recorded_at}>{c.recorded_at}</time> · {c.host}</p>
        <details><summary>Versions, hashes and source freshness</summary>
          <table><caption>Direct tools identified in this run</caption><thead><tr><th scope="col">Tool</th><th scope="col">Version</th><th scope="col">Fingerprints</th></tr></thead><tbody>{c.tools.map(t => <tr><th scope="row">{t.name}</th><td>{t.version}</td><td>{t.binary_sha256 ? <><span>Executable SHA-256</span><code>{t.binary_sha256}</code></> : 'Executable identity not recorded'}{t.archive_sha256 && <><span>Archive SHA-256</span><code>{t.archive_sha256}</code></>}</td></tr>)}</tbody></table>
          {c.reference_tools.length > 0 && <table><caption>Independent reference tools; stage scope is described above</caption><thead><tr><th scope="col">Tool</th><th scope="col">Version</th><th scope="col">Executable SHA-256</th></tr></thead><tbody>{c.reference_tools.map(t => <tr><th scope="row">{t.name}</th><td>{t.version}</td><td><code>{t.binary_sha256}</code></td></tr>)}</tbody></table>}
          {c.reference_image && <p>Reference image <code>{c.reference_image}</code>.</p>}
          {c.python && <p>Observer Python version {c.python}.</p>}
          {c.firmware.length > 0 && <table><caption>Firmware identities; no firmware is included</caption><thead><tr><th scope="col">File</th><th scope="col">Bytes</th><th scope="col">SHA-256</th></tr></thead><tbody>{c.firmware.map(f => <tr><th scope="row">{f.name}</th><td>{f.bytes.toLocaleString('en-GB')}</td><td><code>{f.sha256}</code></td></tr>)}</tbody></table>}
          <p>Tested samples revision <code>{c.samples_revision}</code>.</p>
          <ul class="progress-sources">{c.sources.map(s => <li><a href={s.url}>Pinned source or observer</a> — {s.matches_current_source ? 'matched at snapshot' : 'changed or unavailable'}<code>{s.sha256}</code></li>)}</ul>
          <table><caption>Retained evidence fingerprints</caption><thead><tr><th scope="col">Record</th><th scope="col">SHA-256</th></tr></thead><tbody>{c.records.map(r => <tr><th scope="row">{r.kind}</th><td><code>{r.sha256}</code></td></tr>)}</tbody></table>
          <details><summary>Recorded measurements</summary><pre>{JSON.stringify(c.observations, null, 2)}</pre></details>
        </details>
      </section>
    ))}
    <section class="progress-section" aria-labelledby="remaining-heading"><h2 id="remaining-heading">Still to connect</h2><ul>{progress.remaining.map(item => <li>{item}</li>)}</ul><p>Direct tool qualification does not establish every transitive dependency or configuration.</p></section>
    <p><a href="/family/progress">Return to the project overview.</a> <a href="/family/progress/snapshot.json">Download the complete reviewed snapshot.</a></p>
  </PageFrame>
</Layout>
