---
import Layout from '../../layouts/Layout.astro';
import { Cpu, ArrowRight, ArrowLeft } from '@lucide/astro';
import GithubIcon from '@components/GithubIcon.astro';

// One illustrative command per usage mode. Verified against the Emu198x
// binaries' actual flags (2026-06-03); the full set lives on GitHub.
const snippets = [
  {
    label: 'Boot a machine in a window',
    code: 'cargo run --release -p emu198x-spectrum -- \\\n  --rom 48.rom --tape game.tzx --autoload-tape',
  },
  {
    label: 'Capture a screenshot headlessly (CI, docs)',
    code: 'cargo run --release -p emu198x-nes --no-default-features -- \\\n  --rom game.nes --frames 300 --screenshot nes.png',
  },
  {
    label: 'Drive it from an agent or script over MCP',
    code: 'cargo run --release -p emu198x-atari-800xl -- --mcp',
  },
];
---

<Layout
  title="Emu198x — the 198x family"
  description="Emu198x builds cycle-accurate emulators for vintage machines in Rust — modelling the real hardware rather than faking it. Part of the 198x family; the accuracy Code198x leans on."
>
  <div class="explainer">
    <section class="hero">
      <a class="back" href="/family"><ArrowLeft size={15} /> The 198x family</a>
      <div class="hero-badge">// 198x FAMILY · EMU198X</div>
      <h1>Emu198x</h1>
      <p class="hero-subtitle">Cycle-accurate emulators for vintage machines</p>
    </section>

    <div class="prose">
      <p class="lead">
        Emu198x is one of the sibling projects in the <a href="/family">198x family</a> —
        and the one Code198x leans on for accuracy. It builds emulators for vintage
        machines in Rust, modelling the real hardware directly — pin-level CPU
        interfaces, system timing, video, audio, DMA and peripherals — rather than
        faking the parts that are hard. If a hardware path isn't modelled accurately
        enough yet, the machine stays honestly incomplete rather than pretending.
      </p>

      <h2>What it runs</h2>
      <p>
        Six <strong>primary</strong> systems run as full desktop apps with real software
        and green CPU test oracles: the <strong>ZX Spectrum</strong> (11 variants),
        <strong>Commodore 64</strong>, <strong>NES</strong>,
        <strong>Commodore Amiga</strong> (OCS/ECS/AGA — Workbench 3.1 boots to a clean
        desktop), <strong>Game Boy</strong>, and <strong>Dragon 32</strong>.
        Another <strong>22</strong> machines — Atari, Acorn, MSX, Sega, Oric, ZX80/81,
        Sord M5 and more — run headlessly today while their native windows are built out.
      </p>

      <h2>How it's used</h2>
      <p>
        Each system is a small binary. The same machine can open in a native window,
        run headlessly for a screenshot, or be driven programmatically — including over
        an MCP server, so an agent can boot it and inspect any chip. A few illustrative
        commands (the full flag set and every system are on GitHub):
      </p>

      {snippets.map((s) => (
        <div class="snippet">
          <p class="snippet-label">{s.label}</p>
          <pre tabindex="0"><code>{s.code}</code></pre>
        </div>
      ))}

      <h2>Why it's in the family</h2>
      <p>
        Accuracy is the point. When a Code198x Pattern Library routine claims "this works
        on real hardware", that claim has to survive a cycle-accurate emulator — which is
        exactly what Emu198x is built to be. It's its own project with its own roadmap,
        used by Code198x among others — not a Code198x component.
      </p>
    </div>

    <div class="cta">
      <span class="status"><Cpu size={16} /> Active</span>
      <a class="cta-link" href="https://github.com/emu198x" target="_blank" rel="noopener">
        <GithubIcon size={16} /> View on GitHub <ArrowRight size={15} />
      </a>
      <p class="cta-note">Full docs, install, and every system it boots, live on GitHub.</p>
    </div>
  </div>
</Layout>

<style>
  .explainer {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }

  /* Hero */
  .hero {
    padding: var(--space-10) 0 var(--space-8);
    text-align: center;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }

  .back:hover {
    text-decoration: underline;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-house-2);
    letter-spacing: 0.2em;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-house-2);
    background: var(--color-surface);
  }

  .hero h1 {
    font-family: var(--font-family-read);
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 0.9;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    color: var(--color-text-secondary);
    margin: 0;
    font-family: var(--font-family-mono);
    letter-spacing: 0.08em;
  }

  /* Prose */
  .prose .lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
  }

  .prose h2 {
    font-size: 1.4rem;
    color: var(--color-text);
    margin: var(--space-8) 0 var(--space-3) 0;
  }

  .prose p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-4) 0;
  }

  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* Snippets */
  .snippet {
    margin: 0 0 var(--space-4) 0;
  }

  .snippet-label {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2) 0;
  }

  .snippet pre {
    margin: 0;
    padding: var(--space-4);
    background: var(--color-code-bg);
    color: var(--color-code-text);
    border-radius: 0.25rem;
    overflow-x: auto;
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .snippet pre:focus-visible {
    outline: 2px solid var(--color-house-2);
    outline-offset: 2px;
  }

  /* CTA */
  .cta {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #166534;
    border: 1px solid currentColor;
    padding: 0.2rem 0.6rem;
    margin-bottom: var(--space-4);
  }

  :global(:root[data-theme="dark"]) .status {
    color: #4ade80;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .status {
      color: #4ade80;
    }
  }

  .cta-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    transition: gap var(--transition-base);
  }

  .cta-link:hover {
    gap: var(--space-3);
  }

  .cta-note {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin: var(--space-3) 0 0 0;
  }
</style>
