---
import FamilyOpening from '../../components/FamilyOpening.astro';
import PageFrame from '../../components/PageFrame.astro';
import Layout from '../../layouts/Layout.astro';
import { Package, ArrowRight, ArrowLeft } from '@lucide/astro';
import GithubIcon from '@components/GithubIcon.astro';

const examples = [
  {
    label: 'Frame one assembled Spectrum program',
    owner: 'Asm198x',
    detail: 'A single CODE block, with only the reference-compatible loader stub when the assembler owns that framing.',
  },
  {
    label: 'Master a release tape',
    owner: 'Build198x',
    detail: 'A BASIC loader, loading screen, one or more CODE blocks, and the ordering needed to make a distributable tape image.',
  },
  {
    label: 'Build a disk image',
    owner: 'Build198x',
    detail: 'Compiled program, converted assets, directory layout, boot files, and the final machine-readable disk image.',
  },
];
---

<Layout
  title="Build198x — the 198x family"
  description="Build198x owns the build pipeline beyond assembly: asset conversion, packing, and media mastering for Code Like It's 198x projects."
>
  <FamilyOpening title="Build198x" />
  <PageFrame class="explainer" opening="none">
    <section class="hero">
      <a class="back" href="/family"><ArrowLeft size={15} /> The 198x family</a>
      <p class="hero-subtitle">Build tools &amp; media mastering for vintage releases</p>
    </section>

    <div class="prose">
      <p class="lead">
        Build198x is the family's build pipeline after the assembler has done its job. It
        converts art and audio into native formats, packs data, and masters the tape and disk
        images that a real machine or emulator can boot.
      </p>

      <h2>The simple split</h2>
      <p>
        Asm198x emits programs. Build198x composes releases. If the output is one assembled
        program in a reference assembler's normal container, that is assembler framing. Once a
        second artefact joins it - a loading screen, an authored BASIC loader, another CODE
        block, a disk directory - it becomes mastering.
      </p>

      <div class="examples">
        {examples.map((example) => (
          <article>
            <p class="owner">{example.owner}</p>
            <h2>{example.label}</h2>
            <p>{example.detail}</p>
          </article>
        ))}
      </div>

      <h2>Why Code198x needs it</h2>
      <p>
        Lessons should end in artefacts that feel like the period: a Spectrum tape with a loader
        and screen, a C64 program with converted assets, an Amiga disk image that boots. Build198x
        keeps that work out of lesson prose and out of the assembler, so the course can teach the
        machine while the build tool does the packaging.
      </p>

      <h2>Where it sits</h2>
      <p>
        Code198x provides the curriculum and source projects. Asm198x assembles code. Emu198x runs
        and captures it. Build198x turns the built pieces into the media image you would actually
        load.
      </p>
    </div>

    <div class="cta">
      <span class="status"><Package size={16} /> Active</span>
      <a class="cta-link" href="https://github.com/build198x" target="_blank" rel="noopener">
        <GithubIcon size={16} /> View on GitHub <ArrowRight size={15} />
      </a>
      <p class="cta-note">Full docs and the current tool roadmap live on GitHub.</p>
    </div>
  </PageFrame>
</Layout>

<style>@layer blocks {  .hero { padding: var(--space-10) 0 var(--h-space-8); text-align: center; }
  .back { display: inline-flex; align-items: center; gap: var(--h-space-1); font-family: var(--h-font-ui); font-size: 0.8125rem; color: var(--ink); text-decoration: none; margin-bottom: var(--h-space-6); font-weight: 600; }
  .back:hover { text-decoration: underline; }
  .hero h1 { font-family: var(--h-font-ui); font-size: clamp(2.8rem, 7vw, 4.5rem); font-weight: 700; line-height: 0.9;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: 0 0 var(--h-space-4) 0; color: var(--h-ink); }
  .hero-subtitle { font-size: clamp(1.05rem, 2.4vw, 1.3rem); color: var(--h-ink-muted); margin: 0; font-family: var(--h-font-ui); letter-spacing: normal; font-weight: 400;}
  .prose h2 { font-size: 1.4rem; color: var(--h-ink); margin: var(--h-space-8) 0 var(--h-space-3) 0; }
  .prose p { color: var(--h-ink-muted); line-height: 1.7; margin: 0 0 var(--h-space-4) 0; }
  .examples { display: grid; gap: var(--h-space-4); margin: var(--h-space-6) 0; }
  .examples article { border: 3px solid var(--h-line); border-left-color: var(--h-spot-ink); border-left-width: 1px; background: var(--h-ground); padding: var(--space-5); }
  .examples h2 { font-size: 1.15rem; margin: 0 0 var(--h-space-2); }
  .examples p:last-child { margin: 0; }
  .cta { margin-top: var(--space-10); padding-top: var(--h-space-8); border-top: 1px solid var(--h-line); text-align: center; }
  .status { display: inline-flex; align-items: center; gap: var(--h-space-2); font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; text-transform: none; letter-spacing: normal; color: #166534; border: 1px solid currentColor; padding: 0.2rem 0.6rem; margin-bottom: var(--h-space-4); }
  .cta-link { display: flex; align-items: center; justify-content: center; gap: var(--h-space-2); font-family: var(--h-font-ui); font-size: 0.95rem; font-weight: 600; color: var(--ink); text-decoration: none; transition: gap var(--transition-base); }
  .cta-link:hover { gap: var(--h-space-3); }
  .cta-note { color: var(--h-ink-muted); font-size: 0.85rem; margin: var(--h-space-3) 0 0 0; }
}
/* Still in legacy: each rule here beats a rule in another legacy stylesheet
   by weight, so it moves to blocks when that one does. */
@layer legacy {
  .prose .lead { font-size: 1.15rem; line-height: 1.7; color: var(--h-ink); margin: 0 0 var(--h-space-6) 0; }
  .examples .owner { font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--h-spot-ink); margin: 0 0 var(--h-space-1); }
  }
</style>

<style>@layer blocks {
:global(main#main-content[data-site-frame]:has(> .family-opening)) { max-width: none; }
}
</style>

<style>@layer blocks {
.explainer { overflow-wrap: anywhere; }
}
</style>
