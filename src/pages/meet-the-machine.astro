---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getSection } from '../lib/sections';

const section = getSection('meet-the-machine');

const briefings = (await getCollection('module-pages'))
  .filter((e) => e.id.startsWith('meet-the-machine/'))
  .map((e) => ({
    slug: e.id.replace(/\/index$/, '').replace(/^meet-the-machine\//, ''),
    title: e.data.title,
    description: e.data.description ?? '',
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

const accent = section?.color ?? '#5b7a8c';
---

<Layout
  title="Meet the Machine | Code Like It's 198x"
  description="What each machine is, and the constraints it imposes. A short briefing per computer — its screen, its sound, its memory — the part that's the machine's own, not the processor's."
  platformColor={accent}
>
  <div class="wrap">
    <header class="mhead">
      <p class="eyebrow">Meet the Machine</p>
      <h1>Every machine has its own character.</h1>
      <div class="rule"></div>
      <p class="lede">The processor you learn in <a href="/meet-assembly">Meet Assembly</a> is
        the same across every computer built on it. What changes from one to the next is the
        machine itself — its screen, its sound, the shape of its memory, its quirks. Each
        briefing here covers just that: the part that's the machine's own. For the instruction
        set, it points you back to the shared course for its CPU.</p>
    </header>

    <ol class="grid">
      {briefings.map((b) => (
        <li>
          <a class="card" href={`/meet-the-machine/${b.slug}`}>
            <h2>{b.title}</h2>
            <p class="desc">{b.description}</p>
            <span class="go">Read the briefing →</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style define:vars={{ accent }}>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .mhead { margin-bottom: var(--space-10); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .mhead h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.04; margin: var(--space-2) 0 0; color: var(--color-text); max-width: 18ch; }
  .rule { height: 6px; width: 160px; max-width: 70%; background: var(--accent); margin: var(--space-3) 0 0; }
  .lede { font-size: 1.05rem; max-width: 70ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .lede a { color: var(--accent); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-5); }
  .card { display: block; height: 100%; padding: var(--space-5); background: var(--color-surface); border: 2px solid var(--color-border); border-left: 6px solid var(--accent); text-decoration: none; transition: border-color var(--transition-base), transform var(--transition-base); }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .card h2 { font-size: 1.4rem; margin: 0 0 var(--space-2); color: var(--color-text); }
  .desc { font-size: 0.95rem; color: var(--color-text-secondary); margin: 0 0 var(--space-4); }
  .go { font-family: var(--font-family-mono); font-size: 0.8rem; font-weight: 600; color: var(--accent); }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
