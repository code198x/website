---
import Layout from '../../../layouts/Layout.astro';

// Define the 16 lessons - you can update these titles/descriptions as needed
const lessons = [
  {
    number: 1,
    title: "Setting Up Your Development Environment",
    description: "Install the assembler, emulator, and create your first C64 program",
    status: "available"
  },
  {
    number: 2,
    title: "Understanding the C64 Memory Map",
    description: "Learn where screen memory, color RAM, and the character set live",
    status: "available"
  },
  {
    number: 3,
    title: "Drawing Characters on Screen",
    description: "Place your first character on the C64 screen",
    status: "available"
  },
  {
    number: 4,
    title: "Creating the Basket",
    description: "Design and display the player's basket using custom characters",
    status: "available"
  },
  {
    number: 5,
    title: "Reading the Joystick",
    description: "Read joystick input to control the basket",
    status: "available"
  },
  {
    number: 6,
    title: "Moving the Basket",
    description: "Make the basket move smoothly left and right",
    status: "available"
  },
  {
    number: 7,
    title: "Adding Falling Objects",
    description: "Create characters that fall from the top of the screen",
    status: "available"
  },
  {
    number: 8,
    title: "Animating the Fall",
    description: "Make objects fall smoothly using timing loops",
    status: "available"
  },
  {
    number: 9,
    title: "Collision Detection",
    description: "Detect when the basket catches or misses objects",
    status: "available"
  },
  {
    number: 10,
    title: "Keeping Score",
    description: "Display and update the player's score on screen",
    status: "available"
  },
  {
    number: 11,
    title: "Adding Sound Effects",
    description: "Program the SID chip for catch and miss sounds",
    status: "available"
  },
  {
    number: 12,
    title: "Multiple Falling Objects",
    description: "Manage multiple objects falling simultaneously",
    status: "available"
  },
  {
    number: 13,
    title: "Increasing Difficulty",
    description: "Speed up falling objects as the game progresses",
    status: "available"
  },
  {
    number: 14,
    title: "Lives and Game Over",
    description: "Implement lives system and game over state",
    status: "available"
  },
  {
    number: 15,
    title: "Title Screen",
    description: "Create an attractive title screen with the game name",
    status: "available"
  },
  {
    number: 16,
    title: "Polish and High Score",
    description: "Add colors, borders, and track the highest score",
    status: "available"
  }
];
---

<Layout title="Skyfall - Build a C64 Game in Assembly">
  <style>
    .game-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .game-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.3);
    }

    .game-subtitle {
      font-size: 1.5rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .game-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .game-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .lesson-status.coming-soon {
      background: rgba(0, 0, 0, 0.05);
      color: var(--color-text-secondary);
    }

    .game-preview {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
      text-align: center;
    }

    .preview-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--space-4);
      margin-top: var(--space-6);
    }

    .preview-item {
      padding: var(--space-4);
      background: var(--color-bg);
      border-radius: 0.5rem;
    }

    .preview-item h4 {
      color: #4a4dff;
      margin-bottom: var(--space-2);
    }

    .preview-item p {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    .character-demo {
      background: #000;
      color: #4a4dff;
      font-family: var(--font-family-mono);
      padding: var(--space-4);
      border-radius: 0.5rem;
      margin: var(--space-6) auto;
      max-width: 400px;
      text-align: center;
      font-size: 1.5rem;
      line-height: 1.2;
      letter-spacing: 0.2em;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      margin-top: var(--space-8);
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Game Hero -->
  <section class="game-hero">
    <h1 class="game-title">SKYFALL</h1>
    <p class="game-subtitle">Build a Complete C64 Game in Assembly</p>

    <p class="game-description">
      Over 16 lessons, you'll build Skyfall - a complete character-based catcher game for the Commodore 64.
      Objects fall from the sky and you must catch them with your basket. Miss too many and it's game over!
      Using only character graphics (no sprites!), you'll learn the fundamentals of C64 game development,
      including screen memory, custom characters, collision detection, and the SID chip.
    </p>

    <div class="game-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">6502</div>
        <div class="stat-label">Assembly</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Complete Game</div>
      </div>
    </div>
  </section>

  <!-- What You'll Build -->
  <div class="content-container">
    <section class="game-preview">
      <h2 class="preview-title">What You'll Build</h2>

      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">
        A complete game using only character graphics - no sprites needed!
      </p>

      <div class="character-demo">
        ···*···<br/>
        ··***··<br/>
        ·*****·<br/>
        ···O···<br/>
        ··\_/··
      </div>

      <div class="preview-grid">
        <div class="preview-item">
          <h4>Character Graphics</h4>
          <p>Custom character design and screen memory manipulation</p>
        </div>
        <div class="preview-item">
          <h4>Input</h4>
          <p>Joystick control for smooth player movement</p>
        </div>
        <div class="preview-item">
          <h4>Game Physics</h4>
          <p>Gravity simulation and collision detection</p>
        </div>
        <div class="preview-item">
          <h4>Sound</h4>
          <p>SID chip programming for music and effects</p>
        </div>
        <div class="preview-item">
          <h4>Game Logic</h4>
          <p>Scoring, lives, difficulty progression</p>
        </div>
        <div class="preview-item">
          <h4>Polish</h4>
          <p>Title screen, colors, borders, and high scores</p>
        </div>
      </div>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Course Outline</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/skyfall/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class={`lesson-status ${lesson.status === 'available' ? '' : 'coming-soon'}`}>
              {lesson.status === 'available' ? 'Start →' : 'Coming Soon'}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start Building?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">
        No prior assembly experience required. We'll start from the very beginning
        and build up your knowledge step by step.
      </p>
      <a href="/commodore-64/skyfall/lesson-01" class="start-button">
        Start Lesson 1
      </a>
    </section>
  </div>
</Layout>