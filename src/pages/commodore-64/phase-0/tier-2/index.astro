---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 17,
    title: "The Art of Movement",
    description: "Animate single- and multi-tile shapes with smooth loops",
    status: "available"
  },
  {
    number: 18,
    title: "Logic & Motion II",
    description: "Blend velocity, collisions, and hazards inside live mazes",
    status: "available"
  },
  {
    number: 19,
    title: "Text Tricks II",
    description: "Format HUDs and normalise input for richer interfaces",
    status: "available"
  },
  {
    number: 20,
    title: "Memory Games II",
    description: "Load multi-room data (maps, rules, dialogue) from DATA",
    status: "available"
  },
  {
    number: 21,
    title: "Smarter Decisions II",
    description: "Drive room-specific behaviour through rule tables",
    status: "available"
  },
  {
    number: 22,
    title: "Text Tricks III",
    description: "Build highlighted menus and scrolling dialogue panels",
    status: "available"
  },
  {
    number: 23,
    title: "Memory Games III",
    description: "Stream dialogue and music cues alongside map data",
    status: "available"
  },
  {
    number: 24,
    title: "Mini-Game: Terminal Tangle",
    description: "Run a multi-room chase with UI, rules, and dialogue",
    status: "available"
  },
  {
    number: 25,
    title: "Sprite Primer",
    description: "Define sprite shapes, colours, and pointers",
    status: "available"
  },
  {
    number: 26,
    title: "Sprite Motion",
    description: "Move sprites with velocity and clamping",
    status: "available"
  },
  {
    number: 27,
    title: "Sprite Animation",
    description: "Flip frames for walking cycles tied to movement",
    status: "available"
  },
  {
    number: 28,
    title: "Sprite Collision",
    description: "Use hardware collision registers to detect hits",
    status: "available"
  },
  {
    number: 29,
    title: "Score & Timer",
    description: "Zero-padded HUD with countdown pressure",
    status: "available"
  },
  {
    number: 30,
    title: "Random Events",
    description: "Spawn pickups and hazards with RND",
    status: "available"
  },
  {
    number: 31,
    title: "Enemy AI",
    description: "Position-based chasers with rule-driven speed",
    status: "available"
  },
  {
    number: 32,
    title: "Mini-Game: Circuit Run",
    description: "Multi-room chase with HUD, AI, and randomness",
    status: "available"
  }
];
---

<Layout title="Tier 2: Living Worlds & Sprites - Phase 0 - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 2: LIVING WORLDS & SPRITES</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Build interactive multi-room worlds and learn VIC-II sprite programming. These 16 lessons teach advanced text interfaces, data-driven design, and hardware sprites for character animation, collision detection, and game logic.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">2</div>
        <div class="stat-label">Complete Games</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 2 bridges text-based games and sprite-based action games. You'll learn:
      </p>

      <ul>
        <li><strong>Advanced text interfaces</strong> - HUD formatting, menus, scrolling dialogue</li>
        <li><strong>Multi-room systems</strong> - Data-driven maps, room rules, navigation</li>
        <li><strong>VIC-II sprites</strong> - Definition, positioning, animation, collision</li>
        <li><strong>Game HUDs</strong> - Score displays, timers, status indicators</li>
        <li><strong>AI patterns</strong> - Position-based enemies, chase logic</li>
        <li><strong>Random events</strong> - Spawning pickups and hazards dynamically</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 2 Goals:</strong> Build "Terminal Tangle" (multi-room text adventure) and "Circuit Run" (sprite-based chase game with HUD and AI). Master both text-based and sprite-based game development.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Tier 1 (lessons 1-16). You'll build on fundamentals, arrays, subroutines, and state machines.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-2/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Continue?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        You've mastered fundamentals. Now let's build living worlds with multi-room navigation
        and bring characters to life with VIC-II sprites!
      </p>
      <a href="/commodore-64/phase-0/tier-2/lesson-017" class="start-button">
        Start Lesson 17: The Art of Movement
      </a>
    </section>
  </div>
</Layout>
