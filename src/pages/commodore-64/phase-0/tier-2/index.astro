---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 17,
    title: "Your First Sprite",
    description: "Hardware-accelerated graphics—introducing MOBs (Movable Object Blocks), sprite pointers, VIC-II positioning registers, 9-bit coordinates, keyboard control.",
    status: "available"
  },
  {
    number: 18,
    title: "Arcade-Quality Control",
    description: "Replace keyboard input with joystick hardware—CIA chip reading, Port 2 input, bit-level decoding, fire button detection, instant response, diagonal movement.",
    status: "available"
  },
  {
    number: 19,
    title: "Hardware Collision",
    description: "The VIC-II chip detects sprite collisions automatically—discover collision registers, bit testing, collision clearing, and building collision-responsive games.",
    status: "available"
  },
  {
    number: 20,
    title: "Your First Weapon",
    description: "Implement bullet sprites with movement—spawn from player position, update each frame, manage multiple bullets with arrays, despawn off-screen, sprite resource allocation.",
    status: "available"
  },
  {
    number: 21,
    title: "Enemy Waves",
    description: "Create enemy sprites with AI patterns—wave-based spawning system, sprite-to-sprite collision for gameplay, multiple AI behaviours (straight, sine wave, tracking), scoring system, sprite allocation strategy.",
    status: "available"
  },
  {
    number: 22,
    title: "Complete Sprite Game 🔗",
    description: "Synthesis of Tier 2—assemble everything into a polished space shooter. Game states (title/play/game over), lives system, HUD updates, screen flashing, player respawn, defensive boundary checks.",
    status: "available"
  },
  {
    number: 23,
    title: "Three Voice Harmony",
    description: "Use all three SID voices simultaneously to create chords, learn musical harmony theory, chord progressions (I-IV-V), and polyphonic sound design for game music.",
    status: "available"
  },
  {
    number: 24,
    title: "Note Sequencer",
    description: "Create melodies with DATA-driven note sequences—learn time-based playback with TI jiffy clock, note tables, blocking vs non-blocking patterns, and build game-ready music systems.",
    status: "available"
  },
  {
    number: 25,
    title: "Background Music",
    description: "Integrate non-blocking music into games—learn state machine patterns, multi-system coordination, voice allocation strategy, and create professional audio whilst gameplay continues.",
    status: "available"
  },
  {
    number: 26,
    title: "Sound Effect Library",
    description: "Build a reusable library of sound effects—explosions, lasers, pickups—triggered by game events without interrupting background music.",
    status: "available"
  },
  {
    number: 27,
    title: "Music Studio 🔗",
    description: "Synthesis of Sound & Music arc—build a complete 3-voice composition tool that creates melodies, harmonies, and bass lines, then exports them as reusable DATA statements.",
    status: "available"
  },
  {
    number: 28,
    title: "Smooth Movement",
    description: "Velocity-based movement—separate position from velocity to create smooth, physics-ready sprite control with sub-pixel precision, 8-direction movement, and foundation for momentum.",
    status: "available"
  },
  {
    number: 29,
    title: "Momentum & Inertia",
    description: "Realistic physics—implement momentum where velocity persists when input stops, acceleration that builds gradually, and friction that creates natural deceleration. Ice skating to spaceship control.",
    status: "available"
  },
  {
    number: 30,
    title: "Rotation & Thrust",
    description: "Directional physics—sprite rotation using frame switching, thrust-based movement with trigonometry (SIN/COS), Asteroids-style ship control, velocity magnitude clamping, screen wrapping.",
    status: "available"
  },
  {
    number: 31,
    title: "Asteroids & Wrapping",
    description: "Build a complete asteroid field with multiple moving objects, screen wrapping, and collision-based destruction—learn to manage arrays of independent entities moving simultaneously across an infinite playfield.",
    status: "available"
  },
  {
    number: 32,
    title: "Asteroid Field 🔗",
    description: "Synthesis of Physics & Motion arc—build a complete physics-based arcade game with momentum-controlled ship, rotating sprites, collision detection, wave system, and discover that 7 sprites run smoother than 8.",
    status: "available"
  }
];
---

<Layout
  title="Tier 2: Living Worlds & Sprites - Phase 0 - Commodore 64"
  description="Master C64 sprites and build multi-room worlds. Learn VIC-II hardware sprites, animation, collision detection, and data-driven design. Progress from single sprites to complete animated game systems."
>
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .dev-notice {
      background: linear-gradient(135deg, rgba(255, 165, 0, 0.1), rgba(255, 140, 0, 0.1));
      border: 2px solid orange;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-bottom: var(--space-12);
      text-align: center;
    }

    .dev-notice h3 {
      color: orange;
      margin-bottom: var(--space-3);
      font-size: 1.25rem;
    }

    .dev-notice p {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 2: LIVING WORLDS & SPRITES</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Build on your Tier 1 fundamentals with hardware-accelerated sprites, multi-room systems, and data-driven design. Learn to create animated game characters, implement collision detection, build HUDs, and design living worlds that react to player actions. From single sprites to complete game systems.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons Available</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Planned Total</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–25</div>
        <div class="stat-label">Minutes Each</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <div class="dev-notice">
      <h3>🚧 Tier 2 In Development</h3>
      <p>
        Lessons 017-031 are now available! One more lesson coming soon to complete the Physics & Motion arc with the Asteroid Field synthesis game.
      </p>
    </div>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 2 introduces hardware sprites and data-driven game design. You'll move beyond text and characters to create smooth, hardware-accelerated graphics. By the end of these 16 lessons, you'll understand:
      </p>

      <ul>
        <li><strong>VIC-II Sprites:</strong> Hardware MOBs (Movable Object Blocks), sprite pointers, 9-bit coordinates, MSB handling, sprite colours</li>
        <li><strong>Animation Systems:</strong> Frame sequences, timing, sprite flipping, multi-sprite characters</li>
        <li><strong>Collision Detection:</strong> Hardware sprite-sprite collision, sprite-background collision, response systems</li>
        <li><strong>Multi-Room Worlds:</strong> Room transitions, coordinate systems, data-driven maps, persistent state</li>
        <li><strong>HUD & UI:</strong> Score displays, health bars, inventory indicators, text overlays</li>
        <li><strong>AI Patterns:</strong> Enemy movement, patrol routines, chase logic, state machines</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 2 Goal:</strong> Build a complete sprite-based action game with animated characters, multiple rooms, enemies with AI, collision detection, and a working HUD. You'll prove you can create smooth, responsive games using the C64's hardware acceleration.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Tier 1 (lessons 1-16). You should understand BASIC fundamentals, VIC-II colours, screen memory, SID sound, and keyboard input.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-2/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Create Your First Sprite?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Time to meet the VIC-II sprite system—hardware-accelerated graphics that move independently of the character grid. Let's create your first MOB!
      </p>
      <a href="/commodore-64/phase-0/tier-2/lesson-017" class="start-button">
        Start Lesson 17: Your First Sprite
      </a>
    </section>
  </div>
</Layout>
