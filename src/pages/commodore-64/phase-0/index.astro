---
import Layout from '../../../layouts/Layout.astro';

const tiers = [
  {
    number: 1,
    title: "Fundamentals & Structure",
    description: "PRINT, loops, variables, arrays, subroutines, text parsing, state machines, error handling",
    lessonCount: 16,
    duration: "4-5 hours",
    status: "available",
    url: "/commodore-64/phase-0/tier-1"
  },
  {
    number: 2,
    title: "Living Worlds & Sprites",
    description: "Multi-room systems, data-driven design, VIC-II sprites, animation, collision, HUD, AI",
    lessonCount: 16,
    duration: "4-5 hours",
    status: "available",
    url: "/commodore-64/phase-0/tier-2"
  },
  {
    number: 3,
    title: "Scrolling & Game Logic",
    description: "Camera systems, smooth scrolling, 2-axis physics, projectiles, power-ups, persistence",
    lessonCount: 16,
    duration: "4-5 hours",
    status: "available",
    url: "/commodore-64/phase-0/tier-3"
  },
  {
    number: 4,
    title: "Polish & Performance",
    description: "Libraries, menus, cutscenes, debugging, optimization, machine-code bridges, performance analysis",
    lessonCount: 16,
    duration: "4-5 hours",
    status: "available",
    url: "/commodore-64/phase-0/tier-4"
  }
];
---

<Layout title="Phase 0: BASIC Gateway - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-16) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
      position: relative;
      overflow: hidden;
    }

    .course-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.05) 2px,
          rgba(255, 255, 255, 0.05) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-3);
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.5rem;
      opacity: 0.95;
      margin-bottom: var(--space-8);
    }

    .course-description {
      max-width: 800px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.8;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
      text-align: center;
    }

    .intro-section h2 {
      font-size: 2rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.8;
      max-width: 700px;
      margin: 0 auto var(--space-4);
    }

    .tier-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-6);
      margin-bottom: var(--space-16);
    }

    .tier-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
    }

    .tier-card:hover {
      border-color: #4a4dff;
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(74, 77, 255, 0.15);
    }

    .tier-header {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
    }

    .tier-number {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.5rem;
      font-weight: bold;
      flex-shrink: 0;
    }

    .tier-title-block {
      flex: 1;
    }

    .tier-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-1);
    }

    .tier-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .tier-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: var(--space-4);
      flex-grow: 1;
    }

    .tier-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    .tier-lessons {
      font-family: var(--font-family-mono);
      font-weight: 600;
    }

    .tier-duration {
      opacity: 0.8;
    }

    .cta-section {
      text-align: center;
      padding: var(--space-16) 0;
    }

    .cta-title {
      font-size: 2rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .cta-description {
      color: var(--color-text-secondary);
      max-width: 600px;
      margin: 0 auto var(--space-6);
      line-height: 1.7;
    }

    .cta-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .cta-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .tier-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <div class="hero-content">
      <h1 class="course-title">PHASE 0: BASIC GATEWAY</h1>
      <p class="course-subtitle">Your Foundation for Assembly Programming</p>

      <p class="course-description">
        Learn C64 BASIC V2 from first principles through 64 focused lessons organized into 4 progressive tiers.
        Build complete games while mastering fundamentals that prepare you for pure assembly programming.
        This is your gateway to the metal.
      </p>

      <div class="course-stats">
        <div class="stat-item">
          <div class="stat-value">64</div>
          <div class="stat-label">Lessons</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">4</div>
          <div class="stat-label">Tiers</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">16-21</div>
          <div class="stat-label">Hours Total</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">6</div>
          <div class="stat-label">Complete Games</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Course Content -->
  <div class="content-container">
    <a href="/commodore-64" class="back-link">
      ← Back to Commodore 64
    </a>

    <!-- Introduction -->
    <section class="intro-section">
      <h2>What You'll Learn</h2>
      <p>
        Phase 0 teaches complete C64 game development in BASIC V2. You'll start with your first PRINT statement
        and build progressively to smooth-scrolling arcade games with sprites, AI, and sound. Every tier ends
        with working games you can play and share.
      </p>
      <p>
        By Tier 4, you'll understand BASIC's performance limits and be ready to transition to pure 6502 assembly
        in Phase 1. No prior programming experience required—just curiosity and a C64 (real or emulated).
      </p>
      <p style="margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border);">
        <strong>Need a quick reference?</strong> Check out the <a href="/commodore-64/phase-0/patterns" style="color: #4a4dff; font-weight: 600;">BASIC Pattern Library</a> —
        a comprehensive collection of reusable code patterns for game development.
      </p>
    </section>

    <!-- Tier Grid -->
    <section>
      <div class="tier-grid">
        {tiers.map(tier => (
          <a href={tier.url} class="tier-card">
            <div class="tier-header">
              <div class="tier-number">{tier.number}</div>
              <div class="tier-title-block">
                <div class="tier-label">Tier {tier.number}</div>
                <h3 class="tier-title">{tier.title}</h3>
              </div>
            </div>
            <p class="tier-description">{tier.description}</p>
            <div class="tier-meta">
              <span class="tier-lessons">{tier.lessonCount} lessons</span>
              <span class="tier-duration">{tier.duration}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <h2 class="cta-title">Ready to Start Your Journey?</h2>
      <p class="cta-description">
        Boot your C64, wait for the "READY." prompt, and let's build something amazing.
        The journey of a thousand programs begins with a single PRINT statement.
      </p>
      <a href="/commodore-64/phase-0/tier-1/lesson-001" class="cta-button">
        Start Lesson 1: Talk to Me →
      </a>
    </section>
  </div>
</Layout>
