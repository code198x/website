---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 1,
    title: "Talk to Me",
    description: "PRINT your first words and discover loops, colour, and the READY prompt.",
    status: "available"
  },
  {
    number: 2,
    title: "Timing Is Everything",
    description: "Master `FOR...NEXT` loops to pace output and build rhythmic effects.",
    status: "available"
  },
  {
    number: 3,
    title: "Decisions, Decisions",
    description: "Use `IF...THEN` with numbers and strings to make programs react.",
    status: "available"
  },
  {
    number: 4,
    title: "Counting on You",
    description: "Track scores and lives with numeric and string variables.",
    status: "available"
  },
  {
    number: 5,
    title: "Random Encounters",
    description: "Seed and use `RND` to add surprise, loot, and branching outcomes.",
    status: "available"
  },
  {
    number: 6,
    title: "Simple Animation",
    description: "Clear, position, and delay text to animate characters on screen.",
    status: "available"
  },
  {
    number: 7,
    title: "Sound Off",
    description: "Trigger SID voice 1 for bleeps, bloops, and celebratory cues.",
    status: "available"
  },
  {
    number: 8,
    title: "Mini-Game: Typing Turmoil",
    description: "Race random letters, score bonuses, and finish the first tier with a game.",
    status: "available"
  },
  {
    number: 9,
    title: "Arrays Are Born",
    description: "Dimension arrays to hold maps, inventories, and large data sets.",
    status: "available"
  },
  {
    number: 10,
    title: "Subroutines and Structure",
    description: "Organise code with `GOSUB...RETURN` to eliminate duplication.",
    status: "available"
  },
  {
    number: 11,
    title: "Parsing Commands",
    description: "Split input with `LEFT$`, `RIGHT$`, and `MID$` to build verb-noun systems.",
    status: "available"
  },
  {
    number: 12,
    title: "Nested Logic",
    description: "Combine conditions and nested `IF` blocks to handle intricate game rules.",
    status: "available"
  },
  {
    number: 13,
    title: "State Machines",
    description: "Model game phases (title, play, game-over) as numbered states.",
    status: "available"
  },
  {
    number: 14,
    title: "Error Handling",
    description: "Guard against invalid input and array bounds to avoid crashes.",
    status: "available"
  },
  {
    number: 15,
    title: "Data Structures",
    description: "Pack related values into parallel arrays to manage complex systems.",
    status: "available"
  },
  {
    number: 16,
    title: "Mini-Game: Room Explorer",
    description: "Build a text adventure framework with rooms, objects, and narrative.",
    status: "available"
  }
];
---

<Layout title="Tier 1: Fundamentals & Structure - Phase 0 - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 1: FUNDAMENTALS & STRUCTURE</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Over 16 lessons, you'll learn the fundamentals of C64 BASIC programming and build structured programs. From your first PRINT to creating text adventures with state machines, you'll develop real skills while making programs that actually do something. No prior experience required!
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">2</div>
        <div class="stat-label">Complete Games</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 1 covers essential programming fundamentals and structured programming techniques. By the end of these 16 lessons, you'll understand:
      </p>

      <ul>
        <li><strong>Display output</strong> with PRINT, cursor resets, and colour changes</li>
        <li><strong>Control flow</strong> with FOR...NEXT loops and IF...THEN decisions</li>
        <li><strong>Data storage</strong> in variables and arrays</li>
        <li><strong>Randomness</strong> for dynamic gameplay</li>
        <li><strong>Animation</strong> and SID sound effects</li>
        <li><strong>Code organization</strong> with GOSUB subroutines</li>
        <li><strong>Text parsing</strong> for command-driven games</li>
        <li><strong>State machines</strong> for game phase management</li>
        <li><strong>Error handling</strong> and robust input validation</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 1 Goals:</strong> Build two complete games - "Typing Turmoil" (a reflex mini-game) and "Room Explorer" (a text adventure framework). You'll prove you can ship working games while learning solid programming fundamentals.
      </div>

      <p>
        <strong>Prerequisites:</strong> None! Assume zero prior programming experience. You'll need access to a Commodore 64 (real hardware or emulator like VICE).
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-1/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Turn on your C64 (or boot your emulator), wait for the "READY." prompt,
        and let's write your first line of code!
      </p>
      <a href="/commodore-64/phase-0/tier-1/lesson-001" class="start-button">
        Start Lesson 1: Talk to Me
      </a>
    </section>
  </div>
</Layout>
