---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 1,
    title: "Hello, Computer",
    description: "PRINT your first words, understand the READY prompt, and create infinite loops.",
    status: "available"
  },
  {
    number: 2,
    title: "Counting",
    description: "Store values in variables and perform arithmetic operations.",
    status: "available"
  },
  {
    number: 3,
    title: "Repeating Yourself",
    description: "Master FOR...NEXT loops to automate repetitive tasks and create patterns.",
    status: "available"
  },
  {
    number: 4,
    title: "Making Decisions",
    description: "Use IF...THEN to branch your code and create interactive programs.",
    status: "available"
  },
  {
    number: 5,
    title: "Collections",
    description: "Dimension arrays to hold high score tables and collections of data.",
    status: "available"
  },
  {
    number: 6,
    title: "Data Everywhere",
    description: "Use DATA, READ, and RESTORE to separate data from logic in your programs.",
    status: "available"
  },
  {
    number: 7,
    title: "The First Colour",
    description: "Touch hardware for the first time by POKEing VIC-II border and background registers.",
    status: "available"
  },
  {
    number: 8,
    title: "Painting the Screen",
    description: "Write directly to screen memory and colour memory to create visual effects.",
    status: "available"
  },
  {
    number: 9,
    title: "Character Graphics",
    description: "Use PETSCII characters and CHR$() to draw boxes and patterns on screen.",
    status: "available"
  },
  {
    number: 10,
    title: "First Sound",
    description: "Program the SID chip to play notes and understand basic sound synthesis.",
    status: "available"
  },
  {
    number: 11,
    title: "Sound Effects",
    description: "Master ADSR envelopes and waveforms to create explosion, pickup, and attack sounds.",
    status: "available"
  },
  {
    number: 12,
    title: "Listening to the Player",
    description: "Use GET for non-blocking keyboard input and implement WASD movement.",
    status: "available"
  },
  {
    number: 13,
    title: "Random Events",
    description: "Generate random numbers with RND to spawn stars, enemies, and create variety.",
    status: "available"
  },
  {
    number: 14,
    title: "Collision and Scoring",
    description: "Detect when things collide, track scores, and implement win/lose conditions.",
    status: "available"
  },
  {
    number: 15,
    title: "Working with Time",
    description: "Use the TI jiffy clock for spawn timers, delays, and countdown mechanics.",
    status: "available"
  },
  {
    number: 16,
    title: "Dungeon Quest",
    description: "Combine all Tier 1 skills into a complete 69-line text adventure game.",
    status: "available"
  }
];
---

<Layout title="Tier 1: Fundamentals & Structure - Phase 0 - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 1: FUNDAMENTALS & STRUCTURE</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Over 16 lessons, you'll progress from "Hello World" to a complete text adventure game. Learn programming fundamentals, touch the hardware directly, and discover how the C64's chips create graphics and sound. By the end, you'll have built Dungeon Quest—a 69-line game combining everything you've learnt. No prior experience required!
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–25</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Complete Game</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 1 teaches programming fundamentals while introducing you to the C64's hardware. By the end of these 16 lessons, you'll understand:
      </p>

      <ul>
        <li><strong>Programming Fundamentals (L1-6):</strong> PRINT, variables, FOR loops, IF conditions, arrays, DATA statements</li>
        <li><strong>Hardware Introduction (L7-11):</strong> VIC-II colour registers, screen memory, PETSCII graphics, SID sound chip programming</li>
        <li><strong>Interactive Foundation (L12-15):</strong> GET input, random numbers, collision detection, score tracking, TI jiffy clock timing</li>
        <li><strong>Game Structure:</strong> GOSUB subroutines, boundary checking, event handlers, state management</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 1 Goal:</strong> Build "Dungeon Quest" - a complete 69-line text adventure combining movement, collision, scoring, random encounters, sound effects, and timing. You'll prove you can ship a working game while mastering both programming and hardware fundamentals.
      </div>

      <p>
        <strong>Prerequisites:</strong> None! Zero prior programming experience required. You'll need access to a Commodore 64 (real hardware or emulator like VICE).
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-1/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Turn on your C64 (or boot your emulator), wait for the "READY." prompt,
        and let's write your first line of code!
      </p>
      <a href="/commodore-64/phase-0/tier-1/lesson-001" class="start-button">
        Start Lesson 1: Hello, Computer
      </a>
    </section>
  </div>
</Layout>
