---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 49,
    title: "When Bullets Overwhelm",
    description: "Attempt to create a bullet hell shooter with 50 projectiles on screen and discover the brutal reality—3-4 frames per second performance that makes the game completely unplayable.",
    status: "available"
  },
  {
    number: 50,
    title: "The Jerky Road",
    description: "Attempt to create a smooth racing game and discover why character-based scrolling creates visible 8-pixel jumps—experience the hard limitation that requires assembly language for true smooth scrolling.",
    status: "available"
  },
  {
    number: 51,
    title: "When Physics Hits the Wall",
    description: "Create a particle explosion system with realistic gravity physics and discover why 30 particles calculating velocity and acceleration drops performance to 4-5 fps—experience BASIC's calculation overhead ceiling.",
    status: "available"
  },
  {
    number: 52,
    title: "Hitting the Wall 🔗",
    description: "Reflect on three attempts to build fast-paced games in BASIC—50 bullets dropped to 3 fps, smooth scrolling hit an 8-pixel wall, and 30 particles created a slideshow. Discover the pattern: BASIC's interpreter overhead makes real-time action with many objects fundamentally impossible.",
    status: "available"
  },
  {
    number: 53,
    title: "Worlds Too Large",
    description: "Attempt to create a Metroidvania with 50 interconnected rooms and discover why navigation overhead creates slow room transitions—experience how scope and data complexity compound in BASIC.",
    status: "available"
  },
  {
    number: 54,
    title: "Too Many Moving Parts",
    description: "Attempt to create a real-time strategy game with 10 units, pathfinding, and AI—discover why managing multiple entities with complex behaviours drops performance to 2 fps.",
    status: "available"
  },
  {
    number: 55,
    title: "Systems That Collide",
    description: "Attempt to create an open world with NPCs, quests, weather, time, and inventory—discover why multiple interacting systems create compounding overhead that slows every action.",
    status: "available"
  },
  {
    number: 56,
    title: "The Ambitious Dream 🔗",
    description: "SYNTHESIS: Combine everything you've learnt—50 rooms, 4-party members, 20 NPCs, 10 quests, time, weather—and discover the ultimate complexity ceiling where ambitious scope meets BASIC's limits.",
    status: "available"
  },
  {
    number: 57,
    title: "The Flickering Dream",
    description: "Attempt smooth pixel-perfect scrolling using VIC-II hardware registers and discover why timing precision requirements make it impossible in BASIC—witness screen tearing and jittery motion that reveals the boundary between interpreted code and cycle-accurate assembly.",
    status: "available"
  },
  {
    number: 58,
    title: "The Wandering Split",
    description: "Attempt split-screen racing for 2 players and discover why raster synchronization requires timing precision BASIC cannot achieve—witness split lines that wander and border colors that chase the raster beam.",
    status: "available"
  },
  {
    number: 59,
    title: "The Stuttering Symphony",
    description: "Attempt to play background music with sound effects in an arcade game and discover why SID's three-voice limitation creates impossible conflicts—witness music voices hijacked by gunshots and explosions, revealing the boundary between BASIC's sequential execution and assembly's interrupt-driven audio.",
    status: "available"
  },
  {
    number: 60,
    title: "The Boundary Revealed 🔗",
    description: "Run a demo collection showcasing every hardware effect BASIC can't achieve—smooth scrolling tears, raster bars wander, split-screens drift, music stutters—and synthesise the pattern: BASIC can access hardware registers but cannot synchronise with the VIC-II and SID timing requirements that define professional C64 programming.",
    status: "available"
  },
  {
    number: 61,
    title: "Breaking Through the Eight Sprite Barrier",
    description: "Experience the power of assembly language sprite multiplexing—call a pre-written machine code routine and suddenly display 16+ sprites at 60 fps, solving the performance problems that plagued BASIC throughout Tier 4.",
    status: "available"
  },
  {
    number: 62,
    title: "Smooth as Silk Scrolling",
    description: "Call an assembly smooth scrolling routine and experience true 1-pixel motion at 60 fps—watch the jerky 8-pixel character jumps from BASIC disappear completely as hardware scrolling takes over.",
    status: "available"
  },
  {
    number: 63,
    title: "Music Without the Mayhem",
    description: "Experience assembly-powered background music playing continuously during gameplay—solve the SID channel conflicts that plagued BASIC, finally achieving the music+sound effects combination of commercial games.",
    status: "available"
  },
  {
    number: 64,
    title: "The Hybrid Masterpiece 🔗",
    description: "SYNTHESIS - Combine assembly sprite multiplexing, smooth scrolling, and audio engine into one complete 60 fps platformer—experience the full power of hybrid BASIC+assembly programming and see exactly what Phase 1 will teach you to build.",
    status: "available"
  }
];
---

<Layout
  title="Tier 4: Systems & Boundaries - Phase 0 - Commodore 64"
  description="Push BASIC to its absolute limits and discover exactly where assembly language becomes necessary. Attempt bullet hell shooters, smooth scrolling, and complex systems—then experience the power of hybrid BASIC+assembly programming."
>
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 4: SYSTEMS & BOUNDARIES</h1>
    <p class="course-subtitle">Phase 0 - Finding the Limits</p>

    <p class="course-description">
      Over 16 lessons, you'll push BASIC to its breaking point and discover exactly where assembly language becomes necessary. Attempt bullet hell shooters that drop to 3 fps, smooth scrolling that tears, and complex systems that collapse—then experience the transformative power of hybrid BASIC+assembly programming. By the end, you'll understand both BASIC's limits and assembly's potential.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">20–30</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">4</div>
        <div class="stat-label">Synthesis Projects</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Discover This Tier</h2>

      <p>
        Tier 4 is about discovering boundaries through direct experience. You'll attempt ambitious projects that BASIC can't handle, then experience the dramatic difference when assembly language solves those exact problems:
      </p>

      <ul>
        <li><strong>Performance Limits (L49-52):</strong> Bullet hell shooters, smooth scrolling, particle systems—discover why BASIC's interpreter overhead makes fast-paced action impossible</li>
        <li><strong>Complexity Limits (L53-56):</strong> Large worlds, RTS games, system interactions—experience how scope and data complexity compound</li>
        <li><strong>Hardware Timing Limits (L57-60):</strong> VIC-II synchronization, raster splits, SID timing—witness why BASIC can't achieve cycle-accurate hardware control</li>
        <li><strong>Assembly Solutions (L61-64):</strong> Call pre-written machine code routines and experience 16+ sprites at 60 fps, smooth scrolling, and continuous music—see exactly what Phase 1 will teach you to build</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 4 Goal:</strong> Build "The Hybrid Masterpiece" - a complete 60 fps platformer combining BASIC game logic with assembly sprite multiplexing, smooth scrolling, and audio. Experience the full power of hybrid programming and understand exactly why Phase 1's assembly curriculum exists.
      </div>

      <p>
        <strong>Prerequisites:</strong> Completion of Tiers 1-3 (sprites, physics, optimization). This tier teaches by contrast—you need to master BASIC before discovering its boundaries.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-4/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Find the Limits?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        You've mastered BASIC fundamentals, sprites, and optimization. Now discover exactly where BASIC ends and assembly begins.
      </p>
      <a href="/commodore-64/phase-0/tier-4/lesson-049" class="start-button">
        Start Lesson 49: When Bullets Overwhelm
      </a>
    </section>
  </div>
</Layout>
