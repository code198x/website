---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 49,
    title: "Subroutine Libraries",
    description: "GOSUB patterns, parameter passing, return values—reusable sprite library",
    status: "coming_soon"
  },
  {
    number: 50,
    title: "Dispatch Tables",
    description: "ON...GOSUB, function pointer concept, dynamic routing—plugin-style system",
    status: "coming_soon"
  },
  {
    number: 51,
    title: "Initialization Routines",
    description: "Setup/teardown patterns, clean state management, error recovery",
    status: "coming_soon"
  },
  {
    number: 52,
    title: "Code Documentation",
    description: "REM comment strategy, self-documenting names, structure markers",
    status: "coming_soon"
  },
  {
    number: 53,
    title: "Level Data Structure",
    description: "Level format design, DATA organization, multiple level storage",
    status: "coming_soon"
  },
  {
    number: 54,
    title: "Level Loading",
    description: "READ/RESTORE patterns, level initialization, validation",
    status: "coming_soon"
  },
  {
    number: 55,
    title: "Save to Disk",
    description: "OPEN, PRINT#, CLOSE—sequential files, save game state",
    status: "coming_soon"
  },
  {
    number: 56,
    title: "High Score Table",
    description: "Persistent storage, sorting scores, name entry—Top 10 leaderboard",
    status: "coming_soon"
  },
  {
    number: 57,
    title: "Title Screen",
    description: "Animated title, press fire to start, credits display",
    status: "coming_soon"
  },
  {
    number: 58,
    title: "Menu System",
    description: "Array-driven menus, selection display, navigation—options menu",
    status: "coming_soon"
  },
  {
    number: 59,
    title: "Instructions Screen",
    description: "Multi-page text, controls display, pagination—in-game manual",
    status: "coming_soon"
  },
  {
    number: 60,
    title: "Configuration",
    description: "Difficulty settings, control preferences, volume control",
    status: "coming_soon"
  },
  {
    number: 61,
    title: "Error Handling",
    description: "ON ERROR GOTO, ERR/ERL variables, graceful failure",
    status: "coming_soon"
  },
  {
    number: 62,
    title: "Performance Profiling",
    description: "Identifying bottlenecks, TI measurement, optimization priorities",
    status: "coming_soon"
  },
  {
    number: 63,
    title: "Assembly Bridge",
    description: "Calling ML from BASIC, SYS command, USR function—hybrid programs",
    status: "coming_soon"
  },
  {
    number: 64,
    title: "Complete Polished Game",
    description: "Professional structure, all Tier 4 patterns—Phase 0 capstone",
    status: "coming_soon"
  }
];
---

<Layout
  title="Tier 4: Systems - Phase 0 - Commodore 64"
  description="Professional patterns, complete programs, smooth transition to assembly. Build polished game with libraries, menus, disk I/O, error handling, and machine code bridges."
>
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 4: POLISH & PERFORMANCE</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Complete your BASIC mastery with professional polish, optimization, and understanding BASIC's limits. These final 16 lessons teach libraries, menus, cutscenes, debugging, performance tuning, and bridging to assembly. Graduate ready for pure machine code.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Complete Game</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 4 brings professional polish and prepares you for assembly programming. You'll learn:
      </p>

      <ul>
        <li><strong>Code libraries</strong> - Reusable routines for drawing, sound, and utilities</li>
        <li><strong>Title screens & menus</strong> - Attract modes, navigation, and options</li>
        <li><strong>Multi-level systems</strong> - Stage progression with data-driven design</li>
        <li><strong>Narrative cutscenes</strong> - Timed, skippable story beats</li>
        <li><strong>Debugging techniques</strong> - Variable tracing, pause loops, debug HUDs</li>
        <li><strong>Performance optimization</strong> - Profiling hotspots, caching, loop unrolling</li>
        <li><strong>Error handling</strong> - Graceful failures for DATA, memory, input</li>
        <li><strong>Memory inspection</strong> - Understanding BASIC pointers and RAM layout</li>
        <li><strong>Machine code integration</strong> - Installing and calling assembly helpers with SYS</li>
        <li><strong>Frame budgets</strong> - Monitoring performance limits and deciding what to port</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 4 Goal:</strong> Build "Galactic Miner" (complete game with menus, cutscenes, multiple levels) and understand BASIC's performance boundaries. Graduate ready to tackle assembly programming in Phase 1.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Tiers 1-3 (lessons 1-48). You'll build on all prior techniques and push BASIC to its limits.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-4/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Polish?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        You've built complete games. Now let's add professional polish, optimize performance,
        and understand BASIC's limits before moving to pure assembly!
      </p>
      <a href="/commodore-64/phase-0/tier-4/lesson-049" class="start-button">
        Start Lesson 49: Libraries in BASIC
      </a>
    </section>
  </div>
</Layout>
