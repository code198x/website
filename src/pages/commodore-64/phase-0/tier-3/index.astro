---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 33,
    title: "Paging the Screen",
    description: "Slide a viewing window across stored data like a camera pan",
    status: "available"
  },
  {
    number: 34,
    title: "Level Design by DATA",
    description: "Load tile maps from DATA tables and render them as readable tunnels",
    status: "available"
  },
  {
    number: 35,
    title: "Smooth Scrolling",
    description: "Use VIC-II fine scroll to glide text and tiles a pixel at a time",
    status: "available"
  },
  {
    number: 36,
    title: "Verticality",
    description: "Balance two-axis velocity, thrust, and bounds for hovercraft control",
    status: "available"
  },
  {
    number: 37,
    title: "Simple AI",
    description: "Switch patrols into chase mode with lightweight distance checks",
    status: "available"
  },
  {
    number: 38,
    title: "Collision Layers",
    description: "Separate walls, collectibles, and hazards with VIC-II collision flags",
    status: "available"
  },
  {
    number: 39,
    title: "Game Loops Revisited",
    description: "Stabilise action with fixed-step timing driven by the jiffy clock",
    status: "available"
  },
  {
    number: 40,
    title: "Scroll Runner",
    description: "Capstone mini-game combining scrolling, AI, collisions, and pacing",
    status: "available"
  },
  {
    number: 41,
    title: "Finite State Fun",
    description: "Drive title, play, and game-over screens with clean state logic",
    status: "available"
  },
  {
    number: 42,
    title: "Random Opponents",
    description: "Blend patrol and chase behaviours with weighted randomness",
    status: "available"
  },
  {
    number: 43,
    title: "Shooting Stars",
    description: "Launch, recycle, and pace projectiles with cooldowns",
    status: "available"
  },
  {
    number: 44,
    title: "Hit Detection",
    description: "React to sprite collisions with flashes, score bumps, and respawns",
    status: "available"
  },
  {
    number: 45,
    title: "Power-Ups",
    description: "Spawn buffs, trigger effects, and cleanly expire them",
    status: "available"
  },
  {
    number: 46,
    title: "Balancing Act",
    description: "Ramp speed and spawn timers without overwhelming the player",
    status: "available"
  },
  {
    number: 47,
    title: "Saving Scores",
    description: "Keep a high-score table in arrays and write it to disk",
    status: "available"
  },
  {
    number: 48,
    title: "Cosmic Clash",
    description: "Mini-game weaving states, AI, power-ups, and persistence together",
    status: "available"
  }
];
---

<Layout title="Tier 3: Scrolling & Game Logic - Phase 0 - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 3: SCROLLING & GAME LOGIC</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Master smooth scrolling, advanced game loops, and complete game systems. These 16 lessons teach VIC-II scrolling, projectile systems, power-ups, and building full arcade experiences with state management and persistence.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">2</div>
        <div class="stat-label">Complete Games</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 3 brings arcade-quality scrolling and complex game systems. You'll learn:
      </p>

      <ul>
        <li><strong>Camera systems</strong> - Paging viewports and smooth VIC-II hardware scrolling</li>
        <li><strong>Tile-based level design</strong> - Data-driven maps with collision layers</li>
        <li><strong>2-axis physics</strong> - Velocity, thrust, and bounds for flight/hover control</li>
        <li><strong>Advanced AI</strong> - Patrol/chase modes with weighted randomness</li>
        <li><strong>Projectile systems</strong> - Launching, recycling, and cooldowns</li>
        <li><strong>Power-up mechanics</strong> - Spawning, effects, and expiry</li>
        <li><strong>Game balancing</strong> - Difficulty ramping without overwhelming players</li>
        <li><strong>Persistence</strong> - High-score tables saved to disk</li>
        <li><strong>Fixed-step timing</strong> - Jiffy clock-driven stable game loops</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 3 Goals:</strong> Build "Scroll Runner" (smooth-scrolling platformer with AI) and "Cosmic Clash" (complete arcade game with states, power-ups, and high-score persistence). Achieve commercial-quality game systems.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Tiers 1-2 (lessons 1-32). You'll build on sprites, collision, and state machines.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/phase-0/tier-3/lesson-${String(lesson.number).padStart(3, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Scroll?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        You've conquered sprites and rooms. Now let's unlock smooth scrolling,
        advanced physics, and complete arcade game systems!
      </p>
      <a href="/commodore-64/phase-0/tier-3/lesson-033" class="start-button">
        Start Lesson 33: Paging the Screen
      </a>
    </section>
  </div>
</Layout>
