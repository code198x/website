---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 33,
    title: "Falling Into Place",
    description: "Implement gravity as constant downward acceleration and create jumping mechanics with velocity override—build the foundation for platformer physics with ground collision detection.",
    status: "available"
  },
  {
    number: 34,
    title: "Landing on Solid Ground",
    description: "Detect collision with multiple platforms using array-based data structures and velocity-aware landing logic—only land when falling, not when jumping through from below.",
    status: "available"
  },
  {
    number: 35,
    title: "Character States Come to Life",
    description: "Implement a character state machine switching between idle, walk, and jump animations—discover how frame cycling creates smooth motion and experience the performance impact of multi-state animation in BASIC.",
    status: "available"
  },
  {
    number: 36,
    title: "The World Moves Around You",
    description: "Create a horizontal scrolling camera system that follows your character across multi-screen levels—discover character-based scrolling in BASIC and experience the performance cost of redrawing 1000 screen characters.",
    status: "available"
  },
  {
    number: 37,
    title: "Enemy AI Patterns",
    description: "Implement platform-aware enemy AI with patrol and chase behaviours—discover how to manage multiple enemies using state machines, distance calculations, and platform collision detection.",
    status: "available"
  },
  {
    number: 38,
    title: "Collectibles & Goals",
    description: "Keys, gems, locked doors, level objectives—implement item collection systems, door mechanics, and win conditions for platformer levels.",
    status: "available"
  },
  {
    number: 39,
    title: "Polish & Integration",
    description: "Title screen, HUD, sound effects, lives—add professional presentation and integrate all systems into cohesive platformer experience.",
    status: "available"
  },
  {
    number: 40,
    title: "Crystal Caverns 🔗",
    description: "Synthesis of Action Platformer arc—complete game (~180 lines) with gravity, jumping, scrolling, enemies, animation. Runs at 8-10 fps with full animation—playable but noticeably choppy.",
    status: "available"
  },
  {
    number: 41,
    title: "Room-Based World",
    description: "12-room dungeon with NSEW navigation—build RPG-style world structure with room transitions, persistent state, and text-based navigation.",
    status: "available"
  },
  {
    number: 42,
    title: "Inventory System",
    description: "Collect items, manage slots, item usage—create RPG inventory with capacity limits, item effects, and usage mechanics.",
    status: "available"
  },
  {
    number: 43,
    title: "Dialogue System",
    description: "NPC conversations, branching choices—implement text-based dialogue trees, character interactions, and story progression.",
    status: "available"
  },
  {
    number: 44,
    title: "Turn-Based Combat",
    description: "HP, attacks, enemy AI, items in battle—create RPG combat system with no speed pressure, proving BASIC excels at turn-based games.",
    status: "available"
  },
  {
    number: 45,
    title: "Save/Load System",
    description: "Disk operations, game state persistence—implement save files so players can return to their RPG adventure across sessions.",
    status: "available"
  },
  {
    number: 46,
    title: "Dungeon Quest 🔗",
    description: "Synthesis of Turn-Based RPG arc—complete RPG (~220 lines) with world, inventory, dialogue, combat, save/load. Runs flawlessly—BASIC's sweet spot discovered!",
    status: "available"
  },
  {
    number: 47,
    title: "Box Pusher: Sokoban Clone",
    description: "Grid-based pushing puzzle with 8 levels—implement puzzle game logic, push mechanics, level progression. Complex logic runs perfectly in BASIC.",
    status: "available"
  },
  {
    number: 48,
    title: "Puzzle Master 🔗",
    description: "Synthesis of Puzzle Collection—Sokoban + Connect Four + Memory Match (~120 lines total). Puzzle games are BASIC's superpower—unlimited complexity, zero speed issues!",
    status: "available"
  }
];
---

<Layout
  title="Tier 3: Mastery - Phase 0 - Commodore 64"
  description="Build three professional-quality games across major genres. Master advanced techniques and discover BASIC's genre sweet spot—turn-based and puzzle games excel, action games struggle. Complete games comparable to commercial 1980s releases."
>
  <style>
    .course-hero {
      background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #ff6b35;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #ff6b35;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #ff6b35;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(255, 107, 53, 0.1);
    }

    .lesson-card.coming-soon {
      opacity: 0.6;
      cursor: default;
    }

    .lesson-card.coming-soon:hover {
      border-color: var(--color-border);
      transform: none;
      box-shadow: none;
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-card.coming-soon .lesson-number {
      background: #666;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(255, 107, 53, 0.1);
      color: #ff6b35;
    }

    .lesson-card.coming-soon .lesson-status {
      background: rgba(128, 128, 128, 0.1);
      color: #666;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 107, 53, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #ff6b35;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #ff6b35;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .dev-notice {
      background: linear-gradient(135deg, rgba(255, 165, 0, 0.1), rgba(255, 140, 0, 0.1));
      border: 2px solid orange;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-bottom: var(--space-12);
      text-align: center;
    }

    .dev-notice h3 {
      color: orange;
      margin-bottom: var(--space-3);
      font-size: 1.25rem;
    }

    .dev-notice p {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .arc-section {
      margin-bottom: var(--space-12);
    }

    .arc-title {
      font-size: 1.5rem;
      color: #ff6b35;
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid #ff6b35;
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 3: MASTERY</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Build three professional-quality games across major genres. Master advanced techniques like multi-state animation, inventory systems, save/load, and AI. Discover BASIC's genre sweet spot through building complete games—turn-based and puzzle excel, action struggles.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons Available</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Total Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">150–250</div>
        <div class="stat-label">Lines of Code</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <div class="dev-notice">
      <h3>🎉 Tier 3 Complete!</h3>
      <p>
        All 16 lessons now available! Build Crystal Caverns (action platformer at 8-10 fps), create Dungeon Quest (turn-based RPG with flawless performance), and finish with Puzzle Master (3-game collection). Experience firsthand how BASIC excels at turn-based and puzzle games whilst action games struggle. You've discovered BASIC's genre sweet spot through direct experience!
      </p>
    </div>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 3 is where you become a professional game developer. You'll build three complete, polished games across different genres—platformer, RPG, and puzzle collection. By the end of these 16 lessons, you'll have created games comparable to commercial 1980s releases and discovered BASIC's true strengths:
      </p>

      <ul>
        <li><strong>Action Platformer (L33-40):</strong> Gravity, jumping, scrolling, multi-state animation, enemies, polish → Crystal Caverns (~180 lines, runs at 8-10 fps)</li>
        <li><strong>Turn-Based RPG (L41-46):</strong> Room navigation, inventory, dialogue, combat, save/load → Dungeon Quest (~220 lines, runs flawlessly!)</li>
        <li><strong>Puzzle Games (L47-48):</strong> Sokoban, Connect Four, Memory Match → Puzzle Master (~120 lines, perfect performance)</li>
        <li><strong>Advanced Systems:</strong> Multi-state animation, inventory management, AI patterns, save/load to disk</li>
        <li><strong>Production Skills:</strong> Title screens, HUD design, sound integration, player feedback, polish</li>
        <li><strong>Genre Discovery:</strong> Experience firsthand which game types work brilliantly in BASIC and which struggle</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 3 Goal:</strong> Build three complete professional games and discover through experience that BASIC has a genre sweet spot. Your platformer will work but feel choppy at 8-10 fps. Your RPG will feel perfect—complex systems with zero slowdown. Your puzzle games will be flawless. You'll learn to choose the right tool for each genre.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Tier 2 (lessons 17-32). You should master sprites, animation, collision, joystick control, sound/music, and physics simulation. Programs up to 150 lines.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <!-- Arc 1: Action Platformer -->
      <div class="arc-section">
        <h3 class="arc-title">Arc 1: Action Platformer (L33-40)</h3>
        <div class="lessons-grid">
          {lessons.slice(0, 8).map(lesson => (
            <a href={lesson.status === 'available' ? `/commodore-64/phase-0/tier-3/lesson-${String(lesson.number).padStart(3, '0')}` : '#'}
               class={`lesson-card ${lesson.status === 'coming-soon' ? 'coming-soon' : ''}`}>
              <div class="lesson-number">{lesson.number}</div>
              <div class="lesson-content">
                <h3 class="lesson-title">{lesson.title}</h3>
                <p class="lesson-description">{lesson.description}</p>
              </div>
              <div class="lesson-status">
                {lesson.status === 'available' ? 'Start →' : 'Coming Soon'}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Arc 2: Turn-Based RPG -->
      <div class="arc-section">
        <h3 class="arc-title">Arc 2: Turn-Based RPG (L41-46)</h3>
        <div class="lessons-grid">
          {lessons.slice(8, 14).map(lesson => (
            <a href={lesson.status === 'available' ? `/commodore-64/phase-0/tier-3/lesson-${String(lesson.number).padStart(3, '0')}` : '#'}
               class={`lesson-card ${lesson.status === 'coming-soon' ? 'coming-soon' : ''}`}>
              <div class="lesson-number">{lesson.number}</div>
              <div class="lesson-content">
                <h3 class="lesson-title">{lesson.title}</h3>
                <p class="lesson-description">{lesson.description}</p>
              </div>
              <div class="lesson-status">
                {lesson.status === 'available' ? 'Start →' : 'Coming Soon'}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Arc 3: Puzzle Collection -->
      <div class="arc-section">
        <h3 class="arc-title">Arc 3: Puzzle Collection (L47-48)</h3>
        <div class="lessons-grid">
          {lessons.slice(14).map(lesson => (
            <a href={lesson.status === 'available' ? `/commodore-64/phase-0/tier-3/lesson-${String(lesson.number).padStart(3, '0')}` : '#'}
               class={`lesson-card ${lesson.status === 'coming-soon' ? 'coming-soon' : ''}`}>
              <div class="lesson-number">{lesson.number}</div>
              <div class="lesson-content">
                <h3 class="lesson-title">{lesson.title}</h3>
                <p class="lesson-description">{lesson.description}</p>
              </div>
              <div class="lesson-status">
                {lesson.status === 'available' ? 'Start →' : 'Coming Soon'}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Build Professional Games?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Begin the Action Platformer arc with gravity and jumping physics—the foundation of every platform game. Let's create realistic falling and jumping mechanics!
      </p>
      <a href="/commodore-64/phase-0/tier-3/lesson-033" class="start-button">
        Start Lesson 33: Falling Into Place
      </a>
    </section>
  </div>
</Layout>
