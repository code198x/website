---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 33,
    title: "Advanced Animation",
    description: "Multi-frame sequences and animation state machines",
    status: "coming_soon"
  },
  {
    number: 34,
    title: "Sprite Priority",
    description: "Foreground/background layering—sprites behind objects",
    status: "coming_soon"
  },
  {
    number: 35,
    title: "Sprite Expansion",
    description: "X/Y doubling and multicolor sprites—large boss sprites",
    status: "available"
  },
  {
    number: 36,
    title: "Attempting Multiplexing",
    description: "Reuse sprites mid-screen... watch BASIC flicker",
    status: "available"
  },
  {
    number: 37,
    title: "Sprite Optimization",
    description: "Minimise POKEs—best BASIC can do (still has limits)",
    status: "available"
  },
  {
    number: 38,
    title: "Multi-Voice Music",
    description: "Melody + bass + rhythm—timing challenges in BASIC",
    status: "coming_soon"
  },
  {
    number: 39,
    title: "Sound + Sprite Sync",
    description: "Music during gameplay—timing coordination struggles",
    status: "coming_soon"
  },
  {
    number: 40,
    title: "Ring Modulation & Filters",
    description: "SID advanced features—special effects sounds",
    status: "coming_soon"
  },
  {
    number: 41,
    title: "Understanding Rasters",
    description: "Electron beam concept—BASIC too slow to exploit",
    status: "coming_soon"
  },
  {
    number: 42,
    title: "Mid-Screen Color Changes",
    description: "Attempting color bars—unstable, showing BASIC's limit",
    status: "coming_soon"
  },
  {
    number: 43,
    title: "Timing Measurement",
    description: "TI jiffy clock accuracy—profiling code sections",
    status: "coming_soon"
  },
  {
    number: 44,
    title: "Address Tables",
    description: "Pre-calculated values—trading memory for speed",
    status: "coming_soon"
  },
  {
    number: 45,
    title: "Loop Unrolling",
    description: "Eliminate loop overhead—code size tradeoff",
    status: "coming_soon"
  },
  {
    number: 46,
    title: "Efficient Screen Updates",
    description: "Minimise writes—dirty rectangle concept, flicker reduction",
    status: "coming_soon"
  },
  {
    number: 47,
    title: "Memory Management",
    description: "FRE() function, variable organization, array placement",
    status: "coming_soon"
  },
  {
    number: 48,
    title: "Ambitious Game",
    description: "Push BASIC hard—sprite flicker, music stutters, jerky scrolling",
    status: "coming_soon"
  }
];
---

<Layout
  title="Tier 3: Limits - Phase 0 - Commodore 64"
  description="Push BASIC to its absolute limit. Attempt sprite multiplexing, raster effects, and optimisation. Experience where BASIC breaks and understand why assembly exists. Prepare for Phase 1."
>
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      opacity: 0.6;
      cursor: not-allowed;
    }

    .lesson-card.available {
      opacity: 1;
      cursor: pointer;
    }

    .lesson-card.available:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .lesson-status.coming-soon {
      background: rgba(128, 128, 128, 0.1);
      color: var(--color-text-secondary);
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .start-button.disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">TIER 3: LIMITS</h1>
    <p class="course-subtitle">Phase 0 - BASIC Gateway</p>

    <p class="course-description">
      Push BASIC to its absolute ceiling. These 16 lessons deliberately attempt impossible techniques—sprite multiplexing, raster effects, extreme optimisation. Watch BASIC break. Understand why assembly exists. Graduate frustrated and motivated.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">16</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15–20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Limit-Breaking Game</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <a href="/commodore-64/phase-0" class="back-link">
      ← Back to Phase 0
    </a>

    <section class="intro-section">
      <h2>What You'll Learn This Tier</h2>

      <p>
        Tier 3 is about deliberate failure. You'll attempt professional techniques that BASIC simply cannot do:
      </p>

      <ul>
        <li><strong>Advanced sprite techniques</strong> - Multi-colour, priorities, expansion, and failed multiplexing</li>
        <li><strong>Sound shaping</strong> - ADSR envelopes, music sequences, and sync struggles</li>
        <li><strong>Raster understanding</strong> - How screen drawing works and why BASIC can't control it</li>
        <li><strong>Optimisation</strong> - Lookup tables, loop unrolling, profiling bottlenecks</li>
        <li><strong>Hybrid programming</strong> - Calling assembly from BASIC (gateway to Phase 1)</li>
      </ul>

      <div class="wow-box">
        <strong>Tier 3 Goal:</strong> Build "Against the Wall"—a complete game that starts smooth at Wave 1, becomes sluggish at Wave 3, flickers wildly at Wave 4, and turns into an unplayable slideshow at Wave 5. Not because you did something wrong. Because BASIC has limits. Time for assembly.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Tiers 1-2 (lessons 1-32). You'll need sprites, sound, and collision before hitting limits.
      </p>

      <p style="margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-text-secondary); font-size: 0.95rem;">
        <strong>Pedagogical note:</strong> This tier creates productive frustration. You'll see flickering sprites, unstable raster bars, and jerky animation <em>that you cannot fix in BASIC</em>. This visceral experience is critical—it creates genuine need for assembly programming in Phase 1.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          lesson.status === "available" ? (
            <a href={`/commodore-64/phase-0/tier-3/lesson-${String(lesson.number).padStart(3, '0')}`}
               class="lesson-card available">
              <div class="lesson-number">{lesson.number}</div>
              <div class="lesson-content">
                <h3 class="lesson-title">{lesson.title}</h3>
                <p class="lesson-description">{lesson.description}</p>
              </div>
              <div class="lesson-status">Start →</div>
            </a>
          ) : (
            <div class="lesson-card">
              <div class="lesson-number">{lesson.number}</div>
              <div class="lesson-content">
                <h3 class="lesson-title">{lesson.title}</h3>
                <p class="lesson-description">{lesson.description}</p>
              </div>
              <div class="lesson-status coming-soon">Coming Soon</div>
            </div>
          )
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Hit the Wall?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        You've built complete games in BASIC. Now it's time to discover its limits by attempting
        the impossible. Frustration awaits—and so does the path to assembly mastery.
      </p>
      <a href="/commodore-64/phase-0/tier-3/lesson-033" class="start-button">
        Start Lesson 33: Multi-Colour Sprites
      </a>
    </section>
  </div>
</Layout>
