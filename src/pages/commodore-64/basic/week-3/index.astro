---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 17,
    title: "The Art of Movement",
    description: "Animate single- and multi-tile shapes with smooth loops",
    status: "available"
  },
  {
    number: 18,
    title: "Logic & Motion II",
    description: "Blend velocity, collisions, and hazards inside live mazes",
    status: "available"
  },
  {
    number: 19,
    title: "Text Tricks II",
    description: "Format HUDs and normalise input for richer interfaces",
    status: "available"
  },
  {
    number: 20,
    title: "Memory Games II",
    description: "Load multi-room data (maps, rules, dialogue) from DATA",
    status: "available"
  },
  {
    number: 21,
    title: "Smarter Decisions II",
    description: "Drive room-specific behaviour through rule tables",
    status: "available"
  },
  {
    number: 22,
    title: "Text Tricks III",
    description: "Build highlighted menus and scrolling dialogue panels",
    status: "available"
  },
  {
    number: 23,
    title: "Memory Games III",
    description: "Stream dialogue and music cues alongside map data",
    status: "available"
  },
  {
    number: 24,
    title: "Mini-Game: Terminal Tangle",
    description: "Run a multi-room chase with UI, rules, and dialogue",
    status: "available"
  }
];
---

<Layout title="Week 3: Graphics & Sound - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #ff6b9d 0%, #c06c84 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #ff6b9d;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #ff6b9d;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #ff6b9d;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(255, 107, 157, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #ff6b9d 0%, #c06c84 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(255, 107, 157, 0.1);
      color: #ff6b9d;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #ff6b9d 0%, #c06c84 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 107, 157, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #ff6b9d;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #ff6b9d;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 3: LIVING WORLDS</h1>
    <p class="course-subtitle">Motion • Rules • Interface • Narrative</p>

    <p class="course-description">
      Week 3 stitches smooth movement, room-specific logic, polished UI, and streaming story data into one responsive experience. You’ll glide characters, adapt hazards via rule tables, format dialogue and menus, and load per-room text and music—finishing with the Terminal Tangle mini-game.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15-20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">100%</div>
        <div class="stat-label">Hardware Power</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>What You'll Learn This Week</h2>

      <p>
        Week 3 unlocks responsive worlds. By the end of these 8 lessons,
        you'll understand how to:
      </p>

      <ul>
        <li><strong>Animate characters</strong> with direct screen/colour memory control</li>
        <li><strong>Blend velocity and collisions</strong> so players and patrollers share the maze safely</li>
        <li><strong>Format UI</strong> using padded HUDs, highlightable menus, and scrolling dialogue</li>
        <li><strong>Load per-room data</strong> (maps, rules, dialogue, music cues) from structured DATA blocks</li>
        <li><strong>Route behaviour</strong> through rule tables instead of sprawling IF chains</li>
        <li><strong>Ship a multi-room mini-game</strong> where logic, narrative, and movement respond to the room</li>
      </ul>

      <div class="wow-box">
        <strong>Week 3 Goal:</strong> Build <em>Terminal Tangle</em> — a multi-room chase featuring dialogue panels, menu choices, adaptive hazards, and hooks for room-specific music.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Weeks 1 & 2 first! These lessons build on loops, variables,
        and DATA statements from previous weeks.
      </p>

      <p>
        <strong>Learning approach:</strong> Each lesson reveals how something you've already used actually works
        under the hood. You'll start with "You've been using this already!" and end with direct hardware control.
        Type the short examples (20-40 lines), modify values, and watch the C64's hardware respond instantly.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-3/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Ready to turn systems into stories? Week 3 blends movement, data, logic, and UI so your maze starts to breathe. Begin by mastering smooth on-screen animation.
      </p>
      <a href="/commodore-64/basic/week-3/lesson-17" class="start-button">
        Start Lesson 17: The Art of Movement
      </a>
    </section>
  </div>
</Layout>
