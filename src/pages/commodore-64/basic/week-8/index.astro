---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 57,
    title: "Text Adventure Game",
    description: "Multi-room adventure with inventory system",
    status: "available"
  },
  {
    number: 58,
    title: "Puzzle Game (Sokoban-style)",
    description: "Push boxes to targets with undo",
    status: "available"
  },
  {
    number: 59,
    title: "Arcade Action Game",
    description: "Shoot waves of enemies with power-ups",
    status: "available"
  },
  {
    number: 60,
    title: "Strategy Game",
    description: "Turn-based battle with AI opponent",
    status: "available"
  },
  {
    number: 61,
    title: "Quiz/Trivia Game",
    description: "Multiple choice with timer and scoring",
    status: "available"
  },
  {
    number: 62,
    title: "Sports Game (Pong-style)",
    description: "2-player paddle game with physics",
    status: "available"
  },
  {
    number: 63,
    title: "Rhythm/Music Game",
    description: "Press keys in time with music",
    status: "available"
  },
  {
    number: 64,
    title: "The BASIC Ceiling",
    description: "What BASIC can't do—and what's next",
    status: "available"
  }
];
---

<Layout title="Week 8: Complete Projects - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #ef4444;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #ef4444;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #ef4444;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(239, 68, 68, 0.1);
      color: #ef4444;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #ef4444;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #ef4444;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 8: COMPLETE PROJECTS</h1>
    <p class="course-subtitle">8 Genre-Defining Games</p>

    <p class="course-description">
      This is it—the culmination of 7 weeks of learning. Week 8 combines everything you've learnt into 8 complete, genre-defining games. Text adventures, puzzles, arcade action, strategy, trivia, sports, rhythm, and finally—the BASIC ceiling. These are the projects that showcase what you can create with C64 BASIC.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Complete Games</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">7</div>
        <div class="stat-label">Weeks Applied</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">Final</div>
        <div class="stat-label">Projects</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>Your Complete Portfolio</h2>

      <p>
        Week 8 is different from everything before. Instead of learning isolated features, you'll build complete games across different genres. Each lesson is a finished product combining all 64 lessons of knowledge:
      </p>

      <ul>
        <li><strong>Lesson 57: Text Adventure</strong> - multi-room exploration with inventory and win condition</li>
        <li><strong>Lesson 58: Puzzle Game</strong> - Sokoban-style box pushing with undo mechanic</li>
        <li><strong>Lesson 59: Arcade Action</strong> - shoot waves of enemies with power-ups and boss</li>
        <li><strong>Lesson 60: Strategy Game</strong> - turn-based battle against AI opponent</li>
        <li><strong>Lesson 61: Quiz/Trivia</strong> - multiple choice questions with timer and high score</li>
        <li><strong>Lesson 62: Sports Game</strong> - 2-player Pong with ball physics and scoring</li>
        <li><strong>Lesson 63: Rhythm/Music</strong> - press keys in time with music for points</li>
        <li><strong>Lesson 64: The BASIC Ceiling</strong> - what BASIC can't do, and your next steps</li>
      </ul>

      <div class="wow-box">
        <strong>Week 8 Goal:</strong> By Lesson 63, you'll have 7 complete games spanning every major genre. Lesson 64 shows you BASIC's limits and points you toward Assembly—the natural next step in your C64 journey.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Weeks 1-7 first! These final projects use EVERYTHING—variables, loops, arrays, sprites, sound, collision, controls, animation, AI, lives, game states, menus, difficulty, power-ups, bosses, and polish.
      </p>

      <p>
        <strong>Learning approach:</strong> Each game is complete and playable. Type them, play them, share them, modify them. These are showcase projects demonstrating what 64 lessons of BASIC can create. Then Lesson 64 honestly shows what BASIC can't do—and where Assembly takes over.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Final Projects</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-8/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Build Your Portfolio?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Week 8 is the culmination of your BASIC journey. Seven complete games across every genre, then an honest look at BASIC's limits and your path to Assembly. This is where learning becomes creation.
      </p>
      <a href="/commodore-64/basic/week-8/lesson-57" class="start-button">
        Start Lesson 57: Text Adventure
      </a>
    </section>
  </div>
</Layout>
