---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 33,
    title: "Paging the Screen",
    description: "Slide a viewing window across stored data like a camera pan.",
    status: "available"
  },
  {
    number: 34,
    title: "Level Design by DATA",
    description: "Load tile maps from DATA tables and render them as readable tunnels.",
    status: "available"
  },
  {
    number: 35,
    title: "Smooth Scrolling",
    description: "Use VIC-II fine scroll to glide text and tiles a pixel at a time.",
    status: "available"
  },
  {
    number: 36,
    title: "Verticality",
    description: "Balance two-axis velocity, thrust, and bounds for hovercraft control.",
    status: "available"
  },
  {
    number: 37,
    title: "Simple AI",
    description: "Switch patrols into chase mode with lightweight distance checks.",
    status: "available"
  },
  {
    number: 38,
    title: "Collision Layers",
    description: "Separate walls, collectibles, and hazards with VIC-II collision flags.",
    status: "available"
  },
  {
    number: 39,
    title: "Game Loops Revisited",
    description: "Stabilise action with fixed-step timing driven by the jiffy clock.",
    status: "available"
  },
  {
    number: 40,
    title: "Scroll Runner",
    description: "Capstone mini-game combining scrolling, AI, collisions, and pacing.",
    status: "available"
  }
];
---

<Layout title="Week 5: Maps & Motion - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #f97316;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #f97316;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #f97316;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(249, 115, 22, 0.1);
      color: #f97316;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(249, 115, 22, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #f97316;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #f97316;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 5: MAPS &amp; MOTION</h1>
    <p class="course-subtitle">Scrolling cameras, responsive controls, Scroll Runner</p>

    <p class="course-description">
      Weeks 1–4 taught you to make the Commodore talk, react, and draw sprites. Week 5 stretches that world across
      unseen space. You will page through memory like a level designer, stream maps from DATA, glide the screen with
      VIC-II fine scroll, and keep action steady with a rock-solid game loop—everything culminating in the Scroll Runner
      mini-game.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">3</div>
        <div class="stat-label">Scrolling Tricks</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Capstone Runner</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>What You'll Explore This Week</h2>

      <p>
        Week 5 is where the C64 stops feeling like a single screen and starts feeling like a world. Each lesson layers a
        new technique for navigating, animating, and pacing bigger environments:
      </p>

      <ul>
        <li><strong>Lesson 33: Paging the Screen</strong> – build a multi-page viewer that acts like a moving camera.</li>
        <li><strong>Lesson 34: Level Design by DATA</strong> – store tile maps in DATA and translate IDs into scenery.</li>
        <li><strong>Lesson 35: Smooth Scrolling</strong> – use VIC-II fine scroll to move a row a pixel at a time.</li>
        <li><strong>Lesson 36: Verticality</strong> – manage two-axis velocity so hovercraft controls feel intentional.</li>
        <li><strong>Lesson 37: Simple AI</strong> – switch drones between patrol and chase with distance checks.</li>
        <li><strong>Lesson 38: Collision Layers</strong> – react differently to walls, collectibles, and hazards.</li>
        <li><strong>Lesson 39: Game Loops Revisited</strong> – pace the action with a fixed-step loop driven by `TI`.</li>
        <li><strong>Lesson 40: Scroll Runner</strong> – stitch it all together in a scrolling tunnel gauntlet.</li>
      </ul>

      <div class="wow-box">
        <strong>Week 5 Goal:</strong> By Lesson 40 you will pilot a hovercraft through a streaming tunnel, collect
        crystals, dodge patrol drones, and win with steady timing. Scroll Runner is the proof that your maps, motion,
        and loop work together.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Weeks 1–4 first. Paging, scrolling, AI, and collisions build directly on
        earlier lessons about arrays, sprites, sound, and input.
      </p>

      <p>
        <strong>How to practise:</strong> Type each listing, run it, then remix it. Change the window size, redraw tiles,
        tune velocities, or add extra drones. The programs are concise on purpose so you can experiment without fear.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-5/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Move the Camera?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Week 5 adds depth to your worlds. Master paging, scrolling, AI, collisions, and timing, then put them into play
        inside Scroll Runner.
      </p>
      <a href="/commodore-64/basic/week-5/lesson-33" class="start-button">
        Start Lesson 33: Paging the Screen
      </a>
    </section>
  </div>
</Layout>
