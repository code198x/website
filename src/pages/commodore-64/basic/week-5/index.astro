---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 33,
    title: "Catch Game",
    description: "Catch falling objects with basket - gravity & scoring",
    status: "available"
  },
  {
    number: 34,
    title: "Maze Navigation",
    description: "Navigate maze with wall collision detection",
    status: "available"
  },
  {
    number: 35,
    title: "Shooting Game",
    description: "Shoot targets with projectile mechanics",
    status: "available"
  },
  {
    number: 36,
    title: "Reaction Time Game",
    description: "Measure reaction speed with timer",
    status: "available"
  },
  {
    number: 37,
    title: "Memory/Pattern Game",
    description: "Simon Says - repeat the sequence",
    status: "available"
  },
  {
    number: 38,
    title: "Simple Platformer Jump",
    description: "Jump between platforms with gravity arc",
    status: "available"
  },
  {
    number: 39,
    title: "Race/Obstacle Course",
    description: "Dodge scrolling obstacles to finish line",
    status: "available"
  },
  {
    number: 40,
    title: "High Score Table",
    description: "Save top 5 scores with player names",
    status: "available"
  }
];
---

<Layout title="Week 5: Complete Mini-Games - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #f97316;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #f97316;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #f97316;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(249, 115, 22, 0.1);
      color: #f97316;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(249, 115, 22, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #f97316;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #f97316;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 5: COMPLETE MINI-GAMES</h1>
    <p class="course-subtitle">8 Playable Games in 20-40 Lines Each</p>

    <p class="course-description">
      Weeks 1-4 taught you the pieces. Week 5 shows you how to combine them into complete, playable games. Each lesson is a fully functional game you can finish in one sitting—from arcade classics to reaction tests to high score tables. This is where your C64 becomes a game machine.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Complete Games</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">20-40</div>
        <div class="stat-label">Lines Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">100%</div>
        <div class="stat-label">Playable</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>What You'll Build This Week</h2>

      <p>
        Week 5 is different. Instead of learning isolated techniques, you'll build 8 complete games from scratch.
        Each lesson gives you a playable game combining everything you've learnt so far:
      </p>

      <ul>
        <li><strong>Lesson 33: Catch Game</strong> - falling objects with gravity, basket movement, and scoring</li>
        <li><strong>Lesson 34: Maze Navigation</strong> - collision detection with walls, grid-based movement</li>
        <li><strong>Lesson 35: Shooting Game</strong> - projectile mechanics, hit detection, target elimination</li>
        <li><strong>Lesson 36: Reaction Time Game</strong> - press key when target appears, measure speed</li>
        <li><strong>Lesson 37: Simon Says</strong> - show pattern, player repeats, memory challenge</li>
        <li><strong>Lesson 38: Platformer Jump</strong> - gravity arc, platform landing, jump physics</li>
        <li><strong>Lesson 39: Obstacle Course</strong> - dodge scrolling obstacles, reach finish line</li>
        <li><strong>Lesson 40: High Score Table</strong> - persistent leaderboard with names and scores</li>
      </ul>

      <div class="wow-box">
        <strong>Week 5 Goal:</strong> By Lesson 40, you'll have 8 complete games in your collection. These aren't
        demos or tech showcases—they're actual playable games with win/lose conditions, scoring, and replay value.
        You can share them with friends or use them as templates for your own ideas.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Weeks 1-4 first! These games use variables, loops, arrays, sprites,
        sound, collision, controls, animation, AI, and lives—everything from previous weeks.
      </p>

      <p>
        <strong>Learning approach:</strong> Type each game, play it, then modify it. Change the speed, add more
        obstacles, adjust scoring, or combine ideas from different lessons. The programs are deliberately short
        (20-40 lines) so you can understand how they work and experiment freely.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-5/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Build Games?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Week 5 transforms you from learning code to creating games. Every lesson is a complete project you can play, share, and build upon. By the end of this week, you'll have a portfolio of 8 working C64 games.
      </p>
      <a href="/commodore-64/basic/week-5/lesson-33" class="start-button">
        Start Lesson 33: Catch Game
      </a>
    </section>
  </div>
</Layout>
