---
import Layout from '../../../../layouts/Layout.astro';

const categories = [
  {
    name: "Sprites",
    icon: "🎮",
    description: "Hardware sprite initialization, movement, collision detection",
    patterns: [
      { title: "Sprite Initialization", url: "/commodore-64/basic/patterns/sprites/sprite-initialization", difficulty: "Beginner" },
      { title: "Sprite Movement", url: "/commodore-64/basic/patterns/sprites/sprite-movement", difficulty: "Beginner" },
      { title: "Sprite Collision", url: "/commodore-64/basic/patterns/sprites/sprite-collision", difficulty: "Intermediate" }
    ]
  },
  {
    name: "Input",
    icon: "🕹️",
    description: "Keyboard and joystick handling for responsive controls",
    patterns: [
      { title: "Keyboard Polling", url: "/commodore-64/basic/patterns/input/keyboard-polling", difficulty: "Beginner" },
      { title: "Joystick Reading", url: "/commodore-64/basic/patterns/input/joystick-reading", difficulty: "Beginner" },
      { title: "Diagonal Movement", url: "/commodore-64/basic/patterns/input/diagonal-movement", difficulty: "Intermediate" }
    ]
  },
  {
    name: "Game Loops",
    icon: "🔄",
    description: "Core game structure and timing",
    patterns: [
      { title: "Basic Game Loop", url: "/commodore-64/basic/patterns/game-loops/basic-game-loop", difficulty: "Beginner" },
      { title: "Input-Update-Draw", url: "/commodore-64/basic/patterns/game-loops/input-update-draw", difficulty: "Intermediate" }
    ]
  },
  {
    name: "State Machines",
    icon: "🎞️",
    description: "Title screens, gameplay modes, game over screens",
    patterns: [
      { title: "Basic State Machine", url: "/commodore-64/basic/patterns/state-machines/basic-state-machine", difficulty: "Intermediate" },
      { title: "State Transitions", url: "/commodore-64/basic/patterns/state-machines/state-transitions", difficulty: "Intermediate" },
      { title: "ON...GOTO Dispatch", url: "/commodore-64/basic/patterns/state-machines/on-goto-dispatch", difficulty: "Intermediate" }
    ]
  },
  {
    name: "HUD",
    icon: "📊",
    description: "Score, lives, timers, and status displays",
    patterns: [
      { title: "Score Display", url: "/commodore-64/basic/patterns/hud/score-display", difficulty: "Beginner" },
      { title: "Lives Display", url: "/commodore-64/basic/patterns/hud/lives-display", difficulty: "Beginner" },
      { title: "Timer Display", url: "/commodore-64/basic/patterns/hud/timer-display", difficulty: "Intermediate" }
    ]
  },
  {
    name: "Menus",
    icon: "📋",
    description: "Menu systems and navigation",
    patterns: [
      { title: "Menu System", url: "/commodore-64/basic/patterns/menus/menu-system", difficulty: "Intermediate" },
      { title: "Keyboard Navigation", url: "/commodore-64/basic/patterns/menus/keyboard-navigation", difficulty: "Intermediate" },
      { title: "Joystick Navigation", url: "/commodore-64/basic/patterns/menus/joystick-navigation", difficulty: "Intermediate" }
    ]
  },
  {
    name: "Sound",
    icon: "🔊",
    description: "SID chip programming for music and effects",
    patterns: [
      { title: "SID Initialization", url: "/commodore-64/basic/patterns/sound/sid-initialization", difficulty: "Intermediate" },
      { title: "Sound Effects", url: "/commodore-64/basic/patterns/sound/sound-effects", difficulty: "Intermediate" },
      { title: "Simple Music", url: "/commodore-64/basic/patterns/sound/simple-music", difficulty: "Advanced" }
    ]
  },
  {
    name: "Data & Levels",
    icon: "📦",
    description: "Level loading and data management",
    patterns: [
      { title: "READ/DATA Pattern", url: "/commodore-64/basic/patterns/data/read-data-pattern", difficulty: "Beginner" },
      { title: "Level Loading", url: "/commodore-64/basic/patterns/data/level-loading", difficulty: "Intermediate" },
      { title: "RESTORE Pattern", url: "/commodore-64/basic/patterns/data/restore-pattern", difficulty: "Intermediate" }
    ]
  },
  {
    name: "Library Structure",
    icon: "📚",
    description: "Reusable code organization",
    patterns: [
      { title: "Library Initialization", url: "/commodore-64/basic/patterns/library/library-initialization", difficulty: "Advanced" },
      { title: "Subroutine Dispatch", url: "/commodore-64/basic/patterns/library/subroutine-dispatch", difficulty: "Advanced" },
      { title: "Parameter Passing", url: "/commodore-64/basic/patterns/library/parameter-passing", difficulty: "Advanced" }
    ]
  },
  {
    name: "Performance",
    icon: "⚡",
    description: "Optimization techniques for smooth gameplay",
    patterns: [
      { title: "Address Tables", url: "/commodore-64/basic/patterns/performance/address-tables", difficulty: "Advanced" },
      { title: "Loop Unrolling", url: "/commodore-64/basic/patterns/performance/loop-unrolling", difficulty: "Advanced" },
      { title: "Timing Measurement", url: "/commodore-64/basic/patterns/performance/timing-measurement", difficulty: "Intermediate" }
    ]
  },
  {
    name: "Error Handling",
    icon: "🛡️",
    description: "Defensive coding and memory management",
    patterns: [
      { title: "Error Handling", url: "/commodore-64/basic/patterns/errors/error-handling", difficulty: "Advanced" },
      { title: "Memory Checking", url: "/commodore-64/basic/patterns/errors/memory-checking", difficulty: "Advanced" }
    ]
  },
  {
    name: "File I/O",
    icon: "💾",
    description: "Disk operations and data persistence",
    patterns: [
      { title: "Save High Scores", url: "/commodore-64/basic/patterns/file-io/save-high-scores", difficulty: "Advanced" },
      { title: "Disk Operations", url: "/commodore-64/basic/patterns/file-io/disk-operations", difficulty: "Advanced" }
    ]
  }
];
---

<Layout title="C64 BASIC Pattern Library">
  <style>
    .pattern-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-16) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
      position: relative;
      overflow: hidden;
    }

    .pattern-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.05) 2px,
          rgba(255, 255, 255, 0.05) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .pattern-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-3);
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.3);
    }

    .pattern-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-8);
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .pattern-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.8;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      list-style: none;
      padding: 0;
      margin: var(--space-6) 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-4);
    }

    .intro-section li {
      display: flex;
      align-items: start;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .intro-section li::before {
      content: '✓';
      color: #4a4dff;
      font-weight: bold;
      flex-shrink: 0;
    }

    .categories-grid {
      display: grid;
      gap: var(--space-8);
      margin-bottom: var(--space-16);
    }

    .category-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      transition: all var(--transition-base);
    }

    .category-card:hover {
      border-color: #4a4dff;
      box-shadow: 0 6px 20px rgba(74, 77, 255, 0.15);
    }

    .category-header {
      display: flex;
      align-items: start;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .category-icon {
      font-size: 3rem;
      flex-shrink: 0;
    }

    .category-info {
      flex: 1;
    }

    .category-name {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: var(--space-2);
    }

    .category-description {
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .patterns-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-3);
    }

    .pattern-link {
      display: block;
      padding: var(--space-4);
      border: 2px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      transition: all var(--transition-base);
      background: var(--color-bg);
    }

    .pattern-link:hover {
      border-color: #4a4dff;
      background: var(--color-surface);
      transform: translateX(4px);
    }

    .pattern-name {
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: var(--space-2);
      font-size: 1rem;
    }

    .pattern-link:hover .pattern-name {
      color: #4a4dff;
    }

    .difficulty-badge {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      font-size: 0.75rem;
      font-weight: 600;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .difficulty-badge.beginner {
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
    }

    .difficulty-badge.intermediate {
      background: rgba(59, 130, 246, 0.1);
      color: #3b82f6;
    }

    .difficulty-badge.advanced {
      background: rgba(168, 85, 247, 0.1);
      color: #a855f7;
    }

    .cta-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
    }

    .cta-section h3 {
      font-size: 1.5rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .cta-section p {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
      line-height: 1.7;
    }

    .cta-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.2);
    }

    .cta-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(74, 77, 255, 0.3);
    }

    @media (max-width: 768px) {
      .patterns-grid {
        grid-template-columns: 1fr;
      }

      .pattern-stats {
        gap: var(--space-6);
      }

      .stat-value {
        font-size: 2rem;
      }
    }
  </style>

  <!-- Hero Section -->
  <section class="pattern-hero">
    <div class="hero-content">
      <h1 class="pattern-title">C64 BASIC PATTERN LIBRARY</h1>
      <p class="pattern-subtitle">
        33 battle-tested patterns extracted from 64 validated lessons. Copy-paste ready code for authentic retro game development.
      </p>

      <div class="pattern-stats">
        <div class="stat-item">
          <div class="stat-value">33</div>
          <div class="stat-label">Patterns</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">200+</div>
          <div class="stat-label">Variations</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">15K+</div>
          <div class="stat-label">Lines of Code</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="content-container">
    <!-- Introduction -->
    <section class="intro-section">
      <h2>About This Library</h2>
      <p>
        Every pattern in this library has been extracted from working game code in the
        <a href="/commodore-64/basic" style="color: #4a4dff; text-decoration: underline;">C64 BASIC course</a>.
        Each pattern includes multiple code variations, common mistakes and fixes, complete integration examples,
        and cross-references to related patterns and lessons.
      </p>

      <ul>
        <li>Validated C64 BASIC V2 syntax from real hardware</li>
        <li>5-6 variations per pattern for different needs</li>
        <li>Complete integration examples you can run</li>
        <li>Memory maps and register documentation</li>
        <li>Common mistakes and how to fix them</li>
        <li>Cross-references to lessons and related patterns</li>
      </ul>
    </section>

    <!-- Pattern Categories -->
    <section class="categories-grid">
      {categories.map(category => (
        <div class="category-card">
          <div class="category-header">
            <span class="category-icon">{category.icon}</span>
            <div class="category-info">
              <h3 class="category-name">{category.name}</h3>
              <p class="category-description">{category.description}</p>
            </div>
          </div>
          <div class="patterns-grid">
            {category.patterns.map(pattern => (
              <a href={pattern.url} class="pattern-link">
                <div class="pattern-name">{pattern.title}</div>
                <span class={`difficulty-badge ${pattern.difficulty.toLowerCase()}`}>
                  {pattern.difficulty}
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <h3>Ready to Build Retro Games?</h3>
      <p>
        These patterns give you everything you need to create authentic C64 BASIC games.
        Start with the beginner patterns, work your way up to advanced optimization, and
        build the retro game of your dreams.
      </p>
      <a href="/commodore-64/basic/week-1" class="cta-button">
        Start Learning C64 BASIC →
      </a>
    </section>
  </div>
</Layout>
