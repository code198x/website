---
import Layout from '../../../layouts/Layout.astro';

const weeks = [
  {
    number: 1,
    title: "BASIC Fundamentals",
    description: "PRINT, screen control, loops, colours, variables, keyboard input, conditional logic",
    lessonCount: 8,
    duration: "2 hours",
    status: "available",
    url: "/commodore-64/basic/week-1"
  },
  {
    number: 2,
    title: "Structured Programming",
    description: "Arrays, subroutines, strings, DATA statements, nested loops, functions, state machines",
    lessonCount: 8,
    duration: "2 hours",
    status: "available",
    url: "/commodore-64/basic/week-2"
  },
  {
    number: 3,
    title: "Graphics & Sound",
    description: "Screen memory, color memory, PETSCII art, sprite basics, movement, SID sound, collision",
    lessonCount: 8,
    duration: "2 hours",
    status: "coming-soon",
    url: "#"
  },
  {
    number: 4,
    title: "Building Game Elements",
    description: "Keyboard input, sprite animation, score display, timers, random events, AI, lives system",
    lessonCount: 8,
    duration: "2 hours",
    status: "coming-soon",
    url: "#"
  },
  {
    number: 5,
    title: "Complete Mini-Games",
    description: "Catch game, maze navigation, shooting, reaction time, memory game, platformer, race, high scores",
    lessonCount: 8,
    duration: "2 hours",
    status: "coming-soon",
    url: "#"
  },
  {
    number: 6,
    title: "Advanced Techniques",
    description: "Smooth scrolling, multi-sprite patterns, custom characters, SID effects, transitions, disk I/O",
    lessonCount: 8,
    duration: "2 hours",
    status: "coming-soon",
    url: "#"
  },
  {
    number: 7,
    title: "Polish & Features",
    description: "Title screens, menus, game states, difficulty levels, power-ups, boss fights, demo mode",
    lessonCount: 8,
    duration: "2 hours",
    status: "coming-soon",
    url: "#"
  },
  {
    number: 8,
    title: "Complete Projects",
    description: "Text adventure, puzzle game, arcade action, strategy, quiz, sports, rhythm, BASIC ceiling",
    lessonCount: 8,
    duration: "3 hours",
    status: "coming-soon",
    url: "#"
  }
];
---

<Layout title="Commodore 64 BASIC - Complete Course">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-16) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
      position: relative;
      overflow: hidden;
    }

    .course-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.05) 2px,
          rgba(255, 255, 255, 0.05) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-3);
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.5rem;
      opacity: 0.95;
      margin-bottom: var(--space-8);
    }

    .course-description {
      max-width: 800px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.8;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-8);
      color: var(--color-text);
      text-align: center;
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.8;
      margin-bottom: var(--space-4);
    }

    .intro-section strong {
      color: var(--color-text);
    }

    .weeks-grid {
      display: grid;
      gap: var(--space-6);
      margin-bottom: var(--space-16);
    }

    .week-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .week-card.available:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 6px 20px rgba(74, 77, 255, 0.15);
    }

    .week-card.coming-soon {
      opacity: 0.6;
      cursor: default;
    }

    .week-number-badge {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      flex-shrink: 0;
    }

    .week-card.coming-soon .week-number-badge {
      background: linear-gradient(135deg, #666 0%, #888 100%);
    }

    .week-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.9;
    }

    .week-number {
      font-size: 2rem;
      font-weight: bold;
      line-height: 1;
    }

    .week-content {
      flex: 1;
    }

    .week-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .week-description {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: var(--space-3);
    }

    .week-meta {
      display: flex;
      gap: var(--space-4);
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      flex-wrap: wrap;
    }

    .week-meta-item {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .week-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 600;
      padding: var(--space-3) var(--space-4);
      border-radius: 9999px;
      white-space: nowrap;
    }

    .week-status.available {
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .week-status.coming-soon {
      background: rgba(0, 0, 0, 0.05);
      color: var(--color-text-secondary);
    }

    .journey-section {
      background: var(--color-bg);
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .journey-section h2 {
      text-align: center;
      margin-bottom: var(--space-6);
    }

    .journey-steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-6);
    }

    .journey-step {
      text-align: center;
      padding: var(--space-4);
    }

    .step-icon {
      font-size: 3rem;
      margin-bottom: var(--space-3);
    }

    .step-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: var(--space-2);
    }

    .step-description {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.25rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.2);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(74, 77, 255, 0.3);
    }

    @media (max-width: 768px) {
      .week-card {
        grid-template-columns: 1fr;
        text-align: center;
        gap: var(--space-4);
      }

      .week-number-badge {
        margin: 0 auto;
      }

      .week-meta {
        justify-content: center;
      }

      .week-status {
        margin: 0 auto;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <div class="hero-content">
      <h1 class="course-title">COMMODORE 64 BASIC</h1>
      <p class="course-subtitle">From "Hello, C64!" to Complete Games</p>

      <p class="course-description">
        Learn to program the Commodore 64 using BASIC V2. This complete 64-lesson course
        takes you from absolute beginner to building sophisticated games with graphics,
        sound, and sprite animation. Every lesson is hands-on, practical, and ends with
        a working program you can actually run on real hardware or emulator.
      </p>

      <div class="course-stats">
        <div class="stat-item">
          <div class="stat-value">64</div>
          <div class="stat-label">Lessons</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">8</div>
          <div class="stat-label">Weeks</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">0</div>
          <div class="stat-label">Prerequisites</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">∞</div>
          <div class="stat-label">Fun</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>Why Learn C64 BASIC in 2025?</h2>

      <p>
        The Commodore 64 was designed to be programmed. Turn it on and you're greeted with
        "READY." — the computer is literally waiting for your instructions. BASIC V2 might be
        40+ years old, but it teaches fundamental programming concepts better than many modern
        languages because you <strong>see results immediately</strong> and have
        <strong>complete control</strong> over the hardware.
      </p>

      <p>
        This isn't a history lesson—it's a programming course that happens to use a system where
        you can't hide behind frameworks and abstractions. You'll learn loops, conditionals,
        variables, arrays, functions, and data structures. You'll manipulate memory directly,
        control hardware, and understand what's actually happening when your code runs.
      </p>

      <p>
        <strong>By Week 8, you'll have built a complete game from scratch.</strong> Not a tutorial
        that you follow blindly, but a real program that you understand completely, can modify,
        and can show off.
      </p>
    </section>

    <!-- Learning Journey -->
    <section class="journey-section">
      <h2 class="section-title">Your Learning Journey</h2>

      <div class="journey-steps">
        <div class="journey-step">
          <div class="step-icon">💻</div>
          <h3 class="step-title">Week 1: Fundamentals</h3>
          <p class="step-description">
            PRINT, loops, colours, variables, keyboard input, IF/THEN.
            Build a number guessing game.
          </p>
        </div>

        <div class="journey-step">
          <div class="step-icon">🔁</div>
          <h3 class="step-title">Weeks 2-3: Structure</h3>
          <p class="step-description">
            FOR loops, arrays, strings, sound basics, data storage.
            Build animation and interactive programs.
          </p>
        </div>

        <div class="journey-step">
          <div class="step-icon">🎮</div>
          <h3 class="step-title">Weeks 4-5: Graphics</h3>
          <p class="step-description">
            Character graphics, sprites, collision detection, SID chip music.
            Build arcade-style games.
          </p>
        </div>

        <div class="journey-step">
          <div class="step-icon">🚀</div>
          <h3 class="step-title">Weeks 6-8: Mastery</h3>
          <p class="step-description">
            Disk I/O, game architecture, complete project.
            Build Skyfall—a polished, distributable game.
          </p>
        </div>
      </div>
    </section>

    <!-- Weeks List -->
    <section>
      <h2 class="section-title">Course Curriculum</h2>

      <div class="weeks-grid">
        {weeks.map(week => (
          week.status === 'available' ? (
            <a href={week.url} class="week-card available">
              <div class="week-number-badge">
                <div class="week-label">Week</div>
                <div class="week-number">{week.number}</div>
              </div>
              <div class="week-content">
                <h3 class="week-title">{week.title}</h3>
                <p class="week-description">{week.description}</p>
                <div class="week-meta">
                  <span class="week-meta-item">📚 {week.lessonCount} lessons</span>
                  <span class="week-meta-item">⏱️ {week.duration}</span>
                </div>
              </div>
              <div class="week-status available">Start Week →</div>
            </a>
          ) : (
            <div class="week-card coming-soon">
              <div class="week-number-badge">
                <div class="week-label">Week</div>
                <div class="week-number">{week.number}</div>
              </div>
              <div class="week-content">
                <h3 class="week-title">{week.title}</h3>
                <p class="week-description">{week.description}</p>
                <div class="week-meta">
                  <span class="week-meta-item">📚 {week.lessonCount} lessons</span>
                  <span class="week-meta-item">⏱️ {week.duration}</span>
                </div>
              </div>
              <div class="week-status coming-soon">Coming Soon</div>
            </div>
          )
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Code Like It's 1982?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 700px; margin-left: auto; margin-right: auto; font-size: 1.125rem; line-height: 1.7;">
        Turn on your Commodore 64 (or fire up VICE emulator), see that friendly "READY." prompt,
        and let's start programming. No installation, no configuration, no package managers—just
        you, the computer, and the joy of making something work.
      </p>
      <a href="/commodore-64/basic/week-1" class="start-button">
        Begin Week 1: BASIC Fundamentals
      </a>
    </section>
  </div>
</Layout>