---
import Layout from '../../../layouts/Layout.astro';
import SystemHero from '../../../components/SystemHero.astro';
import TrackGames from '../../../components/TrackGames.astro';
import { getModulesWithAvailability } from '../../../lib/modules';

const platformColor = '#4a4dff';
const games = await getModulesWithAvailability('commodore-64', 'basic');

const specs = [
  { label: 'CPU', value: 'MOS 6510' },
  { label: 'RAM', value: '64 KB' },
  { label: 'Language', value: 'BASIC V2' },
];
---

<Layout
  title="Commodore 64 BASIC – Learn Programming Through Games"
  description="Learn C64 BASIC V2 by building complete games. A gateway curriculum preparing you for 6510 assembly."
  platformColor={platformColor}
>
  <SystemHero
    title="Commodore 64 BASIC"
    subtitle="Learn programming fundamentals before assembly"
    kicker="C64 · BASIC V2 · gateway"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Build complete games while you learn the fundamentals — variables, loops, and the C64's screen and memory. Start with Game 1 and work through in order.</p>
      <TrackGames games={games} platform="commodore-64" track="basic" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <div class="next-step">
        <h3>After BASIC</h3>
        <p>Complete these 8 games and you'll understand C64 memory layout, screen handling, and the limits of BASIC. Then move to <a href="/commodore-64/assembly">6510 assembly</a> to unlock the full power of the machine.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .next-step { background: var(--color-surface); border: 3px solid var(--platform-color); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .next-step h3 { color: var(--platform-color); margin: 0 0 var(--space-2); font-size: 1.2rem; }
  .next-step p { margin: 0; color: var(--color-text-secondary); }
  .next-step a { color: var(--platform-color); font-weight: 700; }
</style>
