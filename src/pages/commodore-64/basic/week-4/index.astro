---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 25,
    title: "Keyboard Input for Movement",
    description: "Control sprites with WASD keyboard controls",
    status: "available"
  },
  {
    number: 26,
    title: "Sprite Animation",
    description: "Create walking animation with 2-frame flipping",
    status: "available"
  },
  {
    number: 27,
    title: "Score Display",
    description: "Track and display score on screen",
    status: "available"
  },
  {
    number: 28,
    title: "Timer Countdown",
    description: "Race against the clock with time-limited gameplay",
    status: "available"
  },
  {
    number: 29,
    title: "Random Events",
    description: "Spawn items at unpredictable positions",
    status: "available"
  },
  {
    number: 30,
    title: "Simple Enemy AI",
    description: "Create enemy that chases the player",
    status: "available"
  },
  {
    number: 31,
    title: "Boundaries & Wrapping",
    description: "Pac-Man style screen edge wrapping",
    status: "available"
  },
  {
    number: 32,
    title: "Health/Lives System",
    description: "3-life system with game over state",
    status: "available"
  }
];
---

<Layout title="Week 4: Building Game Elements - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #10b981;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #10b981;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #10b981;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #10b981;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #10b981;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 4: BUILDING GAME ELEMENTS</h1>
    <p class="course-subtitle">Keyboard Controls, Animation, Scoring & AI</p>

    <p class="course-description">
      Now you've got the pieces—sprites, sound, collision detection. Week 4 teaches you to combine them into actual game mechanics: responsive controls, animated characters, scoring systems, enemies that chase you, and lives that matter. These are the building blocks of every C64 game you've ever played.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">15-20</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">100%</div>
        <div class="stat-label">Game Ready</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>What You'll Learn This Week</h2>

      <p>
        Week 4 bridges the gap between understanding hardware and building actual games. By the end of these 8 lessons,
        you'll know how to:
      </p>

      <ul>
        <li><strong>Keyboard input handling</strong> for smooth 4-direction sprite movement with GET K$</li>
        <li><strong>Sprite animation</strong> by flipping between 2 frames to create walking effects</li>
        <li><strong>Score display and updates</strong> for tracking player progress and achievements</li>
        <li><strong>Timer-based gameplay</strong> using the TI variable for countdown challenges</li>
        <li><strong>Random spawning</strong> with RND to create unpredictable item placement</li>
        <li><strong>Basic enemy AI</strong> that tracks and chases the player's position</li>
        <li><strong>Screen wrapping</strong> for Pac-Man style edge behaviour</li>
        <li><strong>Lives and game over</strong> managing player state and end conditions</li>
      </ul>

      <div class="wow-box">
        <strong>Week 4 Goal:</strong> By Lesson 32, you'll have a complete player-enemy-score system
        with lives, timer, and game over state—all the core mechanics needed for Week 5's complete games.
        Every mechanic you learn here appears in professional C64 titles.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Weeks 1-3 first! These lessons combine variables, loops,
        sprites, sound, and collision detection from previous weeks.
      </p>

      <p>
        <strong>Learning approach:</strong> Each lesson adds ONE game mechanic in isolation. You'll see how
        classics like Pac-Man, Space Invaders, and Jet Set Willy used these exact techniques. Type the short
        examples (20-40 lines), modify values, and feel how responsive controls make games fun to play.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-4/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Ready to build game mechanics? Week 4 takes you from hardware control to game design. You'll learn the techniques that make C64 games responsive, challenging, and fun to play.
      </p>
      <a href="/commodore-64/basic/week-4/lesson-25" class="start-button">
        Start Lesson 25: Keyboard Input
      </a>
    </section>
  </div>
</Layout>
