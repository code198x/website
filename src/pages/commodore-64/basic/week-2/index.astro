---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 9,
    title: "Arrays: Organizing Data",
    description: "Store multiple related values in a single structure",
    status: "available"
  },
  {
    number: 10,
    title: "Subroutines with GOSUB",
    description: "Reusable code blocks that you can call from anywhere",
    status: "available"
  },
  {
    number: 11,
    title: "String Manipulation",
    description: "Working with text using LEFT$, RIGHT$, and MID$",
    status: "available"
  },
  {
    number: 12,
    title: "DATA Statements & READ",
    description: "Store and retrieve large amounts of data efficiently",
    status: "available"
  },
  {
    number: 13,
    title: "PEEK & POKE for Graphics",
    description: "Direct memory access to draw on screen and read pixels",
    status: "available"
  },
  {
    number: 14,
    title: "Nested Loops",
    description: "Loops inside loops for grids, patterns, and game boards",
    status: "available"
  },
  {
    number: 15,
    title: "Simple Functions (FN)",
    description: "Create reusable calculations with DEF FN",
    status: "available"
  },
  {
    number: 16,
    title: "ON/GOTO for State Machines",
    description: "Game flow control with multi-way branching",
    status: "available"
  }
];
---

<Layout title="Week 2: Structured Programming - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #4a4dff;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(74, 77, 255, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #4a4dff;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #4a4dff;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 2: STRUCTURED PROGRAMMING</h1>
    <p class="course-subtitle">Arrays, Subroutines, and Game Architecture</p>

    <p class="course-description">
      Building on Week 1, these 8 lessons introduce structured programming concepts. Learn to organize data with arrays, create reusable code with subroutines, manipulate text for adventure games, and control game flow with state machines. By the end, you'll understand the architecture behind professional C64 games.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">10-15</div>
        <div class="stat-label">Minutes Each</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">1</div>
        <div class="stat-label">Complete Game</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>What You'll Learn This Week</h2>

      <p>
        Week 2 teaches you to structure programs like a professional. By the end of these 8 lessons,
        you'll understand how to:
      </p>

      <ul>
        <li><strong>Organize data</strong> with arrays to manage multiple related values</li>
        <li><strong>Create reusable code</strong> with GOSUB subroutines and RETURN</li>
        <li><strong>Manipulate text</strong> using LEFT$, RIGHT$, MID$ for text adventures</li>
        <li><strong>Store game data</strong> efficiently with DATA and READ statements</li>
        <li><strong>Draw graphics</strong> directly with PEEK and POKE to screen memory</li>
        <li><strong>Generate patterns</strong> using nested FOR loops</li>
        <li><strong>Define functions</strong> with DEF FN for reusable calculations</li>
        <li><strong>Control game flow</strong> with ON/GOTO state machines</li>
      </ul>

      <div class="wow-box">
        <strong>Week 2 Goal:</strong> By Lesson 16, you'll have created a complete state machine-driven game
        that cycles through title screen, gameplay, and game over states—the same structure used in every
        professional C64 game.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Week 1 first! These lessons build on PRINT, variables,
        loops, and IF/THEN from the fundamentals week.
      </p>

      <p>
        <strong>Learning approach:</strong> Each lesson adds one new concept to your programming toolkit.
        Type in the examples, experiment with modifications, and watch your programs become more sophisticated.
        Every lesson ends with a "wow moment" that shows what's now possible with your growing skills.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-2/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Start?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Ready to level up your C64 programming? Week 2 takes you from basics to structured programming. You'll learn the techniques that professional game developers use to build complex, maintainable programs.
      </p>
      <a href="/commodore-64/basic/week-2/lesson-09" class="start-button">
        Start Lesson 9: Arrays
      </a>
    </section>
  </div>
</Layout>