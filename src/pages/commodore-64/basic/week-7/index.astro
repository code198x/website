---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 49,
    title: "Title Screen with Animation",
    description: "Animated title with bouncing logo",
    status: "available"
  },
  {
    number: 50,
    title: "Menu System",
    description: "Navigate options with cursor",
    status: "available"
  },
  {
    number: 51,
    title: "Game States",
    description: "Complete flow from title to game over",
    status: "available"
  },
  {
    number: 52,
    title: "Difficulty Levels",
    description: "Choose easy/normal/hard",
    status: "available"
  },
  {
    number: 53,
    title: "Power-Ups & Collectibles",
    description: "Temporary invincibility pickup",
    status: "available"
  },
  {
    number: 54,
    title: "Boss Fight Basics",
    description: "Enemy with health bar, attack patterns",
    status: "available"
  },
  {
    number: 55,
    title: "Attract Mode/Demo",
    description: "AI plays the game automatically",
    status: "available"
  },
  {
    number: 56,
    title: "Instructions Screen",
    description: "Show controls and rules before playing",
    status: "available"
  }
];
---

<Layout title="Week 7: Polish & Features - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: bold;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #ec4899;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #ec4899;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #ec4899;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(236, 72, 153, 0.1);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-content {
      flex: 1;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
      color: var(--color-text);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(236, 72, 153, 0.1);
      color: #ec4899;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(236, 72, 153, 0.3);
    }

    .wow-box {
      background: var(--color-bg);
      border-left: 4px solid #ec4899;
      padding: var(--space-4);
      margin: var(--space-6) 0;
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .wow-box strong {
      color: #ec4899;
      font-family: var(--font-family-mono);
    }

    @media (max-width: 768px) {
      .lesson-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .lesson-number {
        margin: 0 auto;
      }

      .lesson-status {
        justify-self: center;
      }
    }
  </style>

  <!-- Course Hero -->
  <section class="course-hero">
    <h1 class="course-title">WEEK 7: POLISH & FEATURES</h1>
    <p class="course-subtitle">Professional Game Elements</p>

    <p class="course-description">
      You've built games. Now make them professional. Week 7 adds the polish and features that transform simple games into complete experiences—animated title screens, menu systems, game states, difficulty levels, power-ups, boss fights, attract modes, and instruction screens. These are the finishing touches that define quality C64 titles.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Polish Features</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">Pro</div>
        <div class="stat-label">Level Quality</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">100%</div>
        <div class="stat-label">Complete</div>
      </div>
    </div>
  </section>

  <!-- Course Introduction -->
  <div class="content-container">
    <section class="intro-section">
      <h2>What You'll Add This Week</h2>

      <p>
        Week 7 focuses on the features that make games feel finished and professional. Every commercial C64 title included these elements—now you'll learn how to build them:
      </p>

      <ul>
        <li><strong>Animated title screen</strong> with bouncing logo and attract mode</li>
        <li><strong>Menu system</strong> with cursor navigation and option selection</li>
        <li><strong>Game states</strong> managing title/play/game over flow</li>
        <li><strong>Difficulty levels</strong> with speed multipliers and enemy scaling</li>
        <li><strong>Power-ups & collectibles</strong> temporary effects with visual feedback</li>
        <li><strong>Boss fight basics</strong> enemies with health bars and attack patterns</li>
        <li><strong>Attract mode/demo</strong> AI or scripted gameplay demonstration</li>
        <li><strong>Instructions screen</strong> multi-page controls and rules explanation</li>
      </ul>

      <div class="wow-box">
        <strong>Week 7 Goal:</strong> By Lesson 56, your games will have professional presentation. Players will see polished title screens, choose difficulty, collect power-ups, face bosses, and understand controls—all the features that made C64 games memorable.
      </div>

      <p>
        <strong>Prerequisites:</strong> Complete Weeks 1-6 first! These polish features build on complete games and advanced techniques from previous weeks.
      </p>

      <p>
        <strong>Learning approach:</strong> Each lesson adds ONE feature to your game toolkit. See the basic version, then the WOW moment showing how commercial games used it. These are the final pieces that separate hobby projects from professional titles.
      </p>
    </section>

    <!-- Lessons List -->
    <section>
      <h2 class="section-title">Lessons</h2>

      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-7/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Add Professional Polish?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        Week 7 transforms simple games into polished experiences. Learn the features that define professional C64 titles—from animated logos to boss battles. This is where games become complete.
      </p>
      <a href="/commodore-64/basic/week-7/lesson-49" class="start-button">
        Start Lesson 49: Title Screen Animation
      </a>
    </section>
  </div>
</Layout>
