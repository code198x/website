---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 49,
    title: "Libraries in BASIC",
    description: "Build a reusable toolkit of drawing and sound routines.",
    status: "available"
  },
  {
    number: 50,
    title: "Title Screens",
    description: "Animate attract-mode banners while waiting for start.",
    status: "available"
  },
  {
    number: 51,
    title: "Menus & Options",
    description: "Navigate choices with keyboard or joystick dispatch.",
    status: "available"
  },
  {
    number: 52,
    title: "Multiple Levels",
    description: "Load stages from structured DATA blocks on demand.",
    status: "available"
  },
  {
    number: 53,
    title: "Cutscenes in BASIC",
    description: "Script story beats with timed, skippable dialogue.",
    status: "available"
  },
  {
    number: 54,
    title: "Debugging Retro-Style",
    description: "Trace variables, pause loops, and build a debug HUD.",
    status: "available"
  },
  {
    number: 55,
    title: "Optimising for Speed",
    description: "Measure and precompute to keep BASIC loops responsive.",
    status: "available"
  },
  {
    number: 56,
    title: "Galactic Miner",
    description: "Mini-game weaving states, AI, cutscenes, and scores.",
    status: "available"
  }
];
---

<Layout title="Week 7: Under the Hood - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 720px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .content-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .intro-section {
      background: var(--color-surface);
      border: 2px solid #ec4899;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-12);
    }

    .intro-section h2 {
      color: #ec4899;
      margin-bottom: var(--space-4);
      font-size: 1.5rem;
    }

    .intro-section p,
    .intro-section ul {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .intro-section ul {
      padding-left: var(--space-6);
    }

    .intro-section li {
      margin-bottom: var(--space-2);
    }

    .lessons-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-12);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      align-items: center;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .lesson-card:hover {
      border-color: #ec4899;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(236, 72, 153, 0.12);
    }

    .lesson-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
    }

    .lesson-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .lesson-status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.875rem;
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: 9999px;
      background: rgba(236, 72, 153, 0.12);
      color: #ec4899;
    }

    .start-button {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
      color: white;
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .start-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(236, 72, 153, 0.3);
    }
  </style>

  <section class="course-hero">
    <h1 class="course-title">WEEK 7: UNDER THE HOOD</h1>
    <p class="course-subtitle">Libraries, menus, cutscenes, debugging, Galactic Miner</p>
    <p class="course-description">
      Week 7 shows what happens behind the scenes. You’ll stash reusable routines in libraries, dress the game with
      animated title screens and menus, load any level on demand, weave story cutscenes, debug like it’s 1987, squeeze
      more speed from BASIC, and finish with <em>Galactic Miner</em>—a mini-game that feels like a full production.
    </p>
  </section>

  <div class="content-container">
    <section class="intro-section">
      <h2>What You’ll Explore</h2>
      <ul>
        <li><strong>Lesson 49:</strong> Package drawing and sound helpers into a callable library.</li>
        <li><strong>Lesson 50:</strong> Animate an attract-mode title while waiting for player input.</li>
        <li><strong>Lesson 51:</strong> Build a responsive options menu with keyboard and joystick support.</li>
        <li><strong>Lesson 52:</strong> Load multi-level maps from structured DATA blocks.</li>
        <li><strong>Lesson 53:</strong> Deliver timed, skippable cutscenes between stages.</li>
        <li><strong>Lesson 54:</strong> Instrument your loop with trace toggles and pause/step debugging.</li>
        <li><strong>Lesson 55:</strong> Optimise hot loops with timers, caching, and precomputed tables.</li>
        <li><strong>Lesson 56:</strong> Ship <em>Galactic Miner</em>, combining every tool from Weeks 5–7.</li>
      </ul>
    </section>

    <section>
      <h2 class="section-title">Lessons</h2>
      <div class="lessons-grid">
        {lessons.map(lesson => (
          <a href={`/commodore-64/basic/week-7/lesson-${String(lesson.number).padStart(2, '0')}`}
             class="lesson-card">
            <div class="lesson-number">{lesson.number}</div>
            <div class="lesson-content">
              <h3 class="lesson-title">{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
            </div>
            <div class="lesson-status">Start →</div>
          </a>
        ))}
      </div>
    </section>

    <section style="text-align: center; margin: var(--space-16) 0;">
      <h2 class="section-title">Ready to Look Under the Hood?</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        These lessons turn your BASIC projects into polished experiences—organised code, slick presentation, smarter
        systems, and a finale that remembers the player.
      </p>
      <a href="/commodore-64/basic/week-7/lesson-49" class="start-button">Start Lesson 49: Libraries in BASIC</a>
    </section>
  </div>
</Layout>
