---
import Layout from '../../../layouts/Layout.astro';
import SystemHero from '../../../components/SystemHero.astro';
import TrackGames from '../../../components/TrackGames.astro';
import FeatureGrid from '../../../components/FeatureGrid.astro';
import { getModulesWithAvailability } from '../../../lib/modules';

const platformColor = '#4a4dff';
const games = await getModulesWithAvailability('commodore-64', 'assembly');

const specs = [
  { label: 'CPU', value: 'MOS 6510' },
  { label: 'Speed', value: '1 MHz' },
  { label: 'RAM', value: '64 KB' },
  { label: 'Graphics', value: 'VIC-II' },
  { label: 'Sound', value: 'SID' },
];

const features = [
  { title: 'VIC-II graphics', description: 'Sprites, character graphics, smooth scrolling, raster interrupts, and the tricks that made C64 games look impossible.' },
  { title: 'SID sound', description: "Three voices, filters, ADSR envelopes, and the techniques that created the C64's legendary sound." },
  { title: '6510 assembly', description: 'The full instruction set, addressing modes, and optimisation tricks that squeeze every cycle from the CPU.' },
  { title: 'Game architecture', description: 'State machines, collision systems, input handling, and the patterns that make games feel right.' },
];
---

<Layout
  title="Commodore 64 – Learn Assembly Through Games"
  description="Learn Commodore 64 assembly by building complete games. Master the VIC-II, SID chip, and 6510 CPU through hands-on projects."
  platformColor={platformColor}
>
  <SystemHero
    title="Commodore 64 assembly"
    subtitle="Learn the machine by building games on it"
    kicker="C64 · Assembly · 6510"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <div class="track-page" style={`--platform-color: ${platformColor};`}>
    <section class="content-section">
      <h2 class="section-title">Before you begin</h2>
      <p class="section-intro">You'll need an emulator and an assembler. Both are free and take five minutes to install.</p>
      <a href="/commodore-64/getting-started" class="btn btn-secondary">Set up your tools →</a>
    </section>

    <section class="content-section">
      <h2 class="section-title">Games</h2>
      <p class="section-intro">Each game teaches new skills while building something you'll want to play. Start with Game 1 and work through in order — each builds on what came before.</p>
      <TrackGames games={games} platform="commodore-64" track="assembly" platformColor={platformColor} />
    </section>

    <section class="content-section">
      <h2 class="section-title">What you'll master</h2>
      <p class="section-intro">By the time you've built all the games, you'll have deep knowledge of C64 hardware and assembly programming.</p>
      <FeatureGrid features={features} platformColor={platformColor} />
    </section>

    <section class="content-section center">
      <h2 class="section-title">Ready to start?</h2>
      <p class="section-intro">Game 1 starts with a ship on screen. By Unit 2, you're moving it with the joystick. By Unit 16, you've got a complete shooter.</p>
      <a href="/commodore-64/assembly/game-01-starfield/unit-01" class="btn btn-primary">Start Game 1: Starfield →</a>
    </section>
  </div>
</Layout>

<style>
  .content-section { padding: var(--space-12) var(--space-6); max-width: 1000px; margin: 0 auto; }
  .section-title { font-size: 1.9rem; font-weight: 800; margin-bottom: var(--space-2); }
  .section-title::after { content: ""; display: block; width: 52px; height: 4px; background: var(--platform-color, var(--color-house-2)); margin: var(--space-3) 0 0; }
  .section-intro { color: var(--color-text-secondary); margin-bottom: var(--space-8); max-width: 700px; }
  .content-section.center { text-align: center; }
  .content-section.center .section-intro { margin-left: auto; margin-right: auto; }
  .content-section.center .section-title::after { margin-left: auto; margin-right: auto; }
</style>
