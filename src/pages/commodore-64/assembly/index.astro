---
import Layout from '../../../layouts/Layout.astro';

const weeks = [
  {
    slug: 'week-1',
    title: 'Act I – Speaking in Bytes',
    summary: 'Convert Scroll Runner to pure assembly. Build a deterministic main loop, input system, renderer, and master zero-page orchestration. Start coding immediately after BASIC!',
    status: 'available',
    cta: 'Start Act I',
  },
  {
    slug: 'week-2',
    title: 'Act II – Controlling Energy',
    summary: 'Drive sprites, raster interrupts, and SID routines with precise timing and hardware control.',
    status: 'coming',
    cta: 'Coming Soon',
  },
  {
    slug: 'week-3',
    title: 'Act III – Building Systems',
    summary: 'Engineer full game loops, asset streaming, and state machines entirely in 6502.',
    status: 'coming',
    cta: 'Coming Soon',
  },
  {
    slug: 'week-4',
    title: 'Act IV – Craft of Creation',
    summary: 'Optimise, polish, and release the finished arcade experience with IRQ-driven effects and sound.',
    status: 'coming',
    cta: 'Coming Soon',
  },
];
---

<Layout title="C64 Assembly Programming – Talking to the Metal">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-16) var(--space-4);
      text-align: center;
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .hero-subtitle {
      font-size: 1.5rem;
      opacity: 0.95;
      max-width: 700px;
      margin: 0 auto;
    }

    .content-section {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: var(--space-12) var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .week-card {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-6);
    }

    .week-card.coming {
      border-color: rgba(74, 77, 255, 0.35);
      opacity: 0.85;
    }

    .week-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-4);
    }

    .week-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .week-status {
      background: #22c55e;
      color: white;
      padding: var(--space-1) var(--space-3);
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .week-status.coming-soon {
      background: rgba(0, 0, 0, 0.08);
      color: var(--color-text-secondary);
    }

    .week-description {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .week-button {
      display: inline-block;
      background: #4a4dff;
      color: white;
      padding: var(--space-3) var(--space-6);
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      transition: all var(--transition-base);
    }

    .week-button:hover {
      background: #3b3ecc;
      transform: translateY(-2px);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }
  </style>

  <!-- Hero -->
  <section class="course-hero">
    <h1 class="hero-title">C64 Assembly Programming</h1>
    <p class="hero-subtitle">
      Talk directly to the 6510. Four Acts guide you from BASIC graduate to professional 6502 programmer.
    </p>
  </section>

  <section class="content-section">
    <a href="/commodore-64" class="back-link">
      ← Back to Commodore 64
    </a>

    <h2 class="section-title">Course Roadmap</h2>

    <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 820px;">
      The assembly track builds directly on the BASIC course. Complete all 8 BASIC weeks first, then dive straight into Act I.
      Lesson 1 covers toolchain setup and essential assembly concepts—no transition course needed!
      Four Acts take you from BASIC graduate to shipping a fully polished arcade game in pure 6502 assembly.
    </p>

    {weeks.map(week => (
      <div class={`week-card ${week.status === 'available' ? '' : 'coming'}`}>
        <div class="week-header">
          <h3 class="week-title">{week.title}</h3>
          <span class={`week-status ${week.status === 'available' ? 'available' : 'coming-soon'}`}>
            {week.status === 'available' ? 'Available Now' : 'In Development'}
          </span>
        </div>
        <p class="week-description">{week.summary}</p>
        {week.status === 'available' ? (
          <a href={`/commodore-64/assembly/${week.slug}`} class="week-button">
            {week.cta} →
          </a>
        ) : (
          <div class="week-button" style="background: rgba(0,0,0,0.05); color: var(--color-text-secondary); cursor: default;">
            {week.cta}
          </div>
        )}
      </div>
    ))}
  </section>
</Layout>
