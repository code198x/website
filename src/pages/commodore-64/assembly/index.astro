---
import Layout from '../../../layouts/Layout.astro';

// Game catalogue - 16 assembly games
const games = [
  {
    number: 1,
    slug: 'game-01-sid-symphony',
    name: 'SID Symphony',
    tagline: 'A rhythm game that makes the SID chip sing',
    units: 64,
    unitsAvailable: 16,
    skills: ['Screen layout', 'SID audio', 'Input handling', 'Animation'],
    status: 'in-progress'
  },
  {
    number: 2,
    slug: 'game-02-starfield',
    name: 'Starfield',
    tagline: 'Single-screen space shooter with hardware sprites',
    units: 64,
    unitsAvailable: 0,
    skills: ['VIC-II sprites', 'Joystick input', 'Collision detection', 'Bullet pooling'],
    status: 'coming-soon'
  },
  {
    number: 3,
    slug: 'game-03-maze-raider',
    name: 'Maze Raider',
    tagline: 'Pac-Man style maze chase with custom characters',
    units: 64,
    unitsAvailable: 0,
    skills: ['Custom character sets', 'Tile-based maps', 'Tile collision', 'Pathfinding AI'],
    status: 'coming-soon'
  },
  {
    number: 4,
    slug: 'game-04-platform-panic',
    name: 'Platform Panic',
    tagline: 'Single-screen platformer with gravity and jump physics',
    units: 64,
    unitsAvailable: 0,
    skills: ['Jump physics', 'Platform collision', 'Player animation', 'Level design'],
    status: 'coming-soon'
  },
  {
    number: 5,
    slug: 'game-05-brick-basher',
    name: 'Brick Basher',
    tagline: 'Breakout clone with ball physics and power-ups',
    units: 64,
    unitsAvailable: 0,
    skills: ['Ball physics', 'Reflection angles', 'Block destruction', 'Level editor'],
    status: 'coming-soon'
  },
  {
    number: 6,
    slug: 'game-06-invader-wave',
    name: 'Invader Wave',
    tagline: 'Space Invaders style shooter with formation patterns',
    units: 64,
    unitsAvailable: 0,
    skills: ['Formation patterns', 'Multi-sprite collision', 'Multiplexing intro', 'Sprite priority'],
    status: 'coming-soon'
  },
  {
    number: 7,
    slug: 'game-07-scroll-runner',
    name: 'Scroll Runner',
    tagline: 'Horizontal scrolling introduction',
    units: 64,
    unitsAvailable: 0,
    skills: ['Hardware scrolling', 'Screen split', 'Level streaming', 'Camera systems'],
    status: 'coming-soon'
  },
  {
    number: 8,
    slug: 'game-08-night-raid',
    name: 'Night Raid',
    tagline: 'Scramble-style side-scroller with terrain',
    units: 64,
    unitsAvailable: 0,
    skills: ['Scrolling shooter', 'Terrain collision', 'Fuel mechanics', 'Level design'],
    status: 'coming-soon'
  },
  {
    number: 9,
    slug: 'game-09-sprite-storm',
    name: 'Sprite Storm',
    tagline: 'Sprite multiplexing for 16-32 objects on screen',
    units: 64,
    unitsAvailable: 0,
    skills: ['Sprite multiplexing', 'Sorting algorithms', 'Raster timing', 'Many enemies'],
    status: 'coming-soon'
  },
  {
    number: 10,
    slug: 'game-10-raster-rider',
    name: 'Raster Rider',
    tagline: 'Pseudo-3D racing with raster effects',
    units: 64,
    unitsAvailable: 0,
    skills: ['Raster interrupts', 'Perspective maths', 'Road rendering', 'Speed illusion'],
    status: 'coming-soon'
  },
  {
    number: 11,
    slug: 'game-11-dungeon-crawl',
    name: 'Dungeon Crawl',
    tagline: 'Adventure game with disk I/O and saving',
    units: 128,
    unitsAvailable: 0,
    skills: ['Disk I/O', 'Save system', 'Large game design', 'Adventure mechanics'],
    status: 'coming-soon'
  },
  {
    number: 12,
    slug: 'game-12-arena-fighter',
    name: 'Arena Fighter',
    tagline: 'Fighting game with combo systems',
    units: 128,
    unitsAvailable: 0,
    skills: ['Fighting mechanics', 'Hit detection', 'Animation states', 'Two-player'],
    status: 'coming-soon'
  },
  {
    number: 13,
    slug: 'game-13-parallax-patrol',
    name: 'Parallax Patrol',
    tagline: 'R-Type style shooter with parallax scrolling',
    units: 128,
    unitsAvailable: 0,
    skills: ['Multi-layer parallax', 'Boss patterns', 'Weapon systems', 'Level design'],
    status: 'coming-soon'
  },
  {
    number: 14,
    slug: 'game-14-isometric-quest',
    name: 'Isometric Quest',
    tagline: 'Isometric adventure with depth sorting',
    units: 128,
    unitsAvailable: 0,
    skills: ['Isometric projection', 'Depth sorting', 'Puzzle mechanics', 'World building'],
    status: 'coming-soon'
  },
  {
    number: 15,
    slug: 'game-15-mega-blaster',
    name: 'Mega Blaster',
    tagline: 'Turrican-style action platformer',
    units: 128,
    unitsAvailable: 0,
    skills: ['Large sprites', 'Scrolling action', 'Weapon variety', 'Boss battles'],
    status: 'coming-soon'
  },
  {
    number: 16,
    slug: 'game-16-symphonys-end',
    name: "Symphony's End",
    tagline: 'Capstone game with demo-scene techniques',
    units: 256,
    unitsAvailable: 0,
    skills: ['Demo effects', 'All techniques', 'Professional polish', 'Full game'],
    status: 'coming-soon'
  }
];

const systemColor = '#4a4dff';
---

<Layout
  title="Commodore 64 – Learn Assembly Through Games"
  description="Learn Commodore 64 assembly by building complete games. Master the VIC-II, SID chip, and 6510 CPU through hands-on projects."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.1) 2px,
          rgba(255, 255, 255, 0.1) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-6);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-4);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .status-strip {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-4);
      margin: var(--space-6) auto 0;
      max-width: 900px;
      text-align: center;
    }

    .status-strip a {
      color: #4a4dff;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 1px solid #4a4dff40;
      padding-bottom: 2px;
    }

    .status-strip small {
      display: block;
      color: var(--color-text-secondary);
      margin-top: var(--space-2);
    }

    /* Game Cards */
    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .game-card:hover {
      border-color: #4a4dff;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(74, 77, 255, 0.15);
    }

    .game-card.coming-soon {
      opacity: 0.6;
      cursor: default;
    }

    .game-card.coming-soon:hover {
      transform: none;
      box-shadow: none;
      border-color: var(--color-border);
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: #4a4dff;
      width: 3rem;
      text-align: center;
    }

    .game-card.coming-soon .game-number {
      color: var(--color-text-secondary);
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .game-tagline {
      color: var(--color-text-secondary);
      font-size: 1rem;
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: rgba(74, 77, 255, 0.1);
      color: #4a4dff;
      border-radius: 0.25rem;
      font-weight: 500;
    }

    .game-card.coming-soon .skill-tag {
      background: var(--color-bg);
      color: var(--color-text-secondary);
    }

    .game-progress {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      gap: var(--space-2);
      min-width: 100px;
    }

    .progress-bar {
      width: 100px;
      height: 6px;
      background: var(--color-border);
      border-radius: 3px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: #4a4dff;
      border-radius: 3px;
    }

    .progress-text {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-family: var(--font-family-mono);
    }

    .game-status {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    /* Features */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.125rem;
      color: #4a4dff;
      margin-bottom: var(--space-2);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    @media (max-width: 768px) {
      .game-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .game-number {
        width: auto;
      }

      .game-progress {
        align-items: center;
      }

      .game-skills {
        justify-content: center;
      }

      .system-specs {
        gap: var(--space-4);
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">COMMODORE 64</h1>
      <p class="system-subtitle">Learn assembly by building games</p>
      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">MOS 6510</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">1 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">64 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Graphics</div>
          <div class="spec-value">VIC-II</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Sound</div>
          <div class="spec-value">SID</div>
        </div>
      </div>
    </div>
  </section>

  <div class="status-strip">
    <div><a href="/commodore-64/assembly/game-01-sid-symphony/unit-01">SID Symphony</a> units 01–16 are live.</div>
    <small>Starfield and Maze Raider coming soon.</small>
  </div>

  <!-- Getting Started -->
  <section class="content-section">
    <h2 class="section-title">Before You Begin</h2>
    <p class="section-intro">
      You'll need an emulator and an assembler. Both are free and take five minutes to install.
    </p>
    <a
      href="/commodore-64/assembly/getting-started"
      style="display: inline-block; padding: var(--space-3) var(--space-6);
             background: var(--color-surface); border: 2px solid #4a4dff;
             color: #4a4dff; border-radius: 0.5rem;
             text-decoration: none; font-weight: 600;"
    >
      Set Up Your Tools →
    </a>
  </section>

  <!-- Games Catalogue -->
  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      Each game teaches new skills while building something you'll want to play. Start with Game 1 and work through in order — each builds on what came before.
    </p>

    <div class="game-grid">
      {games.map((game) => (
        <a
          href={`/commodore-64/assembly/${game.slug}`}
          class={`game-card ${game.status === 'coming-soon' ? 'coming-soon' : ''}`}
        >
          <div class="game-number">{game.number}</div>
          <div class="game-info">
            <div class="game-name">{game.name}</div>
            <div class="game-tagline">{game.tagline}</div>
            <div class="game-skills">
              {game.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          <div class="game-progress">
            {game.status === 'coming-soon' ? (
              <span class="game-status">Coming Soon</span>
            ) : (
              <>
                <div class="progress-bar">
                  <div class="progress-fill" style={`width: ${(game.unitsAvailable / game.units) * 100}%`}></div>
                </div>
                <span class="progress-text">{game.unitsAvailable} / {game.units} units</span>
              </>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- What You'll Master -->
  <section class="content-section">
    <h2 class="section-title">What You'll Master</h2>
    <p class="section-intro">
      By the time you've built all the games, you'll have deep knowledge of C64 hardware and assembly programming.
    </p>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">VIC-II Graphics</h3>
        <p class="feature-description">
          Sprites, character graphics, smooth scrolling, raster interrupts, and the tricks that made C64 games look impossible.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">SID Sound</h3>
        <p class="feature-description">
          Three voices, filters, ADSR envelopes, and the techniques that created the C64's legendary sound.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">6510 Assembly</h3>
        <p class="feature-description">
          The full instruction set, addressing modes, and optimisation tricks that squeeze every cycle from the CPU.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Game Architecture</h3>
        <p class="feature-description">
          State machines, collision systems, input handling, and the patterns that make games feel right.
        </p>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Start?</h2>
    <p class="section-intro" style="margin-left: auto; margin-right: auto;">
      Game 1 starts with sound and input. By the end of Unit 1, you'll have a screen that looks like a game and a key that makes the SID chip sing.
    </p>
    <a
      href="/commodore-64/assembly/game-01-sid-symphony"
      style="display: inline-block; padding: var(--space-3) var(--space-6);
             background: #4a4dff; color: white; border-radius: 0.5rem;
             text-decoration: none; font-weight: 600; font-size: 1.1rem;"
    >
      Start Game 1: SID Symphony →
    </a>
  </section>
</Layout>
