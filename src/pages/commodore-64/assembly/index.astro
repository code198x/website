---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="C64 Assembly Programming - Build Games in 6502">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-16) var(--space-4);
      text-align: center;
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .hero-subtitle {
      font-size: 1.5rem;
      opacity: 0.95;
      max-width: 700px;
      margin: 0 auto;
    }

    .content-section {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: var(--space-12) var(--space-4);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .week-card {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.75rem;
      padding: var(--space-8);
      margin-bottom: var(--space-6);
    }

    .week-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-4);
    }

    .week-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .week-status {
      background: #22c55e;
      color: white;
      padding: var(--space-1) var(--space-3);
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .week-description {
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .week-button {
      display: inline-block;
      background: #4a4dff;
      color: white;
      padding: var(--space-3) var(--space-6);
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      transition: all var(--transition-base);
    }

    .week-button:hover {
      background: #3b3ecc;
      transform: translateY(-2px);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      margin-bottom: var(--space-8);
    }

    .back-link:hover {
      color: var(--color-text);
    }
  </style>

  <!-- Hero -->
  <section class="course-hero">
    <h1 class="hero-title">C64 Assembly Programming</h1>
    <p class="hero-subtitle">
      Learn 6502 assembly by building complete games for the Commodore 64
    </p>
  </section>

  <!-- Course Content -->
  <section class="content-section">
    <a href="/commodore-64" class="back-link">
      ← Back to Commodore 64
    </a>

    <h2 class="section-title">Available Weeks</h2>

    <!-- Week 1 -->
    <div class="week-card">
      <div class="week-header">
        <h3 class="week-title">Week 1: Assembly Fundamentals</h3>
        <span class="week-status">Available Now</span>
      </div>
      <p class="week-description">
        Set up your development environment and learn the basics of 6502 assembly.
        Build the foundation for Skyfall—a falling-objects game. By the end of Week 1,
        you'll have a player character that moves smoothly across the screen.
      </p>
      <a href="/commodore-64/assembly/week-1" class="week-button">
        Start Week 1 →
      </a>
    </div>

    <!-- Week 2 Coming Soon -->
    <div class="week-card" style="opacity: 0.6; border-color: var(--color-border);">
      <div class="week-header">
        <h3 class="week-title">Week 2: Gameplay & Physics</h3>
        <span class="week-status" style="background: var(--color-border); color: var(--color-text-secondary);">Coming Soon</span>
      </div>
      <p class="week-description">
        Add falling objects, collision detection, scoring, and sound effects.
        Complete the Skyfall game and learn essential game development techniques.
      </p>
    </div>
  </section>
</Layout>
