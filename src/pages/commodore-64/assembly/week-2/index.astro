---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 9,
    title: "Creating Falling Objects",
    description: "Learn 2D position calculation and the row × 40 multiplication technique",
    status: "available"
  },
  {
    number: 10,
    title: "Collision Detection",
    description: "Detect when the player catches falling objects and implement scoring",
    status: "available"
  },
  {
    number: 11,
    title: "Random Spawning",
    description: "Generate random numbers using the SID chip for unpredictable gameplay",
    status: "available"
  },
  {
    number: 12,
    title: "Multiple Objects",
    description: "Manage arrays of falling objects simultaneously",
    status: "available"
  },
  {
    number: 13,
    title: "Sound Effects",
    description: "Add catch and miss sounds using the SID chip",
    status: "available"
  },
  {
    number: 14,
    title: "Multi-Digit Score Display",
    description: "Display scores from 0-99 with proper formatting",
    status: "available"
  },
  {
    number: 15,
    title: "Game Over and Restart",
    description: "Implement game over conditions and restart mechanics",
    status: "available"
  },
  {
    number: 16,
    title: "Polish and Final Touches",
    description: "Add title screen, difficulty progression, and complete the game",
    status: "available"
  }
];
---

<Layout title="Week 2: Complete the Game - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #f59e0b 0%, #dc2626 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 900;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-section {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: 0 var(--space-4) var(--space-12);
    }

    .prerequisite-box {
      background: var(--color-surface);
      border: 2px solid #f59e0b;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-bottom: var(--space-8);
    }

    .prerequisite-box h2 {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: #f59e0b;
    }

    .prerequisite-box p {
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .prerequisite-box a {
      color: #f59e0b;
      font-weight: 600;
    }

    .lessons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
    }

    .lesson-card:hover {
      border-color: #f59e0b;
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .lesson-number {
      font-family: var(--font-family-mono);
      font-size: 0.875rem;
      color: #f59e0b;
      font-weight: 700;
      margin-bottom: var(--space-2);
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .lesson-description {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      flex-grow: 1;
    }

    .lesson-status {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      color: #22c55e;
      font-weight: 600;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: var(--space-8);
      transition: color var(--transition-base);
    }

    .back-link:hover {
      color: var(--color-text);
    }
  </style>

  <!-- Hero Section -->
  <section class="course-hero">
    <h1 class="course-title">C64 Assembly - Week 2</h1>
    <p class="course-subtitle">Complete the Skyfall Game</p>
    <p class="course-description">
      Turn your player controls into a complete game! Add falling objects, collision detection,
      scoring, sound effects, and polish. By the end of Week 2, you'll have a finished,
      playable C64 game.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">~5 hrs</div>
        <div class="stat-label">Time to Complete</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">Complete</div>
        <div class="stat-label">Game Project</div>
      </div>
    </div>
  </section>

  <!-- Lessons Grid -->
  <section class="content-section">
    <a href="/commodore-64/assembly" class="back-link">
      ← Back to C64 Assembly
    </a>

    <div class="prerequisite-box">
      <h2>⚠️ Prerequisites</h2>
      <p>
        Week 2 builds directly on Week 1. You should complete
        <a href="/commodore-64/assembly/week-1">Week 1: Assembly Fundamentals</a>
        first, which covers setting up your environment, screen memory, keyboard input,
        and player movement.
      </p>
    </div>

    <div class="lessons-grid">
      {lessons.map((lesson) => (
        <a href={`/commodore-64/assembly/week-2/lesson-${String(lesson.number).padStart(2, '0')}`} class="lesson-card">
          <div class="lesson-number">Lesson {lesson.number}</div>
          <h3 class="lesson-title">{lesson.title}</h3>
          <p class="lesson-description">{lesson.description}</p>
          <div class="lesson-status">✓ {lesson.status}</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
