---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 1,
    title: "Setting Up Your Development Environment",
    description: "Install ACME assembler, VICE emulator, and write your first program",
    status: "available"
  },
  {
    number: 2,
    title: "Screen Memory Fundamentals",
    description: "Learn how the C64 displays characters and where screen memory lives",
    status: "available"
  },
  {
    number: 3,
    title: "Drawing the Player",
    description: "Calculate positions and draw your first game object",
    status: "available"
  },
  {
    number: 4,
    title: "Colors & Screen Control",
    description: "Set custom colors and sync to the screen refresh",
    status: "available"
  },
  {
    number: 5,
    title: "Keyboard Input Basics",
    description: "Read keyboard input directly from hardware",
    status: "available"
  },
  {
    number: 6,
    title: "Moving the Player",
    description: "Implement left/right movement with boundaries",
    status: "available"
  },
  {
    number: 7,
    title: "Timing and Smooth Movement",
    description: "Use the raster beam for frame-based timing",
    status: "available"
  },
  {
    number: 8,
    title: "Responsive Controls",
    description: "Polish input handling and prepare for gameplay",
    status: "available"
  }
];
---

<Layout title="Week 1: Assembly Fundamentals - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 900;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-section {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: 0 var(--space-4) var(--space-12);
    }

    .lessons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
    }

    .lesson-card:hover {
      border-color: #4a4dff;
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .lesson-number {
      font-family: var(--font-family-mono);
      font-size: 0.875rem;
      color: #4a4dff;
      font-weight: 700;
      margin-bottom: var(--space-2);
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .lesson-description {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      flex-grow: 1;
    }

    .lesson-status {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      color: #22c55e;
      font-weight: 600;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: var(--space-8);
      transition: color var(--transition-base);
    }

    .back-link:hover {
      color: var(--color-text);
    }
  </style>

  <!-- Hero Section -->
  <section class="course-hero">
    <h1 class="course-title">C64 Assembly - Week 1</h1>
    <p class="course-subtitle">Build Your First Game in 6502 Assembly</p>
    <p class="course-description">
      Learn assembly programming by building Skyfall—a falling-objects game.
      By the end of Week 1, you'll have a movable player character with responsive controls.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">~4 hrs</div>
        <div class="stat-label">Time to Complete</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">6502</div>
        <div class="stat-label">CPU Architecture</div>
      </div>
    </div>
  </section>

  <!-- Lessons Grid -->
  <section class="content-section">
    <a href="/commodore-64" class="back-link">
      ← Back to Commodore 64
    </a>

    <div class="lessons-grid">
      {lessons.map((lesson) => (
        <a href={`/commodore-64/assembly/week-1/lesson-${String(lesson.number).padStart(2, '0')}`} class="lesson-card">
          <div class="lesson-number">Lesson {lesson.number}</div>
          <h3 class="lesson-title">{lesson.title}</h3>
          <p class="lesson-description">{lesson.description}</p>
          <div class="lesson-status">✓ {lesson.status}</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
