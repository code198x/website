---
import Layout from '../../../../layouts/Layout.astro';

const lessons = [
  {
    number: 1,
    title: "Bootstrapping Scroll Runner",
    description: "Convert the hybrid BASIC launcher into a pure assembly project and stage the assets.",
    status: "draft"
  },
  {
    number: 2,
    title: "Deterministic Game Loop",
    description: "Build the assembly update/render scheduler with tight frame timing.",
    status: "draft"
  },
  {
    number: 3,
    title: "Input & State Core",
    description: "Move joystick/keyboard polling and game state transitions into zero-page structs.",
    status: "draft"
  },
  {
    number: 4,
    title: "Tile & Sprite Renderer",
    description: "Stream map columns, animate sprites, and manage character data in 6502.",
    status: "draft"
  },
  {
    number: 5,
    title: "Collision & Physics Engine",
    description: "Port collision checks and velocity math to fast assembly routines.",
    status: "draft"
  },
  {
    number: 6,
    title: "HUD & Diagnostics",
    description: "Render score, timers, and debug counters entirely from assembly code.",
    status: "draft"
  },
  {
    number: 7,
    title: "SID Hooks & Effects",
    description: "Trigger SID cues from assembly tasks without breaking the frame budget.",
    status: "draft"
  },
  {
    number: 8,
    title: "Act I Release Build",
    description: "Integrate every subsystem and ship the all-assembly Scroll Runner demo.",
    status: "draft"
  }
];
---

<Layout title="Week 2: Complete the Game - Commodore 64">
  <style>
    .course-hero {
      background: linear-gradient(135deg, #f59e0b 0%, #dc2626 100%);
      color: white;
      padding: var(--space-12) var(--space-4);
      text-align: center;
      margin-bottom: var(--space-12);
    }

    .course-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .course-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .course-description {
      max-width: 700px;
      margin: 0 auto var(--space-8);
      font-size: 1.125rem;
      line-height: 1.7;
      opacity: 0.95;
    }

    .course-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 900;
      font-family: var(--font-family-mono);
    }

    .stat-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .content-section {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: 0 var(--space-4) var(--space-12);
    }

    .prerequisite-box {
      background: var(--color-surface);
      border: 2px solid #f59e0b;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-bottom: var(--space-8);
    }

    .prerequisite-box h2 {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: #f59e0b;
    }

    .prerequisite-box p {
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .prerequisite-box a {
      color: #f59e0b;
      font-weight: 600;
    }

    .lessons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .lesson-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
    }

    .lesson-card:hover {
      border-color: #f59e0b;
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .lesson-number {
      font-family: var(--font-family-mono);
      font-size: 0.875rem;
      color: #f59e0b;
      font-weight: 700;
      margin-bottom: var(--space-2);
    }

    .lesson-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .lesson-description {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      flex-grow: 1;
    }

    .lesson-status {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      color: #22c55e;
      font-weight: 600;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: var(--space-8);
      transition: color var(--transition-base);
    }

    .back-link:hover {
      color: var(--color-text);
    }
  </style>

  <!-- Hero Section -->
  <section class="course-hero">
    <h1 class="course-title">Act I – Speaking in Bytes</h1>
    <p class="course-subtitle">Turn Scroll Runner into a pure assembly experience.</p>
    <p class="course-description">
      Each lesson replaces a remaining BASIC subsystem with tight 6502 code—bootstrapping, loop control,
      input, rendering, collisions, HUD, and audio. Finish Act I with an all-assembly Scroll Runner build
      ready for the ambitious Acts ahead.
    </p>

    <div class="course-stats">
      <div class="stat-item">
        <div class="stat-value">8</div>
        <div class="stat-label">Lessons</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">~6 hrs</div>
        <div class="stat-label">Estimated Build Time</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">Scroll Runner</div>
        <div class="stat-label">Assembly Demo</div>
      </div>
    </div>
  </section>

  <!-- Lessons Grid -->
  <section class="content-section">
    <a href="/commodore-64/assembly" class="back-link">
      ← Back to C64 Assembly
    </a>

    <div class="prerequisite-box">
      <h2>⚡ Prerequisites</h2>
      <p>
        Complete the <a href="/commodore-64/basic">C64 BASIC course</a> (all 8 weeks, especially Week 8's Scroll Runner project).
        Lesson 1 includes comprehensive toolchain setup and assembly fundamentals—you can start immediately after BASIC!
      </p>
    </div>

    <div class="lessons-grid">
      {lessons.map((lesson) => (
        <a href={`/commodore-64/assembly/week-1/lesson-${String(lesson.number).padStart(2, '0')}`} class="lesson-card">
          <div class="lesson-number">Lesson {lesson.number}</div>
          <h3 class="lesson-title">{lesson.title}</h3>
          <p class="lesson-description">{lesson.description}</p>
          <div class="lesson-status">{lesson.status == 'draft' ? 'Draft in progress' : 'Available'}</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
