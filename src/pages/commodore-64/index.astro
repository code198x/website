---
import Layout from '../../layouts/Layout.astro';
import SystemHero from '../../components/SystemHero.astro';
import PathCard from '../../components/PathCard.astro';
import VaultCard from '../../components/VaultCard.astro';
import SetupCallout from '../../components/SetupCallout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { Binary, BookOpen } from '@lucide/astro';
import { getTrackStatCards } from '../../lib/modules';

const platformColor = '#4a4dff';

const specs = [
  { label: 'CPU', value: 'MOS 6510' },
  { label: 'Speed', value: '1 MHz' },
  { label: 'RAM', value: '64 KB' },
  { label: 'Graphics', value: 'VIC-II' },
  { label: 'Sound', value: 'SID' },
];

const assemblyStats = await getTrackStatCards('commodore-64', 'assembly');
const basicStats = await getTrackStatCards('commodore-64', 'basic');

const vaultArticles = [
  {
    href: '/vault/hardware/vic-ii',
    kicker: 'Hardware',
    title: 'Inside the VIC-II',
    description: 'The graphics chip that gave the C64 its visual identity and pushed developers to new heights.',
  },
  {
    href: '/vault/hardware/sid-chip',
    kicker: 'Hardware',
    title: 'The SID Chip',
    description: "Why the 6581 became legendary and how composers created music that still resonates.",
  },
  {
    href: '/vault/techniques/raster-tricks',
    kicker: 'Technique',
    title: 'Raster Tricks',
    description: 'Timing magic for more colours and sprites than the hardware officially supports.',
  },
  {
    href: '/vault/people/rob-hubbard',
    kicker: 'People',
    title: 'Rob Hubbard',
    description: 'The composer who pushed the SID to its limits and defined the sound of 8-bit gaming.',
  },
  {
    href: '/vault/games/paradroid',
    kicker: 'Games',
    title: 'Paradroid',
    description: "Andrew Braybrook's robotic masterpiece that redefined what C64 games could be.",
  },
  {
    href: '/vault/magazines/zzap-64',
    kicker: 'Culture',
    title: 'ZZAP!64',
    description: 'The magazine that shaped C64 culture and set the standard for games journalism.',
  },
];
---

<Layout
  title="Commodore 64 – Learn Programming Through Games"
  description="Learn Commodore 64 programming by building complete games. Choose between BASIC V2 for beginners or 6510 assembly for the full experience."
  platformColor={platformColor}
>
  <style>
    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .path-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .path-icon {
      color: var(--ink);
      margin-bottom: var(--space-3);
    }

    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .about-section {
      padding: var(--space-10) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .about-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .about-text {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: var(--space-4);
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <SystemHero
    title="Commodore 64"
    subtitle="Where bedroom coders became legends"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
  />

  <!-- About This System -->
  <section class="about-section">
    <h2 class="about-title">Why the Commodore 64?</h2>
    <div class="about-text">
      <p>
        The Commodore 64 remains the best-selling home computer of all time. Launched in 1982, it
        paired an affordable price with genuinely capable hardware: the VIC-II chip delivered smooth
        scrolling and hardware sprites, while the SID sound chip gave bedroom musicians a genuine
        synthesiser. Together, they created a platform where one person could build something that
        felt like an arcade game.
      </p>
      <p>
        Learning the C64 teaches you to think like a programmer. With just 64 KB of RAM and a 1 MHz
        processor, every byte matters and every cycle counts. The constraints force creativity — and
        the skills transfer directly to modern embedded systems, game development, and low-level
        programming. Plus, there's still an active community releasing new games, demos, and tools
        forty years later.
      </p>
    </div>
  </section>

  <!-- Quick Setup -->
  <SetupCallout dockerImage="ghcr.io/code198x/commodore-64" />

  <!-- Choose Your Path -->
  <section class="content-section">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-intro">
      Two ways to learn C64 game development. Start with BASIC if you're new to programming, or dive
      straight into assembly for the full experience.
    </p>

    <div class="path-grid">
      <PathCard
        href="/commodore-64/assembly"
        title="6510 Assembly"
        subtitle="Full hardware control"
        description="Master the VIC-II for sprites and scrolling, the SID for legendary sound, and every cycle of the 6510 CPU. This is how the best C64 games were made."
        stats={assemblyStats}
        platformColor={platformColor}
        isRecommended
        ctaText="Start Assembly Path"
      >
        <Binary size={32} class="path-icon" slot="icon" />
      </PathCard>

      <PathCard
        href="/commodore-64/basic"
        title="BASIC V2"
        subtitle="Gateway curriculum"
        description="Learn programming fundamentals with the C64's built-in BASIC. Build 8 complete games while understanding memory, graphics, and the machine's limits — then graduate to assembly."
        stats={basicStats}
        platformColor={platformColor}
        ctaText="Start BASIC Path"
      >
        <BookOpen size={32} class="path-icon" slot="icon" />
      </PathCard>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <SectionHeader
        title="From the Vault"
        linkHref="/vault"
        linkText="View all articles"
        platformColor={platformColor}
      />
      <div class="vault-grid">
        {vaultArticles.map((article) => (
          <VaultCard
            href={article.href}
            kicker={article.kicker}
            title={article.title}
            description={article.description}
            platformColor={platformColor}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
