---
import Layout from '../../layouts/Layout.astro';
import { Binary, BookOpen } from '@lucide/astro';
---

<Layout
  title="Commodore 64 – Learn Programming Through Games"
  description="Learn Commodore 64 programming by building complete games. Choose between BASIC V2 for beginners or 6510 assembly for the full experience."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.1) 2px,
          rgba(255, 255, 255, 0.1) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-6);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-4);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    /* Path Cards */
    .path-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .path-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .path-card:hover {
      border-color: #4a4dff;
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(74, 77, 255, 0.2);
    }

    /* Assembly path - technical appearance with subtle grid pattern */
    .path-card.recommended {
      border-color: #4a4dff;
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, #4a4dff 3%, var(--color-surface) 97%) 100%);
    }

    .path-card.recommended::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(90deg, rgba(74, 77, 255, 0.03) 1px, transparent 1px),
        linear-gradient(rgba(74, 77, 255, 0.03) 1px, transparent 1px);
      background-size: 20px 20px;
      pointer-events: none;
    }

    /* BASIC path - warmer, friendlier appearance */
    .path-card:not(.recommended) {
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%) 100%);
    }

    .path-badge {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-3);
      background: #4a4dff;
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
    }

    .path-icon {
      color: #4a4dff;
      margin-bottom: var(--space-3);
    }

    .path-title {
      font-family: var(--font-family-mono);
      font-size: 1.75rem;
      font-weight: 900;
      color: #4a4dff;
      margin-bottom: var(--space-2);
    }

    .path-subtitle {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
    }

    .path-description {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: var(--space-6);
      flex-grow: 1;
    }

    .path-stats {
      display: flex;
      gap: var(--space-6);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }

    .path-stat {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 1.5rem;
      font-weight: 900;
      color: #4a4dff;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      text-transform: uppercase;
    }

    .path-cta {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: #4a4dff;
      color: white;
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      margin-top: var(--space-4);
      text-align: center;
    }

    .path-card:not(.recommended) .path-cta {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      color: #4a4dff;
    }

    /* Vault Section */
    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .vault-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
    }

    .vault-title {
      font-size: 1.5rem;
      color: var(--color-text);
    }

    .vault-link {
      color: #4a4dff;
      text-decoration: none;
      font-weight: 500;
    }

    .vault-link:hover {
      text-decoration: underline;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .vault-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .vault-card:hover {
      border-color: #4a4dff;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .vault-kicker {
      display: block;
      font-size: 0.7rem;
      color: #4a4dff;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-bottom: var(--space-1);
    }

    .vault-name {
      display: block;
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .vault-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }

      .system-specs {
        gap: var(--space-4);
      }

      .vault-header {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">COMMODORE 64</h1>
      <p class="system-subtitle">Learn programming by building games</p>
      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">MOS 6510</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">1 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">64 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Graphics</div>
          <div class="spec-value">VIC-II</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Sound</div>
          <div class="spec-value">SID</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Choose Your Path -->
  <section class="content-section">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-intro">
      Two ways to learn C64 game development. Start with BASIC if you're new to programming, or dive straight into assembly for the full experience.
    </p>

    <div class="path-grid">
      <a href="/commodore-64/assembly" class="path-card recommended">
        <span class="path-badge">Recommended</span>
        <div class="path-icon"><Binary size={32} /></div>
        <h3 class="path-title">6510 Assembly</h3>
        <p class="path-subtitle">Full hardware control</p>
        <p class="path-description">
          Master the VIC-II for sprites and scrolling, the SID for legendary sound, and every cycle of the 6510 CPU. This is how the best C64 games were made.
        </p>
        <div class="path-stats">
          <div class="path-stat">
            <div class="stat-value">16</div>
            <div class="stat-label">Games</div>
          </div>
          <div class="path-stat">
            <div class="stat-value">1,536</div>
            <div class="stat-label">Units</div>
          </div>
        </div>
        <span class="path-cta">Start Assembly Path</span>
      </a>

      <a href="/commodore-64/basic" class="path-card">
        <div class="path-icon"><BookOpen size={32} /></div>
        <h3 class="path-title">BASIC V2</h3>
        <p class="path-subtitle">Gateway curriculum</p>
        <p class="path-description">
          Learn programming fundamentals with the C64's built-in BASIC. Build 8 complete games while understanding memory, graphics, and the machine's limits — then graduate to assembly.
        </p>
        <div class="path-stats">
          <div class="path-stat">
            <div class="stat-value">8</div>
            <div class="stat-label">Games</div>
          </div>
          <div class="path-stat">
            <div class="stat-value">512</div>
            <div class="stat-label">Units</div>
          </div>
        </div>
        <span class="path-cta">Start BASIC Path</span>
      </a>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <div class="vault-header">
        <h2 class="vault-title">From the Vault</h2>
        <a href="/vault" class="vault-link">View all articles</a>
      </div>
      <div class="vault-grid">
        <a href="/vault/hardware/vic-ii" class="vault-card">
          <span class="vault-kicker">Hardware</span>
          <span class="vault-name">Inside the VIC-II</span>
          <span class="vault-desc">The graphics chip that gave the C64 its visual identity and pushed developers to new heights.</span>
        </a>
        <a href="/vault/hardware/sid-chip" class="vault-card">
          <span class="vault-kicker">Hardware</span>
          <span class="vault-name">The SID Chip</span>
          <span class="vault-desc">Why the 6581 became legendary and how composers created music that still resonates.</span>
        </a>
        <a href="/vault/techniques/raster-tricks-101" class="vault-card">
          <span class="vault-kicker">Technique</span>
          <span class="vault-name">Raster Tricks 101</span>
          <span class="vault-desc">Timing magic for more colours and sprites than the hardware officially supports.</span>
        </a>
        <a href="/vault/people/rob-hubbard" class="vault-card">
          <span class="vault-kicker">People</span>
          <span class="vault-name">Rob Hubbard</span>
          <span class="vault-desc">The composer who pushed the SID to its limits and defined the sound of 8-bit gaming.</span>
        </a>
        <a href="/vault/games/paradroid" class="vault-card">
          <span class="vault-kicker">Games</span>
          <span class="vault-name">Paradroid</span>
          <span class="vault-desc">Andrew Braybrook's robotic masterpiece that redefined what C64 games could be.</span>
        </a>
        <a href="/vault/culture/zzap64" class="vault-card">
          <span class="vault-kicker">Culture</span>
          <span class="vault-name">ZZAP!64</span>
          <span class="vault-desc">The magazine that shaped C64 culture and set the standard for games journalism.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
