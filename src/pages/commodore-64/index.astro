---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Commodore 64 - Learn BASIC and 6502 Assembly">
  <style>
    .system-hero {
      min-height: 400px;
      background: linear-gradient(135deg, #4a4dff 0%, #7c70da 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.1) 2px,
          rgba(255, 255, 255, 0.1) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .system-subtitle {
      font-size: 1.5rem;
      opacity: 0.95;
      margin-bottom: var(--space-6);
    }

    .system-specs {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-6);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.875rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-16) var(--space-4);
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .coming-soon-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
      margin: var(--space-8) auto;
      max-width: 600px;
    }

    .coming-soon-icon {
      font-size: 4rem;
      margin-bottom: var(--space-4);
    }

    .coming-soon-title {
      font-size: 1.5rem;
      color: var(--color-text);
      margin-bottom: var(--space-3);
    }

    .coming-soon-text {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      color: #4a4dff;
      margin-bottom: var(--space-3);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .memory-map {
      background: var(--color-surface);
      border: 2px solid #4a4dff;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
      font-family: var(--font-family-mono);
    }

    .memory-region {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .memory-region:last-child {
      border-bottom: none;
    }

    .memory-address {
      color: #4a4dff;
      font-weight: bold;
    }

    .memory-description {
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .system-specs {
        gap: var(--space-4);
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">COMMODORE 64</h1>
      <p class="system-subtitle">The best-selling computer of all time</p>

      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">MOS 6502</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">1 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">64 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Released</div>
          <div class="spec-value">1982</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Course Paths -->
  <section class="content-section">
    <h2 class="section-title">Learning Paths</h2>

    <div class="feature-grid" style="margin-top: var(--space-6);">
      <div class="feature-card" style="border: 2px solid #4a4dff;">
        <h3 class="feature-title">📘 C64 BASIC V2</h3>
        <p class="feature-description" style="margin-bottom: var(--space-4);">
          Start with BASIC - the built-in language of the C64. Perfect for beginners,
          learn programming fundamentals while creating games and utilities.
        </p>
        <p style="margin-bottom: var(--space-3);"><strong>Week 1 Available Now:</strong></p>
        <ul style="list-style: none; padding: 0; color: var(--color-text-secondary); font-size: 0.9rem;">
          <li>✓ Lesson 1: Hello, World</li>
          <li>✓ Lesson 2: Screen Control</li>
          <li>✓ Lesson 3: Loops with GOTO</li>
          <li>✓ Lesson 4: Colours with POKE</li>
          <li>✓ Lesson 5: Variables</li>
          <li>✓ Lesson 6: Keyboard Input with GET</li>
          <li>✓ Lesson 7: IF/THEN Decisions</li>
          <li>✓ Lesson 8: Your First Complete Game</li>
        </ul>
        <a href="/commodore-64/basic/week-1"
           style="display: inline-block; margin-top: var(--space-4); padding: var(--space-2) var(--space-4);
                  background: #4a4dff; color: white; border-radius: 0.375rem;
                  text-decoration: none; font-weight: 600; font-size: 0.9rem;">
          Start Learning BASIC →
        </a>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">⚙️ 6502 Assembly</h3>
        <p class="feature-description" style="margin-bottom: var(--space-4);">
          Dive deep into machine-level programming. Create sprites, music, and high-performance
          games with direct hardware control.
        </p>
        <div class="coming-soon-icon" style="font-size: 2rem; margin: var(--space-4) 0;">🚧</div>
        <p style="color: var(--color-text-secondary); font-size: 0.9rem;">
          Assembly course coming soon. Master BASIC first, then you'll be ready
          for low-level programming!
        </p>
      </div>
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="content-section">
    <h2 class="section-title">What You'll Learn</h2>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">VIC-II Graphics</h3>
        <p class="feature-description">
          Master the VIC-II chip: sprites, character graphics, smooth scrolling,
          and raster interrupts for amazing visual effects.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">SID Chip Music</h3>
        <p class="feature-description">
          Program the legendary SID chip to create music and sound effects.
          Three voices, filters, and that classic C64 sound.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">6502 Assembly</h3>
        <p class="feature-description">
          Learn the 6502 instruction set that powered a generation.
          From basic operations to advanced techniques.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Game Development</h3>
        <p class="feature-description">
          Build real games: shooters, platformers, puzzle games.
          All running on authentic C64 hardware or emulators.
        </p>
      </div>
    </div>
  </section>

  <!-- Memory Map Preview -->
  <section class="content-section">
    <h2 class="section-title">C64 Memory Map Preview</h2>

    <div class="memory-map">
      <div class="memory-region">
        <span class="memory-address">$0000-$00FF</span>
        <span class="memory-description">Zero Page - Fast access RAM</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$0400-$07FF</span>
        <span class="memory-description">Screen Memory (1K)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$D000-$D3FF</span>
        <span class="memory-description">VIC-II Graphics Chip</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$D400-$D7FF</span>
        <span class="memory-description">SID Sound Chip</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$D800-$DBFF</span>
        <span class="memory-description">Color RAM</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$E000-$FFFF</span>
        <span class="memory-description">KERNAL ROM</span>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Code Like It's 1982?</h2>
    <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 600px; margin-left: auto; margin-right: auto;">
      Start with Week 1 of C64 BASIC and build your first complete game. No experience required—just
      curiosity and a willingness to learn how the best-selling computer of all time works.
    </p>
    <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
      <a href="/commodore-64/basic/week-1"
         style="display: inline-block; padding: var(--space-3) var(--space-6);
                background: #4a4dff; color: white; border-radius: 0.5rem;
                text-decoration: none; font-weight: 600;">
        Start Learning →
      </a>
      <a href="https://github.com/code198x"
         style="display: inline-block; padding: var(--space-3) var(--space-6);
                background: transparent; color: #4a4dff; border: 2px solid #4a4dff; border-radius: 0.5rem;
                text-decoration: none; font-weight: 600;">
        View on GitHub
      </a>
    </div>
  </section>
</Layout>