---
import Layout from '../../../layouts/Layout.astro';
import { getGamesWithAvailability } from '../../../lib/games';

const games = await getGamesWithAvailability('sinclair-zx-spectrum', 'assembly');
const systemColor = '#cc0000';
---

<Layout
  title="ZX Spectrum – Learn Z80 Assembly Through Games"
  description="Learn ZX Spectrum Z80 assembly by building complete games. Master the attribute system, ULA graphics, and the processor that powered millions of machines."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Rainbow stripe at the bottom - iconic Spectrum branding */
    .system-hero::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 8px;
      background: linear-gradient(90deg,
        #00FF00 0%, #00FF00 14.28%,
        #FFFF00 14.28%, #FFFF00 28.57%,
        #00FFFF 28.57%, #00FFFF 42.85%,
        #FF0000 42.85%, #FF0000 57.14%,
        #FF00FF 57.14%, #FF00FF 71.42%,
        #00FF00 71.42%, #00FF00 85.71%,
        #00FFFF 85.71%, #00FFFF 100%
      );
      z-index: 2;
    }

    /* Subtle scanline effect */
    .system-hero::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.05) 2px,
          rgba(255, 255, 255, 0.05) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-6);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-4);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .status-strip {
      background: var(--color-surface);
      border: 2px solid #cc0000;
      border-radius: 0.75rem;
      padding: var(--space-4);
      margin: var(--space-6) auto 0;
      max-width: 900px;
      text-align: center;
    }

    .status-strip a {
      color: #cc0000;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 1px solid #cc000040;
      padding-bottom: 2px;
    }

    .status-strip small {
      display: block;
      color: var(--color-text-secondary);
      margin-top: var(--space-2);
    }

    /* Game Cards */
    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .game-card:hover {
      border-color: #cc0000;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .game-card.coming-soon {
      opacity: 0.6;
      cursor: default;
    }

    .game-card.coming-soon:hover {
      transform: none;
      box-shadow: none;
      border-color: var(--color-border);
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: #cc0000;
      width: 3rem;
      text-align: center;
    }

    .game-card.coming-soon .game-number {
      color: var(--color-text-secondary);
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .game-tagline {
      color: var(--color-text-secondary);
      font-size: 1rem;
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: rgba(0, 0, 0, 0.08);
      color: #cc0000;
      border-radius: 0.25rem;
      font-weight: 500;
    }

    .game-card.coming-soon .skill-tag {
      background: var(--color-bg);
      color: var(--color-text-secondary);
    }

    .game-progress {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      gap: var(--space-2);
      min-width: 100px;
    }

    .progress-bar {
      width: 100px;
      height: 6px;
      background: var(--color-border);
      border-radius: 3px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: #cc0000;
      border-radius: 3px;
    }

    .progress-text {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-family: var(--font-family-mono);
    }

    .game-status {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    /* Features */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.125rem;
      color: #cc0000;
      margin-bottom: var(--space-2);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* Memory Map */
    .memory-map {
      background: var(--color-surface);
      border: 2px solid #cc0000;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-6) 0;
      font-family: var(--font-family-mono);
    }

    .memory-region {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .memory-region:last-child {
      border-bottom: none;
    }

    .memory-address {
      color: #cc0000;
      font-weight: bold;
    }

    .memory-description {
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .game-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .game-number {
        width: auto;
      }

      .game-progress {
        align-items: center;
      }

      .game-skills {
        justify-content: center;
      }

      .system-specs {
        gap: var(--space-4);
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">ZX SPECTRUM</h1>
      <p class="system-subtitle">Learn Z80 assembly by building games</p>
      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">Zilog Z80</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">3.5 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">48 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Graphics</div>
          <div class="spec-value">ULA</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Sound</div>
          <div class="spec-value">Beeper</div>
        </div>
      </div>
    </div>
  </section>

  <div class="status-strip">
    <div><a href="/sinclair-zx-spectrum/assembly/game-05-ink-war/unit-01">Ink War</a> units 01–64 are live.</div>
    <small>Shadowkeep and Shatter coming soon.</small>
  </div>

  <!-- Getting Started -->
  <section class="content-section">
    <h2 class="section-title">Before You Begin</h2>
    <p class="section-intro">
      You'll need an emulator and an assembler. Both are free and take five minutes to install.
    </p>
    <a href="/sinclair-zx-spectrum/getting-started" class="btn btn-secondary btn-spectrum">
      Set Up Your Tools →
    </a>
  </section>

  <!-- Games Catalogue -->
  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      Each game teaches new skills while building something you'll want to play. Start with Game 1 and work through in order — each builds on what came before.
    </p>

    <div class="game-grid">
      {games.map((game) => (
        <a
          href={`/sinclair-zx-spectrum/assembly/${game.slug}`}
          class={`game-card ${game.status === 'coming-soon' ? 'coming-soon' : ''}`}
        >
          <div class="game-number">{game.number}</div>
          <div class="game-info">
            <div class="game-name">{game.name}</div>
            <div class="game-tagline">{game.tagline}</div>
            <div class="game-skills">
              {game.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          <div class="game-progress">
            {game.status === 'coming-soon' ? (
              <span class="game-status">Coming Soon</span>
            ) : (
              <>
                <div class="progress-bar">
                  <div class="progress-fill" style={`width: ${(game.unitsAvailable / game.units) * 100}%`}></div>
                </div>
                <span class="progress-text">{game.unitsAvailable} / {game.units} units</span>
              </>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- What You'll Master -->
  <section class="content-section">
    <h2 class="section-title">What You'll Master</h2>
    <p class="section-intro">
      By the time you've built all the games, you'll have deep knowledge of Spectrum hardware and Z80 assembly.
    </p>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">Attribute System</h3>
        <p class="feature-description">
          The Spectrum's unique colour system where 8×8 pixel blocks share INK and PAPER colours. Learn why this limitation defined Spectrum aesthetics.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">ULA Graphics</h3>
        <p class="feature-description">
          Understand the Uncommitted Logic Array that generates the display. Master the non-linear screen layout and attribute memory.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Z80 Assembly</h3>
        <p class="feature-description">
          The instruction set that powered millions of machines. Write code that runs on Spectrum, Amstrad CPC, MSX, and Game Boy.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Software Sprites</h3>
        <p class="feature-description">
          No hardware sprites means everything is software. Learn masking, shifting, and the techniques that made Spectrum games possible.
        </p>
      </div>
    </div>
  </section>

  <!-- Memory Map -->
  <section class="content-section">
    <h2 class="section-title">Memory Map</h2>
    <p class="section-intro">
      The Spectrum's memory layout is simple but carefully designed — ROM at the bottom, screen memory in a specific location, RAM above.
    </p>

    <div class="memory-map">
      <div class="memory-region">
        <span class="memory-address">$0000-$3FFF</span>
        <span class="memory-description">ROM (16KB) - BASIC interpreter & system</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$4000-$57FF</span>
        <span class="memory-description">Screen bitmap (6144 bytes)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$5800-$5AFF</span>
        <span class="memory-description">Screen attributes (768 bytes)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">$5B00-$FFFF</span>
        <span class="memory-description">Available RAM (~41KB on 48K model)</span>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Start?</h2>
    <p class="section-intro" style="margin-left: auto; margin-right: auto;">
      Game 1 starts with the attribute system — the defining feature of every Spectrum game. By the end of Unit 1, you'll be navigating rooms of a dark keep.
    </p>
    <a href="/sinclair-zx-spectrum/assembly/game-01-shadowkeep" class="btn btn-primary btn-spectrum" style="font-size: 1.1rem;">
      Start Game 1: Shadowkeep →
    </a>
  </section>
</Layout>
