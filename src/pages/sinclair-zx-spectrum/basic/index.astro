---
import Layout from '../../../layouts/Layout.astro';
import { getGamesWithAvailability } from '../../../lib/games';

const games = await getGamesWithAvailability('sinclair-zx-spectrum', 'basic');

// Group games by phase — colours from the Spectrum rainbow
const phases = [
  {
    number: 1,
    name: 'Foundations',
    subtitle: 'Learn the language by building six small games. Each introduces one visual dimension — colour, sound, screen control, strings, data — until your programs look like real Spectrum software.',
    units: '8 units each',
    color: '#CC0000',
    games: games.filter(g => g.phase === 'Foundations'),
  },
  {
    number: 2,
    name: 'Skills',
    subtitle: 'Characters move, enemies chase, the screen transitions between levels. Frame-rate timing, colour-based collision, the full character set, and flicker-free XOR drawing.',
    units: '16 units each',
    color: '#CCCC00',
    games: games.filter(g => g.phase === 'Skills'),
  },
  {
    number: 3,
    name: 'Projects',
    subtitle: 'Custom character sets, pixel graphics, UDGs, and machine code helpers. Your output looks like commercial Spectrum software — because you\'re using the same techniques.',
    units: '32 units each',
    color: '#00CC00',
    games: games.filter(g => g.phase === 'Projects'),
  },
  {
    number: 4,
    name: 'Advanced',
    subtitle: 'No new tricks — instead, use everything you know to create atmosphere, procedural worlds, and a graphical text adventure with autonomous NPCs.',
    units: '32–64 units',
    color: '#0000CC',
    games: games.filter(g => g.phase === 'Advanced'),
  },
].filter(p => p.games.length > 0);
---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC by building complete games. A gateway curriculum preparing you for Z80 assembly."
>
  <style>
    .system-hero {
      min-height: 300px;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-12) var(--space-4);
    }

    .hero-content {
      text-align: center;
      padding: var(--space-4);
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-script);
      font-size: clamp(2.6rem, 6vw, 4.5rem);
      font-weight: 700;
      line-height: 0.95;
      color: var(--color-text);
      margin-bottom: var(--space-4);
    }

    .system-subtitle {
      font-size: 1.25rem;
      color: var(--color-text-secondary);
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.9rem;
      font-weight: 800;
      margin-bottom: var(--space-2);
    }
    .section-title::after {
      content: "";
      display: block;
      width: 52px;
      height: 4px;
      background: var(--platform-color, #cc0000);
      margin: var(--space-3) 0 0;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .phase-group {
      margin-bottom: var(--space-12);
    }

    .phase-header {
      display: flex;
      align-items: flex-start;
      gap: var(--space-5);
      margin-bottom: var(--space-6);
      padding: var(--space-5) var(--space-6);
      background: var(--color-surface);
      border-radius: 0.75rem;
      border-left: 4px solid #444444;
    }

    .phase-number {
      font-family: var(--font-family-mono);
      font-size: 2.5rem;
      font-weight: 900;
      line-height: 1;
      color: #444444;
      flex-shrink: 0;
    }

    .phase-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .phase-name {
      font-size: 1.35rem;
      font-weight: 700;
    }

    .phase-subtitle {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .phase-games-count {
      font-family: var(--font-family-mono);
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      margin-top: var(--space-1);
    }

    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    /* Game cards — with and without thumbnails */
    .game-card {
      display: flex;
      align-items: stretch;
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      overflow: hidden;
      opacity: 0.6;
    }

    .game-card.available {
      opacity: 1;
      cursor: pointer;
      transition: all var(--transition-base);
    }

    .game-card.available:hover {
      border-color: #444444;
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    /* Thumbnail */
    .game-thumbnail {
      flex-shrink: 0;
      width: 180px;
      overflow: hidden;
      background: #000;
    }

    .game-thumbnail img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
      image-rendering: crisp-edges;
    }

    /* Card body */
    .game-body {
      flex: 1;
      display: flex;
      gap: var(--space-6);
      padding: var(--space-6);
      min-width: 0;
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--color-text-secondary);
      width: 3rem;
      text-align: center;
      flex-shrink: 0;
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      flex: 1;
      min-width: 0;
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .game-tagline {
      color: var(--color-text-secondary);
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-bg);
      color: var(--color-text-secondary);
      border-radius: 0.25rem;
    }

    .game-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-2);
      flex-shrink: 0;
    }

    .game-status {
      font-size: 0.75rem;
      font-weight: 600;
      padding: var(--space-1) var(--space-2);
      border-radius: 0.25rem;
    }

    .game-status.complete {
      color: #16a34a;
      background: rgba(22, 163, 74, 0.1);
    }

    .game-status.in-progress {
      color: #d97706;
      background: rgba(217, 119, 6, 0.1);
    }

    .game-status.coming-soon {
      color: var(--color-text-secondary);
      background: var(--color-border);
    }

    .game-units {
      font-family: var(--font-family-mono);
      font-size: 0.7rem;
      color: var(--color-text-secondary);
    }

    .next-step {
      background: var(--color-surface);
      border: 2px solid #444444;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-top: var(--space-8);
    }

    .next-step h3 {
      color: #444444;
      margin-bottom: var(--space-2);
    }

    @media (max-width: 768px) {
      .phase-header {
        padding: var(--space-4);
        gap: var(--space-3);
      }

      .phase-number {
        font-size: 1.75rem;
      }

      .game-thumbnail {
        width: 100px;
      }

      .game-body {
        flex-direction: column;
        gap: var(--space-3);
      }

      .game-number {
        width: auto;
        font-size: 1.5rem;
      }

      .game-meta {
        flex-direction: row;
        align-items: center;
      }
    }

    @media (max-width: 480px) {
      .game-thumbnail {
        display: none;
      }
    }
  </style>

  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">Sinclair BASIC</h1>
      <p class="system-subtitle">Learn programming from scratch by building 16 complete games</p>
    </div>
  </section>

  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      16 complete games teaching Sinclair BASIC from absolute zero to a graphical text adventure with autonomous NPCs. Start with a number guessing game, finish with a haunted manor.
    </p>

    {phases.map((phase) => (
      <div class="phase-group">
        <div class="phase-header" style={`border-left-color: ${phase.color}`}>
          <span class="phase-number" style={`color: ${phase.color}`}>{phase.number}</span>
          <div class="phase-text">
            <span class="phase-name">{phase.name}</span>
            <span class="phase-subtitle">{phase.subtitle}</span>
            <span class="phase-games-count">{phase.games.length} games · {phase.units}</span>
          </div>
        </div>
        <div class="game-grid">
          {phase.games.map((game) => {
            const isAvailable = game.status === 'complete' || game.status === 'in-progress';
            const statusLabel = game.status === 'complete' ? 'Complete' : game.status === 'in-progress' ? 'In Progress' : 'Coming Soon';
            const statusClass = game.status === 'complete' ? 'complete' : game.status === 'in-progress' ? 'in-progress' : 'coming-soon';
            return (
              <a href={`/sinclair-zx-spectrum/basic/${game.slug}`} class={`game-card${isAvailable ? ' available' : ''}`}>
                {game.thumbnail && (
                  <div class="game-thumbnail">
                    <img src={game.thumbnail} alt="" loading="lazy" />
                  </div>
                )}
                <div class="game-body">
                  <div class="game-number">{game.number}</div>
                  <div class="game-info">
                    <div class="game-name">{game.name}</div>
                    <div class="game-tagline">{game.tagline}</div>
                    <div class="game-skills">
                      {game.skills.map((skill: string) => (
                        <span class="skill-tag">{skill}</span>
                      ))}
                    </div>
                  </div>
                  <div class="game-meta">
                    <span class={`game-status ${statusClass}`}>{statusLabel}</span>
                    {game.units > 0 && (
                      <span class="game-units">
                        {game.unitsAvailable}/{game.units} units
                      </span>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}

    <div class="next-step">
      <h3>After BASIC</h3>
      <p>BASIC is not a prerequisite for assembly — the two tracks are independent. But completing these 16 games gives you a deep understanding of the Spectrum's colour model, screen layout, and what BASIC can (and can't) do. Ready for raw speed? Try <a href="/sinclair-zx-spectrum/assembly">Z80 Assembly</a>.</p>
    </div>
  </section>
</Layout>
