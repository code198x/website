---
import Layout from '../../../layouts/Layout.astro';
import { getGamesWithAvailability } from '../../../lib/games';

const games = await getGamesWithAvailability('sinclair-zx-spectrum', 'basic');
---

<Layout
  title="ZX Spectrum BASIC – Learn Programming Through Games"
  description="Learn Sinclair BASIC by building complete games. A gateway curriculum preparing you for Z80 assembly."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #444444 0%, #666666 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
    }

    .game-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    /* Game cards — with and without thumbnails */
    .game-card {
      display: flex;
      align-items: stretch;
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      overflow: hidden;
      opacity: 0.6;
    }

    .game-card.available {
      opacity: 1;
      cursor: pointer;
      transition: all var(--transition-base);
    }

    .game-card.available:hover {
      border-color: #444444;
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    /* Thumbnail */
    .game-thumbnail {
      flex-shrink: 0;
      width: 180px;
      overflow: hidden;
      background: #000;
    }

    .game-thumbnail img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
      image-rendering: crisp-edges;
    }

    /* Card body */
    .game-body {
      flex: 1;
      display: flex;
      gap: var(--space-6);
      padding: var(--space-6);
      min-width: 0;
    }

    .game-number {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--color-text-secondary);
      width: 3rem;
      text-align: center;
      flex-shrink: 0;
    }

    .game-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      flex: 1;
      min-width: 0;
    }

    .game-name {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .game-tagline {
      color: var(--color-text-secondary);
    }

    .game-skills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .skill-tag {
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-2);
      background: var(--color-bg);
      color: var(--color-text-secondary);
      border-radius: 0.25rem;
    }

    .game-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-2);
      flex-shrink: 0;
    }

    .game-status {
      font-size: 0.75rem;
      font-weight: 600;
      padding: var(--space-1) var(--space-2);
      border-radius: 0.25rem;
    }

    .game-status.complete {
      color: #16a34a;
      background: rgba(22, 163, 74, 0.1);
    }

    .game-status.in-progress {
      color: #d97706;
      background: rgba(217, 119, 6, 0.1);
    }

    .game-status.coming-soon {
      color: var(--color-text-secondary);
      background: var(--color-border);
    }

    .game-units {
      font-family: var(--font-family-mono);
      font-size: 0.7rem;
      color: var(--color-text-secondary);
    }

    .next-step {
      background: var(--color-surface);
      border: 2px solid #444444;
      border-radius: 0.75rem;
      padding: var(--space-6);
      margin-top: var(--space-8);
    }

    .next-step h3 {
      color: #444444;
      margin-bottom: var(--space-2);
    }

    @media (max-width: 768px) {
      .game-thumbnail {
        width: 100px;
      }

      .game-body {
        flex-direction: column;
        gap: var(--space-3);
      }

      .game-number {
        width: auto;
        font-size: 1.5rem;
      }

      .game-meta {
        flex-direction: row;
        align-items: center;
      }
    }

    @media (max-width: 480px) {
      .game-thumbnail {
        display: none;
      }
    }
  </style>

  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">SINCLAIR BASIC</h1>
      <p class="system-subtitle">Learn programming from scratch by building 16 complete games</p>
    </div>
  </section>

  <section class="content-section">
    <h2 class="section-title">Games</h2>
    <p class="section-intro">
      16 complete games teaching Sinclair BASIC from absolute zero to a graphical text adventure with autonomous NPCs. Start with a number guessing game, finish with a haunted manor.
    </p>

    <div class="game-grid">
      {games.map((game) => {
        const isAvailable = game.status === 'complete' || game.status === 'in-progress';
        const statusLabel = game.status === 'complete' ? 'Complete' : game.status === 'in-progress' ? 'In Progress' : 'Coming Soon';
        const statusClass = game.status === 'complete' ? 'complete' : game.status === 'in-progress' ? 'in-progress' : 'coming-soon';
        return (
          <a href={`/sinclair-zx-spectrum/basic/${game.slug}`} class={`game-card${isAvailable ? ' available' : ''}`}>
            {game.thumbnail && (
              <div class="game-thumbnail">
                <img src={game.thumbnail} alt="" loading="lazy" />
              </div>
            )}
            <div class="game-body">
              <div class="game-number">{game.number}</div>
              <div class="game-info">
                <div class="game-name">{game.name}</div>
                <div class="game-tagline">{game.tagline}</div>
                <div class="game-skills">
                  {game.skills.map((skill) => (
                    <span class="skill-tag">{skill}</span>
                  ))}
                </div>
              </div>
              <div class="game-meta">
                <span class={`game-status ${statusClass}`}>{statusLabel}</span>
                {game.units > 0 && (
                  <span class="game-units">
                    {game.unitsAvailable}/{game.units} units
                  </span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="next-step">
      <h3>After BASIC</h3>
      <p>BASIC is not a prerequisite for assembly — the two tracks are independent. But completing these 16 games gives you a deep understanding of the Spectrum's colour model, screen layout, and what BASIC can (and can't) do. Ready for raw speed? Try <a href="/sinclair-zx-spectrum/assembly">Z80 Assembly</a>.</p>
    </div>
  </section>
</Layout>
