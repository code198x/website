---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="ZX Spectrum - Learn Z80 Assembly">
  <style>
    .system-hero {
      min-height: 400px;
      background: linear-gradient(135deg, #ff00ff 0%, #00ffff 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .system-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(0, 0, 0, 0.1) 2px,
          rgba(0, 0, 0, 0.1) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
    }

    .system-subtitle {
      font-size: 1.5rem;
      margin-bottom: var(--space-6);
    }

    .system-specs {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-6);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.875rem;
      opacity: 0.9;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-16) var(--space-4);
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .coming-soon-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-align: center;
      margin: var(--space-8) auto;
      max-width: 600px;
    }

    .coming-soon-icon {
      font-size: 4rem;
      margin-bottom: var(--space-4);
    }

    .coming-soon-title {
      font-size: 1.5rem;
      color: var(--color-text);
      margin-bottom: var(--space-3);
    }

    .coming-soon-text {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .feature-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-6);
    }

    .feature-title {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      color: #ff00ff;
      margin-bottom: var(--space-3);
    }

    .feature-description {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .attribute-clash-demo {
      background: var(--color-surface);
      border: 2px solid #ff00ff;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
      font-family: var(--font-family-mono);
    }

    .clash-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 2px;
      margin-top: var(--space-4);
    }

    .clash-cell {
      aspect-ratio: 1;
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
    }

    .clash-cell.ink {
      background: #ff00ff;
      color: white;
    }

    .clash-cell.paper {
      background: #00ffff;
      color: black;
    }

    .memory-map {
      background: var(--color-surface);
      border: 2px solid #ff00ff;
      border-radius: 0.5rem;
      padding: var(--space-6);
      margin: var(--space-8) 0;
      font-family: var(--font-family-mono);
    }

    .memory-region {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .memory-region:last-child {
      border-bottom: none;
    }

    .memory-address {
      color: #ff00ff;
      font-weight: bold;
    }

    .memory-description {
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .system-specs {
        gap: var(--space-4);
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">ZX SPECTRUM</h1>
      <p class="system-subtitle">The computer that defined British gaming</p>

      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">Z80A</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">3.5 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">48 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Released</div>
          <div class="spec-value">1982</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Notice -->
  <section class="content-section">
    <div class="coming-soon-card">
      <div class="coming-soon-icon">🚧</div>
      <h2 class="coming-soon-title">Lessons Coming Soon</h2>
      <p class="coming-soon-text">
        We're currently building the ZX Spectrum assembly course. Soon you'll be mastering
        attribute clash, creating beeper music, and building games in Z80 assembly.
        Watch the repository for updates!
      </p>
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="content-section">
    <h2 class="section-title">What You'll Learn</h2>

    <div class="feature-grid">
      <div class="feature-card">
        <h3 class="feature-title">Z80 Assembly</h3>
        <p class="feature-description">
          Master the Z80 processor with its rich instruction set,
          16-bit operations, and powerful indexing modes.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Attribute System</h3>
        <p class="feature-description">
          Turn the infamous attribute clash from limitation to feature.
          Learn to design within the 8×8 colour grid constraints.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Beeper Audio</h3>
        <p class="feature-description">
          Create music and sound effects with just a piezo beeper.
          From simple beeps to multi-channel music routines.
        </p>
      </div>

      <div class="feature-card">
        <h3 class="feature-title">Tape Loading</h3>
        <p class="feature-description">
          Understand the legendary loading system. Create custom loaders
          with your own loading screens and music.
        </p>
      </div>
    </div>
  </section>

  <!-- Attribute Clash Demo -->
  <section class="content-section">
    <h2 class="section-title">The Famous Attribute Clash</h2>

    <div class="attribute-clash-demo">
      <p style="margin-bottom: var(--space-4); color: var(--color-text-secondary);">
        Each 8×8 pixel block can only have two colours: INK (foreground) and PAPER (background)
      </p>

      <div class="clash-grid">
        <div class="clash-cell ink">I</div>
        <div class="clash-cell ink">N</div>
        <div class="clash-cell ink">K</div>
        <div class="clash-cell paper"></div>
        <div class="clash-cell paper">P</div>
        <div class="clash-cell paper">A</div>
        <div class="clash-cell paper">P</div>
        <div class="clash-cell paper">R</div>
      </div>

      <p style="margin-top: var(--space-4); font-size: 0.875rem; color: var(--color-text-secondary);">
        This constraint led to the Spectrum's unique visual style and clever workarounds
      </p>
    </div>
  </section>

  <!-- Memory Map Preview -->
  <section class="content-section">
    <h2 class="section-title">ZX Spectrum Memory Map</h2>

    <div class="memory-map">
      <div class="memory-region">
        <span class="memory-address">£0000-£3FFF</span>
        <span class="memory-description">ROM (16K)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">£4000-£57FF</span>
        <span class="memory-description">Screen Memory (6K)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">£5800-£5AFF</span>
        <span class="memory-description">Attributes (768 bytes)</span>
      </div>
      <div class="memory-region">
        <span class="memory-address">£5B00-£FFFF</span>
        <span class="memory-description">User RAM</span>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="content-section" style="text-align: center;">
    <h2 class="section-title">Ready to Code Like It's 1982?</h2>
    <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6);">
      Follow the project on GitHub to be notified when ZX Spectrum lessons are available.
    </p>
    <a href="https://github.com/code198x"
       style="display: inline-block; padding: var(--space-3) var(--space-6);
              background: linear-gradient(135deg, #ff00ff 0%, #00ffff 100%);
              color: white; border-radius: 0.5rem;
              text-decoration: none; font-weight: 600;">
      Watch on GitHub
    </a>
  </section>
</Layout>