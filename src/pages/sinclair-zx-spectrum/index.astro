---
import Layout from '../../layouts/Layout.astro';
import { Binary, BookOpen } from '@lucide/astro';
---

<Layout
  title="ZX Spectrum – Learn Programming Through Games"
  description="Learn ZX Spectrum programming by building complete games. Choose between Sinclair BASIC for beginners or Z80 assembly for the full experience."
>
  <style>
    .system-hero {
      min-height: 350px;
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Rainbow stripe at the bottom - iconic Spectrum branding */
    .system-hero::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 8px;
      background: linear-gradient(90deg,
        #00FF00 0%, #00FF00 14.28%,
        #FFFF00 14.28%, #FFFF00 28.57%,
        #00FFFF 28.57%, #00FFFF 42.85%,
        #FF0000 42.85%, #FF0000 57.14%,
        #FF00FF 57.14%, #FF00FF 71.42%,
        #00FF00 71.42%, #00FF00 85.71%,
        #00FFFF 85.71%, #00FFFF 100%
      );
      z-index: 2;
    }

    /* Subtle scanline effect */
    .system-hero::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 255, 255, 0.05) 2px,
          rgba(255, 255, 255, 0.05) 4px
        );
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-8) var(--space-4);
      position: relative;
      z-index: 1;
      max-width: 800px;
    }

    .system-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      margin-bottom: var(--space-4);
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .system-subtitle {
      font-size: 1.25rem;
      opacity: 0.95;
      margin-bottom: var(--space-4);
    }

    .system-specs {
      display: flex;
      gap: var(--space-6);
      justify-content: center;
      flex-wrap: wrap;
      margin-top: var(--space-4);
    }

    .spec-item {
      text-align: center;
    }

    .spec-label {
      font-size: 0.75rem;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-value {
      font-family: var(--font-family-mono);
      font-size: 1rem;
      font-weight: bold;
    }

    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    /* Path Cards */
    .path-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .path-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-8);
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .path-card:hover {
      border-color: #cc0000;
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(204, 0, 0, 0.2);
    }

    /* Assembly path - technical appearance with subtle grid pattern */
    .path-card.recommended {
      border-color: #cc0000;
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, #cc0000 3%, var(--color-surface) 97%) 100%);
    }

    .path-card.recommended::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(90deg, rgba(204, 0, 0, 0.03) 1px, transparent 1px),
        linear-gradient(rgba(204, 0, 0, 0.03) 1px, transparent 1px);
      background-size: 20px 20px;
      pointer-events: none;
    }

    /* BASIC path - warmer, friendlier appearance */
    .path-card:not(.recommended) {
      background: linear-gradient(135deg, var(--color-surface) 0%, color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%) 100%);
    }

    .path-badge {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      font-size: 0.75rem;
      padding: var(--space-1) var(--space-3);
      background: #cc0000;
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
    }

    .path-icon {
      color: #cc0000;
      margin-bottom: var(--space-3);
    }

    .path-title {
      font-family: var(--font-family-mono);
      font-size: 1.75rem;
      font-weight: 900;
      color: #cc0000;
      margin-bottom: var(--space-2);
    }

    .path-subtitle {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
    }

    .path-description {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: var(--space-6);
      flex-grow: 1;
    }

    .path-stats {
      display: flex;
      gap: var(--space-6);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }

    .path-stat {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 1.5rem;
      font-weight: 900;
      color: #cc0000;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      text-transform: uppercase;
    }

    .path-cta {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: #cc0000;
      color: white;
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      margin-top: var(--space-4);
      text-align: center;
    }

    .path-card:not(.recommended) .path-cta {
      background: var(--color-surface);
      border: 2px solid #cc0000;
      color: #cc0000;
    }

    /* Vault Section */
    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .vault-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
    }

    .vault-title {
      font-size: 1.5rem;
      color: var(--color-text);
    }

    .vault-link {
      color: #cc0000;
      text-decoration: none;
      font-weight: 500;
    }

    .vault-link:hover {
      text-decoration: underline;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .vault-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .vault-card:hover {
      border-color: #cc0000;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .vault-kicker {
      display: block;
      font-size: 0.7rem;
      color: #cc0000;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-bottom: var(--space-1);
    }

    .vault-name {
      display: block;
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .vault-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* About Section */
    .about-section {
      padding: var(--space-10) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .about-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .about-text {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: var(--space-4);
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }

      .system-specs {
        gap: var(--space-4);
      }

      .vault-header {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
      }
    }
  </style>

  <!-- System Hero -->
  <section class="system-hero">
    <div class="hero-content">
      <h1 class="system-title">ZX SPECTRUM</h1>
      <p class="system-subtitle">Learn programming by building games</p>
      <div class="system-specs">
        <div class="spec-item">
          <div class="spec-label">CPU</div>
          <div class="spec-value">Zilog Z80</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Speed</div>
          <div class="spec-value">3.5 MHz</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">RAM</div>
          <div class="spec-value">48 KB</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Graphics</div>
          <div class="spec-value">ULA</div>
        </div>
        <div class="spec-item">
          <div class="spec-label">Sound</div>
          <div class="spec-value">Beeper</div>
        </div>
      </div>
    </div>
  </section>

  <!-- About This System -->
  <section class="about-section">
    <h2 class="about-title">Why the ZX Spectrum?</h2>
    <div class="about-text">
      <p>
        The ZX Spectrum ignited Britain's home computing revolution. When Clive Sinclair launched it in 1982 at just £125, he put colour computing within reach of ordinary families. Teenagers who'd never touched a computer were suddenly writing games in their bedrooms — and some of them became millionaires before they turned twenty.
      </p>
      <p>
        The Spectrum's famous limitations — its attribute-based colour system, single-channel beeper, and lack of hardware sprites — forced programmers to be ingenious. Learning to work within these constraints teaches problem-solving skills that transfer everywhere. The Z80 processor powers everything from arcade machines to embedded systems, and the Spectrum's vibrant community is still releasing new games and tools today.
      </p>
    </div>
  </section>

  <!-- Choose Your Path -->
  <section class="content-section">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-intro">
      Two ways to learn Spectrum game development. Start with Sinclair BASIC if you're new to programming, or dive straight into Z80 assembly for the full experience.
    </p>

    <div class="path-grid">
      <a href="/sinclair-zx-spectrum/assembly" class="path-card recommended">
        <span class="path-badge">Recommended</span>
        <div class="path-icon"><Binary size={32} /></div>
        <h3 class="path-title">Z80 Assembly</h3>
        <p class="path-subtitle">Full hardware control</p>
        <p class="path-description">
          Master the attribute system, software sprites, and every register of the Z80. Learn the techniques that made classics like Manic Miner, Jet Set Willy, and Knight Lore possible.
        </p>
        <div class="path-stats">
          <div class="path-stat">
            <div class="stat-value">16</div>
            <div class="stat-label">Games</div>
          </div>
          <div class="path-stat">
            <div class="stat-value">1,536</div>
            <div class="stat-label">Units</div>
          </div>
        </div>
        <span class="path-cta">Start Assembly Path</span>
      </a>

      <a href="/sinclair-zx-spectrum/basic" class="path-card">
        <div class="path-icon"><BookOpen size={32} /></div>
        <h3 class="path-title">Sinclair BASIC</h3>
        <p class="path-subtitle">Gateway curriculum</p>
        <p class="path-description">
          Rich built-in graphics commands (PLOT, DRAW, CIRCLE) make Sinclair BASIC an excellent starting point. Build 8 complete games while understanding the attribute system and UDGs — then graduate to assembly.
        </p>
        <div class="path-stats">
          <div class="path-stat">
            <div class="stat-value">8</div>
            <div class="stat-label">Games</div>
          </div>
          <div class="path-stat">
            <div class="stat-value">512</div>
            <div class="stat-label">Units</div>
          </div>
        </div>
        <span class="path-cta">Start BASIC Path</span>
      </a>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <div class="vault-header">
        <h2 class="vault-title">From the Vault</h2>
        <a href="/vault" class="vault-link">View all articles</a>
      </div>
      <div class="vault-grid">
        <a href="/vault/systems/zx-spectrum" class="vault-card">
          <span class="vault-kicker">Hardware</span>
          <span class="vault-name">ZX Spectrum</span>
          <span class="vault-desc">Britain's home computing revolution - the rubber-keyed wonder that launched a generation.</span>
        </a>
        <a href="/vault/people/matthew-smith" class="vault-card">
          <span class="vault-kicker">People</span>
          <span class="vault-name">Matthew Smith</span>
          <span class="vault-desc">Creator of Manic Miner and Jet Set Willy - games that defined platform gaming.</span>
        </a>
        <a href="/vault/people/oliver-twins" class="vault-card">
          <span class="vault-kicker">People</span>
          <span class="vault-name">The Oliver Twins</span>
          <span class="vault-desc">Philip and Andrew Oliver's Dizzy universe and the rise of budget gaming.</span>
        </a>
        <a href="/vault/games/dizzy" class="vault-card">
          <span class="vault-kicker">Games</span>
          <span class="vault-name">Dizzy</span>
          <span class="vault-desc">The egg-shaped adventurer's puzzle platforming that became a Codemasters phenomenon.</span>
        </a>
        <a href="/vault/culture/crash-magazine" class="vault-card">
          <span class="vault-kicker">Culture</span>
          <span class="vault-name">CRASH Magazine</span>
          <span class="vault-desc">Spectrum's legendary monthly that set the standard for games coverage.</span>
        </a>
        <a href="/vault/culture/your-sinclair" class="vault-card">
          <span class="vault-kicker">Culture</span>
          <span class="vault-name">Your Sinclair</span>
          <span class="vault-desc">The irreverent voice of Spectrum gaming with humour and heart.</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
