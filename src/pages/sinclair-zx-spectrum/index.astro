---
import Layout from '../../layouts/Layout.astro';
import SystemHero from '../../components/SystemHero.astro';
import PathCard from '../../components/PathCard.astro';
import VaultCard from '../../components/VaultCard.astro';
import SetupCallout from '../../components/SetupCallout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { Binary, BookOpen } from '@lucide/astro';
import { getTrackStatCards } from '../../lib/modules';

const platformColor = '#cc0000';

const specs = [
  { label: 'CPU', value: 'Zilog Z80' },
  { label: 'Speed', value: '3.5 MHz' },
  { label: 'RAM', value: '48 KB' },
  { label: 'Graphics', value: 'ULA' },
  { label: 'Sound', value: 'Beeper' },
];

const assemblyStats = await getTrackStatCards('sinclair-zx-spectrum', 'assembly');
const basicStats = await getTrackStatCards('sinclair-zx-spectrum', 'basic');

const vaultArticles = [
  {
    href: '/vault/systems/zx-spectrum',
    kicker: 'Hardware',
    title: 'ZX Spectrum',
    description: "Britain's home computing revolution - the rubber-keyed wonder that launched a generation.",
  },
  {
    href: '/vault/people/matthew-smith',
    kicker: 'People',
    title: 'Matthew Smith',
    description: 'Creator of Manic Miner and Jet Set Willy - games that defined platform gaming.',
  },
  {
    href: '/vault/people/oliver-twins',
    kicker: 'People',
    title: 'The Oliver Twins',
    description: "Philip and Andrew Oliver's Dizzy universe and the rise of budget gaming.",
  },
  {
    href: '/vault/games/dizzy',
    kicker: 'Games',
    title: 'Dizzy',
    description: "The egg-shaped adventurer's puzzle platforming that became a Codemasters phenomenon.",
  },
  {
    href: '/vault/magazines/crash-magazine',
    kicker: 'Culture',
    title: 'CRASH Magazine',
    description: "Spectrum's legendary monthly that set the standard for games coverage.",
  },
  {
    href: '/vault/magazines/your-sinclair',
    kicker: 'Culture',
    title: 'Your Sinclair',
    description: 'The irreverent voice of Spectrum gaming with humour and heart.',
  },
];
---

<Layout
  title="ZX Spectrum – Learn Programming Through Games"
  description="Learn ZX Spectrum programming by building complete games. Choose between Sinclair BASIC for beginners or Z80 assembly for the full experience."
  platformColor={platformColor}
>
  <style>
    .content-section {
      padding: var(--space-12) var(--space-4);
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.9rem;
      font-weight: 800;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      text-align: center;
    }

    .section-title::after,
    .about-title::after {
      content: "";
      display: block;
      width: 52px;
      height: 4px;
      background: var(--platform-color, #cc0000);
      margin: var(--space-3) auto 0;
    }

    .section-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 700px;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .path-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }

    .path-icon {
      color: var(--ink);
      margin-bottom: var(--space-3);
    }

    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: 1100px;
      margin: 0 auto;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .about-section {
      padding: var(--space-10) var(--space-4);
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .about-title {
      font-size: 1.5rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .about-text {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: var(--space-4);
    }

    .about-text p:last-child {
      margin-bottom: 0;
    }

    .afield-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      max-width: 1100px;
      margin: 0 auto;
    }
    .afield-card {
      background: var(--color-surface);
      border: 3px solid var(--color-border);
      box-shadow: var(--shadow-chunky);
      padding: var(--space-6);
    }
    .afield-card.whats-not {
      border-color: var(--platform-color, #cc0000);
    }
    .afield-kicker {
      font-family: var(--font-family-mono);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-3);
    }
    .afield-list { list-style: none; padding: 0; margin: 0; }
    .afield-list li {
      padding: var(--space-2) 0;
      border-bottom: 1px dashed var(--color-border);
    }
    .afield-list li:last-child { border-bottom: 0; }
    .afield-list a { font-weight: 600; color: var(--color-text); text-decoration: none; }
    .afield-list .desc { display: block; font-size: 0.85rem; color: var(--color-text-secondary); }
    .subscribe { display: flex; margin: var(--space-4) 0 var(--space-3); }
    .subscribe input {
      flex: 1; min-width: 0;
      font-family: var(--font-family-mono);
      font-size: 0.85rem;
      padding: var(--space-3);
      border: 3px solid var(--color-text);
      border-right: 0;
      background: var(--color-bg);
      color: var(--color-text);
    }
    .subscribe button {
      font-family: var(--font-family-mono);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      padding: 0 var(--space-4);
      border: 3px solid var(--platform-color, #cc0000);
      background: var(--platform-color, #cc0000);
      color: #fff;
      cursor: pointer;
    }
    .issue-link {
      font-family: var(--font-family-mono);
      font-size: 0.8rem;
      color: var(--ink);
      text-decoration: none;
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }
      .afield-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- System Hero -->
  <SystemHero
    title="ZX Spectrum"
    kicker="You found us · Live · UK · 1982"
    subtitle="Britain's home computing revolution"
    platformColor={platformColor}
    specs={specs}
    variant="paper"
    rainbowStripe
  />

  <!-- About This System -->
  <section class="about-section">
    <h2 class="about-title">Why the ZX Spectrum?</h2>
    <div class="about-text">
      <p>
        The ZX Spectrum ignited Britain's home computing revolution. When Clive Sinclair launched it
        in 1982 at just £125, he put colour computing within reach of ordinary families. Teenagers
        who'd never touched a computer were suddenly writing games in their bedrooms — and some of
        them became millionaires before they turned twenty.
      </p>
      <p>
        The Spectrum's famous limitations — its attribute-based colour system, single-channel
        beeper, and lack of hardware sprites — forced programmers to be ingenious. Learning to work
        within these constraints teaches problem-solving skills that transfer everywhere. The Z80
        processor powers everything from arcade machines to embedded systems, and the Spectrum's
        vibrant community is still releasing new games and tools today.
      </p>
    </div>
  </section>

  <!-- Quick Setup -->
  <SetupCallout dockerImage="ghcr.io/code198x/sinclair-zx-spectrum" />

  <!-- Choose Your Path -->
  <section class="content-section">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-intro">
      Two independent paths to Spectrum game development. Sinclair BASIC teaches programming
      from scratch. Z80 assembly gives you full hardware control. Pick whichever suits you.
    </p>

    <div class="path-grid">
      <PathCard
        href="/sinclair-zx-spectrum/assembly"
        title="Z80 Assembly"
        subtitle="Full hardware control"
        description="Master the attribute system, software sprites, and every register of the Z80. Learn the techniques that made classics like Manic Miner, Jet Set Willy, and Knight Lore possible."
        stats={assemblyStats}
        platformColor={platformColor}
        ctaText="Start Assembly Path"
      >
        <Binary size={32} class="path-icon" slot="icon" />
      </PathCard>

      <PathCard
        href="/sinclair-zx-spectrum/basic"
        title="Sinclair BASIC"
        subtitle="Learn to program"
        description="Learn programming from scratch through 16 complete games — from a number guessing game to a graphical text adventure with autonomous NPCs. No prerequisites, no prior experience needed."
        stats={basicStats}
        platformColor="#2f9e44"
        isRecommended
        ctaText="Start BASIC Path"
      >
        <BookOpen size={32} class="path-icon" slot="icon" />
      </PathCard>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <SectionHeader
        title="From the Vault"
        linkHref="/vault"
        linkText="View all articles"
        platformColor={platformColor}
      />
      <div class="vault-grid">
        {vaultArticles.map((article) => (
          <VaultCard
            href={article.href}
            kicker={article.kicker}
            title={article.title}
            description={article.description}
            platformColor={platformColor}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Further afield + what's not here yet (honest tier) -->
  <section class="content-section">
    <div class="afield-grid">
      <div class="afield-card">
        <div class="afield-kicker">Further afield</div>
        <ul class="afield-list">
          <li><a href="https://worldofspectrum.org/" target="_blank" rel="noopener">World of Spectrum ↗</a><span class="desc">archive of every release</span></li>
          <li><a href="https://en.wikipedia.org/wiki/ZX_Spectrum" target="_blank" rel="noopener">Wikipedia ↗</a><span class="desc">history &amp; technical specs</span></li>
          <li><a href="https://spectrumcomputing.co.uk/" target="_blank" rel="noopener">Spectrum Computing ↗</a><span class="desc">active community forum</span></li>
        </ul>
      </div>
      <div class="afield-card whats-not">
        <div class="afield-kicker">What's not here yet</div>
        <p>Shadowkeep Arcs 3 &amp; 4 · BASIC Volumes 3–4 · deeper Emu198x integration for automated checks and screenshots. All coming.</p>
        <a class="issue-link" href="https://discord.gg/AdmEYQKWZb" target="_blank" rel="noopener">Join the Discord · we post when things land ↗</a>
        <a class="issue-link" href="https://github.com/code198x" target="_blank" rel="noopener">Track progress · github.com/code198x ↗</a>
      </div>
    </div>
  </section>
</Layout>
