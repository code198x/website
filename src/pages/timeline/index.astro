---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Clock, ArrowRight } from '@lucide/astro';

// Get vault entries and extract year based on category
const vaultEntries = await getCollection('vault');

// Helper to get the primary year for a vault entry based on category
function getStartYear(e: typeof vaultEntries[0]): number | null {
  const d = e.data;
  switch (d.category) {
    case 'people': return d.born ?? null;
    case 'companies': return d.founded ?? null;
    case 'games': return d.released ?? null;
    case 'techniques': return d.originated ?? null;
    case 'culture': return d.emerged ?? null;
    case 'hardware':
    case 'systems': return d.introduced ?? null;
    default: return null;
  }
}

// Helper to get the end year for a vault entry (death, dissolution, etc.)
function getEndYear(e: typeof vaultEntries[0]): number | null {
  const d = e.data;
  switch (d.category) {
    case 'people': return d.died ?? null;
    case 'companies': return d.dissolved ?? null;
    case 'techniques': return d.deprecated ?? null;
    case 'culture': return d.ended ?? null;
    case 'hardware':
    case 'systems': return d.discontinued ?? null;
    default: return null;
  }
}

// Get vault events (excluding people - they get birth/death events instead)
const vaultEvents = vaultEntries
  .filter(e => e.data.category !== 'people' && getStartYear(e) !== null)
  .map(e => ({
    year: getStartYear(e) as number,
    category: e.data.category,
    type: 'vault' as const,
  }));

// Generate birth events for people
const birthEvents = vaultEntries
  .filter(e => e.data.category === 'people' && e.data.born !== null && e.data.born !== undefined)
  .map(e => ({
    year: e.data.born as number,
    category: 'people' as const,
    type: 'birth' as const,
  }));

// Generate death events
const deathEvents = vaultEntries
  .filter(e => e.data.category === 'people' && e.data.died !== null && e.data.died !== undefined)
  .map(e => ({
    year: e.data.died as number,
    category: 'people' as const,
    type: 'death' as const,
  }));

// Generate company closure events
const companyClosureEvents = vaultEntries
  .filter(e => e.data.category === 'companies' && e.data.dissolved !== null && e.data.dissolved !== undefined)
  .map(e => ({
    year: e.data.dissolved as number,
    category: 'companies' as const,
    type: 'closure' as const,
  }));

// Get global timeline events
const timelineEntries = await getCollection('timeline');
const globalEvents = timelineEntries.map(e => ({
  year: e.data.year,
  category: e.data.category,
  type: 'global' as const,
}));

// Merge all events
const allEvents = [...vaultEvents, ...birthEvents, ...deathEvents, ...companyClosureEvents, ...globalEvents];

// Group events by decade
const decades = [1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020];
const eventsByDecade = decades.map(decade => {
  const events = allEvents.filter(e => e.year >= decade && e.year < decade + 10);
  const systems = events.filter(e => e.category === 'systems').length;
  const games = events.filter(e => e.category === 'games').length;
  const people = events.filter(e => e.category === 'people').length;
  const global = events.filter(e => e.type === 'global').length;

  return {
    decade,
    total: events.length,
    systems,
    games,
    people,
    global,
    companies: events.filter(e => e.category === 'companies').length,
    culture: events.filter(e => e.category === 'culture').length,
  };
});

// Decade descriptions
const decadeDescriptions: Record<number, string> = {
  1920: "The birth of computing pioneers",
  1930: "Turing machines and early theory",
  1940: "WWII, ENIAC, and the computer age begins",
  1950: "Transistors and the first video games",
  1960: "Mainframes, space race, and semiconductors",
  1970: "Microprocessors, arcades, and home computing",
  1980: "The golden age of 8-bit and 16-bit",
  1990: "3D graphics, CD-ROMs, and the web",
  2000: "Mobile gaming and the indie revolution",
  2010: "Retro revival and crowdfunding",
  2020: "Nostalgia, preservation, and new frontiers",
};
---

<Layout title="Timeline" description="A visual timeline of computing history from the 1920s to present, organised by decade.">
  <style>
    /* Animations */
    @keyframes float-1 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(15px, -20px) rotate(5deg); }
      50% { transform: translate(-10px, -35px) rotate(-3deg); }
      75% { transform: translate(20px, -15px) rotate(8deg); }
    }

    @keyframes float-2 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(-20px, 15px) rotate(-8deg); }
      50% { transform: translate(15px, 25px) rotate(5deg); }
      75% { transform: translate(-25px, 10px) rotate(-5deg); }
    }

    @keyframes float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(25px, -20px) scale(1.1); }
      66% { transform: translate(-15px, 15px) scale(0.95); }
    }

    @keyframes float-4 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      50% { transform: translate(-30px, -25px) rotate(180deg); }
    }

    @keyframes float-5 {
      0%, 100% { transform: translate(0, 0) rotate(45deg); }
      50% { transform: translate(20px, 30px) rotate(135deg); }
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.6; }
    }

    @keyframes scanline-beam {
      0% { top: -10%; }
      100% { top: 110%; }
    }

    .timeline-index {
      min-height: 100vh;
      background: var(--color-bg);
    }

    /* Hero Section */
    .hero {
      min-height: 380px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Animated shapes */
    .hero-shapes {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .shape {
      position: absolute;
      opacity: 0.35;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    /* Shape 1: Square - top left (amber/gold for time theme) */
    .shape-1 {
      top: 12%;
      left: 8%;
      width: 60px;
      height: 60px;
      border: 3px solid #fbbf24;
      box-shadow: 0 0 20px #fbbf24, inset 0 0 10px rgba(251, 191, 36, 0.1);
      animation: float-1 14s infinite, pulse-glow 5s infinite;
    }

    /* Shape 2: Circle - top right (cyan) */
    .shape-2 {
      top: 18%;
      right: 12%;
      width: 50px;
      height: 50px;
      border: 3px solid #38bdf8;
      border-radius: 50%;
      box-shadow: 0 0 20px #38bdf8;
      animation: float-2 16s infinite, pulse-glow 6s infinite 1s;
    }

    /* Shape 3: Diamond - left (purple) */
    .shape-3 {
      bottom: 25%;
      left: 12%;
      width: 45px;
      height: 45px;
      border: 3px solid #a78bfa;
      transform: rotate(45deg);
      box-shadow: 0 0 20px #a78bfa;
      animation: float-3 18s infinite, pulse-glow 7s infinite 2s;
    }

    /* Shape 4: Small circle - bottom right (pink) */
    .shape-4 {
      bottom: 20%;
      right: 15%;
      width: 35px;
      height: 35px;
      border: 3px solid #f472b6;
      border-radius: 50%;
      box-shadow: 0 0 15px #f472b6;
      animation: float-4 20s infinite, pulse-glow 4s infinite;
    }

    /* Shape 5: Triangle - bottom center-right (teal) */
    .shape-5 {
      bottom: 30%;
      right: 25%;
      width: 0;
      height: 0;
      border-left: 25px solid transparent;
      border-right: 25px solid transparent;
      border-bottom: 40px solid #64ffda;
      filter: drop-shadow(0 0 15px #64ffda);
      animation: float-5 22s infinite, pulse-glow 8s infinite 3s;
    }

    /* Grid overlay */
    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 1;
    }

    /* Scanlines */
    .hero-scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
      );
      pointer-events: none;
      z-index: 2;
    }

    /* Animated beam */
    .hero-beam {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(251, 191, 36, 0.1) 20%,
        rgba(251, 191, 36, 0.3) 50%,
        rgba(251, 191, 36, 0.1) 80%,
        transparent 100%
      );
      animation: scanline-beam 10s linear infinite;
      pointer-events: none;
      z-index: 3;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-10) var(--space-4);
      position: relative;
      z-index: 5;
      max-width: 700px;
    }

    .hero-icon {
      color: #fbbf24;
      margin-bottom: var(--space-4);
      filter: drop-shadow(0 0 20px rgba(251, 191, 36, 0.5));
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: 0.05em;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5), 0 0 40px rgba(251, 191, 36, 0.3);
    }

    .hero-subtitle {
      font-size: 1.25rem;
      opacity: 0.9;
      margin-bottom: var(--space-6);
      font-style: italic;
      text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      flex-wrap: wrap;
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(4px);
      padding: var(--space-4) var(--space-8);
      border-radius: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .hero-stats .stat-item {
      text-align: center;
      background: transparent;
      padding: 0;
    }

    .hero-stats .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: #fbbf24;
      text-shadow: 0 0 20px rgba(251, 191, 36, 0.5);
    }

    .hero-stats .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
      .shape {
        animation: none;
      }
      .hero-beam {
        animation: none;
        opacity: 0;
      }
    }

    @media (max-width: 768px) {
      .shape {
        opacity: 0.2;
      }
      .shape-1, .shape-2, .shape-3, .shape-4 {
        width: 35px;
        height: 35px;
      }
    }

    .decades-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .decades-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: var(--space-6);
    }

    .decade-card {
      display: block;
      padding: 3px;
      background: var(--color-border);
      text-decoration: none;
      color: var(--color-text);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .decade-card-inner {
      background: var(--color-surface);
      padding: var(--space-6);
      height: 100%;
      position: relative;
      z-index: 1;
      transition: background 0.3s ease;
    }

    /* Animated border gradient on hover */
    .decade-card-glow {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        #fbbf24 0%,
        #38bdf8 50%,
        #a78bfa 100%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 0;
    }

    /* Corner decorations */
    .decade-corner {
      position: absolute;
      width: 12px;
      height: 12px;
      border-color: #fbbf24;
      border-style: solid;
      border-width: 0;
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 2;
    }

    .decade-corner.tl { top: 5px; left: 5px; border-top-width: 2px; border-left-width: 2px; }
    .decade-corner.tr { top: 5px; right: 5px; border-top-width: 2px; border-right-width: 2px; }
    .decade-corner.bl { bottom: 5px; left: 5px; border-bottom-width: 2px; border-left-width: 2px; }
    .decade-corner.br { bottom: 5px; right: 5px; border-bottom-width: 2px; border-right-width: 2px; }

    .decade-card:hover,
    .decade-card:focus-visible {
      transform: translateY(-6px);
      box-shadow:
        0 16px 32px rgba(0, 0, 0, 0.15),
        0 0 25px rgba(251, 191, 36, 0.2);
    }

    .decade-card:hover .decade-card-glow,
    .decade-card:focus-visible .decade-card-glow {
      opacity: 1;
    }

    .decade-card:hover .decade-corner,
    .decade-card:focus-visible .decade-corner {
      opacity: 1;
    }

    .decade-card:focus-visible {
      outline: 2px solid #fbbf24;
      outline-offset: 2px;
    }

    .decade-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: var(--space-4);
    }

    .decade-year {
      font-family: var(--font-family-mono);
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--color-primary);
      line-height: 1;
      transition: all 0.3s ease;
    }

    .decade-card:hover .decade-year {
      color: #fbbf24;
      text-shadow: 0 0 20px rgba(251, 191, 36, 0.5);
    }

    .decade-arrow {
      color: var(--color-text-muted);
      transition: all 0.3s ease;
    }

    .decade-card:hover .decade-arrow {
      transform: translateX(4px);
      color: #fbbf24;
    }

    .decade-description {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
      line-height: 1.5;
    }

    .decade-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-2);
    }

    .decade-stats .stat-item {
      text-align: center;
      padding: var(--space-2);
      background: var(--color-bg);
      border-radius: 0.5rem;
    }

    .stat-number {
      font-family: var(--font-family-mono);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .stat-name {
      font-size: 0.65rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
    }

    .total-badge {
      position: absolute;
      top: var(--space-6);
      right: var(--space-6);
      background: var(--color-primary);
      color: white;
      font-family: var(--font-family-mono);
      font-size: 0.875rem;
      font-weight: 700;
      padding: var(--space-1) var(--space-3);
      border-radius: 9999px;
      z-index: 3;
      transition: all 0.3s ease;
    }

    .decade-card:hover .total-badge {
      background: #fbbf24;
      box-shadow: 0 0 15px rgba(251, 191, 36, 0.5);
    }

    .intro-text {
      max-width: 800px;
      margin: 0 auto var(--space-8);
      text-align: center;
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    /* Reduced motion for cards */
    @media (prefers-reduced-motion: reduce) {
      .decade-card:hover,
      .decade-card:focus-visible {
        transform: none;
      }
    }

    @media (max-width: 768px) {
      .decades-grid {
        grid-template-columns: 1fr;
      }

      .decade-stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <div class="timeline-index">
    <section class="hero">
      <!-- Animated background shapes -->
      <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
      </div>

      <!-- Grid overlay -->
      <div class="hero-grid"></div>

      <!-- Scanlines -->
      <div class="hero-scanlines"></div>

      <!-- Animated beam -->
      <div class="hero-beam"></div>

      <div class="hero-content">
        <div class="hero-icon"><Clock size={48} /></div>
        <h1 class="hero-title">The Timeline</h1>
        <p class="hero-subtitle">Computing history in context: 1920s–present</p>
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-value">{allEvents.length}</div>
            <div class="stat-label">Total Events</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">{decades.length}</div>
            <div class="stat-label">Decades</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">{globalEvents.length}</div>
            <div class="stat-label">World Events</div>
          </div>
        </div>
      </div>
    </section>

    <div class="decades-container">
      <p class="intro-text">
        Explore computing history decade by decade. From the theoretical foundations of the 1930s
        through the golden age of home computing in the 1980s to the retro revival of today.
        Each decade page shows systems, games, people, and world events in chronological context.
      </p>

      <div class="decades-grid">
        {eventsByDecade.map(({ decade, total, systems, games, people, global }) => (
          <a href={`/timeline/${decade}s`} class="decade-card">
            <div class="decade-card-glow"></div>
            <div class="decade-card-inner">
              <span class="total-badge">{total}</span>
              <div class="decade-header">
                <span class="decade-year">{decade}s</span>
                <span class="decade-arrow"><ArrowRight size={24} /></span>
              </div>
              <p class="decade-description">{decadeDescriptions[decade]}</p>
              <div class="decade-stats">
                <div class="stat-item">
                  <div class="stat-number">{systems}</div>
                  <div class="stat-name">Systems</div>
                </div>
                <div class="stat-item">
                  <div class="stat-number">{games}</div>
                  <div class="stat-name">Games</div>
                </div>
                <div class="stat-item">
                  <div class="stat-number">{people}</div>
                  <div class="stat-name">People</div>
                </div>
                <div class="stat-item">
                  <div class="stat-number">{global}</div>
                  <div class="stat-name">World</div>
                </div>
              </div>
            </div>
            <div class="decade-corner tl"></div>
            <div class="decade-corner tr"></div>
            <div class="decade-corner bl"></div>
            <div class="decade-corner br"></div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
