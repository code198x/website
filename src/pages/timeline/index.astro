---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TimelineStories from '../../components/TimelineStories.astro';
import { timelineStories } from '../../data/timeline-stories';
import { timelineEvents, timelineDecades, decadeEvents, eventTotals, resolveStories } from '../../lib/timeline';
import '../../styles/timeline.css';
const [vault, world] = await Promise.all([getCollection('vault'), getCollection('timeline')]);
const events = timelineEvents(vault, world);
const decades = timelineDecades(events);
const stories = resolveStories(timelineStories, vault);
const totals = eventTotals(events);
---
<Layout title="Timeline" description="Follow connected stories through computing history, then explore the machines, games, people and world events in each decade." masthead={false}>
  <div class="timeline-page">
    <header class="timeline-heading"><h1>Nothing happened<br /><em>in isolation.</em></h1><div><p>A computer leads to a game. A game needs a new technique. A tool lets someone else begin. Follow those connections through time.</p><a href="#chronology">Browse the full chronology</a></div></header>
    <TimelineStories stories={stories}/>
    <section class="timeline-chronology" id="chronology" aria-labelledby="chronology-title">
      <header><h2 id="chronology-title">Find your decade.</h2><p>{totals.total.toLocaleString('en-GB')} events: {totals.vault.toLocaleString('en-GB')} from the Vault and {totals.world} world events. Choose a decade to explore.</p></header>
      <ol class="timeline-decades">{decades.map(decade=>{
        const entries=decadeEvents(events,decade);const counts=eventTotals(entries);
        const examples=entries.filter(event=>event.reviewed && event.type==='subject').slice(0,3);
        return <li><a href={`/timeline/${decade}s/`}><h3>{decade}s</h3><p>{examples.length ? examples.map(event=>event.title).join(' · ') : 'People and events recorded in this decade'}</p><span><strong>{counts.total} {counts.total === 1 ? 'event' : 'events'}</strong> · {counts.vault} Vault · {counts.world} world</span></a></li>;
      })}</ol>
    </section>
    <section class="timeline-coverage" aria-labelledby="coverage-title"><h2 id="coverage-title">What’s in the chronology?</h2><p>Dates recorded in Vault articles, alongside our world-event entries. We include subject beginnings, births, deaths and company endings; an article can appear more than once. Unknown dates stay out. This is a route through the collection, not a complete history of computing.</p><p>The stories above use reviewed articles. The full chronology also labels entries that have not yet been fact-checked; follow each article for its sources and review status.</p><a href="/vault/">Explore the Vault by subject</a></section>
  </div>
</Layout>
