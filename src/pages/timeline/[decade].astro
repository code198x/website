---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageFrame from '../../components/PageFrame.astro';
import Switcher from '../../components/layout/Switcher.astro';
import Cluster from '../../components/layout/Cluster.astro';
import TimelineEvents from '../../components/TimelineEvents.astro';
import { timelineStories } from '../../data/timeline-stories';
import { timelineEvents, timelineDecades, decadeEvents, eventTotals, resolveStories } from '../../lib/timeline';
import { getVaultCategories } from '../../lib/categories';
import '../../styles/timeline.css';
export async function getStaticPaths() {
  const [vault,world] = await Promise.all([getCollection('vault'),getCollection('timeline')]);
  const events=timelineEvents(vault,world);const decades=timelineDecades(events);
  const stories=resolveStories(timelineStories,vault);
  return decades.map((decade,index)=>({params:{decade:`${decade}s`},props:{decade,events:decadeEvents(events,decade),previous:decades[index-1],next:decades[index+1],stories:stories.filter(story=>story.steps.some(step=>step.year>=decade&&step.year<decade+10))}}));
}
const {decade,events,previous,next,stories}=Astro.props;
const totals=eventTotals(events);
const labels=Object.fromEntries((await getVaultCategories()).map(category=>[category.id,category.data.name]));
Object.assign(labels,{politics:'Politics',technology:'Technology',economics:'Economics',science:'Science'});
---
<Layout title={`${decade}s Timeline`} description={`Explore the recorded machines, games, people, tools and world events from ${decade} to ${decade+9}.`}>
  <PageFrame class="timeline-page" opening="none">
    <Switcher as="header" class="timeline-heading decade-heading" threshold="54rem"><h1>The <em>{decade}s.</em></h1><div><p>See what appeared alongside what you already know. Follow an event into the Vault, or narrow the decade to a subject.</p><p class="timeline-totals" data-total={totals.total}>{totals.total} events · {totals.vault} Vault · {totals.world} world</p></div></Switcher>
    <Cluster as="nav" class="timeline-decade-nav" space={6} align="stretch" aria-label="Decades">{previous!==undefined&&<a href={`/timeline/${previous}s/`}>← {previous}s</a>}<a href="/timeline/#chronology">All decades</a>{next!==undefined&&<a href={`/timeline/${next}s/`}>{next}s →</a>}</Cluster>
    {stories.length>0&&<Cluster as="aside" class="timeline-story-links" align="baseline" aria-label="Stories through this decade"><h2>Follow a connection.</h2><Cluster as="ul" align="stretch">{stories.map(story=><li><a href={`/timeline/?story=${story.id}#story-${story.id}`}>{story.title}</a></li>)}</Cluster></Cluster>}
    <TimelineEvents events={events} labels={labels}/>
    <footer class="timeline-coverage"><p>Dates come from Vault article metadata and the world-event collection. Births, deaths and company endings are separate events. Unknown dates are omitted; unreviewed articles are labelled.</p><a href="/timeline/">Choose another story or decade</a></footer>
  </PageFrame>
</Layout>
