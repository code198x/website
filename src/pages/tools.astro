---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import "../styles/tools.css";
---

<Layout title="Tools" description="Essential development tools, assemblers, and emulators for classic 8-bit and 16-bit system programming. Everything you need to start coding retro games and demos.">
  <div class="tools">
    <section class="tools__hero">
      <div class="tools__hero-content">
        <h1 class="tools__title">Development Tools</h1>
        <p class="tools__description">
          Essential assemblers, emulators, and development environments for classic system programming.
          All tested and ready to use in our Docker environment.
        </p>
      </div>
    </section>

    <section class="tools__section tools__section--assemblers">
      <div class="tools__section-header">
        <h2 class="tools__section-title">Assemblers</h2>
        <p class="tools__section-description">
          Professional-grade assemblers for each platform, all pre-configured in our development environment.
        </p>
      </div>
      <div class="tools__grid">
        <div class="tools__card tools__card--acme">
          <div class="tools__card-header">
            <div class="tools__card-icon">⚙️</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">ACME</h3>
              <p class="tools__card-subtitle">6502/6510 Cross-Assembler</p>
            </div>
          </div>
          <p class="tools__card-description">
            Cross-platform assembler optimized for Commodore 64 development. Features macro support and flexible syntax.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--c64">C64</span>
            <span class="tools__platform-tag tools__platform-tag--c64">C128</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://sourceforge.net/projects/acme-crossass/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>

        <div class="tools__card tools__card--sjasm">
          <div class="tools__card-header">
            <div class="tools__card-icon">🔧</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">sjasmplus</h3>
              <p class="tools__card-subtitle">Z80 Cross-Assembler</p>
            </div>
          </div>
          <p class="tools__card-description">
            Modern Z80 assembler with excellent ZX Spectrum support. Includes advanced features and debugging capabilities.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--spectrum">ZX Spectrum</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://github.com/z00m128/sjasmplus" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>

        <div class="tools__card tools__card--ca65">
          <div class="tools__card-header">
            <div class="tools__card-icon">🛠️</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">ca65</h3>
              <p class="tools__card-subtitle">cc65 Assembler Suite</p>
            </div>
          </div>
          <p class="tools__card-description">
            Powerful 6502 assembler with linker and C compiler. Industry standard for NES development.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--nes">NES</span>
            <span class="tools__platform-tag tools__platform-tag--c64">C64</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://cc65.github.io/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>

        <div class="tools__card tools__card--vasm">
          <div class="tools__card-header">
            <div class="tools__card-icon">🔩</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">vasm</h3>
              <p class="tools__card-subtitle">68000 Assembler</p>
            </div>
          </div>
          <p class="tools__card-description">
            Portable multi-target assembler with excellent 68000 support. Perfect for Amiga development.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--amiga">Amiga</span>
          </div>
          <div class="tools__card-actions">
            <a href="http://sun.hasenbraten.de/vasm/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="tools__section tools__section--emulators">
      <div class="tools__section-header">
        <h2 class="tools__section-title">Emulators</h2>
        <p class="tools__section-description">
          Accurate emulators for testing and development. Essential for iterating quickly on your projects.
        </p>
      </div>
      <div class="tools__grid">
        <div class="tools__card tools__card--vice">
          <div class="tools__card-header">
            <div class="tools__card-icon">📺</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">VICE</h3>
              <p class="tools__card-subtitle">Commodore Emulator Suite</p>
            </div>
          </div>
          <p class="tools__card-description">
            The definitive Commodore emulator with cycle-accurate timing and comprehensive debugging tools.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--c64">C64</span>
            <span class="tools__platform-tag tools__platform-tag--c64">C128</span>
            <span class="tools__platform-tag tools__platform-tag--c64">VIC-20</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://vice-emu.sourceforge.io/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>

        <div class="tools__card tools__card--fuse">
          <div class="tools__card-header">
            <div class="tools__card-icon">💻</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">Fuse</h3>
              <p class="tools__card-subtitle">ZX Spectrum Emulator</p>
            </div>
          </div>
          <p class="tools__card-description">
            Free Unix Spectrum Emulator with excellent compatibility and tape/disk support.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--spectrum">ZX Spectrum</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://fuse-emulator.sourceforge.net/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>

        <div class="tools__card tools__card--mesen">
          <div class="tools__card-header">
            <div class="tools__card-icon">🎮</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">Mesen</h3>
              <p class="tools__card-subtitle">NES/Famicom Emulator</p>
            </div>
          </div>
          <p class="tools__card-description">
            High-accuracy NES emulator with powerful debugging features and development tools.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--nes">NES</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://www.mesen.ca/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>

        <div class="tools__card tools__card--fsuae">
          <div class="tools__card-header">
            <div class="tools__card-icon">🖥️</div>
            <div class="tools__card-meta">
              <h3 class="tools__card-title">FS-UAE</h3>
              <p class="tools__card-subtitle">Amiga Emulator</p>
            </div>
          </div>
          <p class="tools__card-description">
            Accurate Amiga emulator with modern features and excellent WHDLoad support.
          </p>
          <div class="tools__card-platforms">
            <span class="tools__platform-tag tools__platform-tag--amiga">Amiga</span>
          </div>
          <div class="tools__card-actions">
            <a href="https://fs-uae.net/" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="external-link" size={16} />
              Visit Website
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="tools__section tools__section--docker">
      <div class="tools__section-header">
        <h2 class="tools__section-title">Development Environment</h2>
        <p class="tools__section-description">
          Everything pre-configured and ready to use. No installation headaches, just start coding.
        </p>
      </div>
      <div class="tools__docker">
        <div class="tools__docker-content">
          <div class="tools__docker-icon">🐳</div>
          <h3 class="tools__docker-title">Docker Environment</h3>
          <p class="tools__docker-text">
            Complete development environment with all assemblers, emulators, and build tools pre-configured.
            Works identically on Windows, macOS, and Linux.
          </p>
          <div class="tools__docker-features">
            <div class="tools__docker-feature">
              <Icon name="check" size={16} />
              <span>All assemblers pre-installed</span>
            </div>
            <div class="tools__docker-feature">
              <Icon name="check" size={16} />
              <span>Build scripts included</span>
            </div>
            <div class="tools__docker-feature">
              <Icon name="check" size={16} />
              <span>Cross-platform compatibility</span>
            </div>
          </div>
          <div class="tools__docker-actions">
            <a href="/getting-started#setup" class="tools__btn tools__btn--primary">
              <Icon name="arrow-right" size={20} />
              Get Started
            </a>
            <a href="https://github.com/code198x/docker-env" class="tools__btn tools__btn--outline" target="_blank" rel="noopener">
              <Icon name="github" size={20} />
              View Source
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

