---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'utilities');
---

<VaultCategoryLayout
  title="Utilities - The Vault"
  description="Explore system utilities that provided file management, disk tools, and system enhancement capabilities."
  heroTitle="Utilities"
  heroSubtitle="Essential tools that enhanced system functionality"
  heroDescription={`Explore ${categoryData.length} system utilities that provided file management, disk tools, and system enhancement capabilities.`}
  heroIcon="🛠️"
  heroColor="#14b8a6"
  categorySlug="utilities"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Utilities Collection"
  infoDescription="This collection documents the essential system utilities that enhanced the functionality of classic computers. From file managers to disk tools, these programs were crucial for daily computing tasks and system maintenance."
  stats={[
    {
      label: "File Managers",
      value: 0,
      filter: (u) => u.t === 'file-manager'
    },
    {
      label: "Disk Tools",
      value: 0,
      filter: (u) => u.t === 'disk-tool'
    },
    {
      label: "System Monitors",
      value: 0,
      filter: (u) => u.t === 'system-monitor'
    },
    {
      label: "Backup Tools",
      value: 0,
      filter: (u) => u.t === 'backup'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a utility we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

