---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'groups');
---

<VaultCategoryLayout
  title="Groups - The Vault"
  description="Discover legendary groups that pushed hardware beyond its limits and created art from code."
  heroTitle="Groups"
  heroSubtitle="Demo crews, cracking teams, and collectives that defined digital culture"
  heroDescription={`Discover ${categoryData.length} legendary groups that pushed hardware beyond its limits and created art from code.`}
  heroIcon="👥"
  heroColor="#ec4899"
  categorySlug="groups"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={false}
  showStatusFilter={true}
  infoTitle="About the Groups Collection"
  infoDescription="From the demoscene to the cracking scene, these groups created a unique digital subculture. They competed in pushing hardware to impossible limits, creating audiovisual art, and sharing software across the globe. Their innovations in coding, graphics, and music continue to influence modern development."
>
  <div class="scene-types">
    <div class="scene-card">
      <h3>🎨 Demoscene</h3>
      <p>Creating real-time audiovisual art that pushes hardware to its absolute limits</p>
    </div>
    <div class="scene-card">
      <h3>🔓 Cracking Scene</h3>
      <p>Removing copy protection and adding intros that became an art form</p>
    </div>
    <div class="scene-card">
      <h3>🎵 Music Scene</h3>
      <p>Composing tracker music and pushing sound chips beyond their specifications</p>
    </div>
  </div>
</VaultCategoryLayout>


