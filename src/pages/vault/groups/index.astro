---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";
import "../../../styles/vault.css";

// Filter to just groups entries
const groupsData = vaultData.filter(entry => entry.c === 'groups');
---

<Layout title="Groups - The Vault">
  <Hero
    title="Groups"
    subtitle="Demo crews, cracking teams, and collectives that defined digital culture"
    description={`Discover ${groupsData.length} legendary groups that pushed hardware beyond its limits and created art from code.`}
    variant="gradient"
    badge={{
      text: "👥 Groups",
      color: "#ec4899",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={groupsData}
        placeholder="Search groups by name, type, or achievements..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={false}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="vault-category-info-section">
        <h2>About the Groups Collection</h2>
        <p>
          From the demoscene to the cracking scene, these groups created a unique digital
          subculture. They competed in pushing hardware to impossible limits, creating
          audiovisual art, and sharing software across the globe. Their innovations in
          coding, graphics, and music continue to influence modern development.
        </p>

        <div class="scene-types">
          <div class="scene-card">
            <h3>🎨 Demoscene</h3>
            <p>Creating real-time audiovisual art that pushes hardware to its absolute limits</p>
          </div>
          <div class="scene-card">
            <h3>🔓 Cracking Scene</h3>
            <p>Removing copy protection and adding intros that became an art form</p>
          </div>
          <div class="scene-card">
            <h3>🎵 Music Scene</h3>
            <p>Composing tracker music and pushing sound chips beyond their specifications</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

