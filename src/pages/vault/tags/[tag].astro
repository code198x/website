---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import VaultEntryCard from "../../../components/VaultEntryCard.astro";
import { vaultData } from "../../../data/vault-data.js";

export async function getStaticPaths() {
  // Get all unique tags from vault data
  const allTags = new Set<string>();

  vaultData.forEach(entry => {
    if (entry.g && Array.isArray(entry.g)) {
      entry.g.forEach((tag: string) => {
        allTags.add(tag.toLowerCase());
      });
    }
  });

  // Generate a path for each unique tag
  return Array.from(allTags).map(tag => ({
    params: { tag },
    props: {
      tag,
      entries: vaultData.filter(entry =>
        entry.g && entry.g.some((t: string) => t.toLowerCase() === tag)
      )
    }
  }));
}

const { tag, entries } = Astro.props;

// Capitalize the tag for display
const displayTag = tag.charAt(0).toUpperCase() + tag.slice(1);

// Generate breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Vault', href: '/vault' },
  { label: 'Tags', href: '/vault/tags' },
  { label: displayTag, href: `/vault/tags/${tag}` }
];
---

<Layout
  title={`${displayTag} - Vault Tags`}
  description={`Explore ${entries.length} vault entries tagged with "${displayTag}"`}
>
  <Hero
    title={`Tag: ${displayTag}`}
    subtitle={`${entries.length} entries with this tag`}
    description="Explore all vault entries that share this common theme"
    variant="gradient"
    badge={{
      text: `#${displayTag}`,
      color: "#8b5cf6",
      href: "/vault/tags"
    }}
  />

  <div class="tag-page-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={breadcrumbItems} />

      <!-- Entries Grid -->
      <div class="entries-grid">
        {entries.map((entry) => (
          <a
            href={`/vault/${entry.c}/${entry.s}`}
            class="vault-entry-card"
          >
            <div class="vault-entry-card__category">
              {entry.c.replace('-', ' ')}
            </div>
            <h3 class="vault-entry-card__title">{entry.n}</h3>
            {entry.d && (
              <p class="vault-entry-card__description">{entry.d}</p>
            )}
            <div class="vault-entry-card__footer">
              <span class="vault-entry-card__type">{entry.t}</span>
              {entry.y > 0 && (
                <span class="vault-entry-card__year">{entry.y}</span>
              )}
            </div>
          </a>
        ))}
      </div>

      <!-- Related Tags Section -->
      {entries.length > 0 && (
        <section class="related-tags">
          <h2>Other Tags From These Entries</h2>
          <div class="tags-cloud">
            {Array.from(new Set(
              entries.flatMap(entry =>
                entry.g && Array.isArray(entry.g)
                  ? entry.g.filter((t: string) => t.toLowerCase() !== tag)
                  : []
              )
            )).slice(0, 20).map(relatedTag => (
              <a
                href={`/vault/tags/${relatedTag.toLowerCase()}`}
                class="tag-link"
              >
                #{relatedTag}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Back Navigation -->
      <div class="back-navigation">
        <a href="/vault/tags" class="back-link">
          ← View All Tags
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tag-page-container {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  /* Entries Grid */
  .entries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-2xl) 0;
  }

  .vault-entry-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    position: relative;
  }

  .vault-entry-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .vault-entry-card__category {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .vault-entry-card__title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    margin: 0 0 var(--space-sm) 0;
    color: var(--color-text-primary);
  }

  .vault-entry-card__description {
    flex: 1;
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md) 0;
  }

  .vault-entry-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .vault-entry-card__type {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    font-weight: 500;
    text-transform: capitalize;
  }

  .vault-entry-card__year {
    font-size: var(--font-size-sm);
    background: var(--color-background-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
  }

  /* Related Tags Section */
  .related-tags {
    margin: var(--space-2xl) 0;
    padding: var(--space-xl);
    background: var(--color-background-secondary);
    border-radius: var(--border-radius-lg);
    border: 2px solid var(--color-border);
  }

  .related-tags h2 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-lg);
    color: var(--color-text-primary);
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 0.9));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .tag-link:hover {
    transform: scale(1.05) translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
  }

  /* Back Navigation */
  .back-navigation {
    margin-top: var(--space-2xl);
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-md) var(--space-xl);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 1));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.2);
  }

  .back-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 123, 255, 0.3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .entries-grid {
      grid-template-columns: 1fr;
    }
  }
</style>