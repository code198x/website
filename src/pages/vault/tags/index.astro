---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { vaultData } from "../../../data/vault-data.js";

// Collect all tags with their counts
const tagCounts = new Map<string, number>();

vaultData.forEach(entry => {
  if (entry.g && Array.isArray(entry.g)) {
    entry.g.forEach((tag: string) => {
      const normalizedTag = tag.toLowerCase();
      tagCounts.set(normalizedTag, (tagCounts.get(normalizedTag) || 0) + 1);
    });
  }
});

// Sort tags alphabetically
const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => a[0].localeCompare(b[0]));

// Group tags by first letter
const tagsByLetter = new Map<string, Array<[string, number]>>();
sortedTags.forEach(([tag, count]) => {
  const firstLetter = tag[0].toUpperCase();
  if (!tagsByLetter.has(firstLetter)) {
    tagsByLetter.set(firstLetter, []);
  }
  tagsByLetter.get(firstLetter)!.push([tag, count]);
});

// Generate breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Vault', href: '/vault' },
  { label: 'Tags', href: '/vault/tags' }
];

// Get total number of unique tags
const totalTags = tagCounts.size;

// Get most popular tags (top 10)
const popularTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<Layout
  title="All Tags - Vault"
  description={`Explore ${totalTags} unique tags across the Code198x vault collection`}
>
  <Hero
    title="Vault Tags"
    subtitle={`${totalTags} unique tags`}
    description="Browse all tags used across the vault collection"
    variant="gradient"
    badge={{
      text: "Tag Index",
      color: "#8b5cf6",
      href: "/vault"
    }}
  />

  <div class="tags-index-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={breadcrumbItems} />

      <!-- Popular Tags Section -->
      <section class="popular-tags-section">
        <h2>Popular Tags</h2>
        <div class="popular-tags-grid">
          {popularTags.map(([tag, count]) => (
            <a
              href={`/vault/tags/${tag}`}
              class="popular-tag-card"
            >
              <div class="popular-tag-name">
                #{tag.charAt(0).toUpperCase() + tag.slice(1)}
              </div>
              <div class="popular-tag-count">
                {count} {count === 1 ? 'entry' : 'entries'}
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- All Tags Alphabetical -->
      <section class="all-tags-section">
        <h2>All Tags (A-Z)</h2>

        <div class="alphabet-nav">
          {Array.from(tagsByLetter.keys()).map((letter) => (
            <a href={`#letter-${letter}`} class="alphabet-link">
              {letter}
            </a>
          ))}
        </div>

        <div class="tags-by-letter">
          {Array.from(tagsByLetter.entries()).map(([letter, tags]) => (
            <div id={`letter-${letter}`} class="letter-group">
              <h3 class="letter-heading">{letter}</h3>
              <div class="tags-grid">
                {tags.map(([tag, count]) => (
                  <a
                    href={`/vault/tags/${tag}`}
                    class="tag-item"
                  >
                    <span class="tag-name">
                      #{tag.charAt(0).toUpperCase() + tag.slice(1)}
                    </span>
                    <span class="tag-count">({count})</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Back Navigation -->
      <div class="back-navigation">
        <a href="/vault" class="back-link">
          ← Back to Vault
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tags-index-container {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  /* Popular Tags Section */
  .popular-tags-section {
    margin: var(--space-2xl) 0;
    padding: var(--space-xl);
    background: linear-gradient(135deg,
      var(--color-background-secondary) 0%,
      rgba(139, 92, 246, 0.05) 50%,
      var(--color-background-secondary) 100%);
    border-radius: var(--border-radius-lg);
    border: 2px solid var(--color-border);
  }

  .popular-tags-section h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-xl);
    color: var(--color-text-primary);
  }

  .popular-tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .popular-tag-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .popular-tag-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, #8b5cf6, #6366f1);
    transform: scaleY(0);
    transition: transform 0.2s ease;
  }

  .popular-tag-card:hover {
    border-color: #8b5cf6;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .popular-tag-card:hover::before {
    transform: scaleY(1);
  }

  .popular-tag-name {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .popular-tag-count {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  /* All Tags Section */
  .all-tags-section {
    margin: var(--space-2xl) 0;
  }

  .all-tags-section h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-lg);
    color: var(--color-text-primary);
  }

  /* Alphabet Navigation */
  .alphabet-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
    padding: var(--space-md);
    background: var(--color-background-secondary);
    border-radius: var(--border-radius-md);
    border: 1px solid var(--color-border);
  }

  .alphabet-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: var(--font-size-sm);
    transition: all 0.2s ease;
  }

  .alphabet-link:hover {
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 1));
    color: white;
    border-color: transparent;
    transform: scale(1.1);
  }

  /* Tags by Letter */
  .tags-by-letter {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .letter-group {
    padding: var(--space-lg);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    scroll-margin-top: var(--space-xl);
  }

  .letter-heading {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border);
  }

  .tags-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 0.9));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    transition: all 0.2s ease;
  }

  .tag-item:hover {
    transform: scale(1.05) translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
  }

  .tag-name {
    font-weight: 600;
  }

  .tag-count {
    opacity: 0.9;
    font-size: var(--font-size-xs);
  }

  /* Back Navigation */
  .back-navigation {
    margin-top: var(--space-2xl);
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-md) var(--space-xl);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 1));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.2);
  }

  .back-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 123, 255, 0.3);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .popular-tags-grid {
      grid-template-columns: 1fr;
    }

    .alphabet-nav {
      justify-content: center;
    }

    .tags-grid {
      gap: var(--space-xs);
    }

    .tag-item {
      font-size: var(--font-size-xs);
      padding: var(--space-xs) var(--space-sm);
    }
  }
</style>