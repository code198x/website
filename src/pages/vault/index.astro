---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Fetch content from each directory
const companies = await getCollection('companies');
const people = await getCollection('people');
const systems = await getCollection('systems');
const events = await getCollection('events');
const software = await getCollection('software');

// Count entries
const stats = {
  companies: companies.length,
  people: people.length,
  systems: systems.length,
  events: events.length,
  software: software.length,
};
---

<Layout title="The Vault - Code Like It's 198x">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2">The Vault</h1>
    <p class="text-xl text-gray-600 mb-8">
      Explore the people, companies, systems, and events that shaped the computing revolution.
    </p>

    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">The Vault</span>
    </nav>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
      <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-800">People</h2>
          <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-sm font-medium">
            {stats.people}
          </span>
        </div>
        <p class="text-gray-600 mb-4 text-sm">
          Engineers, entrepreneurs, and visionaries who created the technology we learn about.
        </p>
        <a 
          href="/vault/people" 
          class="block w-full text-center px-4 py-2 bg-green-600 text-white font-medium rounded hover:bg-green-700 transition-colors"
        >
          Browse People →
        </a>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-800">Companies</h2>
          <span class="bg-amber-100 text-amber-800 px-2 py-1 rounded-full text-sm font-medium">
            {stats.companies}
          </span>
        </div>
        <p class="text-gray-600 mb-4 text-sm">
          The companies that manufactured the computers and processors that defined an era.
        </p>
        <a 
          href="/vault/companies" 
          class="block w-full text-center px-4 py-2 bg-amber-600 text-white font-medium rounded hover:bg-amber-700 transition-colors"
        >
          Browse Companies →
        </a>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-800">Systems</h2>
          <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
            {stats.systems}
          </span>
        </div>
        <p class="text-gray-600 mb-4 text-sm">
          The vintage computing systems featured in our programming lessons.
        </p>
        <a 
          href="/vault/systems" 
          class="block w-full text-center px-4 py-2 bg-blue-600 text-white font-medium rounded hover:bg-blue-700 transition-colors"
        >
          Browse Systems →
        </a>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-800">Timeline</h2>
          <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded-full text-sm font-medium">
            {stats.events}
          </span>
        </div>
        <p class="text-gray-600 mb-4 text-sm">
          Key events in computing history and the world events that provided context.
        </p>
        <a 
          href="/timeline" 
          class="block w-full text-center px-4 py-2 bg-purple-600 text-white font-medium rounded hover:bg-purple-700 transition-colors"
        >
          View Timeline →
        </a>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-800">Software</h2>
          <span class="bg-red-100 text-red-800 px-2 py-1 rounded-full text-sm font-medium">
            {stats.software}
          </span>
        </div>
        <p class="text-gray-600 mb-4 text-sm">
          Notable applications, games, and programs that defined vintage computing.
        </p>
        <a 
          href="/vault/software" 
          class="block w-full text-center px-4 py-2 bg-red-600 text-white font-medium rounded hover:bg-red-700 transition-colors"
        >
          Browse Software →
        </a>
      </div>

    </div>

    <div class="mt-12 bg-gray-50 rounded-lg p-8">
      <h2 class="text-2xl font-semibold mb-4">About The Vault</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-lg font-medium mb-2">Historical Context</h3>
          <p class="text-gray-700 text-sm">
            The Vault provides the historical and technical context behind the systems you're learning to program. 
            Understanding the people who designed the processors, the companies that built the computers, and the 
            events that shaped the industry enriches your learning experience.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-medium mb-2">Cross-References</h3>
          <p class="text-gray-700 text-sm">
            Vault entries are cross-referenced throughout the lessons, providing deeper insight into the 
            technologies and design decisions that made these vintage computers possible. Click on any name 
            or company mentioned in lessons to learn more about their contributions.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>