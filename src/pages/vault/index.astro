---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import FeaturedEntries from "../../components/FeaturedEntries.astro";
import FullWidthSection from "../../components/FullWidthSection.astro";
import { getCollection } from "astro:content";
import { vaultData } from "../../data/vault-data.js";
import { getRecentEntries, getFeaturedEntries } from "../../utils/breadcrumbs";

// Get tag statistics
const tagCounts = new Map<string, number>();
vaultData.forEach((entry) => {
  if (entry.g && Array.isArray(entry.g)) {
    entry.g.forEach((tag: string) => {
      const normalizedTag = tag.toLowerCase();
      tagCounts.set(normalizedTag, (tagCounts.get(normalizedTag) || 0) + 1);
    });
  }
});

// Get top tags for display
const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15);

const totalTags = tagCounts.size;

// Get counts for each collection
const collectionCounts: Record<string, number> = {};

try {
  collectionCounts.hardware = (await getCollection("hardware")).length;
} catch {
  collectionCounts.hardware = 0;
}

try {
  collectionCounts.people = (await getCollection("people")).length;
} catch {
  collectionCounts.people = 0;
}

try {
  collectionCounts.companies = (await getCollection("companies")).length;
} catch {
  collectionCounts.companies = 0;
}

try {
  collectionCounts.applications = (await getCollection("applications")).length;
} catch {
  collectionCounts.applications = 0;
}

try {
  collectionCounts["development-tools"] = (await getCollection("development-tools")).length;
} catch {
  collectionCounts["development-tools"] = 0;
}

try {
  collectionCounts.utilities = (await getCollection("utilities")).length;
} catch {
  collectionCounts.utilities = 0;
}

try {
  collectionCounts.games = (await getCollection("games")).length;
} catch {
  collectionCounts.games = 0;
}

try {
  collectionCounts.demos = (await getCollection("demos")).length;
} catch {
  collectionCounts.demos = 0;
}

try {
  collectionCounts["operating-systems"] = (await getCollection("operating-systems")).length;
} catch {
  collectionCounts["operating-systems"] = 0;
}

try {
  collectionCounts.emulators = (await getCollection("emulators")).length;
} catch {
  collectionCounts.emulators = 0;
}

try {
  collectionCounts["programming-languages"] = (await getCollection("programming-languages")).length;
} catch {
  collectionCounts["programming-languages"] = 0;
}

try {
  collectionCounts.techniques = (await getCollection("techniques")).length;
} catch {
  collectionCounts.techniques = 0;
}

try {
  collectionCounts.publications = (await getCollection("publications")).length;
} catch {
  collectionCounts.publications = 0;
}

try {
  collectionCounts.events = (await getCollection("events")).length;
} catch {
  collectionCounts.events = 0;
}

try {
  collectionCounts.groups = (await getCollection("groups")).length;
} catch {
  collectionCounts.groups = 0;
}

try {
  collectionCounts.formats = (await getCollection("formats")).length;
} catch {
  collectionCounts.formats = 0;
}

try {
  collectionCounts.culture = (await getCollection("culture")).length;
} catch {
  collectionCounts.culture = 0;
}

// Calculate total entries
const totalEntries = Object.values(collectionCounts).reduce((sum, count) => sum + count, 0);

// Function to get dynamic featured items for a category
function getFeaturedItemsForCategory(categorySlug: string, maxItems: number = 4): string[] {
  const categoryEntries = vaultData.filter((entry) => entry.c === categorySlug);

  // If no entries exist, return an empty array
  if (categoryEntries.length === 0) {
    return [];
  }

  // Sort by a combination of factors for the most representative items
  const sortedEntries = categoryEntries
    .filter((entry) => entry.st === "available") // Only show available entries
    .sort((a, b) => {
      // First, sort by significance (legendary/famous entries get priority)
      // This could be determined by having certain tags or being well-known
      const aIsSignificant =
        a.g?.some((tag) =>
          ["legendary", "famous", "classic", "iconic"].includes(tag.toLowerCase())
        ) || false;
      const bIsSignificant =
        b.g?.some((tag) =>
          ["legendary", "famous", "classic", "iconic"].includes(tag.toLowerCase())
        ) || false;

      if (aIsSignificant && !bIsSignificant) return -1;
      if (!aIsSignificant && bIsSignificant) return 1;

      // Then prioritize by year (newer/more relevant first for most categories)
      if (a.y && b.y && a.y !== b.y) {
        return b.y - a.y;
      }

      // Finally, alphabetically for consistency
      return a.n.localeCompare(b.n);
    });

  // If we have fewer entries than requested, return all available
  const availableEntries = sortedEntries.slice(0, maxItems);

  // Return the names of the selected entries
  return availableEntries.map((entry) => entry.n);
}

// Define content categories with dynamic featured items
const contentCategories: Array<{
  title: string;
  slug: string;
  icon: string;
  colorClass: string;
  description: string;
  examples: string[];
  count: number;
}> = [
  {
    title: "Hardware",
    slug: "hardware",
    icon: "🖥️",
    colorClass: "blue",
    description: "Systems, chips, peripherals, and modifications that defined an era",
    examples: getFeaturedItemsForCategory("hardware"),
    count: collectionCounts.hardware || 0,
  },
  {
    title: "People",
    slug: "people",
    icon: "👤",
    colorClass: "green",
    description: "Pioneers, programmers, and visionaries who shaped computing history",
    examples: getFeaturedItemsForCategory("people"),
    count: collectionCounts.people || 0,
  },
  {
    title: "Companies",
    slug: "companies",
    icon: "🏢",
    colorClass: "purple",
    description: "The corporations and startups that built the industry",
    examples: getFeaturedItemsForCategory("companies"),
    count: collectionCounts.companies || 0,
  },
  {
    title: "Applications",
    slug: "applications",
    icon: "💼",
    colorClass: "amber",
    description: "Productivity and creative software",
    examples: getFeaturedItemsForCategory("applications"),
    count: collectionCounts.applications || 0,
  },
  {
    title: "Development Tools",
    slug: "development-tools",
    icon: "🔧",
    colorClass: "rose",
    description: "Compilers, assemblers, and IDEs",
    examples: getFeaturedItemsForCategory("development-tools"),
    count: collectionCounts["development-tools"] || 0,
  },
  {
    title: "Utilities",
    slug: "utilities",
    icon: "🛠️",
    colorClass: "teal",
    description: "System tools and file managers",
    examples: getFeaturedItemsForCategory("utilities"),
    count: collectionCounts.utilities || 0,
  },
  {
    title: "Games",
    slug: "games",
    icon: "🎮",
    colorClass: "orange",
    description: "Entertainment software that defined generations",
    examples: getFeaturedItemsForCategory("games"),
    count: collectionCounts.games || 0,
  },
  {
    title: "Demos",
    slug: "demos",
    icon: "🎬",
    colorClass: "cyan",
    description: "Demoscene productions that pushed hardware beyond limits",
    examples: getFeaturedItemsForCategory("demos"),
    count: collectionCounts.demos || 0,
  },
  {
    title: "Operating Systems",
    slug: "operating-systems",
    icon: "🖥️",
    colorClass: "slate",
    description: "The foundations that everything ran on",
    examples: getFeaturedItemsForCategory("operating-systems"),
    count: collectionCounts["operating-systems"] || 0,
  },
  {
    title: "Emulators",
    slug: "emulators",
    icon: "🔄",
    colorClass: "violet",
    description: "Preservation through accurate emulation",
    examples: getFeaturedItemsForCategory("emulators"),
    count: collectionCounts.emulators || 0,
  },
  {
    title: "Programming Languages",
    slug: "programming-languages",
    icon: "📝",
    colorClass: "emerald",
    description: "Languages and tools that enabled creation",
    examples: getFeaturedItemsForCategory("programming-languages"),
    count: collectionCounts["programming-languages"] || 0,
  },
  {
    title: "Techniques",
    slug: "techniques",
    icon: "⚡",
    colorClass: "red",
    description: "Programming tricks and hardware hacks that made the impossible possible",
    examples: getFeaturedItemsForCategory("techniques"),
    count: collectionCounts.techniques || 0,
  },
  {
    title: "Publications",
    slug: "publications",
    icon: "📖",
    colorClass: "indigo",
    description: "Magazines, books, and manuals that spread knowledge",
    examples: getFeaturedItemsForCategory("publications"),
    count: collectionCounts.publications || 0,
  },
  {
    title: "Events",
    slug: "events",
    icon: "🎪",
    colorClass: "pink",
    description: "Demo parties, trade shows, and historic launches",
    examples: getFeaturedItemsForCategory("events"),
    count: collectionCounts.events || 0,
  },
  {
    title: "Groups",
    slug: "groups",
    icon: "👥",
    colorClass: "teal",
    description: "Demo groups, cracking teams, and development studios",
    examples: getFeaturedItemsForCategory("groups"),
    count: collectionCounts.groups || 0,
  },
  {
    title: "Formats",
    slug: "formats",
    icon: "💾",
    colorClass: "orange",
    description: "File formats, storage media, and technical standards",
    examples: getFeaturedItemsForCategory("formats"),
    count: collectionCounts.formats || 0,
  },
  {
    title: "Culture",
    slug: "culture",
    icon: "🌟",
    colorClass: "cyan",
    description: "Demo scene, BBS culture, and computing phenomena",
    examples: getFeaturedItemsForCategory("culture"),
    count: collectionCounts.culture || 0,
  },
];

// Timeline is handled separately as an interactive feature
const vaultCategories = contentCategories;

// Get featured and recent entries for display
const featuredEntries = getFeaturedEntries(vaultData, 6);
const recentEntries = getRecentEntries(vaultData, 6);

// Structured data for vault
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "The Vault - Retro Computing Encyclopedia",
  description:
    "Comprehensive encyclopedia of retro computing history including hardware, people, companies, games, and innovations from the golden age of home computing.",
  url: "https://code198x.stevehill.xyz/vault",
  author: {
    "@type": "Organization",
    name: "Code Like It's 198x",
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: vaultData.length,
    itemListElement: featuredEntries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Article",
        name: entry.n,
        description: entry.d,
        url: `https://code198x.stevehill.xyz/vault/${entry.c}/${entry.s}`,
      },
    })),
  },
};
---

<Layout
  title="The Vault - Retro Computing Encyclopedia"
  description="Explore the complete history of retro computing. From legendary computers like Commodore 64 and Amiga to the pioneers who built the digital age. Hardware, software, people, and stories."
  structuredData={structuredData}
>
  <Hero
    title="The Vault"
    subtitle="Your Encyclopedia of Retro Computing History"
    description="Explore the people, companies, games, and innovations that defined the golden age of home computing. Every entry connects to our lessons, showing you not just the 'how' but the 'who', 'what', 'when', and 'why'."
    variant="gradient"
    badge={{
      text: `🔓 ${totalEntries} Total Entries`,
      color: "#10b981",
    }}
  />

  <div class="vault-container">
    <!-- Category Grid -->
    <div class="container">
      <SectionHeader
        title="Explore the Archives"
        subtitle="Dive deep into the stories behind the code"
      />

      <div class="vault-grid">
        {
          vaultCategories.map((category) => (
            <a
              href={`/vault/${category.slug}`}
              class={`vault-card vault-card--${category.colorClass}`}
            >
              <div class="vault-card__header">
                <span class="vault-card__icon">{category.icon}</span>
                <span class="vault-card__count">
                  {category.slug === "timeline"
                    ? "Interactive Timeline"
                    : `${category.count} ${category.count === 1 ? "entry" : "entries"}`}
                </span>
              </div>
              <div class="vault-card__body">
                <h3 class="vault-card__title">{category.title}</h3>
                <p class="vault-card__description">{category.description}</p>
                <div class="vault-card__examples">
                  <span class="vault-card__examples-label">Featured:</span>
                  <span class="vault-card__examples-list">{category.examples.join(" • ")}</span>
                </div>
              </div>
              <div class="vault-card__footer">
                <span class="vault-card__action">Browse {category.title} →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Timeline Feature Section -->
    <div class="timeline-feature-section">
      <div class="container">
        <SectionHeader
          title="Journey Through Time"
          subtitle="Experience the evolution of computing history interactively"
        />

        <div class="timeline-feature-card">
          <div class="timeline-feature-content">
            <div class="timeline-feature-icon">📅</div>
            <div class="timeline-feature-text">
              <h3 class="timeline-feature-title">Interactive Computing Timeline</h3>
              <p class="timeline-feature-description">
                Explore 40+ years of computing history from the first home computers to the golden
                age of gaming. See how people, companies, and innovations connected to create the
                digital revolution.
              </p>
              <div class="timeline-feature-highlights">
                <div class="timeline-highlight">
                  <span class="timeline-highlight-icon">🚀</span>
                  <span class="timeline-highlight-text">1977: Apple II Launch</span>
                </div>
                <div class="timeline-highlight">
                  <span class="timeline-highlight-icon">🎮</span>
                  <span class="timeline-highlight-text">1982: C64 Revolution</span>
                </div>
                <div class="timeline-highlight">
                  <span class="timeline-highlight-icon">💾</span>
                  <span class="timeline-highlight-text">1985: Amiga Era Begins</span>
                </div>
                <div class="timeline-highlight">
                  <span class="timeline-highlight-icon">🌐</span>
                  <span class="timeline-highlight-text">1991: World Wide Web</span>
                </div>
              </div>
            </div>
          </div>
          <div class="timeline-feature-actions">
            <a href="/vault/timeline" class="timeline-feature-btn timeline-feature-btn--primary">
              🗓️ Explore Timeline
            </a>
            <a href="/lessons" class="timeline-feature-btn timeline-feature-btn--secondary">
              📚 Start Learning
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Tag Cloud Section -->
    <div class="tag-cloud-section">
      <div class="container">
        <SectionHeader
          title="Explore by Tags"
          subtitle={`Discover content through ${totalTags} unique tags`}
        />

        <div class="tag-statistics">
          <div class="tag-stat-card">
            <span class="tag-stat-number">{totalTags}</span>
            <span class="tag-stat-label">Total Tags</span>
          </div>
          <div class="tag-stat-card">
            <span class="tag-stat-number">{vaultData.length}</span>
            <span class="tag-stat-label">Tagged Entries</span>
          </div>
          <div class="tag-stat-card">
            <span class="tag-stat-number"
              >{
                Math.round(
                  (vaultData.filter((e) => e.g && e.g.length > 0).length / vaultData.length) * 100
                )
              }%</span
            >
            <span class="tag-stat-label">Coverage</span>
          </div>
        </div>

        <div class="popular-tags-cloud">
          <h3 class="tags-cloud-title">Popular Tags</h3>
          <div class="tags-cloud-container">
            {
              topTags.map(([tag, count]) => {
                const size = Math.min(Math.max(count / 5, 0.8), 2);
                return (
                  <a
                    href={`/vault/tags/${tag}`}
                    class="cloud-tag"
                    style={`font-size: ${size}rem; opacity: ${Math.min(0.5 + count / 20, 1)}`}
                    title={`${count} entries`}
                  >
                    #{tag}
                    <span class="cloud-tag-count">({count})</span>
                  </a>
                );
              })
            }
          </div>
          <div class="tags-cloud-footer">
            <a href="/vault/tags" class="view-all-tags">
              View All {totalTags} Tags →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Connections Section -->
    <div class="featured-section">
      <div class="container">
        <SectionHeader
          title="Everything Is Connected"
          subtitle="See how people, companies, and innovations influenced each other"
        />

        <div class="connection-examples">
          <div class="connection-card">
            <h4>The Commodore Story</h4>
            <div class="connection-flow">
              <span class="connection-node">Jack Tramiel</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Commodore</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">C64</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">SID Chip</span>
            </div>
            <p>From Holocaust survivor to computer revolution leader</p>
          </div>

          <div class="connection-card">
            <h4>The British Invasion</h4>
            <div class="connection-flow">
              <span class="connection-node">Clive Sinclair</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">ZX Spectrum</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Bedroom Coders</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Ocean Software</span>
            </div>
            <p>How affordable computers created a gaming industry</p>
          </div>

          <div class="connection-card">
            <h4>Demo Scene Origins</h4>
            <div class="connection-flow">
              <span class="connection-node">Cracking Groups</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Intros</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Demo Parties</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">New Techniques</span>
            </div>
            <p>From piracy to pushing hardware beyond its limits</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Entries -->
    <FeaturedEntries
      title="Featured Entries"
      subtitle="Curated highlights from across the vault - significant entries that shaped computing history"
      entries={featuredEntries}
      showMoreLink="/vault/search"
    />

    <!-- Recently Added -->
    <FeaturedEntries
      title="Recently Added"
      subtitle="The latest additions to our retro computing encyclopedia"
      entries={recentEntries}
      showMoreLink="/vault/search"
      className="recent-entries"
    />

    <!-- Call to Action -->
    <FullWidthSection
      variant="primary"
      title="Ready to Build Your Own Computing Legacy?"
      description="The Vault shows you the 'who' and 'what' - our lessons teach you the 'how'. Start your retro programming journey today."
      actions={[
        {
          text: "🎮 Start Coding",
          href: "/lessons",
          variant: "secondary",
          size: "large",
        },
        {
          text: "🔍 Browse All Entries",
          href: "/vault/search",
          variant: "secondary",
          size: "large",
        },
      ]}
      connectToFooter={true}
    />
  </div>
</Layout>

<style>
  /* Tag Cloud Section */
  .tag-cloud-section {
    padding: var(--space-2xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-background-secondary) 0%,
      rgba(139, 92, 246, 0.05) 50%,
      var(--color-background-secondary) 100%
    );
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    margin: var(--space-2xl) 0;
  }

  .tag-statistics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .tag-stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-lg);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    transition: all 0.2s ease;
  }

  .tag-stat-card:hover {
    transform: translateY(-2px);
    border-color: #8b5cf6;
    box-shadow: var(--shadow-lg);
  }

  .tag-stat-number {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tag-stat-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-xs);
  }

  .popular-tags-cloud {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .tags-cloud-title {
    font-size: var(--font-size-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-lg);
    text-align: center;
  }

  .tags-cloud-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
    align-items: center;
    padding: var(--space-lg) 0;
    min-height: 150px;
  }

  .cloud-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 0.9));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-weight: 600;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .cloud-tag:hover {
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4);
  }

  .cloud-tag-count {
    font-size: 0.8em;
    opacity: 0.8;
  }

  .tags-cloud-footer {
    text-align: center;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px dashed var(--color-border);
  }

  .view-all-tags {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-lg);
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .view-all-tags:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .tag-statistics {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .tags-cloud-container {
      gap: var(--space-sm);
      padding: var(--space-md) 0;
    }

    .cloud-tag {
      padding: var(--space-xs) var(--space-sm);
    }

    .cloud-tag-count {
      display: none;
    }
  }

  /* Timeline Feature Section */
  .timeline-feature-section {
    padding: var(--space-4xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      var(--color-background-secondary) 50%,
      var(--color-background) 100%
    );
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    margin: var(--space-4xl) 0;
    position: relative;
  }

  .timeline-feature-section::before {
    content: "";
