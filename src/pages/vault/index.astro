---
import VaultLayout from "../../layouts/VaultLayout.astro";

// Organize all 39 vault articles by category
const categories = {
  hardware: [
    { name: "Commodore 64", url: "/vault/commodore-64", desc: "The best-selling single computer model of all time" },
    { name: "ZX Spectrum", url: "/vault/zx-spectrum", desc: "Britain's home computing revolution" },
    { name: "Amstrad CPC", url: "/vault/amstrad-cpc", desc: "The integrated system that came with everything" },
    { name: "Atari ST", url: "/vault/atari-st", desc: "16-bit powerhouse of the demoscene" },
    { name: "Commodore Amiga", url: "/vault/commodore-amiga", desc: "Custom chips that changed multimedia computing" },
    { name: "NES", url: "/vault/nes", desc: "Nintendo's 8-bit console that saved gaming" },
    { name: "VIC-II", url: "/vault/vic-ii", desc: "The C64's legendary graphics chip" },
    { name: "SID Chip", url: "/vault/sid-chip", desc: "The sound that defined a generation" },
  ],
  people: [
    { name: "Jeff Minter", url: "/vault/jeff-minter", desc: "Llamas, psychedelia, and light synthesizers" },
    { name: "Matthew Smith", url: "/vault/matthew-smith", desc: "Creator of Manic Miner and Jet Set Willy" },
    { name: "Andrew Braybrook", url: "/vault/andrew-braybrook", desc: "Master of smooth scrolling action" },
    { name: "Rob Hubbard", url: "/vault/rob-hubbard", desc: "Composer who pushed the SID to its limits" },
    { name: "Oliver Twins", url: "/vault/oliver-twins", desc: "Philip and Andrew Oliver's Dizzy universe" },
    { name: "Al Charpentier", url: "/vault/al-charpentier", desc: "Designer of the VIC-II graphics chip" },
    { name: "Bob Yannes", url: "/vault/bob-yannes", desc: "Creator of the legendary SID chip" },
  ],
  companies: [
    { name: "Llamasoft", url: "/vault/llamasoft", desc: "Jeff Minter's indie studio since 1982" },
    { name: "Hewson Consultants", url: "/vault/hewson-consultants", desc: "Premium quality arcade conversions" },
    { name: "Codemasters", url: "/vault/codemasters", desc: "Budget gaming empire of the Oliver twins" },
    { name: "Firebird", url: "/vault/firebird", desc: "British Telecom's software publishing arm" },
    { name: "Mastertronic", url: "/vault/mastertronic", desc: "£1.99 budget games for the masses" },
  ],
  games: [
    { name: "Paradroid", url: "/vault/paradroid", desc: "Andrew Braybrook's robotic masterpiece" },
    { name: "Uridium", url: "/vault/uridium", desc: "Smooth scrolling at impossible speeds" },
    { name: "Dizzy", url: "/vault/dizzy", desc: "The egg-shaped adventurer's puzzle platforming" },
    { name: "Super Robin Hood", url: "/vault/super-robin-hood", desc: "Codemasters' isometric archery adventure" },
    { name: "Attack of the Mutant Camels", url: "/vault/attack-of-the-mutant-camels", desc: "Jeff Minter's surreal shooter" },
    { name: "Tempest 2000", url: "/vault/tempest-2000", desc: "The Atari Jaguar's killer app" },
  ],
  culture: [
    { name: "The Bedroom Coder", url: "/vault/bedroom-coder", desc: "How teenagers with cassette decks built an industry" },
    { name: "Demo Scene 101", url: "/vault/demo-scene-101", desc: "Art, music, and code pushed to the limit" },
    { name: "ZZAP!64", url: "/vault/zzap64", desc: "The magazine that shaped C64 culture" },
    { name: "CRASH Magazine", url: "/vault/crash-magazine", desc: "Spectrum's legendary monthly" },
    { name: "Your Sinclair", url: "/vault/your-sinclair", desc: "The irreverent voice of Spectrum gaming" },
    { name: "Fairlight (Demo Group)", url: "/vault/fairlight-group", desc: "Swedish pioneers of the C64 demoscene" },
    { name: "Crest", url: "/vault/crest", desc: "C64 demo group pushing hardware limits" },
  ],
  techniques: [
    { name: "Cassette Loading", url: "/vault/cassette-loading", desc: "How magnetic tape became playable games" },
    { name: "Disk Fastloaders", url: "/vault/disk-fastloaders", desc: "Speeding up the painfully slow 1541 drive" },
    { name: "Raster Tricks 101", url: "/vault/raster-tricks-101", desc: "Timing magic for more colours and sprites" },
    { name: "KERNAL I/O", url: "/vault/kernal-io", desc: "The C64's operating system routines" },
  ],
};
---

<VaultLayout title="The Vault" subtitle="An encyclopaedia of vintage computing" summary="Explore the people, hardware, companies, games, and techniques that defined 1980s home computing. From the Commodore 64's SID chip to bedroom coders who built an industry.">
  <div class="vault-intro">
    <p>
      Welcome to <strong>The Vault</strong> — a curated collection of reference articles connecting hands-on lessons to their cultural and technical roots. From the chips that powered the machines to the people who pushed them to their limits.
    </p>
  </div>

  <!-- Featured Section -->
  <section class="featured-section">
    <h2>Start Here</h2>
    <div class="featured-grid">
      <a href="/vault/bedroom-coder" class="featured-card featured-card--large">
        <span class="featured-kicker">Culture</span>
        <h3 class="featured-title">The Rise of the Bedroom Coder</h3>
        <p class="featured-desc">How kids with cassette decks and type-in magazines built a multi-billion pound industry from their bedrooms.</p>
      </a>
      <a href="/vault/vic-ii" class="featured-card">
        <span class="featured-kicker">Hardware</span>
        <h3 class="featured-title">Inside the VIC‑II</h3>
        <p class="featured-desc">Sprites, scrolling, and the signature look of the C64.</p>
      </a>
      <a href="/vault/cassette-loading" class="featured-card">
        <span class="featured-kicker">Technique</span>
        <h3 class="featured-title">How a Cassette Becomes a Game</h3>
        <p class="featured-desc">From magnetic stripes to moving sprites.</p>
      </a>
    </div>
  </section>

  <!-- Hardware -->
  <section class="category-section">
    <h2>
      <span class="category-icon">🔧</span>
      Hardware
    </h2>
    <p class="category-intro">The machines and chips that made it all possible.</p>
    <div class="article-grid">
      {categories.hardware.map(article => (
        <a href={article.url} class="article-card">
          <h3 class="article-title">{article.name}</h3>
          <p class="article-desc">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- People -->
  <section class="category-section">
    <h2>
      <span class="category-icon">👾</span>
      People
    </h2>
    <p class="category-intro">The developers, designers, and composers who defined the era.</p>
    <div class="article-grid">
      {categories.people.map(article => (
        <a href={article.url} class="article-card">
          <h3 class="article-title">{article.name}</h3>
          <p class="article-desc">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Companies -->
  <section class="category-section">
    <h2>
      <span class="category-icon">🏢</span>
      Companies & Studios
    </h2>
    <p class="category-intro">From bedroom operations to publishing empires.</p>
    <div class="article-grid">
      {categories.companies.map(article => (
        <a href={article.url} class="article-card">
          <h3 class="article-title">{article.name}</h3>
          <p class="article-desc">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Games -->
  <section class="category-section">
    <h2>
      <span class="category-icon">🎮</span>
      Classic Games
    </h2>
    <p class="category-intro">The titles that pushed boundaries and defined genres.</p>
    <div class="article-grid">
      {categories.games.map(article => (
        <a href={article.url} class="article-card">
          <h3 class="article-title">{article.name}</h3>
          <p class="article-desc">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Culture -->
  <section class="category-section">
    <h2>
      <span class="category-icon">📚</span>
      Culture & Community
    </h2>
    <p class="category-intro">Magazines, movements, and the scenes that connected it all.</p>
    <div class="article-grid">
      {categories.culture.map(article => (
        <a href={article.url} class="article-card">
          <h3 class="article-title">{article.name}</h3>
          <p class="article-desc">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Techniques -->
  <section class="category-section">
    <h2>
      <span class="category-icon">⚙️</span>
      Techniques & Technology
    </h2>
    <p class="category-intro">The clever tricks and deep system knowledge that made magic happen.</p>
    <div class="article-grid">
      {categories.techniques.map(article => (
        <a href={article.url} class="article-card">
          <h3 class="article-title">{article.name}</h3>
          <p class="article-desc">{article.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Contribute CTA -->
  <section class="contribute-section">
    <div class="contribute-card">
      <h2 class="contribute-title">📖 Help Expand The Vault</h2>
      <p class="contribute-desc">
        Have sources, scans, memories, or technical insights to add? The Vault grows with community expertise.
      </p>
      <a href="https://github.com/code198x" class="contribute-button" target="_blank" rel="noopener noreferrer">
        Contribute on GitHub →
      </a>
    </div>
  </section>

  <style>
    .vault-intro {
      max-width: 65ch;
      margin-bottom: var(--space-12);
      font-size: 1.125rem;
      line-height: 1.7;
    }

    /* Featured Section */
    .featured-section {
      margin-bottom: var(--space-16);
    }

    .featured-section h2 {
      font-size: 1.5rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .featured-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-4);
      margin-bottom: var(--space-8);
    }

    .featured-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .featured-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
      border-color: var(--color-primary);
    }

    .featured-card--large {
      grid-row: span 2;
    }

    .featured-kicker {
      display: block;
      font-size: 0.75rem;
      color: var(--color-primary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .featured-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .featured-card--large .featured-title {
      font-size: 2rem;
    }

    .featured-desc {
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Category Sections */
    .category-section {
      margin-bottom: var(--space-16);
    }

    .category-section h2 {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: 1.75rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .category-icon {
      font-size: 1.5rem;
    }

    .category-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
      font-size: 1rem;
    }

    .article-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .article-card {
      display: block;
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .article-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--color-primary);
    }

    .article-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .article-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* Contribute Section */
    .contribute-section {
      margin-top: var(--space-16);
      margin-bottom: var(--space-8);
    }

    .contribute-card {
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
      color: white;
      padding: var(--space-8);
      border-radius: 0.75rem;
      text-align: center;
    }

    .contribute-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-4);
      color: white;
    }

    .contribute-desc {
      font-size: 1.125rem;
      margin-bottom: var(--space-6);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      opacity: 0.95;
    }

    .contribute-button {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: white;
      color: var(--color-primary);
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .contribute-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .featured-grid {
        grid-template-columns: 1fr;
      }

      .featured-card--large {
        grid-row: span 1;
      }

      .article-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</VaultLayout>
