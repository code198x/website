---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import { HardDrive, Cpu, Users, Building2, Gamepad2, BookOpen, Wrench, Library } from '@lucide/astro';

// Get all vault entries from the content collection
const allEntries = await getCollection('vault');

// Group entries by category
const entriesByCategory = allEntries.reduce((acc, entry) => {
  const category = entry.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push({
    name: entry.data.title,
    url: `/vault/${entry.slug}`,
    desc: entry.data.summary,
  });
  return acc;
}, {} as Record<string, { name: string; url: string; desc: string }[]>);

// Sort entries within each category alphabetically
Object.keys(entriesByCategory).forEach(category => {
  entriesByCategory[category].sort((a, b) => a.name.localeCompare(b.name));
});

// Preview limit per category
const PREVIEW_LIMIT = 6;

// Category metadata with accent colors
const categoryMeta = {
  systems: { name: 'Systems', icon: HardDrive, intro: 'The machines that defined an era.', color: '#64ffda' },
  hardware: { name: 'Hardware', icon: Cpu, intro: 'The chips and components that made it all possible.', color: '#fbbf24' },
  people: { name: 'People', icon: Users, intro: 'The developers, designers, and composers who defined the era.', color: '#a78bfa' },
  companies: { name: 'Companies & Studios', icon: Building2, intro: 'From bedroom operations to publishing empires.', color: '#34d399' },
  games: { name: 'Classic Games', icon: Gamepad2, intro: 'The titles that pushed boundaries and defined genres.', color: '#f472b6' },
  culture: { name: 'Culture & Community', icon: BookOpen, intro: 'Magazines, movements, and the scenes that connected it all.', color: '#38bdf8' },
  techniques: { name: 'Techniques & Technology', icon: Wrench, intro: 'The clever tricks and deep system knowledge that made magic happen.', color: '#818cf8' },
};

---

<Layout title="The Vault" description="Explore the people, hardware, companies, games, and techniques that defined 1980s home computing.">
  <!-- Hero Section -->
  <section class="vault-hero">
    <!-- Animated background shapes -->
    <div class="hero-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
      <div class="shape shape-4"></div>
      <div class="shape shape-5"></div>
    </div>

    <!-- Grid overlay -->
    <div class="hero-grid"></div>

    <!-- Scanlines -->
    <div class="hero-scanlines"></div>

    <!-- Animated beam -->
    <div class="hero-beam"></div>

    <div class="hero-content">
      <div class="hero-icon"><Library size={48} /></div>
      <h1 class="hero-title">The Vault</h1>
      <p class="hero-subtitle">An encyclopaedia of vintage computing</p>
      <p class="hero-description">
        A curated collection of reference articles connecting hands-on lessons to their cultural and technical roots. From the chips that powered the machines to the people who pushed them to their limits.
      </p>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{allEntries.length}</div>
          <div class="stat-label">Articles</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">{Object.keys(entriesByCategory).length}</div>
          <div class="stat-label">Categories</div>
        </div>
      </div>
    </div>
  </section>

  <article class="vault-page">

    <!-- Category Sections -->
    {['systems', 'hardware', 'people', 'companies', 'games', 'culture', 'techniques'].map(categoryKey => {
      const meta = categoryMeta[categoryKey];
      const articles = entriesByCategory[categoryKey] || [];
      if (articles.length === 0) return null;

      const IconComponent = meta.icon;
      const previewArticles = articles.slice(0, PREVIEW_LIMIT);
      const hasMore = articles.length > PREVIEW_LIMIT;

      return (
        <section class="category-section" style={`--category-color: ${meta.color};`}>
          <div class="category-header">
            <h2>
              <span class="category-icon"><IconComponent size={28} /></span>
              {meta.name}
            </h2>
            {hasMore && (
              <a href={`/vault/category/${categoryKey}`} class="view-all-link">
                View all {articles.length} articles →
              </a>
            )}
          </div>
          <p class="category-intro">{meta.intro}</p>
          <div class="article-grid">
            {previewArticles.map(article => (
              <a href={article.url} class="article-card">
                <div class="card-glow"></div>
                <div class="card-content">
                  <h3 class="article-title">{article.name}</h3>
                  <p class="article-desc"><InlineMarkdown text={article.desc} /></p>
                </div>
                <div class="card-corner tl"></div>
                <div class="card-corner tr"></div>
                <div class="card-corner bl"></div>
                <div class="card-corner br"></div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <!-- Contribute CTA -->
    <section class="contribute-section">
      <div class="contribute-card">
        <!-- Animated shapes -->
        <div class="cta-shapes">
          <div class="cta-shape cta-shape-1"></div>
          <div class="cta-shape cta-shape-2"></div>
          <div class="cta-shape cta-shape-3"></div>
        </div>
        <!-- Grid overlay -->
        <div class="cta-grid"></div>
        <!-- Scanlines -->
        <div class="cta-scanlines"></div>
        <!-- Corner decorations -->
        <div class="cta-corner tl"></div>
        <div class="cta-corner tr"></div>
        <div class="cta-corner bl"></div>
        <div class="cta-corner br"></div>
        <!-- Content -->
        <div class="contribute-content">
          <h2 class="contribute-title">Help Expand The Vault</h2>
          <p class="contribute-desc">
            Have sources, scans, memories, or technical insights to add? The Vault grows with community expertise.
          </p>
          <a href="https://github.com/code198x" class="contribute-button" target="_blank" rel="noopener noreferrer">
            Contribute on GitHub →
          </a>
        </div>
      </div>
    </section>
  </article>

  <style>
    /* Animations */
    @keyframes float-1 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(15px, -20px) rotate(5deg); }
      50% { transform: translate(-10px, -35px) rotate(-3deg); }
      75% { transform: translate(20px, -15px) rotate(8deg); }
    }

    @keyframes float-2 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(-20px, 15px) rotate(-8deg); }
      50% { transform: translate(15px, 25px) rotate(5deg); }
      75% { transform: translate(-25px, 10px) rotate(-5deg); }
    }

    @keyframes float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(25px, -20px) scale(1.1); }
      66% { transform: translate(-15px, 15px) scale(0.95); }
    }

    @keyframes float-4 {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      50% { transform: translate(-30px, -25px) rotate(180deg); }
    }

    @keyframes float-5 {
      0%, 100% { transform: translate(0, 0) rotate(45deg); }
      50% { transform: translate(20px, 30px) rotate(135deg); }
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.6; }
    }

    @keyframes scanline-beam {
      0% { top: -10%; }
      100% { top: 110%; }
    }

    /* Hero Section */
    .vault-hero {
      min-height: 380px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Animated shapes */
    .hero-shapes {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .shape {
      position: absolute;
      opacity: 0.35;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    /* Shape 1: Square - top left */
    .shape-1 {
      top: 12%;
      left: 8%;
      width: 60px;
      height: 60px;
      border: 3px solid #64ffda;
      box-shadow: 0 0 20px #64ffda, inset 0 0 10px rgba(100, 255, 218, 0.1);
      animation: float-1 14s infinite, pulse-glow 5s infinite;
    }

    /* Shape 2: Circle - top right */
    .shape-2 {
      top: 18%;
      right: 12%;
      width: 50px;
      height: 50px;
      border: 3px solid #a78bfa;
      border-radius: 50%;
      box-shadow: 0 0 20px #a78bfa;
      animation: float-2 16s infinite, pulse-glow 6s infinite 1s;
    }

    /* Shape 3: Diamond - left */
    .shape-3 {
      bottom: 25%;
      left: 12%;
      width: 45px;
      height: 45px;
      border: 3px solid #f472b6;
      transform: rotate(45deg);
      box-shadow: 0 0 20px #f472b6;
      animation: float-3 18s infinite, pulse-glow 7s infinite 2s;
    }

    /* Shape 4: Small circle - bottom right */
    .shape-4 {
      bottom: 20%;
      right: 15%;
      width: 35px;
      height: 35px;
      border: 3px solid #fbbf24;
      border-radius: 50%;
      box-shadow: 0 0 15px #fbbf24;
      animation: float-4 20s infinite, pulse-glow 4s infinite;
    }

    /* Shape 5: Triangle - bottom center-right */
    .shape-5 {
      bottom: 30%;
      right: 25%;
      width: 0;
      height: 0;
      border-left: 25px solid transparent;
      border-right: 25px solid transparent;
      border-bottom: 40px solid #38bdf8;
      filter: drop-shadow(0 0 15px #38bdf8);
      animation: float-5 22s infinite, pulse-glow 8s infinite 3s;
    }

    /* Grid overlay */
    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 1;
    }

    /* Scanlines */
    .hero-scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
      );
      pointer-events: none;
      z-index: 2;
    }

    /* Animated beam */
    .hero-beam {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(100, 255, 218, 0.1) 20%,
        rgba(100, 255, 218, 0.3) 50%,
        rgba(100, 255, 218, 0.1) 80%,
        transparent 100%
      );
      animation: scanline-beam 10s linear infinite;
      pointer-events: none;
      z-index: 3;
    }

    .hero-content {
      text-align: center;
      color: white;
      padding: var(--space-10) var(--space-4);
      position: relative;
      z-index: 5;
      max-width: 700px;
    }

    .hero-icon {
      color: #64ffda;
      margin-bottom: var(--space-4);
      filter: drop-shadow(0 0 20px rgba(100, 255, 218, 0.5));
    }

    .hero-title {
      font-family: var(--font-family-mono);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: 0.05em;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5), 0 0 40px rgba(100, 255, 218, 0.3);
    }

    .hero-subtitle {
      font-size: 1.25rem;
      opacity: 0.9;
      margin-bottom: var(--space-4);
      font-style: italic;
      text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    }

    .hero-description {
      font-size: 1rem;
      line-height: 1.7;
      opacity: 0.85;
      margin-bottom: var(--space-6);
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(4px);
      padding: var(--space-4) var(--space-8);
      border-radius: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: #64ffda;
      text-shadow: 0 0 20px rgba(100, 255, 218, 0.5);
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
      .shape {
        animation: none;
      }
      .hero-beam {
        animation: none;
        opacity: 0;
      }
    }

    @media (max-width: 768px) {
      .shape {
        opacity: 0.2;
      }
      .shape-1, .shape-2, .shape-3, .shape-4 {
        width: 35px;
        height: 35px;
      }
    }

    .vault-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-5);
    }

    .vault-header {
      margin-bottom: var(--space-12);
    }

    .vault-title {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
    }

    .vault-subtitle {
      font-size: 1.25rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
    }

    .vault-intro {
      max-width: 65ch;
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    /* Category Sections */
    .category-section {
      margin-bottom: var(--space-16);
      padding-top: var(--space-8);
      position: relative;
    }

    .category-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--category-color) 0%, transparent 60%);
    }

    .category-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
      flex-wrap: wrap;
    }

    .category-section h2 {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: 1.75rem;
      margin-bottom: 0;
      color: var(--color-text);
    }

    .category-icon {
      display: flex;
      align-items: center;
      color: var(--category-color);
      filter: drop-shadow(0 0 8px var(--category-color));
    }

    .view-all-link {
      font-size: 0.9rem;
      color: var(--category-color);
      text-decoration: none;
      font-weight: 500;
      white-space: nowrap;
      transition: all var(--transition-base);
    }

    .view-all-link:hover {
      text-shadow: 0 0 10px var(--category-color);
    }

    .category-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
      font-size: 1rem;
    }

    .article-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .article-card {
      display: block;
      padding: 3px;
      background: var(--color-border);
      text-decoration: none;
      color: var(--color-text);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .article-card .card-content {
      background: var(--color-surface);
      padding: var(--space-6);
      height: 100%;
      position: relative;
      z-index: 1;
      transition: background 0.3s ease;
    }

    .article-card .card-glow {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        var(--category-color) 0%,
        color-mix(in oklch, var(--category-color) 70%, var(--color-primary) 30%) 50%,
        var(--category-color) 100%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 0;
    }

    /* Corner decorations */
    .article-card .card-corner {
      position: absolute;
      width: 10px;
      height: 10px;
      border-color: var(--category-color);
      border-style: solid;
      border-width: 0;
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 2;
    }

    .article-card .card-corner.tl { top: 4px; left: 4px; border-top-width: 2px; border-left-width: 2px; }
    .article-card .card-corner.tr { top: 4px; right: 4px; border-top-width: 2px; border-right-width: 2px; }
    .article-card .card-corner.bl { bottom: 4px; left: 4px; border-bottom-width: 2px; border-left-width: 2px; }
    .article-card .card-corner.br { bottom: 4px; right: 4px; border-bottom-width: 2px; border-right-width: 2px; }

    .article-card:hover,
    .article-card:focus-visible {
      transform: translateY(-4px);
      box-shadow:
        0 12px 24px rgba(0, 0, 0, 0.1),
        0 0 20px color-mix(in oklch, var(--category-color) 20%, transparent 80%);
    }

    .article-card:hover .card-glow,
    .article-card:focus-visible .card-glow {
      opacity: 1;
    }

    .article-card:hover .card-corner,
    .article-card:focus-visible .card-corner {
      opacity: 1;
    }

    .article-card:hover .article-title {
      color: var(--category-color);
    }

    .article-card:focus-visible {
      outline: 2px solid var(--category-color);
      outline-offset: 2px;
    }

    .article-title {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--color-text);
      transition: color 0.3s ease;
      font-family: var(--font-family-mono);
    }

    .article-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Reduced motion for cards */
    @media (prefers-reduced-motion: reduce) {
      .article-card:hover,
      .article-card:focus-visible {
        transform: none;
      }
    }

    /* Contribute Section */
    .contribute-section {
      margin-top: var(--space-16);
      margin-bottom: var(--space-8);
    }

    .contribute-card {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      color: white;
      padding: var(--space-12) var(--space-8);
      text-align: center;
      position: relative;
      overflow: hidden;
      border: 3px solid var(--color-border);
    }

    /* CTA Animated shapes */
    .cta-shapes {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .cta-shape {
      position: absolute;
      opacity: 0.4;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    .cta-shape-1 {
      top: 15%;
      left: 8%;
      width: 50px;
      height: 50px;
      border: 3px solid #64ffda;
      border-radius: 50%;
      box-shadow: 0 0 20px #64ffda;
      animation: float-2 12s infinite, pulse-glow 4s infinite;
    }

    .cta-shape-2 {
      top: 20%;
      right: 10%;
      width: 40px;
      height: 40px;
      border: 3px solid #a78bfa;
      transform: rotate(45deg);
      box-shadow: 0 0 15px #a78bfa;
      animation: float-1 15s infinite, pulse-glow 5s infinite 1s;
    }

    .cta-shape-3 {
      bottom: 20%;
      left: 15%;
      width: 0;
      height: 0;
      border-left: 20px solid transparent;
      border-right: 20px solid transparent;
      border-bottom: 35px solid #f472b6;
      filter: drop-shadow(0 0 12px #f472b6);
      animation: float-3 18s infinite, pulse-glow 6s infinite 2s;
    }

    /* CTA Grid overlay */
    .cta-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 1;
    }

    /* CTA Scanlines */
    .cta-scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.08) 2px,
        rgba(0, 0, 0, 0.08) 4px
      );
      pointer-events: none;
      z-index: 2;
    }

    /* CTA Corner decorations */
    .cta-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border-color: #64ffda;
      border-style: solid;
      border-width: 0;
      z-index: 3;
    }

    .cta-corner.tl { top: 12px; left: 12px; border-top-width: 3px; border-left-width: 3px; }
    .cta-corner.tr { top: 12px; right: 12px; border-top-width: 3px; border-right-width: 3px; }
    .cta-corner.bl { bottom: 12px; left: 12px; border-bottom-width: 3px; border-left-width: 3px; }
    .cta-corner.br { bottom: 12px; right: 12px; border-bottom-width: 3px; border-right-width: 3px; }

    .contribute-content {
      position: relative;
      z-index: 5;
    }

    .contribute-title {
      font-family: var(--font-family-mono);
      font-size: 1.75rem;
      font-weight: 900;
      margin-bottom: var(--space-4);
      color: white;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5), 0 0 30px rgba(100, 255, 218, 0.3);
      letter-spacing: 0.03em;
    }

    .contribute-desc {
      font-size: 1.125rem;
      margin-bottom: var(--space-6);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      opacity: 0.9;
      line-height: 1.6;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
    }

    .contribute-button {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: transparent;
      color: #64ffda;
      font-family: var(--font-family-mono);
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: 2px solid #64ffda;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .contribute-button:hover {
      background: #64ffda;
      color: #0f3460;
      box-shadow: 0 0 25px rgba(100, 255, 218, 0.5);
      transform: translateY(-2px);
    }

    /* Reduced motion for CTA */
    @media (prefers-reduced-motion: reduce) {
      .cta-shape {
        animation: none;
      }
      .contribute-button:hover {
        transform: none;
      }
    }

    @media (max-width: 768px) {
      .cta-shape {
        opacity: 0.25;
      }
      .cta-shape-1 { width: 35px; height: 35px; }
