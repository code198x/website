---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import FeaturedEntries from "../../components/FeaturedEntries.astro";
import { getCollection } from 'astro:content';
import { vaultData } from "../../data/vault-data.js";
import { getRecentEntries, getFeaturedEntries } from "../../utils/breadcrumbs";

// Get counts for each collection
const collectionCounts: Record<string, number> = {};

try {
  collectionCounts.hardware = (await getCollection('hardware')).length;
} catch { collectionCounts.hardware = 0; }

try {
  collectionCounts.people = (await getCollection('people')).length;
} catch { collectionCounts.people = 0; }

try {
  collectionCounts.companies = (await getCollection('companies')).length;
} catch { collectionCounts.companies = 0; }

try {
  collectionCounts.applications = (await getCollection('applications')).length;
} catch { collectionCounts.applications = 0; }

try {
  collectionCounts['development-tools'] = (await getCollection('developmentTools')).length;
} catch { collectionCounts['development-tools'] = 0; }

try {
  collectionCounts.utilities = (await getCollection('utilities')).length;
} catch { collectionCounts.utilities = 0; }

try {
  collectionCounts.drivers = (await getCollection('drivers')).length;
} catch { collectionCounts.drivers = 0; }

try {
  collectionCounts.plugins = (await getCollection('plugins')).length;
} catch { collectionCounts.plugins = 0; }

try {
  collectionCounts.games = (await getCollection('games')).length;
} catch { collectionCounts.games = 0; }

try {
  collectionCounts.demos = (await getCollection('demos')).length;
} catch { collectionCounts.demos = 0; }

try {
  collectionCounts['operating-systems'] = (await getCollection('operatingSystems')).length;
} catch { collectionCounts['operating-systems'] = 0; }

try {
  collectionCounts.emulators = (await getCollection('emulators')).length;
} catch { collectionCounts.emulators = 0; }

try {
  collectionCounts['programming-languages'] = (await getCollection('programmingLanguages')).length;
} catch { collectionCounts['programming-languages'] = 0; }

try {
  collectionCounts.techniques = (await getCollection('techniques')).length;
} catch { collectionCounts.techniques = 0; }

try {
  collectionCounts.publications = (await getCollection('publications')).length;
} catch { collectionCounts.publications = 0; }

try {
  collectionCounts.events = (await getCollection('events')).length;
} catch { collectionCounts.events = 0; }

try {
  collectionCounts.groups = (await getCollection('groups')).length;
} catch { collectionCounts.groups = 0; }

try {
  collectionCounts.formats = (await getCollection('formats')).length;
} catch { collectionCounts.formats = 0; }

try {
  collectionCounts.culture = (await getCollection('culture')).length;
} catch { collectionCounts.culture = 0; }

// Calculate total entries
const totalEntries = Object.values(collectionCounts).reduce((sum, count) => sum + count, 0);

// Define vault categories with metadata
const vaultCategories: Array<{
  title: string;
  slug: string;
  icon: string;
  colorClass: string;
  description: string;
  examples: string[];
  count: number | string;
}> = [
  {
    title: "Hardware",
    slug: "hardware",
    icon: "🖥️",
    colorClass: "blue",
    description: "Systems, chips, peripherals, and modifications that defined an era",
    examples: ["Commodore 64", "ZX Spectrum", "MOS 6581 SID", "Z80 CPU"],
    count: collectionCounts.hardware || 0
  },
  {
    title: "People",
    slug: "people",
    icon: "👤",
    colorClass: "green",
    description: "Pioneers, programmers, and visionaries who shaped computing history",
    examples: ["Jack Tramiel", "Rob Hubbard", "Clive Sinclair", "Shigeru Miyamoto"],
    count: collectionCounts.people || 0
  },
  {
    title: "Companies",
    slug: "companies",
    icon: "🏢",
    colorClass: "purple",
    description: "The corporations and startups that built the industry",
    examples: ["Commodore", "Sinclair Research", "Ocean Software", "Nintendo"],
    count: collectionCounts.companies || 0
  },
  {
    title: "Applications",
    slug: "applications",
    icon: "💼",
    colorClass: "amber",
    description: "Productivity and creative software",
    examples: ["WordPerfect", "Deluxe Paint", "VisiCalc", "PageMaker"],
    count: collectionCounts.applications || 0
  },
  {
    title: "Development Tools",
    slug: "development-tools",
    icon: "🔧",
    colorClass: "rose",
    description: "Compilers, assemblers, and IDEs",
    examples: ["Turbo Pascal", "ACME", "SEKA", "DevPac"],
    count: collectionCounts['development-tools'] || 0
  },
  {
    title: "Utilities",
    slug: "utilities",
    icon: "🛠️",
    colorClass: "teal",
    description: "System tools and file managers",
    examples: ["Norton Commander", "FastCopy", "DiskMaster", "SysInfo"],
    count: collectionCounts.utilities || 0
  },
  {
    title: "Drivers",
    slug: "drivers",
    icon: "⚙️",
    colorClass: "stone",
    description: "Hardware drivers and system extensions",
    examples: ["HIMEM.SYS", "EMM386", "Mouse drivers", "SCSI drivers"],
    count: collectionCounts.drivers || 0
  },
  {
    title: "Plugins",
    slug: "plugins",
    icon: "🧩",
    colorClass: "fuchsia",
    description: "Extensions, mods, and add-ons",
    examples: ["Action Replay", "Game Genie codes", "GEOS apps", "BBS doors"],
    count: collectionCounts.plugins || 0
  },
  {
    title: "Games",
    slug: "games",
    icon: "🎮",
    colorClass: "orange",
    description: "Entertainment software that defined generations",
    examples: ["Elite", "Manic Miner", "The Last Ninja", "Impossible Mission"],
    count: collectionCounts.games || 0
  },
  {
    title: "Demos",
    slug: "demos",
    icon: "🎬",
    colorClass: "cyan",
    description: "Demoscene productions that pushed hardware beyond limits",
    examples: ["Second Reality", "Edge of Disgrace", "Unreal", "9 Fingers"],
    count: collectionCounts.demos || 0
  },
  {
    title: "Operating Systems",
    slug: "operating-systems",
    icon: "🖥️",
    colorClass: "slate",
    description: "The foundations that everything ran on",
    examples: ["AmigaOS", "GEOS", "CP/M", "ProDOS"],
    count: collectionCounts['operating-systems'] || 0
  },
  {
    title: "Emulators",
    slug: "emulators",
    icon: "🔄",
    colorClass: "violet",
    description: "Preservation through accurate emulation",
    examples: ["VICE", "MAME", "WinUAE", "DOSBox"],
    count: collectionCounts.emulators || 0
  },
  {
    title: "Programming Languages",
    slug: "programming-languages",
    icon: "📝",
    colorClass: "emerald",
    description: "Languages and tools that enabled creation",
    examples: ["BASIC", "6502 Assembly", "AMOS", "Turbo Pascal"],
    count: collectionCounts['programming-languages'] || 0
  },
  {
    title: "Techniques",
    slug: "techniques",
    icon: "⚡",
    colorClass: "red",
    description: "Programming tricks and hardware hacks that made the impossible possible",
    examples: ["Sprite Multiplexing", "Raster Interrupts", "Mode 7", "Copper Effects"],
    count: collectionCounts.techniques || 0
  },
  {
    title: "Publications",
    slug: "publications",
    icon: "📖",
    colorClass: "indigo",
    description: "Magazines, books, and manuals that spread knowledge",
    examples: ["Compute!", "Zzap!64", "Your Sinclair", "The C64 PRG"],
    count: collectionCounts.publications || 0
  },
  {
    title: "Events",
    slug: "events",
    icon: "🎪",
    colorClass: "pink",
    description: "Demo parties, trade shows, and historic launches",
    examples: ["Assembly", "The Party", "CES", "C64 Launch"],
    count: collectionCounts.events || 0
  },
  {
    title: "Groups",
    slug: "groups",
    icon: "👥",
    colorClass: "teal",
    description: "Demo groups, cracking teams, and development studios",
    examples: ["Fairlight", "Future Crew", "Eagle Soft", "Llamasoft"],
    count: collectionCounts.groups || 0
  },
  {
    title: "Formats",
    slug: "formats",
    icon: "💾",
    colorClass: "orange",
    description: "File formats, storage media, and technical standards",
    examples: [".TAP", ".D64", "Cassettes", "PAL/NTSC"],
    count: collectionCounts.formats || 0
  },
  {
    title: "Culture",
    slug: "culture",
    icon: "🌟",
    colorClass: "cyan",
    description: "Demo scene, BBS culture, and computing phenomena",
    examples: ["Demo Scene", "BBS Networks", "Copy Parties", "Piracy"],
    count: collectionCounts.culture || 0
  },
  {
    title: "Timeline",
    slug: "timeline",
    icon: "📅",
    colorClass: "slate",
    description: "Chronological journey through computing history",
    examples: ["1982: C64 Launch", "1983: Video Game Crash", "1985: Amiga"],
    count: "Interactive" // Special case, will be handled differently
  }
];

// Get featured and recent entries for display
const featuredEntries = getFeaturedEntries(vaultData, 6);
const recentEntries = getRecentEntries(vaultData, 6);

// Structured data for vault
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "The Vault - Retro Computing Encyclopedia",
  "description": "Comprehensive encyclopedia of retro computing history including hardware, people, companies, games, and innovations from the golden age of home computing.",
  "url": "https://code198x.stevehill.xyz/vault",
  "author": {
    "@type": "Organization",
    "name": "Code Like It's 198x"
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": vaultData.length,
    "itemListElement": featuredEntries.map((entry, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Article",
        "name": entry.n,
        "description": entry.d,
        "url": `https://code198x.stevehill.xyz/vault/${entry.c}/${entry.s}`
      }
    }))
  }
};
---

<Layout
  title="The Vault - Retro Computing Encyclopedia"
  description="Explore the complete history of retro computing. From legendary computers like Commodore 64 and Amiga to the pioneers who built the digital age. Hardware, software, people, and stories."
  structuredData={structuredData}
>
  <Hero
    title="The Vault"
    subtitle="Your Encyclopedia of Retro Computing History"
    description="Explore the people, companies, games, and innovations that defined the golden age of home computing. Every entry connects to our lessons, showing you not just the 'how' but the 'who', 'what', 'when', and 'why'."
    variant="gradient"
    badge={{
      text: `🔓 ${totalEntries} Total Entries`,
      color: "#10b981"
    }}
  />

  <div class="vault-container">
    <!-- Category Grid -->
    <div class="container">
      <SectionHeader
        title="Explore the Archives"
        subtitle="Dive deep into the stories behind the code"
      />
      
      <div class="vault-grid">
        {vaultCategories.map((category) => (
          <a href={`/vault/${category.slug}`} class={`vault-card vault-card--${category.colorClass}`}>
            <div class="vault-card__header">
              <span class="vault-card__icon">{category.icon}</span>
              <span class="vault-card__count">
                {category.slug === 'timeline'
                  ? 'Interactive Timeline'
                  : `${category.count} ${category.count === 1 ? 'entry' : 'entries'}`}
              </span>
            </div>
            <div class="vault-card__body">
              <h3 class="vault-card__title">{category.title}</h3>
              <p class="vault-card__description">{category.description}</p>
              <div class="vault-card__examples">
                <span class="vault-card__examples-label">Featured:</span>
                <span class="vault-card__examples-list">{category.examples.join(" • ")}</span>
              </div>
            </div>
            <div class="vault-card__footer">
              <span class="vault-card__action">Browse {category.title} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Featured Connections Section -->
    <div class="featured-section">
      <div class="container">
        <SectionHeader
          title="Everything Is Connected"
          subtitle="See how people, companies, and innovations influenced each other"
        />
        
        <div class="connection-examples">
          <div class="connection-card">
            <h4>The Commodore Story</h4>
            <div class="connection-flow">
              <span class="connection-node">Jack Tramiel</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Commodore</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">C64</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">SID Chip</span>
            </div>
            <p>From Holocaust survivor to computer revolution leader</p>
          </div>
          
          <div class="connection-card">
            <h4>The British Invasion</h4>
            <div class="connection-flow">
              <span class="connection-node">Clive Sinclair</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">ZX Spectrum</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Bedroom Coders</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Ocean Software</span>
            </div>
            <p>How affordable computers created a gaming industry</p>
          </div>
          
          <div class="connection-card">
            <h4>Demo Scene Origins</h4>
            <div class="connection-flow">
              <span class="connection-node">Cracking Groups</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Intros</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">Demo Parties</span>
              <span class="connection-arrow">→</span>
              <span class="connection-node">New Techniques</span>
            </div>
            <p>From piracy to pushing hardware beyond its limits</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Entries -->
    <FeaturedEntries
      title="Featured Entries"
      subtitle="Curated highlights from across the vault - significant entries that shaped computing history"
      entries={featuredEntries}
      showMoreLink="/vault/search"
    />

    <!-- Recently Added -->
    <FeaturedEntries
      title="Recently Added"
      subtitle="The latest additions to our retro computing encyclopedia"
      entries={recentEntries}
      showMoreLink="/vault/search"
      className="recent-entries"
    />

    <!-- Call to Action -->
    <div class="vault-cta">
      <div class="container text-center">
        <h2>Start Your Journey Through History</h2>
        <p>Every lesson references Vault entries. Every Vault entry enhances your learning.</p>
        <div class="vault-cta__actions">
          <a href="/vault/timeline" class="btn btn--primary">
            <span>📅</span>
            <span>Explore the Timeline</span>
          </a>
          <a href="/lessons" class="btn btn--secondary">
            <span>📚</span>
            <span>Start Learning</span>
          </a>
        </div>
      </div>
    </div>
  </div>

</Layout>

<style>
  /* Custom styling for Recently Added section */
  .recent-entries {
    background: linear-gradient(135deg, var(--color-background-secondary) 0%, var(--color-background) 100%);
  }

  .recent-entries .featured-entries__title::before {
    content: "🆕";
  }

  .recent-entries .featured-entry-card::before {
    background: linear-gradient(90deg, var(--color-accent), var(--color-secondary));
  }

  .recent-entries .featured-entry-card:hover {
    border-color: var(--color-accent);
  }
</style>