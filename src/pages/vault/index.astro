---
import {gameStudies, studyPath, GAME_STUDIES_ROOT} from '../../data/game-studies.mjs';
import { getCollection } from 'astro:content';
import VaultFeature from '../../components/VaultFeature.astro';
import VaultExplorer from '../../components/VaultExplorer.astro';
import { ArrowRight } from '@lucide/astro';
import { vaultFeatures, vaultExploration, vaultDiscoveries } from '../../data/vault-features';
import { resolveVaultFeatures, resolveVaultExploration, resolveVaultDiscoveries } from '../../lib/vault-features';
import VaultOpening from '../../components/VaultOpening.astro';
import Center from '../../components/layout/Center.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import Switcher from '../../components/layout/Switcher.astro';
import Grid from '../../components/layout/Grid.astro';
import Cluster from '../../components/layout/Cluster.astro';
import Layout from '../../layouts/Layout.astro';
import { getVaultCategories } from '../../lib/categories';
import '../../styles/vault.css';
import { vaultColourGroup } from '../../lib/vault-colours';

const entries = await getCollection('vault');
const categories = (await getVaultCategories()).map(category => ({
  id: category.id,
  name: category.data.name,
  colour: vaultColourGroup(category.id),
  count: entries.filter(entry => entry.data.category === category.id).length,
})).filter(category => category.count > 0);
const [feature] = resolveVaultFeatures(vaultFeatures, entries);
const reading = feature.related;
const exploration = resolveVaultExploration(vaultExploration, entries);
const discoveries = resolveVaultDiscoveries(vaultDiscoveries, entries);
const searchIndex = [...entries.map(entry => ({
  title: entry.data.title,
  url: `/vault/${entry.id}`,
  category: categories.find(category => category.id === entry.data.category)?.name ?? entry.data.category,
  colour: vaultColourGroup(entry.data.category),
})),{title:'Game studies',url:GAME_STUDIES_ROOT,category:'Game studies',colour:vaultColourGroup('games')},...gameStudies.map(study=>({title:study.title+' — Game study',url:studyPath(study.slug),category:'Game studies',colour:vaultColourGroup('games')}))].sort((a, b) => a.title.localeCompare(b.title));
---

<Layout title="The Vault" description="Explore the people, hardware, companies, games, and techniques that defined home computing.">
  <VaultOpening articles={entries.length} subjects={categories.length} />
  <Center max="frame" gutters="page" class="vault-index">
    <Switcher threshold="40rem" space={12} class="vault-opening">
      <p class="vault-introduction">Every subject leads somewhere.<br />Explore the people, machines and ideas that connect computing’s history.</p>
        <div class="vault-search" data-vault-search>
          <label for="vault-query">Search article titles</label>
          <div class="vault-search-field"><input id="vault-query" type="search" placeholder="Try Z80, Tetris, or Sinclair" autocomplete="off" aria-controls="vault-results" /><button type="button" data-clear hidden>Clear</button></div>
          <div id="vault-results" hidden><p class="vault-search-status" aria-live="polite"></p><ul></ul></div>
          <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
        </div>
    </Switcher>
    <Sidebar sideWidth="12rem" contentMin="70%" space={8} noStretch class="vault-columns">
      <aside class="vault-directory" aria-label="Subject directory">
        <nav class="vault-subjects" aria-label="Vault subjects">
          <details open data-vault-subjects><summary>Browse by subject</summary>
          <Grid as="ul" min="8rem" space={6}>{categories.map(category => (
            <li data-vault-colour={category.colour}><a href={`/vault/category/${category.id}`}><span>{category.name}</span><small class="label">{category.count}</small></a></li>
          ))}</Grid></details>
          <a href={GAME_STUDIES_ROOT} class="vault-reading-link"><span><strong>Game studies</strong><small>Explore how a whole game works and why it matters.</small></span><ArrowRight size={20} aria-hidden="true" /></a>
        </nav>
      </aside>
      <div class="vault-editorial">
        <VaultExplorer exploration={exploration} categories={categories} />
        <section class="vault-further" aria-labelledby="vault-further-title">
          <h2 id="vault-further-title">See what’s happening.</h2>
          <Sidebar side="right" sideWidth="16rem" contentMin="66%" space={8} noStretch>
            <VaultFeature feature={feature} categoryName={categories.find(category => category.id === feature.entry.data.category)!.name} />
            <Grid min="12rem" space={6} class="vault-reading">
              <h3>Keep exploring the technique.</h3>
              {reading.map(entry => (
                <a href={`/vault/${entry.id}`} class="vault-reading-link" data-vault-colour={vaultColourGroup(entry.data.category)}>
                  <span><strong>{entry.data.title}</strong><small>{entry.data.subtitle}</small><span class="vault-category-label">{categories.find(category => category.id === entry.data.category)?.name}</span></span>
                  <ArrowRight size={20} aria-hidden="true" />
                </a>
              ))}
            </Grid>
          </Sidebar>
        </section>
      </div>
    </Sidebar>
    <section class="vault-discoveries" aria-labelledby="vault-discoveries-title">
      <Switcher threshold="40rem" space={8} class="vault-section-heading"><h2 id="vault-discoveries-title">Another way in.</h2><p>A different machine, a different person, a different part of the story.</p></Switcher>
      <Grid min="16rem" space={8} class="vault-discovery-list">
        {discoveries.map(entry => (
          <a href={`/vault/${entry.id}`} data-vault-colour={vaultColourGroup(entry.data.category)}>
            <h3>{entry.data.title}<ArrowRight size={22} aria-hidden="true" /></h3>
            <p>{entry.data.subtitle}</p>
            <span class="vault-category-label">{categories.find(category => category.id === entry.data.category)?.name}</span>
          </a>
        ))}
      </Grid>
    </section>
    <Cluster as="section" align="baseline" space={6} class="vault-contribute">
      <h2>Help expand the Vault.</h2>
      <p>Have sources, scans, or technical insight to add?</p>
      <a href="https://github.com/code198x" rel="noopener">Contribute on GitHub <ArrowRight size={18} aria-hidden="true" /></a>
    </Cluster>
  </Center>
</Layout>

<script>
  function initialiseVaultSearch() {
    document.querySelectorAll<HTMLElement>('[data-vault-search]:not([data-bound])').forEach(root => {
      root.dataset.bound = 'true';
      const subjects = document.querySelector<HTMLDetailsElement>('[data-vault-subjects]');
      // Fold the subject list when the directory has stacked above the stories.
      const [directory, editorial] = subjects?.closest('.vault-columns')?.children ?? [];
      if (subjects && directory && editorial && (editorial as HTMLElement).offsetTop > (directory as HTMLElement).offsetTop) subjects.open = false;
      const input = root.querySelector<HTMLInputElement>('input')!;
      const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
      const results = root.querySelector<HTMLElement>('#vault-results')!;
      const status = results.querySelector<HTMLElement>('[aria-live]')!;
      const list = results.querySelector<HTMLUListElement>('ul')!;
      const index: {title: string; url: string; category: string; colour: string}[] = JSON.parse(root.querySelector('[data-search-index]')!.textContent!);
      const normalise = (value: string) => value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('en-GB');
      function update() {
        const query = normalise(input.value.trim());
        results.hidden = !query;
        clear.hidden = !query;
        list.replaceChildren();
        if (!query) return;
        const matches = index.filter(entry => normalise(entry.title).includes(query));
        status.textContent = matches.length ? `${matches.length} ${matches.length === 1 ? 'article' : 'articles'}${matches.length > 20 ? '. Showing the first 20; refine your search for more.' : '.'}` : 'No matching titles. Try a machine, person, game, or technique.';
        for (const entry of matches.slice(0, 20)) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = entry.url;
          const title = document.createElement('strong');
          title.textContent = entry.title;
          const category = document.createElement('small');
          category.textContent = entry.category;
          category.className = 'vault-category-label';
          link.dataset.vaultColour = entry.colour;
          link.append(title, category);
          item.append(link);
          list.append(item);
        }
      }
      input.addEventListener('input', update);
      clear.addEventListener('click', () => {input.value = ''; update(); input.focus();});
      input.addEventListener('keydown', event => {if(event.key === 'Escape') {input.value = ''; update();}});
    });
  }
  initialiseVaultSearch();
  document.addEventListener('astro:page-load', initialiseVaultSearch);
</script>

<style>@layer blocks {
  .vault-search-field input { flex: 1 1 0; width: 0; }
  .vault-search-field button { flex: 0 0 auto; position: static; min-height: 44px; }
  /* The opening band runs the full width; the index below re-centres itself. */
  :global(main#main-content[data-site-frame]:has(> .vault-atlas)) { max-width: none; }
}
</style>
