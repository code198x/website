---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { HardDrive, Cpu, Users, Building2, Gamepad2, BookOpen, Wrench } from '@lucide/astro';

// Get all vault entries from the content collection
const allEntries = await getCollection('vault');

// Group entries by category
const entriesByCategory = allEntries.reduce((acc, entry) => {
  const category = entry.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push({
    name: entry.data.title,
    url: `/vault/${entry.slug}`,
    desc: entry.data.summary,
  });
  return acc;
}, {} as Record<string, { name: string; url: string; desc: string }[]>);

// Sort entries within each category alphabetically
Object.keys(entriesByCategory).forEach(category => {
  entriesByCategory[category].sort((a, b) => a.name.localeCompare(b.name));
});

// Category metadata
const categoryMeta = {
  systems: { name: 'Systems', icon: HardDrive, intro: 'The machines that defined an era.' },
  hardware: { name: 'Hardware', icon: Cpu, intro: 'The chips and components that made it all possible.' },
  people: { name: 'People', icon: Users, intro: 'The developers, designers, and composers who defined the era.' },
  companies: { name: 'Companies & Studios', icon: Building2, intro: 'From bedroom operations to publishing empires.' },
  games: { name: 'Classic Games', icon: Gamepad2, intro: 'The titles that pushed boundaries and defined genres.' },
  culture: { name: 'Culture & Community', icon: BookOpen, intro: 'Magazines, movements, and the scenes that connected it all.' },
  techniques: { name: 'Techniques & Technology', icon: Wrench, intro: 'The clever tricks and deep system knowledge that made magic happen.' },
};

// Featured articles (manually curated)
const featured = {
  large: allEntries.find(e => e.slug === 'culture/bedroom-coder'),
  small: [
    allEntries.find(e => e.slug === 'hardware/vic-ii'),
    allEntries.find(e => e.slug === 'techniques/cassette-loading'),
  ].filter(Boolean),
};
---

<Layout title="The Vault" description="Explore the people, hardware, companies, games, and techniques that defined 1980s home computing.">
  <article class="vault-page">
    <header class="vault-header">
      <h1 class="vault-title">The Vault</h1>
      <p class="vault-subtitle">An encyclopaedia of vintage computing</p>
      <p class="vault-intro">
        Welcome to <strong>The Vault</strong> — a curated collection of reference articles connecting hands-on lessons to their cultural and technical roots. From the chips that powered the machines to the people who pushed them to their limits.
      </p>
    </header>

    <!-- Featured Section -->
    {featured.large && (
      <section class="featured-section">
        <h2>Start Here</h2>
        <div class="featured-grid">
          <a href={`/vault/${featured.large.slug}`} class="featured-card featured-card--large">
            <span class="featured-kicker">{categoryMeta[featured.large.data.category]?.name || 'Article'}</span>
            <h3 class="featured-title">{featured.large.data.title}</h3>
            <p class="featured-desc">{featured.large.data.summary}</p>
          </a>
          {featured.small.map(entry => entry && (
            <a href={`/vault/${entry.slug}`} class="featured-card">
              <span class="featured-kicker">{categoryMeta[entry.data.category]?.name || 'Article'}</span>
              <h3 class="featured-title">{entry.data.title}</h3>
              <p class="featured-desc">{entry.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Category Sections -->
    {['systems', 'hardware', 'people', 'companies', 'games', 'culture', 'techniques'].map(categoryKey => {
      const meta = categoryMeta[categoryKey];
      const articles = entriesByCategory[categoryKey] || [];
      if (articles.length === 0) return null;

      const IconComponent = meta.icon;
      return (
        <section class="category-section">
          <h2>
            <span class="category-icon"><IconComponent size={28} /></span>
            {meta.name}
          </h2>
          <p class="category-intro">{meta.intro}</p>
          <div class="article-grid">
            {articles.map(article => (
              <a href={article.url} class="article-card">
                <h3 class="article-title">{article.name}</h3>
                <p class="article-desc">{article.desc}</p>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <!-- Contribute CTA -->
    <section class="contribute-section">
      <div class="contribute-card">
        <h2 class="contribute-title">Help Expand The Vault</h2>
        <p class="contribute-desc">
          Have sources, scans, memories, or technical insights to add? The Vault grows with community expertise.
        </p>
        <a href="https://github.com/code198x" class="contribute-button" target="_blank" rel="noopener noreferrer">
          Contribute on GitHub →
        </a>
      </div>
    </section>
  </article>

  <style>
    .vault-page {
      max-width: 1000px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-5);
    }

    .vault-header {
      margin-bottom: var(--space-12);
    }

    .vault-title {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
    }

    .vault-subtitle {
      font-size: 1.25rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
    }

    .vault-intro {
      max-width: 65ch;
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    /* Featured Section */
    .featured-section {
      margin-bottom: var(--space-16);
    }

    .featured-section h2 {
      font-size: 1.5rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .featured-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-4);
      margin-bottom: var(--space-8);
    }

    .featured-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .featured-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
      border-color: var(--color-primary);
    }

    .featured-card--large {
      grid-row: span 2;
    }

    .featured-kicker {
      display: block;
      font-size: 0.75rem;
      color: var(--color-primary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .featured-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .featured-card--large .featured-title {
      font-size: 2rem;
    }

    .featured-desc {
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Category Sections */
    .category-section {
      margin-bottom: var(--space-16);
    }

    .category-section h2 {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: 1.75rem;
      margin-bottom: var(--space-4);
      color: var(--color-text);
    }

    .category-icon {
      display: flex;
      align-items: center;
      color: var(--color-primary);
    }

    .category-intro {
      color: var(--color-text-secondary);
      margin-bottom: var(--space-6);
      font-size: 1rem;
    }

    .article-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .article-card {
      display: block;
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .article-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--color-primary);
    }

    .article-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .article-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* Contribute Section */
    .contribute-section {
      margin-top: var(--space-16);
      margin-bottom: var(--space-8);
    }

    .contribute-card {
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
      color: white;
      padding: var(--space-8);
      border-radius: 0.75rem;
      text-align: center;
    }

    .contribute-title {
      font-size: 1.75rem;
      margin-bottom: var(--space-4);
      color: white;
    }

    .contribute-desc {
      font-size: 1.125rem;
      margin-bottom: var(--space-6);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      opacity: 0.95;
    }

    .contribute-button {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: white;
      color: var(--color-primary);
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all var(--transition-base);
    }

    .contribute-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .featured-grid {
        grid-template-columns: 1fr;
      }

      .featured-card--large {
        grid-row: span 1;
      }

      .article-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
