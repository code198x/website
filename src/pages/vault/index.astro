---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import { HardDrive, Cpu, Users, Building2, Gamepad2, BookOpen, Wrench } from '@lucide/astro';

// Get all vault entries from the content collection
const allEntries = await getCollection('vault');

// Group entries by category
const entriesByCategory = allEntries.reduce((acc, entry) => {
  const category = entry.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push({
    name: entry.data.title,
    url: `/vault/${entry.id}`,
    desc: entry.data.summary,
  });
  return acc;
}, {} as Record<string, { name: string; url: string; desc: string }[]>);

// Sort entries within each category alphabetically
Object.keys(entriesByCategory).forEach(category => {
  entriesByCategory[category].sort((a, b) => a.name.localeCompare(b.name));
});

// Preview limit per category
const PREVIEW_LIMIT = 6;

// Category metadata
const categoryMeta = {
  systems: { name: 'Systems', icon: HardDrive, intro: 'The machines that defined an era.' },
  hardware: { name: 'Hardware', icon: Cpu, intro: 'The chips and components that made it all possible.' },
  people: { name: 'People', icon: Users, intro: 'The developers, designers, and composers who defined the era.' },
  companies: { name: 'Companies & Studios', icon: Building2, intro: 'From bedroom operations to publishing empires.' },
  games: { name: 'Classic Games', icon: Gamepad2, intro: 'The titles that pushed boundaries and defined genres.' },
  culture: { name: 'Culture & Community', icon: BookOpen, intro: 'Magazines, movements, and the scenes that connected it all.' },
  techniques: { name: 'Techniques & Technology', icon: Wrench, intro: 'The clever tricks and deep system knowledge that made magic happen.' },
};
const order = ['systems', 'hardware', 'people', 'companies', 'games', 'culture', 'techniques'];
---

<Layout title="The Vault" description="Explore the people, hardware, companies, games, and techniques that defined 1980s home computing.">
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Reference library · cross-system</p>
      <h1>The Vault.</h1>
      <div class="herorule"></div>
      <p class="lede">A curated encyclopaedia of vintage computing — connecting the hands-on lessons to
        their cultural and technical roots. The chips that powered the machines, and the people who
        pushed them past their limits.</p>
      <p class="summary"><b>{allEntries.length}</b> articles · <b>{Object.keys(entriesByCategory).length}</b> categories</p>
    </div>

    {order.map(categoryKey => {
      const meta = categoryMeta[categoryKey];
      const articles = entriesByCategory[categoryKey] || [];
      if (!meta || articles.length === 0) return null;
      const IconComponent = meta.icon;
      const previewArticles = articles.slice(0, PREVIEW_LIMIT);
      const hasMore = articles.length > PREVIEW_LIMIT;
      return (
        <section class="cat">
          <div class="cat-head">
            <h2><span class="cat-icon"><IconComponent size={22} /></span>{meta.name}</h2>
            {hasMore && <a href={`/vault/category/${categoryKey}`} class="view-all">View all {articles.length} →</a>}
          </div>
          <p class="cat-intro">{meta.intro}</p>
          <div class="grid">
            {previewArticles.map(article => (
              <a href={article.url} class="acard">
                <h3>{article.name}</h3>
                <p><InlineMarkdown text={article.desc} /></p>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <section class="contribute">
      <div>
        <p class="kicker">Open source · community-built</p>
        <h2>Help expand the Vault.</h2>
        <p>Have sources, scans, memories, or technical insight to add? The Vault grows with community expertise — every entry is a real, citable page.</p>
      </div>
      <div class="contribute-cta">
        <a class="btn btn-primary" href="https://github.com/code198x" rel="noopener">Contribute on GitHub →</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-5) var(--space-6) var(--space-16); }
  .eyebrow, .kicker { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }

  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3.4rem, 8vw, 5.25rem); line-height: 0.84;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 260px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 70ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .summary { font-family: var(--font-family-mono); font-size: 0.75rem; color: var(--color-text-secondary); margin-top: var(--space-3); }
  .summary b { color: var(--color-text); }

  .cat { margin-top: var(--space-10); }
  .cat-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); border-bottom: 3px solid var(--color-text); padding-bottom: var(--space-2); margin-bottom: var(--space-2); }
  .cat-head h2 { display: flex; align-items: center; gap: var(--space-3); font-size: 1.5rem; font-weight: 800; margin: 0; }
  .cat-icon { display: inline-flex; color: var(--color-house-2); }
  .view-all { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; color: var(--color-house-2); text-decoration: none; white-space: nowrap; }
  .cat-intro { color: var(--color-text-secondary); margin: 0 0 var(--space-5); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-4); }
  .acard { display: block; padding: var(--space-5); background: var(--color-surface); border: 3px solid var(--color-border); text-decoration: none; color: var(--color-text); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
  .acard:hover, .acard:focus-visible { border-color: var(--color-house-2); transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--color-house-2); }
  .acard h3 { font-size: 1.15rem; font-weight: 700; margin: 0 0 var(--space-2); }
  .acard p { font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.55; margin: 0; }

  .contribute { margin-top: var(--space-12); border: 3px solid #241a12; background: #3a2c1f; box-shadow: var(--shadow-chunky); padding: var(--space-8); display: grid; grid-template-columns: 1fr auto; gap: var(--space-8); align-items: center; }
  .contribute .kicker { color: #e8a07e; }
  .contribute h2 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 0.95; color: #f6efe2; margin: var(--space-1) 0 0; }
  .contribute p { color: #dac9b4; max-width: 60ch; margin: var(--space-3) 0 0; font-size: 0.95rem; }
  .contribute-cta { text-align: right; }

  @media (max-width: 760px) {
    .contribute { grid-template-columns: 1fr; }
    .contribute-cta { text-align: left; }
  }
</style>
