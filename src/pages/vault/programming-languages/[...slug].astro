---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("programmingLanguages");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Programming Languages`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from ${entry.data.year || 'the golden age of computing'}.`}
  entry={entry}
  categorySlug="programming-languages"
  categoryName="Programming Languages"
  categoryIcon="📝"
  categoryColor="#10b981"
/>