---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'programming-languages');
---

<VaultCategoryLayout
  title="Programming Languages - The Vault"
  description="Explore programming languages that enabled creativity and innovation on classic computing platforms."
  heroTitle="Programming Languages"
  heroSubtitle="The languages that powered classic software development"
  heroDescription={`Explore ${categoryData.length} programming languages that enabled creativity and innovation on classic computing platforms.`}
  heroIcon="📝"
  heroColor="#10b981"
  categorySlug="programming-languages"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Programming Languages Collection"
  infoDescription="This collection documents the programming languages and dialects available on classic computing platforms. From BASIC interpreters to assembly languages, these tools enabled programmers to create the software that defined an era."
  stats={[
    {
      label: "Interpreted",
      value: 0,
      filter: (p) => p.t === 'interpreted'
    },
    {
      label: "Compiled",
      value: 0,
      filter: (p) => p.t === 'compiled'
    },
    {
      label: "Assembly",
      value: 0,
      filter: (p) => p.t === 'assembly'
    },
    {
      label: "Scripting",
      value: 0,
      filter: (p) => p.t === 'scripting'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a programming language we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

