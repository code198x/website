---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import "../../../styles/vault.css";
import "../../../styles/vault-entry.css";

export async function getStaticPaths() {
  const entries = await getCollection("techniques");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Capitalize category name for display
const categoryName = "techniques".charAt(0).toUpperCase() + "techniques".slice(1);
---

<Layout title={`${entry.data.name} - ${categoryName}`}>
  <Hero
    title={entry.data.name}
    subtitle={entry.data.description}
    description={`Learn about ${entry.data.name}, ${entry.data.type} from ${entry.data.year || 'the golden age of computing'}.`}
    variant="gradient"
    badge={{
      text: `⚡ ${categoryName}`,
      color: "#14b8a6",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <article class="vault-entry-content">
        <!-- Entry metadata -->
        <div class="entry-metadata">
          <div class="metadata-grid">
            {entry.data.year && (
              <div class="metadata-item">
                <span class="metadata-label">Year</span>
                <span class="metadata-value">{entry.data.year}</span>
              </div>
            )}
            <div class="metadata-item">
              <span class="metadata-label">Type</span>
              <span class="metadata-value">{entry.data.type}</span>
            </div>
            <div class="metadata-item">
              <span class="metadata-label">Status</span>
              <span class="metadata-value status-{entry.data.status}">
                {entry.data.status === 'available' ? 'Complete' :
                 entry.data.status === 'draft' ? 'Draft' : 'Coming Soon'}
              </span>
            </div>
          </div>

          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="entry-tags">
              <span class="tags-label">Tags:</span>
              <div class="tags-list">
                {entry.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Main content -->
        <div class="entry-main-content">
          <Content />
        </div>

        <!-- Back navigation -->
        <div class="back-navigation">
          <a href="/vault/techniques" class="back-link">
            ← Back to {categoryName} Collection
          </a>
        </div>
      </article>
    </div>
  </div>
</Layout>
