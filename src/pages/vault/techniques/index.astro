---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";
import "../../../styles/vault.css";

// Filter to just techniques entries
const techniquesData = vaultData.filter(entry => entry.c === 'techniques');
---

<Layout title="Techniques - The Vault">
  <Hero
    title="Techniques"
    subtitle="Programming tricks and hardware hacks that defined the art of optimization"
    description={`Learn ${techniquesData.length} classic techniques that squeezed every cycle from vintage hardware.`}
    variant="gradient"
    badge={{
      text: "⚡ Techniques",
      color: "#14b8a6",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={techniquesData}
        placeholder="Search techniques by name, type, or platform..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={false}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="vault-category-info-section">
        <h2>About the Techniques Collection</h2>
        <p>
          Before modern compilers and powerful hardware, programmers had to be creative.
          These techniques represent the accumulated knowledge of developers who turned
          limitations into opportunities, creating effects that seemed impossible on the
          hardware of the time.
        </p>

        <div class="technique-categories">
          <div class="category-card">
            <div class="category-icon">🎨</div>
            <h3>Graphics Techniques</h3>
            <p>Sprite multiplexing, raster effects, copper programming, and more</p>
          </div>
          <div class="category-card">
            <div class="category-icon">🎵</div>
            <h3>Audio Techniques</h3>
            <p>Sample playback, SID programming, tracker optimization</p>
          </div>
          <div class="category-card">
            <div class="category-icon">💾</div>
            <h3>Memory Techniques</h3>
            <p>Compression, bank switching, self-modifying code</p>
          </div>
          <div class="category-card">
            <div class="category-icon">⚡</div>
            <h3>Performance Techniques</h3>
            <p>Cycle counting, unrolled loops, lookup tables</p>
          </div>
        </div>

        <div class="learning-note">
          <h3>Learning These Techniques</h3>
          <p>
            Each technique entry includes historical context, technical explanation,
            and practical examples. Many link to related hardware entries and games
            that famously used these tricks.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>

