---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'techniques');
---

<VaultCategoryLayout
  title="Techniques - The Vault"
  description="Learn classic techniques that squeezed every cycle from vintage hardware."
  heroTitle="Techniques"
  heroSubtitle="Programming tricks and hardware hacks that defined the art of optimization"
  heroDescription={`Learn ${categoryData.length} classic techniques that squeezed every cycle from vintage hardware.`}
  heroIcon="⚡"
  heroColor="#14b8a6"
  categorySlug="techniques"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={false}
  showStatusFilter={true}
  infoTitle="About the Techniques Collection"
  infoDescription="Before modern compilers and powerful hardware, programmers had to be creative. These techniques represent the accumulated knowledge of developers who turned limitations into opportunities, creating effects that seemed impossible on the hardware of the time."
>
  <div class="technique-categories">
    <div class="category-card">
      <div class="category-icon">🎨</div>
      <h3>Graphics Techniques</h3>
      <p>Sprite multiplexing, raster effects, copper programming, and more</p>
    </div>
    <div class="category-card">
      <div class="category-icon">🎵</div>
      <h3>Audio Techniques</h3>
      <p>Sample playback, SID programming, tracker optimization</p>
    </div>
    <div class="category-card">
      <div class="category-icon">💾</div>
      <h3>Memory Techniques</h3>
      <p>Compression, bank switching, self-modifying code</p>
    </div>
    <div class="category-card">
      <div class="category-icon">⚡</div>
      <h3>Performance Techniques</h3>
      <p>Cycle counting, unrolled loops, lookup tables</p>
    </div>
  </div>

  <div class="learning-note">
    <h3>Learning These Techniques</h3>
    <p>
      Each technique entry includes historical context, technical explanation,
      and practical examples. Many link to related hardware entries and games
      that famously used these tricks.
    </p>
  </div>
</VaultCategoryLayout>


