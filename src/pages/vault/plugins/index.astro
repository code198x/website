---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'plugins');
---

<VaultCategoryLayout
  title="Plugins - The Vault"
  description="Explore plugins and extensions that enhanced software functionality on classic computing platforms."
  heroTitle="Plugins"
  heroSubtitle="Extensions that expanded application capabilities"
  heroDescription={`Explore ${categoryData.length} plugins and extensions that enhanced software functionality on classic computing platforms.`}
  heroIcon="🧩"
  heroColor="#a855f7"
  categorySlug="plugins"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Plugins Collection"
  infoDescription="This collection documents the plugins, extensions, and add-ons that expanded the capabilities of applications on classic systems. These small programs enhanced functionality and customization options for users."
  stats={[
    {
      label: "Graphics",
      value: 0,
      filter: (p) => p.t === 'graphics'
    },
    {
      label: "Audio",
      value: 0,
      filter: (p) => p.t === 'audio'
    },
    {
      label: "Filters",
      value: 0,
      filter: (p) => p.t === 'filter'
    },
    {
      label: "Effects",
      value: 0,
      filter: (p) => p.t === 'effect'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a plugin we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

