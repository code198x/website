---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("plugins");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Plugins`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from ${entry.data.year || 'the golden age of computing'}.`}
  entry={entry}
  categorySlug="plugins"
  categoryName="Plugins"
  categoryIcon="🧩"
  categoryColor="#a855f7"
/>