---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";
import "../../../styles/vault.css";

// Filter to just formats entries
const formatsData = vaultData.filter(entry => entry.c === 'formats');
---

<Layout title="Formats - The Vault">
  <Hero
    title="Formats"
    subtitle="File formats, disk images, and data structures that preserved digital history"
    description={`Learn about ${formatsData.length} formats that enable preservation and emulation of classic systems.`}
    variant="gradient"
    badge={{
      text: "💾 Formats",
      color: "#84cc16",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={formatsData}
        placeholder="Search formats by name, type, or system..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={false}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="vault-category-info-section">
        <h2>About the Formats Collection</h2>
        <p>
          File formats are the unsung heroes of digital preservation. They capture not just
          data, but the entire context of how that data was stored, protected, and accessed.
          Understanding these formats is key to preserving and experiencing computing history.
        </p>

        <div class="format-categories">
          <div class="format-card">
            <div class="format-icon">💿</div>
            <h3>Disk Images</h3>
            <p>Complete captures of floppy disks, hard drives, and optical media</p>
          </div>
          <div class="format-card">
            <div class="format-icon">🎵</div>
            <h3>Audio Formats</h3>
            <p>MOD files, SID tunes, and chip music formats</p>
          </div>
          <div class="format-card">
            <div class="format-icon">🎨</div>
            <h3>Graphics Formats</h3>
            <p>Palette-based images, sprites, and custom bitmap formats</p>
          </div>
          <div class="format-card">
            <div class="format-icon">📦</div>
            <h3>Archive Formats</h3>
            <p>Compression and packaging formats from the BBS era</p>
          </div>
        </div>

        <div class="preservation-note">
          <h3>Digital Preservation</h3>
          <p>
            These formats do more than store data - they preserve the quirks, copy protection,
            and even the errors that made each system unique. They're time capsules that let
            us experience software exactly as it was, decades after the hardware has failed.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>

