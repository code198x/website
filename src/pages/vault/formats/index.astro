---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'formats');
---

<VaultCategoryLayout
  title="Formats - The Vault"
  description="Learn about formats that enable preservation and emulation of classic systems."
  heroTitle="Formats"
  heroSubtitle="File formats, disk images, and data structures that preserved digital history"
  heroDescription={`Learn about ${categoryData.length} formats that enable preservation and emulation of classic systems.`}
  heroIcon="💾"
  heroColor="#84cc16"
  categorySlug="formats"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={false}
  showStatusFilter={true}
  infoTitle="About the Formats Collection"
  infoDescription="File formats are the unsung heroes of digital preservation. They capture not just data, but the entire context of how that data was stored, protected, and accessed. Understanding these formats is key to preserving and experiencing computing history."
>
  <div class="format-categories">
    <div class="format-card">
      <div class="format-icon">💿</div>
      <h3>Disk Images</h3>
      <p>Complete captures of floppy disks, hard drives, and optical media</p>
    </div>
    <div class="format-card">
      <div class="format-icon">🎵</div>
      <h3>Audio Formats</h3>
      <p>MOD files, SID tunes, and chip music formats</p>
    </div>
    <div class="format-card">
      <div class="format-icon">🎨</div>
      <h3>Graphics Formats</h3>
      <p>Palette-based images, sprites, and custom bitmap formats</p>
    </div>
    <div class="format-card">
      <div class="format-icon">📦</div>
      <h3>Archive Formats</h3>
      <p>Compression and packaging formats from the BBS era</p>
    </div>
  </div>

  <div class="preservation-note">
    <h3>Digital Preservation</h3>
    <p>
      These formats do more than store data - they preserve the quirks, copy protection,
      and even the errors that made each system unique. They're time capsules that let
      us experience software exactly as it was, decades after the hardware has failed.
    </p>
  </div>
</VaultCategoryLayout>


