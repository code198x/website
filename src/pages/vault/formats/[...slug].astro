---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("formats");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Formats`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from ${entry.data.year || 'the golden age of computing'}.`}
  entry={entry}
  categorySlug="formats"
  categoryName="Formats"
  categoryIcon="💾"
  categoryColor="#84cc16"
/>
