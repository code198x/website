---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const software = await getCollection('software');
  return software.map((item) => ({
    params: { slug: item.slug },
    props: { software: item },
  }));
}

const { software } = Astro.props;
const { Content } = await software.render();
---

<Layout title={`${software.data.name} - Software - The Vault - Code Like It's 198x`}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <a href="/vault" class="text-blue-600 hover:underline">The Vault</a>
      <span class="mx-2">/</span>
      <a href="/vault/software" class="text-blue-600 hover:underline">Software</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">{software.data.name}</span>
    </nav>

    <div class="mb-8">
      <div class="flex items-start justify-between mb-4">
        <h1 class="text-4xl font-bold">{software.data.name}</h1>
        <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium">
          {software.data.type}
        </span>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-8">
        <div class="bg-gray-50 rounded-lg p-6">
          <h2 class="text-lg font-semibold mb-4">Quick Facts</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-600">Original Platform</dt>
              <dd class="text-sm text-gray-900">{software.data.original_platform}</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Release Date</dt>
              <dd class="text-sm text-gray-900">
                {software.data.original_release_date.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </dd>
            </div>
            {software.data.original_developer && (
              <div>
                <dt class="text-sm font-medium text-gray-600">Developer{software.data.original_developer.length > 1 ? 's' : ''}</dt>
                <dd class="text-sm text-gray-900">
                  {software.data.original_developer.map(dev => dev.name).join(', ')}
                </dd>
              </div>
            )}
            {software.data.original_publisher && (
              <div>
                <dt class="text-sm font-medium text-gray-600">Publisher</dt>
                <dd class="text-sm text-gray-900">{software.data.original_publisher}</dd>
              </div>
            )}
            {software.data.genre && (
              <div>
                <dt class="text-sm font-medium text-gray-600">Genre</dt>
                <dd class="text-sm text-gray-900">{software.data.genre}</dd>
              </div>
            )}
          </dl>
        </div>

        <div class="bg-blue-50 rounded-lg p-6">
          <h2 class="text-lg font-semibold mb-4">Significance</h2>
          <p class="text-sm text-gray-700">{software.data.significance}</p>
          
          {software.data.technical_innovations && software.data.technical_innovations.length > 0 && (
            <div class="mt-4">
              <h3 class="text-sm font-medium text-gray-600 mb-2">Technical Innovations</h3>
              <ul class="text-sm text-gray-700 space-y-1">
                {software.data.technical_innovations.map((innovation) => (
                  <li class="flex items-start">
                    <span class="text-blue-500 mr-2">•</span>
                    {innovation}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    {software.data.platform_releases && software.data.platform_releases.length > 0 && (
      <div class="mt-12 bg-gray-50 rounded-lg p-6">
        <h2 class="text-xl font-semibold mb-4">Platform Releases</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {software.data.platform_releases.map((release) => (
            <div class="bg-white rounded p-4 border">
              <h3 class="font-medium text-gray-900 mb-2">{release.system}</h3>
              <p class="text-sm text-gray-600 mb-1">
                Released: {release.release_date.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </p>
              {release.developer && (
                <p class="text-sm text-gray-600 mb-1">
                  Developer: {release.developer.map(dev => dev.name).join(', ')}
                </p>
              )}
              {release.technical_notes && (
                <p class="text-sm text-gray-700 mt-2">{release.technical_notes}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="mt-8 text-center">
      <a 
        href="/vault/software" 
        class="inline-flex items-center px-4 py-2 bg-red-600 text-white font-medium rounded hover:bg-red-700 transition-colors"
      >
        ← Back to Software
      </a>
    </div>
  </main>
</Layout>