---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const software = await getCollection('software');
const sortedSoftware = software.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Software - The Vault - Code Like It's 198x">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2">Software</h1>
    <p class="text-xl text-gray-600 mb-8">
      Notable applications, games, and programs that defined vintage computing.
    </p>

    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <a href="/vault" class="text-blue-600 hover:underline">The Vault</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">Software</span>
    </nav>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedSoftware.map((item) => (
        <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
          <div class="flex items-start justify-between mb-4">
            <h2 class="text-xl font-semibold text-gray-800">{item.data.name}</h2>
            <span class="bg-red-100 text-red-800 px-2 py-1 rounded-full text-xs font-medium">
              {item.data.type}
            </span>
          </div>
          
          <div class="mb-4">
            <p class="text-sm text-gray-600 mb-2">
              <strong>Platform:</strong> {item.data.original_platform}
            </p>
            <p class="text-sm text-gray-600 mb-2">
              <strong>Released:</strong> {item.data.original_release_date.toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </p>
            {item.data.original_developer && (
              <p class="text-sm text-gray-600 mb-2">
                <strong>Developer:</strong> {item.data.original_developer.map(dev => dev.name).join(', ')}
              </p>
            )}
          </div>

          <p class="text-gray-700 text-sm mb-4 line-clamp-3">
            {item.data.description}
          </p>

          <a 
            href={`/vault/software/${item.slug}`}
            class="block w-full text-center px-4 py-2 bg-red-600 text-white font-medium rounded hover:bg-red-700 transition-colors"
          >
            Learn More →
          </a>
        </div>
      ))}
    </div>

    {sortedSoftware.length === 0 && (
      <div class="text-center py-12">
        <div class="text-gray-400 text-lg mb-4">No software entries found.</div>
        <p class="text-gray-600">Software entries are being added to the vault.</p>
      </div>
    )}
  </main>
</Layout>