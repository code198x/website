---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just software entries
const softwareData = vaultData.filter(entry => entry.c === 'software');
---

<Layout title="Software - The Vault">
  <Hero
    title="Software Collection"
    subtitle="Applications, utilities, and tools that defined productivity and creativity"
    description={`Explore ${softwareData.length} classic software titles that pushed the boundaries of what computers could do.`}
    variant="gradient"
    badge={{
      text: "💿 Software Collection",
      color: "#6366f1"
    }}
  />

  <div class="software-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={softwareData}
        placeholder="Search software by name, type, platform, or purpose..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the Software Collection</h2>
        <p>
          From groundbreaking graphics programs to revolutionary music trackers,
          this collection showcases the software that turned computers from calculators
          into creative powerhouses. These applications didn't just serve purposes -
          they created entirely new forms of digital expression.
        </p>

        <div class="software-categories">
          <div class="category-card">
            <h3>🎨 Graphics Software</h3>
            <p>Paint programs, animation tools, and 3D modeling that pioneered digital art</p>
          </div>
          <div class="category-card">
            <h3>🎵 Music Software</h3>
            <p>Trackers, sequencers, and synthesizers that revolutionized computer music</p>
          </div>
          <div class="category-card">
            <h3>💼 Productivity Tools</h3>
            <p>Word processors, spreadsheets, and databases that made computers essential</p>
          </div>
          <div class="category-card">
            <h3>🔧 Development Tools</h3>
            <p>Assemblers, compilers, and IDEs that built the software revolution</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .software-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .software-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .category-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .category-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .category-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .category-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .software-categories {
      grid-template-columns: 1fr;
    }
  }
</style>