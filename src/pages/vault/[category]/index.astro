---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";
import { getCategoryConfig, getAllCategorySlugs } from "../../../data/vault-categories.js";

export async function getStaticPaths() {
  return getAllCategorySlugs().map((category) => ({
    params: { category }
  }));
}

const { category } = Astro.params;

// Get category configuration
const categoryConfig = getCategoryConfig(category);

if (!categoryConfig) {
  return Astro.redirect('/vault');
}

// Filter vault data to this category
const categoryData = vaultData.filter(entry => entry.c === category);

// Build description with count
const description = `Explore ${categoryData.length} ${categoryConfig.heroTitle.toLowerCase()} ${categoryData.length === 1 ? 'entry' : 'entries'} from the golden age of computing.`;
---

<VaultCategoryLayout
  title={categoryConfig.title}
  description={description}
  heroTitle={categoryConfig.heroTitle}
  heroSubtitle={categoryConfig.heroSubtitle}
  heroDescription={description}
  heroIcon={categoryConfig.heroIcon}
  heroColor={categoryConfig.heroColor}
  categorySlug={category}
  categoryData={categoryData}
  infoTitle={categoryConfig.infoTitle}
  infoDescription={categoryConfig.infoDescription}
  stats={categoryConfig.stats || []}
>
  <section class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about {categoryConfig.heroTitle.toLowerCase()} we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </section>
</VaultCategoryLayout>