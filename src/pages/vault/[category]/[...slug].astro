---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";
import { getCategoryConfig, getAllCategorySlugs } from "../../../data/vault-categories.js";

export async function getStaticPaths() {
  const categorySlugs = getAllCategorySlugs();
  const allPaths = [];

  // For each category, get all entries from that collection
  for (const category of categorySlugs) {
    try {
      // Get the collection for this category with proper typing
      const entries = await getCollection(category as any);

      // Map each entry to a path
      const categoryPaths = entries.map((entry: any) => ({
        params: {
          category,
          slug: entry.slug,
        },
        props: {
          entry,
          category,
        },
      }));

      allPaths.push(...categoryPaths);
    } catch (error) {
      // Skip if collection doesn't exist or is empty
      console.log(`Collection "${category}" not found or empty, skipping...`);
    }
  }

  return allPaths;
}

const { entry, category } = Astro.props;

// Get category configuration
const categoryConfig = getCategoryConfig(category);

if (!categoryConfig) {
  return Astro.redirect("/vault");
}

// Prepare metadata for the layout
const categoryName = categoryConfig.heroTitle;
const categoryIcon = categoryConfig.heroIcon;
const categoryColor = categoryConfig.heroColor;
---

<VaultEntryLayout
  title={`${entry.data.name || entry.data.title || "Entry"} - ${categoryName}`}
  description={`Learn about ${entry.data.name || entry.data.title || "this entry"} from the golden age of computing.`}
  entry={entry}
  categorySlug={category}
  categoryName={categoryName}
  categoryIcon={categoryIcon}
  categoryColor={categoryColor}
/>
