---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'projects');
---

<VaultCategoryLayout
  title="Projects - The Vault"
  description="Explore hands-on projects that teach programming concepts through practical examples on classic hardware."
  heroTitle="Projects"
  heroSubtitle="Educational programming projects for classic systems"
  heroDescription={`Explore ${categoryData.length} hands-on projects that teach programming concepts through practical examples on classic hardware.`}
  heroIcon="🚀"
  heroColor="#f59e0b"
  categorySlug="projects"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Projects Collection"
  infoDescription="This collection contains educational programming projects designed to teach classic programming concepts through hands-on experience. Each project includes complete source code, explanations, and learning objectives."
  stats={[
    {
      label: "Beginner",
      value: 0,
      filter: (p) => p.t === 'beginner'
    },
    {
      label: "Intermediate",
      value: 0,
      filter: (p) => p.t === 'intermediate'
    },
    {
      label: "Advanced",
      value: 0,
      filter: (p) => p.t === 'advanced'
    },
    {
      label: "Demos",
      value: 0,
      filter: (p) => p.t === 'demo'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Have a project idea or want to contribute code? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      grow our educational resources.
    </p>
  </div>
</VaultCategoryLayout>

