---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'demos');
---

<VaultCategoryLayout
  title="Demos - The Vault"
  description="Explore legendary demos that demonstrated the artistic and technical capabilities of classic computing hardware."
  heroTitle="Demos"
  heroSubtitle="Audiovisual showcases that pushed technical boundaries"
  heroDescription={`Explore ${categoryData.length} legendary demos that demonstrated the artistic and technical capabilities of classic computing hardware.`}
  heroIcon="🎬"
  heroColor="#06b6d4"
  categorySlug="demos"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Demos Collection"
  infoDescription="This collection documents the creative and technical achievements of the demoscene. These audiovisual presentations pushed hardware to its limits, showcasing innovative programming techniques and artistic vision that influenced generations of developers."
  stats={[
    {
      label: "Intros",
      value: 0,
      filter: (d) => d.t === 'intro'
    },
    {
      label: "Demos",
      value: 0,
      filter: (d) => d.t === 'demo'
    },
    {
      label: "Cracktros",
      value: 0,
      filter: (d) => d.t === 'cracktro'
    },
    {
      label: "Invitations",
      value: 0,
      filter: (d) => d.t === 'invitation'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a demo we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

