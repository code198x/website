---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";

// Get URL parameters for filtering
const url = new URL(Astro.request.url);
const filters = {
  type: url.searchParams.get('type') || 'all',
  cpu: url.searchParams.get('cpu') || 'all',
  decade: url.searchParams.get('decade') || 'all',
  status: url.searchParams.get('status') || 'all',
  manufacturer: url.searchParams.get('manufacturer') || 'all',
  search: url.searchParams.get('search') || ''
};

// Hardware entries with enhanced metadata and tags
const allHardware = [
  // Home Computers
  {
    name: "Commodore 64",
    slug: "commodore-64",
    year: 1982,
    cpu: "6502",
    cpuFull: "MOS 6510",
    status: "available",
    type: "computer",
    manufacturer: "Commodore",
    tags: ["8-bit", "bestseller", "SID", "demoscene", "gaming"],
    description: "The best-selling computer model of all time"
  },
  {
    name: "ZX Spectrum",
    slug: "zx-spectrum",
    year: 1982,
    cpu: "Z80",
    cpuFull: "Z80A",
    status: "available",
    type: "computer",
    manufacturer: "Sinclair",
    tags: ["8-bit", "UK", "rubber-keys", "bedroom-coders"],
    description: "Britain's gateway to home computing"
  },
  {
    name: "Commodore Amiga",
    slug: "commodore-amiga",
    year: 1985,
    cpu: "68000",
    cpuFull: "MC68000",
    status: "available",
    type: "computer",
    manufacturer: "Commodore",
    tags: ["16-bit", "multimedia", "demoscene", "video-production"],
    description: "Revolutionary multimedia computer"
  },
  {
    name: "Apple II",
    slug: "apple-ii",
    year: 1977,
    cpu: "6502",
    cpuFull: "MOS 6502",
    status: "coming",
    type: "computer",
    manufacturer: "Apple",
    tags: ["8-bit", "education", "business", "color-graphics"],
    description: "The computer that started Apple's empire"
  },
  {
    name: "BBC Micro",
    slug: "bbc-micro",
    year: 1981,
    cpu: "6502",
    cpuFull: "MOS 6502",
    status: "coming",
    type: "computer",
    manufacturer: "Acorn",
    tags: ["8-bit", "education", "UK", "BBC"],
    description: "Educational computer for the UK"
  },
  {
    name: "Atari 800",
    slug: "atari-800",
    year: 1979,
    cpu: "6502",
    cpuFull: "MOS 6502",
    status: "coming",
    type: "computer",
    manufacturer: "Atari",
    tags: ["8-bit", "gaming", "graphics", "ANTIC"],
    description: "Advanced graphics and sound for 1979"
  },
  // Game Consoles
  {
    name: "Nintendo Entertainment System",
    slug: "nintendo-entertainment-system",
    year: 1983,
    cpu: "6502",
    cpuFull: "Ricoh 2A03",
    status: "available",
    type: "console",
    manufacturer: "Nintendo",
    tags: ["8-bit", "gaming", "cartridge", "scrolling"],
    description: "Saved gaming after the 1983 crash"
  },
  {
    name: "Atari 2600",
    slug: "atari-2600",
    year: 1977,
    cpu: "6502",
    cpuFull: "MOS 6507",
    status: "coming",
    type: "console",
    manufacturer: "Atari",
    tags: ["8-bit", "gaming", "cartridge", "joystick"],
    description: "Brought arcade gaming home"
  },
  {
    name: "Sega Master System",
    slug: "sega-master-system",
    year: 1985,
    cpu: "Z80",
    cpuFull: "Z80A",
    status: "coming",
    type: "console",
    manufacturer: "Sega",
    tags: ["8-bit", "gaming", "arcade-ports"],
    description: "Sega's 8-bit challenger"
  },
  {
    name: "Super Nintendo",
    slug: "super-nintendo",
    year: 1990,
    cpu: "65816",
    cpuFull: "Ricoh 5A22",
    status: "coming",
    type: "console",
    manufacturer: "Nintendo",
    tags: ["16-bit", "gaming", "Mode-7", "scaling"],
    description: "16-bit gaming perfection"
  },
  // Chips & Components
  {
    name: "MOS 6581 SID",
    slug: "mos-6581-sid",
    year: 1982,
    type: "chip",
    manufacturer: "MOS Technology",
    status: "draft",
    tags: ["sound", "synthesizer", "C64", "music"],
    description: "Revolutionary sound synthesis chip"
  },
  {
    name: "Z80 CPU",
    slug: "z80-cpu",
    year: 1976,
    type: "chip",
    manufacturer: "Zilog",
    status: "draft",
    tags: ["processor", "8-bit", "Z80"],
    description: "Legendary 8-bit processor"
  },
  {
    name: "VIC-II",
    slug: "vic-ii",
    year: 1982,
    type: "chip",
    manufacturer: "MOS Technology",
    status: "draft",
    tags: ["graphics", "sprites", "C64", "raster"],
    description: "C64's graphics powerhouse"
  },
  // Peripherals
  {
    name: "1541 Disk Drive",
    slug: "1541-disk-drive",
    year: 1982,
    type: "peripheral",
    manufacturer: "Commodore",
    status: "draft",
    tags: ["storage", "floppy", "C64", "serial"],
    description: "The C64's (in)famous disk drive"
  }
];

// Apply filters
let filteredHardware = allHardware;

// Filter by type
if (filters.type !== 'all') {
  filteredHardware = filteredHardware.filter(item => item.type === filters.type);
}

// Filter by CPU architecture
if (filters.cpu !== 'all') {
  filteredHardware = filteredHardware.filter(item => item.cpu === filters.cpu);
}

// Filter by decade
if (filters.decade !== 'all') {
  const startYear = parseInt(filters.decade);
  const endYear = startYear + 9;
  filteredHardware = filteredHardware.filter(item =>
    item.year >= startYear && item.year <= endYear
  );
}

// Filter by status
if (filters.status !== 'all') {
  filteredHardware = filteredHardware.filter(item => item.status === filters.status);
}

// Filter by manufacturer
if (filters.manufacturer !== 'all') {
  filteredHardware = filteredHardware.filter(item =>
    item.manufacturer?.toLowerCase() === filters.manufacturer.toLowerCase()
  );
}

// Search filter (searches name, description, and tags)
if (filters.search) {
  const searchLower = filters.search.toLowerCase();
  filteredHardware = filteredHardware.filter(item =>
    item.name.toLowerCase().includes(searchLower) ||
    item.description?.toLowerCase().includes(searchLower) ||
    item.tags?.some(tag => tag.toLowerCase().includes(searchLower))
  );
}

// Group filtered hardware by type
const groupedHardware = {
  "Home Computers": filteredHardware.filter(h => h.type === "computer"),
  "Game Consoles": filteredHardware.filter(h => h.type === "console"),
  "Chips & Components": filteredHardware.filter(h => h.type === "chip"),
  "Peripherals": filteredHardware.filter(h => h.type === "peripheral")
};

// Get unique values for filter options
const uniqueCPUs = [...new Set(allHardware.filter(h => h.cpu).map(h => h.cpu))].sort();
const uniqueManufacturers = [...new Set(allHardware.filter(h => h.manufacturer).map(h => h.manufacturer))].sort();
const allTags = [...new Set(allHardware.flatMap(h => h.tags || []))].sort();

// Filter handling is done client-side now
---

<Layout title="Hardware">
  <Hero
    title="Hardware Archive"
    subtitle="Systems, Chips & Peripherals"
    description="Explore the machines, processors, and components that powered the golden age of computing."
    variant="gradient"
    badge={{
      text: "🖥️ Hardware Collection",
      color: "#3b82f6"
    }}
  />

  <div class="hardware-container">
    <div class="container">
      <!-- Filter Controls -->
      <section class="filter-section">
        <div class="search-bar">
          <form method="get" action="/vault/hardware">
            <input
              type="search"
              name="search"
              placeholder="Search hardware by name, description, or tags..."
              value={filters.search}
              class="search-input"
            />
            {/* Preserve other filters when searching */}
            {filters.type !== 'all' && <input type="hidden" name="type" value={filters.type} />}
            {filters.cpu !== 'all' && <input type="hidden" name="cpu" value={filters.cpu} />}
            {filters.decade !== 'all' && <input type="hidden" name="decade" value={filters.decade} />}
            {filters.status !== 'all' && <input type="hidden" name="status" value={filters.status} />}
            {filters.manufacturer !== 'all' && <input type="hidden" name="manufacturer" value={filters.manufacturer} />}
            <button type="submit" class="search-button">Search</button>
          </form>
        </div>

        <div class="filter-controls">
          <div class="filter-group">
            <label for="type-filter">Type:</label>
            <select id="type-filter" class="filter-select" data-filter="type">
              <option value="all" selected={filters.type === 'all'}>All Types</option>
              <option value="computer" selected={filters.type === 'computer'}>Computers</option>
              <option value="console" selected={filters.type === 'console'}>Consoles</option>
              <option value="chip" selected={filters.type === 'chip'}>Chips</option>
              <option value="peripheral" selected={filters.type === 'peripheral'}>Peripherals</option>
            </select>
          </div>

          <div class="filter-group">
            <label for="cpu-filter">CPU:</label>
            <select id="cpu-filter" class="filter-select" data-filter="cpu">
              <option value="all" selected={filters.cpu === 'all'}>All CPUs</option>
              {uniqueCPUs.map(cpu =>
                <option value={cpu} selected={filters.cpu === cpu}>{cpu}</option>
              )}
            </select>
          </div>

          <div class="filter-group">
            <label for="decade-filter">Decade:</label>
            <select id="decade-filter" class="filter-select" data-filter="decade">
              <option value="all" selected={filters.decade === 'all'}>All Decades</option>
              <option value="1970" selected={filters.decade === '1970'}>1970s</option>
              <option value="1980" selected={filters.decade === '1980'}>1980s</option>
              <option value="1990" selected={filters.decade === '1990'}>1990s</option>
            </select>
          </div>

          <div class="filter-group">
            <label for="status-filter">Status:</label>
            <select id="status-filter" class="filter-select" data-filter="status">
              <option value="all" selected={filters.status === 'all'}>All Status</option>
              <option value="available" selected={filters.status === 'available'}>Available</option>
              <option value="coming" selected={filters.status === 'coming'}>Coming Soon</option>
              <option value="draft" selected={filters.status === 'draft'}>In Progress</option>
            </select>
          </div>

          <div class="filter-group">
            <label for="manufacturer-filter">Manufacturer:</label>
            <select id="manufacturer-filter" class="filter-select" data-filter="manufacturer">
              <option value="all" selected={filters.manufacturer === 'all'}>All</option>
              {uniqueManufacturers.map(mfr =>
                <option value={mfr} selected={filters.manufacturer === mfr}>{mfr}</option>
              )}
            </select>
          </div>

          {(filters.type !== 'all' || filters.cpu !== 'all' || filters.decade !== 'all' ||
            filters.status !== 'all' || filters.manufacturer !== 'all' || filters.search) && (
            <a href="/vault/hardware" class="clear-filters">Clear Filters</a>
          )}
        </div>

        <!-- Popular Tags -->
        <div class="tags-section">
          <h3>Popular Tags:</h3>
          <div class="tag-cloud">
            {allTags.slice(0, 15).map(tag => (
              <a href={`/vault/hardware?search=${tag}`} class="tag-link">
                {tag}
              </a>
            ))}
          </div>
        </div>

        <!-- Results Count -->
        <div class="results-info">
          Showing {filteredHardware.length} of {allHardware.length} items
          {filters.search && ` matching "${filters.search}"`}
        </div>
      </section>

      {/* Hardware Grid */}
      {Object.entries(groupedHardware).map(([category, items]) =>
        items.length > 0 && (
        <section class="hardware-section">
          <h2 class="section-title">{category}</h2>
          <div class="hardware-grid">
            {items.map((item) => (
              <a
                href={item.status === "available" ? `/vault/hardware/${item.slug}` : "#"}
                class={`hardware-card hardware-card--${item.status}`}
                title={item.status !== "available" ? "Coming Soon" : ""}
              >
                <div class="card-header">
                  <h3 class="card-title">{item.name}</h3>
                  {item.status === "available" && (
                    <span class="status-badge status-badge--available">Available</span>
                  )}
                  {item.status === "coming" && (
                    <span class="status-badge status-badge--coming">Coming Soon</span>
                  )}
                  {item.status === "draft" && (
                    <span class="status-badge status-badge--draft">In Progress</span>
                  )}
                </div>
                <p class="card-description">{item.description}</p>
                <div class="card-details">
                  <span class="detail-item">
                    <span class="detail-label">Year:</span> {item.year}
                  </span>
                  <span class="detail-item">
                    <span class="detail-label">{item.cpuFull ? "CPU:" : "Type:"}</span> {item.cpuFull || item.type}
                  </span>
                  {item.manufacturer && (
                    <span class="detail-item">
                      <span class="detail-label">By:</span> {item.manufacturer}
                    </span>
                  )}
                </div>
                {item.tags && item.tags.length > 0 && (
                  <div class="card-tags">
                    {item.tags.slice(0, 3).map(tag => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      ))}

      <section class="hardware-footer">
        <div class="footer-card">
          <h3>Contributing</h3>
          <p>
            Help us expand the Hardware Archive! If you have technical specifications,
            historical information, or personal experiences with these systems,
            we'd love to include them.
          </p>
          <a href="https://github.com/code198x/code198x/issues" class="contribute-link" target="_blank">
            Contribute Information →
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .hardware-container {
    min-height: 100vh;
    padding: 2rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Filter Section */
  .filter-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .search-bar {
    margin-bottom: 1.5rem;
  }

  .search-bar form {
    display: flex;
    gap: 1rem;
  }

  .search-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 1rem;
  }

  .search-input:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .search-button {
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: transform 0.2s;
  }

  .search-button:hover {
    transform: translateY(-1px);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .filter-group select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--bg-primary);
    color: var(--text-primary);
    cursor: pointer;
  }

  .filter-group select:focus {
    outline: none;
    border-color: #3b82f6;
  }

  .clear-filters {
    padding: 0.5rem 1rem;
    background: #ef4444;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: background 0.2s;
  }

  .clear-filters:hover {
    background: #dc2626;
  }

  /* Tags Section */
  .tags-section {
    margin-bottom: 1rem;
  }

  .tags-section h3 {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-link {
    padding: 0.375rem 0.75rem;
    background: var(--tag-bg, rgba(59, 130, 246, 0.1));
    color: var(--tag-color, #3b82f6);
    text-decoration: none;
    border-radius: 20px;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .tag-link:hover {
    background: rgba(59, 130, 246, 0.2);
    transform: translateY(-1px);
  }

  .results-info {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .hardware-section {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--text-primary);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
  }

  .hardware-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .hardware-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.2s;
    display: block;
  }

  .hardware-card--available:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    border-color: #3b82f6;
  }

  .hardware-card--coming,
  .hardware-card--draft {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .card-title {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin: 0;
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0.75rem 0;
    line-height: 1.5;
  }

  .status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-badge--available {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }

  .status-badge--coming {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }

  .status-badge--draft {
    background: rgba(107, 114, 128, 0.1);
    color: #6b7280;
  }

  .card-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-item {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .detail-label {
    font-weight: 600;
    color: var(--text-primary);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .card-tags .tag {
    padding: 0.25rem 0.5rem;
    background: var(--tag-bg, rgba(59, 130, 246, 0.1));
    color: var(--tag-color, #3b82f6);
    border-radius: 12px;
    font-size: 0.75rem;
  }

  .hardware-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .footer-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
  }

  .footer-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .footer-card p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .contribute-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: white;
    text-decoration: none;
    border-radius: 6px;
    transition: transform 0.2s;
  }

  .contribute-link:hover {
    transform: translateY(-1px);
  }
</style>

<script is:inline define:vars={{ filters }}>
  // Handle filter changes
  document.querySelectorAll('.filter-select').forEach(select => {
    select.addEventListener('change', (e) => {
      const filterType = e.target.dataset.filter;
      const value = e.target.value;

      // Build new URL with updated filter
      const url = new URL(window.location);
      if (value === 'all') {
        url.searchParams.delete(filterType);
      } else {
        url.searchParams.set(filterType, value);
      }

      window.location.href = url.toString();
    });
  });

  // Handle search
  const searchBox = document.getElementById('search-box');
  if (searchBox) {
    searchBox.addEventListener('input', (e) => {
      const url = new URL(window.location);
      if (e.target.value) {
        url.searchParams.set('search', e.target.value);
      } else {
        url.searchParams.delete('search');
      }

      // Debounce the search
      clearTimeout(window.searchTimeout);
      window.searchTimeout = setTimeout(() => {
        window.location.href = url.toString();
      }, 500);
    });
  }
</script>