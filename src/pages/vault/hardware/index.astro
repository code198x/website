---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just hardware entries
const hardwareData = vaultData.filter(entry => entry.c === 'hardware');
---

<Layout title="Hardware - The Vault">
  <Hero
    title="Hardware Collection"
    subtitle="Systems, chips, and peripherals that defined an era"
    description={`Explore ${hardwareData.length} pieces of computing history, from the legendary Commodore 64 to groundbreaking sound chips and innovative peripherals.`}
    variant="gradient"
    badge={{
      text: "🖥️ Hardware Collection",
      color: "#3b82f6"
    }}
  />

  <div class="hardware-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={hardwareData}
        placeholder="Search hardware by name, type, manufacturer, or tags..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the Hardware Collection</h2>
        <p>
          This collection documents the computers, consoles, chips, and peripherals that shaped
          the golden age of home computing. Each entry includes technical specifications,
          historical context, and connections to related software and techniques.
        </p>

        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">{hardwareData.filter(h => h.t === 'computer').length}</span>
            <span class="stat-label">Computers</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{hardwareData.filter(h => h.t === 'console').length}</span>
            <span class="stat-label">Consoles</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{hardwareData.filter(h => h.t === 'chip').length}</span>
            <span class="stat-label">Chips</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{hardwareData.filter(h => h.t === 'peripheral').length}</span>
            <span class="stat-label">Peripherals</span>
          </div>
        </div>

        <div class="contribute-section">
          <h3>Contributing</h3>
          <p>
            Know about a system we're missing? Found an error? We welcome contributions!
            Check our <a href="/community">community page</a> to learn how you can help
            preserve computing history.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .hardware-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Info Section */
  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .stat-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-secondary);
  }

  /* Contribute Section */
  .contribute-section {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--color-bg);
    border-radius: 8px;
    border-left: 4px solid var(--color-primary);
  }

  .contribute-section h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .contribute-section p {
    font-size: 1rem;
    margin: 0;
  }

  .contribute-section a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .contribute-section a:hover {
    text-decoration: underline;
  }

  /* Dark mode adjustments */
  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .stat-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode) .contribute-section {
    background: rgba(30, 41, 59, 0.8);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>