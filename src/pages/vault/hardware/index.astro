---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just hardware entries
const hardwareData = vaultData.filter(entry => entry.c === 'hardware');
---

<VaultCategoryLayout
  title="Hardware - The Vault"
  description={`Explore ${hardwareData.length} pieces of computing history, from the legendary Commodore 64 to groundbreaking sound chips and innovative peripherals.`}
  heroTitle="Hardware"
  heroSubtitle="Systems, chips, and peripherals that defined an era"
  heroDescription={`Explore ${hardwareData.length} pieces of computing history, from the legendary Commodore 64 to groundbreaking sound chips and innovative peripherals.`}
  heroIcon="🖥️"
  heroColor="#3b82f6"
  categorySlug="hardware"
  categoryData={hardwareData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Hardware Collection"
  infoDescription="This collection documents the computers, consoles, chips, and peripherals that shaped the golden age of home computing. Each entry includes technical specifications, historical context, and connections to related software and techniques."
  stats={[
    { label: "Computers", value: 0, filter: (h) => h.t === 'computer' },
    { label: "Consoles", value: 0, filter: (h) => h.t === 'console' },
    { label: "Chips", value: 0, filter: (h) => h.t === 'chip' },
    { label: "Peripherals", value: 0, filter: (h) => h.t === 'peripheral' }
  ]}
>
  <section class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a system we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </section>
</VaultCategoryLayout>

