---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";

// This would eventually come from content collections
const c64Data = {
  name: "Commodore 64",
  manufacturer: "Commodore International",
  releaseDate: "August 1982",
  discontinuedDate: "April 1994",
  cpu: "MOS Technology 6510 @ 1.023 MHz (NTSC) / 0.985 MHz (PAL)",
  memory: "64 KB RAM, 20 KB ROM",
  graphics: "VIC-II (320×200, 16 colors, sprites)",
  sound: "MOS Technology 6581/8580 SID",
  price: "$595 USD (1982)",
  unitsSold: "12.5-17 million",
  nickname: "C64, CBM 64, C=64"
};

const relatedLinks = {
  people: [
    { name: "Jack Tramiel", slug: "/vault/people/jack-tramiel", available: false },
    { name: "Bob Yannes", slug: "/vault/people/bob-yannes", available: false }
  ],
  companies: [
    { name: "Commodore International", slug: "/vault/companies/commodore", available: false },
    { name: "MOS Technology", slug: "/vault/companies/mos-technology", available: false }
  ],
  hardware: [
    { name: "MOS 6581 SID", slug: "/vault/hardware/mos-6581-sid", available: false },
    { name: "VIC-II", slug: "/vault/hardware/vic-ii", available: false },
    { name: "1541 Disk Drive", slug: "/vault/hardware/1541-disk-drive", available: false }
  ],
  software: [
    { name: "The Last Ninja", slug: "/vault/software/the-last-ninja", available: false },
    { name: "Impossible Mission", slug: "/vault/software/impossible-mission", available: false }
  ]
};
---

<Layout title="Commodore 64">
  <Hero
    title="Commodore 64"
    subtitle="The Best-Selling Computer of All Time"
    description="Released in 1982, the C64 dominated the home computer market with superior graphics, revolutionary sound, and an affordable price."
    variant="gradient"
    badge={{
      text: "🖥️ Hardware",
      color: "#3b82f6"
    }}
  />

  <div class="entry-container">
    <div class="container">
      <!-- Quick Facts -->
      <section class="info-card">
        <h2>Quick Facts</h2>
        <div class="facts-grid">
          <div class="fact-item">
            <span class="fact-label">Manufacturer</span>
            <span class="fact-value">{c64Data.manufacturer}</span>
          </div>
          <div class="fact-item">
            <span class="fact-label">Released</span>
            <span class="fact-value">{c64Data.releaseDate}</span>
          </div>
          <div class="fact-item">
            <span class="fact-label">Discontinued</span>
            <span class="fact-value">{c64Data.discontinuedDate}</span>
          </div>
          <div class="fact-item">
            <span class="fact-label">Launch Price</span>
            <span class="fact-value">{c64Data.price}</span>
          </div>
          <div class="fact-item">
            <span class="fact-label">Units Sold</span>
            <span class="fact-value">{c64Data.unitsSold}</span>
          </div>
          <div class="fact-item">
            <span class="fact-label">Also Known As</span>
            <span class="fact-value">{c64Data.nickname}</span>
          </div>
        </div>
      </section>

      <!-- Technical Specifications -->
      <section class="info-card">
        <h2>Technical Specifications</h2>
        <div class="specs-grid">
          <div class="spec-item">
            <h3>Processor</h3>
            <p>{c64Data.cpu}</p>
          </div>
          <div class="spec-item">
            <h3>Memory</h3>
            <p>{c64Data.memory}</p>
          </div>
          <div class="spec-item">
            <h3>Graphics</h3>
            <p>{c64Data.graphics}</p>
          </div>
          <div class="spec-item">
            <h3>Sound</h3>
            <p>{c64Data.sound}</p>
          </div>
        </div>
      </section>

      <!-- History -->
      <section class="content-section">
        <h2>History</h2>
        <p>
          The Commodore 64 was conceived by Commodore International following the success
          of the VIC-20. Jack Tramiel's famous business philosophy "computers for the masses,
          not the classes" drove the C64's development, with a focus on affordability without
          sacrificing capabilities.
        </p>
        <p>
          Announced at CES in January 1982 and released in August of the same year, the C64
          quickly became the best-selling single computer model of all time. Its success was
          driven by aggressive pricing, superior graphics and sound capabilities (especially
          the revolutionary SID chip), and a vast library of software.
        </p>
        <p>
          The C64 dominated the home computer market throughout the 1980s, outselling IBM PC
          clones, Apple computers, and Atari systems. It remained in production until 1994,
          an remarkable 12-year run that saw it become a cultural icon and gateway to
          computing for millions of users worldwide.
        </p>
      </section>

      <!-- Learn to Program -->
      <section class="learn-section">
        <h2>Learn C64 Programming</h2>
        <p>
          Ready to start programming the Commodore 64? We have comprehensive lessons
          that will take you from your first POKE to advanced demo effects.
        </p>
        <div class="learn-actions">
          <a href="/lessons/commodore-64" class="btn btn-primary">
            Start Learning C64 Assembly →
          </a>
          <a href="/setup/c64" class="btn btn-secondary">
            Setup Development Environment
          </a>
        </div>
      </section>

      <!-- Related Entries -->
      <section class="related-section">
        <h2>Related Vault Entries</h2>

        <div class="related-category">
          <h3>👤 People</h3>
          <div class="related-grid">
            {relatedLinks.people.map(link => (
              <a
                href={link.available ? link.slug : "#"}
                class={`related-link ${!link.available ? 'related-link--coming' : ''}`}
              >
                {link.name}
                {!link.available && <span class="coming-badge">Coming Soon</span>}
              </a>
            ))}
          </div>
        </div>

        <div class="related-category">
          <h3>🏢 Companies</h3>
          <div class="related-grid">
            {relatedLinks.companies.map(link => (
              <a
                href={link.available ? link.slug : "#"}
                class={`related-link ${!link.available ? 'related-link--coming' : ''}`}
              >
                {link.name}
                {!link.available && <span class="coming-badge">Coming Soon</span>}
              </a>
            ))}
          </div>
        </div>

        <div class="related-category">
          <h3>🔧 Hardware</h3>
          <div class="related-grid">
            {relatedLinks.hardware.map(link => (
              <a
                href={link.available ? link.slug : "#"}
                class={`related-link ${!link.available ? 'related-link--coming' : ''}`}
              >
                {link.name}
                {!link.available && <span class="coming-badge">Coming Soon</span>}
              </a>
            ))}
          </div>
        </div>

        <div class="related-category">
          <h3>🎮 Software</h3>
          <div class="related-grid">
            {relatedLinks.software.map(link => (
              <a
                href={link.available ? link.slug : "#"}
                class={`related-link ${!link.available ? 'related-link--coming' : ''}`}
              >
                {link.name}
                {!link.available && <span class="coming-badge">Coming Soon</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .entry-container {
    min-height: 100vh;
    padding: 2rem 0;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .info-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .info-card h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fact-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fact-value {
    font-size: 1.125rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .spec-item h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .spec-item p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .content-section {
    margin: 3rem 0;
  }

  .content-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .content-section p {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .learn-section {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(37, 99, 235, 0.05) 100%);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 12px;
    padding: 2rem;
    margin: 3rem 0;
    text-align: center;
  }

  .learn-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .learn-section p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .learn-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .btn-secondary {
    background: var(--card-bg);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background: var(--hover-bg);
    transform: translateY(-1px);
  }

  .related-section {
    margin: 3rem 0;
  }

  .related-section h2 {
    font-size: 1.75rem;
    margin-bottom: 2rem;
    color: var(--text-primary);
  }

  .related-category {
    margin-bottom: 2rem;
  }

  .related-category h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .related-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .related-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.2s;
    position: relative;
  }

  .related-link:hover:not(.related-link--coming) {
    background: var(--hover-bg);
    transform: translateY(-1px);
    border-color: #3b82f6;
  }

  .related-link--coming {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .coming-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #f59e0b;
    color: white;
    font-size: 0.625rem;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>