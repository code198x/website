---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const hardwareEntries = await getCollection("hardware");
  return hardwareEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Hardware`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from ${entry.data.year || 'the golden age of computing'}.`}
  entry={entry}
  categorySlug="hardware"
  categoryName="Hardware"
  categoryIcon="🖥️"
  categoryColor="#3b82f6"
/>

