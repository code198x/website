---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'events');
---

<VaultCategoryLayout
  title="Events - The Vault"
  description="Explore legendary events where creativity, competition, and camaraderie defined digital culture."
  heroTitle="Events"
  heroSubtitle="Demoparties, conferences, and gatherings that brought the community together"
  heroDescription={`Explore ${categoryData.length} legendary events where creativity, competition, and camaraderie defined digital culture.`}
  heroIcon="🎪"
  heroColor="#f97316"
  categorySlug="events"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Events Collection"
  infoDescription="From massive demoparties in converted warehouses to intimate user group meetings, these events were where the magic happened. Code was shared, friendships forged, and legends born. They weren't just gatherings - they were celebrations of digital creativity and technical excellence."
>
  <div class="event-types">
    <div class="event-card">
      <h3>🎮 Demoparties</h3>
      <p>Multi-day festivals of real-time digital art, featuring competitions in demos, intros, graphics, and music</p>
    </div>
    <div class="event-card">
      <h3>💻 Copy Parties</h3>
      <p>Early gatherings focused on software sharing and cracking, evolving into creative competitions</p>
    </div>
    <div class="event-card">
      <h3>🎯 Competitions</h3>
      <p>Coding contests, game jams, and hack events that pushed programmers to their limits</p>
    </div>
  </div>

  <div class="event-culture">
    <h3>The Party Experience</h3>
    <ul>
      <li>Sleep-deprived coding marathons in sleeping bags beside computers</li>
      <li>Big screen competitions with live voting and audience reactions</li>
      <li>Informal seminars sharing techniques and tricks</li>
      <li>Networks of hundreds of computers sharing creations in real-time</li>
      <li>Friendships and rivalries that lasted decades</li>
    </ul>
  </div>
</VaultCategoryLayout>


