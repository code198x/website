---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just events entries
const eventsData = vaultData.filter(entry => entry.c === 'events');
---

<Layout title="Events - The Vault">
  <Hero
    title="Events Collection"
    subtitle="Demoparties, conferences, and gatherings that brought the community together"
    description={`Explore ${eventsData.length} legendary events where creativity, competition, and camaraderie defined digital culture.`}
    variant="gradient"
    badge={{
      text: "🎪 Events Collection",
      color: "#f97316"
    }}
  />

  <div class="events-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={eventsData}
        placeholder="Search events by name, type, location, or year..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the Events Collection</h2>
        <p>
          From massive demoparties in converted warehouses to intimate user group meetings,
          these events were where the magic happened. Code was shared, friendships forged,
          and legends born. They weren't just gatherings - they were celebrations of
          digital creativity and technical excellence.
        </p>

        <div class="event-types">
          <div class="event-card">
            <h3>🎮 Demoparties</h3>
            <p>Multi-day festivals of real-time digital art, featuring competitions in demos, intros, graphics, and music</p>
          </div>
          <div class="event-card">
            <h3>💻 Copy Parties</h3>
            <p>Early gatherings focused on software sharing and cracking, evolving into creative competitions</p>
          </div>
          <div class="event-card">
            <h3>🎯 Competitions</h3>
            <p>Coding contests, game jams, and hack events that pushed programmers to their limits</p>
          </div>
        </div>

        <div class="event-culture">
          <h3>The Party Experience</h3>
          <ul>
            <li>Sleep-deprived coding marathons in sleeping bags beside computers</li>
            <li>Big screen competitions with live voting and audience reactions</li>
            <li>Informal seminars sharing techniques and tricks</li>
            <li>Networks of hundreds of computers sharing creations in real-time</li>
            <li>Friendships and rivalries that lasted decades</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .events-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .event-types {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .event-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .event-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .event-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .event-culture {
    margin-top: 2rem;
    padding: 1.5rem;
    background: rgba(249, 115, 22, 0.1);
    border-radius: 8px;
  }

  .event-culture h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .event-culture ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .event-culture li {
    padding: 0.5rem 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
    position: relative;
    padding-left: 1.5rem;
  }

  .event-culture li::before {
    content: "⚡";
    position: absolute;
    left: 0;
    color: #f97316;
  }

  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .event-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode) .event-culture {
    background: rgba(249, 115, 22, 0.05);
  }

  @media (max-width: 768px) {
    .event-types {
      grid-template-columns: 1fr;
    }
  }
</style>