---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("events");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Events`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from the golden age of computing.`}
  entry={entry}
  categorySlug="events"
  categoryName="Events"
  categoryIcon="🎪"
  categoryColor="#f97316"
/>