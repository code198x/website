---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";
import "../../../styles/vault.css";

// Filter to just culture entries
const cultureData = vaultData.filter(entry => entry.c === 'culture');
---

<Layout title="Culture - The Vault">
  <Hero
    title="Culture"
    subtitle="Movements, scenes, and subcultures that emerged from the digital revolution"
    description={`Explore ${cultureData.length} cultural phenomena that transformed computers from tools into a way of life.`}
    variant="gradient"
    badge={{
      text: "🌐 Culture",
      color: "#a855f7",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={cultureData}
        placeholder="Search cultural movements, scenes, and phenomena..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={false}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="vault-category-info-section">
        <h2>About the Culture Collection</h2>
        <p>
          Computing wasn't just about technology - it spawned entire subcultures with their
          own values, aesthetics, and communities. From the competitive artistry of the demoscene
          to the underground networks of the BBS era, these movements defined what it meant
          to be part of the digital revolution.
        </p>

        <div class="culture-aspects">
          <div class="aspect-card">
            <h3>🎨 The Demoscene</h3>
            <p>
              A subculture focused on creating demos - non-interactive audiovisual presentations
              that showcase programming, visual art, and music skills. Born from the cracking scene,
              it evolved into a respected art form with its own competitions, groups, and legends.
            </p>
          </div>
          <div class="aspect-card">
            <h3>💻 Hacker Culture</h3>
            <p>
              The ethos of exploration, understanding, and pushing boundaries. Not about breaking
              things, but about deeply understanding how they work and making them do things
              never imagined by their creators.
            </p>
          </div>
          <div class="aspect-card">
            <h3>📡 BBS Era</h3>
            <p>
              Before the web, bulletin board systems created the first online communities.
              Local dial-up networks where users shared files, messages, and formed friendships
              that often moved into real life.
            </p>
          </div>
        </div>

        <div class="cultural-impact">
          <h3>Lasting Impact</h3>
          <ul>
            <li>Created new forms of digital art and expression</li>
            <li>Established ethics and values around sharing and collaboration</li>
            <li>Pioneered online communities and social networks</li>
            <li>Influenced modern game development and visual effects</li>
            <li>Preserved and celebrated computing history through active communities</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Layout>

