---
import { getCollection } from 'astro:content';
import VaultFeature from '../../../components/VaultFeature.astro';
import { vaultFeatures } from '../../../data/vault-features';
import { resolveVaultFeatures } from '../../../lib/vault-features';
import PageMasthead from '../../../components/PageMasthead.astro';
import PageFrame from '../../../components/PageFrame.astro';
import Grid from '../../../components/layout/Grid.astro';
import Layout from '../../../layouts/Layout.astro';
import VaultDirectory from '../../../components/VaultDirectory.astro';
import VaultReadingPaths from '../../../components/VaultReadingPaths.astro';
import { techniquePaths } from '../../../data/vault-reading-paths';
import { getVaultCategories } from '../../../lib/categories';
import { vaultColourGroup } from '../../../lib/vault-colours';
import '../../../styles/vault.css';
import '../../../styles/vault-inner.css';

// Get categories from collection
const categoriesData = await getVaultCategories();

// Map to format expected by template
const categories = categoriesData.map(c => ({
  slug: c.id,
  name: c.data.name,
  desc: c.data.description,
  color: c.data.color,
}));

export async function getStaticPaths() {
  const { getVaultCategories } = await import('../../../lib/categories');
  const categories = await getVaultCategories();
  return categories.map(c => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const category = categories.find(c => c.slug === slug);

if (!category) {
  return Astro.redirect('/vault');
}

// Get all vault entries in this category
const allEntries = await getCollection('vault');
const categoryEntries = allEntries
  .filter(e => e.data.category === slug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const feature = resolveVaultFeatures(vaultFeatures, allEntries).find(item => item.entry.data.category === slug);
const paths = (slug === 'techniques' ? techniquePaths : []).map(path => {
  const entry = allEntries.find(entry => entry.id === path.article);
  if (!entry?.data.reviewed) throw new Error(`Reading path must name a reviewed article: ${path.article}`);
  return { ...path, title: entry.data.title };
});

// Custom breadcrumbs - skip the "category" segment
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'The Vault', href: '/vault' },
  { label: category.name }
];
---

<Layout
  title={`${category.name} — The Vault`}
  description={`${category.desc} Browse all ${categoryEntries.length} articles in The Vault.`}
  breadcrumbs={breadcrumbs}
>
  <PageFrame as="section" opening="none" class="vault-category" data-vault-colour={vaultColourGroup(slug!)}>
    <PageMasthead class="category-mast" label={category.name} heading><span>{categoryEntries.length} articles</span></PageMasthead>
    <p class="category-intro">{category.desc}</p>
    {feature && <VaultFeature feature={feature} categoryName={category.name} compact />}


    {paths.length > 0 && <VaultReadingPaths paths={paths} />}
    {categoryEntries.length > 0 ? <VaultDirectory category={category.name} entries={categoryEntries} /> : <p class="empty-text">There are no articles in this category yet. Explore another subject below.</p>}

    <!-- Explore other subjects -->
    <div class="other-categories">
      <h2 class="other-title">Explore other subjects</h2>
      <Grid min="8rem" space={6} maxColumns={4} class="category-grid">
        {categories.filter(c => c.slug !== slug).map(cat => (
            <a href={`/vault/category/${cat.slug}`} class="category-link" data-vault-colour={vaultColourGroup(cat.slug)}>
              <span class="cat-name">{cat.name}</span>
            </a>
        ))}
      </Grid>
    </div>
  </PageFrame>
</Layout>

<style>@layer blocks {
    .empty-text { color: var(--h-ink-muted); max-width: 500px; margin: 0 auto; line-height: 1.6; }
    .other-categories { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--h-ink); }
    .other-title { font-size: 1.25rem; font-weight: 800; margin-bottom: var(--h-space-6); color: var(--h-ink); }
    .category-grid { row-gap: 0; }
    .category-link { display: flex; align-items: center; gap: var(--h-space-3); margin: 12px 0; padding: 8px 0; font-size: 16px; text-decoration: none; color: var(--h-ink); }
    .category-link:hover { color: var(--vault-category-ink); text-decoration: underline; }
}
</style>
