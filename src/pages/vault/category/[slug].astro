---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import InlineMarkdown from '../../../components/InlineMarkdown.astro';
import { HardDrive, Cpu, Users, Building2, Gamepad2, BookOpen, Wrench } from '@lucide/astro';

// Category metadata (same as index)
const categories = [
  { slug: 'systems', name: 'Systems', desc: 'The machines that defined an era.', icon: HardDrive },
  { slug: 'hardware', name: 'Hardware', desc: 'The chips and components that made it all possible.', icon: Cpu },
  { slug: 'people', name: 'People', desc: 'The developers, designers, and composers who defined the era.', icon: Users },
  { slug: 'companies', name: 'Companies & Studios', desc: 'From bedroom operations to publishing empires.', icon: Building2 },
  { slug: 'games', name: 'Classic Games', desc: 'The titles that pushed boundaries and defined genres.', icon: Gamepad2 },
  { slug: 'culture', name: 'Culture & Community', desc: 'Magazines, movements, and the scenes that connected it all.', icon: BookOpen },
  { slug: 'techniques', name: 'Techniques & Technology', desc: 'The clever tricks and deep system knowledge that made magic happen.', icon: Wrench },
];

export async function getStaticPaths() {
  const categorySlugs = ['systems', 'hardware', 'people', 'companies', 'games', 'culture', 'techniques'];
  return categorySlugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const category = categories.find(c => c.slug === slug);

if (!category) {
  return Astro.redirect('/vault');
}

// Get all vault entries in this category
const allEntries = await getCollection('vault');
const categoryEntries = allEntries
  .filter(e => e.data.category === slug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const IconComponent = category.icon;
---

<Layout
  title={`${category.name} — The Vault`}
  description={`${category.desc} Browse all ${categoryEntries.length} articles in The Vault.`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-icon"><IconComponent size={48} /></div>
      <h1 class="hero-title">{category.name}</h1>
      <p class="hero-subtitle">{category.desc}</p>
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-value">{categoryEntries.length}</div>
          <div class="stat-label">Articles</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/vault">The Vault</a>
    <span> / </span>
    <span>{category.name}</span>
  </nav>

  <section class="content-section">
    {categoryEntries.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {category.name.toLowerCase()} articles yet</h2>
        <p class="empty-text">
          Articles are being added regularly. Check back soon or explore other categories.
        </p>
      </div>
    ) : (
      <div class="article-grid">
        {categoryEntries.map(entry => (
          <a href={`/vault/${entry.slug}`} class="article-card">
            <h3 class="article-title">{entry.data.title}</h3>
            {entry.data.subtitle && (
              <p class="article-subtitle">{entry.data.subtitle}</p>
            )}
            <p class="article-summary"><InlineMarkdown text={entry.data.summary} /></p>
          </a>
        ))}
      </div>
    )}

    <!-- Other Categories -->
    <div class="other-categories">
      <h2 class="other-title">Other Categories</h2>
      <div class="category-grid">
        {categories.filter(c => c.slug !== slug).map(cat => {
          const CatIcon = cat.icon;
          return (
            <a href={`/vault/category/${cat.slug}`} class="category-link">
              <span class="cat-icon"><CatIcon size={20} /></span>
              <span class="cat-name">{cat.name}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
    /* Hero Section */
    .hero {
      min-height: 250px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
      pointer-events: none;
    }

    .hero-content {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
      color: white;
      padding: var(--space-8) var(--space-4);
    }

    .hero-icon {
      color: var(--color-primary);
      margin-bottom: var(--space-4);
      opacity: 0.9;
    }

    .hero-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      margin-bottom: var(--space-2);
      letter-spacing: -0.02em;
    }

    .hero-subtitle {
      font-size: 1.125rem;
      opacity: 0.9;
      margin-bottom: var(--space-4);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-8);
      justify-content: center;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-family-mono);
      font-size: 2rem;
      font-weight: 900;
      color: var(--color-primary);
    }

    .stat-label {
      font-size: 0.75rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Breadcrumb */
    .breadcrumb {
      padding: var(--space-4) var(--space-4);
      max-width: 1000px;
      margin: 0 auto;
    }

    .breadcrumb a {
      color: var(--color-text-secondary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .breadcrumb span {
      color: var(--color-text-muted);
    }

    /* Content Section */
    .content-section {
      padding: var(--space-4) var(--space-4) var(--space-12);
      max-width: 1000px;
      margin: 0 auto;
    }

    /* Article Grid */
    .article-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-4);
    }

    .article-card {
      display: block;
      padding: var(--space-3) var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .article-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--color-primary);
    }

    .article-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--color-text);
    }

    .article-subtitle {
      font-size: 0.875rem;
      color: var(--color-primary);
      margin-bottom: var(--space-2);
      font-style: italic;
    }

    .article-summary {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* Empty State */
    .empty-notice {
      background: var(--color-surface);
      border: 2px dashed var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-12);
      text-align: center;
    }

    .empty-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .empty-text {
      color: var(--color-text-secondary);
      max-width: 500px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Other Categories */
    .other-categories {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }

    .other-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-6);
      color: var(--color-text);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
    }

    .category-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .category-link:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .category-link .cat-icon {
      color: var(--color-primary);
    }

    .category-link .cat-name {
      font-weight: 600;
    }

    @media (max-width: 768px) {
      .article-grid {
        grid-template-columns: 1fr;
      }

      .category-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
</style>
