---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import InlineMarkdown from '../../../components/InlineMarkdown.astro';
import DynamicIcon from '../../../components/DynamicIcon.astro';
import AlphabetFilter from '../../../components/AlphabetFilter.astro';
import { getVaultCategories } from '../../../lib/categories';

// Get categories from collection
const categoriesData = await getVaultCategories();

// Map to format expected by template
const categories = categoriesData.map(c => ({
  slug: c.id,
  name: c.data.name,
  desc: c.data.description,
  icon: c.data.icon,
  color: c.data.color,
}));

export async function getStaticPaths() {
  const { getVaultCategories } = await import('../../../lib/categories');
  const categories = await getVaultCategories();
  return categories.map(c => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const category = categories.find(c => c.slug === slug);

if (!category) {
  return Astro.redirect('/vault');
}

// Get all vault entries in this category
const allEntries = await getCollection('vault');
const categoryEntries = allEntries
  .filter(e => e.data.category === slug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const categoryIcon = category.icon;

// Custom breadcrumbs - skip the "category" segment
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'The Vault', href: '/vault' },
  { label: category.name }
];
---

<Layout
  title={`${category.name} — The Vault`}
  description={`${category.desc} Browse all ${categoryEntries.length} articles in The Vault.`}
  breadcrumbs={breadcrumbs}
>
  <section class="content-section">
    <div class="vhead">
      <p class="eyebrow"><span class="vhead-icon"><DynamicIcon name={categoryIcon} size={16} /></span> The Vault · {category.name}</p>
      <h1>{category.name}</h1>
      <div class="herorule"></div>
      <p class="lede">{category.desc}</p>
      <p class="summary"><b>{categoryEntries.length}</b> articles</p>
    </div>

    {categoryEntries.length === 0 ? (
      <div class="empty-notice">
        <h2 class="empty-title">No {category.name.toLowerCase()} articles yet</h2>
        <p class="empty-text">
          Articles are being added regularly. Check back soon or explore other categories.
        </p>
      </div>
    ) : (
      <>
        <AlphabetFilter entries={categoryEntries.map(e => ({ title: e.data.title }))} />
        <div class="article-grid">
          {categoryEntries.map(entry => (
            <a href={`/vault/${entry.id}`} class="article-card" data-title={entry.data.title}>
              <h3 class="article-title">{entry.data.title}</h3>
              {entry.data.subtitle && (
                <p class="article-subtitle">{entry.data.subtitle}</p>
              )}
              <p class="article-summary"><InlineMarkdown text={entry.data.summary} /></p>
            </a>
          ))}
        </div>
      </>
    )}

    <!-- Other Categories -->
    <div class="other-categories">
      <h2 class="other-title">Other Categories</h2>
      <div class="category-grid">
        {categories.filter(c => c.slug !== slug).map(cat => (
            <a href={`/vault/category/${cat.slug}`} class="category-link">
              <span class="cat-icon"><DynamicIcon name={cat.icon} size={20} /></span>
              <span class="cat-name">{cat.name}</span>
            </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
    .content-section { padding: var(--space-5) var(--space-6) var(--space-16); max-width: 1000px; margin: 0 auto; }
    .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); display: flex; align-items: center; gap: 6px; }
    .vhead-icon { display: inline-flex; color: var(--color-house-2); }
    .vhead { margin-bottom: var(--space-8); }
    .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 8vw, 4.6rem); line-height: 0.84; margin: var(--space-1) 0 0; color: var(--color-text); }
    .herorule { height: 9px; width: 240px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
    .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
    .lede { font-size: 1rem; max-width: 68ch; margin: var(--space-3) 0 0; color: var(--color-text); }
    .summary { font-family: var(--font-family-mono); font-size: 0.75rem; color: var(--color-text-secondary); margin-top: var(--space-2); }
    .summary b { color: var(--color-text); }

    .article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4); margin-top: var(--space-6); }
    .article-card { display: block; padding: var(--space-5); background: var(--color-surface); border: 3px solid var(--color-border); text-decoration: none; color: var(--color-text); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
    .article-card:hover, .article-card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--color-house-2); border-color: var(--color-house-2); }
    .article-title { font-size: 1.15rem; font-weight: 700; margin: 0 0 var(--space-2); color: var(--color-text); }
    .article-subtitle { font-size: 0.85rem; color: var(--color-house-2); margin: 0 0 var(--space-2); font-style: italic; }
    .article-summary { font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.55; margin: 0; }

    .empty-notice { background: var(--color-surface); border: 3px dashed var(--color-border); padding: var(--space-12); text-align: center; }
    .empty-title { font-size: 1.25rem; margin-bottom: var(--space-3); color: var(--color-text); }
    .empty-text { color: var(--color-text-secondary); max-width: 500px; margin: 0 auto; line-height: 1.6; }

    .other-categories { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 3px solid var(--color-text); }
    .other-title { font-size: 1.25rem; font-weight: 800; margin-bottom: var(--space-6); color: var(--color-text); }
    .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-4); }
    .category-link { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background: var(--color-surface); border: 3px solid var(--color-border); text-decoration: none; color: var(--color-text); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
    .category-link:hover { border-color: var(--color-house-2); transform: translate(-3px, -3px); box-shadow: var(--shadow-chunky); }
    .category-link .cat-icon { display: inline-flex; color: var(--color-house-2); }
    .category-link .cat-name { font-weight: 600; }

    @media (max-width: 768px) { .article-grid { grid-template-columns: 1fr; } .category-grid { grid-template-columns: 1fr 1fr; } }
</style>
