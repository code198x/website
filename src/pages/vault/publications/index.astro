---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'publications');
---

<VaultCategoryLayout
  title="Publications - The Vault"
  description="Discover publications that taught, inspired, and connected the computing community."
  heroTitle="Publications"
  heroSubtitle="Magazines, books, and newsletters that documented the digital revolution"
  heroDescription={`Discover ${categoryData.length} publications that taught, inspired, and connected the computing community.`}
  heroIcon="📚"
  heroColor="#ef4444"
  categorySlug="publications"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Publications Collection"
  infoDescription="Before the internet, magazines and books were the lifeline of the computing community. They shared type-in programs, hardware hacks, game reviews, and connected enthusiasts worldwide. These publications didn't just document history - they helped create it."
>
  <div class="publication-types">
    <div class="type-card">
      <div class="type-icon">📖</div>
      <h3>Magazines</h3>
      <p>Monthly windows into the rapidly evolving world of computing</p>
    </div>
    <div class="type-card">
      <div class="type-icon">📝</div>
      <h3>Type-In Programs</h3>
      <p>Learn by typing - programs printed in magazines for readers to enter</p>
    </div>
    <div class="type-card">
      <div class="type-icon">📰</div>
      <h3>Newsletters</h3>
      <p>User group publications that fostered local computing communities</p>
    </div>
    <div class="type-card">
      <div class="type-icon">📘</div>
      <h3>Technical Books</h3>
      <p>Deep dives into hardware, programming, and system architecture</p>
    </div>
  </div>

  <div class="historical-note">
    <h3>Historical Significance</h3>
    <p>
      These publications were more than media - they were the social network of their time.
      Through reader letters, program submissions, and shared discoveries, they created
      a global community of computer enthusiasts learning together.
    </p>
  </div>
</VaultCategoryLayout>


