---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just publications entries
const publicationsData = vaultData.filter(entry => entry.c === 'publications');
---

<Layout title="Publications - The Vault">
  <Hero
    title="Publications Collection"
    subtitle="Magazines, books, and newsletters that documented the digital revolution"
    description={`Discover ${publicationsData.length} publications that taught, inspired, and connected the computing community.`}
    variant="gradient"
    badge={{
      text: "📚 Publications Collection",
      color: "#ef4444"
    }}
  />

  <div class="publications-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={publicationsData}
        placeholder="Search publications by name, type, or topic..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the Publications Collection</h2>
        <p>
          Before the internet, magazines and books were the lifeline of the computing community.
          They shared type-in programs, hardware hacks, game reviews, and connected enthusiasts
          worldwide. These publications didn't just document history - they helped create it.
        </p>

        <div class="publication-types">
          <div class="type-card">
            <div class="type-icon">📖</div>
            <h3>Magazines</h3>
            <p>Monthly windows into the rapidly evolving world of computing</p>
          </div>
          <div class="type-card">
            <div class="type-icon">📝</div>
            <h3>Type-In Programs</h3>
            <p>Learn by typing - programs printed in magazines for readers to enter</p>
          </div>
          <div class="type-card">
            <div class="type-icon">📰</div>
            <h3>Newsletters</h3>
            <p>User group publications that fostered local computing communities</p>
          </div>
          <div class="type-card">
            <div class="type-icon">📘</div>
            <h3>Technical Books</h3>
            <p>Deep dives into hardware, programming, and system architecture</p>
          </div>
        </div>

        <div class="historical-note">
          <h3>Historical Significance</h3>
          <p>
            These publications were more than media - they were the social network of their time.
            Through reader letters, program submissions, and shared discoveries, they created
            a global community of computer enthusiasts learning together.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .publications-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .publication-types {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .type-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    text-align: center;
  }

  .type-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .type-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .type-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .historical-note {
    margin-top: 2rem;
    padding: 1.5rem;
    background: rgba(239, 68, 68, 0.1);
    border-left: 4px solid #ef4444;
    border-radius: 4px;
  }

  .historical-note h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .historical-note p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .type-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode) .historical-note {
    background: rgba(239, 68, 68, 0.05);
  }

  @media (max-width: 768px) {
    .publication-types {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }
</style>