---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("publications");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const displayYear = entry.data.firstIssue ? entry.data.firstIssue.getFullYear() : null;
---

<VaultEntryLayout
  title={`${entry.data.name} - Publications`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from ${displayYear || 'the golden age of computing'}.`}
  entry={entry}
  categorySlug="publications"
  categoryName="Publications"
  categoryIcon="📚"
  categoryColor="#ef4444"
/>
