---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const companies = await getCollection("companies");
  return companies.map((company) => ({
    params: { slug: company.slug },
  }));
}

const company = await getEntry("companies", Astro.params.slug);
if (!company) {
    throw new Error(`Company not found: ${Astro.params.slug}`);
}

const { Content } = await render(company);

// Format dates for display
const formatDate = (date: Date | string | undefined) => {
  if (!date) return null;
  const dateObj = typeof date === 'string' ? new Date(date) : date;
  return dateObj.toLocaleDateString('en-GB', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

const foundedDate = formatDate(company.data.founded);
const dissolvedDate = formatDate(company.data.dissolved);
const acquisitionDate = formatDate(company.data.acquisition_date);
---

<Layout title={`${company.data.name} - Companies - The Vault - Code Like It's 198x`}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <a href="/vault" class="text-blue-600 hover:underline">The Vault</a>
      <span class="mx-2">/</span>
      <a href="/vault/companies" class="text-blue-600 hover:underline">Companies</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">{company.data.name}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{company.data.name}</h1>
      
      <div class="bg-gray-50 rounded-lg p-6 mb-6">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Company Details</h2>
            <dl class="space-y-2 text-sm">
              <div class="flex">
                <dt class="font-medium text-gray-600 w-20">Founded:</dt>
                <dd class="text-gray-800">{foundedDate}</dd>
              </div>
              {dissolvedDate && (
                <div class="flex">
                  <dt class="font-medium text-gray-600 w-20">Dissolved:</dt>
                  <dd class="text-gray-800">{dissolvedDate}</dd>
                </div>
              )}
              {company.data.acquired_by && acquisitionDate && (
                <div class="flex">
                  <dt class="font-medium text-gray-600 w-20">Acquired:</dt>
                  <dd class="text-gray-800">{acquisitionDate} by {company.data.acquired_by}</dd>
                </div>
              )}
              <div class="flex">
                <dt class="font-medium text-gray-600 w-20">Location:</dt>
                <dd class="text-gray-800">{company.data.headquarters}, {company.data.country}</dd>
              </div>
            </dl>
          </div>
          
          <div>
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Key People</h2>
            <dl class="space-y-2 text-sm">
              <div>
                <dt class="font-medium text-gray-600 mb-1">Founders:</dt>
                <dd class="text-gray-800">
                  {company.data.founders.map(founder => 
                    typeof founder === 'string' ? founder : 
                    `${founder.name}${founder.role ? ` (${founder.role})` : ''}`
                  ).join(', ')}
                </dd>
              </div>
              {company.data.key_people && company.data.key_people.length > 0 && (
                <div>
                  <dt class="font-medium text-gray-600 mb-1">Key People:</dt>
                  <dd class="text-gray-800">
                    {company.data.key_people.map(person => 
                      typeof person === 'string' ? person : 
                      `${person.name}${person.role ? ` (${person.role})` : ''}${person.tenure ? ` ${person.tenure}` : ''}`
                    ).join(', ')}
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mt-6">
          <div>
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Business Focus</h2>
            <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
              {company.data.business_focus.map((focus) => (
                <li>{focus}</li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Notable Products</h2>
            <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
              {company.data.notable_products.map((product) => (
                <li>
                  {typeof product === 'string' ? product : 
                    `${product.name}${product.type ? ` (${product.type})` : ''}${product.year ? ` - ${product.year}` : ''}`
                  }
                </li>
              ))}
            </ul>
          </div>
        </div>

        {company.data.legacy && (
          <div class="mt-6">
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Legacy</h2>
            <p class="text-sm text-gray-700 italic">
              {company.data.legacy}
            </p>
          </div>
        )}
      </div>
    </header>

    <article class="prose prose-lg max-w-none">
      <Content />
    </article>

    {company.data.external_links && company.data.external_links.length > 0 && (
      <div class="mt-8 p-6 bg-blue-50 rounded-lg">
        <h2 class="text-lg font-semibold mb-4">External Resources</h2>
        <ul class="space-y-2">
          {company.data.external_links.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-blue-600 hover:text-blue-800 underline"
              >
                {link.title} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </main>
</Layout>