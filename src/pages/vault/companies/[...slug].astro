---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("companies");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Companies`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from the golden age of computing.`}
  entry={entry}
  categorySlug="companies"
  categoryName="Companies"
  categoryIcon="🏢"
  categoryColor="#6366f1"
/>