---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just companies entries
const companiesData = vaultData.filter(entry => entry.c === 'companies');
---

<Layout title="Companies - The Vault">
  <Hero
    title="Companies Collection"
    subtitle="The corporations and startups that defined the computing revolution"
    description={`Explore ${companiesData.length} companies that built the hardware, published the software, and shaped the industry.`}
    variant="gradient"
    badge={{
      text: "🏢 Companies Collection",
      color: "#3b82f6"
    }}
  />

  <div class="companies-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={companiesData}
        placeholder="Search companies by name, type, or products..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the Companies Collection</h2>
        <p>
          From garage startups to computing giants, these companies drove innovation,
          created new markets, and sometimes spectacularly failed. Each company's story
          is part of the larger narrative of how personal computing transformed the world.
        </p>

        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">{companiesData.filter(c => c.t === 'hardware').length}</span>
            <span class="stat-label">Hardware Manufacturers</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{companiesData.filter(c => c.t === 'software').length}</span>
            <span class="stat-label">Software Publishers</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{companiesData.filter(c => c.t === 'publisher').length}</span>
            <span class="stat-label">Game Publishers</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{companiesData.filter(c => c.st === 'available').length}</span>
            <span class="stat-label">Documented</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .companies-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .stat-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: bold;
    color: #3b82f6;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-secondary);
  }

  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .stat-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>