---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'companies');
---

<VaultCategoryLayout
  title="Companies - The Vault"
  description="Explore companies that built the hardware, published the software, and shaped the industry."
  heroTitle="Companies"
  heroSubtitle="The corporations and startups that defined the computing revolution"
  heroDescription={`Explore ${categoryData.length} companies that built the hardware, published the software, and shaped the industry.`}
  heroIcon="🏢"
  heroColor="#3b82f6"
  categorySlug="companies"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Companies Collection"
  infoDescription="From garage startups to computing giants, these companies drove innovation, created new markets, and sometimes spectacularly failed. Each company's story is part of the larger narrative of how personal computing transformed the world."
  stats={[
    {
      label: "Hardware Manufacturers",
      value: 0,
      filter: (c) => c.t === 'hardware'
    },
    {
      label: "Software Publishers",
      value: 0,
      filter: (c) => c.t === 'software'
    },
    {
      label: "Game Publishers",
      value: 0,
      filter: (c) => c.t === 'publisher'
    },
    {
      label: "Documented",
      value: 0,
      filter: (c) => c.st === 'available'
    }
  ]}
/>