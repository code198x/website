---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import AlphabeticalList from "../../../components/AlphabeticalList.astro";
import { sortAlphabetically, groupByFirstLetter } from "../../../utils/helpers";

const companies = await getCollection("companies");
const groupedCompanies = groupByFirstLetter(companies.sort(sortAlphabetically));
---

<Layout title="Companies - The Vault - Code Like It's 198x">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2">Companies</h1>
    <p class="text-xl text-gray-600 mb-8">
      The companies that created the processors, computers, and software that defined the digital revolution.
    </p>

    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <a href="/vault" class="text-blue-600 hover:underline">The Vault</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">Companies</span>
    </nav>

    <AlphabeticalList title="Companies" groupedItems={groupedCompanies} baseUrl="/vault/companies" />
  </main>
</Layout>