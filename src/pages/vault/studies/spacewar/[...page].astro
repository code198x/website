---
import SpacewarStudy from '../../../../components/SpacewarStudy.astro';
import {gameStudies} from '../../../../data/game-studies.mjs';
export function getStaticPaths() {
 const study=gameStudies.find(study=>study.slug==='spacewar')!;
 return [undefined,...study.companions].map(page=>({params:{page}}));
}
---
<SpacewarStudy page={Astro.params.page} />
