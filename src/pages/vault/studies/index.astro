---
import Layout from '../../../layouts/Layout.astro';
import FeatureArticle from '../../../components/editorial/FeatureArticle.astro';
import ArticleOpening from '../../../components/editorial/ArticleOpening.astro';
import {gameStudies, studyPath} from '../../../data/game-studies.mjs';
const breadcrumbs=[{label:'Home',href:'/'},{label:'The Vault',href:'/vault/'},{label:'Game Studies'}];
---
<Layout title="Game studies — The Vault" description="Spend time with a game: how it plays, how it was made, and why it matters." breadcrumbs={breadcrumbs} noindex={gameStudies.every(study=>!study.reviewed)}>
 <FeatureArticle>
  <ArticleOpening slot="opening" title="Game studies" description="Spend time with a game: how it plays, how it was made, and why it matters." tone="paper" />
  <p>Get to know the whole game. Follow a manoeuvre into the maths, a design choice into the machine, or an imagined world into the people and culture that shaped it.</p>
  {gameStudies.map(study=><section class="study-listing" aria-labelledby={`study-${study.slug}`}>
   <a class="study-cover" href={studyPath(study.slug)} aria-label={`Read ${study.title}`}><img src={study.image} alt="" width="2172" height="724" /></a>
   <p class="study-art-credit">Original editorial illustration</p>
   <h2 id={`study-${study.slug}`}><a href={studyPath(study.slug)}>{study.title}</a></h2>
   <p>{study.description}</p>
   <p class="study-context">{study.context}{!study.reviewed && ' · Not yet fact-checked'}</p>
   <p><a href={studyPath(study.slug)}>Read the study</a></p>
  </section>)}
  <p>Each study connects to the Vault’s focused reference articles and to explanations elsewhere on the site. You can follow those threads without needing to write a program.</p>
 </FeatureArticle>
</Layout>
<style>
 @layer legacy {
 .study-listing{grid-column:wide;max-width:1000px;width:100%;justify-self:center;margin:24px 0 48px}
 .study-cover{display:block}.study-cover img{display:block;width:100%;height:auto}
 .study-cover:focus-visible{outline:3px solid var(--h-ink);outline-offset:5px}
 .study-art-credit,.study-context{font-size:14px!important;line-height:1.6!important;color:var(--h-ink-muted)!important}
 .study-art-credit{margin:10px 0 0}.study-listing h2{margin-top:28px!important}
 .study-listing p{max-width:65ch;margin-bottom:16px}
 }
</style>
