---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";
import "../../../styles/vault.css";

// Filter to just applications entries
const applicationsData = vaultData.filter(entry => entry.c === 'applications');
---

<Layout title="Applications - The Vault">
  <Hero
    title="Applications"
    subtitle="Creative and productivity software that empowered users"
    description={`Explore ${applicationsData.length} applications that transformed computers from calculators into creative tools.`}
    variant="gradient"
    badge={{
      text: "🎨 Applications",
      color: "#8b5cf6",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={applicationsData}
        placeholder="Search applications by name, type, platform..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="vault-category-info-section">
        <h2>About the Applications Collection</h2>
        <p>
          From paint programs that democratized digital art to music trackers that
          revolutionized computer music, these applications represent the creative
          tools that turned home computers into multimedia powerhouses. Each entry
          documents the features, file formats, and cultural impact of these
          groundbreaking programs.
        </p>
      </section>
    </div>
  </div>
</Layout>