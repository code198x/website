---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'applications');
---

<VaultCategoryLayout
  title="Applications - The Vault"
  description="Explore applications that transformed computers from calculators into creative tools."
  heroTitle="Applications"
  heroSubtitle="Creative and productivity software that empowered users"
  heroDescription={`Explore ${categoryData.length} applications that transformed computers from calculators into creative tools.`}
  heroIcon="🎨"
  heroColor="#8b5cf6"
  categorySlug="applications"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Applications Collection"
  infoDescription="From paint programs that democratized digital art to music trackers that revolutionized computer music, these applications represent the creative tools that turned home computers into multimedia powerhouses. Each entry documents the features, file formats, and cultural impact of these groundbreaking programs."
/>