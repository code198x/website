---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import DynamicIcon from '../../components/DynamicIcon.astro';
import { getAllPlatforms } from '../../lib/platforms';
import { getVaultCategories } from '../../lib/categories';
import { getBacklinks } from '../../lib/backlinks';

export async function getStaticPaths() {
  const vaultEntries = await getCollection('vault');

  return vaultEntries.map((entry) => {
    return {
      params: { slug: entry.id },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Units that cite this entry (IA v3 "Referenced in lessons").
const backlinks = await getBacklinks(`/vault/${entry.id}`);

// Build category lookup from collection
const categoriesData = await getVaultCategories();
const categoryInfo = Object.fromEntries(
  categoriesData.map(c => [c.id, { name: c.data.name, icon: c.data.icon, color: c.data.color }])
);

const category = categoryInfo[entry.data.category] || { name: entry.data.category, icon: 'FileText', color: '#94a3b8' };

// Get current category from slug for browse links
const currentCategory = entry.data.category;

// Build platform key -> display name mapping from collection
// Vault frontmatter uses lowercase short keys (c64, spectrum, amiga, nes)
const platforms = await getAllPlatforms();
const platformNames = Object.fromEntries(
  platforms.map(p => [p.data.shortName.toLowerCase(), p.data.shortName])
);

// Titles for every Vault entry, so a `sources[].ref` can be shown as the name of
// the thing rather than a path.
const vaultTitles = new Map(
  (await getCollection('vault')).map((e) => [e.id, e.data.title])
);

const MONTHS = ['January','February','March','April','May','June',
                'July','August','September','October','November','December'];

/**
 * Citations for one frontmatter field, from `sources`.
 *
 * Only what IS sourced gets marked. Flagging what is not would put "unverified"
 * on almost every page — 238 of 239 company entries carry a founding year and
 * one carries a source for it — and a warning that never varies tells a reader
 * nothing. Manufacturing doubt is the same failure as manufacturing certainty.
 * A citation that appears as entries are grounded is a positive signal, and it
 * hands the reader something to check.
 */
function citations(data, fields) {
  const out = [];
  for (const f of fields ?? []) {
    for (const s of data.sources?.[f] ?? []) {
      const name = (s.ref && vaultTitles.get(s.ref)) || s.title || s.ref;
      if (!name) continue;
      // "1985-05" is deliberately a string in the schema: partial dates are not
      // dates, and treating them as one invents a day.
      let when = '';
      if (s.date) {
        const [y, m] = s.date.split('-');
        when = m ? `, ${MONTHS[Number(m) - 1] ?? m} ${y}` : `, ${y}`;
      }
      const issue = s.issue ? `, issue ${s.issue}` : '';
      const rest = `${when}${issue}`;
      // A single source often carries several fields — Companies House gives
      // both the incorporation and the dissolution — and citing it once per
      // field prints "Companies House; Companies House".
      if (out.some((o) => o.name === name && o.rest === rest)) continue;
      out.push({ href: s.ref ? `/vault/${s.ref}` : null, name, rest });
    }
  }
  return out;
}

// Category-specific date fields helper
function getDateDisplay(entry) {
  const cat = entry.data.category;
  const data = entry.data;

  switch (cat) {
    case 'people':
      if (data.born || data.died) {
        // A known death with an unknown birth year is a real state, not a gap
        // to paper over: render it as "Died 2021" rather than "?-2021".
        if (!data.born) return { label: 'Died', value: String(data.died) };
        const died = data.died ? data.died : 'present';
        return { label: 'Lived', value: `${data.born}–${died}` };
      }
      break;
    case 'companies':
    case 'groups':
      if (data.founded || data.ended) {
        const founded = data.founded ?? '?';
        // A missing `ended` is not evidence that a company is still trading.
        // Rendering the range regardless printed "Active: 1980–present" on
        // Acornsoft and 169 others, asserting survival for companies that were
        // wound up decades ago — the same confusion `ended` replaced `dissolved`
        // to fix, running the other way.
        //
        // So absence and null are read as the different things they are:
        //   ended: 1988   an established ending      "Active 1980–1988"
        //   ended: null   established as still going "Active 1979–present"
        //   (absent)      not established            "Founded 1980"
        if (data.ended === undefined) {
          return { label: 'Founded', value: String(founded), fields: ['founded'] };
        }
        const ended = data.ended ? data.ended : 'present';
        // How it ended, where we know: "1984–1988 (acquired)" rather than a
        // bare range that reads as a death for a company that was bought.
        const how = data.ended && data.ended_as ? ` (${data.ended_as})` : '';
        return { label: 'Active', value: `${founded}–${ended}${how}`, fields: ['founded', 'ended'] };
      }
      break;
    case 'games':
    case 'demos':
      if (data.released) {
        return { label: 'Released', value: String(data.released), fields: ['released'] };
      }
      break;
    case 'techniques':
      if (data.originated || data.deprecated) {
        const originated = data.originated ?? '?';
        const deprecated = data.deprecated ? data.deprecated : 'present';
        return { label: 'Used', value: `${originated}–${deprecated}` };
      }
      break;
    case 'culture':
    case 'phenomena':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Period', value: `${emerged}–${ended}` };
      }
      break;
    case 'events':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Held', value: `${emerged}–${ended}` };
      }
      break;
    case 'magazines':
      if (data.founded || data.ended) {
        const founded = data.founded ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Published', value: `${founded}–${ended}`, fields: ['founded', 'ended'] };
      }
      break;
    case 'books':
      if (data.released) {
        return { label: 'Published', value: String(data.released) };
      }
      break;
    case 'tools':
    case 'emulators':
      if (data.released) {
        return { label: 'Released', value: String(data.released) };
      }
      break;
    case 'genres':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Era', value: `${emerged}–${ended}` };
      }
      break;
    case 'distribution':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Era', value: `${emerged}–${ended}` };
      }
      break;
    case 'communities':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Active', value: `${emerged}–${ended}` };
      }
      break;
    case 'hardware':
    case 'systems':
      if (data.introduced || data.discontinued) {
        const introduced = data.introduced ?? '?';
        const discontinued = data.discontinued ? data.discontinued : 'present';
        return { label: 'Produced', value: `${introduced}–${discontinued}` };
      }
      break;
  }

  return null;
}

const dateDisplay = getDateDisplay(entry);
const dateCitations = citations(entry.data, dateDisplay?.fields);
const hasTags = (entry.data.platforms?.length > 0) || (entry.data.tags?.length > 0) || dateDisplay;

// Build custom breadcrumbs with proper title
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'The Vault', href: '/vault' },
  { label: category.name, href: `/vault/category/${entry.data.category}` },
  { label: entry.data.title }
];
---

<Layout title={entry.data.title} description={entry.data.summary} breadcrumbs={breadcrumbs}>
  <div class="vault-container">
    <div class="vault-layout">
      <article class="vault-entry">
        <header class="header" style={`--category-color: ${category.color}`}>
          <a href={`/vault/category/${entry.data.category}`} class="category-badge">
            <span class="category-icon"><DynamicIcon name={category.icon} size={16} /></span>
            <span class="category-name">{category.name}</span>
          </a>

          <h1 class="title">{entry.data.title}</h1>
          {entry.data.subtitle && <h2 class="subtitle">{entry.data.subtitle}</h2>}
          <div class="herorule"></div>

          {entry.data.summary && (
            <div class="summary-callout">
              <div class="summary-accent"></div>
              <p class="summary"><InlineMarkdown text={entry.data.summary} /></p>
            </div>
          )}

          <div class="tags tags-mobile">
            {entry.data.platforms?.map((p) => (
              <span class="tag platform">{platformNames[p] || p}</span>
            ))}
            {entry.data.tags?.map((t) => (
              <span class="tag tech">{t}</span>
            ))}
            {dateDisplay && (
              <span class="tag years">{dateDisplay.value}</span>
            )}
          </div>
        </header>

        <div class="content">
          <Content />
        </div>

        <footer class="provenance" data-reviewed={entry.data.reviewed ? 'true' : 'false'}>
          {entry.data.reviewed ? (
            /* Deliberately says nothing about who drafted the entry. The
               ai_generated flag is not reliable in its `false` state — entries
               marked as human-written include AI-drafted ones — so claiming
               human authorship here stated something we cannot stand behind.
               What we can stand behind is that a person checked it. */
            <p>
              <strong>Checked.</strong> Verified against primary sources and
              signed off by a person.
            </p>
          ) : (
            <p>
              <strong>Not yet fact-checked.</strong> This entry was drafted by an
              AI and nobody has verified it. The dates, figures and technical
              details may be wrong. Use it to find your bearings, then confirm
              anything that matters against a primary source.
            </p>
          )}
        </footer>
      </article>

      <aside class="vault-sidebar">
        <div class="sidebar-section">
          <TableOfContents selector=".content" />
        </div>

        {hasTags && (
          <div class="sidebar-section">
            <h4 class="sidebar-title">Details</h4>
            {dateDisplay && (
              <div class="sidebar-detail">
                <span class="detail-label">{dateDisplay.label}</span>
                <span class="detail-value">{dateDisplay.value}</span>
                {dateCitations.length > 0 && (
                  <cite class="detail-source">
                    {dateCitations.map((c, i) => (
                      <>
                        {i > 0 && '; '}
                        {c.href ? <a href={c.href}>{c.name}</a> : c.name}{c.rest}
                      </>
                    ))}
                  </cite>
                )}
              </div>
            )}
            {entry.data.platforms?.length > 0 && (
              <div class="sidebar-detail">
                <span class="detail-label">Platforms</span>
                <span class="detail-value">{entry.data.platforms.map(p => platformNames[p] || p).join(', ')}</span>
              </div>
            )}
            {entry.data.tags?.length > 0 && (
              <div class="sidebar-tags">
                {entry.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            )}
          </div>
        )}

        {backlinks.length > 0 && (
          <div class="sidebar-section">
            <h4 class="sidebar-title">Referenced in lessons</h4>
            <ul class="refs">
              {backlinks.map(b => (
                <li><a href={b.url}>{b.title}<span class="ref-url">{b.url}</span></a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="sidebar-section">
          <h4 class="sidebar-title">Browse The Vault</h4>
          <ul class="browse-links">
            <li><a href="/vault/category/hardware" class={currentCategory === 'hardware' ? 'active' : ''}>🔧 Hardware</a></li>
            <li><a href="/vault/category/systems" class={currentCategory === 'systems' ? 'active' : ''}>💾 Systems</a></li>
            <li><a href="/vault/category/people" class={currentCategory === 'people' ? 'active' : ''}>👾 People</a></li>
            <li><a href="/vault/category/companies" class={currentCategory === 'companies' ? 'active' : ''}>🏢 Companies</a></li>
            <li><a href="/vault/category/groups" class={currentCategory === 'groups' ? 'active' : ''}>👥 Groups</a></li>
            <li><a href="/vault/category/games" class={currentCategory === 'games' ? 'active' : ''}>🎮 Games</a></li>
            <li><a href="/vault/category/demos" class={currentCategory === 'demos' ? 'active' : ''}>✨ Demos</a></li>
            <li><a href="/vault/category/genres" class={currentCategory === 'genres' ? 'active' : ''}>🏷️ Genres</a></li>
            <li><a href="/vault/category/techniques" class={currentCategory === 'techniques' ? 'active' : ''}>⚙️ Techniques</a></li>
            <li><a href="/vault/category/tools" class={currentCategory === 'tools' ? 'active' : ''}>🛠️ Tools</a></li>
            <li><a href="/vault/category/emulators" class={currentCategory === 'emulators' ? 'active' : ''}>🖥️ Emulators</a></li>
            <li><a href="/vault/category/culture" class={currentCategory === 'culture' ? 'active' : ''}>🌍 Culture</a></li>
            <li><a href="/vault/category/events" class={currentCategory === 'events' ? 'active' : ''}>🎪 Events</a></li>
            <li><a href="/vault/category/phenomena" class={currentCategory === 'phenomena' ? 'active' : ''}>💫 Phenomena</a></li>
            <li><a href="/vault/category/magazines" class={currentCategory === 'magazines' ? 'active' : ''}>📰 Magazines</a></li>
            <li><a href="/vault/category/books" class={currentCategory === 'books' ? 'active' : ''}>📖 Books</a></li>
            <li><a href="/vault/category/distribution" class={currentCategory === 'distribution' ? 'active' : ''}>📦 Distribution</a></li>
            <li><a href="/vault/category/communities" class={currentCategory === 'communities' ? 'active' : ''}>🌐 Communities</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
    .vault-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    /* Two-column layout */
    .vault-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    @media (min-width: 1024px) {
      .vault-layout {
        grid-template-columns: 1fr 260px;
      }
    }

    .vault-entry {
      min-width: 0;
    }

    /* Header */
    .header {
      margin-bottom: var(--space-6);
    }

    .category-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 2px 8px;
      background: var(--color-surface);
      border: 2px solid var(--color-house-2);
      font-family: var(--font-family-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-house-2);
      margin-bottom: var(--space-4);
      text-decoration: none;
      transition: all var(--transition-base);
    }

    .category-badge:hover {
      transform: translate(-2px, -2px);
      box-shadow: 3px 3px 0 var(--color-house-2);
    }

    .category-icon {
      display: inline-flex;
    }

    .category-name {
      color: var(--color-house-2);
      font-weight: 700;
    }

    .title {
      font-family: var(--font-family-script);
      font-weight: 700;
      font-size: clamp(3.2rem, 8vw, 5.25rem);
      margin: var(--space-2) 0 0;
      line-height: 0.82;
      color: var(--color-text);
    }

    .subtitle {
      font-family: var(--font-family-mono);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--color-text-secondary);
      margin: var(--space-2) 0 0;
    }

    .herorule {
      height: 9px;
      width: 260px;
      max-width: 80%;
      background: var(--color-house);
      position: relative;
      margin: var(--space-3) 0 0;
    }
    .herorule::after {
      content: "";
      position: absolute;
      right: 0; top: 0; bottom: 0;
      width: 24%;
      background: var(--color-house-2);
    }

    /* Summary standfirst — calm italic lead, house accent */
    .provenance {
      margin-top: var(--space-8);
      padding: var(--space-3) var(--space-4);
      border: 1px solid var(--color-border);
      border-left-width: 4px;
      background: var(--color-surface);
    }

    .provenance p {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
    }

    .provenance strong { color: var(--color-text); }

    /* Unchecked is the larger claim on the reader's trust, so it gets the
       stronger rule. Neither state shouts: most of the vault is unchecked, and
       a warning on four pages in five is one nobody reads. */
    .provenance[data-reviewed='false'] { border-left-color: var(--color-house-2); }
    .provenance[data-reviewed='true'] { border-left-color: var(--color-border); }

    .summary-callout {
      position: relative;
      margin: var(--space-5) 0 0;
      padding: 0 0 0 var(--space-4);
    }

    .summary-accent {
      position: absolute;
      left: 0;
      top: 2px;
      bottom: 2px;
      width: 4px;
      background: var(--color-house-2);
    }

    .summary-callout::before,
    .summary-callout::after {
      content: '';
      position: absolute;
      width: 8px;
      height: 8px;
      border-color: color-mix(in oklab, var(--category-color) 40%, var(--color-border) 60%);
      border-style: solid;
    }

    .summary-callout::before {
      top: -1px;
      right: -1px;
      border-width: 1px 1px 0 0;
    }

    .summary-callout::after {
      bottom: -1px;
      right: -1px;
      border-width: 0 1px 1px 0;
    }

    .summary {
      font-size: 1.1rem;
      font-style: italic;
      color: var(--color-text);
      margin: 0;
      line-height: 1.7;
    }

    .summary :global(strong),
    .summary :global(em) {
      color: var(--category-color);
    }

    /* Tags in header (mobile only) */
    .tags-mobile {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    @media (min-width: 1024px) {
      .tags-mobile {
        display: none;
      }
    }

    .tag {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.375rem;
      padding: 0.25rem 0.625rem;
      font-size: 0.8rem;
      line-height: 1.4;
      color: var(--color-text-secondary);
    }

    .tag.platform {
      color: var(--color-primary);
      border-color: color-mix(in oklab, var(--color-primary) 30%, var(--color-border) 70%);
    }
    .tag.tech {
      color: var(--color-accent);
      border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-border) 70%);
    }
    .tag.years {
      color: var(--color-text-secondary);
      font-family: var(--font-family-mono);
      font-size: 0.75rem;
    }

    /* Content — reading-paper panel (warmer than a unit, still legible) */
    .content {
      line-height: 1.72;
      background: radial-gradient(rgb(0 0 0 / 0.018) 1px, transparent 1.5px) 0 0/7px 7px, var(--color-read);
      border: 3px solid var(--color-border);
      box-shadow: var(--shadow-chunky);
      padding: var(--space-8) var(--space-10);
    }

    .content :global(p) {
      margin-bottom: var(--space-4);
      color: var(--color-text);
      max-width: 62ch;
    }

    .content :global(> p:first-of-type)::first-letter {
      font-family: var(--font-family-script);
      font-weight: 700;
      font-size: 4.5rem;
      line-height: 0.66;
      float: left;
      color: var(--color-house-2);
      margin: 8px 18px 4px 2px;
    }

    .content :global(h2) {
      font-weight: 800;
      font-size: 1.3rem;
      margin-top: var(--space-8);
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .content :global(h3) {
      font-size: 1.25rem;
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .content :global(ul),
    .content :global(ol) {
      margin-bottom: var(--space-4);
      padding-left: var(--space-6);
    }

    .content :global(li) {
      margin-bottom: var(--space-2);
    }

    .content :global(blockquote) {
      font-family: var(--font-family-script);
      font-weight: 600;
      font-size: 1.9rem;
      line-height: 1.12;
      color: var(--color-house);
      border-left: 4px solid var(--color-house-2);
      padding: 2px 0 2px 18px;
      margin: var(--space-6) 0;
      max-width: 54ch;
    }

    .content :global(blockquote p) {
      margin: 0;
      max-width: none;
      color: var(--color-house);
    }

    .content :global(pre) {
      background: var(--color-code-bg);
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--color-primary);
      border-radius: 0.5rem;
      padding: var(--space-4);
      overflow-x: auto;
      margin: var(--space-6) 0;
    }

    /* The dark code surface needs its own ink. Highlight-API tokens paint over
       this, so it only shows where a token does not — which is all of an
       unlabelled fence, and the default-coloured runs of every other block. */
    .content :global(pre code) {
      color: var(--color-code-text);
    }

    .content :global(code) {
      font-family: var(--font-family-mono);
      font-size: 0.9em;
    }

    .content :global(:not(pre) > code) {
      background: var(--color-surface);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
      color: var(--color-primary);
    }

    .content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--space-6) 0;
    }

    .content :global(th),
    .content :global(td) {
      padding: var(--space-3);
      border: 1px solid var(--color-border);
      text-align: left;
    }

    .content :global(th) {
      background: var(--color-surface);
      font-weight: 600;
    }

    .content :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .content :global(a:hover) {
      color: var(--color-accent);
    }

    .content :global(strong) {
      color: var(--color-text);
      font-weight: 600;
    }

    /* Sidebar */
    .detail-source {
      flex-basis: 100%;
      text-align: right;
      margin-top: 0.15rem;
      font-size: 0.72rem;
      font-style: normal;
      line-height: 1.35;
      color: var(--color-text-muted, #8a8a8a);
    }

    .detail-source a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-thickness: 1px;
    }

    .detail-source a:hover,
    .detail-source a:focus-visible {
      color: var(--color-text, inherit);
    }

