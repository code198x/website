---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import VaultArticleHeader from '../../components/VaultArticleHeader.astro';
import VaultArticleConnections from '../../components/VaultArticleConnections.astro';
import { colourClashConnections } from '../../data/vault-reading-paths';
import { vaultExploration, vaultFeatures } from '../../data/vault-features';
import { resolveVaultExploration, resolveVaultFeatures } from '../../lib/vault-features';
import { getAllPlatforms } from '../../lib/platforms';
import { getVaultCategories } from '../../lib/categories';
import { getBacklinks } from '../../lib/backlinks';
import { vaultColourGroup } from '../../lib/vault-colours';
import '../../styles/vault.css';
import '../../styles/vault-inner.css';

export async function getStaticPaths() {
  const vaultEntries = await getCollection('vault');

  return vaultEntries.map((entry) => {
    return {
      params: { slug: entry.id },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allVaultEntries = await getCollection('vault');
const connections = [vaultExploration, colourClashConnections].flatMap(selection => resolveVaultExploration(selection, allVaultEntries).connections).filter(connection => connection.from.id === entry.id);
const openingImage = resolveVaultFeatures(vaultFeatures, allVaultEntries).find(feature => feature.article === entry.id)?.images.at(-1);

// Units that cite this entry (IA v3 "Referenced in lessons").
const backlinks = await getBacklinks(`/vault/${entry.id}`);

// Build category lookup from collection
const categoriesData = await getVaultCategories();
const categoryInfo = Object.fromEntries(
  categoriesData.map(c => [c.id, { name: c.data.name, icon: c.data.icon, color: c.data.color }])
);

const category = categoryInfo[entry.data.category] || { name: entry.data.category, icon: 'FileText', color: '#94a3b8' };

// Get current category from slug for browse links
const currentCategory = entry.data.category;

// Resolve canonical system IDs and retain older short-key frontmatter.
const platforms = await getAllPlatforms();
const platformNames = Object.fromEntries([
  ...platforms.map(p => [p.data.shortName.toLowerCase(), p.data.shortName]),
  ...platforms.map(p => [p.id, p.data.name]),
]);

// Titles for every Vault entry, so a `sources[].ref` can be shown as the name of
// the thing rather than a path.
const vaultTitles = new Map(
  (await getCollection('vault')).map((e) => [e.id, e.data.title])
);

const MONTHS = ['January','February','March','April','May','June',
                'July','August','September','October','November','December'];

/**
 * Citations for one frontmatter field, from `sources`.
 *
 * Only what IS sourced gets marked. Flagging what is not would put "unverified"
 * on almost every page — 238 of 239 company entries carry a founding year and
 * one carries a source for it — and a warning that never varies tells a reader
 * nothing. Manufacturing doubt is the same failure as manufacturing certainty.
 * A citation that appears as entries are grounded is a positive signal, and it
 * hands the reader something to check.
 */
function citations(data, fields) {
  const out = [];
  for (const f of fields ?? []) {
    for (const s of data.sources?.[f] ?? []) {
      const name = (s.ref && vaultTitles.get(s.ref)) || s.title || s.ref;
      if (!name) continue;
      // "1985-05" is deliberately a string in the schema: partial dates are not
      // dates, and treating them as one invents a day.
      let when = '';
      if (s.date) {
        const [y, m] = s.date.split('-');
        when = m ? `, ${MONTHS[Number(m) - 1] ?? m} ${y}` : `, ${y}`;
      }
      const issue = s.issue ? `, issue ${s.issue}` : '';
      const rest = `${when}${issue}`;
      // A single source often carries several fields — Companies House gives
      // both the incorporation and the dissolution — and citing it once per
      // field prints "Companies House; Companies House".
      if (out.some((o) => o.name === name && o.rest === rest)) continue;
      out.push({ href: s.ref ? `/vault/${s.ref}` : null, name, rest });
    }
  }
  return out;
}

// Category-specific date fields helper
function getDateDisplay(entry) {
  const cat = entry.data.category;
  const data = entry.data;

  switch (cat) {
    case 'people':
      if (data.born || data.died) {
        // A known death with an unknown birth year is a real state, not a gap
        // to paper over: render it as "Died 2021" rather than "?-2021".
        if (!data.born) return { label: 'Died', value: String(data.died) };
        const died = data.died ? data.died : 'present';
        return { label: 'Lived', value: `${data.born}–${died}` };
      }
      break;
    case 'companies':
    case 'groups':
      if (data.founded || data.ended) {
        const founded = data.founded ?? '?';
        // A missing `ended` is not evidence that a company is still trading.
        // Rendering the range regardless printed "Active: 1980–present" on
        // Acornsoft and 169 others, asserting survival for companies that were
        // wound up decades ago — the same confusion `ended` replaced `dissolved`
        // to fix, running the other way.
        //
        // So absence and null are read as the different things they are:
        //   ended: 1988   an established ending      "Active 1980–1988"
        //   ended: null   established as still going "Active 1979–present"
        //   (absent)      not established            "Founded 1980"
        if (data.ended === undefined) {
          return { label: 'Founded', value: String(founded), fields: ['founded'] };
        }
        const ended = data.ended ? data.ended : 'present';
        // How it ended, where we know: "1984–1988 (acquired)" rather than a
        // bare range that reads as a death for a company that was bought.
        const how = data.ended && data.ended_as ? ` (${data.ended_as})` : '';
        return { label: 'Active', value: `${founded}–${ended}${how}`, fields: ['founded', 'ended'] };
      }
      break;
    case 'games':
    case 'demos':
      if (data.released) {
        return { label: 'Released', value: String(data.released), fields: ['released'] };
      }
      break;
    case 'techniques':
    case 'design':
    case 'technologies':
      if (data.originated || data.deprecated) {
        const originated = data.originated ?? '?';
        const deprecated = data.deprecated ? data.deprecated : 'present';
        return { label: 'Used', value: `${originated}–${deprecated}` };
      }
      break;
    case 'culture':
    case 'phenomena':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Period', value: `${emerged}–${ended}` };
      }
      break;
    case 'events':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Held', value: `${emerged}–${ended}` };
      }
      break;
    case 'magazines':
      if (data.founded || data.ended) {
        const founded = data.founded ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Published', value: `${founded}–${ended}`, fields: ['founded', 'ended'] };
      }
      break;
    case 'books':
      if (data.released) {
        return { label: 'Published', value: String(data.released) };
      }
      break;
    case 'tools':
    case 'languages':
    case 'software':
    case 'emulators':
      if (data.released) {
        return { label: 'Released', value: String(data.released) };
      }
      break;
    case 'genres':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Era', value: `${emerged}–${ended}` };
      }
      break;
    case 'distribution':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Era', value: `${emerged}–${ended}` };
      }
      break;
    case 'communities':
      if (data.emerged || data.ended) {
        const emerged = data.emerged ?? '?';
        const ended = data.ended ? data.ended : 'present';
        return { label: 'Active', value: `${emerged}–${ended}` };
      }
      break;
    case 'hardware':
    case 'systems':
      if (data.introduced || data.discontinued) {
        const introduced = data.introduced ?? '?';
        // As with companies, absence means the ending is not established.
        // Only an explicit null records ongoing production.
        if (data.discontinued === undefined) {
          return { label: 'Introduced', value: String(introduced), fields: ['introduced'] };
        }
        const discontinued = data.discontinued ? data.discontinued : 'present';
        return { label: 'Produced', value: `${introduced}–${discontinued}`, fields: ['introduced', 'discontinued'] };
      }
      break;
  }

  return null;
}

const dateDisplay = getDateDisplay(entry);
const dateCitations = citations(entry.data, dateDisplay?.fields);
const hasTags = (entry.data.platforms?.length > 0) || (entry.data.tags?.length > 0) || dateDisplay;

// Build custom breadcrumbs with proper title
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'The Vault', href: '/vault' },
  { label: category.name, href: `/vault/category/${entry.data.category}` },
  { label: entry.data.title }
];
---

<Layout title={entry.data.title} description={entry.data.summary} breadcrumbs={breadcrumbs} noindex={!entry.data.reviewed}>
  <div class="vault-container vault-article" data-vault-colour={vaultColourGroup(entry.data.category)}>
    <VaultArticleHeader title={entry.data.title} subtitle={entry.data.subtitle} summary={entry.data.summary} category={{name: category.name, slug: entry.data.category}} reviewed={entry.data.reviewed} image={openingImage} imageDetailHref={entry.id === 'techniques/colour-clash' ? '#what-clash-looks-like' : undefined} />
    <div class="vault-layout">
      <aside class="vault-contents" aria-label="Article contents">
        <h2>On this page</h2>
        <TableOfContents selector=".vault-entry .content" platformColor="var(--vault-category-ink)" />
      </aside>
      <article class="vault-entry">
        <div class="content">
          <Content />
        </div>

        <VaultArticleConnections connections={connections} />

        <footer id="article-status" class="provenance" data-reviewed={entry.data.reviewed ? 'true' : 'false'}>
          {entry.data.reviewed ? (
            /* Deliberately says nothing about who drafted the entry. The
               ai_generated flag is not reliable in its `false` state — entries
               marked as human-written include AI-drafted ones — so claiming
               human authorship here stated something we cannot stand behind.
               What we can stand behind is that a person checked it. */
            <p>
              <strong>Checked.</strong> Verified against primary sources and
              signed off by a person.
            </p>
          ) : (
            <p>
              <strong>Not yet fact-checked.</strong> This entry was drafted by an
              AI and nobody has verified it. The dates, figures and technical
              details may be wrong. Use it to find your bearings, then confirm
              anything that matters against a primary source.
            </p>
          )}
        </footer>
      </article>

      <aside class="vault-sidebar">
        {hasTags && (
          <div class="sidebar-section">
            <h4 class="sidebar-title">Details</h4>
            {dateDisplay && (
              <div class="sidebar-detail">
                <span class="detail-label">{dateDisplay.label}</span>
                <span class="detail-value">{dateDisplay.value}</span>
                {dateCitations.length > 0 && (
                  <cite class="detail-source">
                    {dateCitations.map((c, i) => (
                      <>
                        {i > 0 && '; '}
                        {c.href ? <a href={c.href}>{c.name}</a> : c.name}{c.rest}
                      </>
                    ))}
                  </cite>
                )}
              </div>
            )}
            {entry.data.platforms?.length > 0 && (
              <div class="sidebar-detail">
                <span class="detail-label">Platforms</span>
                <span class="detail-value">{entry.data.platforms.map(p => platformNames[p] || p).join(', ')}</span>
              </div>
            )}
            {entry.data.tags?.length > 0 && (
              <div class="sidebar-tags">
                {entry.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            )}
          </div>
        )}

        {backlinks.length > 0 && (
          <div class="sidebar-section">
            <h4 class="sidebar-title">Referenced in lessons</h4>
            <ul class="refs">
              {backlinks.map(b => (
                <li><a href={b.url}>{b.title}<span class="ref-url">{b.url}</span></a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="sidebar-section article-browse">
          <h4 class="sidebar-title">Keep exploring</h4>
          <a href={`/vault/category/${currentCategory}`}>All {category.name.toLowerCase()} articles ↗</a>
          <a href="/vault/">Browse the Vault ↗</a>
        </div>

      </aside>
    </div>
  </div>
</Layout>

<style>@layer blocks {
    .vault-container {
      max-width: var(--site-frame-width);
      margin: 0 auto;
      padding: var(--h-space-8) var(--gutter);
    }

    /* Two-column layout */
    .vault-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--h-space-8);
    }

    @media (min-width: 1024px) {
      .vault-layout {
        grid-template-columns: 1fr 260px;
      }
    }

    .vault-entry {
      min-width: 0;
    }

    /* Header */
    .header {
      margin-bottom: var(--h-space-6);
    }

    .title {
      font-family: var(--h-font-ui);
      font-weight: 700;
      font-size: clamp(3rem, 8vw, var(--h-text-display));
      margin: var(--h-space-2) 0 0;
      line-height: 0.82;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
      color: var(--h-ink);
    }

    .subtitle {
      font-family: var(--h-font-ui);
      font-size: 0.8125rem;
      font-weight: 400;
      letter-spacing: normal;
      color: var(--h-ink-muted);
      margin: var(--h-space-2) 0 0;
    }

    .herorule {
      height: 9px;
      width: 260px;
      max-width: 80%;
      background: var(--h-spot-ink);
      position: relative;
      margin: var(--h-space-3) 0 0;
    }
    .herorule::after {
      content: "";
      position: absolute;
      right: 0; top: 0; bottom: 0;
      width: 24%;
      background: var(--h-spot-ink);
    }

    /* Summary standfirst — calm italic lead, house accent */
    .provenance {
      margin-top: var(--h-space-8);
      padding: var(--h-space-3) var(--h-space-4);
      border: 1px solid var(--h-line);
      border-left-width: 1px;
      background: var(--h-ground);
    }

    .provenance p {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--h-ink-muted);
    }

    .provenance strong { color: var(--h-ink); }

    /* Unchecked is the larger claim on the reader's trust, so it gets the
       stronger rule. Neither state shouts: most of the vault is unchecked, and
       a warning on four pages in five is one nobody reads. */
    .provenance[data-reviewed='false'] { border-left-color: var(--h-spot-ink); }
    .provenance[data-reviewed='true'] { border-left-color: var(--h-line); }

    .summary {
      font-size: 1.1rem;
      font-style: italic;
      color: var(--h-ink);
      margin: 0;
      line-height: 1.7;
    }

    /* Emphasis in the summary is set in the heading ink. The category colour
       is a raw declared value (Classic Games #34d399 measured 1.61:1 on the
       light ground) and a category takes a mark, not a hue
       (family-visual-identity.md §7). */
    .summary :global(strong), .summary :global(em) {
      color: var(--h-ink);
    }

    .tag {
      background: var(--h-ground);
      border: 1px solid var(--h-line);
      border-radius: 0.375rem;
      padding: 0.25rem 0.625rem;
      font-size: 0.8rem;
      line-height: 1.4;
      color: var(--h-ink-muted);
    }

    .tag.platform {
      color: var(--h-spot);
      border-color: color-mix(in oklab, var(--h-spot) 30%, var(--h-line) 70%);
    }
    .tag.tech {
      color: var(--h-ink);
      border-color: color-mix(in oklab, var(--h-ink) 30%, var(--h-line) 70%);
    }
    .tag.years {
      color: var(--h-ink-muted);
      font-family: var(--h-font-ui);
      font-size: 0.8125rem; font-weight: 600; }

    /* Content — reading-paper panel (warmer than a unit, still legible) */
    .content {
      line-height: var(--h-lh-body);
      background: radial-gradient(rgb(0 0 0 / 0.018) 1px, transparent 1.5px) 0 0/7px 7px, var(--h-page);
      border: 3px solid var(--h-line);
      padding: var(--h-space-8) var(--space-10);
    }

    .content :global(p) {
      margin-bottom: var(--h-space-4);
      color: var(--h-ink);
      max-width: 62ch;
      font-family: var(--h-font-ui);
      font-size: var(--h-text-body);
      line-height: var(--h-lh-body);
    }

    .content :global(h2) {
      font-weight: 800;
      font-size: var(--h-text-h3);
      line-height: var(--h-lh-h3);
      letter-spacing: var(--h-tr-h3);
      margin-top: var(--h-space-8);
      margin-bottom: var(--h-space-3);
      color: var(--h-ink);
    }

    .content :global(h3) {
      font-size: var(--h-text-h4);
      line-height: var(--h-lh-h4);
      letter-spacing: var(--h-tr-h4);
      margin-top: var(--h-space-6);
      margin-bottom: var(--h-space-3);
      color: var(--h-ink);
    }

    .content :global(ul), .content :global(ol) {
      margin-bottom: var(--h-space-4);
      padding-left: var(--h-space-6);
    }

    .content :global(li) {
      margin-bottom: var(--h-space-2);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-body);
      line-height: var(--h-lh-body);
    }

    .content :global(blockquote) {
      font-family: var(--h-font-ui);
      font-weight: 600;
      font-size: var(--h-text-h3);
      line-height: var(--h-lh-h3);
      color: var(--h-ink);
      border-left: 1px solid var(--h-spot-ink);
      padding: 2px 0 2px 18px;
      margin: var(--h-space-6) 0;
      max-width: 54ch;
    }

    .content :global(blockquote p) {
      margin: 0;
      max-width: none;
      color: var(--h-ink);
      font: inherit;
    }

    .content :global(pre) {
      background: var(--color-code-bg);
      border: 1px solid var(--h-line);
      border-left: 1px solid var(--h-spot);
      border-radius: 0.5rem;
      padding: var(--h-space-4);
      overflow-x: auto;
      margin: var(--h-space-6) 0;
    }

    /* The dark code surface needs its own ink. Highlight-API tokens paint over
       this, so it only shows where a token does not — which is all of an
       unlabelled fence, and the default-coloured runs of every other block. */
    .content :global(pre code) {
      color: var(--color-code-text);
    }

    .content :global(code) {
      font-family: var(--h-font-mono);
      font-size: 0.9em;
    }

    .content :global(:not(pre) > code) {
      background: var(--h-ground);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
      color: var(--h-spot);
    }

    .content :global(th) {
      padding: var(--h-space-3);
      border: 1px solid var(--h-line);
      text-align: left;
    }

    .content :global(th) {
      background: var(--h-ground);
      font-weight: 600;
    }

    .content :global(a) {
      color: var(--h-spot);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .content :global(a:hover) {
      color: var(--h-ink);
    }

    .content :global(strong) {
      color: var(--h-ink);
      font-weight: 600;
    }

    /* Sidebar */
    .detail-source {
      flex-basis: 100%;
      text-align: right;
      margin-top: 0.15rem;
      font-size: 0.72rem;
      font-style: normal;
      line-height: 1.35;
      color: var(--h-ink-muted);
    }

    .detail-source a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-thickness: 1px;
    }

    .detail-source a:hover, .detail-source a:focus-visible {
      color: var(--h-ink);
    }

    .vault-sidebar {
      display: none;
    }

    @media (min-width: 1024px) {
      .vault-sidebar {
        display: block;
        position: sticky;
        top: calc(var(--h-space-4));
        max-height: calc(100vh - var(--h-space-8));
        overflow-y: auto;
      }
    }

    .sidebar-section {
      margin-bottom: var(--h-space-6);
      padding-bottom: var(--h-space-6);
      border-bottom: 1px solid var(--h-line);
    }

    .sidebar-section:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .sidebar-title {
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: none;
      letter-spacing: normal;
      color: var(--h-ink-muted);
      margin: 0 0 var(--h-space-3) 0;
    font-family: var(--h-font-ui);
  }

    .refs { list-style: none; margin: 0; padding: 0; }
    .refs li { padding: var(--h-space-2) 0; border-bottom: 1px dashed var(--h-line); }
    .refs li:last-child { border-bottom: 0; }
    .refs a { display: block; font-size: 0.85rem; font-weight: 600; color: var(--h-ink); text-decoration: none; }
    .refs a:hover { color: var(--h-spot-ink); }
    .ref-url { display: block; font-family: var(--h-font-mono); font-size: 0.62rem; color: var(--h-ink-muted); margin-top: 2px; word-break: break-all; }

    .sidebar-detail {
      display: flex;
      /* Wraps so a citation can take a full-width line of its own beneath the
         value it supports, instead of becoming a third item competing for the
         row with space-between. */
      flex-wrap: wrap;
      justify-content: space-between;
      font-size: 0.875rem;
      margin-bottom: var(--h-space-2);
    }

    .detail-label {
      color: var(--h-ink-muted);
    }

    .detail-value {
      color: var(--h-ink);
      font-weight: 500;
      text-align: right;
    }

    .sidebar-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--h-space-2);
      margin-top: var(--h-space-3);
    }

    .sidebar-tags .tag {
      font-size: 0.75rem;
    }

    @media (max-width: 768px) {
      .vault-container { padding: var(--h-space-6) var(--gutter); }
    }
}
@layer legacy {
/* Still in legacy: each rule here beats a rule in another legacy stylesheet
   by weight, so it moves to blocks when that one does. */

    .content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--h-space-6) 0;
    }

    .content :global(td) {
      padding: var(--h-space-3);
      border: 1px solid var(--h-line);
      text-align: left;
    }
    }
</style>
