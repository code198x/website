---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const vaultEntries = await getCollection('vault');

  return vaultEntries.map((entry) => {
    // Use nested URL structure: /vault/category/slug
    return {
      params: { slug: entry.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Category display names and icons
const categoryInfo = {
  people: { name: 'People', icon: '👾' },
  companies: { name: 'Companies', icon: '🏢' },
  games: { name: 'Games', icon: '🎮' },
  techniques: { name: 'Techniques', icon: '⚙️' },
  hardware: { name: 'Hardware', icon: '🔧' },
  systems: { name: 'Systems', icon: '💾' },
  culture: { name: 'Culture', icon: '📚' },
};

const category = categoryInfo[entry.data.category] || { name: entry.data.category, icon: '📄' };

// Convert platforms to display names
const platformNames = {
  c64: 'C64',
  spectrum: 'ZX Spectrum',
  amiga: 'Amiga',
  nes: 'NES',
};
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="vault-entry">
    <a href="/vault" class="back-link">← Back to The Vault</a>

    <header class="header">
      <div class="category-badge">
        <span class="category-icon">{category.icon}</span>
        <span class="category-name">{category.name}</span>
      </div>

      <h1 class="title">{entry.data.title}</h1>
      {entry.data.subtitle && <h2 class="subtitle">{entry.data.subtitle}</h2>}
      {entry.data.summary && <p class="summary">{entry.data.summary}</p>}

      <div class="tags">
        {entry.data.platforms?.map((p) => (
          <span class="tag platform">{platformNames[p] || p}</span>
        ))}
        {entry.data.tags?.map((t) => (
          <span class="tag tech">{t}</span>
        ))}
        {entry.data.years && entry.data.years.length > 0 && (
          <span class="tag years">{entry.data.years[0]}–{entry.data.years[entry.data.years.length - 1]}</span>
        )}
      </div>
    </header>

    <div class="content">
      <Content />
    </div>
  </article>

  <style>
    .vault-entry {
      max-width: 820px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-5);
    }

    .back-link {
      display: inline-block;
      margin-bottom: var(--space-4);
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--color-primary); }

    .category-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      font-size: 0.85rem;
      margin-bottom: var(--space-4);
    }

    .category-icon {
      font-size: 1rem;
    }

    .category-name {
      color: var(--color-text-secondary);
      font-weight: 500;
    }

    .title {
      margin: 0 0 var(--space-1) 0;
      line-height: 1.1;
    }

    .subtitle {
      font-weight: 500;
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-2) 0;
    }

    .summary {
      font-style: italic;
      color: var(--color-text-muted);
      margin: 0 0 var(--space-4) 0;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-5);
    }

    .tag {
      background: color-mix(in oklab, var(--color-surface) 85%, var(--color-bg) 15%);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: 0.2rem 0.6rem;
      font-size: 0.8rem;
      line-height: 1.4;
    }

    .tag.platform { color: var(--color-primary); }
    .tag.tech { color: var(--color-accent); }
    .tag.years { color: var(--color-text-muted); }

    .content :global(p) { margin-bottom: var(--space-4); }
    .content :global(h2, h3) { margin-top: var(--space-6); }
    .content :global(blockquote) {
      border-left: 3px solid var(--color-border);
      padding-left: var(--space-3);
      color: var(--color-text-secondary);
      margin: var(--space-4) 0;
    }

    .content :global(pre) {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-4);
      overflow-x: auto;
      margin: var(--space-4) 0;
    }

    .content :global(code) {
      font-family: var(--font-family-mono);
      font-size: 0.9em;
    }

    .content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: var(--space-4) 0;
    }

    .content :global(th),
    .content :global(td) {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      text-align: left;
    }

    .content :global(th) {
      background: var(--color-surface);
      font-weight: 600;
    }

    .content :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
    }

    .content :global(a:hover) {
      color: var(--color-accent);
    }

    @media (max-width: 768px) {
      .vault-entry { padding: var(--space-6) var(--space-4); }
    }
  </style>
</Layout>
