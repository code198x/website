---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'drivers');
---

<VaultCategoryLayout
  title="Drivers - The Vault"
  description="Explore essential drivers that enabled hardware functionality and system compatibility in classic computing."
  heroTitle="Drivers"
  heroSubtitle="System software that bridged hardware and applications"
  heroDescription={`Explore ${categoryData.length} essential drivers that enabled hardware functionality and system compatibility in classic computing.`}
  heroIcon="⚙️"
  heroColor="#6b7280"
  categorySlug="drivers"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Drivers Collection"
  infoDescription="This collection documents the system-level software that enabled hardware functionality on classic computing platforms. These drivers were essential for printer support, sound cards, graphics accelerators, and other peripherals."
  stats={[
    {
      label: "Printer",
      value: 0,
      filter: (d) => d.t === 'printer'
    },
    {
      label: "Graphics",
      value: 0,
      filter: (d) => d.t === 'graphics'
    },
    {
      label: "Sound",
      value: 0,
      filter: (d) => d.t === 'sound'
    },
    {
      label: "Storage",
      value: 0,
      filter: (d) => d.t === 'storage'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a driver we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

