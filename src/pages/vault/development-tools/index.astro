---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'development-tools');
---

<VaultCategoryLayout
  title="Development Tools - The Vault"
  description="Explore essential development tools that enabled programmers to create the software and games of the golden age."
  heroTitle="Development Tools"
  heroSubtitle="Compilers, assemblers, and IDEs that powered creativity"
  heroDescription={`Explore ${categoryData.length} essential development tools that enabled programmers to create the software and games of the golden age.`}
  heroIcon="🔧"
  heroColor="#ec4899"
  categorySlug="development-tools"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Development Tools Collection"
  infoDescription="This collection documents the compilers, assemblers, debuggers, and integrated development environments that enabled programmers to create software for classic systems. Each entry includes technical details, supported platforms, and historical significance."
  stats={[
    {
      label: "Compilers",
      value: 0,
      filter: (d) => d.t === 'compiler'
    },
    {
      label: "Assemblers",
      value: 0,
      filter: (d) => d.t === 'assembler'
    },
    {
      label: "Debuggers",
      value: 0,
      filter: (d) => d.t === 'debugger'
    },
    {
      label: "IDEs",
      value: 0,
      filter: (d) => d.t === 'ide'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about a development tool we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

