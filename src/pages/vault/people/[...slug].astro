---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("people");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - People`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from the golden age of computing.`}
  entry={entry}
  categorySlug="people"
  categoryName="People"
  categoryIcon="👤"
  categoryColor="#10b981"
/>