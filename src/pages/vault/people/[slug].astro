---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((person) => ({
    params: { slug: person.slug },
  }));
}

const person = await getEntry("people", Astro.params.slug);
if (!person) {
    throw new Error(`Person not found: ${Astro.params.slug}`);
}

const { Content } = await render(person);

// Format dates for display
const formatDate = (date: Date | string | undefined) => {
  if (!date) return null;
  const dateObj = typeof date === 'string' ? new Date(date) : date;
  return dateObj.toLocaleDateString('en-GB', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

const birthDate = formatDate(person.data.birth_date);
const deathDate = formatDate(person.data.death_date);
---

<Layout title={`${person.data.name} - People - The Vault - Code Like It's 198x`}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <a href="/vault" class="text-blue-600 hover:underline">The Vault</a>
      <span class="mx-2">/</span>
      <a href="/vault/people" class="text-blue-600 hover:underline">People</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">{person.data.name}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{person.data.name}</h1>
      
      <div class="bg-gray-50 rounded-lg p-6 mb-6">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Personal Details</h2>
            <dl class="space-y-2 text-sm">
              {birthDate && (
                <div class="flex">
                  <dt class="font-medium text-gray-600 w-20">Born:</dt>
                  <dd class="text-gray-800">{birthDate}</dd>
                </div>
              )}
              {deathDate && (
                <div class="flex">
                  <dt class="font-medium text-gray-600 w-20">Died:</dt>
                  <dd class="text-gray-800">{deathDate}</dd>
                </div>
              )}
              <div class="flex">
                <dt class="font-medium text-gray-600 w-20">Nationality:</dt>
                <dd class="text-gray-800">{person.data.nationality}</dd>
              </div>
            </dl>
          </div>
          
          <div>
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Professional</h2>
            <dl class="space-y-2 text-sm">
              <div>
                <dt class="font-medium text-gray-600 mb-1">Occupation:</dt>
                <dd class="text-gray-800">
                  {person.data.occupation.join(', ')}
                </dd>
              </div>
              {person.data.companies_founded && person.data.companies_founded.length > 0 && (
                <div>
                  <dt class="font-medium text-gray-600 mb-1">Founded:</dt>
                  <dd class="text-gray-800">
                    {person.data.companies_founded.join(', ')}
                  </dd>
                </div>
              )}
              {person.data.companies_worked_for && person.data.companies_worked_for.length > 0 && (
                <div>
                  <dt class="font-medium text-gray-600 mb-1">Worked for:</dt>
                  <dd class="text-gray-800">
                    {person.data.companies_worked_for.join(', ')}
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </div>

        {person.data.notable_contributions && person.data.notable_contributions.length > 0 && (
          <div class="mt-6">
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Notable Contributions</h2>
            <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
              {person.data.notable_contributions.map((contribution) => (
                <li>{contribution}</li>
              ))}
            </ul>
          </div>
        )}

        {person.data.awards && person.data.awards.length > 0 && (
          <div class="mt-6">
            <h2 class="text-lg font-semibold mb-3 text-gray-800">Awards & Recognition</h2>
            <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
              {person.data.awards.map((award) => (
                <li>{award}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </header>

    <article class="prose prose-lg max-w-none">
      <Content />
    </article>

    {person.data.external_links && person.data.external_links.length > 0 && (
      <div class="mt-8 p-6 bg-blue-50 rounded-lg">
        <h2 class="text-lg font-semibold mb-4">External Resources</h2>
        <ul class="space-y-2">
          {person.data.external_links.map((link) => (
            <li>
              <a 
                href={link.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-blue-600 hover:text-blue-800 underline"
              >
                {link.title} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </main>
</Layout>