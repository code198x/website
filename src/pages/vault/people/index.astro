---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just people entries
const peopleData = vaultData.filter(entry => entry.c === 'people');
---

<VaultCategoryLayout
  title="People - The Vault"
  description={`Discover ${peopleData.length} influential figures who created the hardware, software, and culture of the golden age of computing.`}
  heroTitle="People"
  heroSubtitle="Pioneers, programmers, and visionaries who shaped computing history"
  heroDescription={`Discover ${peopleData.length} influential figures who created the hardware, software, and culture of the golden age of computing.`}
  heroIcon="👤"
  heroColor="#10b981"
  categorySlug="people"
  categoryData={peopleData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={false}
  showStatusFilter={true}
  infoTitle="About the People Collection"
  infoDescription="This collection celebrates the individuals who drove innovation in computing. From hardware engineers to game designers, from business leaders to demo scene legends, these are the people who made computing history."
  stats={[
    { label: "Engineers", value: 0, filter: (p) => p.t === 'engineer' },
    { label: "Executives", value: 0, filter: (p) => p.t === 'executive' },
    { label: "Designers", value: 0, filter: (p) => p.t === 'designer' },
    { label: "Programmers", value: 0, filter: (p) => p.t === 'programmer' }
  ]}
/>