---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just people entries
const peopleData = vaultData.filter(entry => entry.c === 'people');
---

<Layout title="People - The Vault">
  <Hero
    title="People Collection"
    subtitle="Pioneers, programmers, and visionaries who shaped computing history"
    description={`Discover ${peopleData.length} influential figures who created the hardware, software, and culture of the golden age of computing.`}
    variant="gradient"
    badge={{
      text: "👤 People Collection",
      color: "#10b981"
    }}
  />

  <div class="people-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={peopleData}
        placeholder="Search people by name, role, company, or contributions..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={false}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the People Collection</h2>
        <p>
          This collection celebrates the individuals who drove innovation in computing.
          From hardware engineers to game designers, from business leaders to demo scene
          legends, these are the people who made computing history.
        </p>

        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">{peopleData.filter(p => p.t === 'engineer').length}</span>
            <span class="stat-label">Engineers</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{peopleData.filter(p => p.t === 'executive').length}</span>
            <span class="stat-label">Executives</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{peopleData.filter(p => p.t === 'designer').length}</span>
            <span class="stat-label">Designers</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{peopleData.filter(p => p.t === 'programmer').length}</span>
            <span class="stat-label">Programmers</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .people-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .stat-card {
    background: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: bold;
    color: #10b981;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-secondary);
  }

  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .stat-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>