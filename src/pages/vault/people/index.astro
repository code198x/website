---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import AlphabeticalList from "../../../components/AlphabeticalList.astro";
import { sortAlphabetically, groupByFirstLetter } from "../../../utils/helpers";

const people = await getCollection("people");
const groupedPeople = groupByFirstLetter(people.sort(sortAlphabetically));
---

<Layout title="People - The Vault - Code Like It's 198x">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2">People</h1>
    <p class="text-xl text-gray-600 mb-8">
      The engineers, entrepreneurs, and visionaries who created the technology that defined computing.
    </p>

    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <a href="/vault" class="text-blue-600 hover:underline">The Vault</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">People</span>
    </nav>

    <AlphabeticalList title="People" groupedItems={groupedPeople} baseUrl="/vault/people" />
  </main>
</Layout>