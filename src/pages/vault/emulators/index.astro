---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'emulators');
---

<VaultCategoryLayout
  title="Emulators - The Vault"
  description="Explore emulators that keep classic systems alive for future generations."
  heroTitle="Emulators"
  heroSubtitle="Preserving computing history through accurate hardware simulation"
  heroDescription={`Explore ${categoryData.length} emulators that keep classic systems alive for future generations.`}
  heroIcon="💾"
  heroColor="#8b5cf6"
  categorySlug="emulators"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Emulators Collection"
  infoDescription="Emulation is digital archaeology - preserving not just software but the entire experience of historic computing platforms. These emulators range from cycle-accurate recreations to practical tools for running classic software on modern hardware."
>
  <div class="feature-list">
    <h3>Why Emulation Matters</h3>
    <ul>
      <li>Preserves software that would otherwise be lost to hardware failure</li>
      <li>Enables development for classic systems using modern tools</li>
      <li>Documents the exact behavior of historic hardware</li>
      <li>Makes computing history accessible to new generations</li>
    </ul>
  </div>
</VaultCategoryLayout>

