---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";

// Filter to just emulators entries
const emulatorsData = vaultData.filter(entry => entry.c === 'emulators');
---

<Layout title="Emulators - The Vault">
  <Hero
    title="Emulators Collection"
    subtitle="Preserving computing history through accurate hardware simulation"
    description={`Explore ${emulatorsData.length} emulators that keep classic systems alive for future generations.`}
    variant="gradient"
    badge={{
      text: "💾 Emulators Collection",
      color: "#8b5cf6"
    }}
  />

  <div class="emulators-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={emulatorsData}
        placeholder="Search emulators by name, platform, or features..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="info-section">
        <h2>About the Emulators Collection</h2>
        <p>
          Emulation is digital archaeology - preserving not just software but the entire
          experience of historic computing platforms. These emulators range from cycle-accurate
          recreations to practical tools for running classic software on modern hardware.
        </p>

        <div class="feature-list">
          <h3>Why Emulation Matters</h3>
          <ul>
            <li>Preserves software that would otherwise be lost to hardware failure</li>
            <li>Enables development for classic systems using modern tools</li>
            <li>Documents the exact behavior of historic hardware</li>
            <li>Makes computing history accessible to new generations</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .emulators-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .info-section {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .feature-list {
    margin-top: 2rem;
  }

  .feature-list h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .feature-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-list li {
    padding: 0.75rem 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
    border-bottom: 1px solid var(--color-border);
  }

  .feature-list li:last-child {
    border-bottom: none;
  }

  .feature-list li::before {
    content: "→";
    margin-right: 0.75rem;
    color: #8b5cf6;
    font-weight: bold;
  }

  :global(.dark-mode) .info-section {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .feature-list li {
    border-color: rgba(255, 255, 255, 0.1);
  }
</style>