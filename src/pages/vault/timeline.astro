---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import InteractiveTimeline from "../../components/InteractiveTimeline.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { generateVaultBreadcrumbs } from "../../utils/breadcrumbs";
import { getCollection } from 'astro:content';
import { buildTimelineEvents, getTimelineCategoryStyles } from "../../utils/timeline";

// Pull from all content collections
const collections = {
  hardware: await getCollection('hardware'),
  people: await getCollection('people'),
  companies: await getCollection('companies'),
  events: await getCollection('events'),
  games: await getCollection('games'),
  demos: await getCollection('demos'),
  operatingSystems: await getCollection('operating-systems'),
  programmingLanguages: await getCollection('programming-languages'),
  publications: await getCollection('publications'),
  groups: await getCollection('groups'),
  applications: await getCollection('applications'),
  developmentTools: await getCollection('development-tools'),
  utilities: await getCollection('utilities'),
  emulators: await getCollection('emulators'),
  techniques: await getCollection('techniques'),
  formats: await getCollection('formats'),
  culture: await getCollection('culture')
};

// Build timeline events using the utility
const timelineEvents = buildTimelineEvents(collections);

// Get category styles
const { colors: categoryColors, icons: categoryIcons } = getTimelineCategoryStyles();
---

<Layout title="Timeline">
  <Hero
    title="Computing Timeline"
    subtitle="Journey Through the Golden Age"
    description="Explore the key moments that shaped home computing, from the first microprocessors to the rise of 16-bit machines."
    variant="gradient"
    badge={{
      text: "📅 Historical Archive",
      color: "#06b6d4"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs()} />

      <!-- Interactive Timeline Component -->
      <InteractiveTimeline
        timelineData={timelineEvents}
        categoryColors={categoryColors}
        categoryIcons={categoryIcons}
      />
    </div>
  </div>
</Layout>