});

// Add techniques
techniques.forEach(tech => {
  if (tech.data.year) {
    const existing = timelineEvents.find(e => e.year === tech.data.year);
    const event = {
      month: "",
      title: `${tech.data.name} Discovered`,
      category: "techniques",
      description: tech.data.description,
      type: "innovation",
      link: tech.data.status === 'available' ? `/vault/techniques/${tech.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: tech.data.year,
        events: [event]
      });
    }
  }
});

// Add formats
formats.forEach(fmt => {
  if (fmt.data.year) {
    const existing = timelineEvents.find(e => e.year === fmt.data.year);
    const event = {
      month: "",
      title: `${fmt.data.name} Introduced`,
      category: "formats",
      description: fmt.data.description,
      type: "standard",
      link: fmt.data.status === 'available' ? `/vault/formats/${fmt.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: fmt.data.year,
        events: [event]
      });
    }
  }
});

// Add drivers
drivers.forEach(driver => {
  if (driver.data.year) {
    const existing = timelineEvents.find(e => e.year === driver.data.year);
    const event = {
      month: "",
      title: `${driver.data.name} Released`,
      category: "drivers",
      description: driver.data.description,
      type: "release",
      link: driver.data.status === 'available' ? `/vault/drivers/${driver.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: driver.data.year,
        events: [event]
      });
    }
  }
});

// Add utilities
utilities.forEach(util => {
  if (util.data.year) {
    const existing = timelineEvents.find(e => e.year === util.data.year);
    const event = {
      month: "",
      title: `${util.data.name} Released`,
      category: "utilities",
      description: util.data.description,
      type: "release",
      link: util.data.status === 'available' ? `/vault/utilities/${util.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: util.data.year,
        events: [event]
      });
    }
  }
});

// Add plugins
plugins.forEach(plugin => {
  if (plugin.data.year) {
    const existing = timelineEvents.find(e => e.year === plugin.data.year);
    const event = {
      month: "",
      title: `${plugin.data.name} Released`,
      category: "plugins",
      description: plugin.data.description,
      type: "release",
      link: plugin.data.status === 'available' ? `/vault/plugins/${plugin.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: plugin.data.year,
        events: [event]
      });
    }
  }
});

// Add cultural movements
culture.forEach(cult => {
  // Culture uses period.start instead of year
  if (cult.data.period && cult.data.period.start) {
    const year = cult.data.period.start;
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: "",
      title: cult.data.name,
      category: "culture",
      description: cult.data.description,
      type: "movement",
      link: cult.data.status === 'available' ? `/vault/culture/${cult.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }

  // Also add end date if the movement ended
  if (cult.data.period && cult.data.period.end) {
    const year = cult.data.period.end;
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: "",
      title: `${cult.data.name} Ends`,
      category: "culture",
      description: `End of ${cult.data.name}`,
      type: "closure",
      link: cult.data.status === 'available' ? `/vault/culture/${cult.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Add events
events.forEach(evt => {
  if (evt.data.date) {
    const year = new Date(evt.data.date).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(evt.data.date).toLocaleDateString('en-US', { month: 'long' }),
      title: evt.data.name,
      category: "events",
      description: evt.data.description,
      type: "event",
      link: evt.data.status === 'available' ? `/vault/events/${evt.slug || evt.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Merge with mock data for demonstration
if (timelineEvents.length === 0) {
  // If no real data yet, use mock data
  timelineEvents.push(...mockTimelineEvents);
} else {
  // Merge mock data for years not covered by real data
  mockTimelineEvents.forEach(mockYear => {
    const existingYear = timelineEvents.find(e => e.year === mockYear.year);
    if (!existingYear) {
      timelineEvents.push(mockYear);
    }
  });
}

// Sort by year and then by month within each year
timelineEvents.sort((a, b) => a.year - b.year);
timelineEvents.forEach(yearGroup => {
  yearGroup.events.sort((a: any, b: any) => {
    // Sort by month if available
    const months = ["January", "February", "March", "April", "May", "June",
                   "July", "August", "September", "October", "November", "December"];
    const aIndex = months.indexOf(a.month) !== -1 ? months.indexOf(a.month) : 99;
    const bIndex = months.indexOf(b.month) !== -1 ? months.indexOf(b.month) : 99;
    return aIndex - bIndex;
  });
});

const categoryColors: Record<string, string> = {
  hardware: "blue",
  people: "green",
  companies: "purple",
  games: "orange",
  demos: "cyan",
  "operating-systems": "slate",
  "programming-languages": "emerald",
  applications: "amber",
  "development-tools": "rose",
  drivers: "stone",
  utilities: "teal",
  plugins: "fuchsia",
  emulators: "violet",
  techniques: "red",
  publications: "indigo",
  events: "pink",
  groups: "teal",
  formats: "orange",
  culture: "cyan",
  projects: "lime",
  software: "amber" // fallback for old mock data
};

// Icon mapping for categories
const categoryIcons: Record<string, string> = {
  hardware: "🖥️",
  people: "👤",
  companies: "🏢",
  games: "🎮",
  demos: "🎬",
  "operating-systems": "💻",
  "programming-languages": "📝",
  applications: "💼",
  "development-tools": "🔧",
  drivers: "⚙️",
  utilities: "🛠️",
  plugins: "🧩",
  emulators: "🔄",
  techniques: "⚡",
  publications: "📖",
  events: "🎪",
  groups: "👥",
  formats: "💾",
  culture: "🌟",
  projects: "🎯",
  software: "💾" // fallback for old mock data
};
---

<Layout title="Timeline">
  <Hero
    title="Computing Timeline"
    subtitle="Journey Through the Golden Age"
    description="Explore the key moments that shaped home computing, from the first microprocessors to the rise of 16-bit machines."
    variant="gradient"
    badge={{
      text: "📅 Historical Archive",
      color: "#06b6d4"
    }}
  />

  <div class="timeline-container">
    <div class="container">
      <div class="timeline">
        {timelineEvents.map((yearGroup) => (
          <div class="timeline-year">
            <div class="timeline-year-marker">
              <span class="year-label">{yearGroup.year}</span>
            </div>
            <div class="timeline-events">
