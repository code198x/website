});

// Add operating systems
operatingSystems.forEach(os => {
  if (os.data.year) {
    const existing = timelineEvents.find(e => e.year === os.data.year);
    const event = {
      month: "",
      title: `${os.data.name} Released`,
      category: "operating-systems",
      description: os.data.description,
      type: "release",
      link: os.data.status === 'available' ? `/vault/operating-systems/${os.id}` : undefined
    };

    if (existing) {
