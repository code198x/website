// Build timeline events from collections
const timelineEvents: any[] = [];

// Add hardware releases
hardware.forEach(item => {
  if (item.data.year) {
    const existing = timelineEvents.find(e => e.year === item.data.year);
    const event = {
      month: "",
      title: `${item.data.name} Released`,
      category: "hardware",
      description: item.data.description,
      type: "release",
      link: item.data.status === 'available' ? `/vault/hardware/${item.slug || item.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: item.data.year,
        events: [event]
      });
    }
  }
});

// Add people births
people.forEach(person => {
  if (person.data.birthDate) {
    const year = new Date(person.data.birthDate).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(person.data.birthDate).toLocaleDateString('en-US', { month: 'long' }),
      title: `${person.data.name} Born`,
      category: "people",
      description: person.data.description,
      type: "birth",
      link: person.data.status === 'available' ? `/vault/people/${person.slug || person.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Add company foundings
companies.forEach(company => {
  if (company.data.founded) {
    const existing = timelineEvents.find(e => e.year === company.data.founded);
    const event = {
      month: "",
      title: `${company.data.name} Founded`,
      category: "companies",
      description: company.data.description,
      type: "founding",
      link: company.data.status === 'available' ? `/vault/companies/${company.slug || company.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: company.data.founded,
        events: [event]
      });
    }
  }
});

// Add games
games.forEach(game => {
  if (game.data.year) {
    const existing = timelineEvents.find(e => e.year === game.data.year);
    const event = {
      month: "",
      title: `${game.data.name} Released`,
      category: "games",
      description: game.data.description,
      type: "release",
