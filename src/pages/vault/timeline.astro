});

// Add demos
demos.forEach(demo => {
  if (demo.data.year) {
    const existing = timelineEvents.find(e => e.year === demo.data.year);
    const event = {
      month: "",
      title: `${demo.data.name} Released`,
      category: "demos",
      description: demo.data.description,
      type: "demo",
      link: demo.data.status === 'available' ? `/vault/demos/${demo.slug || demo.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: demo.data.year,
        events: [event]
      });
    }
  }
});

// Add demo groups
groups.forEach(group => {
  if (group.data.formed) {
    const existing = timelineEvents.find(e => e.year === group.data.formed);
    const event = {
      month: "",
      title: `${group.data.name} Formed`,
      category: "groups",
      description: group.data.description,
      type: "founding",
      link: group.data.status === 'available' ? `/vault/groups/${group.slug || group.id}` : undefined
