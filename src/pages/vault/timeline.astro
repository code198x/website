});

// Add emulators
emulators.forEach(emu => {
  if (emu.data.year) {
    const existing = timelineEvents.find(e => e.year === emu.data.year);
    const event = {
      month: "",
      title: `${emu.data.name} Released`,
      category: "emulators",
      description: emu.data.description,
      type: "release",
      link: emu.data.status === 'available' ? `/vault/emulators/${emu.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: emu.data.year,
