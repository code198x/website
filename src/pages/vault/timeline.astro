---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import InteractiveTimeline from "../../components/InteractiveTimeline.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { generateVaultBreadcrumbs } from "../../utils/breadcrumbs";
import { getCollection } from 'astro:content';
import "../../styles/vault.css";

// Pull from all content collections
const hardware = await getCollection('hardware');
const people = await getCollection('people');
const companies = await getCollection('companies');
const events = await getCollection('events');
const games = await getCollection('games');
const demos = await getCollection('demos');
const operatingSystems = await getCollection('operatingSystems');
const programmingLanguages = await getCollection('programmingLanguages');
const publications = await getCollection('publications');
const groups = await getCollection('groups');
const applications = await getCollection('applications');
const developmentTools = await getCollection('developmentTools');
const drivers = await getCollection('drivers');
const utilities = await getCollection('utilities');
const plugins = await getCollection('plugins');
const emulators = await getCollection('emulators');
const techniques = await getCollection('techniques');
const formats = await getCollection('formats');
const culture = await getCollection('culture');


// Build timeline events from collections
const timelineEvents: any[] = [];

// Add hardware releases
hardware.forEach(item => {
  if (item.data.year) {
    const existing = timelineEvents.find(e => e.year === item.data.year);
    const event = {
      month: "",
      title: `${item.data.name} Released`,
      category: "hardware",
      description: item.data.description,
      type: "release",
      link: `/vault/hardware/${item.slug || item.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: item.data.year,
        events: [event]
      });
    }
  }
});

// Add people births
people.forEach(person => {
  if (person.data.birthDate) {
    const year = new Date(person.data.birthDate).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(person.data.birthDate).toLocaleDateString('en-US', { month: 'long' }),
      title: `${person.data.name} Born`,
      category: "people",
      description: person.data.description,
      type: "birth",
      link: `/vault/people/${person.slug || person.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Add company foundings
companies.forEach(company => {
  if (company.data.founded) {
    const existing = timelineEvents.find(e => e.year === company.data.founded);
    const event = {
      month: "",
      title: `${company.data.name} Founded`,
      category: "companies",
      description: company.data.description,
      type: "founding",
      link: `/vault/companies/${company.slug || company.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: company.data.founded,
        events: [event]
      });
    }
  }
});

// Add games
games.forEach(game => {
  if (game.data.year) {
    const existing = timelineEvents.find(e => e.year === game.data.year);
    const event = {
      month: "",
      title: `${game.data.name} Released`,
      category: "games",
      description: game.data.description,
      type: "release",
      link: `/vault/games/${game.slug || game.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: game.data.year,
        events: [event]
      });
    }
  }
});

// Add demos
demos.forEach(demo => {
  if (demo.data.year) {
    const existing = timelineEvents.find(e => e.year === demo.data.year);
    const event = {
      month: "",
      title: `${demo.data.name} Released`,
      category: "demos",
      description: demo.data.description,
      type: "demo",
      link: `/vault/demos/${demo.slug || demo.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: demo.data.year,
        events: [event]
      });
    }
  }
});

// Add demo groups
groups.forEach(group => {
  if (group.data.formed) {
    const existing = timelineEvents.find(e => e.year === group.data.formed);
    const event = {
      month: "",
      title: `${group.data.name} Formed`,
      category: "groups",
      description: group.data.description,
      type: "founding",
      link: `/vault/groups/${group.slug || group.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: group.data.formed,
        events: [event]
      });
    }
  }
});

// Add operating systems
operatingSystems.forEach(os => {
  if (os.data.year) {
    const existing = timelineEvents.find(e => e.year === os.data.year);
    const event = {
      month: "",
      title: `${os.data.name} Released`,
      category: "operating-systems",
      description: os.data.description,
      type: "release",
      link: `/vault/operating-systems/${os.slug || os.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: os.data.year,
        events: [event]
      });
    }
  }
});

// Add programming languages
programmingLanguages.forEach(lang => {
  if (lang.data.year) {
    const existing = timelineEvents.find(e => e.year === lang.data.year);
    const event = {
      month: "",
      title: `${lang.data.name} Created`,
      category: "programming-languages",
      description: lang.data.description,
      type: "creation",
      link: `/vault/programming-languages/${lang.slug || lang.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: lang.data.year,
        events: [event]
      });
    }
  }
});

// Add publications
publications.forEach(pub => {
  // Add first issue
  if (pub.data.firstIssue) {
    const year = new Date(pub.data.firstIssue).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(pub.data.firstIssue).toLocaleDateString('en-US', { month: 'long' }),
      title: `${pub.data.name} First Issue`,
      category: "publications",
      description: pub.data.description,
      type: "launch",
      link: `/vault/publications/${pub.slug || pub.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }

  // Add last issue if publication ended
  if (pub.data.lastIssue) {
    const year = new Date(pub.data.lastIssue).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(pub.data.lastIssue).toLocaleDateString('en-US', { month: 'long' }),
      title: `${pub.data.name} Final Issue`,
      category: "publications",
      description: `End of ${pub.data.name}`,
      type: "closure",
      link: `/vault/publications/${pub.slug || pub.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Add applications
applications.forEach(app => {
  if (app.data.year) {
    const existing = timelineEvents.find(e => e.year === app.data.year);
    const event = {
      month: "",
      title: `${app.data.name} Released`,
      category: "applications",
      description: app.data.description,
      type: "release",
      link: `/vault/applications/${app.slug || app.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: app.data.year,
        events: [event]
      });
    }
  }
});

// Add development tools
developmentTools.forEach(tool => {
  if (tool.data.year) {
    const existing = timelineEvents.find(e => e.year === tool.data.year);
    const event = {
      month: "",
      title: `${tool.data.name} Released`,
      category: "development-tools",
      description: tool.data.description,
      type: "release",
      link: `/vault/development-tools/${tool.slug || tool.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: tool.data.year,
        events: [event]
      });
    }
  }
});

// Add emulators
emulators.forEach(emu => {
  if (emu.data.year) {
    const existing = timelineEvents.find(e => e.year === emu.data.year);
    const event = {
      month: "",
      title: `${emu.data.name} Released`,
      category: "emulators",
      description: emu.data.description,
      type: "release",
      link: `/vault/emulators/${emu.slug || emu.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: emu.data.year,
        events: [event]
      });
    }
  }
});

// Add techniques
techniques.forEach(tech => {
  if (tech.data.year) {
    const existing = timelineEvents.find(e => e.year === tech.data.year);
    const event = {
      month: "",
      title: `${tech.data.name} Discovered`,
      category: "techniques",
      description: tech.data.description,
      type: "innovation",
      link: `/vault/techniques/${tech.slug || tech.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: tech.data.year,
        events: [event]
      });
    }
  }
});

// Add formats
formats.forEach(fmt => {
  if (fmt.data.year) {
    const existing = timelineEvents.find(e => e.year === fmt.data.year);
    const event = {
      month: "",
      title: `${fmt.data.name} Introduced`,
      category: "formats",
      description: fmt.data.description,
      type: "standard",
      link: `/vault/formats/${fmt.slug || fmt.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: fmt.data.year,
        events: [event]
      });
    }
  }
});

// Add drivers
drivers.forEach(driver => {
  if (driver.data.year) {
    const existing = timelineEvents.find(e => e.year === driver.data.year);
    const event = {
      month: "",
      title: `${driver.data.name} Released`,
      category: "drivers",
      description: driver.data.description,
      type: "release",
      link: `/vault/drivers/${driver.slug || driver.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: driver.data.year,
        events: [event]
      });
    }
  }
});

// Add utilities
utilities.forEach(util => {
  if (util.data.year) {
    const existing = timelineEvents.find(e => e.year === util.data.year);
    const event = {
      month: "",
      title: `${util.data.name} Released`,
      category: "utilities",
      description: util.data.description,
      type: "release",
      link: `/vault/utilities/${util.slug || util.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: util.data.year,
        events: [event]
      });
    }
  }
});

// Add plugins
plugins.forEach(plugin => {
  if (plugin.data.year) {
    const existing = timelineEvents.find(e => e.year === plugin.data.year);
    const event = {
      month: "",
      title: `${plugin.data.name} Released`,
      category: "plugins",
      description: plugin.data.description,
      type: "release",
      link: `/vault/plugins/${plugin.slug || plugin.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: plugin.data.year,
        events: [event]
      });
    }
  }
});

// Add cultural movements
culture.forEach(cult => {
  // Culture uses period.start instead of year
  if (cult.data.period && cult.data.period.start) {
    const year = cult.data.period.start;
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: "",
      title: cult.data.name,
      category: "culture",
      description: cult.data.description,
      type: "movement",
      link: `/vault/culture/${cult.slug || cult.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }

  // Also add end date if the movement ended
  if (cult.data.period && cult.data.period.end) {
    const year = cult.data.period.end;
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: "",
      title: `${cult.data.name} Ends`,
      category: "culture",
      description: `End of ${cult.data.name}`,
      type: "closure",
      link: `/vault/culture/${cult.slug || cult.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Add events
events.forEach(evt => {
  if (evt.data.date) {
    const year = new Date(evt.data.date).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(evt.data.date).toLocaleDateString('en-US', { month: 'long' }),
      title: evt.data.name,
      category: "events",
      description: evt.data.description,
      type: "event",
      link: `/vault/events/${evt.slug || evt.id}`
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});


// Sort by year and then by month within each year
timelineEvents.sort((a, b) => a.year - b.year);
timelineEvents.forEach(yearGroup => {
  yearGroup.events.sort((a: any, b: any) => {
    // Sort by month if available
    const months = ["January", "February", "March", "April", "May", "June",
                   "July", "August", "September", "October", "November", "December"];
    const aIndex = months.indexOf(a.month) !== -1 ? months.indexOf(a.month) : 99;
    const bIndex = months.indexOf(b.month) !== -1 ? months.indexOf(b.month) : 99;
    return aIndex - bIndex;
  });
});

const categoryColors: Record<string, string> = {
  hardware: "blue",
  people: "green",
  companies: "purple",
  games: "orange",
  demos: "cyan",
  "operating-systems": "slate",
  "programming-languages": "emerald",
  applications: "amber",
  "development-tools": "rose",
  drivers: "stone",
  utilities: "teal",
  plugins: "fuchsia",
  emulators: "violet",
  techniques: "red",
  publications: "indigo",
  events: "pink",
  groups: "teal",
  formats: "orange",
  culture: "cyan",
  projects: "lime"
};

// Icon mapping for categories
const categoryIcons: Record<string, string> = {
  hardware: "🖥️",
  people: "👤",
  companies: "🏢",
  games: "🎮",
  demos: "🎬",
  "operating-systems": "💻",
  "programming-languages": "📝",
  applications: "💼",
  "development-tools": "🔧",
  drivers: "⚙️",
  utilities: "🛠️",
  plugins: "🧩",
  emulators: "🔄",
  techniques: "⚡",
  publications: "📖",
  events: "🎪",
  groups: "👥",
  formats: "💾",
  culture: "🌟",
  projects: "🎯"
};
---

<Layout title="Timeline">
  <Hero
    title="Computing Timeline"
    subtitle="Journey Through the Golden Age"
    description="Explore the key moments that shaped home computing, from the first microprocessors to the rise of 16-bit machines."
    variant="gradient"
    badge={{
      text: "📅 Historical Archive",
      color: "#06b6d4"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs()} />

      <!-- Interactive Timeline Component -->
      <InteractiveTimeline
        timelineData={timelineEvents}
        categoryColors={categoryColors}
        categoryIcons={categoryIcons}
      />
    </div>
  </div>
</Layout>