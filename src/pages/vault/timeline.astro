---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { getCollection } from 'astro:content';
import "../../styles/vault.css";

// Pull from all content collections
const hardware = await getCollection('hardware');
const people = await getCollection('people');
const companies = await getCollection('companies');
const events = await getCollection('events');
const games = await getCollection('games');
const demos = await getCollection('demos');
const operatingSystems = await getCollection('operatingSystems');
const programmingLanguages = await getCollection('programmingLanguages');
const publications = await getCollection('publications');
const groups = await getCollection('groups');
const applications = await getCollection('applications');
const developmentTools = await getCollection('developmentTools');
const drivers = await getCollection('drivers');
const utilities = await getCollection('utilities');
const plugins = await getCollection('plugins');
const emulators = await getCollection('emulators');
const techniques = await getCollection('techniques');
const formats = await getCollection('formats');
const culture = await getCollection('culture');
const projects = await getCollection('projects');

// Keep some mock data as fallback for demonstration
const mockTimelineEvents = [
