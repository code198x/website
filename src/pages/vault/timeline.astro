});

// Add programming languages
programmingLanguages.forEach(lang => {
  if (lang.data.year) {
    const existing = timelineEvents.find(e => e.year === lang.data.year);
    const event = {
      month: "",
      title: `${lang.data.name} Created`,
      category: "programming-languages",
      description: lang.data.description,
      type: "creation",
      link: lang.data.status === 'available' ? `/vault/programming-languages/${lang.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: lang.data.year,
        events: [event]
      });
    }
  }
});

// Add publications
publications.forEach(pub => {
  // Add first issue
  if (pub.data.firstIssue) {
    const year = new Date(pub.data.firstIssue).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(pub.data.firstIssue).toLocaleDateString('en-US', { month: 'long' }),
      title: `${pub.data.name} First Issue`,
      category: "publications",
      description: pub.data.description,
      type: "launch",
      link: pub.data.status === 'available' ? `/vault/publications/${pub.slug || pub.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }

  // Add last issue if publication ended
  if (pub.data.lastIssue) {
    const year = new Date(pub.data.lastIssue).getFullYear();
    const existing = timelineEvents.find(e => e.year === year);
    const event = {
      month: new Date(pub.data.lastIssue).toLocaleDateString('en-US', { month: 'long' }),
      title: `${pub.data.name} Final Issue`,
      category: "publications",
      description: `End of ${pub.data.name}`,
      type: "closure",
      link: pub.data.status === 'available' ? `/vault/publications/${pub.slug || pub.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year,
        events: [event]
      });
    }
  }
});

// Add applications
applications.forEach(app => {
  if (app.data.year) {
    const existing = timelineEvents.find(e => e.year === app.data.year);
    const event = {
      month: "",
      title: `${app.data.name} Released`,
      category: "applications",
      description: app.data.description,
      type: "release",
      link: app.data.status === 'available' ? `/vault/applications/${app.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: app.data.year,
        events: [event]
      });
    }
  }
});

// Add development tools
developmentTools.forEach(tool => {
  if (tool.data.year) {
    const existing = timelineEvents.find(e => e.year === tool.data.year);
    const event = {
      month: "",
      title: `${tool.data.name} Released`,
      category: "development-tools",
      description: tool.data.description,
      type: "release",
      link: tool.data.status === 'available' ? `/vault/development-tools/${tool.id}` : undefined
    };

    if (existing) {
      existing.events.push(event);
    } else {
      timelineEvents.push({
        year: tool.data.year,
        events: [event]
      });
    }
