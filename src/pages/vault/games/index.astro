---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import VaultSearch from "../../../components/VaultSearch.astro";
import { vaultData } from "../../../data/vault-data.js";
import "../../../styles/vault.css";

// Filter to just games entries
const gamesData = vaultData.filter(entry => entry.c === 'games');
---

<Layout title="Games - The Vault">
  <Hero
    title="Games"
    subtitle="Entertainment software that defined generations"
    description={`Explore ${gamesData.length} classic games that pushed hardware to its limits and created lasting memories.`}
    variant="gradient"
    badge={{
      text: "🎮 Games",
      color: "#f59e0b",
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Use the shared search component -->
      <VaultSearch
        data={gamesData}
        placeholder="Search games by title, genre, platform, or year..."
        showCategoryFilter={false}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Additional Information Section -->
      <section class="vault-category-info-section">
        <h2>About the Games Collection</h2>
        <p>
          From groundbreaking technical achievements to pure gameplay innovation,
          these games represent the creativity and technical mastery of their era.
          Each entry includes historical context, technical details, and connections
          to the hardware and people that made them possible.
        </p>
      </section>
    </div>
  </div>
</Layout>

