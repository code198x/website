---
// Example of how to use the shared Vault search system
import Layout from '../../layouts/Layout.astro';
import VaultSearch from '../../components/VaultSearch.astro';
import { vaultData, getEntriesByCategory } from '../../data/vault-data.js';

// Option 1: Use all vault data
const allData = vaultData;

// Option 2: Filter to specific category
const hardwareData = getEntriesByCategory('hardware');

// Option 3: Load from content collections (for fresh data)
import { getCollection } from 'astro:content';
const freshHardware = await getCollection('hardware');
const formattedData = freshHardware.map(entry => ({
  c: 'hardware',
  n: entry.data.name,
  d: entry.data.description,
  s: entry.slug,
  t: entry.data.type,
  g: entry.data.tags || [],
  y: entry.data.year,
  st: entry.data.status || 'available'
}));
---

<Layout title="Vault Example">
  <h1>Example Vault Page</h1>

  <!-- Use the shared search component with all data -->
  <VaultSearch
    data={allData}
    placeholder="Search all vault entries..."
    showCategoryFilter={true}
    showTypeFilter={true}
    showTagFilter={true}
    showYearFilter={true}
    showStatusFilter={true}
  />

  <!-- Or pre-filtered to a specific category -->
  <VaultSearch
    data={hardwareData}
    category="hardware"
    placeholder="Search hardware..."
    showCategoryFilter={false}
    showTypeFilter={true}
    showTagFilter={true}
  />
</Layout>