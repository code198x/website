---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { getEntryIcon, getCategoryDisplayName } from "../../utils/vault-template-generator";

// Get search parameters
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get('q') || '';
const categoryFilter = url.searchParams.get('category') || 'all';
const typeFilter = url.searchParams.get('type') || 'all';
const tagFilter = url.searchParams.get('tag') || '';

// Mock data - will be replaced with content collections
const allVaultEntries = [
  // Hardware
  {
    category: 'hardware',
    type: 'computer',
    slug: 'commodore-64',
    name: 'Commodore 64',
    description: 'The best-selling computer model of all time',
    tags: ['8-bit', 'bestseller', 'SID', 'demoscene', 'gaming'],
    year: 1982,
    status: 'available'
  },
  {
    category: 'hardware',
    type: 'computer',
    slug: 'zx-spectrum',
    name: 'ZX Spectrum',
    description: "Britain's gateway to home computing",
    tags: ['8-bit', 'UK', 'rubber-keys', 'bedroom-coders'],
    year: 1982,
    status: 'available'
  },
  {
    category: 'hardware',
    type: 'chip',
    slug: 'mos-6581-sid',
    name: 'MOS 6581 SID',
    description: 'Revolutionary sound synthesis chip',
    tags: ['sound', 'synthesizer', 'C64', 'music'],
    year: 1982,
    status: 'draft'
  },
  // People
  {
    category: 'people',
    type: 'executive',
    slug: 'jack-tramiel',
    name: 'Jack Tramiel',
    description: 'Founder of Commodore - "Computers for the masses, not the classes"',
    tags: ['Commodore', 'visionary', 'businessman'],
    year: 1928,
    status: 'coming'
  },
  {
    category: 'people',
    type: 'engineer',
    slug: 'bob-yannes',
    name: 'Bob Yannes',
    description: 'Creator of the legendary SID chip',
    tags: ['SID', 'engineer', 'synthesizer', 'Commodore'],
    year: 1957,
    status: 'coming'
  },
  // Companies
  {
    category: 'companies',
    type: 'manufacturer',
    slug: 'commodore',
    name: 'Commodore International',
    description: 'Home computer giant that brought computing to the masses',
    tags: ['manufacturer', 'home-computers', 'Jack-Tramiel'],
    year: 1954,
    status: 'coming'
  },
  {
    category: 'companies',
    type: 'manufacturer',
    slug: 'sinclair-research',
    name: 'Sinclair Research',
    description: 'British company that popularized home computing in the UK',
    tags: ['manufacturer', 'UK', 'ZX-Spectrum', 'Clive-Sinclair'],
    year: 1973,
    status: 'coming'
  },
  // Software
  {
    category: 'software',
    type: 'game',
    slug: 'elite',
    name: 'Elite',
    description: 'Revolutionary space trading game with 3D wireframe graphics',
    tags: ['space', '3D', 'trading', 'BBC-Micro', 'innovative'],
    year: 1984,
    status: 'coming'
  },
  {
    category: 'software',
    type: 'game',
    slug: 'the-last-ninja',
    name: 'The Last Ninja',
    description: 'Isometric ninja adventure that pushed the C64 to its limits',
    tags: ['action', 'isometric', 'C64', 'System-3'],
    year: 1987,
    status: 'coming'
  },
  // Techniques
  {
    category: 'techniques',
    type: 'graphics',
    slug: 'sprite-multiplexing',
    name: 'Sprite Multiplexing',
    description: 'Displaying more sprites than hardware allows by reusing them',
    tags: ['sprites', 'graphics', 'C64', 'VIC-II', 'raster'],
    year: 1983,
    status: 'coming'
  },
  {
    category: 'techniques',
    type: 'graphics',
    slug: 'raster-interrupts',
    name: 'Raster Interrupts',
    description: 'Changing graphics parameters mid-screen for visual effects',
    tags: ['raster', 'interrupts', 'graphics', 'effects'],
    year: 1982,
    status: 'coming'
  },
  // Groups
  {
    category: 'groups',
    type: 'demo',
    slug: 'fairlight',
    name: 'Fairlight',
    description: 'Legendary Swedish demo and cracking group',
    tags: ['demoscene', 'cracking', 'Sweden', 'C64'],
    year: 1986,
    status: 'coming'
  },
  // Events
  {
    category: 'events',
    type: 'demo-party',
    slug: 'the-party-1991',
    name: 'The Party 1991',
    description: 'One of the largest demo parties ever held',
    tags: ['demo-party', 'Denmark', 'Amiga', 'PC'],
    year: 1991,
    status: 'coming'
  },
  // Publications
  {
    category: 'publications',
    type: 'magazine',
    slug: 'zzap-64',
    name: 'Zzap!64',
    description: 'Iconic British C64 gaming magazine',
    tags: ['magazine', 'C64', 'reviews', 'UK'],
    year: 1985,
    status: 'coming'
  },
  // Culture
  {
    category: 'culture',
    type: 'scene',
    slug: 'demoscene',
    name: 'Demoscene',
    description: 'Digital art subculture focused on producing demos',
    tags: ['art', 'programming', 'music', 'competition'],
    year: 1980,
    status: 'coming'
  }
];

// Apply search and filters
let filteredEntries = [...allVaultEntries];

// Search filter
if (searchQuery) {
  const query = searchQuery.toLowerCase();
  filteredEntries = filteredEntries.filter(entry =>
    entry.name.toLowerCase().includes(query) ||
    entry.description.toLowerCase().includes(query) ||
    entry.tags.some(tag => tag.toLowerCase().includes(query)) ||
    entry.slug.toLowerCase().includes(query)
  );
}

// Category filter
if (categoryFilter !== 'all') {
  filteredEntries = filteredEntries.filter(entry => entry.category === categoryFilter);
}

// Type filter
if (typeFilter !== 'all') {
  filteredEntries = filteredEntries.filter(entry => entry.type === typeFilter);
}

// Tag filter
if (tagFilter) {
  filteredEntries = filteredEntries.filter(entry =>
    entry.tags.some(tag => tag.toLowerCase() === tagFilter.toLowerCase())
  );
}

// Group by category
const groupedResults = filteredEntries.reduce((acc, entry) => {
  if (!acc[entry.category]) {
    acc[entry.category] = [];
  }
  acc[entry.category].push(entry);
  return acc;
}, {} as Record<string, typeof filteredEntries>);

// Get all unique tags for tag cloud
const allTags = [...new Set(allVaultEntries.flatMap(e => e.tags))].sort();

// Get unique categories and types
const categories = [...new Set(allVaultEntries.map(e => e.category))].sort();
const types = [...new Set(allVaultEntries.map(e => e.type))].sort();
---

<Layout title="Search The Vault">
  <Hero
    title="Search The Vault"
    subtitle="Explore Our Complete Knowledge Base"
    description="Search across hardware, people, software, techniques, and more. Everything about retro computing in one place."
    variant="gradient"
    badge={{
      text: "🔍 Universal Search",
      color: "#8b5cf6"
    }}
  />

  <div class="search-container">
    <div class="container">
      <!-- Search Bar -->
      <section class="search-section">
        <form method="get" action="/vault/search" class="search-form">
          <div class="search-main">
            <input
              type="search"
              name="q"
              placeholder="Search everything... (try 'C64', 'demoscene', 'Jack Tramiel')"
              value={searchQuery}
              class="search-input"
              autofocus
            />
            <button type="submit" class="search-button">
              <span>🔍</span>
              Search
            </button>
          </div>

          <div class="search-filters">
            <div class="filter-group">
              <label for="category">Category:</label>
              <select name="category" id="category">
                <option value="all" selected={categoryFilter === 'all'}>All Categories</option>
                {categories.map(cat => (
                  <option value={cat} selected={categoryFilter === cat}>
                    {getCategoryDisplayName(cat)}
                  </option>
                ))}
              </select>
            </div>

            <div class="filter-group">
              <label for="type">Type:</label>
              <select name="type" id="type">
                <option value="all" selected={typeFilter === 'all'}>All Types</option>
                {types.map(type => (
                  <option value={type} selected={typeFilter === type}>
                    {type.replace('-', ' ')}
                  </option>
                ))}
              </select>
            </div>

            {(searchQuery || categoryFilter !== 'all' || typeFilter !== 'all' || tagFilter) && (
              <a href="/vault/search" class="clear-filters">Clear All</a>
            )}
          </div>
        </form>

        <!-- Quick Tag Links -->
        <div class="tag-cloud">
          <h3>Popular Tags:</h3>
          <div class="tags">
            {allTags.slice(0, 20).map(tag => (
              <a
                href={`/vault/search?tag=${encodeURIComponent(tag)}`}
                class={`tag-link ${tagFilter === tag ? 'active' : ''}`}
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Search Results -->
      <section class="results-section">
        <div class="results-header">
          <h2>
            {searchQuery ? `Search Results for "${searchQuery}"` : 'Browse All Entries'}
          </h2>
          <span class="result-count">
            {filteredEntries.length} {filteredEntries.length === 1 ? 'result' : 'results'} found
          </span>
        </div>

        {filteredEntries.length === 0 ? (
          <div class="no-results">
            <p>No entries found matching your search.</p>
            <p>Try different keywords or browse by category.</p>
          </div>
        ) : (
          <div class="results-grid">
            {Object.entries(groupedResults).map(([category, entries]) => (
              <div class="category-group">
                <h3 class="category-title">
                  <span class="category-icon">{getEntryIcon(category)}</span>
                  {getCategoryDisplayName(category)}
                  <span class="category-count">({entries.length})</span>
                </h3>
                <div class="entry-list">
                  {entries.map(entry => (
                    <a
                      href={entry.status === 'available'
                        ? `/vault/${entry.category}/${entry.slug}`
                        : '#'}
                      class={`entry-card entry-card--${entry.status}`}
                    >
                      <div class="entry-header">
                        <span class="entry-icon">{getEntryIcon(entry.category)}</span>
                        <div class="entry-info">
                          <h4 class="entry-name">{entry.name}</h4>
                          <p class="entry-description">{entry.description}</p>
                        </div>
                        {entry.status !== 'available' && (
                          <span class="status-badge status-badge--{entry.status}">
                            {entry.status === 'coming' ? 'Coming Soon' : 'In Progress'}
                          </span>
                        )}
                      </div>
                      <div class="entry-meta">
                        {entry.year && (
                          <span class="meta-item">
                            <span class="meta-label">Year:</span> {entry.year}
                          </span>
                        )}
                        <span class="meta-item">
                          <span class="meta-label">Type:</span> {entry.type.replace('-', ' ')}
                        </span>
                      </div>
                      <div class="entry-tags">
                        {entry.tags.slice(0, 4).map(tag => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- Quick Stats -->
      <section class="stats-section">
        <h3>Vault Statistics</h3>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">{allVaultEntries.length}</span>
            <span class="stat-label">Total Entries</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{categories.length}</span>
            <span class="stat-label">Categories</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{allTags.length}</span>
            <span class="stat-label">Unique Tags</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">
              {allVaultEntries.filter(e => e.status === 'available').length}
            </span>
            <span class="stat-label">Available Now</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .search-container {
    min-height: 100vh;
    padding: 2rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Search Section */
  .search-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .search-form {
    margin-bottom: 2rem;
  }

  .search-main {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .search-input {
    flex: 1;
    padding: 1rem;
    font-size: 1.125rem;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .search-input:focus {
    outline: none;
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
  }

  .search-button {
    padding: 1rem 2rem;
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.2s;
  }

  .search-button:hover {
    transform: translateY(-2px);
  }

  .search-filters {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .filter-group select {
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .clear-filters {
    padding: 0.5rem 1rem;
    background: #ef4444;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
  }

  /* Tag Cloud */
  .tag-cloud {
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
  }

  .tag-cloud h3 {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-link {
    padding: 0.375rem 0.75rem;
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    text-decoration: none;
    border-radius: 20px;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .tag-link:hover,
  .tag-link.active {
    background: #8b5cf6;
    color: white;
  }

  /* Results Section */
  .results-section {
    margin-bottom: 2rem;
  }

  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .results-header h2 {
    font-size: 1.75rem;
    color: var(--text-primary);
  }

  .result-count {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
  }

  .no-results p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .results-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .category-group {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .category-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .category-icon {
    font-size: 1.5rem;
  }

  .category-count {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: normal;
  }

  .entry-list {
    display: grid;
    gap: 1rem;
  }

  .entry-card {
    display: block;
    padding: 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .entry-card:hover:not(.entry-card--coming):not(.entry-card--draft) {
    transform: translateX(4px);
    border-color: #8b5cf6;
  }

  .entry-card--coming,
  .entry-card--draft {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .entry-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .entry-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .entry-info {
    flex: 1;
  }

  .entry-name {
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .entry-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .status-badge--coming {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }

  .status-badge--draft {
    background: rgba(107, 114, 128, 0.1);
    color: #6b7280;
  }

  .entry-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
  }

  .meta-item {
    color: var(--text-secondary);
  }

  .meta-label {
    font-weight: 600;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .entry-tags .tag {
    padding: 0.25rem 0.5rem;
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    border-radius: 12px;
    font-size: 0.75rem;
  }

  /* Stats Section */
  .stats-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
  }

  .stats-section h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
  }

  .stat-card {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: bold;
    color: #8b5cf6;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
</style>