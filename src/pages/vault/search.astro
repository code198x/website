---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import VaultSearch from "../../components/VaultSearch.astro";
import { vaultData, getAllTags } from "../../data/vault-data.js";

// Get total entries and popular tags
const totalEntries = vaultData.length;
const allTags = getAllTags();
const popularTags = Object.entries(allTags)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 10)
  .map(([tag]) => tag);
---

<Layout title="Search The Vault">
  <Hero
    title="Search The Vault"
    subtitle="Find anything in our retro computing encyclopedia"
    description={`${totalEntries} total entries available`}
    variant="gradient"
    badge={{
      text: "🔍 Interactive Search",
      color: "#8b5cf6"
    }}
  />

  <div class="search-container">
    <div class="container">
      <!-- Use the shared search component with all features enabled -->
      <VaultSearch
        data={vaultData}
        placeholder="Search hardware, people, games, techniques..."
        showCategoryFilter={true}
        showTypeFilter={true}
        showTagFilter={true}
        showYearFilter={true}
        showStatusFilter={true}
      />

      <!-- Search Tips -->
      <section class="search-tips">
        <h3>Search Tips</h3>
        <ul>
          <li>Use <kbd>/</kbd> to quickly focus the search box</li>
          <li>Press <kbd>ESC</kbd> to clear your search</li>
          <li>Filter by category to narrow results to specific types</li>
          <li>Click on tags to filter by that tag</li>
          <li>Combine multiple filters for precise results</li>
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  .search-container {
    padding: 2rem 0 4rem;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Search Tips */
  .search-tips {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .search-tips h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .search-tips ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .search-tips li {
    padding: 0.5rem 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .search-tips li::before {
    content: "→";
    margin-right: 0.75rem;
    color: var(--color-primary);
    font-weight: bold;
  }

  .search-tips kbd {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
  }

  /* Dark mode adjustments */
  :global(.dark-mode) .search-tips {
    background: rgba(30, 41, 59, 0.5);
  }

  :global(.dark-mode) .search-tips kbd {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(255, 255, 255, 0.1);
  }
</style>