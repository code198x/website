---
import { getCollection } from "astro:content";
import VaultEntryLayout from "../../../components/VaultEntryLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("operatingSystems");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<VaultEntryLayout
  title={`${entry.data.name} - Operating Systems`}
  description={`Learn about ${entry.data.name}, ${entry.data.type} from ${entry.data.year || 'the golden age of computing'}.`}
  entry={entry}
  categorySlug="operating-systems"
  categoryName="Operating Systems"
  categoryIcon="💻"
  categoryColor="#64748b"
/>