---
import VaultCategoryLayout from "../../../components/VaultCategoryLayout.astro";
import { vaultData } from "../../../data/vault-data.js";

const categoryData = vaultData.filter(entry => entry.c === 'operating-systems');
---

<VaultCategoryLayout
  title="Operating Systems - The Vault"
  description="Explore operating systems that provided the essential interface between hardware and applications."
  heroTitle="Operating Systems"
  heroSubtitle="The foundation software that managed classic computers"
  heroDescription={`Explore ${categoryData.length} operating systems that provided the essential interface between hardware and applications.`}
  heroIcon="💻"
  heroColor="#64748b"
  categorySlug="operating-systems"
  categoryData={categoryData}
  showCategoryFilter={false}
  showTypeFilter={true}
  showTagFilter={true}
  showYearFilter={true}
  showStatusFilter={true}
  infoTitle="About the Operating Systems Collection"
  infoDescription="This collection documents the operating systems that powered classic computers, from simple ROM-based systems to sophisticated multitasking environments. Each entry includes technical specifications, features, and historical context."
  stats={[
    {
      label: "Home Computer",
      value: 0,
      filter: (o) => o.t === 'home-computer'
    },
    {
      label: "Workstation",
      value: 0,
      filter: (o) => o.t === 'workstation'
    },
    {
      label: "Embedded",
      value: 0,
      filter: (o) => o.t === 'embedded'
    },
    {
      label: "Real-time",
      value: 0,
      filter: (o) => o.t === 'real-time'
    }
  ]}
>
  <div class="vault-contribute-section">
    <h3>Contributing</h3>
    <p>
      Know about an operating system we're missing? Found an error? We welcome contributions!
      Check our <a href="/community">community page</a> to learn how you can help
      preserve computing history.
    </p>
  </div>
</VaultCategoryLayout>

