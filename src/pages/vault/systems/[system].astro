---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const systems = await getCollection('systems');
  return systems.map((system) => ({
    params: { system: system.slug },
    props: { system },
  }));
}

const { system } = Astro.props;
const { Content } = await system.render();
---

<Layout title={`${system.data.name} - Systems Vault`}>
  <main class="container" style="padding-top: var(--space-2xl);">
    <div style="margin-bottom: var(--space-2xl);">
      <nav class="breadcrumb" style="margin-bottom: var(--space-lg);">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/vault">Vault</a>
        <span class="separator">/</span>
        <a href="/vault/systems">Systems</a>
        <span class="separator">/</span>
        <span class="current">{system.data.name}</span>
      </nav>
      
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);">{system.data.name}</h1>
      <div class="vault-detail-grid">
        <div>
          <img 
            src={system.data.image} 
            alt={system.data.name}
            style="width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);"
          />
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-lg);">
          <div class="vault-detail-section">
            <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-sm);">Technical Specifications</h3>
            <dl class="vault-detail-list">
              <div class="vault-detail-item"><dt class="vault-detail-label">CPU:</dt><dd class="vault-detail-value">{system.data.cpu}</dd></div>
              <div class="vault-detail-item"><dt class="vault-detail-label">RAM:</dt><dd class="vault-detail-value">{system.data.ram}</dd></div>
              <div class="vault-detail-item"><dt class="vault-detail-label">Released:</dt><dd class="vault-detail-value">{system.data.release_date.global.toDateString()}</dd></div>
              <div class="vault-detail-item"><dt class="vault-detail-label">Origin:</dt><dd class="vault-detail-value">{system.data.country_of_origin}</dd></div>
              <div class="vault-detail-item"><dt class="vault-detail-label">Manufacturer:</dt><dd class="vault-detail-value">{system.data.manufacturer}</dd></div>
            </dl>
          </div>
          
{['commodore-64', 'zx-spectrum', 'commodore-amiga', 'nintendo-entertainment-system'].includes(system.slug) && (
            <div style="padding: var(--space-lg); background: var(--c64-beige-dark); border-radius: var(--radius-lg);">
              <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-sm);">Want to Learn?</h3>
              <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: var(--space-md);">
                Start programming this system with our structured course.
              </p>
              <a 
                href={`/lessons/${system.slug}`}
                class="btn btn-primary"
                style="display: inline-block;"
              >
                View Course →
              </a>
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>
  </main>
</Layout>