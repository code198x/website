---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const systems = await getCollection('systems');
  return systems.map((system) => ({
    params: { system: system.slug },
    props: { system },
  }));
}

const { system } = Astro.props;
const { Content } = await system.render();
---

<Layout title={`${system.data.name} - Systems Vault`}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <nav class="text-sm text-gray-600 mb-4">
        <a href="/vault" class="hover:text-gray-900">Vault</a>
        <span class="mx-2">→</span>
        <a href="/vault/systems" class="hover:text-gray-900">Systems</a>
        <span class="mx-2">→</span>
        <span class="text-gray-900">{system.data.name}</span>
      </nav>
      
      <h1 class="text-4xl font-bold mb-4">{system.data.name}</h1>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <img 
            src={system.data.image} 
            alt={system.data.name}
            class="w-full rounded-lg shadow-lg"
          />
        </div>
        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-semibold mb-2">Technical Specifications</h3>
            <dl class="space-y-1 text-sm">
              <div class="flex"><dt class="font-medium w-24">CPU:</dt><dd>{system.data.cpu}</dd></div>
              <div class="flex"><dt class="font-medium w-24">RAM:</dt><dd>{system.data.ram}</dd></div>
              <div class="flex"><dt class="font-medium w-24">Released:</dt><dd>{system.data.release_date.global.toDateString()}</dd></div>
              <div class="flex"><dt class="font-medium w-24">Origin:</dt><dd>{system.data.country_of_origin}</dd></div>
              <div class="flex"><dt class="font-medium w-24">Manufacturer:</dt><dd>{system.data.manufacturer}</dd></div>
            </dl>
          </div>
          
          <div class="p-4 bg-c64-beige-dark rounded-lg">
            <h3 class="text-lg font-semibold mb-2">Want to Learn?</h3>
            <p class="text-sm text-gray-600 mb-3">
              Start programming this system with our structured course.
            </p>
            <a 
              href={`/lessons/${system.slug}`}
              class="inline-block px-4 py-2 bg-brand-blue text-white font-medium rounded hover:bg-brand-blue-dark transition-colors"
            >
              View Course →
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="prose max-w-none">
      <Content />
    </div>
  </main>
</Layout>