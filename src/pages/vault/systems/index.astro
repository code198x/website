---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const systems = await getCollection('systems');
const sortedSystems = systems.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Systems - Vault">
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <nav class="text-sm text-gray-600 mb-4">
        <a href="/vault" class="hover:text-gray-900">Vault</a>
        <span class="mx-2">→</span>
        <span class="text-gray-900">Systems</span>
      </nav>
      
      <h1 class="text-4xl font-bold mb-4">Computer Systems</h1>
      <p class="text-lg text-gray-600 max-w-3xl">
        Explore the technical specifications, history, and cultural impact of the iconic 
        computer systems that defined the home computing revolution of the 1980s.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedSystems.map((system) => (
        <a 
          href={`/vault/systems/${system.slug}`}
          class="group block bg-white/80 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-200 hover:scale-105"
        >
          <div class="h-48 bg-gray-200 overflow-hidden">
            <img 
              src={system.data.image} 
              alt={system.data.name}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-200"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-brand-blue transition-colors">
              {system.data.name}
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              {system.data.historical_significance?.slice(0, 120)}...
            </p>
            <div class="text-xs text-gray-500">
              <div><strong>Released:</strong> {system.data.release_date.global.getFullYear()}</div>
              <div><strong>Manufacturer:</strong> {system.data.manufacturer}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>