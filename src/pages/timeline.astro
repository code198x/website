---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get all events
const events = await getCollection("events");

// Get all people with birth/death dates
const people = await getCollection("people");

// Get all companies with founding/dissolution dates  
const companies = await getCollection("companies");

// Get all systems with release dates
const systems = await getCollection("systems");

// Create timeline entries from all sources
const timelineEntries = [];

// Add events
events.forEach(event => {
  timelineEntries.push({
    date: new Date(event.data.date),
    dateStr: event.data.date,
    type: "event",
    category: event.data.category,
    title: event.data.title,
    description: event.data.description,
    link: null
  });
});

// Add people births
people.forEach(person => {
  if (person.data.birth_date && person.data.birth_date !== "1974-01-01") { // Exclude 68000 team placeholder
    timelineEntries.push({
      date: new Date(person.data.birth_date),
      dateStr: person.data.birth_date,
      type: "birth",
      category: "People",
      title: `${person.data.name} born`,
      description: `Birth of ${person.data.occupation[0].toLowerCase()}`,
      link: `/vault/people/${person.slug}`
    });
  }
});

// Add people deaths
people.forEach(person => {
  if (person.data.death_date && person.data.death_date !== "null") {
    timelineEntries.push({
      date: new Date(person.data.death_date),
      dateStr: person.data.death_date,
      type: "death",
      category: "People",
      title: `${person.data.name} dies`,
      description: `Death of pioneering ${person.data.occupation[0].toLowerCase()}`,
      link: `/vault/people/${person.slug}`
    });
  }
});

// Add company foundations
companies.forEach(company => {
  if (company.data.founded) {
    timelineEntries.push({
      date: new Date(company.data.founded),
      dateStr: company.data.founded,
      type: "founding",
      category: "Companies",
      title: `${company.data.name} founded`,
      description: `Establishment of ${company.data.business_focus[0]} company`,
      link: `/vault/companies/${company.slug}`
    });
  }
});

// Add company dissolutions/acquisitions
companies.forEach(company => {
  if (company.data.dissolved && company.data.dissolved !== "null") {
    timelineEntries.push({
      date: new Date(company.data.dissolved),
      dateStr: company.data.dissolved,
      type: "dissolution",
      category: "Companies",
      title: `${company.data.name} ${company.data.acquired_by ? 'acquired' : 'dissolved'}`,
      description: company.data.acquired_by ? `Acquired by ${company.data.acquired_by}` : "Company ceased operations",
      link: `/vault/companies/${company.slug}`
    });
  }
});

// Add system launches
systems.forEach(system => {
  if (system.data.release_date) {
    timelineEntries.push({
      date: new Date(system.data.release_date),
      dateStr: system.data.release_date,
      type: "system",
      category: "Technology",
      title: `${system.data.name} launched`,
      description: system.data.tagline,
      link: `/lessons/${system.slug}/`
    });
  }
});

// Sort chronologically
timelineEntries.sort((a, b) => a.date - b.date);

// Filter to focus on relevant period (1970-1999) plus some context
const filteredEntries = timelineEntries.filter(entry => {
  const year = entry.date.getFullYear();
  return year >= 1920 && year <= 1999;
});

// Group by decade
const decades = {};
filteredEntries.forEach(entry => {
  const decade = Math.floor(entry.date.getFullYear() / 10) * 10;
  if (!decades[decade]) {
    decades[decade] = [];
  }
  decades[decade].push(entry);
});

// Category colours
const categoryColours = {
  "Technology": "text-blue-600",
  "Gaming History": "text-purple-600", 
  "World History": "text-red-600",
  "People": "text-green-600",
  "Companies": "text-amber-600"
};
---

<Layout title="Timeline - Code Like It's 198x">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-2">Timeline</h1>
    <p class="text-xl text-gray-600 mb-8">
      Explore the intertwined history of computing, gaming, and world events that shaped the digital revolution.
    </p>

    <nav class="mb-8 text-sm">
      <a href="/" class="text-blue-600 hover:underline">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">Timeline</span>
    </nav>

    <div class="mb-6 p-4 bg-gray-100 rounded-lg">
      <h2 class="font-semibold mb-2">Legend</h2>
      <div class="flex flex-wrap gap-4 text-sm">
        <span class="flex items-center gap-2">
          <span class="w-4 h-4 bg-blue-600 rounded"></span>
          Technology
        </span>
        <span class="flex items-center gap-2">
          <span class="w-4 h-4 bg-purple-600 rounded"></span>
          Gaming History
        </span>
        <span class="flex items-center gap-2">
          <span class="w-4 h-4 bg-red-600 rounded"></span>
          World History
        </span>
        <span class="flex items-center gap-2">
          <span class="w-4 h-4 bg-green-600 rounded"></span>
          People
        </span>
        <span class="flex items-center gap-2">
          <span class="w-4 h-4 bg-amber-600 rounded"></span>
          Companies
        </span>
      </div>
    </div>

    {Object.entries(decades).map(([decade, entries]) => (
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-800">{decade}s</h2>
        <div class="space-y-4">
          {entries.map(entry => {
            const year = entry.date.getFullYear();
            const month = entry.date.toLocaleString('en-GB', { month: 'long' });
            const day = entry.date.getDate();
            
            return (
              <div class="flex gap-4 items-start">
                <div class="w-32 flex-shrink-0 text-right">
                  <div class="font-semibold">{year}</div>
                  <div class="text-sm text-gray-600">{day} {month}</div>
                </div>
                <div class="flex-grow border-l-2 border-gray-300 pl-4 pb-4">
                  <div class={`font-semibold ${categoryColours[entry.category] || 'text-gray-800'}`}>
                    {entry.link ? (
                      <a href={entry.link} class="hover:underline">
                        {entry.title}
                      </a>
                    ) : (
                      entry.title
                    )}
                  </div>
                  <div class="text-gray-600 text-sm mt-1">
                    {entry.description}
                  </div>
                  <div class="text-xs text-gray-500 mt-1">
                    {entry.category}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <div class="mt-12 p-6 bg-blue-50 rounded-lg">
      <h2 class="text-xl font-semibold mb-2">About This Timeline</h2>
      <p class="text-gray-700">
        This timeline combines technological milestones with significant world events to provide context for the 
        computing revolution of the 1970s, 1980s, and 1990s. Understanding how technology developed alongside 
        major historical events helps us appreciate both the challenges and opportunities that shaped the digital age.
      </p>
    </div>
  </main>
</Layout>