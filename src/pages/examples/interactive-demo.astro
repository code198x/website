---
import Layout from '../../layouts/Layout.astro';
import MemoryMapVisualizer from '../../components/MemoryMapVisualizer.astro';
import RegisterDisplay from '../../components/RegisterDisplay.tsx';
import SpriteEditor from '../../components/SpriteEditor.tsx';
import AssemblyStepThrough from '../../components/AssemblyStepThrough.tsx';
---

<Layout title="Interactive Components Demo">
  <main class="container mx-auto p-4">
    <h1 class="text-3xl font-bold text-white mb-8">
      Code Like It's 198x Interactive Learning Components
    </h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Memory Map Visualizer -->
      <section>
        <h2 class="text-xl font-semibold text-white mb-4">Memory Map Visualizer</h2>
        <MemoryMapVisualizer 
          platform="c64" 
          activeAddress={0xD020}
          highlights={[
            {start: 0xD020, end: 0xD021, label: "Border/Background"},
            {start: 0xD000, end: 0xD02E, label: "VIC-II Registers"}
          ]}
        />
        <p class="text-slate-400 text-sm mt-2">
          Shows the C64's memory layout. The highlighted region at $D020 is the border color register.
        </p>
      </section>
      
      <!-- Register Display -->
      <section>
        <h2 class="text-xl font-semibold text-white mb-4">CPU Register Display</h2>
        <RegisterDisplay 
          client:load
          registers={{
            A: 0x42,
            X: 0x00,
            Y: 0x10,
            SP: 0xFF,
            PC: 0xC000,
            N: false,
            V: false,
            B: false,
            D: false,
            I: true,
            Z: false,
            C: false
          }}
          previousRegisters={{
            A: 0x00,
            X: 0x00,
            Y: 0x10,
            SP: 0xFF,
            PC: 0xBFFE,
            N: false,
            V: false,
            B: false,
            D: false,
            I: true,
            Z: true,
            C: false
          }}
          platform="c64"
        />
        <p class="text-slate-400 text-sm mt-2">
          Live CPU state with change highlighting. Yellow shows which registers changed.
        </p>
      </section>
      
      <!-- Sprite Editor -->
      <section>
        <h2 class="text-xl font-semibold text-white mb-4">Interactive Sprite Editor</h2>
        <SpriteEditor 
          client:load
          platform="c64"
          width={8}
          height={8}
          onDataChange={(data) => console.log('Sprite data:', data)}
        />
        <p class="text-slate-400 text-sm mt-2">
          Draw pixel art and get the hex data instantly. Perfect for creating game graphics!
        </p>
      </section>
      
      <!-- Assembly Step-Through -->
      <section>
        <h2 class="text-xl font-semibold text-white mb-4">Assembly Step-Through</h2>
        <AssemblyStepThrough client:load />
        <p class="text-slate-400 text-sm mt-2">
          Step through assembly code instruction by instruction. See exactly how the CPU executes your code.
        </p>
      </section>
      
    </div>
    
    <!-- Code Example -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold text-white mb-4">
        How These Work Together
      </h2>
      <div class="bg-slate-800 p-4 rounded-lg">
        <p class="text-slate-100 mb-4">
          Imagine learning to change the C64's border color:
        </p>
        <ol class="list-decimal list-inside text-slate-100 space-y-2">
          <li>The <strong>Memory Map</strong> shows you $D020 is in the I/O area</li>
          <li>The <strong>Sprite Editor</strong> lets you design graphics for your program</li>
          <li>The <strong>Register Display</strong> shows A = $06 after LDA #$06</li>
          <li>The <strong>Step-Through</strong> shows STA $D020 writing to memory</li>
          <li>The border changes color - you see cause and effect!</li>
        </ol>
        <div class="mt-4 p-3 bg-slate-900 rounded">
          <code class="text-green-400 font-mono text-sm">
            LDA #$06     ; A = 6 (blue)<br>
            STA $D020    ; Border = blue<br>
            LDA #$0E     ; A = 14 (light blue)<br>
            STA $D021    ; Background = light blue
          </code>
        </div>
      </div>
    </section>
    
    <!-- Usage in Lessons -->
    <section class="mt-8 p-4 bg-blue-900 rounded-lg">
      <h3 class="text-xl font-semibold text-white mb-2">
        📚 Using in Lessons
      </h3>
      <p class="text-blue-100">
        These components can be embedded in any MDX lesson file. They're reactive, 
        so you can connect them together - when the step-through executes an instruction,
        the registers update, and if it writes to memory, the memory map highlights!
      </p>
    </section>
    
  </main>
</Layout>

<style>
  main {
    background: linear-gradient(to bottom, #1a1a2e, #0f0f23);
    min-height: 100vh;
  }
</style>