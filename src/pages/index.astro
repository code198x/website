---
/**
 * The homepage, on the approved concept
 * (Code198x/website-preview/public/concepts/home.html) and
 * 198x/decisions/family-visual-identity.md §6 and §7.
 *
 * The machine is the hero: a listing beside the screen it makes, every live
 * machine doing the same job, and the game a learner builds, unit by unit.
 * Sections are told apart by a glyph, never a hue. Every number on the page is
 * counted from the catalogues at build time.
 */
import { existsSync, readFileSync } from 'node:fs';
import { getCollection } from 'astro:content';
import PageMasthead from '../components/PageMasthead.astro';
import Layout from '../layouts/Layout.astro';
import Eyebrow from '@198x-ui/components/Eyebrow.astro';
import Button from '@198x-ui/components/Button.astro';
import Figure from '@198x-ui/components/Figure.astro';
import Tile from '@198x-ui/components/Tile.astro';
import Shell from '@198x-ui/components/Shell.astro';
import HeroMachine from '../components/home/HeroMachine.astro';
import SameJob from '../components/home/SameJob.astro';
import RefitScreens from '../components/RefitScreens.astro';
import { getAllPlatforms } from '../lib/platforms';
import { systemLessonCounts } from '../lib/system-directory';

/* The doors' marks: Phosphor glyphs, self-hosted in public/icons/phosphor
   (see its README), inlined so they draw in currentColor. */
const glyph = (name: string) => readFileSync(`public/icons/phosphor/${name}.svg`, 'utf8');
const [lightbulb, cpu, hammer, puzzle, vault, clock] =
  ['lightbulb', 'cpu', 'hammer', 'puzzle-piece', 'vault', 'clock-counter-clockwise'].map(glyph);

const platforms = await getAllPlatforms();
const lessonCounts = await systemLessonCounts();
const withLessons = platforms.filter((p) => lessonCounts.has(p.id)).length;

/* "Four with lessons so far": small counts read as words, as the concept has
   them; anything past twelve stays a numeral. */
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const inWords = (n: number) => WORDS[n] ?? String(n);

// What's New: the latest three, newest first (the full run is at /updates).
const now = new Date();
const latestUpdates = (await getCollection('updates'))
  .filter((u) => !u.data.draft && u.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

/* What you'll make: Meteor Storm as the learner has it at four units. Each is
   an Emu198x capture of that unit's own program. */
const MS = '/images/sinclair-zx-spectrum/assembly/meteor-storm';
const stages = [
  { unit: 11, src: `${MS}/unit-11/phases-flight.png`, caption: 'One meteor, a title and a result',
    alt: 'Unit 11: one meteor, the ship and the controls line, white on black.' },
  { unit: 22, src: `${MS}/unit-22/records-flight.png`, caption: 'A full storm, timed and scored',
    alt: 'Unit 22: three meteors and a star, with the time, the boost line and the score at the top.' },
  { unit: 27, src: `${MS}/unit-27/debris-scatter.png`, caption: 'The ship breaks apart',
    alt: 'Unit 27: the ship broken into shards arcing over the frozen storm.' },
  { unit: 28, src: `${MS}/unit-28/colour-bands-flight.png`, caption: 'Colour by place',
    alt: 'Unit 28: meteors cyan, green, yellow and red by the band they fall through.' },
];
for (const s of stages) {
  if (!existsSync(`public${s.src}`)) throw new Error(`[home] Missing capture public${s.src}.`);
}

const doors = [
  { href: '/foundations/basics/', title: 'The Basics', glyph: lightbulb, line: 'Never programmed? What a program is, before any machine.', w: 5 },
  { href: '/foundations/', title: 'Foundations', glyph: cpu, line: 'How computers work underneath, explained once for every machine.', w: 4 },
  { href: '/craft/', title: 'The Craft', glyph: hammer, line: 'Game-making techniques that work on any machine.', w: 3 },
  { href: '/patterns/', title: 'Pattern Library', glyph: puzzle, line: 'Production-ready code, per system.', w: 3 },
  { href: '/vault/', title: 'The Vault', glyph: vault, line: 'People, games, hardware and culture.', w: 4 },
  { href: '/timeline/', title: 'The Timeline', glyph: clock, line: 'Hardware alongside the world that shaped it.', w: 5 },
];
---

<Layout masthead={false}
  title="Make a real game, on a real old machine"
  description="Learn programming by building complete games on classic 8-bit and 16-bit systems, in the languages people used at the time."
>
  <RefitScreens />
  <div class="home">
    <PageMasthead class="home-magazine-mast" label="Code like it’s 198x" note="Build · Play · Understand" />
    <section class="hero" aria-labelledby="hero-h">
      <div class="hero-words">
        <Eyebrow>Code Like It's 198x</Eyebrow>
        <h1 id="hero-h">Make a real game, <em>on a real old machine.</em></h1>
        <p class="lede">Build complete games in the languages people used at the time. Direct hardware, no engines, no apologies.</p>
        <div class="ctas">
          <Button href="/systems/sinclair-zx-spectrum/">Start with ZX Spectrum</Button>
          <Button href="/curriculum/" variant="secondary">See the curriculum map</Button>
        </div>
      </div>
      <div class="hero-side">
        <HeroMachine />
      </div>
    </section>

    <section class="block" aria-labelledby="make-h">
      <div class="head">
        <Eyebrow>What you'll make</Eyebrow>
        <h2 id="make-h">One game, built a unit at a time.</h2>
        <p>Meteor Storm is the first game on the Spectrum assembly track. You start with one pixel and end with a timed, scored storm that has sound, colour and a ship that breaks apart. Every screen below is the program as you have it at that unit.</p>
      </div>
      <div class="stages">
        {stages.map((s) => (
          <Figure src={s.src} alt={s.alt} width={352} height={296} class="stage">
            <Fragment slot="caption"><span class="u">Unit {s.unit}</span>{s.caption}</Fragment>
          </Figure>
        ))}
      </div>
      <div class="go">
        <Button href="/systems/sinclair-zx-spectrum/assembly/meteor-storm/">Build Meteor Storm</Button>
      </div>
    </section>

    <section class="block" aria-labelledby="jobs-h">
      <div class="head">
        <Eyebrow>Every machine, every language</Eyebrow>
        <h2 id="jobs-h">Same job. Different machine.</h2>
        <p>Paint the screen red. Every machine has its own way in, in BASIC or in assembly. Learning those ways is the course.</p>
      </div>
      <SameJob />
    </section>

    <section class="block" aria-labelledby="doors-h">
      <div class="head">
        <h2 id="doors-h">Start anywhere.</h2>
        <p>Each part stands on its own. Come in wherever your question is.</p>
      </div>
      <ul class="doors">
        {doors.map((d) => (
          <li class={`w${d.w}`}>
            <Tile href={d.href} title={d.title} as="h3">
              <Fragment slot="glyph" set:html={d.glyph} />
              {d.line}
            </Tile>
          </li>
        ))}
      </ul>
      <p class="standards">How we check what we publish: <a href="/standards/">Sources &amp; Standards</a>.</p>
    </section>

    {latestUpdates.length > 0 && (
      <section class="block" aria-labelledby="news-h">
        <div class="head"><h2 id="news-h">What's new.</h2></div>
        <ul class="news">
          {latestUpdates.map((u) => (
            <li>
              <a href={`/updates/${u.id}/`}>
                <time datetime={u.data.pubDate.toISOString()}>{fmtDate(u.data.pubDate)}</time>
                <span class="t">{u.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="go"><Button href="/updates/" variant="secondary">All updates</Button></div>
      </section>
    )}

    <section class="block ask" aria-labelledby="ask-h">
      <div class="ask-words">
        <Eyebrow>An honest ask</Eyebrow>
        <h2 id="ask-h">{platforms.length} machines catalogued. {inWords(withLessons)} with lessons so far. One of me.</h2>
        <p>This is <strong>free, open source, and forever</strong>: every page, every binary, every line of prose. The catch: I can't reach the full ambition alone. Author a game on a machine you love. Port the methodology to one I don't own. Fill a Vault entry.</p>
        <Button href="/about/">Ways to help</Button>
      </div>
      <div class="poster-cell" aria-hidden="true">
        <Shell variant="device" class="poster">
          <div class="w">WANTED</div>
          <div class="rule"></div>
          <div class="s">Authors, porters,<br />Vault writers</div>
        </Shell>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter) calc(var(--h-cell) * 12);
  }

  /* ---- hero ---- */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: calc(var(--h-cell) * 4);
    align-items: start;
    padding: calc(var(--h-cell) * 10) 0 calc(var(--h-cell) * 8);
  }
  .hero-words { grid-column: 1 / 6; }
  .hero-side { grid-column: 6 / 13; margin-top: calc(var(--h-cell) * 6); }
  .hero h1 {
    margin: calc(var(--h-cell) * 3) 0 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2.75rem, 4.6vw, var(--text-hero));
    line-height: 0.98;
    letter-spacing: var(--tr-hero);
    color: var(--h-ink);
    text-wrap: balance;
  }
  .hero h1 .hl { color: var(--h-accent-ink); }
  .lede {
    max-width: 30ch;
    margin: calc(var(--h-cell) * 3) 0 0;
    font-size: var(--h-text-lead);
    line-height: var(--h-lh-lead);
    color: var(--h-ink-body);
  }
  .ctas { display: flex; flex-wrap: wrap; gap: calc(var(--h-cell) * 1.5); margin-top: calc(var(--h-cell) * 5); }

  /* ---- section rhythm ---- */
  .block { padding: calc(var(--h-cell) * 12) 0 0; }
  .head { max-width: 46rem; }
  .head h2 {
    margin: calc(var(--h-cell) * 2.5) 0 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2.25rem, 4.4vw, var(--h-text-display));
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--h-ink);
  }
  .head p { max-width: 42ch; margin: calc(var(--h-cell) * 2.5) 0 0; color: var(--h-ink-body); }
  .go { margin-top: calc(var(--h-cell) * 6); }

  /* ---- what you'll make ---- */
  .stages {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--h-cell) * 4) calc(var(--h-cell) * 2);
    margin-top: calc(var(--h-cell) * 6);
  }
  /* Four in a row where four fit at 1x, otherwise two by two: never three and
     an orphan. The bezel's margin is halved here, as the concept has it, so
     four 352-pixel screens fit the 1600-pixel frame. */
  @media (min-width: 421px) { .stages :global(.h-screen) { --h-screen-margin: 0.3rem; } }
  @media (min-width: 820px) { .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1650px) { .stages { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stages :global(.h-figure-caption) {
    font-size: var(--h-text-body);
    line-height: 1.4;
    color: var(--h-ink);
  }
  .u {
    display: block;
    margin-bottom: var(--h-cell);
    font-family: var(--h-font-mono);
    font-style: normal;
    font-size: var(--h-text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--h-ink-muted);
  }

  /* ---- doors ---- */
  .doors {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(var(--h-cell) * 2);
    margin: calc(var(--h-cell) * 6) 0 0;
    padding: 0;
    list-style: none;
  }
  .doors li { display: flex; }
  .doors li > :global(.h-tile) { flex: 1; }
  .w5 { grid-column: span 5; }
  .w4 { grid-column: span 4; }
  .w3 { grid-column: span 3; }
  .standards { margin: calc(var(--h-cell) * 4) 0 0; color: var(--h-ink-muted); }
  .standards a { color: var(--h-ink-body); }

  /* ---- what's new ---- */
  .news { margin: calc(var(--h-cell) * 4) 0 0; padding: 0; list-style: none; }
  .news a {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: calc(var(--h-cell) * 4);
    align-items: baseline;
    padding: calc(var(--h-cell) * 4) calc(var(--h-cell) * 0.5);
    border-top: 1px solid var(--h-line);
    text-decoration: none;
  }
  .news li:last-child a { border-bottom: 1px solid var(--h-line); }
  .news time { font-family: var(--h-font-mono); font-size: var(--h-text-micro); color: var(--h-ink-muted); }
  .news .t {
    font-family: var(--h-font-ui);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--h-ink);
    transition: color var(--h-decay) var(--h-ease);
  }
  .news a:hover .t, .news a:focus-visible .t { color: var(--h-accent-ink); text-decoration: underline; text-underline-offset: 0.15em; transition-duration: var(--h-rise); }

  /* ---- the ask ---- */
  .ask {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(var(--h-cell) * 4);
    align-items: center;
  }
  .ask-words { grid-column: 1 / 9; }
  .ask h2 {
    margin: calc(var(--h-cell) * 2.5) 0 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  .ask p { max-width: 52ch; margin: calc(var(--h-cell) * 3.5) 0 calc(var(--h-cell) * 4.5); font-size: var(--h-text-lead); line-height: var(--h-lh-lead); color: var(--h-ink-body); }
  .ask strong { color: var(--h-ink); font-weight: 600; }
  .poster-cell { grid-column: 9 / 13; justify-self: center; }
  /* A printed poster: paper, not interface, so it keeps its own colours in
     both themes. An object, so round, and pinned at a slant. */
  .poster-cell :global(.poster) { transform: rotate(4deg); }
  .poster-cell :global(.poster > .h-shell-core) {
    padding: calc(var(--h-cell) * 5) calc(var(--h-cell) * 4.5);
    text-align: center;
    background: #efe7d6;
    color: #241a12;
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.6);
  }
  .poster-cell .w { font: 700 2.4rem/1 var(--h-font-mono); letter-spacing: 0.14em; }
  .poster-cell .s { margin-top: calc(var(--h-cell) * 2); font: 400 0.8rem/1.5 var(--h-font-mono); }
  .poster-cell .rule { height: 3px; margin: calc(var(--h-cell) * 2.5) 0; background: #241a12; }

  /* ---- collapse ---- */
  @media (max-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 1fr); row-gap: calc(var(--h-cell) * 6); }
    .hero-words, .hero-side { grid-column: 1 / -1; }
    .hero-side { margin-top: 0; }
    .w5, .w4, .w3 { grid-column: span 6; }
    .ask-words { grid-column: 1 / -1; }
    .poster-cell { grid-column: 1 / -1; justify-self: start; }
  }
  @media (max-width: 767px) {
    .hero { padding-top: calc(var(--h-cell) * 6); }
    .block { padding-top: calc(var(--h-cell) * 9); }
    .doors { grid-template-columns: minmax(0, 1fr); }
    .w5, .w4, .w3 { grid-column: 1 / -1; }
    .news a { grid-template-columns: minmax(0, 1fr); gap: var(--h-cell); }
    .ask { grid-template-columns: minmax(0, 1fr); }
    .poster-cell :global(.poster) { transform: none; }
  }
</style>
