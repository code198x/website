---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import C64ScreenPokeComplete from "../components/C64ScreenPokeComplete.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";

const allSystems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter to only show systems that have lessons
const systemsWithLessons = allSystems.filter((system) => {
  return lessons.some((lesson) => lesson.id.startsWith(system.slug));
});

// Sort systems by order
const sortedSystems = systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Learn Vintage Computer Programming" isHomepage={true}>
  <div class="hero">
    <div class="container">
      <Hero
        badge={{
          text: "🚧 Early Prototype - Learn Assembly by Making Games",
          color: "var(--brand-amber)"
        }}
        title="Code Like It's 198x"
        subtitle="Learn assembly programming by building games on the Commodore 64. Experience the magic of 8-bit computing through hands-on exploration."
        description="Currently Available: Interactive C64 memory explorer + sample lessons. In Development: Full game-based curriculum for C64, NES, and ZX Spectrum."
        variant="centered"
        actions={[
          {
            text: "Get Started (Setup Tools)",
            href: "/setup/c64",
            variant: "primary",
            icon: "🚀"
          },
          {
            text: "Try Interactive Demo",
            href: "#c64-demo",
            variant: "secondary",
            icon: "🎮"
          },
          {
            text: "Browse Lessons",
            href: "/lessons/commodore-64",
            variant: "outline",
            icon: "📚"
          }
        ]}
      />
      <div
        style="text-align: center; margin-top: var(--space-lg); color: rgba(255, 255, 255, 0.8);"
      >
        <p style="font-size: 0.875rem;">
          <strong>New to assembly?</strong>
          1️⃣ Setup (15 min) → 2️⃣ Try Demo → 3️⃣ Start Lesson 1
        </p>
      </div>
    </div>
  </div>

  <div class="feature-section">
    <div class="container">
      <SectionHeader
        title="Try It Now: Interactive C64 Memory Explorer"
        subtitle="Experience the magic of the Commodore 64 by POKEing values directly into screen memory. Watch as your code lights up pixels in real-time!"
        variant="centered"
      />
    </div>

    <!-- Interactive C64 Memory Demo -->
    <div class="container" style="margin-top: var(--space-3xl); max-width: 48rem;">
      <C64ScreenPokeComplete />
    </div>

    <!-- Systems with actual content -->
    <div class="container" style="margin-top: var(--space-3xl);">
      <SectionHeader
        title="Available Systems"
        subtitle="We're starting with these classic systems. More lessons are being developed each week."
      />
      <Grid columns={3} gap="large" variant="cards">
        {
          sortedSystems.map((system) => {
            // Define system-specific colors using CSS custom properties
            const getSystemColors = (slug) => {
              switch (slug) {
                case "commodore-64":
                  return {
                    bg: "system-c64",
                    buttonStyle: "background-color: var(--c64-dark-brown);",
                  };
                case "zx-spectrum":
                  return {
                    bg: "system-spectrum",
                    buttonStyle: "background-color: var(--spectrum-blue);",
                  };
                case "nintendo-entertainment-system":
                  return { bg: "system-nes", buttonStyle: "background-color: var(--nes-gray);" };
                case "commodore-amiga":
                  return {
                    bg: "system-amiga",
                    buttonStyle: "background-color: var(--amiga-orange);",
                  };
                default:
                  return { bg: "bg-slate-200", buttonStyle: "background-color: #2563eb;" };
              }
            };
            const colors = getSystemColors(system.slug);

            return (
              <Card
                variant="system"
                headerColor={colors.bg}
                headerIcon="💻"
                title={system.data.name}
                description={system.data.historical_significance?.slice(0, 120) + "..."}
                meta={[
                  { label: "CPU", value: system.data.cpu },
                  { label: "RAM", value: system.data.ram },
                  { label: "Released", value: system.data.release_date.global.getFullYear().toString() }
                ]}
                actions={[
                  { 
                    text: "Start Learning →", 
                    href: `/lessons/${system.slug}`,
                    style: `${colors.buttonStyle} color: var(--text-inverse);`
                  }
                ]}
              />
            );
          })
        }
      </Grid>
    </div>
  </div>

  <div class="feature-section alt">
    <div class="container">
      <SectionHeader
        title="Why Learn Vintage Programming?"
      />

      <Grid columns={3} gap="large">
        <div class="text-center">
          <div
            style="width: 4rem; height: 4rem; background-color: var(--brand-blue); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);"
          >
            <span style="font-size: 1.5rem;">🧠</span>
          </div>
          <h3
            style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);"
          >
            Understanding Fundamentals
          </h3>
          <p style="color: var(--text-secondary);">
            Learn how computers actually work by programming close to the hardware. Understand
            memory, CPU, and I/O in ways modern abstractions hide.
          </p>
        </div>

        <div class="text-center">
          <div
            style="width: 4rem; height: 4rem; background-color: var(--brand-red); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);"
          >
            <span style="font-size: 1.5rem;">⚡</span>
          </div>
          <h3
            style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);"
          >
            Resource Constraints
          </h3>
          <p style="color: var(--text-secondary);">
            Master optimization by working within tight memory and processing limits. These skills
            translate directly to modern embedded and mobile development.
          </p>
        </div>

        <div class="text-center">
          <div
            style="width: 4rem; height: 4rem; background-color: var(--brand-amber); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);"
          >
            <span style="font-size: 1.5rem;">🎨</span>
          </div>
          <h3
            style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);"
          >
            Creative Problem Solving
          </h3>
          <p style="color: var(--text-secondary);">
            Discover how limitations breed creativity. Learn the techniques that created iconic
            games and applications with minimal resources.
          </p>
        </div>
      </Grid>
    </div>
  </div>

  <div class="feature-section">
    <div class="container">
      <SectionHeader
        title="Our Vision: Learn Assembly Through Games"
        subtitle="We believe the best way to learn assembly programming is by building games. Start with simple demos, progress to arcade classics."
      />

      <div
        style="text-align: center; padding: var(--space-2xl); background-color: #f1f5f9; border-radius: var(--radius-lg); max-width: 48rem; margin: 2rem auto;"
      >
        <h3
          style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-lg);"
        >
          C64 Game Development Curriculum
        </h3>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-xl);">
          30 games across 8 phases, from "Neon Nexus" to advanced demos
        </p>
        <div
          style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); text-align: left; max-width: 32rem; margin: 0 auto;"
        >
          <div
            style="padding: var(--space-md); background: white; border-radius: var(--radius-md);"
          >
            <strong>Phase 1:</strong> Grid games & sprites
          </div>
          <div
            style="padding: var(--space-md); background: white; border-radius: var(--radius-md);"
          >
            <strong>Phase 2:</strong> Scrolling & action
          </div>
          <div
            style="padding: var(--space-md); background: white; border-radius: var(--radius-md);"
          >
            <strong>Phase 3:</strong> Advanced graphics
          </div>
          <div
            style="padding: var(--space-md); background: white; border-radius: var(--radius-md);"
          >
            <strong>Phase 4:</strong> Sound & music
          </div>
        </div>
        <p style="color: var(--text-secondary); margin-top: var(--space-xl); font-size: 0.875rem;">
          <strong>Status:</strong> Curriculum designed, building lessons now
        </p>
      </div>
    </div>
  </div>

  <div class="feature-section alt">
    <div class="container">
      <SectionHeader
        title="Join the Project"
        subtitle="This is an open-source educational project. We need help creating lessons, demos, and documentation."
      />

      <div class="grid-3" style="max-width: 56rem; margin: 0 auto;">
        <div style="text-align: center;">
          <div style="font-size: 3rem; margin-bottom: var(--space-md);">📝</div>
          <h3
            style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-sm);"
          >
            Write Lessons
          </h3>
          <p style="color: var(--text-secondary); font-size: 0.875rem;">
            Help create game-based assembly programming tutorials
          </p>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 3rem; margin-bottom: var(--space-md);">🎮</div>
          <h3
            style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-sm);"
          >
            Build Demos
          </h3>
          <p style="color: var(--text-secondary); font-size: 0.875rem;">
            Create interactive demos and example games
          </p>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 3rem; margin-bottom: var(--space-md);">🔧</div>
          <h3
            style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-sm);"
          >
            Test & Review
          </h3>
          <p style="color: var(--text-secondary); font-size: 0.875rem;">
            Help test lessons and provide feedback
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="feature-section dark">
    <div class="container text-center">
      <h2 class="section-title" style="color: var(--text-inverse);">
        Professional Development Environment
      </h2>
      <p
        style="font-size: 1.25rem; color: var(--text-inverse); opacity: 0.9; margin-bottom: var(--space-2xl); max-width: 48rem; margin-left: auto; margin-right: auto;"
      >
        Get a complete retro development setup with VS Code integration, Docker containers,
        authentic assemblers, and 16 example programs. Everything you need to start coding like it's
        198x!
      </p>
      <div class="hero-actions" style="margin-bottom: var(--space-2xl);">
        <a href="/setup/c64" class="btn btn-success btn-large">
          <span style="font-size: 1.5rem; margin-right: var(--space-md);">🚀</span>
          Setup C64 Development Environment
        </a>
        <div class="text-small text-muted" style="color: #94a3b8;">
          Free • Open Source • Cross-Platform
        </div>
      </div>

      <div class="grid-4" style="max-width: 48rem; margin: 0 auto;">
        <div
          style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);"
        >
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">🛠️</div>
          <div class="text-bold" style="color: #4ade80;">4 Assemblers</div>
          <div class="text-small" style="color: #94a3b8;">CA65, SjASMPlus, VASM, NESASM</div>
        </div>
        <div
          style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);"
        >
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">💻</div>
          <div class="text-bold" style="color: #60a5fa;">VS Code Ready</div>
          <div class="text-small" style="color: #94a3b8;">One-click builds & debugging</div>
        </div>
        <div
          style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);"
        >
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">📚</div>
          <div class="text-bold" style="color: #facc15;">16 Examples</div>
          <div class="text-small" style="color: #94a3b8;">From Hello World to demos</div>
        </div>
        <div
          style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);"
        >
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">🎮</div>
          <div class="text-bold" style="color: #c084fc;">Emulator Ready</div>
          <div class="text-small" style="color: #94a3b8;">Test on authentic emulators</div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="hero"
    style="background: var(--brand-blue);"
  >
    <div class="container text-center">
      <h2
        style="font-size: 1.875rem; font-weight: 700; margin-bottom: var(--space-lg); color: var(--text-inverse);"
      >
        Open Source Education
      </h2>
      <p
        style="font-size: 1.25rem; color: rgba(191, 219, 254, 0.9); margin-bottom: var(--space-2xl); max-width: 42rem; margin-left: auto; margin-right: auto;"
      >
        We're building free, open-source assembly programming education. Join us in preserving and
        teaching this fundamental knowledge.
      </p>
      <div class="hero-actions">
        <a href="https://github.com/code198x" class="btn btn-secondary btn-large">
          GitHub Organization
        </a>
        <a
          href="/lessons/commodore-64"
          class="btn btn-large"
          style="background-color: var(--brand-amber); color: var(--text-primary);"
        >
          Try C64 Lessons
        </a>
      </div>
    </div>
  </div>
</Layout>
