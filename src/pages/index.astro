---
import { getCollection } from "astro:content";
import "../styles/homepage.css";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";
import FullWidthSection from "../components/FullWidthSection.astro";

const allSystems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter to only show systems that have lessons
const systemsWithLessons = allSystems.filter((system) => {
  return lessons.some((lesson) => lesson.id.startsWith(system.slug));
});

// Sort systems by order
const sortedSystems = systemsWithLessons.sort((a, b) => a.data.order - b.data.order);

// Structured data for homepage
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Code Like It's 198x",
  url: "https://code198x.stevehill.xyz",
  description:
    "Learn vintage computer programming with hands-on lessons for Commodore 64, ZX Spectrum, Amiga, NES and other classic systems. Master assembly language on real hardware.",
  author: {
    "@type": "Organization",
    name: "Code Like It's 198x",
  },
  educationalUse: "tutorial",
  audience: {
    "@type": "Audience",
    audienceType: "programmers, retro computing enthusiasts, students",
  },
  potentialAction: {
    "@type": "SearchAction",
    target: "https://code198x.stevehill.xyz/search?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Layout
  title="Learn Vintage Computer Programming"
  description="Master assembly programming on classic computers like Commodore 64, ZX Spectrum, and Amiga. Real hardware, real code, real results. Start your retro programming journey today."
  structuredData={structuredData}
  isHomepage={true}
>
  <div class="hero">
    <div class="container">
      <Hero
        title="Build Real Games on Real Retro Hardware"
        subtitle="Write assembly code for Commodore 64 (available now), plus NES, ZX Spectrum, Amiga, and many more classic systems coming soon. No emulation theory—just pure programming power."
        description="Start with <code>POKE 53280,0</code> to change the border. End with smooth-scrolling games, demo effects, and tracker music. Every lesson runs on original hardware."
        variant="default"
        badge={{
          text: "100% Hands-On Assembly",
          color: "#10b981",
        }}
        actions={[
          {
            text: "Get Started",
            href: "/getting-started",
            variant: "primary",
            icon: "🚀",
          },
          {
            text: "Explore Lessons",
            href: "/lessons",
            variant: "secondary",
            icon: "📚",
          },
        ]}
      />
    </div>
  </div>

  <div class="feature-section">
    <!-- Phase 0 BASIC Section -->
    <div class="container">
      <div class="phase-zero-banner">
        <div class="phase-zero-overlay"></div>
        <div class="phase-zero-content">
          <div class="phase-zero-badge">🚀 COMING 2026: Phase 0 - Start with BASIC</div>
          <h2 class="phase-zero-title">Never Programmed Before? Start Here!</h2>
          <p class="phase-zero-description">
            Phase 0 will teach BASIC on systems that support it. Perfect for absolute
            beginners—learn variables, loops, and game logic with instant visual feedback. When
            you're ready, graduate to assembly programming.
          </p>
          <div class="phase-zero-code">
            <div>10 PRINT "HELLO WORLD"</div>
            <div>20 FOR I = 1 TO 10</div>
            <div>30 POKE 53280, I</div>
            <div>40 NEXT I</div>
            <div>RUN</div>
          </div>
          <p class="phase-zero-note">
            Phase 0 BASIC lessons for C64, ZX Spectrum, Apple II, and more systems coming soon!
          </p>
        </div>
      </div>
    </div>

    <!-- Systems with actual content -->
    <div class="container systems-section">
      <SectionHeader
        title="Available Systems"
        subtitle="We're starting with these classic systems. More lessons are being developed each week."
      />
      <Grid columns={4} gap="medium" variant="cards">
        {
          sortedSystems.map((system) => {
            // Use full slugs for system-specific classes
            const systemClass = `system-${system.slug}`;
            const buttonClass = `btn-${system.slug}`;

            // Get the system image path if it exists
            const systemImage = `/images/systems/${system.slug}.jpg`;

            return (
              <Card
                variant="system"
                headerColor={systemClass}
                headerImage={systemImage}
                title={system.data.name}
                description={system.data.description?.slice(0, 120) + "..."}
                meta={[
                  { label: "CPU", value: system.data.cpu },
                  { label: "RAM", value: system.data.ram },
                  {
                    label: "Released",
                    value: system.data.release_date.global.getFullYear().toString(),
                  },
                ]}
                actions={[
                  {
                    text: "Start Learning →",
                    href: `/lessons/${system.slug}`,
                    style: buttonClass,
                  },
                ]}
              />
            );
          })
        }
      </Grid>
    </div>
  </div>

  <!-- Why Learn Section - Full Width -->
  <FullWidthSection
    variant="custom"
    title="Why Learn Assembly on Vintage Hardware?"
    subtitle="These aren't just history lessons—these are the foundations that power everything from embedded systems to modern game engines."
    className="why-learn-section"
  >
    <Grid columns={3} gap="large">
      <div class="text-center">
        <div class="feature-icon feature-icon--blue">
          <span>🧠</span>
        </div>
        <h3 class="feature-title">True Understanding</h3>
        <p class="feature-description">
          No abstractions. No frameworks. Just you, the CPU, and memory. Learn how computers
          actually work at the fundamental level.
        </p>
      </div>

      <div class="text-center">
        <div class="feature-icon feature-icon--red">
          <span>⚡</span>
        </div>
        <h3 class="feature-title">Optimization Mastery</h3>
        <p class="feature-description">
          When you have 64KB of RAM and a 1MHz CPU, every byte and cycle counts. Skills that
          translate directly to modern performance-critical code.
        </p>
      </div>

      <div class="text-center">
        <div class="feature-icon feature-icon--amber">
          <span>🎮</span>
        </div>
        <h3 class="feature-title">Create Real Games</h3>
        <p class="feature-description">
          Build actual games that run on original hardware. From sprites to scrolling, sound to
          joystick input—create the magic yourself.
        </p>
      </div>
    </Grid>
  </FullWidthSection>

  <!-- Professional Tools Section - Full Width Dark -->
  <section class="tools-section">
    <div class="container">
      <h2 class="tools-title">Modern Tools for Retro Development</h2>
      <p class="tools-subtitle">
        No hunting for ancient software or fighting with DOSBox. Get a complete, modern development
        environment with VS Code integration, Docker containers, and authentic assemblers—all
        pre-configured and ready to go.
      </p>

      <div class="tools-grid">
        <div class="tool-card">
          <div class="tool-icon">🛠️</div>
          <div class="tool-name tool-name--green">Authentic Assemblers</div>
          <div class="tool-description">
            ACME, ca65, SjASMPlus, VASM, NESASM—the actual tools used in the era
          </div>
        </div>

        <div class="tool-card">
          <div class="tool-icon">💻</div>
          <div class="tool-name tool-name--blue">VS Code Integration</div>
          <div class="tool-description">
            Syntax highlighting, IntelliSense, one-click build & run
          </div>
        </div>

        <div class="tool-card">
          <div class="tool-icon">🐳</div>
          <div class="tool-name tool-name--amber">Docker Containers</div>
          <div class="tool-description">
            Zero setup hassle—works on Mac, Windows, and Linux instantly
          </div>
        </div>

        <div class="tool-card">
          <div class="tool-icon">🎮</div>
          <div class="tool-name tool-name--purple">Instant Testing</div>
          <div class="tool-description">
            Build and run on accurate emulators with a single command
          </div>
        </div>
      </div>

      <a href="/getting-started" class="tools-cta">
        <span>🚀</span>
        <span>Get Your Dev Environment</span>
      </a>
      <div class="tools-note">Free • Open Source • Works Everywhere</div>
    </div>
  </section>

  <!-- Final CTA Section - Full Width -->
  <section class="cta-section">
    <div class="cta-overlay"></div>
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Start Your Retro Journey</h2>
        <p class="cta-subtitle">
          Learn assembly programming on classic computers. Free lessons, modern tools, and a
          community of enthusiasts exploring the fundamentals of computing.
        </p>

        <div class="btn-group btn-group--centered">
          <a href="/getting-started" class="cta-button cta-button--primary">
            <span>Start Learning Today →</span>
          </a>
          <a href="https://github.com/code198x" class="cta-button cta-button--ghost">
            <span>View on GitHub</span>
          </a>
        </div>

        <div class="cta-stats">
          <div class="stat-item">
            <div class="stat-value">C64</div>
            <div class="stat-label">Available Now</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">More</div>
            <div class="stat-label">Coming Soon</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">100%</div>
            <div class="stat-label">Free & Open Source</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
