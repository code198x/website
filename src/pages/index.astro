---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allSystems = await getCollection('systems');
const lessons = await getCollection('lessons');

// Filter to only show systems that have lessons
const systemsWithLessons = allSystems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort systems by order
const sortedSystems = systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Learn Vintage Computer Programming" isHomepage={true}>
  <div class="hero">
    <div class="container">
      <div style="display: inline-block; background-color: var(--brand-amber); color: #78350f; padding: var(--space-sm) var(--space-lg); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg);">
        🚀 Tier 1 Preview - Early Access
      </div>
      <h1 class="hero-title">
        Master vintage computer programming
      </h1>
      <p class="hero-subtitle" style="max-width: 48rem; margin-left: auto; margin-right: auto;">
        Learn through hands-on lessons, interactive emulators, and real projects. 
        Discover the fundamentals that shaped modern computing.
      </p>
      <p class="hero-description" style="max-width: 42rem;">
        <strong>Early Access:</strong> First lessons available for C64, NES, and ZX Spectrum. 
        <strong>Roadmap:</strong> 32 total systems planned (1977-2001).
      </p>
      <div class="hero-actions">
        <a href="/download" class="btn btn-success btn-large">
          <span style="font-size: 1.25rem; margin-right: var(--space-sm);">⬇️</span>
          Download Dev Environment
        </a>
        <a href="/lessons/commodore-64" class="btn btn-secondary btn-large">
          Start with C64 Lessons
        </a>
        <a href="/lessons" class="btn btn-large" style="background-color: transparent; color: var(--text-inverse); border: 1px solid var(--text-inverse);">
          Browse All Systems
        </a>
      </div>
    </div>
  </div>

  <div class="feature-section">
    <div class="container">
      <div class="section-title">
        <h2>Choose Your System</h2>
      </div>
      <p class="section-subtitle">
        Learn assembly programming through hands-on game development. Each system will eventually offer 
        comprehensive courses, but we're starting with foundational lessons for select systems.
      </p>
      <div style="margin-top: var(--space-xl); padding: var(--space-lg); background-color: #fffbeb; border: 1px solid #fde68a; border-radius: var(--radius-lg); max-width: 56rem; margin-left: auto; margin-right: auto;">
        <p class="text-small" style="color: #92400e;">
          <strong>🚀 Early Access:</strong> C64 (8 lessons), NES & ZX Spectrum (1 lesson each). 
          <strong>📅 Coming Soon:</strong> More lessons + Apple II & BBC Micro.
          <a href="/systems" style="text-decoration: underline;">View full roadmap →</a>
        </p>
      </div>
    </div>

    <!-- TODO(human): Convert the system cards grid to use new CSS framework -->
    <div class="container" style="margin-top: var(--space-3xl);">
      <div class="grid-responsive">
        {sortedSystems.map((system) => {
          // Define system-specific colors using CSS custom properties
          const getSystemColors = (slug) => {
            switch(slug) {
              case 'commodore-64':
                return { bg: 'system-c64', buttonStyle: 'background-color: var(--c64-dark-brown);' };
              case 'zx-spectrum':
                return { bg: 'system-spectrum', buttonStyle: 'background-color: var(--spectrum-blue);' };
              case 'nintendo-entertainment-system':
                return { bg: 'system-nes', buttonStyle: 'background-color: var(--nes-gray);' };
              case 'commodore-amiga':
                return { bg: 'system-amiga', buttonStyle: 'background-color: var(--amiga-orange);' };
              default:
                return { bg: 'bg-slate-200', buttonStyle: 'background-color: #2563eb;' };
            }
          };
          const colors = getSystemColors(system.slug);
          
          return (
            <div class="card">
              <div class={`card-header ${colors.bg}`}>
                <span>💻</span>
              </div>
              <div class="card-body" style="display: flex; flex-direction: column; flex-grow: 1;">
                <h3 class="card-title">{system.data.name}</h3>
                <p class="card-description" style="flex-grow: 1;">
                  {system.data.historical_significance?.slice(0, 120)}...
                </p>
                <div class="card-meta">
                  <div><strong>CPU:</strong> {system.data.cpu}</div>
                  <div><strong>RAM:</strong> {system.data.ram}</div>
                  <div><strong>Released:</strong> {system.data.release_date.global.getFullYear()}</div>
                </div>
                <a 
                  href={`/lessons/${system.slug}`}
                  class="btn"
                  style={`${colors.buttonStyle} color: var(--text-inverse); width: 100%; margin-top: auto;`}
                >
                  Start Learning →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <div class="feature-section alt">
    <div class="container">
      <div class="section-title">
        <h2>Why Learn Vintage Programming?</h2>
      </div>
      
      <div class="grid-3">
        <div class="text-center">
          <div style="width: 4rem; height: 4rem; background-color: var(--brand-blue); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);">
            <span style="font-size: 1.5rem;">🧠</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">Understanding Fundamentals</h3>
          <p style="color: var(--text-secondary);">
            Learn how computers actually work by programming close to the hardware. 
            Understand memory, CPU, and I/O in ways modern abstractions hide.
          </p>
        </div>
        
        <div class="text-center">
          <div style="width: 4rem; height: 4rem; background-color: var(--brand-red); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);">
            <span style="font-size: 1.5rem;">⚡</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">Resource Constraints</h3>
          <p style="color: var(--text-secondary);">
            Master optimization by working within tight memory and processing limits. 
            These skills translate directly to modern embedded and mobile development.
          </p>
        </div>
        
        <div class="text-center">
          <div style="width: 4rem; height: 4rem; background-color: var(--brand-amber); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);">
            <span style="font-size: 1.5rem;">🎨</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">Creative Problem Solving</h3>
          <p style="color: var(--text-secondary);">
            Discover how limitations breed creativity. Learn the techniques that created 
            iconic games and applications with minimal resources.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="feature-section">
    <div class="container">
      <div class="section-title">
        <h2>Explore the History</h2>
      </div>
      <p class="section-subtitle">
        Discover the people, companies, and events that shaped the digital revolution.
      </p>
      
      <div class="grid-2" style="max-width: 56rem; margin: 0 auto;">
        <div class="card" style="padding: var(--space-2xl); text-align: center; border: 1px solid var(--c64-beige-darker);">
          <div style="width: 4rem; height: 4rem; background-color: var(--spectrum-blue); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);">
            <span style="font-size: 1.5rem;">📅</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">Interactive Timeline</h3>
          <p style="color: var(--text-secondary); margin-bottom: var(--space-xl);">
            Explore the chronological story of computing from the 1970s through the 1990s, 
            including major world events that shaped the industry.
          </p>
          <a href="/timeline" class="btn" style="background-color: var(--spectrum-blue); color: var(--text-inverse);">
            View Timeline →
          </a>
        </div>
        
        <div class="card" style="padding: var(--space-2xl); text-align: center; border: 1px solid var(--c64-beige-darker);">
          <div style="width: 4rem; height: 4rem; background-color: var(--c64-brown); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg);">
            <span style="font-size: 1.5rem;">🏛️</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">The Vault</h3>
          <p style="color: var(--text-secondary); margin-bottom: var(--space-xl);">
            Deep dive into the stories of pioneering engineers, visionary companies, 
            and the technology that changed the world.
          </p>
          <a href="/vault" class="btn" style="background-color: var(--amiga-orange); color: var(--text-inverse);">
            Explore Vault →
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="feature-section dark">
    <div class="container text-center">
      <h2 class="section-title" style="color: var(--text-inverse);">Professional Development Environment</h2>
      <p style="font-size: 1.25rem; color: var(--text-inverse); opacity: 0.9; margin-bottom: var(--space-2xl); max-width: 48rem; margin-left: auto; margin-right: auto;">
        Get a complete retro development setup with VS Code integration, Docker containers, 
        authentic assemblers, and 16 example programs. Everything you need to start coding like it's 198x!
      </p>
      <div class="hero-actions" style="margin-bottom: var(--space-2xl);">
        <a href="/download" class="btn btn-success btn-large">
          <span style="font-size: 1.5rem; margin-right: var(--space-md);">🚀</span>
          Download Development Environment
        </a>
        <div class="text-small text-muted" style="color: #94a3b8;">
          Free • Open Source • Cross-Platform
        </div>
      </div>
      
      <div class="grid-4" style="max-width: 48rem; margin: 0 auto;">
        <div style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);">
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">🛠️</div>
          <div class="text-bold" style="color: #4ade80;">4 Assemblers</div>
          <div class="text-small" style="color: #94a3b8;">CA65, SjASMPlus, VASM, NESASM</div>
        </div>
        <div style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);">
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">💻</div>
          <div class="text-bold" style="color: #60a5fa;">VS Code Ready</div>
          <div class="text-small" style="color: #94a3b8;">One-click builds & debugging</div>
        </div>
        <div style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);">
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">📚</div>
          <div class="text-bold" style="color: #facc15;">16 Examples</div>
          <div class="text-small" style="color: #94a3b8;">From Hello World to demos</div>
        </div>
        <div style="background-color: #1e293b; border-radius: var(--radius-lg); padding: var(--space-lg);">
          <div style="font-size: 1.5rem; margin-bottom: var(--space-sm);">🎮</div>
          <div class="text-bold" style="color: #c084fc;">Emulator Ready</div>
          <div class="text-small" style="color: #94a3b8;">Test on authentic emulators</div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero" style="background: linear-gradient(to right, var(--brand-red), var(--brand-blue));">
    <div class="container text-center">
      <h2 style="font-size: 1.875rem; font-weight: 700; margin-bottom: var(--space-lg); color: var(--text-inverse);">Ready to Start Your Journey?</h2>
      <p style="font-size: 1.25rem; color: rgba(191, 219, 254, 0.9); margin-bottom: var(--space-2xl); max-width: 42rem; margin-left: auto; margin-right: auto;">
        Download the development environment, or start with our interactive lessons.
        Each approach gives you hands-on experience with vintage computer programming.
      </p>
      <div class="hero-actions">
        <a href="/download" class="btn btn-secondary btn-large">
          Get Dev Environment
        </a>
        <a href="/lessons/commodore-64" class="btn btn-large" style="background-color: var(--brand-amber); color: var(--text-primary);">
          Start with Lessons
        </a>
      </div>
    </div>
  </div>
</Layout>
