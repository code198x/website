---
import Layout from '../layouts/Layout.astro';
import SystemCard from '../components/SystemCard.astro';
import VaultCard from '../components/VaultCard.astro';
import { Gamepad2, Cpu, Terminal } from '@lucide/astro';

const systems = [
  {
    href: '/commodore-64',
    name: 'C64',
    year: '1982',
    chip: 'MOS 6510',
    tagline: 'Where bedroom coders became legends',
    platformColor: 'var(--c64-blue)',
    status: 'Game 1 Phase 2 live',
  },
  {
    href: '/sinclair-zx-spectrum',
    name: 'SPECTRUM',
    year: '1982',
    chip: 'Zilog Z80',
    tagline: "Britain's home computing revolution",
    platformColor: 'var(--zx-magenta)',
    status: 'Game 1 Phase 1 live',
  },
  {
    href: '/nintendo-entertainment-system',
    name: 'NES',
    year: '1983',
    chip: 'Ricoh 2A03',
    tagline: 'The console that saved gaming',
    platformColor: 'var(--nes-red)',
    status: 'Game 1 Phase 1 live',
  },
  {
    href: '/commodore-amiga',
    name: 'AMIGA',
    year: '1985',
    chip: 'MC68000',
    tagline: 'A decade ahead of its time',
    platformColor: 'var(--amiga-orange)',
    status: 'Game 1 Phase 1 live',
  },
];

const vaultArticles = [
  {
    href: '/vault/culture/bedroom-coder',
    kicker: 'Culture',
    title: 'The Rise of the Bedroom Coder',
    description: 'How teenagers in their bedrooms created an industry and changed gaming forever.',
  },
  {
    href: '/vault/hardware/vic-ii',
    kicker: 'Hardware',
    title: 'Inside the VIC-II',
    description: 'The graphics chip that gave the C64 its visual identity and pushed developers to new heights.',
  },
  {
    href: '/vault/hardware/sid-chip',
    kicker: 'Hardware',
    title: 'The SID Chip',
    description: 'Why the 6581 became legendary and how composers created music that still resonates.',
  },
];
---

<Layout
  title="Learn Programming by Building Retro Games"
  description="Learn programming by building real games for the Commodore 64, ZX Spectrum, NES, and Amiga. Master assembly through complete game projects. Modern Docker toolchain, 100% open source."
>
  <style>
    /* Hero Section */
    .hero {
      min-height: calc(100vh - 200px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-8) var(--space-4);
      background: linear-gradient(135deg,
        var(--color-bg) 0%,
        var(--color-bg-secondary) 100%);
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(0deg, transparent 24%, rgba(0, 0, 0, 0.02) 25%, rgba(0, 0, 0, 0.02) 26%, transparent 27%, transparent 74%, rgba(0, 0, 0, 0.02) 75%, rgba(0, 0, 0, 0.02) 76%, transparent 77%, transparent),
        linear-gradient(90deg, transparent 24%, rgba(0, 0, 0, 0.02) 25%, rgba(0, 0, 0, 0.02) 26%, transparent 27%, transparent 74%, rgba(0, 0, 0, 0.02) 75%, rgba(0, 0, 0, 0.02) 76%, transparent 77%, transparent);
      background-size: 30px 30px;
      opacity: 0.22;
    }

    .hero-content {
      max-width: 1000px;
      text-align: center;
      z-index: 1;
    }

    .hero-logo {
      width: 100%;
      max-width: 500px;
      height: auto;
      margin-bottom: var(--space-6);
    }

    .hero-subtitle {
      font-size: clamp(1.25rem, 3vw, 1.75rem);
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      font-weight: 500;
    }

    .hero-description {
      font-size: 1.125rem;
      line-height: 1.8;
      color: var(--color-text);
      margin-bottom: var(--space-8);
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .status-badge {
      display: block;
      width: fit-content;
      margin-inline: auto;
      background: color-mix(in oklab, var(--color-surface) 90%, var(--color-bg) 10%);
      border: 2px solid var(--color-accent);
      color: var(--color-accent);
      padding: var(--space-2) var(--space-4);
      border-radius: 9999px;
      font-weight: 600;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: var(--space-6);
    }

    /* System Cards Grid */
    .systems-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
      margin: var(--space-12) 0;
      width: 100%;
    }

    /* Vault Section */
    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
    }

    .vault-container {
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .vault-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
    }

    .vault-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 0;
    }

    .vault-link {
      font-size: 0.9rem;
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
    }

    .vault-link:hover {
      text-decoration: underline;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    /* CTA Section */
    .cta-section {
      padding: var(--space-16) var(--space-4);
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      text-align: center;
    }

    .cta-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: var(--space-4);
      color: var(--color-primary);
    }

    .cta-description {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-buttons {
      display: flex;
      gap: var(--space-4);
      justify-content: center;
      flex-wrap: wrap;
    }

    /* Extend global .btn for icon support */
    .cta-buttons .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    /* Features Section */
    .features {
      padding: var(--space-16) var(--space-4);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-8);
      margin-top: var(--space-8);
    }

    .feature {
      text-align: center;
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto var(--space-4);
      color: var(--color-primary);
    }

    .feature-icon svg {
      width: 100%;
      height: 100%;
    }

    .feature-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .feature-description {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .feature-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .feature-link:hover {
      transform: translateY(-2px);
    }

    .feature-cta {
      color: var(--color-primary);
      font-weight: 600;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .systems-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-3);
      }
    }

    @media (max-width: 500px) {
      .systems-grid {
        grid-template-columns: 1fr;
      }

      .vault-grid { grid-template-columns: 1fr; }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }

      .btn {
        width: 100%;
        max-width: 300px;
        justify-content: center;
      }
    }
  </style>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="status-badge">Now live: 4 platforms · 80 lessons · More added weekly</div>

      <img src="/logo-stacked.svg" alt="Code Like It's 198x" class="hero-logo" />

      <p class="hero-subtitle">Learn Assembly by Building Games</p>
      <p style="font-style: italic; opacity: 0.9; margin-top: -0.5rem;">Still teaching the world to code, 40 years later.</p>

      <p class="hero-description">
        No experience required. Learn by building complete games — each one teaches new skills while creating something you'll want to play.
        Pick your platform and work through progressively more ambitious projects.
        <strong>Modern Docker toolchains for zero-setup builds. 100% open source.</strong>
      </p>

      <div class="systems-grid">
        {systems.map((system) => (
          <SystemCard
            href={system.href}
            name={system.name}
            year={system.year}
            chip={system.chip}
            tagline={system.tagline}
            platformColor={system.platformColor}
            status={system.status}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: var(--space-2);">Complete Games. Real Hardware. Deep Learning.</h2>
    <p style="text-align: center; color: var(--color-text-secondary); max-width: 700px; margin: 0 auto;">
      Each game teaches skills you'll use in the next. By the end, you'll have built a library of games and mastered the hardware.
    </p>

    <div class="features-grid">
      <div class="feature">
        <div class="feature-icon">
          <Gamepad2 size={48} />
        </div>
        <h3 class="feature-title">Build Complete Games</h3>
        <p class="feature-description">
          Not exercises — real games. Rhythm games, shooters, platformers, puzzle games.
          Each one you finish is something you'll want to show off and play.
        </p>
      </div>

      <div class="feature">
        <div class="feature-icon">
          <Cpu size={48} />
        </div>
        <h3 class="feature-title">Master the Hardware</h3>
        <p class="feature-description">
          Learn the actual chips that powered the era — graphics, sound, input.
          Understand cycle timing, memory maps, and the tricks that made classic games possible.
        </p>
      </div>

      <a href="/setup" class="feature feature-link">
        <div class="feature-icon">
          <Terminal size={48} />
        </div>
        <h3 class="feature-title">Zero-Config Setup</h3>
        <p class="feature-description">
          No toolchain installation. Docker handles everything — assemblers, emulators, build tools.
          One command to build and test. <span class="feature-cta">Get started →</span>
        </p>
      </a>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <div class="vault-header">
        <h2 class="vault-title">From the Vault</h2>
        <a href="/vault" class="vault-link">View all articles →</a>
      </div>
      <div class="vault-grid">
        {vaultArticles.map((article) => (
          <VaultCard
            href={article.href}
            kicker={article.kicker}
            title={article.title}
            description={article.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <h2 class="cta-title">100% Open Source. Forever Free.</h2>

    <p class="cta-description">
      This project is built in the open. Watch it grow, contribute your own games,
      or fork it and make it yours. The knowledge belongs to everyone.
    </p>

    <div class="cta-buttons">
      <a href="/setup" class="btn btn-primary">
        Get Your Toolchain
      </a>

      <a href="https://github.com/code198x" class="btn btn-secondary">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        View on GitHub
      </a>

      <a href="https://www.patreon.com/c/code_like_its_198x" class="btn btn-secondary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.386.524c-4.764 0-8.64 3.876-8.64 8.64 0 4.75 3.876 8.613 8.64 8.613 4.75 0 8.614-3.864 8.614-8.613C24 4.4 20.136.524 15.386.524M.003 23.537h4.22V.524H.003"/>
        </svg>
        Support on Patreon
      </a>
    </div>

    <p style="margin-top: var(--space-6); color: var(--color-text-muted); font-size: 0.875rem;">
      All games and lessons are free and open source. If you find value in this project, consider supporting its development.
    </p>
  </section>
</Layout>
