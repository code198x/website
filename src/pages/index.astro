---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allSystems = await getCollection('systems');
const lessons = await getCollection('lessons');

// Filter to only show systems that have lessons
const systemsWithLessons = allSystems.filter(system => {
  return lessons.some(lesson => lesson.id.startsWith(system.slug));
});

// Sort systems by order
const sortedSystems = systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Learn Vintage Computer Programming">
  <div class="bg-gradient-to-br from-brand-red via-brand-amber to-brand-blue text-white">
    <div class="container mx-auto px-4 py-16">
      <div class="text-center mb-12">
        <div class="inline-block bg-amber-500 text-amber-900 px-4 py-2 rounded-full text-sm font-semibold mb-4">
          🚀 Tier 1 Preview - Early Access
        </div>
        <h1 class="text-5xl md:text-6xl font-bold mb-6 text-white">
          Master vintage computer programming
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 mb-4 max-w-3xl mx-auto">
          Learn through hands-on lessons, interactive emulators, and real projects. 
          Discover the fundamentals that shaped modern computing.
        </p>
        <p class="text-lg text-blue-200 mb-8 max-w-2xl mx-auto">
          <strong>Early Access:</strong> First lessons available for C64, NES, and ZX Spectrum. 
          <strong>Roadmap:</strong> 32 total systems planned (1977-2001).
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/download" class="px-8 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-500 transition-colors flex items-center justify-center">
            <span class="text-xl mr-2">⬇️</span>
            Download Dev Environment
          </a>
          <a href="/lessons/commodore-64" class="px-8 py-3 bg-white text-gray-900 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
            Start with C64 Lessons
          </a>
          <a href="/lessons" class="px-8 py-3 border border-white text-white font-semibold rounded-lg hover:bg-white hover:text-gray-900 transition-colors">
            Browse All Systems
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Choose Your System</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Learn assembly programming through hands-on game development. Each system will eventually offer 
        comprehensive courses, but we're starting with foundational lessons for select systems.
      </p>
      <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-lg max-w-4xl mx-auto">
        <p class="text-sm text-amber-800">
          <strong>🚀 Early Access:</strong> C64 (8 lessons), NES & ZX Spectrum (1 lesson each). 
          <strong>📅 Coming Soon:</strong> More lessons + Apple II & BBC Micro.
          <a href="/systems" class="underline hover:no-underline">View full roadmap →</a>
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {sortedSystems.map((system) => {
        // Define system-specific colors
        const getSystemColors = (slug) => {
          switch(slug) {
            case 'commodore-64':
              return { bg: 'bg-c64-brown', button: 'bg-c64-dark-brown hover:bg-c64-brown' };
            case 'zx-spectrum':
              return { bg: 'bg-spectrum-red', button: 'bg-spectrum-blue hover:bg-spectrum-magenta' };
            case 'nintendo-entertainment-system':
              return { bg: 'bg-nes-red', button: 'bg-nes-gray hover:bg-nes-dark-gray' };
            case 'commodore-amiga':
              return { bg: 'bg-amiga-blue', button: 'bg-amiga-orange hover:bg-amiga-blue' };
            default:
              return { bg: 'bg-gray-200', button: 'bg-blue-600 hover:bg-blue-700' };
          }
        };
        const colors = getSystemColors(system.slug);
        
        return (
          <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow flex flex-col">
            <div class={`h-48 ${colors.bg} flex items-center justify-center`}>
              <span class="text-4xl text-white">💻</span>
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-bold text-gray-900 mb-2">{system.data.name}</h3>
              <p class="text-gray-600 text-sm mb-4 flex-grow">
                {system.data.historical_significance?.slice(0, 120)}...
              </p>
              <div class="text-xs text-gray-500 mb-4">
                <div><strong>CPU:</strong> {system.data.cpu}</div>
                <div><strong>RAM:</strong> {system.data.ram}</div>
                <div><strong>Released:</strong> {system.data.release_date.global.getFullYear()}</div>
              </div>
              <a 
                href={`/lessons/${system.slug}`}
                class={`block w-full text-center px-4 py-2 ${colors.button} text-white font-medium rounded transition-colors mt-auto`}
              >
                Start Learning →
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="bg-c64-beige-dark py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Why Learn Vintage Programming?</h2>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-brand-blue rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🧠</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Understanding Fundamentals</h3>
          <p class="text-gray-600">
            Learn how computers actually work by programming close to the hardware. 
            Understand memory, CPU, and I/O in ways modern abstractions hide.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-brand-red rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">⚡</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Resource Constraints</h3>
          <p class="text-gray-600">
            Master optimization by working within tight memory and processing limits. 
            These skills translate directly to modern embedded and mobile development.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-brand-amber rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🎨</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Creative Problem Solving</h3>
          <p class="text-gray-600">
            Discover how limitations breed creativity. Learn the techniques that created 
            iconic games and applications with minimal resources.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Explore the History</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Discover the people, companies, and events that shaped the digital revolution.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-white/95 rounded-lg shadow-lg p-8 text-center border border-c64-beige-darker">
          <div class="w-16 h-16 bg-spectrum-blue rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">📅</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Interactive Timeline</h3>
          <p class="text-gray-600 mb-6">
            Explore the chronological story of computing from the 1970s through the 1990s, 
            including major world events that shaped the industry.
          </p>
          <a href="/timeline" class="px-6 py-2 bg-spectrum-blue text-white font-medium rounded hover:bg-spectrum-magenta transition-colors">
            View Timeline →
          </a>
        </div>
        
        <div class="bg-white/95 rounded-lg shadow-lg p-8 text-center border border-c64-beige-darker">
          <div class="w-16 h-16 bg-c64-brown rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🏛️</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">The Vault</h3>
          <p class="text-gray-600 mb-6">
            Deep dive into the stories of pioneering engineers, visionary companies, 
            and the technology that changed the world.
          </p>
          <a href="/vault" class="px-6 py-2 bg-amiga-orange text-white font-medium rounded hover:bg-amiga-blue transition-colors">
            Explore Vault →
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-gray-900 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Professional Development Environment</h2>
      <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
        Get a complete retro development setup with VS Code integration, Docker containers, 
        authentic assemblers, and 16 example programs. Everything you need to start coding like it's 198x!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
        <a href="/download" class="px-8 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-500 transition-colors flex items-center text-lg">
          <span class="text-2xl mr-3">🚀</span>
          Download Development Environment
        </a>
        <div class="text-gray-400 text-sm">
          Free • Open Source • Cross-Platform
        </div>
      </div>
      
      <div class="grid md:grid-cols-4 gap-4 max-w-3xl mx-auto text-sm">
        <div class="bg-gray-800 rounded-lg p-4">
          <div class="text-2xl mb-2">🛠️</div>
          <div class="font-semibold text-green-400">4 Assemblers</div>
          <div class="text-gray-400">CA65, SjASMPlus, VASM, NESASM</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-4">
          <div class="text-2xl mb-2">💻</div>
          <div class="font-semibold text-blue-400">VS Code Ready</div>
          <div class="text-gray-400">One-click builds & debugging</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-4">
          <div class="text-2xl mb-2">📚</div>
          <div class="font-semibold text-yellow-400">16 Examples</div>
          <div class="text-gray-400">From Hello World to demos</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-4">
          <div class="text-2xl mb-2">🎮</div>
          <div class="font-semibold text-purple-400">Emulator Ready</div>
          <div class="text-gray-400">Test on authentic emulators</div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-gradient-to-r from-brand-red to-brand-blue text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Start Your Journey?</h2>
      <p class="text-xl text-blue-200 mb-8 max-w-2xl mx-auto">
        Download the development environment, or start with our interactive lessons.
        Each approach gives you hands-on experience with vintage computer programming.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/download" class="px-8 py-3 bg-white text-gray-900 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Get Dev Environment
        </a>
        <a href="/lessons/commodore-64" class="px-8 py-3 bg-brand-amber text-gray-900 font-semibold rounded-lg hover:bg-brand-amber-dark transition-colors">
          Start with Lessons
        </a>
      </div>
    </div>
  </div>
</Layout>
