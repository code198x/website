---
import Layout from '../layouts/Layout.astro';
import { Gamepad2, Cpu, Terminal } from '@lucide/astro';
---

<Layout
  title="Learn Programming by Building Retro Games"
  description="Learn programming by building real games for the Commodore 64, ZX Spectrum, NES, and Amiga. Master assembly through complete game projects. Modern Docker toolchain, 100% open source."
>
  <style>
    /* Hero Section */
    .hero {
      min-height: calc(100vh - 200px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-8) var(--space-4);
      background: linear-gradient(135deg,
        var(--color-bg) 0%,
        var(--color-bg-secondary) 100%);
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        linear-gradient(0deg, transparent 24%, rgba(0, 0, 0, 0.02) 25%, rgba(0, 0, 0, 0.02) 26%, transparent 27%, transparent 74%, rgba(0, 0, 0, 0.02) 75%, rgba(0, 0, 0, 0.02) 76%, transparent 77%, transparent),
        linear-gradient(90deg, transparent 24%, rgba(0, 0, 0, 0.02) 25%, rgba(0, 0, 0, 0.02) 26%, transparent 27%, transparent 74%, rgba(0, 0, 0, 0.02) 75%, rgba(0, 0, 0, 0.02) 76%, transparent 77%, transparent);
      background-size: 30px 30px;
      opacity: 0.22;
    }

    .hero-content {
      max-width: 900px;
      text-align: center;
      z-index: 1;
    }

    .hero-logo {
      width: 100%;
      max-width: 500px;
      height: auto;
      margin-bottom: var(--space-6);
    }

    .hero-subtitle {
      font-size: clamp(1.25rem, 3vw, 1.75rem);
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      font-weight: 500;
    }

    .hero-description {
      font-size: 1.125rem;
      line-height: 1.8;
      color: var(--color-text);
      margin-bottom: var(--space-8);
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .status-badge {
      display: block;
      width: fit-content;
      margin-inline: auto;
      background: color-mix(in oklab, var(--color-surface) 90%, var(--color-bg) 10%);
      border: 2px solid var(--color-accent);
      color: var(--color-accent);
      padding: var(--space-2) var(--space-4);
      border-radius: 9999px;
      font-weight: 600;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: var(--space-6);
    }

    /* System Cards */
    .systems-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--space-4);
      margin: var(--space-12) 0;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Vault Section */
    .vault-section {
      padding: var(--space-12) var(--space-4);
      background: var(--color-bg-secondary);
    }

    .vault-container {
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .vault-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
    }

    .vault-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 0;
    }

    .vault-link {
      font-size: 0.9rem;
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
    }

    .vault-link:hover {
      text-decoration: underline;
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .vault-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-text);
      transition: all var(--transition-base);
    }

    .vault-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--color-primary);
    }

    .vault-kicker {
      display: block;
      font-size: 0.75rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: var(--space-2);
    }

    .vault-name {
      display: block;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: var(--space-2);
    }

    .vault-excerpt {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .system-card {
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      border-radius: 0.75rem;
      padding: var(--space-6);
      text-align: center;
      transition: all var(--transition-base);
      cursor: pointer;
      text-decoration: none;
      color: var(--color-text);
      position: relative;
      overflow: hidden;
    }

    .system-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--system-color);
      transform: scaleX(0);
      transition: transform var(--transition-base);
    }

    .system-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--system-color);
    }

    .system-card:hover::before {
      transform: scaleX(1);
    }

    .system-card.c64 { --system-color: var(--c64-blue); }
    .system-card.zx { --system-color: var(--zx-magenta); }
    .system-card.nes { --system-color: var(--nes-red); }
    .system-card.amiga { --system-color: var(--amiga-orange); }

    .system-name {
      font-family: var(--font-family-mono);
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-2);
      color: var(--system-color);
    }

    .system-year {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      margin-bottom: var(--space-1);
    }

    .system-chip {
      font-family: var(--font-family-mono);
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      font-weight: 500;
    }

    .system-tagline {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
      margin-top: var(--space-2);
      line-height: 1.4;
    }

    .system-status {
      margin-top: var(--space-3);
      font-size: 0.75rem;
      color: var(--color-text-muted);
      font-style: italic;
    }

    /* CTA Section */
    .cta-section {
      padding: var(--space-16) var(--space-4);
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      text-align: center;
    }

    .cta-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: var(--space-4);
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .cta-description {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-8);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-buttons {
      display: flex;
      gap: var(--space-4);
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: var(--space-3) var(--space-6);
      border-radius: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: all var(--transition-base);
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    .btn-primary {
      background: var(--color-primary);
      color: white;
      border: 2px solid var(--color-primary);
    }

    .btn-primary:hover {
      background: var(--color-primary-dark);
      border-color: var(--color-primary-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .btn-secondary {
      background: transparent;
      color: var(--color-text);
      border: 2px solid var(--color-border);
    }

    .btn-secondary:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      transform: translateY(-2px);
    }

    /* Features Section */
    .features {
      padding: var(--space-16) var(--space-4);
      max-width: var(--container-max-width);
      margin: 0 auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-8);
      margin-top: var(--space-8);
    }

    .feature {
      text-align: center;
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto var(--space-4);
      color: var(--color-primary);
    }

    .feature-icon svg {
      width: 100%;
      height: 100%;
    }

    .feature-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--space-3);
      color: var(--color-text);
    }

    .feature-description {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .feature-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .feature-link:hover {
      transform: translateY(-2px);
    }

    .feature-cta {
      color: var(--color-primary);
      font-weight: 600;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .systems-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-3);
      }

      .vault-grid { grid-template-columns: 1fr; }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }

      .btn {
        width: 100%;
        max-width: 300px;
        justify-content: center;
      }
    }
  </style>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="status-badge">Game 1 Phase 1 on all platforms · C64 up to Phase 2</div>

      <img src="/logo-stacked.svg" alt="Code Like It's 198x" class="hero-logo" />

      <p class="hero-subtitle">Learn Assembly by Building Games</p>
      <p style="font-style: italic; opacity: 0.9; margin-top: -0.5rem;">Still teaching the world to code, 40 years later.</p>

      <p class="hero-description">
        No experience required. Learn by building complete games — each one teaches new skills while creating something you'll want to play.
        Pick your platform and work through progressively more ambitious projects.
        <strong>Modern Docker toolchains for zero-setup builds. 100% open source.</strong>
      </p>

      <div class="systems-grid">
        <a href="/commodore-64" class="system-card c64">
          <div class="system-name">C64</div>
          <div class="system-year">1982</div>
          <div class="system-chip">MOS 6510</div>
          <div class="system-tagline">Where bedroom coders became legends</div>
          <div class="system-status">Game 1 Phase 2 live</div>
        </a>

        <a href="/sinclair-zx-spectrum" class="system-card zx">
          <div class="system-name">SPECTRUM</div>
          <div class="system-year">1982</div>
          <div class="system-chip">Zilog Z80</div>
          <div class="system-tagline">Britain's home computing revolution</div>
          <div class="system-status">Game 1 Phase 1 live</div>
        </a>

        <a href="/nintendo-entertainment-system" class="system-card nes">
          <div class="system-name">NES</div>
          <div class="system-year">1983</div>
          <div class="system-chip">Ricoh 2A03</div>
          <div class="system-tagline">The console that saved gaming</div>
          <div class="system-status">Game 1 Phase 1 live</div>
        </a>

        <a href="/commodore-amiga" class="system-card amiga">
          <div class="system-name">AMIGA</div>
          <div class="system-year">1985</div>
          <div class="system-chip">MC68000</div>
          <div class="system-tagline">A decade ahead of its time</div>
          <div class="system-status">Game 1 Phase 1 live</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: var(--space-2);">Complete Games. Real Hardware. Deep Learning.</h2>
    <p style="text-align: center; color: var(--color-text-secondary); max-width: 700px; margin: 0 auto;">
      Each game teaches skills you'll use in the next. By the end, you'll have built a library of games and mastered the hardware.
    </p>

    <div class="features-grid">
      <div class="feature">
        <div class="feature-icon">
          <Gamepad2 size={48} />
        </div>
        <h3 class="feature-title">Build Complete Games</h3>
        <p class="feature-description">
          Not exercises — real games. Rhythm games, shooters, platformers, puzzle games.
          Each one you finish is something you'll want to show off and play.
        </p>
      </div>

      <div class="feature">
        <div class="feature-icon">
          <Cpu size={48} />
        </div>
        <h3 class="feature-title">Master the Hardware</h3>
        <p class="feature-description">
          Learn the actual chips that powered the era — graphics, sound, input.
          Understand cycle timing, memory maps, and the tricks that made classic games possible.
        </p>
      </div>

      <a href="/setup" class="feature feature-link">
        <div class="feature-icon">
          <Terminal size={48} />
        </div>
        <h3 class="feature-title">Zero-Config Setup</h3>
        <p class="feature-description">
          No toolchain installation. Docker handles everything — assemblers, emulators, build tools.
          One command to build and test. <span class="feature-cta">Get started →</span>
        </p>
      </a>
    </div>
  </section>

  <!-- Vault Section -->
  <section class="vault-section">
    <div class="vault-container">
      <div class="vault-header">
        <h2 class="vault-title">From the Vault</h2>
        <a href="/vault" class="vault-link">View all articles →</a>
      </div>
      <div class="vault-grid">
        <a href="/vault/culture/bedroom-coder" class="vault-card">
          <span class="vault-kicker">Culture</span>
          <span class="vault-name">The Rise of the Bedroom Coder</span>
          <span class="vault-excerpt">How teenagers in their bedrooms created an industry and changed gaming forever.</span>
        </a>
        <a href="/vault/hardware/vic-ii" class="vault-card">
          <span class="vault-kicker">Hardware</span>
          <span class="vault-name">Inside the VIC-II</span>
          <span class="vault-excerpt">The graphics chip that gave the C64 its visual identity and pushed developers to new heights.</span>
        </a>
        <a href="/vault/hardware/sid-chip" class="vault-card">
          <span class="vault-kicker">Hardware</span>
          <span class="vault-name">The SID Chip</span>
          <span class="vault-excerpt">Why the 6581 became legendary and how composers created music that still resonates.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <h2 class="cta-title">100% Open Source. Forever Free.</h2>

    <p class="cta-description">
      This project is built in the open. Watch it grow, contribute your own games,
      or fork it and make it yours. The knowledge belongs to everyone.
    </p>

    <div class="cta-buttons">
      <a href="/setup" class="btn btn-primary">
        Get Your Toolchain
      </a>

      <a href="https://github.com/code198x" class="btn btn-secondary">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        View on GitHub
      </a>

      <a href="https://www.patreon.com/c/code_like_its_198x" class="btn btn-secondary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.386.524c-4.764 0-8.64 3.876-8.64 8.64 0 4.75 3.876 8.613 8.64 8.613 4.75 0 8.614-3.864 8.614-8.613C24 4.4 20.136.524 15.386.524M.003 23.537h4.22V.524H.003"/>
        </svg>
        Support on Patreon
      </a>
    </div>

    <p style="margin-top: var(--space-6); color: var(--color-text-muted); font-size: 0.875rem;">
      All games and lessons are free and open source. If you find value in this project, consider supporting its development.
    </p>
  </section>
</Layout>
