---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";

const allSystems = await getCollection("systems");
const lessons = await getCollection("lessons");

// Filter to only show systems that have lessons
const systemsWithLessons = allSystems.filter((system) => {
  return lessons.some((lesson) => lesson.id.startsWith(system.slug));
});

// Sort systems by order
const sortedSystems = systemsWithLessons.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Learn Vintage Computer Programming" isHomepage={true}>
  <div class="hero">
    <div class="container">
      <Hero
        title="Build Real Games on Real Retro Hardware"
        subtitle="Write assembly code for Commodore 64 (available now), plus NES, ZX Spectrum, Amiga, and many more classic systems coming soon. No emulation theory—just pure programming power."
        description="Start with <code>POKE 53280,0</code> to change the border. End with smooth-scrolling games, demo effects, and tracker music. Every lesson runs on original hardware."
        variant="default"
        badge={{
          text: "100% Hands-On Assembly",
          color: "#10b981"
        }}
        actions={[
          {
            text: "Get Started",
            href: "/getting-started",
            variant: "primary",
            icon: "🚀"
          },
          {
            text: "Explore Lessons",
            href: "/lessons",
            variant: "secondary",
            icon: "📚"
          }
        ]}
      />
    </div>
  </div>

  <div class="feature-section" style="padding-top: var(--space-2xl); padding-bottom: var(--space-3xl);">
    <!-- Phase 0 BASIC Section -->
    <div class="container">
      <div style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); border-radius: 16px; padding: var(--space-3xl); text-align: center; color: white; position: relative; overflow: hidden;">
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.2) 0%, transparent 50%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1;">
          <div style="display: inline-block; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.3); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; margin-bottom: var(--space-lg);">
            🚀 COMING SOON: Phase 0 - Start with BASIC
          </div>
          <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg); text-wrap: balance;">
            Never Programmed Before? Start Here!
          </h2>
          <p style="font-size: 1.25rem; line-height: 1.6; margin-bottom: var(--space-2xl); max-width: 42rem; margin-left: auto; margin-right: auto; opacity: 0.95;">
            Phase 0 will teach BASIC on systems that support it. Perfect for absolute beginners—learn variables, loops, and game logic with instant visual feedback. When you're ready, graduate to assembly programming.
          </p>
          <div style="background: rgba(0, 0, 0, 0.2); border-radius: 12px; padding: var(--space-xl); max-width: 36rem; margin: 0 auto var(--space-2xl); font-family: var(--font-mono); font-size: 1.125rem; text-align: left;">
            <div style="opacity: 0.9;">10 PRINT "HELLO WORLD"</div>
            <div style="opacity: 0.9;">20 FOR I = 1 TO 10</div>
            <div style="opacity: 0.9;">30 POKE 53280, I</div>
            <div style="opacity: 0.9;">40 NEXT I</div>
            <div style="opacity: 0.9;">RUN</div>
          </div>
          <div style="display: inline-block; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); padding: var(--space-md) var(--space-xl); border-radius: 9999px; border: 1px solid rgba(255, 255, 255, 0.2);">
            <span style="font-weight: 600; font-size: 1.125rem;">📅 Coming Q4 2025</span>
          </div>
          <p style="margin-top: var(--space-lg); font-size: 0.875rem; opacity: 0.9;">
            Phase 0 BASIC lessons for C64, ZX Spectrum, Apple II, and more systems coming soon!
          </p>
        </div>
      </div>
    </div>

    <!-- Systems with actual content -->
    <div class="container" style="margin-top: var(--space-3xl);">
      <SectionHeader
        title="Available Systems"
        subtitle="We're starting with these classic systems. More lessons are being developed each week."
      />
      <Grid columns={3} gap="large" variant="cards">
        {
          sortedSystems.map((system) => {
            // Define system-specific colors using CSS custom properties
            const getSystemColors = (slug: string) => {
              switch (slug) {
                case "commodore-64":
                  return {
                    bg: "system-c64",
                    buttonStyle: "background-color: var(--c64-dark-brown);",
                  };
                case "zx-spectrum":
                  return {
                    bg: "system-spectrum",
                    buttonStyle: "background-color: var(--spectrum-blue);",
                  };
                case "nintendo-entertainment-system":
                  return { bg: "system-nes", buttonStyle: "background-color: var(--nes-gray);" };
                case "commodore-amiga":
                  return {
                    bg: "system-amiga",
                    buttonStyle: "background-color: var(--amiga-orange);",
                  };
                default:
                  return { bg: "bg-slate-200", buttonStyle: "background-color: #2563eb;" };
              }
            };
            const colors = getSystemColors(system.slug);

            return (
              <Card
                variant="system"
                headerColor={colors.bg}
                headerIcon="💻"
                title={system.data.name}
                description={system.data.historical_significance?.slice(0, 120) + "..."}
                meta={[
                  { label: "CPU", value: system.data.cpu },
                  { label: "RAM", value: system.data.ram },
                  { label: "Released", value: system.data.release_date.global.getFullYear().toString() }
                ]}
                actions={[
                  { 
                    text: "Start Learning →", 
                    href: `/lessons/${system.slug}`,
                    style: `${colors.buttonStyle} color: var(--text-inverse);`
                  }
                ]}
              />
            );
          })
        }
      </Grid>
    </div>
  </div>

  <!-- Why Learn Section - Full Width -->
  <div style="background: var(--bg-muted); padding: var(--space-4xl) 0; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;">
    <div class="container">
      <h2 style="font-size: 2.5rem; font-weight: 700; text-align: center; margin-bottom: var(--space-xl); color: var(--text-primary);">
        Why Learn Assembly on Vintage Hardware?
      </h2>
      <p style="font-size: 1.25rem; text-align: center; color: var(--text-secondary); max-width: 48rem; margin: 0 auto var(--space-3xl);">
        These aren't just history lessons—these are the foundations that power everything from embedded systems to modern game engines.
      </p>

      <Grid columns={3} gap="large">
        <div class="text-center">
          <div style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #3b82f6, #1e40af); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg); box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.25);">
            <span style="font-size: 1.75rem;">🧠</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">
            True Understanding
          </h3>
          <p style="color: var(--text-secondary); line-height: 1.6;">
            No abstractions. No frameworks. Just you, the CPU, and memory. Learn how computers actually work at the fundamental level.
          </p>
        </div>

        <div class="text-center">
          <div style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg); box-shadow: 0 10px 25px -5px rgba(239, 68, 68, 0.25);">
            <span style="font-size: 1.75rem;">⚡</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">
            Optimization Mastery
          </h3>
          <p style="color: var(--text-secondary); line-height: 1.6;">
            When you have 64KB of RAM and a 1MHz CPU, every byte and cycle counts. Skills that translate directly to modern performance-critical code.
          </p>
        </div>

        <div class="text-center">
          <div style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-lg); box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.25);">
            <span style="font-size: 1.75rem;">🎮</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md);">
            Create Real Games
          </h3>
          <p style="color: var(--text-secondary); line-height: 1.6;">
            Build actual games that run on original hardware. From sprites to scrolling, sound to joystick input—create the magic yourself.
          </p>
        </div>
      </Grid>
    </div>
  </div>


  <!-- Professional Tools Section - Full Width Dark -->
  <div style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: var(--space-4xl) 0; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; color: white;">
    <div class="container text-center">
      <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg); color: white;">
        Modern Tools for Retro Development
      </h2>
      <p style="font-size: 1.25rem; opacity: 0.9; margin-bottom: var(--space-3xl); max-width: 56rem; margin-left: auto; margin-right: auto; line-height: 1.6;">
        No hunting for ancient software or fighting with DOSBox. Get a complete, modern development environment with VS Code integration, Docker containers, and authentic assemblers—all pre-configured and ready to go.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-lg); max-width: 64rem; margin: 0 auto var(--space-3xl);">
        <div style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: var(--space-xl); transition: transform 0.2s;">
          <div style="font-size: 2rem; margin-bottom: var(--space-md);">🛠️</div>
          <div style="font-size: 1.125rem; font-weight: 600; color: #10b981; margin-bottom: var(--space-sm);">Authentic Assemblers</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">ACME, ca65, SjASMPlus, VASM, NESASM—the actual tools used in the era</div>
        </div>
        
        <div style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: var(--space-xl); transition: transform 0.2s;">
          <div style="font-size: 2rem; margin-bottom: var(--space-md);">💻</div>
          <div style="font-size: 1.125rem; font-weight: 600; color: #3b82f6; margin-bottom: var(--space-sm);">VS Code Integration</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Syntax highlighting, IntelliSense, one-click build & run</div>
        </div>
        
        <div style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: var(--space-xl); transition: transform 0.2s;">
          <div style="font-size: 2rem; margin-bottom: var(--space-md);">🐳</div>
          <div style="font-size: 1.125rem; font-weight: 600; color: #f59e0b; margin-bottom: var(--space-sm);">Docker Containers</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Zero setup hassle—works on Mac, Windows, and Linux instantly</div>
        </div>
        
        <div style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: var(--space-xl); transition: transform 0.2s;">
          <div style="font-size: 2rem; margin-bottom: var(--space-md);">🎮</div>
          <div style="font-size: 1.125rem; font-weight: 600; color: #a855f7; margin-bottom: var(--space-sm);">Instant Testing</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Build and run on accurate emulators with a single command</div>
        </div>
      </div>

      <a href="/getting-started" style="display: inline-flex; align-items: center; gap: 0.75rem; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: var(--space-md) var(--space-2xl); border-radius: 8px; font-size: 1.25rem; font-weight: 600; text-decoration: none; transition: transform 0.2s; box-shadow: 0 20px 25px -5px rgba(16, 185, 129, 0.25);">
        <span>🚀</span>
        <span>Get Your Dev Environment</span>
      </a>
      <div style="margin-top: var(--space-md); font-size: 0.875rem; opacity: 0.7;">
        Free • Open Source • Works Everywhere
      </div>
    </div>
  </div>

  <!-- Final CTA Section - Full Width -->
  <div style="background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%); padding: var(--space-4xl) 0; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; margin-bottom: 0; overflow: hidden;">
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 30% 70%, rgba(255, 255, 255, 0.1) 0%, transparent 50%); pointer-events: none;"></div>
    <div class="container text-center" style="position: relative; z-index: 1;">
      <h2 style="font-size: 3rem; font-weight: 700; margin-bottom: var(--space-lg); color: white; text-wrap: balance;">
        Join the Retro Revolution
      </h2>
      <p style="font-size: 1.375rem; color: rgba(255, 255, 255, 0.95); margin-bottom: var(--space-3xl); max-width: 48rem; margin-left: auto; margin-right: auto; line-height: 1.6;">
        This is open-source education at its finest. Free forever. Community-driven. Preserving the art of low-level programming for future generations.
      </p>
      
      <div style="display: flex; gap: var(--space-lg); justify-content: center; flex-wrap: wrap; margin-bottom: var(--space-2xl);">
        <a href="/getting-started" style="display: inline-flex; align-items: center; gap: 0.75rem; background: white; color: var(--retro-purple); padding: var(--space-md) var(--space-2xl); border-radius: 8px; font-size: 1.25rem; font-weight: 700; text-decoration: none; transition: all 0.2s; box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.25);">
          <span>Start Learning Today</span>
          <span>→</span>
        </a>
        <a href="https://github.com/code198x" style="display: inline-flex; align-items: center; gap: 0.75rem; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); color: white; padding: var(--space-md) var(--space-2xl); border-radius: 8px; border: 2px solid rgba(255, 255, 255, 0.3); font-size: 1.25rem; font-weight: 600; text-decoration: none; transition: all 0.2s;">
          <span>View on GitHub</span>
        </a>
      </div>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-lg); max-width: 36rem; margin: 0 auto;">
        <div style="text-align: center;">
          <div style="font-size: 2rem; font-weight: 700; color: white;">70+</div>
          <div style="font-size: 0.875rem; color: rgba(255, 255, 255, 0.8);">Classic Systems</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2rem; font-weight: 700; color: white;">4,096</div>
          <div style="font-size: 0.875rem; color: rgba(255, 255, 255, 0.8);">Lessons Per System</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2rem; font-weight: 700; color: white;">100%</div>
          <div style="font-size: 0.875rem; color: rgba(255, 255, 255, 0.8);">Free & Open Source</div>
        </div>
      </div>
    </div>
  </div>
</Layout>
