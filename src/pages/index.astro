---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getAllPlatforms } from '../lib/platforms';
import { getCompleteModulesForPlatform } from '../lib/modules';
import { accessibleInk, SURFACE_LIGHT, SURFACE_DARK } from '../lib/contrast';

const all = await getAllPlatforms();

// What's New — the latest few milestones, newest first (full run at /updates).
const now = new Date();
const latestUpdates = (await getCollection('updates'))
  .filter((u) => !u.data.draft && u.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Brand colour as the card surface var (--pc) plus theme-aware accessible-ink
// variants for small text on the card surface (light #fdfcf7 / dark #242019).
const cardStyle = (color: string) =>
  `--pc: ${color}; --ink-l: ${accessibleInk(color, SURFACE_LIGHT)}; --ink-d: ${accessibleInk(color, SURFACE_DARK)}`;

// The feature band derives entirely from each machine's manifest `tier` (the
// single source of truth, shared with /systems) and its catalogue content, so
// it can never drift. Membership and badge come from `tier`; the order is "most
// content first", measured by shipped (complete) modules — the machine with the
// most curriculum leads, on merit rather than a hand-kept list.
const contentScore = new Map(
  await Promise.all(all.map(async p => [p.id, await getCompleteModulesForPlatform(p.id)] as const))
);
const byContent = (a: typeof all[number], b: typeof all[number]) =>
  (contentScore.get(b.id) ?? 0) - (contentScore.get(a.id) ?? 0);
const live = all.filter(p => p.data.tier === 'live').sort(byContent);
const next = all.filter(p => p.data.tier === 'next').sort(byContent);

const totalCount = all.length;
const liveCount = live.length;

// Decade strip, counts derived from the manifest.
const decadeDefs: [string, number, number, string][] = [
  ['1975–79', 1975, 1979, 'Genesis'],
  ['1980–84', 1980, 1984, 'The home-computer boom'],
  ['1985–89', 1985, 1989, 'Where the curriculum grows'],
  ['1990–94', 1990, 1994, '16-bit · the bridge'],
  ['1995–99', 1995, 1999, 'Edge of our range'],
  ['2000–05', 2000, 2005, 'The hardest cases'],
];
const decades = decadeDefs.map(([label, lo, hi, blurb]) => ({
  label, blurb,
  count: all.filter(p => p.data.year >= lo && p.data.year <= hi).length,
  live: live.some(p => p.data.year >= lo && p.data.year <= hi),
}));

const pillars = [
  { url: '/curriculum', title: 'Curriculum Map', blurb: 'How the learning layers fit together' },
  { url: '/craft', title: 'The Craft', blurb: 'Cross-machine game-making techniques' },
  { url: '/foundations', title: 'Foundations', blurb: 'The ideas every machine shares' },
  { url: '/vault', title: 'The Vault', blurb: 'People · games · hardware · culture' },
  { url: '/patterns', title: 'Pattern Library', blurb: 'Production-ready code, per system' },
  { url: '/standards', title: 'Sources & Standards', blurb: 'What counts as checked, cited, and real' },
  { url: '/timeline', title: 'The Timeline', blurb: 'Hardware alongside the world that shaped it' },
  { url: '/systems', title: 'The Fleet', blurb: 'Every machine we mean to teach' },
];
---

<Layout
  title="Make a real game, on a real old machine"
  description="Learn programming by building complete games on classic 8-bit and 16-bit systems, in the languages people used at the time."
>
  <style>
    .home { max-width: 1160px; margin: 0 auto; padding: 0 var(--space-6) var(--space-16); }
    .kicker {
      font-family: var(--font-family-mono);
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--color-text-secondary);
    }
    .house-rule { height: 9px; width: 220px; background: var(--color-house); position: relative; margin: var(--space-3) 0; }
    .house-rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }

    /* ---- hero ---- */
    .hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--space-10); align-items: end; padding: var(--space-12) 0 var(--space-8); }
    .hero-title { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3.4rem, 7.4vw, 6.25rem); line-height: 0.85; margin: var(--space-2) 0 0; color: var(--color-text); }
    .hero-title .hl { color: var(--color-house-2); }
    .lede { font-size: 1.05rem; max-width: 48ch; margin: var(--space-3) 0 0; color: var(--color-text); }
    .lede .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }
    .cta-row { display: flex; gap: var(--space-3); margin-top: var(--space-5); flex-wrap: wrap; }
    .btn-sm { padding: var(--space-2) var(--space-4); font-size: 0.8rem; }
    .hero-router { font-size: 0.85rem; margin: var(--space-3) 0 0; color: var(--color-text-secondary); }
    .hero-router a { font-family: var(--font-family-mono); font-weight: 700; color: var(--ink); }

    .statbox { border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky); padding: var(--space-5); }
    .stats { margin: var(--space-3) 0 0; display: grid; gap: var(--space-2); }
    .stats > div { display: grid; grid-template-columns: 3.2rem 1fr; gap: var(--space-3); align-items: baseline; }
    .stats dt { font-family: var(--font-family-mono); font-weight: 700; color: var(--color-house-2); text-align: right; }
    .stats dd { margin: 0; font-size: 0.9rem; }
    .deal { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; color: var(--color-house); margin: var(--space-4) 0 0; }

    /* ---- section band ---- */
    .band { margin-top: var(--space-12); }
    .band-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 3px solid var(--color-text); padding-bottom: var(--space-2); margin-bottom: var(--space-6); }
    .band-url { font-family: var(--font-family-mono); font-size: 0.7rem; letter-spacing: 0.12em; color: var(--color-text-secondary); }

    /* ---- platform cards ---- */
    .fleet-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
    .pcard { border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky); text-decoration: none; color: var(--color-text); display: flex; flex-direction: column; overflow: hidden; transition: all var(--transition-base); }
    .pcard:hover, .pcard:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--pc); }
    .pcard .top { height: 7px; background: var(--pc); }
    .pcard.live .top { height: 12px; }
    .pcard .body { padding: var(--space-4); display: flex; flex-direction: column; flex: 1; }
    .pcard .reg { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-family-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); }
    .pcard h3 { font-size: 1.3rem; margin: var(--space-1) 0 0; }
    .pcard .chip { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); margin-top: var(--space-1); }
    .pcard p { font-size: 0.82rem; color: var(--color-text-secondary); margin: var(--space-2) 0 0; }
    .pcard .go { margin-top: auto; padding-top: var(--space-3); font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; }
    .badge { font-family: var(--font-family-mono); font-size: 0.55rem; font-weight: 700; letter-spacing: 0.12em; padding: 2px 6px; border: 2px solid; }
    /* Per-system flourish: a tint ramp of the machine's own brand colour (--pc),
       so each live card carries its own identity. No per-system data — derived. */
    .flourish { display: flex; height: 7px; width: 80px; border: 1.5px solid var(--color-text); margin-top: var(--space-3); }
    .flourish span { flex: 1; }
    .flourish span:nth-child(1) { background: var(--pc); }
    .flourish span:nth-child(2) { background: color-mix(in srgb, var(--pc) 70%, #fff); }
    .flourish span:nth-child(3) { background: color-mix(in srgb, var(--pc) 45%, #fff); }
    .flourish span:nth-child(4) { background: color-mix(in srgb, var(--pc) 25%, #fff); }

    /* ---- decades ---- */
    .decades { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-3); }
    .dec { border: 3px solid var(--color-border); background: var(--color-surface); padding: var(--space-3); }
    .dec.live { border-color: var(--color-house-2); background: var(--color-house-tint); }
    .dec .n { font-family: var(--font-family-mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); }
    .dec .yr { font-family: var(--font-family-read); font-weight: 700; font-size: 1.6rem; line-height: 0.9; margin-top: 2px; }
    .dec p { font-size: 0.72rem; color: var(--color-text-secondary); margin: var(--space-2) 0 0; line-height: 1.35; }

    /* ---- pillars ---- */
    .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--space-4); }
    .pillar { border: 3px solid var(--color-border); background: var(--color-surface); padding: var(--space-4); text-decoration: none; color: var(--color-text); transition: all var(--transition-base); }
    .pillar:hover { transform: translate(-3px, -3px); box-shadow: var(--shadow-chunky); border-color: var(--color-text); }
    .pillar .u { font-family: var(--font-family-mono); font-size: 0.68rem; color: var(--color-house-2); }
    .pillar h3 { font-size: 1.2rem; margin: var(--space-1) 0 0; }
    .pillar p { font-size: 0.8rem; color: var(--color-text-secondary); margin: var(--space-2) 0 0; }

    /* ---- what's new ---- */
    .band-link { color: var(--color-house-2); font-weight: 700; text-decoration: none; }
    .band-link:hover { text-decoration: underline; }
    .news-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
    .ncard { --nc: var(--color-house-2); position: relative; border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
      padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5); text-decoration: none; color: var(--color-text); display: flex; flex-direction: column; transition: all var(--transition-base); }
    .ncard::before { content: ""; position: absolute; top: 0; left: 0; bottom: 0; width: 7px; background: var(--nc); }
    a.ncard:hover, a.ncard:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--nc); }
    .ndate { font-family: var(--font-family-mono); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); }
    .ncard h3 { font-size: 1.12rem; line-height: 1.1; margin: var(--space-1) 0 0; }
    .ncard p { font-size: 0.82rem; line-height: 1.45; color: var(--color-text-secondary); margin: var(--space-2) 0 0; flex: 1; }
    .ncard .go { margin-top: var(--space-3); font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; }

    /* ---- emu198x band ---- */
    .emu-band { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap;
      border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
      padding: var(--space-5) var(--space-6); text-decoration: none; color: var(--color-text); transition: all var(--transition-base); }
    .emu-band:hover, .emu-band:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--color-house-2); }
    .emu-band h3 { font-family: var(--font-family-read); font-weight: 700; font-size: 1.9rem; line-height: 0.95; margin: 0; }
    .emu-band p { font-size: 0.85rem; color: var(--color-text-secondary); margin: var(--space-2) 0 0; max-width: 70ch; }
    .emu-band-go { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; color: var(--color-house-2); white-space: nowrap; }

    /* ---- honest ask (inverted) ---- */
    .ask { margin-top: var(--space-12); border: 3px solid #241a12; background: #3a2c1f; box-shadow: var(--shadow-chunky); padding: var(--space-8); display: grid; grid-template-columns: 1fr auto; gap: var(--space-8); align-items: center; }
    .ask .kicker { color: #e8a07e; }
    .ask h2 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 0.95; color: #f6efe2; margin: var(--space-1) 0 0; }
    .ask p { color: #dac9b4; max-width: 60ch; margin: var(--space-3) 0 0; font-size: 0.95rem; }
    .ask .ask-cta { text-align: right; }
    .ask .wanted { display: inline-block; font-family: var(--font-family-mono); font-size: 1.2rem; font-weight: 700; letter-spacing: 0.12em; border: 3px solid #f6efe2; color: #f6efe2; padding: 6px 14px; transform: rotate(-6deg); }
    .ask .btn { margin-top: var(--space-4); }

    @media (max-width: 900px) {
      .hero, .ask { grid-template-columns: 1fr; }
      .fleet-row { grid-template-columns: 1fr 1fr; }
      .news-row { grid-template-columns: 1fr; }
      .decades { grid-template-columns: repeat(3, 1fr); }
      .pillars { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .fleet-row, .pillars { grid-template-columns: 1fr; }
    }
  </style>

  <div class="home">
    <!-- HERO -->
    <section class="hero">
      <div>
        <p class="kicker">Hardware-craft game development · 1975 → 2005</p>
        <h1 class="hero-title">Make a real game,<br />on a real <span class="hl">old</span> machine.</h1>
        <div class="house-rule"></div>
        <p class="lede">Pick a system. Work through complete games — not toy exercises — in the
          languages people used at the time. <span class="mk">Direct hardware</span>, no engines,
          no apologies.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/sinclair-zx-spectrum">Start with ZX Spectrum →</a>
          <a class="btn btn-secondary" href="/curriculum">See the curriculum map</a>
        </div>
        <p class="hero-router">Not sure where you fit? <a href="/who-this-is-for">Find your way in →</a> · Want the shape first? <a href="/curriculum">Open the map →</a></p>
      </div>
      <aside class="statbox">
        <p class="kicker">The ambition</p>
        <dl class="stats">
          <div><dt>≈{totalCount}</dt><dd>machines catalogued · 1975 → 2005</dd></div>
          <div><dt>dozens</dt><dd>of games per machine, eventually</dd></div>
          <div><dt>6</dt><dd>regions · the whole world</dd></div>
          <div><dt>{liveCount}</dt><dd>live right now</dd></div>
          <div><dt>∞</dt><dd>contributors welcome</dd></div>
        </dl>
        <p class="deal">FREE · OPEN SOURCE · FOREVER</p>
        <div class="cta-row">
          <a class="btn btn-secondary btn-sm" href="/systems">Open the fleet →</a>
          <a class="btn btn-primary btn-sm" href="/about">Help build it →</a>
        </div>
      </aside>
    </section>

    <!-- WHAT'S READY / NEXT -->
    <section class="band">
      <div class="band-head"><p class="kicker">What's ready · what's next</p><span class="band-url">/systems/</span></div>
      <div class="fleet-row">
        {live.map((p) => (
          <a class="pcard live" href={`/${p.id}`} style={cardStyle(p.data.color)}>
            <span class="top"></span>
            <div class="body">
              <div class="reg"><span>Live · {p.data.region} · {p.data.year}</span><span class="badge" style="border-color: var(--color-text); color: var(--color-text);">Live</span></div>
              <h3>{p.data.name}</h3>
              <div class="chip">{p.data.cpu}</div>
              <p>{p.data.tagline}</p>
              <div class="flourish"><span></span><span></span><span></span><span></span></div>
              <span class="go brand-ink">Open the {p.data.shortName} →</span>
            </div>
          </a>
        ))}
        {next.map((p) => (
          <a class="pcard" href={`/${p.id}`} style={cardStyle(p.data.color)}>
            <span class="top"></span>
            <div class="body">
              <div class="reg"><span>{p.data.region} · {p.data.year}</span><span class="badge" style="border-color: var(--color-house); color: var(--color-house);">Next</span></div>
              <h3>{p.data.shortName}</h3>
              <div class="chip">{p.data.cpu}</div>
              <p>{p.data.tagline}</p>
              <span class="go brand-ink">Preview →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- WHAT'S NEW -->
    {latestUpdates.length > 0 && (
      <section class="band">
        <div class="band-head"><p class="kicker">What's new</p><a class="band-url band-link" href="/updates">/updates/ →</a></div>
        <div class="news-row">
          {latestUpdates.map((u) => (
            <a class="ncard" href={`/updates/${u.id}`} style={u.data.accent ? `--nc: ${u.data.accent}` : ''}>
              <time class="ndate" datetime={u.data.pubDate.toISOString()}>{fmtDate(u.data.pubDate)}</time>
              <h3>{u.data.title}</h3>
              <p>{u.data.summary}</p>
              <span class="go brand-ink">Read →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- DECADES -->
    <section class="band">
      <div class="band-head"><p class="kicker">Four decades · pick a year</p><span class="band-url">/timeline/</span></div>
      <div class="decades">
        {decades.map((d) => (
          <div class={`dec${d.live ? ' live' : ''}`}>
            <div class="n">{d.count} machines</div>
            <div class="yr">{d.label}</div>
            <p>{d.blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PILLARS -->
    <section class="band">
      <div class="band-head"><p class="kicker">Learn in layers</p><span class="band-url">curriculum and reference</span></div>
      <div class="pillars">
        {pillars.map((pl) => (
          <a class="pillar" href={pl.url}>
            <div class="u">{pl.url}</div>
            <h3>{pl.title}</h3>
            <p>{pl.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- EMU198X -->
    <section class="band">
      <div class="band-head"><p class="kicker">Built in the open</p><span class="band-url">github.com/emu198x</span></div>
      <a class="emu-band" href="/setup#emu198x">
        <div class="emu-band-text">
          <h3>Our own emulator.</h3>
          <p>Emu198x — cycle-accurate cores for the machines we teach, modelled down to the pins
            and the timing. Headless and scriptable today; used for automated runs, screenshots,
            and accuracy work while learners use the native emulators.</p>
        </div>
        <span class="emu-band-go">Meet Emu198x →</span>
      </a>
    </section>

    <!-- HONEST ASK -->
    <section class="ask">
      <div>
        <p class="kicker">An honest ask</p>
        <h2>≈{totalCount} machines catalogued. Dozens of games each. One of me.</h2>
        <p>This is <strong style="color:#f0b48f;">free, open source, and forever</strong> — every page,
          every binary, every line of prose. The catch: I can't reach the full ambition alone. Author a
          game on a machine you love. Port the methodology to one I don't own. Fill a vault entry.</p>
        <a class="btn btn-primary" href="/about">Ways to help →</a>
      </div>
      <div class="ask-cta">
        <span class="wanted">WANTED</span>
      </div>
    </section>
  </div>
</Layout>
