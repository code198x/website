---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Navigation Test">
  <div style="padding: 2rem;">
    <h1>Navigation Test Page</h1>
    <p>This page is used to test the navigation layout.</p>
    
    <div style="background: #f0f0f0; padding: 1rem; margin: 1rem 0; border-radius: 8px;">
      <h3>Expected Navigation Behavior:</h3>
      <ul>
        <li><strong>Desktop (>768px):</strong> Horizontal navigation bar with logo on left, menu items in center, action buttons on right</li>
        <li><strong>Mobile (≤767px):</strong> Logo on left, hamburger menu on right</li>
      </ul>
    </div>
    
    <div style="background: #e8f5e9; padding: 1rem; margin: 1rem 0; border-radius: 8px;">
      <p><strong>Current viewport width:</strong> <span id="viewport-width"></span>px</p>
    </div>
  </div>
</Layout>

<script>
  function updateViewportWidth() {
    const span = document.getElementById('viewport-width');
    if (span) {
      span.textContent = window.innerWidth.toString();
    }
  }
  
  updateViewportWidth();
  window.addEventListener('resize', updateViewportWidth);
</script>