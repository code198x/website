---
/**
 * Colophon — /colophon/
 *
 * What the site is made of, and who made it. People are derived from git
 * history by scripts/build-colophon.mjs and read from a committed file; the
 * typefaces and tools are authored, because a list generated from the
 * dependency tree would print 189 packages nobody chose.
 *
 * Sources are pointed at, not restated — /standards already answers how we
 * know what we claim.
 *
 * See Code198x docs/decisions/colophon.md
 */
import Layout from '../layouts/Layout.astro';
import contributors from '../data/contributors.json';

const people = contributors.people;

const typefaces = [
  ['Literata', 'Reading — headings and long prose.', '/fonts/OFL-Literata.txt'],
  ['JetBrains Mono', 'Code, listings and anything the machine said.', '/fonts/OFL-JetBrainsMono.txt'],
  ['Nebula Sans', 'Interface text.', '/fonts/OFL-NebulaSans.txt'],
];

const tools = [
  ['Astro', 'Builds the site.', 'https://astro.build'],
  ['Pagefind', 'Searches it, without a server.', 'https://pagefind.app'],
  ['Vale', 'Reads the prose back and argues with it.', 'https://vale.sh'],
  ['Asm198x', 'Assembles every unit program, on all four machines.', 'https://github.com/asm198x/asm198x'],
  ['Build198x', 'Converts the art and masters the disks.', 'https://github.com/build198x/build198x'],
  ['Emu198x', 'Runs the programs and takes the screenshots.', 'https://github.com/emu198x/emu198x'],
  ['Play198x', 'Decodes retro image formats at build time.', 'https://github.com/play198x/play198x'],
  ['Claude', 'Drafting help, on the terms set out in the standards.', '/standards'],
];
---

<Layout title="Colophon" description="What Code Like It's 198x is made of — the people, the typefaces, and the tools.">
  <div class="wrap">
    <div class="vhead">
      <p class="eyebrow">Colophon</p>
      <h1>What this is<br />made of.</h1>
      <div class="herorule"></div>
      <p class="lede">A colophon is the note at the back of a book saying how it was set and who set it.{' '}
        This one covers the people, the type and the tools. How the <em>facts</em> are established is a
        separate question, answered on <a href="/standards">Sources &amp; Standards</a>.</p>
    </div>

    <section>
      <p class="eyebrow">People</p>
      <h2>Everyone who has contributed.</h2>
      <ul class="people">
        {people.map((p) => (
          <li>
            <a href={p.url} rel="noopener">{p.name ?? p.login}</a>
            {p.name && <span class="handle">{p.login}</span>}
          </li>
        ))}
      </ul>
      <p class="note">
        {people.length === 1
          ? 'One, so far. The list is generated from the commit history across every repository in the organisation, so it grows on its own — and a short list is a reason to add yourself, not a reason not to.'
          : 'Generated from the commit history across every repository in the organisation. Alphabetical: no counts, no ranking. A Vault entry and a corrected typo are both one commit, and comparing them would measure the wrong thing.'}
      </p>
      <a class="btn" href="/contribute">How to join them →</a>
    </section>

    <section>
      <p class="eyebrow">Type</p>
      <h2>Three faces, all libre.</h2>
      <dl class="grid">
        {typefaces.map(([name, role, licence]) => (
          <div class="item">
            <dt>{name}</dt>
            <dd>{role} <a href={licence}>Licence</a></dd>
          </div>
        ))}
      </dl>
      <p class="note">Served from this domain, not a font CDN — the pages should render the same in ten
        years as they do now, and a third party is one more thing that can stop existing.</p>
    </section>

    <section>
      <p class="eyebrow">Tools</p>
      <h2>What builds it.</h2>
      <dl class="grid">
        {tools.map(([name, role, href]) => (
          <div class="item">
            <dt><a href={href} rel="noopener">{name}</a></dt>
            <dd>{role}</dd>
          </div>
        ))}
      </dl>
      <p class="note">Four of these the project wrote itself, because the curriculum needed an assembler,
        a converter and an emulator it could trust to behave the same way twice.</p>
    </section>
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }

  .vhead { margin-bottom: var(--space-8); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.5rem); line-height: 0.9;
      /* Literata's ink drops past the box; reserve it or the rule collides. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 70%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .lede a { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.15em; }

  section { margin-top: var(--space-10); }
  section h2 { font-family: var(--font-family-read); font-weight: 700; font-size: 1.9rem; line-height: 1; margin: var(--space-1) 0 var(--space-4); }

  .people { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .people li { border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky); padding: var(--space-3) var(--space-4); }
  .people a { font-weight: 700; color: var(--color-text); text-decoration: none; }
  .people a:hover { text-decoration: underline; }
  .handle { display: block; font-family: var(--font-family-mono); font-size: 0.72rem; color: var(--color-text-secondary); margin-top: 2px; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin: 0; }
  .item { border: 3px solid var(--color-border); background: var(--color-surface); padding: var(--space-4); }
  .item dt { font-weight: 800; font-size: 1rem; }
  .item dt a { color: var(--color-text); text-decoration: none; }
  .item dt a:hover { text-decoration: underline; }
  .item dd { margin: var(--space-2) 0 0; font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.5; }
  .item dd a { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.15em; }

  .note { font-size: 0.88rem; color: var(--color-text-secondary); max-width: 68ch; margin: var(--space-4) 0 0; line-height: 1.55; }

  .btn { display: inline-block; margin-top: var(--space-4); border: 3px solid var(--color-text); background: var(--color-house-tint); padding: var(--space-2) var(--space-4); font-weight: 700; color: var(--color-text); text-decoration: none; box-shadow: var(--shadow-chunky); }
  .btn:hover { transform: translate(-1px, -1px); }

  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
