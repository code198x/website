---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import "../styles/changelog.css";

// Version data - in production, this could be fetched from GitHub API
const releases = [
  {
    version: "v1.0.0",
    date: "2025-09-20",
    tag: "stable",
    highlights: [
      "Initial stable release",
      "64 gaming systems ready",
      "All toolchains functional"
    ],
    details: {
      added: [
        "Complete Docker environments for 64 retro gaming systems",
        "12 processor family base images with real toolchains",
        "TLCS-900H support via AS macro assembler",
        "Multi-architecture builds (AMD64 + ARM64)",
        "Comprehensive versioning system for educators",
        "GitLab mirroring for redundancy"
      ],
      systems: {
        "6502 Family": ["Commodore 64/128", "Nintendo NES", "Apple II", "Atari 2600/800"],
        "Z80 Family": ["ZX Spectrum", "Amstrad CPC", "MSX", "Sam Coupé"],
        "68000 Family": ["Amiga 500/1200", "Sega Genesis", "Neo Geo", "Atari ST"],
        "MIPS Family": ["Sony PlayStation", "Nintendo 64"],
        "ARM Family": ["Game Boy Advance", "Nintendo DS", "3DO"],
        "And More": ["58 additional classic systems"]
      },
      docker: [
        "# 6502 Systems",
        "ghcr.io/code198x/commodore-64:v1.0.0",
        "ghcr.io/code198x/commodore-128:v1.0.0",
        "ghcr.io/code198x/commodore-pet:v1.0.0",
        "ghcr.io/code198x/commodore-plus4:v1.0.0",
        "ghcr.io/code198x/acorn-bbc-micro:v1.0.0",
        "ghcr.io/code198x/apple-ii:v1.0.0",
        "ghcr.io/code198x/atari-2600:v1.0.0",
        "ghcr.io/code198x/atari-800:v1.0.0",
        "ghcr.io/code198x/nintendo-nes:v1.0.0",
        "ghcr.io/code198x/nintendo-donkey-kong:v1.0.0",
        "",
        "# Z80 Systems",
        "ghcr.io/code198x/sinclair-zx-spectrum:v1.0.0",
        "ghcr.io/code198x/sinclair-zx81:v1.0.0",
        "ghcr.io/code198x/amstrad-cpc:v1.0.0",
        "ghcr.io/code198x/msx:v1.0.0",
        "ghcr.io/code198x/sam-coupe:v1.0.0",
        "ghcr.io/code198x/enterprise-128:v1.0.0",
        "ghcr.io/code198x/oric-1:v1.0.0",
        "ghcr.io/code198x/oric-atmos:v1.0.0",
        "ghcr.io/code198x/thomson-mo5:v1.0.0",
        "ghcr.io/code198x/coleco-adam:v1.0.0",
        "ghcr.io/code198x/sega-game-gear:v1.0.0",
        "",
        "# 68000 Systems",
        "ghcr.io/code198x/commodore-amiga-500:v1.0.0",
        "ghcr.io/code198x/commodore-amiga-1200:v1.0.0",
        "ghcr.io/code198x/atari-st:v1.0.0",
        "ghcr.io/code198x/sega-genesis:v1.0.0",
        "ghcr.io/code198x/sega-32x:v1.0.0",
        "ghcr.io/code198x/snk-neogeo-mvs:v1.0.0",
        "ghcr.io/code198x/snk-neogeo-aes:v1.0.0",
        "ghcr.io/code198x/sharp-x68000:v1.0.0",
        "ghcr.io/code198x/atari-lynx:v1.0.0",
        "ghcr.io/code198x/atari-jaguar:v1.0.0",
        "ghcr.io/code198x/capcom-street-fighter-ii:v1.0.0",
        "",
        "# 8080 Systems",
        "ghcr.io/code198x/altair-8800:v1.0.0",
        "ghcr.io/code198x/imsai-8080:v1.0.0",
        "",
        "# 6809 Systems",
        "ghcr.io/code198x/dragon-32:v1.0.0",
        "ghcr.io/code198x/dragon-64:v1.0.0",
        "ghcr.io/code198x/tandy-trs80-model1:v1.0.0",
        "ghcr.io/code198x/general-computer-vectrex:v1.0.0",
        "ghcr.io/code198x/williams-defender:v1.0.0",
        "",
        "# MIPS Systems",
        "ghcr.io/code198x/sony-playstation:v1.0.0",
        "ghcr.io/code198x/nintendo-64:v1.0.0",
        "",
        "# ARM Systems",
        "ghcr.io/code198x/nintendo-gba:v1.0.0",
        "ghcr.io/code198x/nintendo-ds:v1.0.0",
        "ghcr.io/code198x/panasonic-3do:v1.0.0",
        "",
        "# SuperH Systems",
        "ghcr.io/code198x/sega-saturn:v1.0.0",
        "ghcr.io/code198x/sega-dreamcast:v1.0.0",
        "",
        "# x86 Systems",
        "ghcr.io/code198x/fujitsu-fm-towns:v1.0.0",
        "ghcr.io/code198x/nec-pc9801:v1.0.0",
        "ghcr.io/code198x/nec-pc8801:v1.0.0",
        "ghcr.io/code198x/compupro-system816:v1.0.0",
        "ghcr.io/code198x/sharp-x1:v1.0.0",
        "",
        "# V30 Systems",
        "ghcr.io/code198x/bandai-wonderswan:v1.0.0",
        "ghcr.io/code198x/nec-turbografx16:v1.0.0",
        "ghcr.io/code198x/nec-pc-engine-supergx:v1.0.0",
        "",
        "# TLCS Systems",
        "ghcr.io/code198x/snk-neogeo-pocket:v1.0.0",
        "",
        "# Arcade Systems",
        "ghcr.io/code198x/atari-asteroids:v1.0.0",
        "ghcr.io/code198x/atari-tempest:v1.0.0",
        "ghcr.io/code198x/namco-pacman:v1.0.0",
        "ghcr.io/code198x/namco-galaga:v1.0.0",
        "ghcr.io/code198x/konami-gx400:v1.0.0"
      ]
    }
  }
];

// Group releases by major version
const majorVersions = releases.reduce((acc, release) => {
  const major = release.version.split('.')[0];
  if (!acc[major]) acc[major] = [];
  acc[major].push(release);
  return acc;
}, {});
---

<Layout
  title="Changelog - Code Like It's 198x"
  description="Track updates and releases of the Code Like It's 198x development environment. Version history, new features, and system additions."
>
  <div class="changelog">
    <section class="changelog__hero">
      <div class="changelog__hero-content">
        <h1 class="changelog__title">
          <Icon name="history" size={48} />
          Platform Changelog
        </h1>
        <p class="changelog__description">
          Track the evolution of the Code Like It's 198x development environment.
          Each release is carefully versioned for educational stability.
        </p>
        <div class="changelog__current">
          <span class="changelog__current-label">Current Stable</span>
          <span class="changelog__current-version">v1.0.0</span>
          <span class="changelog__current-date">Released Sep 20, 2025</span>
        </div>
      </div>
    </section>

    <section class="changelog__info">
      <div class="changelog__info-grid">
        <div class="changelog__info-card">
          <h3>📚 For Educators</h3>
          <p>
            Pin your curriculum to specific versions for consistency across semesters.
            All Docker images are permanently available with version tags.
          </p>
        </div>
        <div class="changelog__info-card">
          <h3>🔄 Update Policy</h3>
          <p>
            Minor updates add new systems or features. Major versions may include
            toolchain changes. Patch releases fix bugs without breaking changes.
          </p>
        </div>
        <div class="changelog__info-card">
          <h3>🐳 Docker Tags</h3>
          <p>
            Use <code>:latest</code> for cutting edge or <code>:v1.0.0</code> for
            stability. All historical versions remain available.
          </p>
        </div>
      </div>
    </section>

    <section class="changelog__releases">
      {Object.entries(majorVersions).map(([major, versions]) => (
        <div class="changelog__major-version">
          <h2 class="changelog__major-title">{major}.x Series</h2>

          {versions.map((release) => (
            <article class="changelog__release">
              <header class="changelog__release-header">
                <div class="changelog__release-title">
                  <h3>{release.version}</h3>
                  {release.tag && (
                    <span class={`changelog__tag changelog__tag--${release.tag}`}>
                      {release.tag}
                    </span>
                  )}
                </div>
                <time class="changelog__release-date">{release.date}</time>
              </header>

              {release.highlights && (
                <div class="changelog__highlights">
                  {release.highlights.map((highlight) => (
                    <span class="changelog__highlight">{highlight}</span>
                  ))}
                </div>
              )}

              <div class="changelog__details">
                {release.details.added && (
                  <div class="changelog__section">
                    <h4>✨ Added</h4>
                    <ul>
                      {release.details.added.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {release.details.systems && (
                  <div class="changelog__section">
                    <h4>🎮 Systems Included</h4>
                    <div class="changelog__systems-grid">
                      {Object.entries(release.details.systems).map(([family, systems]) => (
                        <div class="changelog__system-family">
                          <strong>{family}:</strong>
                          <span>{systems.join(", ")}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {release.details.docker && (
                  <div class="changelog__section">
                    <h4>🐳 All 64 Docker Images</h4>
                    <pre class="changelog__docker-examples"><code>{release.details.docker.map(line =>
                      line.startsWith('#') ? `\n${line}` : line
                    ).join('\n')}</code></pre>
                  </div>
                )}

                {release.details.fixed && (
                  <div class="changelog__section">
                    <h4>🔧 Fixed</h4>
                    <ul>
                      {release.details.fixed.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {release.details.breaking && (
                  <div class="changelog__section changelog__section--breaking">
                    <h4>⚠️ Breaking Changes</h4>
                    <ul>
                      {release.details.breaking.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <footer class="changelog__release-footer">
                <a
                  href={`https://github.com/code198x/development-environment/releases/tag/${release.version}`}
                  class="changelog__release-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="github" size={16} />
                  View on GitHub
                </a>
                <a
                  href={`https://github.com/code198x/development-environment/compare/${releases[versions.indexOf(release) + 1]?.version || 'main'}...${release.version}`}
                  class="changelog__release-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="compare" size={16} />
                  Compare changes
                </a>
              </footer>
            </article>
          ))}
        </div>
      ))}
    </section>

    <section class="changelog__contribute">
      <div class="changelog__contribute-content">
        <h2>Contribute</h2>
        <p>
          Help us improve the platform! Report issues, suggest new systems,
          or contribute code on GitHub.
        </p>
        <div class="changelog__contribute-links">
          <a href="https://github.com/code198x/development-environment/issues" class="changelog__btn">
            <Icon name="bug" size={20} />
            Report Issue
          </a>
          <a href="https://github.com/code198x/development-environment/pulls" class="changelog__btn">
            <Icon name="pull-request" size={20} />
            Submit PR
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>