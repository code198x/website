---
import Layout from '../layouts/Layout.astro';
import { BookOpenCheck, Camera, Code2, FileSearch, Scale } from '@lucide/astro';
import GithubIcon from '@components/GithubIcon.astro';

const sourceLadder = [
  {
    title: 'Primary material',
    body: 'Manuals, data sheets, service manuals, original source releases, contemporary developer notes, and scans of period magazines or books.',
  },
  {
    title: 'Verified output',
    body: 'A lesson program that builds from the repository, runs in the named emulator or on hardware, and produces the screenshot or behaviour shown on the page.',
  },
  {
    title: 'Measured hardware',
    body: 'Photos, capture cards, logic analyser traces, disk or tape flux captures, and other evidence taken from real machines when a claim needs that bar.',
  },
  {
    title: 'Trusted secondary work',
    body: 'Modern retrospectives, interviews, emulator documentation, preservation projects, and community research used with attribution and checked against stronger evidence where possible.',
  },
];

const pageRules = [
  ['Lessons', 'The code must build, run, and show the thing the prose says it shows. If a ROM is needed, the page says so without redistributing it.'],
  ['Pattern Library', 'A pattern is reusable only after it exists as working code, with the system, language, and limits named clearly.'],
  ['The Vault', 'Historical claims need a source trail. Primary sources win; oral history and modern writing are useful, but they are labelled for what they are.'],
  ['Screenshots and video', 'Images should be generated from our builds, our emulator captures, real hardware captures, or software we have actually booted. Captions should say enough to understand the origin.'],
];

const validSourceRules = [
  {
    title: 'Good enough on its own',
    items: [
      'Original manuals, data sheets, service manuals, schematics, source releases, ROM listings, and official developer documentation.',
      'A reproducible build and run from this repository, with the command, target, emulator or hardware route, and observed result named.',
      'A capture from real hardware when the claim is specifically about electrical behaviour, analogue output, timing edge cases, or physical media.',
    ],
  },
  {
    title: 'Useful with attribution',
    items: [
      'Period magazines, books, adverts, interviews, reviews, and type-in listings, especially when scanned or quoted from the original publication.',
      'Modern emulator documentation, preservation notes, community research, reverse-engineering write-ups, and long-lived reference sites.',
      'Oral history and retrospective interviews, clearly treated as recollection unless supported by contemporary material.',
    ],
  },
  {
    title: 'Not enough by itself',
    items: [
      'AI output, unsourced summaries, forum hearsay, copied wiki text without a trail, or a screenshot whose origin cannot be explained.',
      'A passing emulator run as proof of exact hardware timing, unless the page only claims emulator behaviour.',
      'A memory, anecdote, or common belief when the page is making a specific historical or technical claim.',
    ],
  },
];

const evidenceLabels = [
  ['Built', 'The source was built from the repository.'],
  ['Run', 'The program was run in the named emulator or on named hardware.'],
  ['Captured', 'The screenshot, image, audio, or video came from that run.'],
  ['Cited', 'The factual claim has a source trail.'],
  ['Inferred', 'The prose is drawing a conclusion from sources or observed behaviour, not quoting a source directly.'],
  ['Needs checking', 'The page is honest that the claim is not fully verified yet.'],
];
---

<Layout
  title="Sources & Standards"
  description="How Code Like It's 198x decides what counts as a valid source, how lesson code is checked, and how screenshots and historical claims are handled."
>
  <div class="standards">
    <section class="hero">
      <p class="kicker">Sources &amp; standards</p>
      <h1>How we know what we claim.</h1>
      <div class="house-rule"></div>
      <p class="lede">
        Code Like It's 198x is part curriculum, part reference shelf, and part public workshop.
        That only works if the site is clear about evidence: what was run, what was read, what
        was inferred, and what still needs checking.
      </p>
    </section>

    <section class="band">
      <div class="band-head">
        <p class="kicker">The source ladder</p>
        <span class="band-url">stronger evidence first</span>
      </div>
      <div class="ladder">
        {sourceLadder.map((item, index) => (
          <article class="ladder-item">
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <h2>{item.title}</h2>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="band-head">
        <p class="kicker">What each section owes you</p>
        <span class="band-url">site contract</span>
      </div>
      <div class="rules">
        {pageRules.map(([title, body]) => (
          <article class="rule">
            <h2>{title}</h2>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="band-head">
        <p class="kicker">What counts as valid</p>
        <span class="band-url">source rules</span>
      </div>
      <div class="valid-grid">
        {validSourceRules.map((group) => (
          <article class="valid-card">
            <h2>{group.title}</h2>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="band-head">
        <p class="kicker">Evidence labels</p>
        <span class="band-url">plain English markers</span>
      </div>
      <div class="labels">
        {evidenceLabels.map(([label, body]) => (
          <article>
            <strong>{label}</strong>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="band split">
      <div>
        <p class="kicker">AI is not a source</p>
        <h2>Drafting help does not make a claim true.</h2>
        <p>
          AI can help rough out prose and code, but it cannot stand in for a manual, a trace,
          a build log, a screenshot, or someone who was there. If an AI draft introduces a fact,
          that fact still needs an ordinary source before it belongs on the site.
        </p>
      </div>
      <div class="checks">
        <div><Code2 size={20} /><span>Code builds from the repo</span></div>
        <div><Camera size={20} /><span>Screenshots come from real runs</span></div>
        <div><BookOpenCheck size={20} /><span>Historical claims cite sources</span></div>
        <div><FileSearch size={20} /><span>Unsettled claims stay labelled</span></div>
      </div>
    </section>

    <section class="band split">
      <div>
        <p class="kicker">Screenshots, copyright and ROMs</p>
        <h2>Show the result, do not ship what is not ours.</h2>
        <p>
          The site can show screenshots and short clips from software that has been booted for
          testing, review, or documentation. It does not distribute commercial ROMs, disks, tapes,
          Kickstarts, kernels, or copyrighted assets as downloadable course material.
        </p>
      </div>
      <div class="links">
        <a href="/setup/roms"><Scale size={18} /> ROM guidance</a>
        <a href="/contribute"><GithubIcon size={18} /> Contribute with sources</a>
      </div>
    </section>

    <section class="band split" id="rights">
      <div>
        <p class="kicker">Imagery, marks and attribution</p>
        <h2>Everything shown here belongs to whoever made it.</h2>
        <p>
          Screenshots and clips on this site are our own captures, taken from media we already
          hold, and published as illustration inside criticism. Company names, logos and
          trademarks are reproduced to identify the companies an entry is about. Cover art,
          inlays and book covers are reproduced small, one per entry, to illustrate a claim the
          entry is making — never as a substitute for the work itself.
        </p>
        <p>
          <strong>
            All games, artwork, logos, trademarks and photographs remain the property of their
            respective owners. Nothing reproduced here is claimed as our work, and no endorsement
            or affiliation is implied.
          </strong>{' '}
          Where an artist, author or photographer is known, we name them. Where a rights-holder
          would prefer something removed, we remove it on request, without argument. Our own marks
          are governed by the same test, and you do not need to ask —
          see <a href="/press#marks">using our name and logo</a>.
        </p>
      </div>
      <div class="checks">
        <div><Camera size={20} /><span>Our own capture, from media we hold</span></div>
        <div><Scale size={20} /><span>Small, and tied to a claim on the page</span></div>
        <div><FileSearch size={20} /><span>Named artist wherever we can establish one</span></div>
      </div>
    </section>

    <section class="band split">
      <div>
        <p class="kicker">Emulator versus hardware</p>
        <h2>Use the right level of proof for the claim.</h2>
        <p>
          Emulator evidence is valid for lessons, screenshots, normal program output, and the
          behaviour learners are expected to reproduce. Hardware evidence matters when a page
          claims exact timing, analogue display behaviour, physical media behaviour, or anything
          where the emulator itself is part of the question.
        </p>
      </div>
      <div class="checks">
        <div><Code2 size={20} /><span>Lesson works in the supported run path</span></div>
        <div><Camera size={20} /><span>Caption names the capture source</span></div>
        <div><FileSearch size={20} /><span>Hardware-only claims need hardware evidence</span></div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .standards { max-width: 1160px; margin: 0 auto; padding: 0 var(--space-6) var(--space-16); }
  .kicker { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .hero { padding: var(--space-12) 0 var(--space-8); }
  .hero h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(3.2rem, 8vw, 5.4rem); line-height: 0.86; margin: var(--space-1) 0 0; color: var(--color-text); }
  .house-rule { height: 9px; width: 220px; max-width: 70%; background: var(--color-house); position: relative; margin: var(--space-3) 0; }
  .house-rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.08rem; max-width: 70ch; color: var(--color-text); margin: var(--space-4) 0 0; }
  .band { margin-top: var(--space-10); }
  .band-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); border-bottom: 3px solid var(--color-text); padding-bottom: var(--space-2); margin-bottom: var(--space-5); }
  .band-url { font-family: var(--font-family-mono); font-size: 0.7rem; letter-spacing: 0.12em; color: var(--color-text-secondary); }
  .ladder { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); counter-reset: ladder; }
  .ladder-item, .rule, .valid-card, .labels article { border: 3px solid var(--color-border); background: var(--color-surface); padding: var(--space-5); }
  .ladder-item { border-top-color: var(--color-house-2); border-top-width: 7px; }
  .num { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; color: var(--color-house-2); }
  .ladder h2, .rule h2, .valid-card h2, .split h2 { font-size: 1.25rem; margin: var(--space-2) 0 var(--space-2); color: var(--color-text); }
  .ladder p, .rule p, .split p, .labels p { color: var(--color-text-secondary); font-size: 0.92rem; line-height: 1.65; margin: 0; }
  .rules { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .valid-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .valid-card ul { margin: var(--space-3) 0 0; padding-left: var(--space-5); color: var(--color-text-secondary); }
  .valid-card li { font-size: 0.88rem; line-height: 1.55; margin-bottom: var(--space-2); }
  .labels { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .labels strong { display: block; font-family: var(--font-family-mono); color: var(--color-house-2); margin-bottom: var(--space-2); }
  .split { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr); gap: var(--space-8); align-items: center; border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky); padding: var(--space-6); }
  .checks { display: grid; gap: var(--space-3); }
  .checks div, .links a { display: flex; align-items: center; gap: var(--space-3); font-family: var(--font-family-mono); font-size: 0.82rem; color: var(--color-text); border: 2px solid var(--color-border); padding: var(--space-3); background: var(--color-bg); }
  .checks svg, .links svg { color: var(--color-house-2); flex: 0 0 auto; }
  .links { display: grid; gap: var(--space-3); }
  .links a { color: var(--ink); font-weight: 700; text-decoration: none; }
  .links a:hover { border-color: var(--color-house-2); }
  /* Every other band carries a single paragraph, so band <p> has no margin.
     The rights notice needs two: the statement, then the practice. */
  #rights p + p { margin-top: var(--space-4); }
  @media (max-width: 920px) { .ladder, .valid-grid, .labels { grid-template-columns: repeat(2, 1fr); } .split { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .ladder, .rules, .valid-grid, .labels { grid-template-columns: 1fr; } .band-head { display: block; } .band-url { display: block; margin-top: var(--space-1); } }
</style>
