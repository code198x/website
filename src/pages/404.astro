---
import Layout from '../layouts/Layout.astro';

const four = ['10001', '10001', '10001', '11111', '00001', '00001', '00001'];
const zero = ['01110', '10001', '10011', '10101', '11001', '10001', '01110'];
const pixels = four.flatMap((row, i) => [...`${row}0${zero[i]}0${row}`]);
const destinations = [
  { href: '/start-here', title: 'Start learning', text: 'Find a route into programming and making games.' },
  { href: '/systems', title: 'Browse systems', text: 'Find your computer or console and its available lessons.' },
  { href: '/vault', title: 'Explore the Vault', text: 'Look up machines, games, people and computing history.' },
];
---

<Layout title="Page not found" description="This address does not lead to a page. Find a lesson, browse systems or return to the Code198x homepage.">
  <div class="not-found">
    <header>
      <div class="pixel-number" aria-hidden="true">{pixels.map(pixel => <span class:list={{ filled: pixel === '1' }} />)}</div>
      <p class="status">Error 404</p>
      <h1>Page not found</h1>
      <p class="explanation">This address doesn’t lead to a page. The link may be out of date,
        or there may be a mistake in the address.</p>
      <a class="home-link" href="/">Return to the homepage <span aria-hidden="true">→</span></a>
    </header>
    <nav class="destinations" aria-label="Places to continue">
      {destinations.map(item => (
        <a href={item.href}>
          <h2>{item.title} <span aria-hidden="true">→</span></h2>
          <p>{item.text}</p>
        </a>
      ))}
    </nav>
    <p class="search-note">Looking for a particular topic? Use the search in the site header.</p>
  </div>
</Layout>

<style>
  .not-found { max-width: 1000px; margin: 0 auto; padding: var(--space-12) var(--space-6) var(--space-16); }
  header { max-width: 660px; }
  .pixel-number { display: grid; grid-template-columns: repeat(17, 1fr); width: min(100%, 340px); aspect-ratio: 17 / 7; gap: 2px; margin-bottom: var(--space-6); }
  .pixel-number span { background: var(--color-surface); }
  .pixel-number .filled { background: var(--h-ink); }
  .status { font-family: var(--font-family-mono); font-size: var(--h-text-small); color: var(--h-ink-muted); }
  h1 { font-family: var(--font-family-read); font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.1; color: var(--h-ink); margin: var(--space-3) 0; }
  .explanation { font-size: 1.1rem; line-height: 1.6; color: var(--h-ink-body); }
  .home-link { display: inline-flex; gap: var(--space-3); align-items: center; min-height: 44px; margin-top: var(--space-3); color: var(--h-ink); text-underline-offset: .2em; }
  .destinations { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-10); }
  .destinations a { display: block; padding: var(--space-5); color: var(--h-ink-body); border: 1px solid var(--color-border); background: var(--color-surface); text-decoration: none; }
  h2 { font-family: var(--font-family-sans); font-size: 1.1rem; line-height: 1.4; color: var(--h-ink); margin: 0; }
  .destinations p { font-size: var(--h-text-small); line-height: 1.6; margin: var(--space-3) 0 0; }
  .destinations a:hover h2 { text-decoration: underline; text-underline-offset: .2em; }
  .search-note { color: var(--h-ink-muted); font-size: var(--h-text-small); margin-top: var(--space-6); }
  @media (max-width: 700px) { .destinations { grid-template-columns: 1fr; } }
</style>
