---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found" description="The page you're looking for doesn't exist." showNav={true}>
  <div class="error-container">
    <div class="error-screen">
      <div class="error-content">
        <div class="error-code">
          <span class="blink">?</span>SYNTAX ERROR<span class="blink">?</span>
        </div>
        <div class="error-line">
          <span class="line-number">404</span>
          <span class="line-text">PAGE NOT FOUND</span>
        </div>
        <div class="error-message">
          <p>READY.</p>
          <p class="cursor-line"><span class="cursor">_</span></p>
        </div>
      </div>
    </div>

    <div class="error-help">
      <h2>Page not found</h2>
      <p>This page may have moved, been removed, or the URL might be incorrect.</p>

      <div class="error-actions">
        <a href="/" class="btn btn-primary">Return Home</a>
        <a href="/commodore-64" class="btn btn-secondary">Browse C64</a>
        <a href="/sinclair-zx-spectrum" class="btn btn-secondary">Browse Spectrum</a>
      </div>

      <div class="error-suggestion">
        <p>Popular starting points:</p>
        <ul>
          <li><a href="/commodore-64/assembly/game-01-sid-symphony">SID Symphony (C64 Game 1)</a></li>
          <li><a href="/sinclair-zx-spectrum/assembly/game-01-ink-war">Ink War (Spectrum Game 1)</a></li>
          <li><a href="/vault">Articles &amp; History</a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-8);
  }

  /* Retro error screen */
  .error-screen {
    background: #4a4dff;
    border: 4px solid #7b7eff;
    border-radius: 0.5rem;
    padding: var(--space-8);
    box-shadow:
      0 0 0 2px #2a2d9f,
      0 8px 32px rgba(74, 77, 255, 0.3);
    position: relative;
    overflow: hidden;
  }

  /* CRT scanline effect */
  .error-screen::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.1) 2px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Subtle screen flicker animation */
  .error-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.03) 100%
    );
    pointer-events: none;
    z-index: 2;
    animation: screen-flicker 8s ease-in-out infinite;
  }

  @keyframes screen-flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.98; }
    52% { opacity: 1; }
    54% { opacity: 0.97; }
    56% { opacity: 1; }
  }

  .error-content {
    font-family: var(--font-family-mono);
    color: #a0a3ff;
    text-align: center;
    position: relative;
    z-index: 3;
  }

  .error-code {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: var(--space-4);
    letter-spacing: 0.1em;
  }

  .error-line {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    color: white;
    margin-bottom: var(--space-6);
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .line-number {
    color: #ffff66;
  }

  .error-message {
    font-size: 1.25rem;
    color: #a0a3ff;
  }

  .error-message p {
    margin: 0;
  }

  .cursor-line {
    margin-top: var(--space-2);
  }

  .cursor {
    animation: blink 1s step-end infinite;
  }

  .blink {
    animation: blink 0.5s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Help section */
  .error-help {
    text-align: center;
  }

  .error-help h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .error-help > p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .error-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .error-suggestion {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .error-suggestion p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .error-suggestion ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-suggestion a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .error-suggestion a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .error-line {
      flex-direction: column;
      gap: var(--space-2);
    }

    .error-actions {
      flex-direction: column;
    }

    .error-suggestion ul {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  /* Dark mode adjustments */
  @media (prefers-color-scheme: dark) {
    .error-screen {
      box-shadow:
        0 0 0 2px #2a2d9f,
        0 8px 32px rgba(74, 77, 255, 0.5);
    }
  }
</style>
