---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found - Code Like It's 198x">
  <main class="container text-center" style="padding-top: var(--space-4xl); padding-bottom: var(--space-4xl);">
    <h1 style="font-size: 4rem; font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-lg);">404</h1>
    <h2 style="font-size: 1.5rem; font-weight: 600; color: var(--text-muted); margin-bottom: var(--space-xl);">Page Not Found</h2>
    <p style="font-size: 1.125rem; color: var(--text-muted); margin-bottom: var(--space-2xl); max-width: 28rem; margin-left: auto; margin-right: auto;">
      Sorry, the page you're looking for doesn't exist. It might have been moved, deleted, or you entered the wrong URL.
    </p>
    
    <div style="display: flex; flex-direction: column; gap: var(--space-lg); align-items: center;">
      <a 
        href="/" 
        class="btn btn-primary"
      >
        Return Home
      </a>
      
      <div style="font-size: 0.875rem; color: var(--text-muted);">
        <p>Or try one of these popular pages:</p>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-lg); margin-top: var(--space-sm);">
          <a href="/lessons" class="link">Browse Lessons</a>
          <a href="/vault" class="link">The Vault</a>
          <a href="/timeline" class="link">Timeline</a>
        </div>
      </div>
    </div>

    <div style="margin-top: var(--space-4xl); font-size: 0.75rem; color: var(--text-muted);">
      <p>Error 404 - Like trying to PEEK a memory address that doesn't exist!</p>
    </div>
  </main>
</Layout>