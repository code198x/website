---
import Layout from '../layouts/Layout.astro';
import { getActivePlatforms } from '../lib/platforms';
import { getCollection } from 'astro:content';

const platforms = await getActivePlatforms();
const gamesEntries = await getCollection('games');

const actionPlatforms = platforms
  .map(platform => ({
    name: platform.data.shortName,
    slug: platform.id,
  }))
  .slice(0, 2);

const popularLinks = platforms
  .map(platform => {
    const entry =
      gamesEntries.find(g => g.data.platform === platform.id && g.data.track === 'assembly') ||
      gamesEntries.find(g => g.data.platform === platform.id);
    const game = entry?.data.games?.[0];

    if (!entry || !game) return null;

    return {
      title: `${game.name} (${platform.data.shortName} Game ${game.number})`,
      href: `/${platform.id}/${entry.data.track}/${game.slug}`,
    };
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .slice(0, 2);
---

<Layout title="404 - Page Not Found" description="The page you're looking for doesn't exist." showNav={true}>
  <div class="error-container">
    <div class="error-screen">
      <div class="error-content">
        <div class="error-code">
          <span class="blink">?</span>SYNTAX ERROR<span class="blink">?</span>
        </div>
        <div class="error-line">
          <span class="line-number">404</span>
          <span class="line-text">PAGE NOT FOUND</span>
        </div>
        <div class="error-message">
          <p>READY.</p>
          <p class="cursor-line"><span class="cursor">_</span></p>
        </div>
      </div>
    </div>

    <div class="error-help">
      <h2>Page not found</h2>
      <p>This page may have moved, been removed, or the URL might be incorrect.</p>

      <div class="error-actions">
        <a href="/" class="btn btn-primary">Return Home</a>
        {actionPlatforms.map(platform => (
          <a href={`/${platform.slug}`} class="btn btn-secondary">Browse {platform.name}</a>
        ))}
      </div>

      <div class="error-suggestion">
        <p>Popular starting points:</p>
        <ul>
          {popularLinks.map(link => (
            <li><a href={link.href}>{link.title}</a></li>
          ))}
          <li><a href="/vault">Articles &amp; History</a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-8);
  }

  /* Retro error screen */
  /* A deliberate C64 BASIC "READY." screen — the homage is the point.
     Squared corners + a chunky offset shadow keep it on the synthesis grid. */
  .error-screen {
    background: #4a4dff;
    border: 4px solid #7b7eff;
    border-radius: 0;
    padding: var(--space-8);
    box-shadow:
      0 0 0 2px #2a2d9f,
      8px 8px 0 rgb(0 0 0 / 0.25);
    position: relative;
    overflow: hidden;
  }

  /* CRT scanline effect */
  .error-screen::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.1) 2px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Subtle screen flicker animation */
  .error-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.03) 100%
    );
    pointer-events: none;
    z-index: 2;
    animation: screen-flicker 8s ease-in-out infinite;
  }

  @keyframes screen-flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.98; }
    52% { opacity: 1; }
    54% { opacity: 0.97; }
    56% { opacity: 1; }
  }

  .error-content {
    font-family: var(--font-family-mono);
    color: #a0a3ff;
    text-align: center;
    position: relative;
    z-index: 3;
  }

  .error-code {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: var(--space-4);
    letter-spacing: 0.1em;
  }

  .error-line {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    color: white;
    margin-bottom: var(--space-6);
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .line-number {
    color: #ffff66;
  }

  .error-message {
    font-size: 1.25rem;
    color: #a0a3ff;
  }

  .error-message p {
    margin: 0;
  }

  .cursor-line {
    margin-top: var(--space-2);
  }

  .cursor {
    animation: blink 1s step-end infinite;
  }

  .blink {
    animation: blink 0.5s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Help section */
  .error-help {
    text-align: center;
  }

  .error-help h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .error-help > p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .error-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .error-suggestion {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .error-suggestion p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .error-suggestion ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-suggestion a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .error-suggestion a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .error-line {
      flex-direction: column;
      gap: var(--space-2);
    }

    .error-actions {
      flex-direction: column;
    }

    .error-suggestion ul {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  /* Dark mode adjustments */
  @media (prefers-color-scheme: dark) {
    .error-screen {
      box-shadow:
        0 0 0 2px #2a2d9f,
        8px 8px 0 rgb(0 0 0 / 0.4);
    }
  }
</style>
