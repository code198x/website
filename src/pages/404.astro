---
import Layout from "../layouts/Layout.astro";
import "../styles/404.css";

// Random retro error messages
const retroErrors = [
  { system: "C64", message: "?SYNTAX ERROR", prompt: "READY." },
  { system: "ZX Spectrum", message: "R Tape loading error, 0:1", prompt: "LOAD \"\" CODE" },
  { system: "Amiga", message: "Software Failure. Press left mouse button to continue.", prompt: "Guru Meditation #00000404.00000000" },
  { system: "DOS", message: "Bad command or file name", prompt: "C:\\>" },
  { system: "Apple II", message: "*** SYNTAX ERR", prompt: "]" }
];

const randomError = retroErrors[Math.floor(Math.random() * retroErrors.length)];

// Fun sprites to float across the screen
const sprites = ["👾", "🕹️", "💾", "🖥️", "🎮"];
---

<Layout title="404: Page Not Found - Code Like It's 198x">
  <div class="error-page">
    <!-- Floating sprites for ambiance -->
    <div class="error-sprites">
      {sprites.map((sprite) => (
        <span class="error-sprite">{sprite}</span>
      ))}
    </div>

    <div class="error-container">
      <!-- Glitchy 404 -->
      <h1 class="error-code">404</h1>
      
      <!-- Error title -->
      <h2 class="error-title">Page Not Found</h2>
      
      <!-- Friendly message -->
      <p class="error-message">
        Looks like you've wandered into uncharted memory space! 
        This page might have been deleted, moved, or never existed in the first place.
      </p>

      <!-- Terminal window with retro error -->
      <div class="error-terminal">
        <div class="error-terminal-content">
          <div>
            <span class="error-terminal-prompt">{randomError.prompt}</span>
          </div>
          <div>
            <span>{randomError.message}</span>
          </div>
          <div>
            <span class="error-terminal-prompt">{randomError.prompt}</span>
            <span class="error-terminal-cursor"></span>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="error-actions">
        <a href="/" class="error-btn">
          <span class="error-btn-icon">🏠</span>
          <span>Return Home</span>
        </a>
        <a href="/lessons" class="error-btn">
          <span class="error-btn-icon">📚</span>
          <span>Browse Lessons</span>
        </a>
      </div>

      <!-- Quick links -->
      <div class="error-links">
        <p class="error-links-title">Or explore these popular sections:</p>
        <div class="error-links-list">
          <a href="/getting-started" class="error-link">Getting Started</a>
          <a href="/systems" class="error-link">Systems</a>
          <a href="/vault" class="error-link">The Vault</a>
          <a href="/about" class="error-link">About</a>
        </div>
      </div>

      <!-- Easter egg -->
      <div class="error-easter-egg">
        <p class="error-easter-egg-text">
          <span class="error-easter-egg-command">POKE 53280,0 : POKE 53281,0</span><br/>
          Fun fact: On a C64, this would turn your screen black! 
          But unlike this 404 error, at least you'd know where you were. 😉
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Add random delays to sprite animations for more natural movement
  document.addEventListener('DOMContentLoaded', () => {
    const sprites = document.querySelectorAll('.error-sprite');
    sprites.forEach((sprite, index) => {
      const delay = Math.random() * 5;
      const duration = 15 + Math.random() * 10;
      (sprite as HTMLElement).style.animationDelay = `${delay}s`;
      (sprite as HTMLElement).style.animationDuration = `${duration}s`;
    });
  });
</script>