---
import { getCollection } from 'astro:content';
import FromTheMetalLayout from '../../layouts/FromTheMetalLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('from-the-metal');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<FromTheMetalLayout entry={entry} />
