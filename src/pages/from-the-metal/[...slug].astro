---
import { getCollection } from 'astro:content';
import FromTheMetalLayout from '../../layouts/FromTheMetalLayout.astro';

export async function getStaticPaths() {
  // Drip release: a future-dated article gets no page until a rebuild on or
  // after its pubDate (its URL 404s until then).
  const entries = (await getCollection('from-the-metal'))
    .filter((entry) => entry.data.pubDate <= new Date());
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<FromTheMetalLayout entry={entry} />
