---
/**
 * From the Metal — the hub.
 *
 * Short essays that reframe modern programming advice by dropping down to a
 * vintage CPU where the cost is visible. Data-driven cards from the
 * `from-the-metal` collection, sorted by `order`, each carrying its topic accent.
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Drip release: only show pieces whose pubDate has arrived at build time.
// Future-dated articles stay hidden until a rebuild on or after their date.
const all = await getCollection('from-the-metal');
const articles = all
  .filter((a) => a.data.pubDate <= new Date())
  .sort((a, b) => a.data.order - b.data.order);
const upcoming = all.length - articles.length;
---

<Layout
  title="From the Metal"
  description="Short essays that reframe modern programming advice by dropping down to a vintage CPU — where the loop, the multiply, the branch all cost something you can see. The layer beneath the abstraction."
>
  <div class="wrap">
    <header class="vhead">
      <p class="eyebrow">// FROM THE METAL //</p>
      <h1>Programming explained through the machine.</h1>
      <div class="herorule"></div>
      <p class="lede">What does a loop cost? When does a smaller program run more slowly?
        These essays use vintage machines to examine how programs work and why familiar
        advice sometimes helps — and sometimes does not. Each explanation connects a
        concrete example to the choices we make when programming today.</p>
    </header>

    <div class="grid">
      {articles.map((a) => (
        <a class="card" href={`/from-the-metal/${a.id}`} style={`--accent: ${a.data.accent}`}>
          <span class="bar"></span>
          <p class="cat">{a.data.category} · {a.data.cpu}</p>
          <h2>{a.data.title}</h2>
          <p class="teaser">{a.data.teaser}</p>
          <span class="read">Read →</span>
        </a>
      ))}
    </div>
    {upcoming > 0 && (
      <p class="cadence">// {upcoming} more in the series — a new one every week //</p>
    )}
  </div>
</Layout>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; color: var(--color-house-2); }
  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }
  .cadence { font-family: var(--font-family-mono); font-size: 0.78rem; letter-spacing: 0.08em; color: var(--color-text-secondary); margin: var(--space-8) 0 0; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6) var(--space-5) var(--space-5);
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .card .bar { position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--accent); }
  .card:hover, .card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); }

  .cat { font-family: var(--font-family-mono); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .card h2 { font-family: var(--font-family-mono); font-weight: 700; font-size: 1.2rem; line-height: 1.2; letter-spacing: -0.3px; margin: var(--space-2) 0 0; color: var(--color-text); }
  .teaser { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; margin: var(--space-3) 0 0; }
  .read { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; color: var(--color-house-2); margin-top: auto; padding-top: var(--space-4); }

  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
