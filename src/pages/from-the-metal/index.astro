---
import Grid from '@198x-ui/components/layout/Grid.astro';
import FromTheMetalOpening from '../../components/FromTheMetalOpening.astro';
/**
 * From the Metal — the hub.
 *
 * Short essays that reframe modern programming advice by dropping down to a
 * vintage CPU where the cost is visible. Data-driven cards from the
 * `from-the-metal` collection, sorted by `order`, each carrying its topic accent.
 */
import Layout from '../../layouts/Layout.astro';
import PageFrame from '../../components/PageFrame.astro';
import { getCollection } from 'astro:content';

// Drip release: only show pieces whose pubDate has arrived at build time.
// Future-dated articles stay hidden until a rebuild on or after their date.
const all = await getCollection('from-the-metal');
const articles = all
  .filter((a) => a.data.pubDate <= new Date())
  .sort((a, b) => a.data.order - b.data.order);
const upcoming = all.length - articles.length;
---

<Layout
  title="From the Metal"
  description="Short essays that reframe modern programming advice by dropping down to a vintage CPU — where the loop, the multiply, the branch all cost something you can see. The layer beneath the abstraction."
>
  <FromTheMetalOpening />
  <PageFrame opening="compact">
    <p class="lede">What does a loop cost? When does a smaller program run more slowly?
        These essays use vintage machines to examine how programs work and why familiar
        advice sometimes helps — and sometimes does not. Each explanation connects a
        concrete example to the choices we make when programming today.</p>

    <Grid min="16rem" maxColumns={3} class="grid" style="--grid-space: var(--space-5)">
      {articles.map((a) => (
        <a class="card" href={`/from-the-metal/${a.id}`} style={`--accent: ${a.data.accent}`}>
          <span class="bar"></span>
          <p class="cat label">{a.data.category} · {a.data.cpu}</p>
          <h2>{a.data.title}</h2>
          <p class="teaser">{a.data.teaser}</p>
          <span class="read label">Read →</span>
        </a>
      ))}
    </Grid>
    {upcoming > 0 && (
      <p class="cadence">// {upcoming} more in the series — a new one every week //</p>
    )}
  </PageFrame>
</Layout>

<style>@layer blocks {
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--h-space-4) 0 2rem; color: var(--h-ink); }
  .grid { overflow-wrap: anywhere; }
  /* Each entry is a flat item under a hairline, marked by its series accent
     bar; hovering washes the ground. */
  .card {
    position: relative; display: flex; flex-direction: column;
    padding: var(--h-space-6) var(--space-5) var(--space-5);
    border-top: 1px solid var(--h-line); color: var(--h-ink); text-decoration: none;
  }
  .card:hover { background: var(--h-wash); }
  .card .bar { position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--accent); }
  .cat { color: var(--h-ink-muted); margin: 0; }
  .cadence { font-family: var(--h-font-ui); font-size: 0.8125rem; color: var(--h-ink-muted); margin: var(--h-space-8) 0 0; }
  .card h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: 1.3rem; line-height: 1.2; letter-spacing: -0.01em; margin: var(--h-space-2) 0 0; color: var(--h-ink); }
  .teaser { font-size: 0.9rem; color: var(--h-ink-muted); line-height: 1.6; margin: var(--h-space-3) 0 0; }
  .read { color: var(--h-spot-ink); margin-top: auto; padding-top: var(--h-space-4); }
}
</style>
