---
import '../../styles/support-pages.css';
import Layout from '../../layouts/Layout.astro';
import PageFrame from '../../components/PageFrame.astro';
import Switcher from '../../components/layout/Switcher.astro';

const GOOD_FIRST = 'https://github.com/search?q=org%3Acode198x+label%3A%22good+first+issue%22+state%3Aopen&type=issues';
const HELP_WANTED = 'https://github.com/code198x/website/issues?q=is%3Aissue+is%3Aopen+label%3A%22help+wanted%22';
const OPEN_PRS = 'https://github.com/search?q=org%3Acode198x+is%3Apr+is%3Aopen&type=pullrequests';
// The low-friction route in. A PR is a high bar for a first contact, and the
// people who can test on real hardware or spot a wrong fact are not always the
// people who want to open one.
const DISCORD = 'https://discord.gg/AdmEYQKWZb';

const steps = [
  ['1', 'Choose a task', 'Read its scope and comment before starting.'],
  ['2', 'Ask questions', 'Agree any unclear details with the maintainer.'],
  ['3', 'Share your work', 'Post findings or open a focused pull request.'],
  ['4', 'Review together', 'Check the result and refine it for publication.'],
];
const deal = [
  'Every page free to read — no ads, no paywalls',
  'Every code sample MIT-licensed',
  'Checks distinguish source review, successful builds and observed execution',
  'Original prose under CC BY 4.0',
  'If the project dies, the content survives',
];
const ways = [
  ['Review a lesson', 'tell us where the explanation loses you'],
  ['Author a game', 'on a machine you love'],
  ['Fill a vault entry', 'for a person, game, or chip'],
  ['Submit a pattern', 'with working code + screenshots'],
  ['Test on real iron', 'and attach photos to a PR'],
  ['Illustrate', 'help a reader see how something works'],
  ['Edit', 'catch the typos, tighten the prose'],
];
---

<Layout title="Contribute" description="Code Like It's 198x is community-built — free, open source, forever. Review a lesson, check accessibility, improve an illustration or contribute code and sources.">
  <PageFrame class="support-page" opening="compact">

    <div class="vhead">

      <h1 class="page-title">Help someone<br />understand a machine.</h1>
      <p class="lede">A clear explanation, a careful test or a useful illustration can make
        a lesson better. You do not need to write code to contribute. Start with a scoped
        GitHub issue, or <a href={DISCORD} rel="noopener">ask in Discord</a> if you would
        like help finding a task.</p>
    </div>

    <section class="how">
      <h2 class="support-label">How it works</h2>
      <div class="steps">
        {steps.map(([n, t, blurb], i) => (
          <div class="step">
            <div class="step-h"><span class="num">{n}</span><span class="t">{t}</span>{i < 3 && <span class="arrow">→</span>}</div>
            <p>{blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <Switcher as="section" class="two" threshold="52rem" style="--switcher-space: var(--space-5)">
      <div class="card deal">
        <h2>Free. Open source.<br />Forever.</h2>
        <ul class="ticks">{deal.map(d => <li>{d}</li>)}</ul>
        <p class="fine mono">github.com/code198x · archive available</p>
      </div>
      <div class="card ways">
        <h2>Find a useful<br />place to begin.</h2>
        <ul class="waylist">{ways.map(([t, rest]) => <li><strong>{t}</strong> {rest}</li>)}</ul>
        <div class="cta-row">
          <a class="btn btn-primary" href={GOOD_FIRST} rel="noopener">Browse starter tasks →</a>
          <a class="btn btn-secondary" href={DISCORD} rel="noopener">Ask in Discord</a>
          <a class="btn btn-secondary" href={OPEN_PRS} rel="noopener">Browse open PRs</a>
        </div>
      </div>
    </Switcher>

    <section class="issues">
      <h2 class="support-label">Work you can take on</h2>
      <div class="issues-cta">
        <p>Starter tasks include a focused lesson review and a keyboard check of one
          learning journey. The help-wanted list also includes work needing more specialist
          experience. Each issue explains where to begin and what a useful result looks like.
          Check its current status and comment before starting; a report can be a contribution
          without a pull request.</p>
        <a class="btn btn-primary" href={HELP_WANTED} rel="noopener">See open contribution tasks ↗</a>
      </div>
    </section>

    <p class="foot">New original prose contributions use <a href="/standards#licence">CC BY 4.0</a>{' '}
      unless a different arrangement is explicitly agreed and recorded. Keep author credits and
      identify third-party material and its terms. Contributors retain their copyright.</p>

    <Switcher as="section" class="three" threshold="52rem">
      <div class="mini"><h2 class="support-label">What you get</h2><p>Credit for your contribution and a chance to improve what readers learn. See <a href="/colophon">the people and tools behind the project</a>.</p></div>
      <div class="mini"><h2 class="support-label">What you won't get</h2><p>Money. Equity. A vesting schedule. This is a craft project, not a startup.</p></div>
      <div class="mini"><h2 class="support-label">The bar</h2><p>Working code, clear sources, honest screenshots, and prose that says what was actually checked. <a href="/standards">Read the standards.</a></p></div>
    </Switcher>
  </PageFrame>
</Layout>

<style>@layer blocks {
  .mono { font-family: var(--h-font-mono); }

  .vhead { margin-block: 40px; padding-bottom: 32px; border-bottom: 1px solid var(--h-line); color: var(--h-ink); background: transparent; }
  @media (max-width: 600px) { .vhead { margin-block: 28px; } }
  .vhead h1 { max-width: 26ch; margin: 18px 0 24px; }
  .lede { margin: var(--h-space-4) 0 0; max-width: var(--reading-width); font: 400 21px/1.6 var(--h-font-ui); color: var(--h-ink-body); }
  .lede a { color: var(--h-ink); text-decoration: underline; text-underline-offset: 0.15em; }

  section { margin-top: var(--h-space-8); }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--h-space-4); margin-top: var(--h-space-3); }
  .step { position: relative; border: 3px solid var(--h-line); background: var(--h-ground); padding: var(--h-space-4); }
  .step-h { display: flex; align-items: baseline; gap: 6px; }
  .step .num { font-family: var(--h-font-ui); font-weight: 700; font-size: 1.8rem; color: var(--h-spot-ink); }
  .step .t { font-weight: 800; font-size: 1rem; }
  .step .arrow { position: absolute; right: -12px; top: 12px; font-family: var(--h-font-mono); color: var(--h-ink-muted); }
  .step p { font-size: 0.82rem; color: var(--h-ink-muted); margin: var(--h-space-2) 0 0; line-height: 1.5; }

  .card { border: 0; border-top: 1px solid var(--h-line); background: transparent; padding: var(--h-space-6); }
  .card h2 { font-family: var(--h-font-ui); font-weight: 700; font-size: 1.9rem; line-height: 0.95; margin: var(--h-space-1) 0 0; }
  .ticks, .waylist { list-style: none; margin: var(--h-space-4) 0 0; padding: 0; }
  .ticks li, .waylist li { font-size: 0.9rem; padding: 5px 0 5px 22px; position: relative; line-height: 1.4; }
  .ticks li::before { content: "✓"; position: absolute; left: 0; color: var(--h-spot-ink); font-weight: 700; }
  .waylist li::before { content: "→"; position: absolute; left: 0; color: var(--h-spot-ink); font-family: var(--h-font-ui); font-weight: 600; }
  .fine { font-size: 0.7rem; color: var(--h-ink-muted); margin-top: var(--h-space-4); }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--h-space-3); margin-top: var(--space-5); }

  .issues-cta { border: 3px dashed var(--h-line); background: var(--h-ground); padding: var(--h-space-6); display: flex; align-items: center; justify-content: space-between; gap: var(--h-space-6); flex-wrap: wrap; margin-top: var(--h-space-3); }
  .issues-cta p { font-size: 0.95rem; color: var(--h-ink-muted); max-width: 60ch; margin: 0; }

  .mini { border: 3px solid var(--h-line); background: var(--h-ground); padding: var(--space-5); }
  .mini p:last-child { font-size: 0.88rem; color: var(--h-ink-muted); margin: var(--h-space-2) 0 0; line-height: 1.5; }
  .mini a { color: var(--h-ink); text-decoration: underline; text-underline-offset: 0.15em; }

  @media (max-width: 860px) { .steps { grid-template-columns: 1fr 1fr; } }
}
@layer blocks {
  @media print { :global(#main-content > .support-page) { padding: 0; } }
}
</style>
