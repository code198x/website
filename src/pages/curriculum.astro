---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getActivePlatforms } from '../lib/platforms';
import { getSectionModules } from '../lib/modules';

// Order is catalogue data, not a list in a page. See
// Code198x docs/decisions/state-lives-in-catalogues.md
const MODULE_ORDER: Record<string, string[]> = {
  foundations: (await getSectionModules('foundations')).map((m) => m.slug),
  craft: (await getSectionModules('craft')).map((m) => m.slug),
};

const readableTrack: Record<string, string> = {
  basic: 'BASIC',
  assembly: 'Assembly',
  amos: 'AMOS',
  blitz: 'Blitz',
};

const TRACK_ORDER: Record<string, number> = {
  basic: 1,
  amos: 2,
  blitz: 3,
  assembly: 4,
};

const moduleOrder = (section: string, slug: string) => {
  const index = MODULE_ORDER[section]?.indexOf(slug) ?? -1;
  return index === -1 ? 99 : index;
};

const sectionModules = (await getCollection('module-pages'))
  .filter((entry) => entry.id.startsWith('foundations/') || entry.id.startsWith('craft/'))
  .map((entry) => {
    const [section, slug] = entry.id.replace(/\/index$/, '').split('/');
    return {
      section,
      slug,
      title: entry.data.title,
      description: entry.data.description ?? '',
      href: `/${section}/${slug}`,
    };
  })
  .sort((a, b) =>
    a.section.localeCompare(b.section) ||
    moduleOrder(a.section, a.slug) - moduleOrder(b.section, b.slug) ||
    a.title.localeCompare(b.title)
  );

const foundations = sectionModules.filter((module) => module.section === 'foundations');
const craft = sectionModules.filter((module) => module.section === 'craft');

const platforms = await getActivePlatforms();
// Section catalogues (foundations, craft) carry neither field — keep only
// platform tracks here so `platform.id`/`track.data.track` stay defined below.
const moduleTracks = (await getCollection('modules'))
  .filter((entry) => entry.data.platform != null && entry.data.track != null);
const tracksByPlatform = new Map<string, typeof moduleTracks>();
for (const track of moduleTracks) {
  const platformTracks = tracksByPlatform.get(track.data.platform) ?? [];
  platformTracks.push(track);
  tracksByPlatform.set(track.data.platform, platformTracks);
}

const activeRoutes = platforms.map((platform) => {
  const tracks = (tracksByPlatform.get(platform.id) ?? [])
    .map((track) => {
      const primer = track.data.modules.find((module) => module.kind === 'teaching');
      const completeGames = track.data.modules.filter((module) => module.kind !== 'teaching' && module.status === 'complete').length;
      const plannedGames = track.data.modules.filter((module) => module.kind !== 'teaching').length;
      return {
        name: readableTrack[track.data.track] ?? track.data.track,
        href: `/${platform.id}/${track.data.track}`,
        primer: primer?.name ?? 'Primer',
        completeGames,
        plannedGames,
        order: TRACK_ORDER[track.data.track] ?? 99,
      };
    })
    .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));

  return {
    name: platform.data.name,
    shortName: platform.data.shortName,
    href: `/${platform.id}`,
    tier: platform.data.tier,
    color: platform.data.color,
    tracks,
  };
});

const layers = [
  {
    number: '01',
    title: 'Foundations',
    href: '/foundations',
    role: 'Before a language',
    body: 'General programming, numbers, bits, and the idea of translation from source to running program.',
  },
  {
    number: '02',
    title: 'Language primers',
    href: '/systems',
    role: 'First concrete route',
    body: 'Meet BASIC, assembly, AMOS, Blitz or another route as that machine actually speaks it.',
  },
  {
    number: '03',
    title: 'The Craft',
    href: '/craft',
    role: 'Cross-machine technique',
    body: 'Game-making ideas that transfer: cheap maths, visible rules, timing, state, collision and feel.',
  },
  {
    number: '04',
    title: 'Machine tracks',
    href: '/systems',
    role: 'Actual application',
    body: 'The registers, screen memory, sound chips, ROM calls, frame loops and complete games for one machine.',
  },
  {
    number: '05',
    title: 'Pattern Library',
    href: '/patterns',
    role: 'Reference shelf',
    body: 'Reusable recipes and distilled patterns once an idea has been taught somewhere concrete.',
  },
];
---

<Layout
  title="Curriculum Map"
  description="The learning architecture for Code Like It's 198x: Foundations, language primers, The Craft, machine tracks, and the Pattern Library."
>
  <div class="wrap">
    <section class="hero">
      <div class="ghost" aria-hidden="true"><span>Map</span></div>
      <div class="in">
        <p class="eyebrow">Curriculum map</p>
        <h1>How the whole course fits together.</h1>
        <div class="rule"></div>
        <p class="lede">
          Code Like It's 198x is not a pile of disconnected lessons. It has layers:
          foundations before languages, primers before full tracks, Craft before repeated
          cross-machine technique, and reference once an idea has somewhere real to point.
        </p>
      </div>
    </section>

    <section class="path" aria-label="Curriculum layers">
      {layers.map((layer) => (
        <a href={layer.href} class="path-step">
          <span class="num">{layer.number}</span>
          <span class="role">{layer.role}</span>
          <h2>{layer.title}</h2>
          <p>{layer.body}</p>
        </a>
      ))}
    </section>

    <section class="split">
      <div class="panel">
        <p class="eyebrow">Core route</p>
        <h2>For a new learner</h2>
        <ol class="sequence">
          <li><a href="/foundations">Foundations</a> if the programming ideas are new.</li>
          <li>Pick a machine route: BASIC, assembly, AMOS, Blitz, or whatever that system supports.</li>
          <li>Use <a href="/craft">The Craft</a> when a game-making idea should transfer across machines.</li>
          <li>Build the machine-track games in order; each turns general ideas into real code.</li>
          <li>Return to the <a href="/patterns">Pattern Library</a> when you need a compact recipe.</li>
        </ol>
      </div>
      <div class="panel">
        <p class="eyebrow">How lessons repeat</p>
        <h2>Not everything appears once</h2>
        <p>
          A primer teaches the first vocabulary for a route. Later games can pause for
          mid-language modules when they need a new idiom or feature. Craft modules teach
          transferable technique, then machine tracks show the version that survives a real
          screen layout, CPU, toolchain and frame budget.
        </p>
      </div>
    </section>

    <section class="catalogue">
      <div class="section-head">
        <p class="eyebrow">Shared layers</p>
        <h2>Things taught once, then reused.</h2>
      </div>
      <div class="module-columns">
        <div>
          <h3>Foundations</h3>
          <div class="module-list">
            {foundations.map((module) => (
              <a href={module.href} class="module">
                <strong>{module.title}</strong>
                <span>{module.description}</span>
              </a>
            ))}
          </div>
        </div>
        <div>
          <h3>The Craft</h3>
          <div class="module-list">
            {craft.map((module) => (
              <a href={module.href} class="module">
                <strong>{module.title}</strong>
                <span>{module.description}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="routes">
      <div class="section-head">
        <p class="eyebrow">Machine routes</p>
        <h2>Where the ideas become code.</h2>
        <p>
          These are the active system routes on the site today. The map shows entry paths,
          not every planned game.
        </p>
      </div>
      <div class="route-grid">
        {activeRoutes.map((route) => (
          <article class="route-card" style={`--pc: ${route.color};`}>
            <div class="top"></div>
            <div class="route-body">
              <div class="route-head">
                <h3><a href={route.href}>{route.shortName}</a></h3>
                <span>{route.tier}</span>
              </div>
              <ul>
                {route.tracks.map((track) => (
                  <li>
                    <a href={track.href}>{track.name}</a>
                    <span>{track.primer} · {track.completeGames}/{track.plannedGames} games complete</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="support">
      <a href="/standards">
        <span>Trust layer</span>
        <strong>Sources & Standards</strong>
        <p>What counts as checked, cited, built, run and real.</p>
      </a>
      <a href="/vault">
        <span>Context layer</span>
        <strong>The Vault</strong>
        <p>The people, companies, games, hardware and culture around the lessons.</p>
      </a>
      <a href="/setup">
        <span>Practical layer</span>
        <strong>Setup Guide</strong>
        <p>Emulators, toolchains, ROMs and the first run on a real old machine.</p>
      </a>
    </section>
  </div>
</Layout>

<style>
  .wrap {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-16);
  }
  .eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-house-2);
    margin: 0;
  }
  .hero { position: relative; overflow: hidden; margin-top: var(--space-4); padding: var(--space-8) 0 var(--space-8); }
  .ghost { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; pointer-events: none; overflow: hidden; z-index: 0; }
  .ghost span {
    font-family: var(--font-family-read);
    font-weight: 700;
    font-size: clamp(120px, 24vw, 280px);
    line-height: 0.7;
    color: var(--color-house);
    opacity: 0.08;
    transform: rotate(-4deg);
    margin-right: -8px;
    white-space: nowrap;
  }
  .hero .in { position: relative; z-index: 1; }
  .hero h1 {
    font-family: var(--font-family-read);
    font-weight: 700;
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    line-height: 0.9;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
    margin: var(--space-2) 0 0;
    color: var(--color-text);
    max-width: 18ch;
  }
  .rule { height: 9px; width: 220px; max-width: 70%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 22%; background: var(--color-house-2); }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  .path {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-10);
  }
  .path-step {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--space-4);
    text-decoration: none;
    box-shadow: var(--shadow-chunky);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .path-step:hover,
  .path-step:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--color-house-2);
    outline: none;
  }
  .num {
    display: block;
    font-family: var(--font-family-read);
    font-size: 2.2rem;
    line-height: 0.8;
    color: var(--color-house-2);
  }
  .role {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .path-step h2 { font-size: 1.15rem; margin: var(--space-2) 0 0; }
  .path-step p { font-size: 0.82rem; line-height: 1.5; color: var(--color-text-secondary); margin: var(--space-2) 0 0; }

  .split,
  .module-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .panel {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6);
  }
  .panel h2,
  .section-head h2 {
    font-size: 1.45rem;
    color: var(--color-text);
    margin: var(--space-2) 0 var(--space-2);
  }
  .panel p,
  .section-head p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .sequence {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
  }
  .sequence li { line-height: 1.6; margin-bottom: var(--space-2); }
  .sequence a,
  .route-card a { color: var(--ink); font-weight: 700; }

  .catalogue,
  .routes {
    margin-top: var(--space-10);
  }
  .section-head { max-width: 72ch; margin-bottom: var(--space-4); }
  .module-columns h3 {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }
  .module-list { display: grid; gap: var(--space-3); }
  .module {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 3px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
  }
  .module:hover,
  .module:focus-visible { border-color: var(--color-text); outline: none; }
  .module strong { color: var(--ink); }
  .module span { color: var(--color-text-secondary); font-size: 0.86rem; line-height: 1.5; }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .route-card {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    overflow: hidden;
  }
  .route-card .top { height: 9px; background: var(--pc); }
  .route-body { padding: var(--space-4); }
  .route-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .route-head h3 { font-size: 1.2rem; margin: 0; }
  .route-head span {
    font-family: var(--font-family-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .route-card ul { list-style: none; display: grid; gap: var(--space-3); margin: var(--space-4) 0 0; padding: 0; }
  .route-card li { display: flex; flex-direction: column; gap: 3px; }
  .route-card li span { color: var(--color-text-secondary); font-size: 0.8rem; line-height: 1.45; }

  .support {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-10);
  }
  .support a {
    border: 3px solid var(--color-border);
    background: var(--color-bg-secondary);
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }
  .support a:hover,
  .support a:focus-visible { border-color: var(--color-text); outline: none; }
  .support span {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .support strong { display: block; margin-top: var(--space-2); color: var(--ink); }
  .support p { color: var(--color-text-secondary); font-size: 0.86rem; line-height: 1.5; margin: var(--space-2) 0 0; }

  @media (max-width: 980px) {
    .path { grid-template-columns: repeat(2, 1fr); }
    .support { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .wrap { padding: var(--space-4) var(--space-4) var(--space-12); }
    .path,
    .split,
    .module-columns { grid-template-columns: 1fr; }
  }
</style>
