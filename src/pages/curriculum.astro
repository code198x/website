---
import CurriculumOpening from '../components/CurriculumOpening.astro';
import Layout from '../layouts/Layout.astro';
import PageFrame from '../components/PageFrame.astro';
import Grid from '../components/layout/Grid.astro';
import Stack from '../components/layout/Stack.astro';
import Switcher from '../components/layout/Switcher.astro';
import { getCollection } from 'astro:content';
import { getSectionModules } from '../lib/modules';

// Order is catalogue data, not a list in a page. See
// Code198x docs/website.md#content-and-navigation
const MODULE_ORDER: Record<string, string[]> = {
  foundations: (await getSectionModules('foundations')).map((m) => m.slug),
  craft: (await getSectionModules('craft')).map((m) => m.slug),
};

const moduleOrder = (section: string, slug: string) => {
  const index = MODULE_ORDER[section]?.indexOf(slug) ?? -1;
  return index === -1 ? 99 : index;
};

const unitPages = await getCollection('unit-pages');

const sectionModules = (await getCollection('module-pages'))
  .filter((entry) => entry.id.startsWith('foundations/') || entry.id.startsWith('craft/'))
  .map((entry) => {
    const [section, slug] = entry.id.replace(/\/index$/, '').split('/');
    return {
      section,
      slug,
      lessonCount: unitPages.filter((unit) => unit.id.startsWith(`${section}/${slug}/unit-`)).length,
      title: entry.data.title,
      description: entry.data.description ?? '',
      href: `/${section}/${slug}`,
    };
  })
  .sort((a, b) =>
    a.section.localeCompare(b.section) ||
    moduleOrder(a.section, a.slug) - moduleOrder(b.section, b.slug) ||
    a.title.localeCompare(b.title)
  );

const foundations = sectionModules.filter((module) => module.section === 'foundations');
const craft = sectionModules.filter((module) => module.section === 'craft');

const layers = [
  { title: 'System tracks', href: '/systems', role: 'Build and investigate', body: 'Guided projects in a particular language and machine. Learn its syntax, tools and hardware as you make things.' },
  { title: 'Foundations', href: '/foundations', role: 'Programming concepts', body: 'Explore instructions, representation and execution through pseudocode. Start here or visit an idea when it becomes useful.' },
  { title: 'The Craft', href: '/craft', role: 'Game-making concepts', body: 'Shared maths and design explanations. The first lessons are published; more sequences are in development.' },
  { title: 'The Vault', href: '/vault', role: 'Context and reference', body: 'An encyclopaedia connecting machines, games, people and the circumstances in which they worked.' },
  { title: 'Pattern Library', href: '/patterns', role: 'Techniques to adapt', body: 'Concrete implementations with assumptions and trade-offs, connected to lessons and particular machines.' },
];
---

<Layout
  title="Curriculum Map"
  description="How system tracks, Foundations, The Craft, the Vault and the Pattern Library support different starting points."
>
  <CurriculumOpening />
  <PageFrame opening="compact" class="curriculum-page">
    <p class="lede">Start with a system track or explore Foundations and The Craft first.
          Lessons explain the immediate task and connect to deeper ideas when they help.
          These are parts of one curriculum, not stages you must complete in order.</p>

    <Grid as="section" min="20rem" maxColumns={3} space={3} class="path" aria-label="Curriculum layers">
      {layers.map((layer) => (
        <a href={layer.href} class="path-step ink-card">
          <span class="role label">{layer.role}</span>
          <h2>{layer.title}</h2>
          <p>{layer.body}</p>
        </a>
      ))}
    </Grid>

    <Switcher as="section" threshold="43rem" limit={2} class="split" style="--switcher-space: 1.25rem">
      <div class="panel">
        <p class="eyebrow label">Choose a starting point</p>
        <h2>Begin with what you want to make or understand</h2>
        <p>You can start a system track without completing <a href="/foundations">Foundations</a>. BASIC and assembly
          are independent entry points; one is not a qualification for the other.
          A track teaches its language and machine, with links to shared explanations.</p>
        <p class="panel-link"><a href="/start-here">Find a starting point →</a></p>
      </div>
      <div class="panel">
        <p class="eyebrow label">Work through a project</p>
        <h2>Build in guided, runnable stages</h2>
        <p>Within a game, follow the development sequence: each stage explains what changes
          and gives you something to try. When a concept is unfamiliar, use its linked
          explanation and return to the game. You do not need to invent a project of your
          own to get started.</p>
      </div>
    </Switcher>

    <section class="catalogue">
      <div class="section-head">
        <p class="eyebrow label">Alongside every track</p>
        <h2>Explore Foundations and The Craft.</h2>
        <p>Lesson counts reflect published lesson pages, not a claim that every planned topic is complete. An outline describes intended coverage.</p>
      </div>
      <Switcher threshold="43rem" limit={2} class="module-columns" style="--switcher-space: 1.25rem">
        <div>
          <h3 class="label"><a href="/foundations">Foundations</a></h3>
          <Stack space={3} class="module-list">
            {foundations.map((module) => (
              <a href={module.href} class="module">
                <strong>{module.title}</strong>
                <span>{module.description}</span>
                <small>{module.lessonCount > 0 ? `${module.lessonCount} lesson ${module.lessonCount === 1 ? "page" : "pages"}` : "Outline · lessons not yet available"}</small>
              </a>
            ))}
          </Stack>
        </div>
        <div>
          <h3 class="label"><a href="/craft">The Craft</a></h3>
          <Stack space={3} class="module-list">
            {craft.map((module) => (
              <a href={module.href} class="module">
                <strong>{module.title}</strong>
                <span>{module.description}</span>
                <small>{module.lessonCount > 0 ? `${module.lessonCount} lesson ${module.lessonCount === 1 ? "page" : "pages"}` : "Outline · lessons not yet available"}</small>
              </a>
            ))}
          </Stack>
        </div>
      </Switcher>
    </section>

    <section class="routes">
      <div class="section-head">
        <p class="eyebrow label">Machine routes</p>
        <h2>Where the ideas become code.</h2>
        <p>Every machine has its own route, and the systems directory is where they live — with what is
          shipping, what is in build, and what is planned, kept current from the catalogue rather
          than restated here.</p>
      </div>
      <p class="routes-cta"><a class="btn" href="/systems">Browse systems →</a></p>
    </section>

    <Switcher as="section" threshold="59rem" limit={3} space={4} class="support">
      <a href="/standards">
        <span class="label">Trust layer</span>
        <strong>Sources & Standards</strong>
        <p>What counts as checked, cited, built, run and real.</p>
      </a>
      <a href="/vault">
        <span class="label">Context layer</span>
        <strong>The Vault</strong>
        <p>The people, companies, games, hardware and culture around the lessons.</p>
      </a>
      <a href="/setup">
        <span class="label">Practical layer</span>
        <strong>Setup Guide</strong>
        <p>Emulators, toolchains, ROMs and the first run on a real old machine.</p>
      </a>
    </Switcher>
  </PageFrame>
</Layout>

<style>@layer blocks {
  .panel p a { text-decoration: underline; text-underline-offset: 0.15em; }
  .module small { color: var(--h-ink-muted); font-size: var(--h-text-small); }
  .panel .panel-link { margin-top: var(--h-space-4); }
  .panel-link a { color: var(--h-ink); text-underline-offset: .15em; }
  .routes-cta { margin: var(--space-5) 0 0; }
  .routes-cta .btn:hover { text-decoration: underline; }

  .eyebrow {
    color: var(--h-spot-ink);
    margin: 0;
  }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 72ch; margin: var(--h-space-4) 0 0; color: var(--h-ink); }

  .path {
    margin: var(--h-space-4) 0 var(--space-10);
  }
  .path-step {
    color: var(--h-ink);
    padding: var(--h-space-4);
    --card-accent: var(--h-spot-ink);
  }
  .role {
    display: block;
    margin-top: var(--h-space-2);
    color: var(--h-ink-muted);
  }
  .path-step h2 { font-size: 1.15rem; margin: var(--h-space-2) 0 0; }
  .path-step p { font-size: 0.82rem; line-height: 1.5; color: var(--h-ink-muted); margin: var(--h-space-2) 0 0; }

  .panel {
    border: 3px solid var(--h-ink);
    background: var(--h-ground);
    padding: var(--h-space-6);
  }
  .panel h2, .section-head h2 {
    font-size: var(--heading-h4-size); line-height: var(--h-lh-h4); letter-spacing: var(--h-tr-h4);
    color: var(--h-ink);
    margin: var(--h-space-2) 0 var(--h-space-2);
  }
  .panel p, .section-head p {
    color: var(--h-ink-muted);
    line-height: 1.6;
    margin: 0;
  }
  .sequence {
    margin: var(--h-space-3) 0 0;
    padding-left: var(--space-5);
    color: var(--h-ink-muted);
  }
  .sequence li { line-height: 1.6; margin-bottom: var(--h-space-2); }
  .sequence a { color: var(--ink); font-weight: 700; }

  .catalogue, .routes {
    margin-top: var(--space-10);
  }
  .section-head { max-width: 72ch; margin-bottom: var(--h-space-4); }
  .module-columns h3 {
    color: var(--h-ink-muted);
    margin: 0 0 var(--h-space-3);
  }
  .module {
    display: flex;
    flex-direction: column;
    gap: var(--h-space-2);
    border: 3px solid var(--h-line);
    background: var(--h-ground);
    padding: var(--h-space-4);
    text-decoration: none;
    color: var(--h-ink);
  }
  .module:hover, .module:focus-visible { border-color: var(--h-ink); outline: none; }
  .module strong { color: var(--ink); }
  .module span { color: var(--h-ink-muted); font-size: 0.86rem; line-height: 1.5; }

  .support {
    margin-top: var(--space-10);
  }
  .support a {
    border: 3px solid var(--h-line);
    background: var(--h-ground);
    padding: var(--h-space-4);
    color: var(--h-ink);
    text-decoration: none;
  }
  .support a:hover, .support a:focus-visible { border-color: var(--h-ink); outline: none; }
  .support span {
    display: block;
    color: var(--h-ink-muted);
  }
  .support strong { display: block; margin-top: var(--h-space-2); color: var(--ink); }
  .support p { color: var(--h-ink-muted); font-size: 0.86rem; line-height: 1.5; margin: var(--h-space-2) 0 0; }

}
@layer blocks {
  .routes-cta .btn { display: inline-block; border: 3px solid var(--h-ink); background: var(--h-ground); padding: var(--h-space-2) var(--space-5); font-weight: 700; color: var(--h-ink); text-decoration: none; }
}
</style>

<style>@layer blocks {
:global(main#main-content[data-site-frame]:has(> .curriculum-opening)) { max-width: none; }
}
</style>


<style>@layer blocks {
.lede { margin-bottom: 2rem; }
}
</style>

<style>@layer blocks {
.path-step, .panel { min-width: 0; overflow-wrap: anywhere; }
}
@layer blocks {
  @media print { :global(#main-content > .curriculum-page) { padding: 0; } }
}
</style>
