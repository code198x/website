---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getSectionModules } from '../lib/modules';

// Order is catalogue data, not a list in a page. See
// Code198x docs/website.md#content-and-navigation
const MODULE_ORDER: Record<string, string[]> = {
  foundations: (await getSectionModules('foundations')).map((m) => m.slug),
  craft: (await getSectionModules('craft')).map((m) => m.slug),
};

const moduleOrder = (section: string, slug: string) => {
  const index = MODULE_ORDER[section]?.indexOf(slug) ?? -1;
  return index === -1 ? 99 : index;
};

const unitPages = await getCollection('unit-pages');

const sectionModules = (await getCollection('module-pages'))
  .filter((entry) => entry.id.startsWith('foundations/') || entry.id.startsWith('craft/'))
  .map((entry) => {
    const [section, slug] = entry.id.replace(/\/index$/, '').split('/');
    return {
      section,
      slug,
      lessonCount: unitPages.filter((unit) => unit.id.startsWith(`${section}/${slug}/unit-`)).length,
      title: entry.data.title,
      description: entry.data.description ?? '',
      href: `/${section}/${slug}`,
    };
  })
  .sort((a, b) =>
    a.section.localeCompare(b.section) ||
    moduleOrder(a.section, a.slug) - moduleOrder(b.section, b.slug) ||
    a.title.localeCompare(b.title)
  );

const foundations = sectionModules.filter((module) => module.section === 'foundations');
const craft = sectionModules.filter((module) => module.section === 'craft');

const layers = [
  { title: 'System tracks', href: '/systems', role: 'Build and investigate', body: 'Guided projects in a particular language and machine. Learn its syntax, tools and hardware as you make things.' },
  { title: 'Foundations', href: '/foundations', role: 'Programming concepts', body: 'Explore instructions, representation and execution through pseudocode. Start here or visit an idea when it becomes useful.' },
  { title: 'The Craft', href: '/craft', role: 'Game-making concepts', body: 'Shared maths and design explanations in development. Current outlines show the intended coverage.' },
  { title: 'The Vault', href: '/vault', role: 'Context and reference', body: 'An encyclopaedia connecting machines, games, people and the circumstances in which they worked.' },
  { title: 'Pattern Library', href: '/patterns', role: 'Techniques to adapt', body: 'Concrete implementations with assumptions and trade-offs, connected to lessons and particular machines.' },
];
---

<Layout
  title="Curriculum Map"
  description="How system tracks, Foundations, The Craft, the Vault and the Pattern Library support different starting points."
>
  <div class="wrap">
    <section class="hero">
      <div class="ghost" aria-hidden="true"><span>Map</span></div>
      <div class="in">
        <p class="eyebrow">Curriculum map</p>
        <h1>How the curriculum fits together.</h1>
        <div class="rule"></div>
        <p class="lede">Start with a system track or explore the shared subjects first.
          Lessons explain the immediate task and connect to deeper ideas when they help.
          These are parts of one curriculum, not stages you must complete in order.</p>
      </div>
    </section>

    <section class="path" aria-label="Curriculum layers">
      {layers.map((layer) => (
        <a href={layer.href} class="path-step">
          <span class="role">{layer.role}</span>
          <h2>{layer.title}</h2>
          <p>{layer.body}</p>
        </a>
      ))}
    </section>

    <section class="split">
      <div class="panel">
        <p class="eyebrow">Choose a starting point</p>
        <h2>Begin with what you want to make or understand</h2>
        <p>You can start a system track without completing Foundations. BASIC and assembly
          are independent entry points; one is not a qualification for the other.
          A track teaches its language and machine, with links to shared explanations.</p>
        <p class="panel-link"><a href="/start-here">Find a starting point →</a></p>
      </div>
      <div class="panel">
        <p class="eyebrow">Work through a project</p>
        <h2>Build in guided, runnable stages</h2>
        <p>Within a game, follow the development sequence: each stage explains what changes
          and gives you something to try. When a concept is unfamiliar, use its linked
          explanation and return to the game. You do not need to invent a project of your
          own to get started.</p>
      </div>
    </section>

    <section class="catalogue">
      <div class="section-head">
        <p class="eyebrow">Shared layers</p>
        <h2>Explore the shared subjects.</h2>
        <p>Lesson counts reflect published lesson pages, not a claim that every planned topic is complete. An outline describes intended coverage.</p>
      </div>
      <div class="module-columns">
        <div>
          <h3>Foundations</h3>
          <div class="module-list">
            {foundations.map((module) => (
              <a href={module.href} class="module">
                <strong>{module.title}</strong>
                <span>{module.description}</span>
                <small>{module.lessonCount > 0 ? `${module.lessonCount} lesson ${module.lessonCount === 1 ? "page" : "pages"}` : "Outline · lessons not yet available"}</small>
              </a>
            ))}
          </div>
        </div>
        <div>
          <h3>The Craft</h3>
          <div class="module-list">
            {craft.map((module) => (
              <a href={module.href} class="module">
                <strong>{module.title}</strong>
                <span>{module.description}</span>
                <small>{module.lessonCount > 0 ? `${module.lessonCount} lesson ${module.lessonCount === 1 ? "page" : "pages"}` : "Outline · lessons not yet available"}</small>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="routes">
      <div class="section-head">
        <p class="eyebrow">Machine routes</p>
        <h2>Where the ideas become code.</h2>
        <p>Every machine has its own route, and the systems directory is where they live — with what is
          shipping, what is in build, and what is planned, kept current from the catalogue rather
          than restated here.</p>
      </div>
      <p class="routes-cta"><a class="btn" href="/systems">Browse systems →</a></p>
    </section>

    <section class="support">
      <a href="/standards">
        <span>Trust layer</span>
        <strong>Sources & Standards</strong>
        <p>What counts as checked, cited, built, run and real.</p>
      </a>
      <a href="/vault">
        <span>Context layer</span>
        <strong>The Vault</strong>
        <p>The people, companies, games, hardware and culture around the lessons.</p>
      </a>
      <a href="/setup">
        <span>Practical layer</span>
        <strong>Setup Guide</strong>
        <p>Emulators, toolchains, ROMs and the first run on a real old machine.</p>
      </a>
    </section>
  </div>
</Layout>

<style>
  .module small { color: var(--h-ink-muted); font-size: var(--h-text-small); }
  .panel .panel-link { margin-top: var(--space-4); }
  .panel-link a { color: var(--h-ink); text-underline-offset: .15em; }
  .routes-cta { margin: var(--space-5) 0 0; }
  .routes-cta .btn { display: inline-block; border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky); padding: var(--space-2) var(--space-5); font-weight: 700; color: var(--color-text); text-decoration: none; }
  .routes-cta .btn:hover { transform: translate(-2px, -2px); }

  .wrap {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--gutter) var(--space-16);
  }
  .eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-house-2);
    margin: 0;
  }
  .hero { position: relative; overflow: hidden; margin-top: var(--space-4); padding: var(--space-8) 0 var(--space-8); }
  .ghost { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; pointer-events: none; overflow: hidden; z-index: 0; }
  .ghost span {
    font-family: var(--font-family-read);
    font-weight: 700;
    font-size: clamp(120px, 24vw, 280px);
    line-height: 0.7;
    color: var(--color-house);
    opacity: 0.08;
    transform: rotate(-4deg);
    margin-right: -8px;
    white-space: nowrap;
  }
  .hero .in { position: relative; z-index: 1; }
  .hero h1 {
    font-family: var(--font-family-read);
    font-weight: 700;
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    line-height: 0.9;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
    margin: var(--space-2) 0 0;
    color: var(--color-text);
    max-width: 18ch;
  }
  .rule { height: 9px; width: 220px; max-width: 70%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 22%; background: var(--color-house-2); }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  .path {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-10);
  }
  .path-step {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--space-4);
    text-decoration: none;
    box-shadow: var(--shadow-chunky);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .path-step:hover,
  .path-step:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--color-house-2);
    outline: none;
  }
  .num {
    display: block;
    font-family: var(--font-family-read);
    font-size: 2.2rem;
    line-height: 0.8;
    color: var(--color-house-2);
  }
  .role {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .path-step h2 { font-size: 1.15rem; margin: var(--space-2) 0 0; }
  .path-step p { font-size: 0.82rem; line-height: 1.5; color: var(--color-text-secondary); margin: var(--space-2) 0 0; }

  .split,
  .module-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .panel {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-6);
  }
  .panel h2,
  .section-head h2 {
    font-size: 1.45rem;
    color: var(--color-text);
    margin: var(--space-2) 0 var(--space-2);
  }
  .panel p,
  .section-head p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .sequence {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
  }
  .sequence li { line-height: 1.6; margin-bottom: var(--space-2); }
  .sequence a,
  .route-card a { color: var(--ink); font-weight: 700; }

  .catalogue,
  .routes {
    margin-top: var(--space-10);
  }
  .section-head { max-width: 72ch; margin-bottom: var(--space-4); }
  .module-columns h3 {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }
  .module-list { display: grid; gap: var(--space-3); }
  .module {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 3px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
  }
  .module:hover,
  .module:focus-visible { border-color: var(--color-text); outline: none; }
  .module strong { color: var(--ink); }
  .module span { color: var(--color-text-secondary); font-size: 0.86rem; line-height: 1.5; }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .route-card {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    overflow: hidden;
  }
  .route-card .top { height: 9px; background: var(--pc); }
  .route-body { padding: var(--space-4); }
  .route-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .route-head h3 { font-size: 1.2rem; margin: 0; }
  .route-head span {
    font-family: var(--font-family-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .route-card ul { list-style: none; display: grid; gap: var(--space-3); margin: var(--space-4) 0 0; padding: 0; }
  .route-card li { display: flex; flex-direction: column; gap: 3px; }
  .route-card li span { color: var(--color-text-secondary); font-size: 0.8rem; line-height: 1.45; }

  .support {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-10);
  }
  .support a {
    border: 3px solid var(--color-border);
    background: var(--color-bg-secondary);
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }
  .support a:hover,
  .support a:focus-visible { border-color: var(--color-text); outline: none; }
  .support span {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .support strong { display: block; margin-top: var(--space-2); color: var(--ink); }
  .support p { color: var(--color-text-secondary); font-size: 0.86rem; line-height: 1.5; margin: var(--space-2) 0 0; }

  @media (max-width: 980px) {
    .path { grid-template-columns: repeat(2, 1fr); }
    .support { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .wrap { padding: var(--space-4) var(--gutter) var(--space-12); }
    .path,
    .split,
    .module-columns { grid-template-columns: 1fr; }
  }
</style>
