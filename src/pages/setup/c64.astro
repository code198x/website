---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import FullWidthSection from "../../components/FullWidthSection.astro";
import Hero from "../../components/Hero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Card from "../../components/Card.astro";
import Grid from "../../components/Grid.astro";
---

<Layout title="C64 Development Setup">
  <Breadcrumb
    items={[
      { label: "🏠 Home", href: "/" },
      { label: "⚙️ Setup", href: "/setup" },
      { label: "💾 Commodore 64" },
    ]}
  />

  <div class="container">
    <Hero
      title="Commodore 64 Development Setup"
      description="Get your C64 development environment running in 15 minutes. Choose Docker for simplicity or install tools directly."
      variant="centered"
      badge={{
        text: "💾 Retro Development Made Easy",
        color: "#10b981",
      }}
    />

    <!-- Quick Choice -->
    <SectionHeader
      title="Choose Your Setup Method"
      subtitle="Pick the approach that works best for you"
      variant="centered"
    />

    <Grid columns={2} gap="large" variant="cards">
      <Card
        variant="feature"
        headerIcon="🐳"
        title="Docker (Recommended)"
        description="Everything pre-configured in containers. Zero setup hassle - works on Mac, Windows, and Linux instantly."
        actions={[
          {
            text: "Use Docker →",
            href: "#docker",
            variant: "primary",
          },
        ]}
      />
      <Card
        variant="feature"
        headerIcon="💻"
        title="Local Installation"
        description="Install assemblers and emulators directly on your system. More control, requires manual setup."
        actions={[
          {
            text: "Install Locally →",
            href: "#local",
            variant: "secondary",
          },
        ]}
      />
    </Grid>

    <!-- What You'll Need -->
    <SectionHeader
      title="What We're Installing"
      subtitle="Three essential tools for C64 development"
      variant="centered"
    />

    <Grid columns={3} gap="large" variant="cards">
      <Card
        variant="feature"
        headerIcon="📝"
        title="ACME Assembler"
        description="Converts your assembly code into machine code the C64 can run. Modern, fast, with great error messages."
      />
      <Card
        variant="feature"
        headerIcon="🎮"
        title="VICE Emulator"
        description="Runs your C64 programs on modern hardware. Cycle-accurate emulation with debugging tools."
      />
      <Card
        variant="feature"
        headerIcon="✏️"
        title="Text Editor"
        description="Any editor works! VS Code recommended for syntax highlighting and integrated build commands."
      />
    </Grid>

    <!-- Docker Setup -->
    <div id="docker" class="section-spacing">
      <SectionHeader
        title="🐳 Docker Setup (Recommended)"
        subtitle="Everything pre-configured in one command"
        variant="default"
      />

      <div class="setup-section setup-section-docker">
        <div class="setup-steps">
          <!-- Step 1 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">Step 1: Install Docker Desktop</h3>
            <div class="instruction-box">
              <p class="instruction-label"><strong>macOS/Windows:</strong></p>
              <a
                href="https://www.docker.com/products/docker-desktop"
                target="_blank"
                class="link-docker"
              >
                Download Docker Desktop →
              </a>
              <p class="instruction-label instruction-label-spaced"><strong>Linux:</strong></p>
              <strong>Install Docker on Linux:</strong>
              <pre
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash">sudo apt install docker.io docker-compose</code></pre>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">Step 2: Get the Development Environment</h3>
            <strong>Clone Repository:</strong>
            <pre
              style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash"># Clone the repository
git clone https://github.com/code198x/development-environment.git
cd development-environment</code></pre>
          </div>

          <!-- Step 3 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">Step 3: Start the Environment</h3>
            <strong>Start Docker Environment:</strong>
            <pre
              style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash"># Start Docker containers
docker-compose up -d

# Enter the workspace
docker-compose exec workspace bash</code></pre>
            <p class="help-text">You're now in a Linux environment with all C64 tools installed!</p>
          </div>

          <!-- Step 4 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">Step 4: Test Your Setup</h3>
            <strong>Test Your Environment:</strong>
            <pre
              style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash"># Create a test project
make create-c64-project NAME=hello

# Build it
make build-prg PROJECT=hello

# Run in emulator
x64sc projects/commodore-64/hello/build/hello.prg</code></pre>
            <p class="help-text">
              If you see the VICE emulator open with your program, you're ready!
            </p>
          </div>
        </div>

        <div class="success-box">
          <p class="success-text">
            <strong>✅ That's it!</strong> You now have a complete C64 development environment.
            <a href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine" class="success-link">
              Start your first lesson →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Local Setup -->
    <div id="local" class="section-spacing">
      <SectionHeader
        title="💻 Local Installation"
        subtitle="Install tools directly on your system"
        variant="default"
      />

      <div class="setup-section setup-section-local">
        <Grid columns={3} gap="large" variant="cards">
          <!-- macOS -->
          <Card
            variant="feature"
            headerIcon="🍎"
            title="macOS Installation"
            description="Install development tools on macOS using Homebrew or manual downloads."
          >
            <div class="platform-content">
              <h4>Using Homebrew (Easiest):</h4>
              <pre
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash" style="color: #e2e8f0;">brew install acme
brew install vice</code></pre>

              <h4>Manual Installation:</h4>
              <ol class="instruction-list">
                <li>
                  Download ACME from <a href="https://github.com/meonwax/acme" target="_blank"
                    >GitHub</a
                  >
                </li>
                <li>
                  Download VICE from <a href="https://vice-emu.sourceforge.io/" target="_blank"
                    >SourceForge</a
                  >
                </li>
                <li>Add to PATH in ~/.zshrc or ~/.bash_profile</li>
              </ol>
            </div>
          </Card>

          <!-- Windows -->
          <Card
            variant="feature"
            headerIcon="🪟"
            title="Windows Installation"
            description="Download and install development tools directly on Windows."
          >
            <div class="platform-content">
              <ol class="instruction-list">
                <li>
                  Download ACME from <a
                    href="https://github.com/meonwax/acme/releases"
                    target="_blank">Releases</a
                  >
                </li>
                <li>
                  Download WinVICE from <a href="https://vice-emu.sourceforge.io/" target="_blank"
                    >SourceForge</a
                  >
                </li>
                <li>Extract both to C:\RetroTools\</li>
                <li>Add C:\RetroTools\acme and C:\RetroTools\WinVICE to System PATH</li>
                <li>Restart terminal/command prompt</li>
              </ol>

              <div class="tip-box">
                <p class="tip-text">
                  <strong>Tip:</strong> Consider using WSL2 for a Linux-like experience on Windows.
                </p>
              </div>
            </div>
          </Card>

          <!-- Linux -->
          <Card
            variant="feature"
            headerIcon="🐧"
            title="Linux Installation"
            description="Install via your distribution's package manager."
          >
            <div class="platform-content">
              <h4>Ubuntu/Debian:</h4>
              <strong>Install on Ubuntu/Debian:</strong>
              <pre
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash">sudo apt update
sudo apt install acme vice</code></pre>

              <h4>Fedora:</h4>
              <strong>Install on Fedora:</strong>
              <pre
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash">sudo dnf install acme vice</code></pre>

              <h4>Arch:</h4>
              <strong>Install on Arch Linux:</strong>
              <pre
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash">yay -S acme vice</code></pre>
            </div>
          </Card>
        </Grid>

        <!-- Verify Installation -->
        <div class="verify-section">
          <h3 class="verify-title">Verify Your Installation</h3>
          <strong>Verify Installation:</strong>
          <pre
            style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash"># Check ACME is installed
acme --version

# Check VICE is installed
x64sc --version</code></pre>

          <p class="help-text">
            Both commands should show version numbers. If not, check your PATH settings.
          </p>
        </div>

        <div class="success-box success-box-spaced">
          <p class="success-text">
            <strong>✅ Setup complete!</strong> You're ready to start coding.
            <a href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine" class="success-link">
              Begin your first lesson →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Test Program -->
    <div class="test-program-section">
      <SectionHeader
        title="Quick Test: Your First Program"
        subtitle="Verify your setup with a simple C64 program"
        variant="centered"
      />

      <p class="test-program-intro">
        Create a file called <code class="inline-code">test.asm</code>:
      </p>

      <strong>test.asm - Change border color:</strong>
      <pre
        style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-asm6502">* = $0801

; BASIC launcher
!byte $0c,$08,$0a,$00,$9e,$20
!byte $32,$30,$36,$31,$00,$00,$00

; Your code starts here
lda #$05    ; Green color
sta $d020   ; Border register
rts         ; Return</code></pre>

      <p class="test-program-intro">Assemble and run it:</p>

      <strong>Terminal Commands:</strong>
      <pre
        style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"><code class="language-bash"># Assemble to PRG file
acme -f cbm -o test.prg test.asm

# Run in VICE
x64sc test.prg</code></pre>

      <p class="test-program-result">
        You should see the C64 boot with a <strong>green border</strong>! 🎉
      </p>
    </div>
  </div>

  <!-- Next Steps -->
  <FullWidthSection
    variant="primary"
    title="Ready to Learn Assembly?"
    description="Your C64 development environment is ready. Start coding with step-by-step lessons that build real programs."
    actions={[
      {
        text: "📚 Start Lesson 1: Hello Machine",
        href: "/lessons/commodore-64/phase-1/tier-1/01-hello-machine",
        variant: "secondary",
        size: "large",
      },
      {
        text: "🎯 Browse All Lessons",
        href: "/lessons",
        variant: "secondary",
        size: "large",
      },
    ]}
    connectToFooter={true}
  />
</Layout>

<style>
  /* Platform card styling */
  .platform-content {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    height: 100%;
    color: #374151 !important;
  }

  .platform-content h4 {
    color: #3b82f6 !important;
    font-size: 1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem 0;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  .platform-content h4:first-child {
    margin-top: 0;
  }

  .instruction-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    counter-reset: step-counter;
  }

  .instruction-list li {
    counter-increment: step-counter;
    padding: 1rem 1rem 1rem 3rem;
    position: relative;
    margin-bottom: 0.75rem;
    background: var(--color-bg-secondary, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 0.5rem;
    line-height: 1.5;
    font-size: 0.9rem;
    color: #374151 !important;
  }

  .instruction-list li::before {
    content: counter(step-counter);
    position: absolute;
    left: 0.75rem;
    top: 1rem;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--color-primary, #3b82f6);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .instruction-list li a {
    color: var(--color-primary, #3b82f6);
    text-decoration: none;
    font-weight: 500;
  }

  .instruction-list li a:hover {
    text-decoration: underline;
  }

  .tip-box {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border: 1px solid #f59e0b;
    border-radius: 0.5rem;
    padding: 1rem;
    margin: 1.5rem 0;
    position: relative;
  }

  .tip-box::before {
    content: "💡";
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    background: #fbbf24;
    padding: 0.25rem 0.5rem;
    border-radius: 1rem;
    font-size: 0.875rem;
  }

  .tip-text {
    margin: 0;
    color: #92400e;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .verify-section {
    margin: 3rem 0 2rem 0;
    padding: 2rem;
    background: var(--color-bg-secondary, #f9fafb);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border, #e5e7eb);
  }

  .verify-title {
    color: var(--color-text, #1f2937);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .verify-title::before {
    content: "✓";
    background: var(--color-success, #10b981);
    color: white;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: bold;
  }

  .help-text {
    color: var(--color-text-light, #6b7280);
    font-size: 0.875rem;
    margin: 1rem 0;
    line-height: 1.5;
  }

  .success-box {
    background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
    border: 1px solid #10b981;
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 2rem 0;
    text-align: center;
  }

  .success-box-spaced {
    margin-top: 3rem;
  }

  .success-text {
    margin: 0;
    color: #065f46;
    font-size: 1rem;
    line-height: 1.6;
  }

  .success-text strong {
    color: #047857;
  }

  .success-link {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary, #3b82f6);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .success-link:hover {
    background: var(--color-primary-dark, #2563eb);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .test-program-section {
    margin: 4rem 0;
    padding: 2rem;
    background: var(--color-bg-secondary, #f9fafb);
    border-radius: 1rem;
    border: 1px solid var(--color-border, #e5e7eb);
  }

  .test-program-intro {
    color: var(--color-text-light, #6b7280);
    margin: 1rem 0;
    line-height: 1.6;
  }

  .test-program-result {
    margin: 1.5rem 0;
    padding: 1rem;
    background: linear-gradient(135deg, #ddd6fe 0%, #c4b5fd 100%);
    border: 1px solid #8b5cf6;
    border-radius: 0.5rem;
    color: #5b21b6;
    font-weight: 500;
    text-align: center;
  }

  .inline-code {
    background: var(--color-bg-secondary, #f3f4f6);
    color: var(--color-primary, #3b82f6);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-family: monospace;
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* Code block enhancements */
  pre {
    position: relative;
  }

  pre code {
    display: block;
    white-space: pre;
    word-wrap: normal;
    overflow-x: auto;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .platform-content {
      padding-top: 0.5rem;
    }

    .instruction-list li {
      padding: 0.75rem 0.75rem 0.75rem 2.5rem;
      font-size: 0.85rem;
    }

    .instruction-list li::before {
      left: 0.5rem;
      top: 0.75rem;
      width: 1.25rem;
      height: 1.25rem;
      font-size: 0.7rem;
    }

    .tip-box,
    .success-box,
    .verify-section,
    .test-program-section {
      padding: 1rem;
      margin: 1.5rem 0;
    }

    .verify-title {
      font-size: 1.125rem;
    }

    pre {
      font-size: 0.875rem;
      padding: 0.75rem;
    }
  }
</style>
