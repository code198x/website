---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CodeBlock from "../../components/CodeBlock.astro";
---

<Layout title="C64 Development Setup">
  <Breadcrumb
    segments={[
      { text: "Setup", href: "/setup" },
      { text: "Commodore 64", href: "/setup/c64" },
    ]}
  />

  <div class="container setup-container">
    <header class="text-center setup-header">
      <div class="hero-icon">💾</div>
      <h1 class="text-brand-green hero-title">
        Commodore 64 Development Setup
      </h1>
      <p class="hero-description">
        Get your C64 development environment running in 15 minutes. Choose Docker for simplicity or
        install tools directly.
      </p>
    </header>

    <!-- Quick Choice -->
    <div class="quick-choice-section">
      <h2 class="quick-choice-title">Choose Your Setup Method</h2>
      <div class="setup-method-buttons">
        <a href="#docker" class="btn btn--primary">
          🐳 Docker (Recommended)
          <div class="setup-method-subtitle">
            Everything pre-configured
          </div>
        </a>
        <a href="#local" class="btn btn--secondary">
          💻 Local Installation
          <div class="setup-method-subtitle setup-method-subtitle-light">
            Install tools directly
          </div>
        </a>
      </div>
    </div>

    <!-- What You'll Need -->
    <div class="info-section">
      <h2 class="info-section-title">
        What We're Installing
      </h2>

      <div class="tools-grid">
        <div class="tool-card">
          <div class="tool-icon">📝</div>
          <h3 class="tool-title">ACME Assembler</h3>
          <p class="tool-description">
            Converts your assembly code into machine code the C64 can run. Modern, fast, with great
            error messages.
          </p>
        </div>

        <div class="tool-card">
          <div class="tool-icon">🎮</div>
          <h3 class="tool-title">VICE Emulator</h3>
          <p class="tool-description">
            Runs your C64 programs on modern hardware. Cycle-accurate emulation with debugging
            tools.
          </p>
        </div>

        <div class="tool-card">
          <div class="tool-icon">✏️</div>
          <h3 class="tool-title">Text Editor</h3>
          <p class="tool-description">
            Any editor works! VS Code recommended for syntax highlighting and integrated build
            commands.
          </p>
        </div>
      </div>
    </div>

    <!-- Docker Setup -->
    <div id="docker" class="section-spacing">
      <h2 class="section-title section-title-icon">
        <span>🐳</span> Docker Setup (Recommended)
      </h2>

      <div class="setup-section setup-section-docker">
        <div class="setup-steps">
          <!-- Step 1 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">
              Step 1: Install Docker Desktop
            </h3>
            <div class="instruction-box">
              <p class="instruction-label"><strong>macOS/Windows:</strong></p>
              <a
                href="https://www.docker.com/products/docker-desktop"
                target="_blank"
                class="link-docker"
              >
                Download Docker Desktop →
              </a>
              <p class="instruction-label instruction-label-spaced"><strong>Linux:</strong></p>
              <code class="code-block-inline">
                sudo apt install docker.io docker-compose
              </code>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">
              Step 2: Get the Development Environment
            </h3>
            <div class="terminal-block">
              <div class="terminal-comment"># Clone the repository</div>
              <div>git clone https://github.com/code198x/development-environment.git</div>
              <div>cd development-environment</div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">
              Step 3: Start the Environment
            </h3>
            <div class="terminal-block terminal-block-spaced">
              <div class="terminal-comment"># Start Docker containers</div>
              <div>docker-compose up -d</div>
              <div class="terminal-comment terminal-comment-spaced"># Enter the workspace</div>
              <div>docker-compose exec workspace bash</div>
            </div>
            <p class="help-text">
              You're now in a Linux environment with all C64 tools installed!
            </p>
          </div>

          <!-- Step 4 -->
          <div class="setup-step">
            <h3 class="step-title step-title-docker">
              Step 4: Test Your Setup
            </h3>
            <div class="terminal-block terminal-block-spaced">
              <div class="terminal-comment"># Create a test project</div>
              <div>make create-c64-project NAME=hello</div>
              <div class="terminal-comment terminal-comment-spaced"># Build it</div>
              <div>make build-prg PROJECT=hello</div>
              <div class="terminal-comment terminal-comment-spaced"># Run in emulator</div>
              <div>x64sc projects/commodore-64/hello/build/hello.prg</div>
            </div>
            <p class="help-text">
              If you see the VICE emulator open with your program, you're ready!
            </p>
          </div>
        </div>

        <div class="success-box">
          <p class="success-text">
            <strong>✅ That's it!</strong> You now have a complete C64 development environment.
            <a
              href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine"
              class="success-link"
            >
              Start your first lesson →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Local Setup -->
    <div id="local" class="section-spacing">
      <h2 class="section-title section-title-icon">
        <span>💻</span> Local Installation
      </h2>

      <div class="setup-section setup-section-local">
        <div class="setup-steps">
          <!-- macOS -->
          <details class="platform-details">
            <summary class="platform-summary">
              🍎 macOS Installation
            </summary>
            <div class="platform-content">
              <h4>Using Homebrew (Easiest):</h4>
              <div class="terminal-block terminal-block-spaced">
                <div>brew install acme</div>
                <div>brew install vice</div>
              </div>

              <h4>Manual Installation:</h4>
              <ol class="instruction-list">
                <li>
                  Download ACME from <a href="https://github.com/meonwax/acme" target="_blank"
                    >GitHub</a
                  >
                </li>
                <li>
                  Download VICE from <a href="https://vice-emu.sourceforge.io/" target="_blank"
                    >SourceForge</a
                  >
                </li>
                <li>Add to PATH in ~/.zshrc or ~/.bash_profile</li>
              </ol>
            </div>
          </details>

          <!-- Windows -->
          <details class="platform-details">
            <summary class="platform-summary">
              🪟 Windows Installation
            </summary>
            <div class="platform-content">
              <ol class="instruction-list">
                <li>
                  Download ACME from <a
                    href="https://github.com/meonwax/acme/releases"
                    target="_blank">Releases</a
                  >
                </li>
                <li>
                  Download WinVICE from <a href="https://vice-emu.sourceforge.io/" target="_blank"
                    >SourceForge</a
                  >
                </li>
                <li>Extract both to C:\RetroTools\</li>
                <li>Add C:\RetroTools\acme and C:\RetroTools\WinVICE to System PATH</li>
                <li>Restart terminal/command prompt</li>
              </ol>

              <div class="tip-box">
                <p class="tip-text">
                  <strong>Tip:</strong> Consider using WSL2 for a Linux-like experience on Windows.
                </p>
              </div>
            </div>
          </details>

          <!-- Linux -->
          <details class="platform-details">
            <summary class="platform-summary">
              🐧 Linux Installation
            </summary>
            <div class="platform-content">
              <h4>Ubuntu/Debian:</h4>
              <div class="terminal-block terminal-block-spaced">
                <div>sudo apt update</div>
                <div>sudo apt install acme vice</div>
              </div>

              <h4>Fedora:</h4>
              <div class="terminal-block terminal-block-spaced">
                <div>sudo dnf install acme vice</div>
              </div>

              <h4>Arch:</h4>
              <div class="terminal-block terminal-block-spaced">
                <div>yay -S acme vice</div>
              </div>
            </div>
          </details>
        </div>

        <!-- Verify Installation -->
        <div class="verify-section">
          <h3 class="verify-title">Verify Your Installation</h3>
          <div class="terminal-block terminal-block-spaced">
            <div class="terminal-comment"># Check ACME is installed</div>
            <div>acme --version</div>
            <div class="terminal-comment terminal-comment-spaced"># Check VICE is installed</div>
            <div>x64sc --version</div>
          </div>

          <p class="help-text">
            Both commands should show version numbers. If not, check your PATH settings.
          </p>
        </div>

        <div class="success-box success-box-spaced">
          <p class="success-text">
            <strong>✅ Setup complete!</strong> You're ready to start coding.
            <a
              href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine"
              class="success-link"
            >
              Begin your first lesson →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Test Program -->
    <div class="test-program-section">
      <h2 class="test-program-title">Quick Test: Your First Program</h2>

      <p class="test-program-intro">
        Create a file called <code class="inline-code">test.asm</code>:
      </p>

      <CodeBlock title="test.asm - Change border color">
        <div>* = $0801</div>
        <div>&nbsp;</div>
        <div class="code-comment">; BASIC launcher</div>
        <div>!byte $0c,$08,$0a,$00,$9e,$20</div>
        <div>!byte $32,$30,$36,$31,$00,$00,$00</div>
        <div>&nbsp;</div>
        <div class="code-comment">; Your code starts here</div>
        <div>lda #$05 <span class="code-inline-comment">; Green color</span></div>
        <div>sta $d020 <span class="code-inline-comment">; Border register</span></div>
        <div>rts <span class="code-inline-comment">; Return</span></div>
      </CodeBlock>

      <p class="test-program-intro">Assemble and run it:</p>

      <div class="terminal-block">
        <div class="terminal-comment"># Assemble to PRG file</div>
        <div>acme -f cbm -o test.prg test.asm</div>
        <div class="terminal-comment terminal-comment-spaced"># Run in VICE</div>
        <div>x64sc test.prg</div>
      </div>

      <p class="test-program-result">
        You should see the C64 boot with a <strong>green border</strong>! 🎉
      </p>
    </div>

    <!-- Next Steps -->
    <div class="next-steps-section">
      <h2 class="next-steps-title">Ready to Learn Assembly?</h2>
      <div class="next-steps-buttons">
        <a
          href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine"
          class="btn btn--success btn--lg"
        >
          📚 Start Lesson 1: Hello Machine
        </a>
        <a href="/#c64-demo" class="btn btn--secondary btn--lg"> 🎮 Try Interactive Demo First </a>
      </div>
    </div>
  </div>
</Layout>