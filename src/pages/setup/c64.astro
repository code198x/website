---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CodeBlock from "../../components/CodeBlock.astro";
---

<Layout title="C64 Development Setup - Code Like It's 198x">
  <Breadcrumb
    segments={[
      { text: "Setup", href: "/setup" },
      { text: "Commodore 64", href: "/setup/c64" },
    ]}
  />

  <div class="container" style="padding-top: var(--space-2xl); max-width: 56rem; margin: 0 auto;">
    <header class="text-center" style="margin-bottom: var(--space-3xl);">
      <div style="font-size: 4rem; margin-bottom: var(--space-lg);">💾</div>
      <h1
        class="text-brand-green"
        style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);"
      >
        Commodore 64 Development Setup
      </h1>
      <p
        style="font-size: 1.25rem; color: var(--text-secondary); max-width: 42rem; margin: 0 auto;"
      >
        Get your C64 development environment running in 15 minutes. Choose Docker for simplicity or
        install tools directly.
      </p>
    </header>

    <!-- Quick Choice -->
    <div
      style="background: var(--brand-blue); color: white; border-radius: 12px; padding: 2rem; margin-bottom: var(--space-3xl); text-align: center;"
    >
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Choose Your Setup Method</h2>
      <div style="display: flex; gap: 2rem; justify-content: center; flex-wrap: wrap;">
        <a
          href="#docker"
          class="btn"
          style="background: white; color: #764ba2; padding: 1rem 2rem; border-radius: 6px; text-decoration: none; font-weight: 600; min-width: 200px;"
        >
          🐳 Docker (Recommended)
          <div style="font-size: 0.875rem; opacity: 0.8; margin-top: 0.25rem;">
            Everything pre-configured
          </div>
        </a>
        <a
          href="#local"
          class="btn"
          style="background: transparent; color: white; border: 2px solid white; padding: 1rem 2rem; border-radius: 6px; text-decoration: none; font-weight: 600; min-width: 200px;"
        >
          💻 Local Installation
          <div style="font-size: 0.875rem; opacity: 0.9; margin-top: 0.25rem;">
            Install tools directly
          </div>
        </a>
      </div>
    </div>

    <!-- What You'll Need -->
    <div
      style="background: #f7f9fc; border-radius: 12px; padding: 2rem; margin-bottom: var(--space-3xl);"
    >
      <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem; text-align: center;">
        What We're Installing
      </h2>

      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;"
      >
        <div
          style="background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid #e2e8f0;"
        >
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📝</div>
          <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">ACME Assembler</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary);">
            Converts your assembly code into machine code the C64 can run. Modern, fast, with great
            error messages.
          </p>
        </div>

        <div
          style="background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid #e2e8f0;"
        >
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎮</div>
          <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">VICE Emulator</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary);">
            Runs your C64 programs on modern hardware. Cycle-accurate emulation with debugging
            tools.
          </p>
        </div>

        <div
          style="background: white; padding: 1.5rem; border-radius: 8px; border: 1px solid #e2e8f0;"
        >
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">✏️</div>
          <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;">Text Editor</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary);">
            Any editor works! VS Code recommended for syntax highlighting and integrated build
            commands.
          </p>
        </div>
      </div>
    </div>

    <!-- Docker Setup -->
    <div id="docker" style="margin-bottom: var(--space-4xl);">
      <h2
        style="font-size: 2rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;"
      >
        <span>🐳</span> Docker Setup (Recommended)
      </h2>

      <div
        style="background: white; border: 2px solid #667eea; border-radius: 12px; padding: 2rem;"
      >
        <div class="setup-steps">
          <!-- Step 1 -->
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: #667eea;">
              Step 1: Install Docker Desktop
            </h3>
            <div
              style="background: #f7f9fc; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"
            >
              <p style="margin-bottom: 0.5rem;"><strong>macOS/Windows:</strong></p>
              <a
                href="https://www.docker.com/products/docker-desktop"
                target="_blank"
                style="color: #667eea;"
              >
                Download Docker Desktop →
              </a>
              <p style="margin-top: 1rem; margin-bottom: 0.5rem;"><strong>Linux:</strong></p>
              <code
                style="background: #1a202c; color: #68d391; padding: 0.5rem; border-radius: 4px; display: block;"
              >
                sudo apt install docker.io docker-compose
              </code>
            </div>
          </div>

          <!-- Step 2 -->
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: #667eea;">
              Step 2: Get the Development Environment
            </h3>
            <div
              style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace;"
            >
              <div style="color: #68d391; margin-bottom: 0.5rem;"># Clone the repository</div>
              <div>git clone https://github.com/code198x/development-environment.git</div>
              <div>cd development-environment</div>
            </div>
          </div>

          <!-- Step 3 -->
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: #667eea;">
              Step 3: Start the Environment
            </h3>
            <div
              style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin-bottom: 1rem;"
            >
              <div style="color: #68d391; margin-bottom: 0.5rem;"># Start Docker containers</div>
              <div>docker-compose up -d</div>
              <div style="margin-top: 0.5rem; color: #68d391;"># Enter the workspace</div>
              <div>docker-compose exec workspace bash</div>
            </div>
            <p style="font-size: 0.875rem; color: var(--text-secondary);">
              You're now in a Linux environment with all C64 tools installed!
            </p>
          </div>

          <!-- Step 4 -->
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: #667eea;">
              Step 4: Test Your Setup
            </h3>
            <div
              style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin-bottom: 1rem;"
            >
              <div style="color: #68d391; margin-bottom: 0.5rem;"># Create a test project</div>
              <div>make create-c64-project NAME=hello</div>
              <div style="margin-top: 0.5rem; color: #68d391;"># Build it</div>
              <div>make build-prg PROJECT=hello</div>
              <div style="margin-top: 0.5rem; color: #68d391;"># Run in emulator</div>
              <div>x64sc projects/commodore-64/hello/build/hello.prg</div>
            </div>
            <p style="font-size: 0.875rem; color: var(--text-secondary);">
              If you see the VICE emulator open with your program, you're ready!
            </p>
          </div>
        </div>

        <div
          style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 1rem;"
        >
          <p style="margin: 0;">
            <strong>✅ That's it!</strong> You now have a complete C64 development environment.
            <a
              href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine"
              style="color: #667eea; font-weight: 600;"
            >
              Start your first lesson →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Local Setup -->
    <div id="local" style="margin-bottom: var(--space-4xl);">
      <h2
        style="font-size: 2rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;"
      >
        <span>💻</span> Local Installation
      </h2>

      <div
        style="background: white; border: 2px solid #f5576c; border-radius: 12px; padding: 2rem;"
      >
        <div class="setup-steps">
          <!-- macOS -->
          <details style="margin-bottom: 1.5rem;">
            <summary
              style="font-size: 1.25rem; font-weight: 600; cursor: pointer; padding: 0.5rem; background: #fef2f2; border-radius: 6px;"
            >
              🍎 macOS Installation
            </summary>
            <div style="padding: 1rem; margin-top: 1rem;">
              <h4>Using Homebrew (Easiest):</h4>
              <div
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0;"
              >
                <div>brew install acme</div>
                <div>brew install vice</div>
              </div>

              <h4>Manual Installation:</h4>
              <ol style="padding-left: 1.5rem;">
                <li>
                  Download ACME from <a href="https://github.com/meonwax/acme" target="_blank"
                    >GitHub</a
                  >
                </li>
                <li>
                  Download VICE from <a href="https://vice-emu.sourceforge.io/" target="_blank"
                    >SourceForge</a
                  >
                </li>
                <li>Add to PATH in ~/.zshrc or ~/.bash_profile</li>
              </ol>
            </div>
          </details>

          <!-- Windows -->
          <details style="margin-bottom: 1.5rem;">
            <summary
              style="font-size: 1.25rem; font-weight: 600; cursor: pointer; padding: 0.5rem; background: #fef2f2; border-radius: 6px;"
            >
              🪟 Windows Installation
            </summary>
            <div style="padding: 1rem; margin-top: 1rem;">
              <ol style="padding-left: 1.5rem;">
                <li>
                  Download ACME from <a
                    href="https://github.com/meonwax/acme/releases"
                    target="_blank">Releases</a
                  >
                </li>
                <li>
                  Download WinVICE from <a href="https://vice-emu.sourceforge.io/" target="_blank"
                    >SourceForge</a
                  >
                </li>
                <li>Extract both to C:\RetroTools\</li>
                <li>Add C:\RetroTools\acme and C:\RetroTools\WinVICE to System PATH</li>
                <li>Restart terminal/command prompt</li>
              </ol>

              <div
                style="background: #fef3c7; border: 1px solid #fde68a; border-radius: 6px; padding: 1rem; margin-top: 1rem;"
              >
                <p style="margin: 0;">
                  <strong>Tip:</strong> Consider using WSL2 for a Linux-like experience on Windows.
                </p>
              </div>
            </div>
          </details>

          <!-- Linux -->
          <details style="margin-bottom: 1.5rem;">
            <summary
              style="font-size: 1.25rem; font-weight: 600; cursor: pointer; padding: 0.5rem; background: #fef2f2; border-radius: 6px;"
            >
              🐧 Linux Installation
            </summary>
            <div style="padding: 1rem; margin-top: 1rem;">
              <h4>Ubuntu/Debian:</h4>
              <div
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0;"
              >
                <div>sudo apt update</div>
                <div>sudo apt install acme vice</div>
              </div>

              <h4>Fedora:</h4>
              <div
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0;"
              >
                <div>sudo dnf install acme vice</div>
              </div>

              <h4>Arch:</h4>
              <div
                style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0;"
              >
                <div>yay -S acme vice</div>
              </div>
            </div>
          </details>
        </div>

        <!-- Verify Installation -->
        <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #e2e8f0;">
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Verify Your Installation</h3>
          <div
            style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin-bottom: 1rem;"
          >
            <div style="color: #68d391; margin-bottom: 0.5rem;"># Check ACME is installed</div>
            <div>acme --version</div>
            <div style="margin-top: 0.5rem; color: #68d391;"># Check VICE is installed</div>
            <div>x64sc --version</div>
          </div>

          <p style="font-size: 0.875rem; color: var(--text-secondary);">
            Both commands should show version numbers. If not, check your PATH settings.
          </p>
        </div>

        <div
          style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 1rem; margin-top: 1.5rem;"
        >
          <p style="margin: 0;">
            <strong>✅ Setup complete!</strong> You're ready to start coding.
            <a
              href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine"
              style="color: #667eea; font-weight: 600;"
            >
              Begin your first lesson →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Test Program -->
    <div
      style="background: var(--brand-green); color: white; border-radius: 12px; padding: 2rem; margin-bottom: var(--space-3xl);"
    >
      <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem;">Quick Test: Your First Program</h2>

      <p style="margin-bottom: 1rem;">
        Create a file called <code
          style="background: rgba(255,255,255,0.2); padding: 0.25rem 0.5rem; border-radius: 4px;"
          >test.asm</code
        >:
      </p>

      <CodeBlock title="test.asm - Change border color">
        <div>* = $0801</div>
        <div>&nbsp;</div>
        <div style="color: #fbbf24;">; BASIC launcher</div>
        <div>!byte $0c,$08,$0a,$00,$9e,$20</div>
        <div>!byte $32,$30,$36,$31,$00,$00,$00</div>
        <div>&nbsp;</div>
        <div style="color: #fbbf24;">; Your code starts here</div>
        <div>lda #$05 <span style="color: #9ca3af;">; Green color</span></div>
        <div>sta $d020 <span style="color: #9ca3af;">; Border register</span></div>
        <div>rts <span style="color: #9ca3af;">; Return</span></div>
      </CodeBlock>

      <p style="margin-bottom: 1rem;">Assemble and run it:</p>

      <div
        style="background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace;"
      >
        <div style="color: #68d391;"># Assemble to PRG file</div>
        <div>acme -f cbm -o test.prg test.asm</div>
        <div style="margin-top: 0.5rem; color: #68d391;"># Run in VICE</div>
        <div>x64sc test.prg</div>
      </div>

      <p style="margin-top: 1rem;">
        You should see the C64 boot with a <strong>green border</strong>! 🎉
      </p>
    </div>

    <!-- Next Steps -->
    <div style="text-align: center;">
      <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem;">Ready to Learn Assembly?</h2>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a
          href="/lessons/commodore-64/phase-1/tier-1/01-hello-machine"
          class="btn btn-success btn-large"
        >
          📚 Start Lesson 1: Hello Machine
        </a>
        <a href="/#c64-demo" class="btn btn-secondary btn-large"> 🎮 Try Interactive Demo First </a>
      </div>
    </div>
  </div>
</Layout>
