---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
---

<Layout title="Development Setup">
  <Breadcrumb segments={[{ text: "Setup", href: "/setup" }]} />

  <div class="container setup-container">
    <header class="text-center setup-header">
      <h1 class="text-brand-green hero-title">Choose Your System</h1>
      <p class="hero-description">
        Get your development environment ready for authentic retro assembly programming. Each system
        has its own focused setup guide with everything you need.
      </p>
    </header>

    <!-- System Selection -->
    <div class="grid-responsive system-selection">
      <!-- Commodore 64 - Primary Focus -->
      <div class="card card-ready">
        <div class="card-header system-c64">
          <span class="system-icon">💾</span>
          <div class="status-badge">READY</div>
        </div>
        <div class="card-body card-body-flex">
          <h3 class="card-title">Commodore 64</h3>
          <p class="card-description card-description-flex">
            Complete development environment with ACME assembler and VICE emulator. 14 lessons
            available with full C64 curriculum ready to go.
          </p>
          <div class="card-meta card-meta-spaced">
            <div><strong>Assembly:</strong> 6502</div>
            <div><strong>Assembler:</strong> ACME</div>
            <div><strong>Emulator:</strong> VICE</div>
          </div>
          <a href="/setup/c64" class="btn btn--c64"> 🚀 Setup C64 Development → </a>
        </div>
      </div>

      <!-- ZX Spectrum -->
      <div class="card">
        <div class="card-header system-spectrum">
          <span class="system-icon">🖥️</span>
        </div>
        <div class="card-body card-body-flex">
          <h3 class="card-title">ZX Spectrum</h3>
          <p class="card-description card-description-flex">
            Z80 assembly development with sjasmplus assembler and Fuse emulator. Setup guide ready,
            lessons in development.
          </p>
          <div class="card-meta card-meta-spaced">
            <div><strong>Assembly:</strong> Z80</div>
            <div><strong>Assembler:</strong> sjasmplus</div>
            <div><strong>Emulator:</strong> Fuse</div>
          </div>
          <a href="/setup/zx-spectrum" class="btn btn--spectrum btn--disabled"> Coming Soon </a>
        </div>
      </div>

      <!-- NES -->
      <div class="card">
        <div class="card-header system-nes">
          <span class="system-icon">🎮</span>
        </div>
        <div class="card-body card-body-flex">
          <h3 class="card-title">Nintendo Entertainment System</h3>
          <p class="card-description card-description-flex">
            6502 assembly for NES development with ca65 assembler and FCEUX emulator. Advanced
            curriculum planned.
          </p>
          <div class="card-meta card-meta-spaced">
            <div><strong>Assembly:</strong> 6502</div>
            <div><strong>Assembler:</strong> ca65</div>
            <div><strong>Emulator:</strong> FCEUX</div>
          </div>
          <a href="/setup/nes" class="btn btn--nes btn--disabled"> Coming Soon </a>
        </div>
      </div>

      <!-- Amiga -->
      <div class="card">
        <div class="card-header system-amiga">
          <span class="system-icon">🎨</span>
        </div>
        <div class="card-body card-body-flex">
          <h3 class="card-title">Commodore Amiga</h3>
          <p class="card-description card-description-flex">
            68000 assembly development with vasm assembler and FS-UAE emulator. Advanced graphics
            and sound programming planned.
          </p>
          <div class="card-meta card-meta-spaced">
            <div><strong>Assembly:</strong> 68000</div>
            <div><strong>Assembler:</strong> vasm</div>
            <div><strong>Emulator:</strong> FS-UAE</div>
          </div>
          <a href="/setup/amiga" class="btn btn--amiga btn--disabled"> Coming Soon </a>
        </div>
      </div>
    </div>

    <!-- What You'll Get -->
    <div class="feature-section">
      <div class="text-center feature-section-header">
        <h2 class="feature-section-title">Complete Development Environment</h2>
        <p class="feature-section-description">
          Each setup guide provides everything you need for authentic retro development
        </p>
      </div>

      <div class="grid-4 features-grid">
        <div class="feature-item">
          <div class="feature-icon">🐳</div>
          <div class="feature-title">Docker Setup</div>
          <div class="feature-description">One command install</div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">⚙️</div>
          <div class="feature-title">Assemblers</div>
          <div class="feature-description">Authentic tools</div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🎮</div>
          <div class="feature-title">Emulators</div>
          <div class="feature-description">Test your programs</div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">📚</div>
          <div class="feature-title">Examples</div>
          <div class="feature-description">Working programs</div>
        </div>
      </div>
    </div>

    <!-- Getting Started -->
    <div class="getting-started-section">
      <h2 class="getting-started-title">New to Assembly Programming?</h2>
      <p class="getting-started-description">
        Start with the Commodore 64 - it's beginner-friendly with complete lessons ready to follow.
      </p>
      <a href="/getting-started" class="btn getting-started-button">
        📖 Read Getting Started Guide
      </a>
    </div>
  </div>
</Layout>
