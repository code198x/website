---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Layout title="Development Setup - Code Like It's 198x">
  <Breadcrumb segments={[{ text: 'Setup', href: '/setup' }]} />
  
  <div class="container" style="padding-top: var(--space-2xl);">
    <header class="text-center" style="margin-bottom: var(--space-4xl);">
      <h1 class="text-brand-green" style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);">
        Choose Your System
      </h1>
      <p style="font-size: 1.25rem; color: var(--text-secondary); max-width: 50rem; margin: 0 auto;">
        Get your development environment ready for authentic retro assembly programming. 
        Each system has its own focused setup guide with everything you need.
      </p>
    </header>

    <!-- System Selection -->
    <div class="grid-responsive" style="max-width: 56rem; margin: 0 auto; gap: var(--space-xl);">
      
      <!-- Commodore 64 - Primary Focus -->
      <div class="card" style="position: relative;">
        <div class="card-header system-c64" style="position: relative;">
          <span style="font-size: 3rem;">💾</span>
          <div style="position: absolute; top: 1rem; right: 1rem; background: #22c55e; color: white; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600;">
            READY
          </div>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column;">
          <h3 class="card-title">Commodore 64</h3>
          <p class="card-description" style="flex-grow: 1;">
            Complete development environment with ACME assembler and VICE emulator. 
            14 lessons available with full C64 curriculum ready to go.
          </p>
          <div class="card-meta" style="margin-bottom: var(--space-lg);">
            <div><strong>Assembly:</strong> 6502</div>
            <div><strong>Assembler:</strong> ACME</div>
            <div><strong>Emulator:</strong> VICE</div>
          </div>
          <a 
            href="/setup/c64"
            class="btn"
            style="background-color: var(--c64-dark-brown); color: var(--text-inverse); width: 100%;"
          >
            🚀 Setup C64 Development →
          </a>
        </div>
      </div>

      <!-- ZX Spectrum -->
      <div class="card">
        <div class="card-header system-spectrum">
          <span style="font-size: 3rem;">🖥️</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column;">
          <h3 class="card-title">ZX Spectrum</h3>
          <p class="card-description" style="flex-grow: 1;">
            Z80 assembly development with sjasmplus assembler and Fuse emulator.
            Setup guide ready, lessons in development.
          </p>
          <div class="card-meta" style="margin-bottom: var(--space-lg);">
            <div><strong>Assembly:</strong> Z80</div>
            <div><strong>Assembler:</strong> sjasmplus</div>
            <div><strong>Emulator:</strong> Fuse</div>
          </div>
          <a 
            href="/setup/zx-spectrum"
            class="btn"
            style="background-color: var(--spectrum-blue); color: var(--text-inverse); width: 100%; opacity: 0.7;"
          >
            Coming Soon
          </a>
        </div>
      </div>

      <!-- NES -->
      <div class="card">
        <div class="card-header system-nes">
          <span style="font-size: 3rem;">🎮</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column;">
          <h3 class="card-title">Nintendo Entertainment System</h3>
          <p class="card-description" style="flex-grow: 1;">
            6502 assembly for NES development with ca65 assembler and FCEUX emulator.
            Advanced curriculum planned.
          </p>
          <div class="card-meta" style="margin-bottom: var(--space-lg);">
            <div><strong>Assembly:</strong> 6502</div>
            <div><strong>Assembler:</strong> ca65</div>
            <div><strong>Emulator:</strong> FCEUX</div>
          </div>
          <a 
            href="/setup/nes"
            class="btn"
            style="background-color: var(--nes-gray); color: var(--text-inverse); width: 100%; opacity: 0.7;"
          >
            Coming Soon
          </a>
        </div>
      </div>

      <!-- Amiga -->
      <div class="card">
        <div class="card-header system-amiga">
          <span style="font-size: 3rem;">🎨</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column;">
          <h3 class="card-title">Commodore Amiga</h3>
          <p class="card-description" style="flex-grow: 1;">
            68000 assembly development with vasm assembler and FS-UAE emulator.
            Advanced graphics and sound programming planned.
          </p>
          <div class="card-meta" style="margin-bottom: var(--space-lg);">
            <div><strong>Assembly:</strong> 68000</div>
            <div><strong>Assembler:</strong> vasm</div>
            <div><strong>Emulator:</strong> FS-UAE</div>
          </div>
          <a 
            href="/setup/amiga"
            class="btn"
            style="background-color: var(--amiga-orange); color: var(--text-inverse); width: 100%; opacity: 0.7;"
          >
            Coming Soon
          </a>
        </div>
      </div>
    </div>

    <!-- What You'll Get -->
    <div class="feature-section" style="margin-top: var(--space-4xl); background: #f7f9fc; border-radius: 12px; padding: 2rem;">
      <div class="text-center" style="margin-bottom: var(--space-2xl);">
        <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">Complete Development Environment</h2>
        <p style="color: var(--text-secondary);">
          Each setup guide provides everything you need for authentic retro development
        </p>
      </div>
      
      <div class="grid-4" style="max-width: 48rem; margin: 0 auto;">
        <div style="text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">🐳</div>
          <div style="font-weight: 600;">Docker Setup</div>
          <div style="font-size: 0.875rem; color: var(--text-secondary);">One command install</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">⚙️</div>
          <div style="font-weight: 600;">Assemblers</div>
          <div style="font-size: 0.875rem; color: var(--text-secondary);">Authentic tools</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎮</div>
          <div style="font-weight: 600;">Emulators</div>
          <div style="font-size: 0.875rem; color: var(--text-secondary);">Test your programs</div>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📚</div>
          <div style="font-weight: 600;">Examples</div>
          <div style="font-size: 0.875rem; color: var(--text-secondary);">Working programs</div>
        </div>
      </div>
    </div>

    <!-- Getting Started -->
    <div style="text-align: center; margin-top: var(--space-4xl); padding: 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; color: white;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">New to Assembly Programming?</h2>
      <p style="margin-bottom: 1.5rem; opacity: 0.95;">
        Start with the Commodore 64 - it's beginner-friendly with complete lessons ready to follow.
      </p>
      <a href="/getting-started" class="btn" style="background: white; color: #764ba2; padding: 1rem 2rem; border-radius: 6px; text-decoration: none; font-weight: 600;">
        📖 Read Getting Started Guide
      </a>
    </div>
  </div>
</Layout>