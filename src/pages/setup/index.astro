---
import Layout from '../../layouts/Layout.astro';
import { Monitor, CheckCircle, Cpu, Package, Camera, Code } from '@lucide/astro';
import { getActivePlatforms } from '../../lib/platforms';
import { inkStyle } from '../../lib/contrast';
import Emu198xCallout from '../../components/Emu198xCallout.astro';

// Only live platforms have setup, getting-started and native-setup pages. Next-tier
// systems are catalogued but not yet buildable, so they don't belong in the setup
// index — listing them would link to pages that don't exist yet.
const platformsData = (await getActivePlatforms()).filter(p => p.data.tier === 'live');

// Transform to the shape needed by this page
const platforms = platformsData.map(p => ({
  name: p.data.shortName,
  fullName: p.data.name,
  slug: p.id,
  image: p.data.dockerImage,
  color: p.data.color,
  assembler: p.data.assembler,
  emulator: p.data.emulator,
  buildOutput: p.data.buildOutput,
  extras: p.data.toolchainExtras,
}));
---

<Layout
  title="Setup"
  description="Get started with retro game development in 60 seconds. Our Docker toolchains include everything you need — no installation hassle."
>
  <div class="setup-page">
    <!-- Hero -->
    <section class="hero">
      <div class="container hero-inner">
        <p class="kicker">Setup · Docker toolchains</p>
        <h1 class="hero-title">Start coding<br />in 60 seconds.</h1>
        <div class="house-rule"></div>
        <p class="hero-lede">One command takes you from a fresh laptop to a working toolchain —
          cross-assemblers and build tools for every system, in a container. No dependency
          management, no version conflicts. <span class="mk">Just code.</span></p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#quick-start">Quick start →</a>
          <a class="btn btn-secondary" href="#emu198x">Meet Emu198x</a>
        </div>
      </div>
    </section>

    <!-- Quick Start -->
    <section class="quick-start" id="quick-start">
      <div class="container">
        <div class="sec-head"><p class="kicker">Three commands</p><h2>Quick start</h2></div>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Install Docker Desktop</h3>
              <p>Free from <a href="https://www.docker.com/products/docker-desktop/" target="_blank" rel="noopener">docker.com</a> for Mac, Windows, and Linux</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Download the toolchain</h3>
              <div class="code-block" tabindex="0">
                <code>docker pull ghcr.io/code198x/commodore-64</code>
              </div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Build your code</h3>
              <div class="code-block" tabindex="0">
                <code>docker run -v ./code:/code ghcr.io/code198x/commodore-64 acme game.asm -o game.prg</code>
              </div>
            </div>
          </div>
        </div>
        <p class="steps-note">Done — your compiled program is ready. Run it in a native emulator (Fuse for Spectrum, VICE for C64), or in <a href="#emu198x">Emu198x</a>, our own.</p>
      </div>
    </section>

    <!-- Platform Cards -->
    <section class="platforms-section">
      <div class="container">
        <div class="sec-head"><p class="kicker">One per machine</p><h2>Available toolchains</h2></div>
        <p class="section-description">Each toolchain is tailored to its system, with the right assembler, emulator, and development tools.</p>

        <div class="platforms-grid">
          {platforms.map(platform => (
            <div class="platform-card" style={`--platform-color: ${platform.color}; ${inkStyle(platform.color)}`}>
              <div class="platform-header">
                <h3>{platform.fullName}</h3>
                <div class="platform-image">
                  <code>{platform.image}</code>
                </div>
              </div>
              <div class="platform-tools">
                <div class="tool-row">
                  <Code size={16} />
                  <span><strong>Assembler:</strong> {platform.assembler}</span>
                </div>
                <div class="tool-row">
                  <Monitor size={16} />
                  <span><strong>Recommended emulator:</strong> {platform.emulator}</span>
                </div>
                <div class="tool-row">
                  <Package size={16} />
                  <span><strong>Output:</strong> {platform.buildOutput}</span>
                </div>
              </div>
              <div class="platform-extras">
                <strong>Also includes:</strong>
                <ul>
                  {platform.extras.map(extra => (
                    <li><CheckCircle size={14} /> {extra}</li>
                  ))}
                </ul>
              </div>
              <a href={`/${platform.slug}/getting-started`} class="platform-link">
                View full setup guide
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What's Included -->
    <section class="included-section">
      <div class="container">
        <div class="sec-head"><p class="kicker">Build · test · ship</p><h2>The workflow</h2></div>
        <div class="features-grid">
          <div class="feature">
            <Code size={32} class="feature-icon" />
            <h3>Build in Docker</h3>
            <p>Cross-assemblers run in containers — consistent builds across macOS, Windows, and Linux with zero setup.</p>
          </div>
          <div class="feature">
            <Monitor size={32} class="feature-icon" />
            <h3>Test in an emulator</h3>
            <p>Run your compiled program in Fuse, VICE, FS-UAE or FCEUX — or in Emu198x, our own. Native emulators give the smoothest experience today.</p>
          </div>
          <div class="feature">
            <Camera size={32} class="feature-icon" />
            <h3>Automated screenshots</h3>
            <p>The toolchains capture screenshots headlessly — the same images you see in the lessons, regenerated on every build.</p>
          </div>
          <div class="feature">
            <Cpu size={32} class="feature-icon" />
            <h3>VS Code integration</h3>
            <p>Dev Container support drops you into a ready IDE, syntax highlighting and all.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Emu198x -->
    <section class="emu-section">
      <div class="container">
        <Emu198xCallout />
      </div>
    </section>

    <!-- Alternative -->
    <section class="native-section">
      <div class="container">
        <p class="native-note">
          <strong>Prefer native tools?</strong> You can install assemblers directly instead of using Docker.
          You'll manage dependencies yourself, but it's fully documented.
        </p>
        <div class="native-links">
          {platforms.map(platform => (
            <a href={`/setup/${platform.slug}/native`}>{platform.name} Native Setup</a>
          ))}
        </div>
      </div>
    </section>

    <!-- ROMs -->
    <section class="native-section">
      <div class="container">
        <p class="native-note">
          <strong>One more thing — ROMs.</strong> The C64 and Amiga need their original system ROMs
          to run. They're not ours to give away, so you bring your own — free where you can, or a few
          pounds via Forever.
        </p>
        <div class="native-links">
          <a href="/setup/roms">How to get your ROMs &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-effects">
        <div class="cta-grid"></div>
        <div class="cta-glow glow-1"></div>
        <div class="cta-glow glow-2"></div>
      </div>
      <div class="container">
        <h2>Ready to build something?</h2>
        <p class="cta-subtitle">Pick a system and start building.</p>

        <div class="platform-ctas">
          {platforms.map(platform => (
            <a href={`/${platform.slug}`} class="platform-cta" style={`--platform-color: ${platform.color}; ${inkStyle(platform.color)}`}>
              <span class="platform-cta-name">{platform.name}</span>
              <span class="platform-cta-arrow">&rarr;</span>
            </a>
          ))}
        </div>

        <div class="cta-secondary">
          <a href="https://github.com/code198x" class="github-link" target="_blank" rel="noopener">
            <span>View toolchains on GitHub</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .setup-page {
    --accent-gradient: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    --terminal-green: var(--color-success, #22c55e);
  }

  /* Hero — house pattern: left-aligned eyebrow + script headline + rule + lede */
  .hero { padding: var(--space-12) var(--space-4) var(--space-8); }

  .setup-page .kicker { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .setup-page .hero-title { font-family: var(--font-family-read); font-weight: 700;
    font-size: clamp(3rem, 7vw, 5rem); line-height: 0.85;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-2) 0 0; color: var(--color-text); }
  .setup-page .house-rule { height: 9px; width: 220px; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .setup-page .house-rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .hero-lede { font-size: 1.05rem; max-width: 60ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .hero-lede .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }
  .hero-cta { display: flex; gap: var(--space-3); margin-top: var(--space-5); flex-wrap: wrap; }

  /* Section heads — eyebrow + left-aligned script heading, matching the house rhythm */
  .sec-head { margin: 0 0 var(--space-6); }
  .setup-page .sec-head h2 { text-align: left; font-family: var(--font-family-read); font-weight: 700;
    font-size: clamp(1.9rem, 3.6vw, 2.6rem); line-height: 0.9;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }

  /* legacy hero effect layers (floating blobs, scanlines, beam) + centred hero-content
     styles removed — the hero now uses the site's left-aligned house pattern above */

  /* Quick Start */
  .quick-start {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .quick-start h2 {
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .steps {
    max-width: 760px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .step-number {
    width: 40px;
    height: 40px;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .step-content p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .step-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .step-content a:hover {
    color: var(--color-accent);
  }

  .code-block {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
  }

  .code-block code {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    background: none;
    padding: 0;
    color: var(--color-success);
  }

  .steps-note {
    text-align: left;
    color: var(--color-text-secondary);
    margin-top: var(--space-6);
    font-style: italic;
  }

  /* Inline prose link — was falling back to the UA default blue (fails on the
     dark surface). Accessible ink + underline so it's distinguishable. */
  .steps-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* Platforms Section */
  .platforms-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg-secondary);
  }

  .platforms-section h2 {
    text-align: center;
    margin: 0 0 var(--space-2) 0;
  }

  .section-description {
    text-align: left;
    color: var(--color-text-secondary);
    max-width: 70ch;
    margin: 0 0 var(--space-8) 0;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    max-width: 1200px;
    margin: 0 auto;
  }

  .platform-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: var(--space-6);
    border-top: 4px solid var(--platform-color);
    transition: transform 0.2s ease, box-shadow 0.3s ease;
  }

  .platform-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 20px color-mix(in srgb, var(--platform-color) 25%, transparent),
      0 0 40px color-mix(in srgb, var(--platform-color) 15%, transparent),
      0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .platform-header {
    margin-bottom: var(--space-4);
  }

  .platform-header h3 {
    margin: 0 0 var(--space-2) 0;
    color: var(--ink);
  }

  .platform-image code {
    font-size: 0.8rem;
    background: var(--color-code-bg);
    color: var(--color-success);
    padding: var(--space-1) var(--space-2);
    border-radius: 0;
  }

  .platform-tools {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .tool-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .tool-row strong {
    color: var(--color-text);
  }

  .platform-extras {
    font-size: 0.875rem;
    margin-bottom: var(--space-4);
  }

  .platform-extras strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }

  .platform-extras ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .platform-extras li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
  }

  .platform-extras li :global(svg) {
    color: var(--color-success);
  }

  .platform-link {
    display: block;
    text-align: center;
    color: var(--ink);
    font-weight: 500;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-light);
  }

  .platform-link:hover {
    text-decoration: underline;
  }

  /* Included Section */
  .included-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .included-section h2 {
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin: 0 auto;
  }

  .feature {
    text-align: center;
    padding: var(--space-4);
  }

  .feature-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .feature h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .feature p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Native Section */
  .native-section {
    padding: var(--space-6) var(--space-4);
    background: var(--color-bg);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .native-note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .native-note strong {
    color: var(--color-text);
  }

  .native-note a {
    color: var(--color-primary);
  }

  .native-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-4);
  }

  .native-links a {
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .native-links a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-16) var(--space-4);
    background: #3a2c1f;
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
  }

  .cta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.15;
  }

  .glow-1 {
    width: 300px;
    height: 300px;
    background: var(--terminal-green);
    top: -100px;
    left: 10%;
  }

  .glow-2 {
    width: 250px;
    height: 250px;
    background: var(--color-primary);
    bottom: -80px;
    right: 15%;
  }

  .cta-section .container {
    position: relative;
    z-index: 1;
  }

  .cta-section h2 {
    margin: 0 0 var(--space-3) 0;
    color: white;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .cta-subtitle {
    margin: 0 0 var(--space-8) 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.125rem;
  }

  .platform-ctas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto var(--space-8) auto;
  }

  .platform-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 4px solid var(--platform-color);
    border-radius: 0;
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .platform-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--platform-color);
    transform: translateX(4px);
    box-shadow: 0 0 20px color-mix(in srgb, var(--platform-color) 30%, transparent);
  }

  .platform-cta-name {
    color: white;
  }

  .platform-cta-arrow {
    color: var(--ink);
    font-size: 1.25rem;
    transition: transform 0.2s ease;
  }

  .platform-cta:hover .platform-cta-arrow {
    transform: translateX(4px);
  }

  .cta-secondary {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 400px;
    margin: 0 auto;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .github-link:hover {
    color: white;
  }

  /* Container */
  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .step {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .platforms-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  </style>
