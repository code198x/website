---
import Layout from '../../layouts/Layout.astro';
import { Terminal, Monitor, Download, CheckCircle, Cpu, Package, Camera, Code } from '@lucide/astro';
import { getActivePlatforms } from '../../lib/platforms';

const platformsData = await getActivePlatforms();

// Transform to the shape needed by this page
const platforms = platformsData.map(p => ({
  name: p.data.shortName,
  fullName: p.data.name,
  slug: p.id,
  image: p.data.dockerImage,
  color: p.data.color,
  assembler: p.data.assembler,
  emulator: p.data.emulator,
  buildOutput: p.data.buildOutput,
  extras: p.data.toolchainExtras,
}));
---

<Layout
  title="Setup"
  description="Get started with retro game development in 60 seconds. Our Docker toolchains include everything you need - no installation hassle."
>
  <div class="setup-page">
    <!-- Hero -->
    <section class="hero">
      <!-- Retro Effects -->
      <div class="hero-effects">
        <div class="hero-shape shape-1"></div>
        <div class="hero-shape shape-2"></div>
        <div class="hero-shape shape-3"></div>
        <div class="hero-shape shape-4"></div>
        <div class="hero-grid"></div>
        <div class="hero-scanlines"></div>
        <div class="hero-beam"></div>
      </div>

      <div class="hero-content">
        <div class="hero-icon-wrapper">
          <Terminal size={48} class="hero-icon" />
        </div>
        <h1>Start Coding in 60 Seconds</h1>
        <p class="hero-subtitle">Zero configuration. One command to build.</p>
        <p class="hero-description">
          Our Docker toolchains include cross-assemblers and build tools for every platform.
          No dependency management. No version conflicts. Just code.
        </p>
      </div>
    </section>

    <!-- Quick Start -->
    <section class="quick-start">
      <div class="container">
        <h2>Quick Start</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Install Docker Desktop</h3>
              <p>Free from <a href="https://www.docker.com/products/docker-desktop/" target="_blank" rel="noopener">docker.com</a> for Mac, Windows, and Linux</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Download the Toolchain</h3>
              <div class="code-block">
                <code>docker pull code198x/commodore-64</code>
              </div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Build Your Code</h3>
              <div class="code-block">
                <code>docker run -v ./code:/code code198x/commodore-64 acme game.asm -o game.prg</code>
              </div>
            </div>
          </div>
        </div>
        <p class="steps-note">Done! Your compiled program is ready. Install an emulator (VICE for C64, Fuse for Spectrum) to run it.</p>
      </div>
    </section>

    <!-- Platform Cards -->
    <section class="platforms-section">
      <div class="container">
        <h2>Available Toolchains</h2>
        <p class="section-description">Each toolchain is tailored for its platform with the right assembler, emulator, and development tools.</p>

        <div class="platforms-grid">
          {platforms.map(platform => (
            <div class="platform-card" style={`--platform-color: ${platform.color}`}>
              <div class="platform-header">
                <h3>{platform.fullName}</h3>
                <div class="platform-image">
                  <code>{platform.image}</code>
                </div>
              </div>
              <div class="platform-tools">
                <div class="tool-row">
                  <Code size={16} />
                  <span><strong>Assembler:</strong> {platform.assembler}</span>
                </div>
                <div class="tool-row">
                  <Monitor size={16} />
                  <span><strong>Recommended emulator:</strong> {platform.emulator}</span>
                </div>
                <div class="tool-row">
                  <Package size={16} />
                  <span><strong>Output:</strong> {platform.buildOutput}</span>
                </div>
              </div>
              <div class="platform-extras">
                <strong>Also includes:</strong>
                <ul>
                  {platform.extras.map(extra => (
                    <li><CheckCircle size={14} /> {extra}</li>
                  ))}
                </ul>
              </div>
              <a href={`/${platform.slug}/getting-started`} class="platform-link">
                View full setup guide
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What's Included -->
    <section class="included-section">
      <div class="container">
        <h2>The Workflow</h2>
        <div class="features-grid">
          <div class="feature">
            <Code size={32} class="feature-icon" />
            <h3>Build in Docker</h3>
            <p>Cross-assemblers run in containers. Consistent builds across macOS, Windows, and Linux with zero setup.</p>
          </div>
          <div class="feature">
            <Monitor size={32} class="feature-icon" />
            <h3>Test in Emulators</h3>
            <p>Run your compiled programs in VICE, Fuse, FS-UAE, or FCEUX. Native emulators give the smoothest experience.</p>
          </div>
          <div class="feature">
            <Camera size={32} class="feature-icon" />
            <h3>Automated Screenshots</h3>
            <p>Docker toolchains include headless screenshot capture for CI/CD and documentation.</p>
          </div>
          <div class="feature">
            <Cpu size={32} class="feature-icon" />
            <h3>VS Code Integration</h3>
            <p>Dev Container support for seamless IDE integration with syntax highlighting.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Alternative -->
    <section class="native-section">
      <div class="container">
        <p class="native-note">
          <strong>Prefer native tools?</strong> You can install assemblers directly instead of using Docker.
          You'll manage dependencies yourself, but it's fully documented.
        </p>
        <div class="native-links">
          <a href="/setup/commodore-64/native">C64 Native Setup</a>
          <a href="/setup/sinclair-zx-spectrum/native">Spectrum Native Setup</a>
          <a href="/setup/commodore-amiga/native">Amiga Native Setup</a>
          <a href="/setup/nintendo-entertainment-system/native">NES Native Setup</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-effects">
        <div class="cta-grid"></div>
        <div class="cta-glow glow-1"></div>
        <div class="cta-glow glow-2"></div>
      </div>
      <div class="container">
        <h2>Ready to Build Something?</h2>
        <p class="cta-subtitle">Pick a platform and start your retro coding journey</p>

        <div class="platform-ctas">
          {platforms.map(platform => (
            <a href={`/${platform.slug}`} class="platform-cta" style={`--platform-color: ${platform.color}`}>
              <span class="platform-cta-name">{platform.name}</span>
              <span class="platform-cta-arrow">&rarr;</span>
            </a>
          ))}
        </div>

        <div class="cta-secondary">
          <a href="https://github.com/code198x" class="github-link" target="_blank" rel="noopener">
            <span>View toolchains on GitHub</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .setup-page {
    --accent-gradient: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    --terminal-green: var(--color-success, #22c55e);
  }

  /* Hero */
  .hero {
    min-height: 340px;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  /* Hero Effects Container */
  .hero-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Animated Floating Shapes - Terminal Green */
  .hero-shape {
    position: absolute;
    border-radius: 50%;
    background: var(--terminal-green);
    opacity: 0.12;
    filter: blur(40px);
  }

  .shape-1 {
    width: 250px;
    height: 250px;
    top: -80px;
    left: 5%;
    animation: float-1 8s ease-in-out infinite;
  }

  .shape-2 {
    width: 180px;
    height: 180px;
    bottom: -50px;
    right: 10%;
    animation: float-2 10s ease-in-out infinite;
  }

  .shape-3 {
    width: 120px;
    height: 120px;
    top: 40%;
    right: 20%;
    animation: float-3 12s ease-in-out infinite;
  }

  .shape-4 {
    width: 100px;
    height: 100px;
    bottom: 30%;
    left: 15%;
    animation: float-4 9s ease-in-out infinite;
  }

  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, 20px) scale(1.1); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-20px, -30px) scale(1.15); }
  }

  @keyframes float-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(15px, -15px) scale(1.05); }
  }

  @keyframes float-4 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-25px, 10px) scale(1.1); }
  }

  /* Grid Overlay */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
  }

  /* Scanlines */
  .hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.1) 2px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
  }

  /* Animated Beam */
  .hero-beam {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--terminal-green) 8%, transparent 92%),
      transparent
    );
    animation: scanline-beam 8s ease-in-out infinite;
  }

  @keyframes scanline-beam {
    0%, 100% { left: -50%; opacity: 0; }
    50% { left: 100%; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shape,
    .hero-beam {
      animation: none;
    }
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    color: white;
    padding: var(--space-12) var(--space-4);
  }

  .hero-icon-wrapper {
    margin-bottom: var(--space-4);
  }

  .hero-icon {
    color: var(--terminal-green);
    filter: drop-shadow(0 0 10px color-mix(in oklab, var(--terminal-green) 50%, transparent 50%));
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 var(--space-4) 0;
    color: white;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--terminal-green);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .hero-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin: 0;
  }

  /* Quick Start */
  .quick-start {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .quick-start h2 {
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .steps {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .step-number {
    width: 40px;
    height: 40px;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .step-content p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .step-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .step-content a:hover {
    color: var(--color-accent);
  }

  .code-block {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
  }

  .code-block code {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    background: none;
    padding: 0;
    color: var(--color-success);
  }

  .steps-note {
    text-align: center;
    color: var(--color-text-secondary);
    margin-top: var(--space-6);
    font-style: italic;
  }

  /* Platforms Section */
  .platforms-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg-secondary);
  }

  .platforms-section h2 {
    text-align: center;
    margin: 0 0 var(--space-2) 0;
  }

  .section-description {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-8) auto;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    max-width: 1200px;
    margin: 0 auto;
  }

  .platform-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--space-6);
    border-top: 4px solid var(--platform-color);
    transition: transform 0.2s ease, box-shadow 0.3s ease;
  }

  .platform-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 20px color-mix(in srgb, var(--platform-color) 25%, transparent),
      0 0 40px color-mix(in srgb, var(--platform-color) 15%, transparent),
      0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .platform-header {
    margin-bottom: var(--space-4);
  }

  .platform-header h3 {
    margin: 0 0 var(--space-2) 0;
    color: var(--platform-color);
  }

  .platform-image code {
    font-size: 0.8rem;
    background: var(--color-code-bg);
    color: var(--color-success);
    padding: var(--space-1) var(--space-2);
    border-radius: 0.25rem;
  }

  .platform-tools {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .tool-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .tool-row strong {
    color: var(--color-text);
  }

  .platform-extras {
    font-size: 0.875rem;
    margin-bottom: var(--space-4);
  }

  .platform-extras strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }

  .platform-extras ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .platform-extras li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
  }

  .platform-extras li :global(svg) {
    color: var(--color-success);
  }

  .platform-link {
    display: block;
    text-align: center;
    color: var(--platform-color);
    font-weight: 500;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-light);
  }

  .platform-link:hover {
    text-decoration: underline;
  }

  /* Included Section */
  .included-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .included-section h2 {
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin: 0 auto;
  }

  .feature {
    text-align: center;
    padding: var(--space-4);
  }

  .feature-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .feature h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.125rem;
  }

  .feature p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Native Section */
  .native-section {
    padding: var(--space-6) var(--space-4);
    background: var(--color-bg);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .native-note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .native-note strong {
    color: var(--color-text);
  }

  .native-note a {
    color: var(--color-primary);
  }

  .native-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-4);
  }

  .native-links a {
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .native-links a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-16) var(--space-4);
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
  }

  .cta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.15;
  }

  .glow-1 {
    width: 300px;
    height: 300px;
    background: var(--terminal-green);
    top: -100px;
    left: 10%;
  }

  .glow-2 {
    width: 250px;
    height: 250px;
    background: var(--color-primary);
    bottom: -80px;
    right: 15%;
  }

  .cta-section .container {
    position: relative;
    z-index: 1;
  }

  .cta-section h2 {
    margin: 0 0 var(--space-3) 0;
    color: white;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .cta-subtitle {
    margin: 0 0 var(--space-8) 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.125rem;
  }

  .platform-ctas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto var(--space-8) auto;
  }

  .platform-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 4px solid var(--platform-color);
    border-radius: 0.5rem;
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .platform-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--platform-color);
    transform: translateX(4px);
    box-shadow: 0 0 20px color-mix(in srgb, var(--platform-color) 30%, transparent);
  }

  .platform-cta-name {
    color: white;
  }

  .platform-cta-arrow {
    color: var(--platform-color);
    font-size: 1.25rem;
    transition: transform 0.2s ease;
  }

  .platform-cta:hover .platform-cta-arrow {
    transform: translateX(4px);
  }

  .cta-secondary {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 400px;
    margin: 0 auto;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .github-link:hover {
    color: white;
  }

  /* Container */
  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .step {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .platforms-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
