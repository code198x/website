---
import SetupLayout from '../../../layouts/SetupLayout.astro';
import { Terminal, Monitor, Apple, Download, CheckCircle } from '@lucide/astro';
---
<SetupLayout title="NES with ca65" description="Alternative local tools for this machine’s assembly lessons." systemSlug="nintendo-entertainment-system" alternative>
  <p>This guide uses ca65. For the recommended Asm198x workflow and available browser lessons, use the <a href="/systems/nintendo-entertainment-system/getting-started/">main setup guide</a>.</p>
    <h2 id="install">Install the alternative tools</h2>
    <section class="tabs-section">
      <div class="container">
        <div class="tabs-wrapper" data-setup-tabs>
          <div class="tab-bar" role="tablist" aria-label="Operating system">
            <button class="tab active" role="tab" aria-selected="true" data-tab="macos" id="tab-macos" aria-controls="macos" tabindex="0" type="button">
              <Apple size={20} />
              <span>macOS</span>
            </button>
            <button class="tab" role="tab" aria-selected="false" data-tab="windows" id="tab-windows" aria-controls="windows" tabindex="-1" type="button">
              <Monitor size={20} />
              <span>Windows</span>
            </button>
            <button class="tab" role="tab" aria-selected="false" data-tab="linux" id="tab-linux" aria-controls="linux" tabindex="-1" type="button">
              <Terminal size={20} />
              <span>Linux</span>
            </button>
          </div>

          <!-- macOS Panel -->
          <div class="tab-panel active" id="macos" role="tabpanel" aria-labelledby="tab-macos" tabindex="0"><h3 class="os-heading">macOS</h3>
            <div class="install-steps">
              <div class="step">
                <h3>1. Install Homebrew (if needed)</h3>
                <div class="code-block" tabindex="0">
                  <code>/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"</code>
                </div>
              </div>

              <div class="step">
                <h3>2. Install cc65 Toolchain</h3>
                <div class="code-block" tabindex="0">
                  <code>brew install cc65</code>
                </div>
                <p class="step-note">This includes ca65 (assembler), ld65 (linker), and cc65 (C compiler).</p>
              </div>

              <div class="step">
                <h3>3. Install FCEUX Emulator</h3>
                <div class="code-block" tabindex="0">
                  <code>brew install --cask fceux</code>
                </div>
              </div>

              <div class="step">
                <h3>4. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>ca65 --version && ld65 --version</code>
                </div>
              </div>
            </div>
          </div>

          <!-- Windows Panel -->
          <div class="tab-panel" id="windows" role="tabpanel" aria-labelledby="tab-windows" tabindex="0"><h3 class="os-heading">Windows</h3>
            <div class="install-steps">
              <div class="step">
                <h3>1. Download cc65</h3>
                <p>Download the Windows snapshot from <a href="https://cc65.github.io/" target="_blank" rel="noopener">cc65.github.io</a>.</p>
                <p class="step-note">Extract to a folder like <code>C:\cc65</code> and add <code>C:\cc65\bin</code> to your PATH.</p>
              </div>

              <div class="step">
                <h3>2. Download FCEUX</h3>
                <p>Download FCEUX from <a href="https://fceux.com/" target="_blank" rel="noopener">fceux.com</a>.</p>
              </div>

              <div class="step">
                <h3>3. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>ca65 --version</code>
                </div>
              </div>
            </div>
          </div>

          <!-- Linux Panel -->
          <div class="tab-panel" id="linux" role="tabpanel" aria-labelledby="tab-linux" tabindex="0"><h3 class="os-heading">Linux</h3>
            <div class="install-steps">
              <div class="step">
                <h3>1. Install cc65 (Debian/Ubuntu)</h3>
                <div class="code-block" tabindex="0">
                  <code>sudo apt install cc65</code>
                </div>
                <p class="step-note">Or build from source for the latest version: <a href="https://github.com/cc65/cc65" target="_blank" rel="noopener">github.com/cc65/cc65</a></p>
              </div>

              <div class="step">
                <h3>2. Install FCEUX</h3>
                <div class="code-block" tabindex="0">
                  <code>sudo apt install fceux</code>
                </div>
              </div>

              <div class="step">
                <h3>3. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>ca65 --version && ld65 --version</code>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Build Example -->
    <section class="install-section alt">
      <div class="container">
        <h2>Building Your Code</h2>
        <p class="section-description">NES builds typically use a two-step process - assemble then link:</p>

        <div class="code-block large" tabindex="0">
          <code>ca65 game.asm -o game.o</code>
        </div>

        <div class="code-block large" tabindex="0">
          <code>ld65 -C nes.cfg game.o -o game.nes</code>
        </div>

        <p class="section-description">Then run in FCEUX:</p>

        <div class="code-block large" tabindex="0">
          <code>fceux game.nes</code>
        </div>

        <p class="step-note">You'll need a linker config file (nes.cfg) - this is covered in the curriculum.</p>
      </div>
    </section>

    <!-- Back Link -->
    <section class="back-section">
      <div class="container">
        <a href="/setup" class="back-link">&larr; Back to Setup Guide</a>
        <a href="/systems/nintendo-entertainment-system" class="start-link">Start the NES Curriculum &rarr;</a>
      </div>
    </section>

</SetupLayout>
<script src="../../../scripts/setup-tabs.ts"></script>
