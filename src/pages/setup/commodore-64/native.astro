---
import SetupLayout from '../../../layouts/SetupLayout.astro';
import { Terminal, Monitor, Apple, Download, CheckCircle } from '@lucide/astro';
---
<SetupLayout title="C64 with ACME" description="Alternative local tools for this machine’s assembly lessons." systemSlug="commodore-64" alternative>
  <p>This guide uses ACME. For the recommended Asm198x workflow and available browser lessons, use the <a href="/systems/commodore-64/getting-started/">main setup guide</a>.</p>
    <h2 id="install">Install the alternative tools</h2>
    <section class="tabs-section">
      <div class="container">
        <div class="tabs-wrapper" data-setup-tabs>
          <div class="tab-bar" role="tablist" aria-label="Operating system">
            <button class="tab active" role="tab" aria-selected="true" data-tab="macos" id="tab-macos" aria-controls="macos" tabindex="0" type="button">
              <Apple size={20} />
              <span>macOS</span>
            </button>
            <button class="tab" role="tab" aria-selected="false" data-tab="windows" id="tab-windows" aria-controls="windows" tabindex="-1" type="button">
              <Monitor size={20} />
              <span>Windows</span>
            </button>
            <button class="tab" role="tab" aria-selected="false" data-tab="linux" id="tab-linux" aria-controls="linux" tabindex="-1" type="button">
              <Terminal size={20} />
              <span>Linux</span>
            </button>
          </div>

          <!-- macOS Panel -->
          <div class="tab-panel active" id="macos" role="tabpanel" aria-labelledby="tab-macos" tabindex="0"><h3 class="os-heading">macOS</h3>
            <div class="install-steps">
              <div class="step">
                <h3>1. Install Homebrew (if needed)</h3>
                <div class="code-block" tabindex="0">
                  <code>/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"</code>
                </div>
              </div>

              <div class="step">
                <h3>2. Install ACME Assembler</h3>
                <div class="code-block" tabindex="0">
                  <code>brew install acme</code>
                </div>
              </div>

              <div class="step">
                <h3>3. Install VICE Emulator</h3>
                <div class="code-block" tabindex="0">
                  <code>brew install --cask vice</code>
                </div>
                <p class="step-note">This installs x64sc (the cycle-accurate C64 emulator) and other VICE tools.</p>
              </div>

              <div class="step">
                <h3>4. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>acme --version</code>
                </div>
              </div>
            </div>
          </div>

          <!-- Windows Panel -->
          <div class="tab-panel" id="windows" role="tabpanel" aria-labelledby="tab-windows" tabindex="0"><h3 class="os-heading">Windows</h3>
            <div class="install-steps">
              <div class="step">
                <h3>1. Download ACME</h3>
                <p>Download the latest ACME release from <a href="https://sourceforge.net/projects/acme-crossass/" target="_blank" rel="noopener">SourceForge</a>.</p>
                <p class="step-note">Extract to a folder like <code>C:\Tools\acme</code> and add it to your PATH.</p>
              </div>

              <div class="step">
                <h3>2. Download VICE</h3>
                <p>Download VICE from <a href="https://vice-emu.sourceforge.io/" target="_blank" rel="noopener">vice-emu.sourceforge.io</a>.</p>
                <p class="step-note">The Windows GTK3 build is recommended. Extract and optionally add to PATH.</p>
              </div>

              <div class="step">
                <h3>3. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>acme --version</code>
                </div>
              </div>
            </div>
          </div>

          <!-- Linux Panel -->
          <div class="tab-panel" id="linux" role="tabpanel" aria-labelledby="tab-linux" tabindex="0"><h3 class="os-heading">Linux</h3>
            <div class="install-steps">
              <div class="step">
                <h3>1. Install ACME (Debian/Ubuntu)</h3>
                <div class="code-block" tabindex="0">
                  <code>sudo apt install acme</code>
                </div>
                <p class="step-note">On other distros, build from source or check your package manager.</p>
              </div>

              <div class="step">
                <h3>2. Install VICE</h3>
                <div class="code-block" tabindex="0">
                  <code>sudo apt install vice</code>
                </div>
              </div>

              <div class="step">
                <h3>3. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>acme --version && x64sc --version</code>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Build Example -->
    <section class="install-section alt">
      <div class="container">
        <h2>Building Your Code</h2>
        <p class="section-description">Once installed, build your assembly files directly:</p>

        <div class="code-block large" tabindex="0">
          <code>acme -f cbm -o game.prg game.asm</code>
        </div>

        <p class="section-description">Then run in VICE:</p>

        <div class="code-block large" tabindex="0">
          <code>x64sc game.prg</code>
        </div>
      </div>
    </section>

    <!-- ROMs -->
    <section class="install-section">
      <div class="container">
        <h2>You'll also need ROMs</h2>
        <p class="section-description">
          VICE doesn't include the C64's system ROMs (KERNAL, BASIC, character) — you provide your
          own. It's free where it can be, and cheap where it can't.{' '}
          <a href="/setup/roms#commodore-64">How to get your C64 ROMs &rarr;</a>
        </p>
      </div>
    </section>

    <!-- Back Link -->
    <section class="back-section">
      <div class="container">
        <a href="/setup" class="back-link">&larr; Back to Setup Guide</a>
        <a href="/systems/commodore-64" class="start-link">Start the C64 Curriculum &rarr;</a>
      </div>
    </section>

</SetupLayout>
<script src="../../../scripts/setup-tabs.ts"></script>
