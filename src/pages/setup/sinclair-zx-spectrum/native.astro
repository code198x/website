---
import Layout from '../../../layouts/Layout.astro';
import { Terminal, Monitor, Apple } from '@lucide/astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Setup', href: '/setup' },
  { label: 'ZX Spectrum', href: '/setup#workspace' },
  { label: 'Native' },
];

const platformColor = 'var(--zx-magenta, #cc0000)';
---

<Layout
  title="Spectrum Native Setup"
  description="Install pasmo assembler and Fuse emulator directly on your system for ZX Spectrum development."
  breadcrumbs={breadcrumbs}
>
  <div class="native-page">
    <!-- Hero -->
    <section class="hero" style={`--accent-color: ${platformColor}`}>
      <div class="hero-effects">
        <div class="hero-shape shape-1"></div>
        <div class="hero-shape shape-2"></div>
        <div class="hero-shape shape-3"></div>
        <div class="hero-grid"></div>
        <div class="hero-scanlines"></div>
        <div class="hero-beam"></div>
      </div>

      <div class="hero-content">
        <div class="hero-icon-wrapper">
          <Terminal size={48} class="hero-icon" />
        </div>
        <h1>Spectrum Native Setup</h1>
        <p class="hero-subtitle">Install tools directly on your system</p>
        <p class="hero-description">
          Install the pasmo assembler natively, if you want the reference tool the
            curriculum's Spectrum output is checked against. Asm198x builds the same
            bytes and installs in one command.
        </p>
      </div>
    </section>

    <!-- OS Tabs Section -->
    <section class="tabs-section">
      <div class="container">
        <div class="tabs-wrapper">
          <div class="tab-bar" role="tablist">
            <button class="tab active" role="tab" aria-selected="true" data-tab="macos">
              <Apple size={20} />
              <span>macOS</span>
            </button>
            <button class="tab" role="tab" aria-selected="false" data-tab="windows">
              <Monitor size={20} />
              <span>Windows</span>
            </button>
            <button class="tab" role="tab" aria-selected="false" data-tab="linux">
              <Terminal size={20} />
              <span>Linux</span>
            </button>
          </div>

          <!-- macOS Panel -->
          <div class="tab-panel active" id="macos" role="tabpanel">
            <div class="install-steps">
              <div class="step">
                <h3>1. Install Homebrew (if needed)</h3>
                <div class="code-block" tabindex="0">
                  <code>/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"</code>
                </div>
              </div>

              <div class="step">
                <h3>2. Install Pasmo Assembler</h3>
                <div class="code-block" tabindex="0">
                  <code>brew install pasmo</code>
                </div>
                <p class="step-note">Note: The curriculum uses pasmonext (enhanced fork). For full compatibility, build it from <a href="https://github.com/Ckirby101/pasmoNext" target="_blank" rel="noopener">source</a>, or use Asm198x, whose pasmonext dialect produces identical bytes.</p>
              </div>

              <div class="step">
                <h3>3. Install Fuse Emulator</h3>
                <div class="code-block" tabindex="0">
                  <code>brew install --cask fuse</code>
                </div>
              </div>

              <div class="step">
                <h3>4. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>pasmo --version</code>
                </div>
              </div>
            </div>
          </div>

          <!-- Windows Panel -->
          <div class="tab-panel" id="windows" role="tabpanel">
            <div class="install-steps">
              <div class="step">
                <h3>1. Download Pasmo</h3>
                <p>Download pasmo from <a href="http://pasmo.speccy.org/" target="_blank" rel="noopener">pasmo.speccy.org</a>.</p>
                <p class="step-note">Extract to a folder like <code>C:\Tools\pasmo</code> and add it to your PATH.</p>
              </div>

              <div class="step">
                <h3>2. Download Fuse</h3>
                <p>Download Fuse from <a href="http://fuse-emulator.sourceforge.net/" target="_blank" rel="noopener">fuse-emulator.sourceforge.net</a>.</p>
              </div>

              <div class="step">
                <h3>3. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>pasmo --version</code>
                </div>
              </div>
            </div>
          </div>

          <!-- Linux Panel -->
          <div class="tab-panel" id="linux" role="tabpanel">
            <div class="install-steps">
              <div class="step">
                <h3>1. Install Pasmo (Debian/Ubuntu)</h3>
                <div class="code-block" tabindex="0">
                  <code>sudo apt install pasmo</code>
                </div>
              </div>

              <div class="step">
                <h3>2. Install Fuse</h3>
                <div class="code-block" tabindex="0">
                  <code>sudo apt install fuse-emulator-gtk</code>
                </div>
              </div>

              <div class="step">
                <h3>3. Verify Installation</h3>
                <div class="code-block" tabindex="0">
                  <code>pasmo --version && fuse --version</code>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Build Example -->
    <section class="install-section alt">
      <div class="container">
        <h2>Building Your Code</h2>
        <p class="section-description">Once installed, build your assembly files directly:</p>

        <div class="code-block large" tabindex="0">
          <code>pasmo --tap game.asm game.tap</code>
        </div>

        <p class="section-description">Or create a snapshot file:</p>

        <div class="code-block large" tabindex="0">
          <code>pasmo --sna game.asm game.sna</code>
        </div>

        <p class="section-description">Then run in Fuse:</p>

        <div class="code-block large" tabindex="0">
          <code>fuse game.tap</code>
        </div>
      </div>
    </section>

    <!-- Back Link -->
    <section class="back-section">
      <div class="container">
        <a href="/setup" class="back-link">&larr; Back to Setup Guide</a>
        <a href="/sinclair-zx-spectrum" class="start-link">Start the Spectrum Curriculum &rarr;</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.tab;

        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(panel => {
          panel.classList.remove('active');
          if (panel.id === targetId) {
            panel.classList.add('active');
          }
        });
      });
    });
  });
</script>

<style>
  .native-page {
    --accent-color: var(--zx-magenta, #cc0000);
  }

  /* Hero */
  .hero {
    min-height: 300px;
    background: var(--color-house);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    background: var(--accent-color);
    opacity: 0.15;
    filter: blur(40px);
  }

  .shape-1 {
    width: 200px;
    height: 200px;
    top: -50px;
    left: 10%;
    animation: float-1 8s ease-in-out infinite;
  }

  .shape-2 {
    width: 150px;
    height: 150px;
    bottom: -30px;
    right: 15%;
    animation: float-2 10s ease-in-out infinite;
  }

  .shape-3 {
    width: 100px;
    height: 100px;
    top: 50%;
    right: 25%;
    animation: float-3 12s ease-in-out infinite;
  }

  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, 20px) scale(1.1); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-20px, -30px) scale(1.15); }
  }

  @keyframes float-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(15px, -15px) scale(1.05); }
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
  }

  .hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.1) 2px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
  }

  .hero-beam {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--accent-color) 10%, transparent 90%),
      transparent
    );
    animation: scanline-beam 8s ease-in-out infinite;
  }

  @keyframes scanline-beam {
    0%, 100% { left: -50%; opacity: 0; }
    50% { left: 100%; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shape, .hero-beam { animation: none; }
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    color: white;
    padding: var(--space-12) var(--space-4);
  }

  .hero-icon-wrapper {
    margin-bottom: var(--space-4);
  }

  .hero-icon {
    color: var(--ink);
    filter: drop-shadow(0 0 10px color-mix(in oklab, var(--accent-color) 50%, transparent 50%));
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin: 0 0 var(--space-3) 0;
    color: white;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--ink);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .hero-description {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* Tabs Section */
  .tabs-section {
    padding: var(--space-8) var(--space-4);
    background: var(--color-bg);
  }

  .tabs-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .tab-bar {
    display: flex;
    gap: var(--space-2);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .tab {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    color: var(--color-text-secondary);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }

  .tab.active {
    color: var(--ink);
    border-bottom-color: var(--accent-color);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Install Sections */
  .install-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-bg);
  }

  .install-section.alt {
    background: var(--color-bg-secondary);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .install-section h2 {
    margin: 0 0 var(--space-2) 0;
  }

  .section-description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  /* Prose links here were unstyled, so they fell back to the UA default blue —
     8.32:1 on the light page but 1.90:1 on the dark one. Same treatment as the
     /setup index. Applied to all four native pages, which are near-copies of
     each other, so a link added to any of them later starts out readable. */
  .section-description a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .section-description a:hover {
    color: var(--color-accent);
  }

  .install-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .step h3 {
    font-size: 1.125rem;
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text);
  }

  .step p {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3) 0;
  }

  .step p a {
    color: var(--color-primary);
  }

  .step-note {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
  }

  .step-note a {
    color: var(--color-primary);
  }

  .step-note code {
    background: var(--color-code-bg);
    color: var(--color-code-text);
    padding: 0.125rem 0.375rem;
    border-radius: 0;
    font-size: 0.8rem;
  }

  .code-block {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
  }

  .code-block.large {
    margin-bottom: var(--space-4);
  }

  .code-block code {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    color: var(--color-success);
    background: none;
    padding: 0;
  }

  /* Back Section */
  .back-section {
    padding: var(--space-8) var(--space-4);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .back-section .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .back-link, .start-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover, .start-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: var(--space-8) var(--space-4);
    }

    .back-section .container {
      flex-direction: column;
      text-align: center;
    }
  }

    /* --- synthesis hero override (paper/ink, no neon decoration) --- */
    .hero { background: transparent; color: var(--color-text); min-height: 0; }
    .hero-effects, .hero-shape, .hero-shapes, .hero-grid, .hero-scanlines, .hero-beam { display: none; }
    .hero-content { color: var(--color-text); }
    .hero h1, .hero-title { font-family: var(--font-family-read); font-weight: 700; line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; color: var(--color-text); }
    .hero h1 *, .hero-title * { color: var(--color-text); }
    .hero-subtitle, .hero-description { color: var(--color-text-secondary); opacity: 1; }
    .hero-icon, .hero-icon-wrapper { color: var(--color-house-2); }
  </style>
