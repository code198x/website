---
import Layout from '../layouts/Layout.astro';
import { Cpu, Binary, Database, Hammer, Package, Play, Github, ArrowRight } from '@lucide/astro';

type Status = 'active' | 'new' | 'planned';

interface Sibling {
  name: string;
  tagline: string;
  description: string;
  status: Status;
  href: string | null;
  learnMore?: string; // internal explainer page, takes precedence over href
  icon: any;
}

const siblings: Sibling[] = [
  {
    name: 'Emu198x',
    tagline: 'Cycle-accurate emulation',
    description:
      'Emulators for vintage machines, written in Rust — cross-platform, scriptable, and MCP-driven. The accuracy work that lets a Pattern Library routine claim "this works on real hardware" and mean it.',
    status: 'active',
    href: 'https://github.com/emu198x',
    learnMore: '/family/emu198x',
    icon: Cpu,
  },
  {
    name: 'Asm198x',
    tagline: 'Modern assemblers & disassemblers',
    description:
      'Single-binary, cross-platform assemblers and disassemblers for the family’s target CPUs — 6502, Z80, 68000 — built on a shared, declarative ISA spec. No dead operating system required to run them.',
    status: 'new',
    href: 'https://github.com/asm198x',
    learnMore: '/family/asm198x',
    icon: Binary,
  },
  {
    name: 'Cat198x',
    tagline: 'Asset cataloguing',
    description:
      'Inventory, verify, and dedup retro binary collections — ROMs, OS disks, TOSEC sets, test suites. Knows what you have, what’s verified against the DATs, and what’s missing.',
    status: 'active',
    href: 'https://github.com/cat198x',
    learnMore: '/family/cat198x',
    icon: Database,
  },
  {
    name: 'Forge198x',
    tagline: 'A workbench for vintage code',
    description:
      'A dev workbench for writing vintage code, sitting over Emu198x and Asm198x with agent-native parity. The repo home is established; the build is deferred until the assembler matures.',
    status: 'planned',
    href: null,
    icon: Hammer,
  },
  {
    name: 'Build198x',
    tagline: 'Build tools & media mastering',
    description:
      'The build pipeline beyond the assembler — converts graphics and audio to native formats (like SCR, Koala, and IFF ILBM), packs data, and masters disk and tape images. Active with Wave 1 image converter merged.',
    status: 'active',
    href: 'https://github.com/build198x',
    icon: Package,
  },
  {
    name: 'Play198x',
    tagline: 'A player for vintage media',
    description:
      'Plays and previews retro media — SID and AY tunes, IFF and SCR images, Amiga animations — by driving Emu198x’s chip cores, without booting a whole machine. Decided as a sibling; the build is not yet started.',
    status: 'planned',
    href: null,
    icon: Play,
  },
];

const statusLabel: Record<Status, string> = {
  active: 'Active',
  new: 'New',
  planned: 'Planned',
};
---

<Layout
  title="The 198x Family"
  description="Code Like It's 198x is one of several sibling projects under the 198x umbrella — emulators, assemblers, and asset tooling for vintage machines. Each has its own mission, roadmap, and brand."
>
  <div class="family-page">
    <section class="hero">
      <div class="hero-content">
        <div class="hero-badge">// THE 198x FAMILY</div>
        <h1>One umbrella, several missions</h1>
        <p class="hero-subtitle">Emulators, assemblers, and asset tooling for vintage machines</p>
      </div>
    </section>

    <div class="family-intro">
      <p class="lead">
        Code Like It's 198x is one of several sibling projects under the <strong>198x</strong> umbrella.
        They share an origin and a love of these machines — but each has its own mission, roadmap, and
        brand. None is "the tool behind" another; they're peers that happen to grow up together.
      </p>
      <p>
        If you've come here from the curriculum, this is what powers the work behind the scenes —
        and where to go if you want to use the tools directly, or help build them.
      </p>
    </div>

    <div class="sibling-grid">
      {siblings.map((s) => (
        <article class={`sibling-card status-${s.status}`}>
          <div class="sibling-head">
            <span class="sibling-icon"><s.icon size={28} /></span>
            <span class={`sibling-badge badge-${s.status}`}>{statusLabel[s.status]}</span>
          </div>
          <h2>{s.name}</h2>
          <p class="sibling-tagline">{s.tagline}</p>
          <p class="sibling-description">{s.description}</p>
          {s.learnMore ? (
            <a class="sibling-link" href={s.learnMore}>
              Explore {s.name} <ArrowRight size={15} />
            </a>
          ) : s.href ? (
            <a class="sibling-link" href={s.href} target="_blank" rel="noopener">
              <Github size={16} /> View on GitHub <ArrowRight size={15} />
            </a>
          ) : (
            <span class="sibling-link disabled">In design — not yet public</span>
          )}
        </article>
      ))}
    </div>

    <div class="family-foot">
      <p>
        All of it is open source, built in the open, with a lot of help from large language models —
        declared plainly, as everything here is.
      </p>
    </div>
  </div>
</Layout>

<style>
  .family-page {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }

  /* Hero */
  .hero {
    padding: var(--space-12) var(--space-4) var(--space-8);
    text-align: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-house-2);
    letter-spacing: 0.2em;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-house-2);
    background: var(--color-surface);
  }

  .hero h1 {
    font-family: var(--font-family-script);
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 0.9;
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    color: var(--color-text-secondary);
    margin: 0;
    font-family: var(--font-family-mono);
    letter-spacing: 0.08em;
  }

  /* Intro */
  .family-intro {
    max-width: 680px;
    margin: 0 auto var(--space-10);
    text-align: center;
  }

  .family-intro .lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }

  .family-intro p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Sibling grid */
  .sibling-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .sibling-card {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .sibling-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .sibling-card.status-planned {
    opacity: 0.75;
  }

  .sibling-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .sibling-icon {
    color: var(--color-house-2);
    display: inline-flex;
  }

  .sibling-badge {
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
  }

  .badge-active { color: #166534; }
  :global(:root[data-theme="dark"]) .badge-active { color: #4ade80; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .badge-active { color: #4ade80; }
  }
  .badge-new { color: var(--color-primary); }
  .badge-planned { color: var(--color-text-muted); }

  .sibling-card h2 {
    font-size: 1.5rem;
    margin: 0 0 var(--space-1) 0;
    color: var(--color-text);
  }

  .sibling-tagline {
    font-family: var(--font-family-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3) 0;
  }

  .sibling-description {
    color: var(--color-text-secondary);
    line-height: 1.65;
    font-size: 0.9375rem;
    margin: 0 0 var(--space-5) 0;
    flex: 1;
  }

  .sibling-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: gap var(--transition-base);
  }

  .sibling-link:hover {
    gap: var(--space-3);
  }

  .sibling-link.disabled {
    color: var(--color-text-muted);
    font-weight: 400;
    font-style: italic;
  }

  /* Foot */
  .family-foot {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .family-foot p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }
</style>
