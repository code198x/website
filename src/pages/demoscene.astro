---
/**
 * Demoscene — /demoscene
 *
 * "Constraint is the craft." Closes door 5 on /start-here. A short intro
 * (extending the router door 5 body) funnels into the demoscene material already
 * in the Vault — demos, groups, and parties/events — then on to the assembly
 * tracks and the pattern library.
 *
 * Vault URL pattern: entries are loaded by glob from src/content/vault with the
 * category folder in the id (e.g. demos/second-reality), and the route is
 * /vault/[...slug].astro keyed on entry.id — so each entry lives at
 * `/vault/${entry.id}`. Counts are real, taken from the collection at build.
 * House idiom: mono eyebrows, script headings, 3px borders, chunky offset
 * shadows, square corners.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Figure from '../components/Figure.astro';
import DemosceneBanner from '../components/DemosceneBanner.astro';
import { getCollection } from 'astro:content';

const vault = await getCollection('vault');
const byCategory = (cat: string) =>
  vault
    .filter((e) => e.data.category === cat)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

const demos = byCategory('demos');
const groups = byCategory('groups');
const events = byCategory('events');

interface Section {
  key: string;
  eyebrow: string;
  title: string;
  blurb: string;
  entries: typeof demos;
}

const sections: Section[] = [
  {
    key: 'demos',
    eyebrow: 'Productions',
    title: 'The demos',
    blurb:
      'Landmark productions — the ones that made a fixed palette and a few kilobytes do things their ' +
      'designers swore were impossible.',
    entries: demos,
  },
  {
    key: 'groups',
    eyebrow: 'Crews',
    title: 'The groups',
    blurb:
      'The crews behind the work — coders, musicians and artists who pushed each machine, and each ' +
      'other, for the love of it.',
    entries: groups,
  },
  {
    key: 'events',
    eyebrow: 'Gatherings',
    title: 'The parties',
    blurb:
      'Where the scene gathers and competes — the parties and events where productions are unveiled, ' +
      'judged, and remembered.',
    entries: events,
  },
];

const total = demos.length + groups.length + events.length;
---

<Layout
 
  title="The demoscene"
  description="Constraint is the craft. The demoscene took a fixed palette, a handful of sprites and a few kilobytes and made the machines sing. The Vault's demos, groups and parties, gathered — then on to the assembly that makes it possible."
>
  <DemosceneBanner />
  <div class="wrap">
    <PageHeader title="Constraint is the craft.">

      <p class="lede">Limits are the point. A fixed palette, a handful of sprites, a few kilobytes —
        constraint is what makes the work <span class="mk">sing</span>, and these machines have it in
        abundance. The demoscene turned those limits into an art form. Here's what the Vault holds on it
        so far — and where to go to learn the craft yourself.</p>
    </PageHeader>

    <section class="production-feature" aria-labelledby="production-title">
      <Figure
        kind="capture"
        src="/images/vault/demos/state-of-the-art/dancer.png"
        alt="A dark red dancer silhouette with one arm raised and overlapping orange outlines against white."
        width={384}
        caption="*State of the Art* — Spaceballs, 1992, Commodore Amiga. Graphics: TMB Designs. Captured by Code198x from the memory-compatible release. Demo artwork remains the work of its creators."
      />
      <div>
        <h2 id="production-title">A dancer becomes shapes</h2>
        <p>The dancers in Spaceballs’ <em>State of the Art</em> were traced from video
          into shapes the Amiga could draw. Look at the outline and the layers of warm
          colour around it: a few flat shapes can preserve a recognisable pose.</p>
        <p>The finished demo brings those shapes into movement and sets them to music.
          Its success also sparked an argument about what a demo should calculate
          while it runs, and what it can prepare in advance.</p>
        <a class="production-link" href="/vault/demos/state-of-the-art/">Explore State of the Art →</a>
      </div>
    </section>

    {sections.map((s) => (
      <section class="band">
        <div class="band-head">
          <div>
            <p class="aud">{s.eyebrow}</p>
            <h2>{s.title}</h2>
          </div>
          <span class="count">{s.entries.length}</span>
        </div>
        <p class="intro">{s.blurb}</p>
        {s.entries.length > 0 ? (
          <div class="grid">
            {s.entries.map((e) => (
              <a class="entry" href={`/vault/${e.id}`}>
                <span class="entry-t">{e.data.title}</span>
                {e.data.subtitle && <span class="entry-s">{e.data.subtitle}</span>}
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">Nothing here yet — this corner of the Vault is still being filled.</p>
        )}
      </section>
    ))}

    <section class="band cta-band">
      <p class="aud">Learn the craft</p>
      <h2>From admiring it to making it</h2>
      <p class="intro">Most of the demos above were written for the Amiga, the Commodore 64 and the
        ZX Spectrum, three of the machines the curriculum teaches in assembly. Pick a machine and
        learn it from the metal up, then use the pattern library for techniques the scene also
        relied on.</p>
      <div class="acts">
        <a class="btn btn-primary" href="/systems">Pick a machine, learn the assembly →</a>
        <a class="btn btn-secondary" href="/patterns">Raid the pattern library</a>
      </div>
    </section>

    <p class="foot">{total} demoscene entries in <a href="/vault">the Vault</a> so far, and growing.
      Spotted a gap, or a production we've missed? <a href="/contribute">Help fill it in.</a></p>
  </div>
</Layout>

<style>
  @layer legacy {
  /* Approved full-bleed artwork; reading and navigation retain the house frame. */
  :global(main#main-content[data-site-frame]:has(> .demoscene-opening)) { max-width: none; }
  :global(main#main-content[data-site-frame]:has(> .demoscene-opening) > .wrap) {
    max-width: var(--site-frame-width); margin-inline: auto;
  }
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .production-feature { display: grid; grid-template-columns: minmax(0, 384px) minmax(0, 1fr); align-items: center; gap: var(--space-8); margin-block: var(--space-8) var(--space-12); }
  .production-feature :global(.figure) { margin: 0; min-width: 0; }
  .production-feature :global(.figure.figure-capture .native-capture) { width: min(var(--native-width), 100%); max-width: 100% !important; left: auto; transform: none; margin-inline: auto; }
  .production-feature h2 { margin: var(--space-3) 0 var(--space-4); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; }
  .production-feature p { max-width: 65ch; line-height: 1.65; }
  .production-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
  @media (max-width: 860px) { .production-feature { grid-template-columns: minmax(0, 1fr); } }
  .eyebrow { font-family: var(--font-family-read); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--color-text-secondary); }
  .mk { background: linear-gradient(180deg, transparent 58%, var(--color-house-tint) 58%); padding: 0 2px; }

  .vhead { margin-bottom: var(--space-10); }
  .vhead h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3rem, 7vw, 4.8rem); line-height: 0.86;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 200px; max-width: 80%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .lede { font-size: 1.05rem; max-width: 72ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  .band {
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-8);
    margin-top: var(--space-10);
  }

  .band-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
  .aud { font-family: var(--font-family-read); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--color-text-secondary); margin: 0; }
  .band h2 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 0.95; margin: var(--space-2) 0 0; color: var(--color-text); }
  .count { font-family: var(--font-family-read); font-size: 0.8125rem; font-weight: 600; color: var(--color-house-2); border: 2px solid var(--color-house-2); padding: 3px 9px; white-space: nowrap; }
  .intro { font-size: 1rem; max-width: 72ch; margin: var(--space-3) 0 0; color: var(--color-text); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-6); }
  .entry {
    display: flex; flex-direction: column;
    border: 3px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-4);
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .entry:hover, .entry:focus-visible { transform: translate(-3px, -3px); box-shadow: var(--shadow-chunky); border-color: var(--color-house-2); }
  .entry-t { font-family: var(--font-family-read); font-size: 0.92rem; font-weight: 600; color: var(--color-text); }
  .entry-s { font-size: 0.8rem; color: var(--color-text-secondary); line-height: 1.4; margin-top: 3px; }

  .empty { font-size: 0.9rem; font-style: italic; color: var(--color-text-secondary); margin: var(--space-5) 0 0; }

  .cta-band { background: var(--color-house-tint); }
  .acts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }

  .foot { margin-top: var(--space-10); font-size: 0.92rem; color: var(--color-text-secondary); }
  .foot a { color: var(--ink); font-weight: 600; }

  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } .band { padding: var(--space-6); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
  }
</style>
