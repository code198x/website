---
import Layout from '../../layouts/Layout.astro';
import CodeFromFile from '../../components/CodeFromFile.astro';
import { crashTypeins } from '../../lib/crash-typeins';
const program = crashTypeins.find(program => program.id === 'c64-logo')!;
---
<Layout title="Type this in: Commodore 64" description="Draw the 198x logo in Commodore 64 BASIC, then find your next programming project.">
  <article class="typein-page">
    <p class="kicker">Commodore 64 · BASIC</p>
    <h1>Type this in.</h1>
    <p>{program.note} Enter RUN when you're ready.</p>
    <img src="/images/crash-live/c64-logo.png" alt={program.alt} width="320" height="200" />
    <h2>Your card's listing</h2>
    <p><a href="/c64-type-in/c64-logo.bas" download>Download the BASIC listing</a></p>
    <CodeFromFile src={program.source} lang={program.lang} />
    <h2>Make something else.</h2>
    <p>Explore free programming lessons for the Commodore 64 and build a game of your own.</p>
    <p><a href={program.next}>Find your next Commodore 64 project →</a></p>
  </article>
</Layout>
<style>
  .typein-page { max-width: 900px; margin: auto; padding: var(--space-8) var(--gutter); }
  h1, h2 { font-family: var(--font-family-read); }
  h1 { font-size: clamp(2.5rem, 6vw, 4rem); }
  h2 { margin-top: var(--space-8); }
  p { line-height: 1.7; }
  .kicker { font-family: var(--font-family-mono); }
  img { display: block; width: min(100%, 480px); height: auto; margin: var(--space-6) 0; image-rendering: pixelated; }
  a { display: inline-block; padding: 10px 0; text-underline-offset: 3px; }
  :global(.typein-page .copy-button) { opacity: 1; min-height: 44px; }
  :global(.typein-page pre) { overflow: auto; padding-top: 4rem; }
</style>
