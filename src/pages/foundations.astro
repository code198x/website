---
import TeachingExample from '../components/TeachingExample.astro';
import Layout from '../layouts/Layout.astro';
import PageFrame from '../components/PageFrame.astro';
import { getCollection } from 'astro:content';
import { getSection } from '../lib/sections';
import { getSectionModules } from '../lib/modules';

const section = getSection('foundations');

// Order is catalogue data, not a list in a page. See
// Code198x docs/website.md#content-and-navigation
const catalogue = await getSectionModules('foundations');
const ORDER = catalogue.map((m) => m.slug);
const statusOf = (slug: string) => catalogue.find((m) => m.slug === slug)?.status;
const subtracks = (await getCollection('module-pages'))
  .filter((e) => e.id.startsWith('foundations/'))
  .map((e) => ({
    slug: e.id.replace(/\/index$/, '').replace(/^foundations\//, ''),
    title: e.data.title,
    description: e.data.description ?? '',
  }))
  .map((m) => ({ ...m, soon: statusOf(m.slug) === 'coming-soon' }))
  .sort((a, b) => {
    const ia = ORDER.indexOf(a.slug);
    const ib = ORDER.indexOf(b.slug);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.title.localeCompare(b.title);
  });

// Group headings come from the catalogue too. A module naming no group, or a
// group nothing is in, still renders rather than vanishing.
const catalogueEntry = (await getCollection('modules')).find((e) => e.data.section === 'foundations');
const groupOf = (slug: string) => catalogue.find((m) => m.slug === slug)?.group;
const groups = (catalogueEntry?.data.groups ?? [])
  .map((g) => ({ ...g, modules: subtracks.filter((s) => groupOf(s.slug) === g.slug) }))
  .filter((g) => g.modules.length > 0);
const ungrouped = subtracks.filter((s) => !groups.some((g) => g.slug === groupOf(s.slug)));

const accent = section?.color ?? '#0d9488';
---

<Layout
  title="Foundations"
  description="Explore programming, representation and execution through pseudocode, diagrams and worked examples. Read from the beginning or visit a concept when you need it."
 
>
  <PageFrame class="foundations-page" opening="none">
    <section class="hero">
      <div class="in">
        <h1>The Ideas Every<br/><em>Machine Shares.</em></h1>
        <p class="lede">Explore what a program does, how a machine counts and how your
          instructions reach it. Pseudocode, diagrams and worked examples keep the ideas
          independent of any one language. You need no programming experience to begin.
          Follow the groups in order, visit a subject that interests you, or return when
          a game raises a question. You can start a system track without completing
          Foundations first.</p>
      </div>
    </section>


    <p class="foundation-start"><a href="/foundations/basics/">Start with The Basics →</a></p>
    <nav class="foundation-groups" aria-label="Foundations subject groups">{groups.map(g=><a href={`#group-${g.slug}`}>{g.name}</a>)}</nav>
    <section class="foundation-example"><div><h2>One Instruction.<br/><em>One Result.</em></h2><p>Here is the smallest program there is. One instruction, which shows a word.</p><a href="/foundations/basics/unit-01/">Read A Program Is Instructions</a></div><TeachingExample/></section>
    {[...groups, ...(ungrouped.length ? [{ slug: 'other', name: 'Also here', strap: '', modules: ungrouped }] : [])].map((g) => (
      <section class="group" aria-labelledby={`group-${g.slug}`}>
        <header class="group-head">
          <h2 class="group-title" id={`group-${g.slug}`}>{g.name}</h2>
          {g.strap && <p class="group-strap">{g.strap}</p>}
        </header>
        <ol class="grid">
          {g.modules.map((s, i) => (
            <li>
              <a class="card" href={`/foundations/${s.slug}`}>

                <h3>{s.title}{s.soon && <span class="soon">soon</span>}</h3>
                <p class="desc">{s.description}</p>
                <span class="go label">{s.soon ? 'Read the outline →' : 'Start →'}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="after">
      <div>

        <h2>Put The Ideas To Work.</h2>
        <p>
          Once you know what a program is, the next step is a real computer. Pick one, meet it,
          then meet the language you will write it in. You can go now and come back to the number modules
          when you need them. If you are heading for assembly, Counting in Twos and Working the Bits
          are the ones it leans on most. And if you already think in variables and loops, skip
          straight to a machine.
        </p>
      </div>
      <div class="after-links">
        <a href="/systems">
          <span class="label">Pick a machine</span>
          <strong>Every computer we teach, and how to choose one →</strong>
        </a>
        <a href="/craft">
          <span class="label">The Craft</span>
          <strong>The techniques every game needs, whichever machine you pick →</strong>
        </a>
      </div>
    </section>
  </PageFrame>
</Layout>

<style>@layer blocks {
  .foundations-page {
    --accent: var(--sys);
  }

  /* An editorial opening, then each group as an open list between hairlines. */
  .hero { position: relative; overflow: hidden; margin-top: var(--h-space-4); padding: 32px 0 24px; color: var(--h-ink); }
  .hero .in { position: relative; z-index: 1; }
  .hero h1 { max-width: 26ch; margin: 0; padding: 0; color: var(--h-ink); font: italic 900 4rem/1.08 var(--h-font-mag); letter-spacing: -0.025em; }
  .hero h1 em { color: var(--h-spot-ink); font-weight: inherit; font-style: inherit; }
  .lede { max-width: var(--reading-width); margin: var(--h-space-4) 0 0; color: var(--h-ink-body); font: 1.25rem/1.6 var(--h-font-ui); }

  .foundation-groups { display: flex; flex-wrap: wrap; gap: 12px 32px; margin: 24px 0 40px; }
  .foundation-groups a { display: inline-flex; align-items: center; min-height: 44px; font-size: 1rem; text-decoration: underline; text-underline-offset: 5px; }

  .foundation-example { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; padding: 48px 0; border-top: 1px solid var(--h-line); }
  .foundation-example h2 { margin-bottom: 24px; font: italic 900 2.5rem/1.12 var(--h-font-mag); }
  .foundation-example h2 em { color: var(--h-spot-ink); font-style: inherit; }
  .foundation-example p { margin: 20px 0; }
  .foundation-example :global(p) { max-width: 65ch; }
  .foundation-example a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; }

  .group { margin-top: var(--space-7, 3rem); padding: 40px 0; border-top: 1px solid var(--h-line); }
  .group-head { margin: 0 0 var(--h-space-2); }
  .group-title { margin: 0; font-family: var(--h-font-ui); font-size: 1.5rem; font-weight: 700; }
  .group-strap { max-width: var(--reading-width); margin: 16px 0 0; color: var(--h-ink-muted); }
  .grid { margin: var(--h-space-4) 0 0; padding: 0; list-style: none; }
  .card { display: block; padding: 24px 0; border-top: 1px solid var(--h-line); color: var(--h-ink); text-decoration: none; }
  .card h3 { margin: var(--h-space-2) 0; color: var(--h-ink); font: 700 1.5rem/1.3 var(--h-font-ui); }
  .desc { max-width: 70ch; margin: 0 0 var(--h-space-4); color: var(--h-ink-muted); font: 1.25rem/1.6 var(--h-font-ui); }
  .soon { display: inline-block; margin-left: var(--h-space-2); padding: 1px 5px; border: 2px solid var(--h-line); color: var(--h-ink-muted); font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; letter-spacing: normal; text-transform: none; vertical-align: middle; }
  .go { color: var(--accent); }

  .after {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
    gap: var(--h-space-6);
    align-items: center;
    margin-top: var(--h-space-8);
    padding: var(--h-space-6);
    border-top: 1px solid var(--h-line);
  }
  .after h2 { margin: var(--h-space-2) 0; color: var(--h-ink); font-size: 1.35rem; }
  .after p { margin: 0; color: var(--h-ink-muted); line-height: 1.6; }
  .after-links { display: grid; gap: var(--h-space-3); }
  .after-links a {
    display: flex;
    flex-direction: column;
    gap: var(--h-space-2);
    padding: var(--h-space-4);
    border: 3px solid var(--h-line);
    background: var(--h-page);
    color: var(--h-ink);
    text-decoration: none;
    transition: border-color var(--transition-base);
  }
  .after-links a:hover, .after-links a:focus-visible { border-color: var(--accent); outline: none; }
  .after-links span { color: var(--h-ink-muted); }
  .after-links strong { color: var(--accent); }

  @media (max-width: 850px) {
    .hero h1 { font-size: 3rem; }
    .foundation-example { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 40px 0; }
  }
  @media (max-width: 640px) {
    .after { grid-template-columns: 1fr; }
  }
}
@layer blocks {
  @media print { :global(#main-content > .foundations-page) { padding: 0; } }
}
</style>
