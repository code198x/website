---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getSection } from '../lib/sections';

const section = getSection('foundations');

const ORDER = ['general-programming', 'numbers-and-bits'];
const subtracks = (await getCollection('module-pages'))
  .filter((e) => e.id.startsWith('foundations/'))
  .map((e) => ({
    slug: e.id.replace(/\/index$/, '').replace(/^foundations\//, ''),
    title: e.data.title,
    description: e.data.description ?? '',
  }))
  .sort((a, b) => {
    const ia = ORDER.indexOf(a.slug);
    const ib = ORDER.indexOf(b.slug);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.title.localeCompare(b.title);
  });

const accent = section?.color ?? '#64748b';
---

<Layout
  title="Foundations | Code Like It's 198x"
  description="The ideas every machine and language shares — taught once, before you pick one. Learn to program at all, then learn how the machine counts."
  platformColor={accent}
>
  <div class="wrap">
    <header class="fhead">
      <p class="eyebrow">Foundations</p>
      <h1>The ideas every machine and language shares.</h1>
      <div class="rule"></div>
      <p class="lede">Before you pick a machine, before you pick a language, there are
        things true on all of them. These short primers teach them once, language-neutral,
        and shown running in Sinclair BASIC so nothing stays abstract. They're the on-ramp
        before the on-ramp — start here and everything downstream gets easier.</p>
    </header>

    <ol class="grid">
      {subtracks.map((s, i) => (
        <li>
          <a class="card" href={`/foundations/${s.slug}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p class="desc">{s.description}</p>
            <span class="go">Start →</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style define:vars={{ accent }}>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-6) var(--space-6) var(--space-16); }
  .fhead { margin-bottom: var(--space-10); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .fhead h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.04; margin: var(--space-2) 0 0; color: var(--color-text); max-width: 18ch; }
  .rule { height: 6px; width: 160px; max-width: 70%; background: var(--accent); margin: var(--space-3) 0 0; }
  .lede { font-size: 1.05rem; max-width: 70ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-5); }
  .card { display: block; height: 100%; padding: var(--space-5); background: var(--color-surface); border: 2px solid var(--color-border); border-left: 6px solid var(--accent); text-decoration: none; transition: border-color var(--transition-base), transform var(--transition-base); }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .num { font-family: var(--font-family-mono); font-size: 0.8rem; font-weight: 700; color: var(--accent); }
  .card h2 { font-size: 1.4rem; margin: var(--space-1) 0 var(--space-2); color: var(--color-text); }
  .desc { font-size: 0.95rem; color: var(--color-text-secondary); margin: 0 0 var(--space-4); }
  .go { font-family: var(--font-family-mono); font-size: 0.8rem; font-weight: 600; color: var(--accent); }

  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
