---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getSection } from '../lib/sections';

const section = getSection('foundations');

const ORDER = ['general-programming', 'numbers-and-bits'];
const subtracks = (await getCollection('module-pages'))
  .filter((e) => e.id.startsWith('foundations/'))
  .map((e) => ({
    slug: e.id.replace(/\/index$/, '').replace(/^foundations\//, ''),
    title: e.data.title,
    description: e.data.description ?? '',
  }))
  .sort((a, b) => {
    const ia = ORDER.indexOf(a.slug);
    const ib = ORDER.indexOf(b.slug);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.title.localeCompare(b.title);
  });

const accent = section?.color ?? '#0d9488';
---

<Layout
  title="Foundations | Code Like It's 198x"
  description="The ideas every machine and language shares — taught once, before you pick one. Learn to program at all, then learn how the machine counts."
  platformColor={accent}
>
  <div class="wrap" style={`--sys: ${accent};`}>
    <section class="hero">
      <div class="ghost" aria-hidden="true"><span>Foundations</span></div>
      <div class="in">
        <p class="eyebrow">Foundations</p>
        <h1>The ideas every machine and language shares.</h1>
        <div class="rule"></div>
        <p class="lede">Before you pick a machine, before you pick a language, there are
          things true on all of them. These short primers teach them once, language-neutral,
          and shown running in Sinclair BASIC so nothing stays abstract. They're the on-ramp
          before the on-ramp — start here and everything downstream gets easier.</p>
      </div>
    </section>

    <ol class="grid">
      {subtracks.map((s, i) => (
        <li>
          <a class="card" href={`/foundations/${s.slug}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p class="desc">{s.description}</p>
            <span class="go">Start →</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .wrap {
    --accent: var(--sys);
    max-width: var(--container-max-width); margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-16);
  }
  :global(:root[data-theme="dark"]) .wrap { --accent: color-mix(in srgb, var(--sys) 64%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .wrap { --accent: color-mix(in srgb, var(--sys) 64%, white); }
  }

  /* hero */
  .hero { position: relative; overflow: hidden; margin-top: var(--space-4); padding: var(--space-8) 0 var(--space-8); }
  .ghost { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; pointer-events: none; overflow: hidden; z-index: 0; }
  .ghost span {
    font-family: var(--font-family-script); font-weight: 700;
    font-size: clamp(110px, 22vw, 260px); line-height: 0.7;
    color: var(--accent); opacity: 0.08; transform: rotate(-4deg);
    margin-right: -8px; white-space: nowrap;
  }
  .hero .in { position: relative; z-index: 1; }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .hero h1 {
    font-family: var(--font-family-script); font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4rem); line-height: 0.92;
    margin: var(--space-2) 0 0; color: var(--color-text); max-width: 18ch;
  }
  .rule { height: 9px; width: 200px; max-width: 70%; background: var(--accent); position: relative; margin: var(--space-3) 0 0; }
  .rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 22%; background: var(--color-text); opacity: 0.22; }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 70ch; margin: var(--space-4) 0 0; color: var(--color-text); }

  /* cards — house style */
  .grid { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-5); }
  .card {
    display: flex; flex-direction: column;
    padding: var(--space-6); background: var(--color-surface);
    border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky);
    text-decoration: none; color: var(--color-text);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .card:hover, .card:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .num { font-family: var(--font-family-script); font-weight: 700; font-size: 2.4rem; line-height: 0.8; color: var(--accent); }
  .card h2 { font-size: 1.4rem; margin: var(--space-2) 0 var(--space-2); color: var(--color-text); }
  .desc { font-size: 0.95rem; line-height: 1.55; color: var(--color-text-secondary); margin: 0 0 var(--space-4); flex: 1; }
  .go { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; color: var(--accent); }

  @media (max-width: 640px) {
    .wrap { padding: var(--space-4) var(--space-4) var(--space-12); }
  }
</style>
