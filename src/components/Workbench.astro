---
/**
 * Interactive assembly workbench — code editor + assembler + emulator.
 *
 * Usage in lessons:
 *   <Workbench system="sinclair-zx-spectrum" language="z80" origin={32768}
 *     src="/code-samples/spectrum/starfield/starfield.asm" />
 *
 * Or with inline source:
 *   <Workbench system="sinclair-zx-spectrum" language="z80" origin={32768}>
 *     {`ORG $8000
 *     LD A, 2
 *     OUT ($FE), A
 *     JR $-2`}
 *   </Workbench>
 */

interface Props {
  system: string;
  language: string;
  src?: string;
  origin?: number;
  width?: number;
  height?: number;
  caption?: string;
}

const {
  system,
  language,
  src,
  origin = 32768,
  width = 960,
  height = 480,
  caption,
} = Astro.props;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<figure class="workbench-figure">
  <emu198x-workbench
    system={system}
    language={language}
    src={src}
    origin={origin.toString()}
    width={width.toString()}
    height={height.toString()}
  ><slot /></emu198x-workbench>
  {caption && <figcaption set:html={inlineMarkdown(caption)} />}
</figure>

<script is:inline src="/emulator/emulator.js"></script>
<script is:inline src="/emulator/workbench.js"></script>

<style>
  .workbench-figure {
    margin: 1.5rem 0;
  }
  .workbench-figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #555);
    text-align: center;
  }
</style>
