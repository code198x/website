---
import DirectorySearch from './DirectorySearch.astro';
import DirectoryStatus from './DirectoryStatus.astro';
import { getCollection } from 'astro:content';
import { getPlatformsForPatternLibrary } from '../lib/platforms';
import { getPopulatedPatternCategories, getPatternDifficulties } from '../lib/categories';
interface Props { platform?: string; category?: string; difficulty?: string }
const {platform = '', category = '', difficulty = ''} = Astro.props;
const [entries, platforms, categories, difficulties] = await Promise.all([getCollection('patterns'), getPlatformsForPatternLibrary(), getPopulatedPatternCategories(), getPatternDifficulties()]);
const patterns = entries.sort((a,b) => a.data.title.localeCompare(b.data.title));
const names = Object.fromEntries(platforms.map(p => [p.slug,p.name]));
const categoryNames = Object.fromEntries(categories.map(c => [c.id,c.data.name]));
const matches = (entry: typeof patterns[number]) => (!platform || entry.data.platform === platform) && (!category || entry.data.category === category) && (!difficulty || entry.data.difficulty === difficulty);
---
<section class="pattern-directory" id="directory" data-pattern-directory>
  <h2>Find your technique.</h2>
  <form class="pattern-filters" role="search" aria-label="Pattern Library" hidden>
    <DirectorySearch id="pattern-search" class="pattern-query" label="Search patterns" placeholder="Try sprites, sound or collision" />
    <label>Machine<select name="platform"><option value="">All machines</option>{platforms.map(p => <option value={p.slug} selected={p.slug === platform}>{p.name}</option>)}</select></label>
    <label>Subject<select name="category"><option value="">All subjects</option>{categories.map(c => <option value={c.id} selected={c.id === category}>{c.data.name}</option>)}</select></label>
    <label>Difficulty<select name="difficulty"><option value="">All levels</option>{difficulties.map(d => <option value={d.id} selected={d.id === difficulty}>{d.data.name}</option>)}</select></label>
    <button type="button" data-clear>Clear filters</button>
  </form>
  <noscript><p>Browse by machine: {platforms.map(p => <a class="pattern-browse-link" href={`/patterns/platform/${p.slug}/`}>{p.name}</a>)}. <a href="/patterns/">See all patterns</a>.</p></noscript>
  <DirectoryStatus class="pattern-result-count"><span data-count>{patterns.filter(matches).length}</span> patterns</DirectoryStatus>
  <p data-empty hidden>No patterns match these filters. Try a broader search or clear the filters.</p>
  <ul class="pattern-results">
    {patterns.map(entry => <li hidden={!matches(entry)} data-pattern data-platform={entry.data.platform} data-category={entry.data.category} data-difficulty={entry.data.difficulty} data-search={`${entry.data.title} ${entry.data.summary} ${entry.data.tags.join(' ')} ${names[entry.data.platform]} ${entry.id.includes('/assembly/') ? 'assembly' : entry.id.includes('/basic/') ? 'BASIC' : ''}`.toLowerCase()}>
      <div><h3><a href={`/patterns/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></div>
      <div class="pattern-row-meta"><span>{names[entry.data.platform]}</span><span>{categoryNames[entry.data.category]} · {entry.data.difficulty}</span><span>{entry.id.includes('/assembly/') ? 'Assembly' : entry.id.includes('/basic/') ? 'BASIC' : 'Shared technique'}</span></div>
    </li>)}
  </ul>
</section>
<script>
import { bindDirectoryReset } from '../lib/directory-controls';
function initPatternDirectories() {
  document.querySelectorAll<HTMLElement>('[data-pattern-directory]').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const form = root.querySelector<HTMLFormElement>('form')!;
    const query = form.elements.namedItem('q') as HTMLInputElement;
    const facets = ['platform','category','difficulty'] as const;
    const select = (name: string) => form.elements.namedItem(name) as HTMLSelectElement;
    const params = new URLSearchParams(location.search);
    for (const name of facets) {
      const value = params.get(name);
      if (value !== null && [...select(name).options].some(option => option.value === value)) select(name).value = value;
    }
    query.value = params.get('q') ?? '';
    const update = (persist = true) => {
      const words = query.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let count = 0;
      root.querySelectorAll<HTMLElement>('[data-pattern]').forEach(row => {
        row.hidden = !words.every(word => row.dataset.search!.includes(word)) || facets.some(name => select(name).value && row.dataset[name] !== select(name).value);
        if (!row.hidden) count++;
      });
      root.querySelector('[data-count]')!.textContent = String(count);
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = count !== 0;
      if (persist) {
        const url = new URL(location.href);
        // Explicit empty facet values override a facet route's default when a link is shared.
        for (const name of facets) url.searchParams.set(name, select(name).value);
        if (query.value.trim()) url.searchParams.set('q',query.value.trim()); else url.searchParams.delete('q');
        history.replaceState(history.state,'',url);
      }
    };
    form.hidden = false;
    form.addEventListener('submit',event => event.preventDefault());
    form.addEventListener('input',() => update());
    bindDirectoryReset(root, query, () => { facets.forEach(name => select(name).value = ''); update(); });
    update(false);
  });
}
initPatternDirectories();
document.addEventListener('astro:page-load',initPatternDirectories);
</script>
