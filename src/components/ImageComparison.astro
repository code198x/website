---
export interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  caption?: string;
  system?: "commodore-64" | "sinclair-zx-spectrum" | "nintendo-entertainment-system" | "amiga";
}

const {
  beforeSrc,
  afterSrc,
  beforeAlt,
  afterAlt,
  beforeLabel = "Before",
  afterLabel = "After",
  caption,
  system = "commodore-64"
} = Astro.props;

const systemColors = {
  "commodore-64": "#6c5ce7",
  "sinclair-zx-spectrum": "#e17055",
  "nintendo-entertainment-system": "#e84393",
  "amiga": "#fdcb6e"
};

const borderColor = systemColors[system];
---

<figure class="image-comparison" data-system={system}>
  <div class="comparison-container">
    <div class="comparison-side">
      <div class="comparison-label before-label">{beforeLabel}</div>
      <div class="screenshot-frame">
        <div class="screenshot-scanlines"></div>
        <img src={beforeSrc} alt={beforeAlt} class="comparison-image" loading="lazy" />
        <div class="screenshot-overlay"></div>
      </div>
    </div>

    <div class="comparison-divider">
      <div class="divider-line"></div>
      <div class="divider-icon">⟶</div>
      <div class="divider-line"></div>
    </div>

    <div class="comparison-side">
      <div class="comparison-label after-label">{afterLabel}</div>
      <div class="screenshot-frame">
        <div class="screenshot-scanlines"></div>
        <img src={afterSrc} alt={afterAlt} class="comparison-image" loading="lazy" />
        <div class="screenshot-overlay"></div>
      </div>
    </div>
  </div>

  {caption && (
    <figcaption class="comparison-caption">
      {caption}
    </figcaption>
  )}
</figure>

<style define:vars={{ borderColor }}>
  .image-comparison {
    margin: var(--space-xl, 2.5rem) 0;
  }

  .comparison-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-md, 1.5rem);
    align-items: center;
  }

  .comparison-side {
    position: relative;
  }

  .comparison-label {
    position: absolute;
    top: -var(--space-sm, 1rem);
    left: 50%;
    transform: translateX(-50%);
    background: var(--borderColor);
    color: white;
    padding: var(--space-xs, 0.5rem) var(--space-sm, 1rem);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-bold, 700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .before-label {
    background: var(--color-warning, #ffc107);
    color: var(--color-warning-dark, #b8860b);
  }

  .after-label {
    background: var(--color-success, #10b981);
    color: white;
  }

  .screenshot-frame {
    position: relative;
    border: 2px solid var(--borderColor);
    border-radius: var(--radius-md, 6px);
    overflow: hidden;
    background: #000;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .screenshot-frame:hover {
    transform: scale(1.05);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .comparison-image {
    width: 100%;
    height: auto;
    display: block;
    filter: contrast(1.1) brightness(0.95);
  }

  .screenshot-scanlines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
      );
    pointer-events: none;
    z-index: 2;
    opacity: 0.6;
  }

  .screenshot-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 0%,
      transparent 70%,
      rgba(0, 0, 0, 0.15) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .comparison-divider {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs, 0.5rem);
    padding: var(--space-sm, 1rem) 0;
  }

  .divider-line {
    width: 2px;
    height: 20px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--borderColor) 50%,
      transparent 100%
    );
  }

  .divider-icon {
    font-size: 1.5rem;
    color: var(--borderColor);
    text-shadow: 0 0 8px currentColor;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.1); }
  }

  .comparison-caption {
    margin-top: var(--space-md, 1.5rem);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #b0b0c0);
    text-align: center;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .comparison-container {
      grid-template-columns: 1fr;
      gap: var(--space-lg, 2rem);
    }

    .comparison-divider {
      flex-direction: row;
      justify-content: center;
    }

    .divider-line {
      width: 20px;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        var(--borderColor) 50%,
        transparent 100%
      );
    }

    .divider-icon {
      transform: rotate(90deg);
    }

    .image-comparison {
      margin: var(--space-lg, 2rem) -var(--space-sm, 1rem);
    }

    .screenshot-frame {
      border-radius: 0;
    }

    .comparison-caption {
      padding: 0 var(--space-sm, 1rem);
    }
  }

  /* Animation for the entire component */
  .image-comparison {
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>