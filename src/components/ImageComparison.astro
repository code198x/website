---
/**
 * ImageComparison - Before/after slider to compare two images
 *
 * Usage:
 *   import ImageComparison from '@components/ImageComparison.astro';
 *
 *   <ImageComparison
 *     before="/images/unit-07/screenshot.png"
 *     after="/images/unit-08/screenshot.png"
 *     beforeLabel="Before: Basic menu"
 *     afterLabel="After: Styled menu"
 *   />
 */

interface Props {
  before: string;        // Path to "before" image
  after: string;         // Path to "after" image
  beforeLabel?: string;  // Label for before image
  afterLabel?: string;   // Label for after image
  beforeAlt?: string;    // Alt text for before image
  afterAlt?: string;     // Alt text for after image
  initialPosition?: number;  // Initial slider position (0-100, default: 50)
}

const {
  before,
  after,
  beforeLabel = 'Before',
  afterLabel = 'After',
  beforeAlt = beforeLabel,
  afterAlt = afterLabel,
  initialPosition = 50
} = Astro.props;

const id = `comparison-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="image-comparison" id={id}>
  <div class="comparison-container">
    <!-- After image (background) -->
    <img src={after} alt={afterAlt} class="after-image" loading="lazy" />

    <!-- Before image (overlay, clipped) -->
    <div class="before-container" style={`width: ${initialPosition}%`}>
      <img src={before} alt={beforeAlt} class="before-image" loading="lazy" />
    </div>

    <!-- Slider control -->
    <div class="slider" style={`left: ${initialPosition}%`}>
      <div class="slider-line"></div>
      <div class="slider-handle">
        <span class="slider-arrow left">&lsaquo;</span>
        <span class="slider-arrow right">&rsaquo;</span>
      </div>
    </div>

    <!-- Labels -->
    <span class="label before-label">{beforeLabel}</span>
    <span class="label after-label">{afterLabel}</span>
  </div>
</figure>

<style>
  .image-comparison {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  .comparison-container {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    cursor: ew-resize;
    user-select: none;
    touch-action: pan-y;
  }

  .after-image,
  .before-image {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .before-container {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
  }

  .before-image {
    position: absolute;
    top: 0;
    left: 0;
    width: auto;
    min-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
  }

  .slider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    transform: translateX(-50%);
    z-index: 10;
  }

  .slider-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: white;
    transform: translateX(-50%);
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }

  .slider-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease;
  }

  .comparison-container:hover .slider-handle,
  .comparison-container:active .slider-handle {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .slider-arrow {
    color: #333;
    font-size: 1.25rem;
    font-weight: bold;
    line-height: 1;
  }

  .slider-arrow.left {
    margin-right: 2px;
  }

  .slider-arrow.right {
    margin-left: 2px;
  }

  .label {
    position: absolute;
    bottom: 12px;
    padding: 4px 12px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 4px;
    pointer-events: none;
  }

  .before-label {
    left: 12px;
  }

  .after-label {
    right: 12px;
  }
</style>

<script define:vars={{ id }}>
  const container = document.getElementById(id);
  if (container) {
    const comparisonContainer = container.querySelector('.comparison-container');
    const beforeContainer = container.querySelector('.before-container');
    const slider = container.querySelector('.slider');

    if (comparisonContainer && beforeContainer && slider) {
      let isDragging = false;

      const updatePosition = (clientX) => {
        const rect = comparisonContainer.getBoundingClientRect();
        let position = ((clientX - rect.left) / rect.width) * 100;
        position = Math.max(0, Math.min(100, position));

        beforeContainer.style.width = `${position}%`;
        slider.style.left = `${position}%`;
      };

      const startDrag = (e) => {
        isDragging = true;
        comparisonContainer.style.cursor = 'grabbing';
      };

      const endDrag = () => {
        isDragging = false;
        comparisonContainer.style.cursor = 'ew-resize';
      };

      const handleMove = (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        updatePosition(clientX);
      };

      // Mouse events
      comparisonContainer.addEventListener('mousedown', (e) => {
        startDrag(e);
        updatePosition(e.clientX);
      });
      document.addEventListener('mousemove', handleMove);
      document.addEventListener('mouseup', endDrag);

      // Touch events
      comparisonContainer.addEventListener('touchstart', (e) => {
        startDrag(e);
        updatePosition(e.touches[0].clientX);
      });
      document.addEventListener('touchmove', handleMove, { passive: false });
      document.addEventListener('touchend', endDrag);

      // Keyboard accessibility
      slider.setAttribute('tabindex', '0');
      slider.setAttribute('role', 'slider');
      slider.setAttribute('aria-valuemin', '0');
      slider.setAttribute('aria-valuemax', '100');
      slider.setAttribute('aria-valuenow', '50');

      slider.addEventListener('keydown', (e) => {
        const current = parseFloat(slider.style.left) || 50;
        let newPosition = current;

        if (e.key === 'ArrowLeft') newPosition = Math.max(0, current - 5);
        if (e.key === 'ArrowRight') newPosition = Math.min(100, current + 5);

        if (newPosition !== current) {
          e.preventDefault();
          beforeContainer.style.width = `${newPosition}%`;
          slider.style.left = `${newPosition}%`;
          slider.setAttribute('aria-valuenow', String(Math.round(newPosition)));
        }
      });
    }
  }
</script>
