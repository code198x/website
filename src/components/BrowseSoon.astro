---
/**
 * BrowseSoon — honest scaffold for /browse/ facets whose data isn't tagged yet
 * (genre, technique, difficulty). A real page, never a 404; explains what the
 * cut will surface and points at what exists today.
 */
interface Props { crumb: string[]; title: string; intro: string; note: string; links: Array<{ href: string; label: string }> }
const { crumb, title, intro, note, links } = Astro.props;
---

<div class="wrap">
  <div class="crumb">
    {crumb.map((p, i) => (
      <>{i > 0 && <span class="sep">›</span>}{i === 0 ? <a href="/browse">{p}</a> : <span>{p}</span>}</>
    ))}
  </div>
  <div class="vhead">
    <h1>{title}</h1>
    <div class="herorule"></div>
    <p class="intro">{intro}</p>
  </div>

  <div class="soon">
    <span class="badge">Coming as content is tagged</span>
    <p>{note}</p>
    <div class="links">
      {links.map(l => <a href={l.href}>{l.label} →</a>)}
    </div>
  </div>
</div>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-4) var(--space-6) var(--space-16); }
  .crumb { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); }
  .crumb a { color: var(--color-text-secondary); text-decoration: none; }
  .crumb a:hover { color: var(--color-house-2); }
  .crumb .sep { color: var(--color-text-muted); }
  .vhead { margin: var(--space-3) 0 var(--space-8); }
  .vhead h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(2.8rem, 7vw, 4.4rem); line-height: 0.86; margin: 0; color: var(--color-text); }
  .herorule { height: 9px; width: 180px; max-width: 70%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .intro { font-size: 1rem; max-width: 70ch; margin: var(--space-3) 0 0; color: var(--color-text-secondary); }

  .soon { border: 3px dashed var(--color-border); background: var(--color-surface); padding: var(--space-8); }
  .badge { font-family: var(--font-family-mono); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-house-2); border: 2px solid var(--color-house-2); padding: 2px 8px; }
  .soon p { font-size: 1rem; color: var(--color-text); max-width: 64ch; margin: var(--space-4) 0 0; line-height: 1.6; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-5); }
  .links a { font-family: var(--font-family-mono); font-size: 0.8rem; font-weight: 700; color: var(--color-house-2); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>
