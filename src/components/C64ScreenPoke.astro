---
// Simple C64 screen memory visualizer component
---

<div class="c64-screen-poker">
  <div class="controls">
    <h3>C64 Screen Memory Explorer</h3>
    <p>Try these POKE commands to see pixels light up:</p>
    <div class="poke-input">
      <label>
        POKE
        <input type="number" id="address" min="1024" max="2023" value="1024" />
        ,
        <input type="number" id="value" min="0" max="255" value="1" />
      </label>
      <button id="poke-btn">POKE!</button>
    </div>
    <div class="examples">
      <button data-addr="1024" data-val="1">POKE 1024,1 (Letter A)</button>
      <button data-addr="1024" data-val="2">POKE 1024,2 (Letter B)</button>
      <button data-addr="1064" data-val="42">POKE 1064,42 (Asterisk)</button>
    </div>
  </div>

  <div class="screen-display">
    <canvas id="c64-screen" width="320" height="200"></canvas>
    <div class="memory-info">
      <span id="mem-info">Screen Memory: $0400-$07E7</span>
    </div>
  </div>
</div>

<style>
  .c64-screen-poker {
    background: #3e31a2; /* C64 blue */
    border: 4px solid #7c70da; /* C64 light blue */
    border-radius: 8px;
    padding: 1rem;
    font-family: "Courier New", monospace;
  }

  .controls {
    background: #352879; /* C64 dark blue */
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .controls h3 {
    color: #7c70da; /* C64 light blue */
    margin: 0 0 0.5rem 0;
  }

  .controls p {
    color: #b3a8f7; /* C64 lighter blue */
    margin: 0.5rem 0;
  }

  .poke-input {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 1rem 0;
  }

  .poke-input label {
    color: #fff;
    font-size: 1.2rem;
  }

  .poke-input input {
    width: 80px;
    padding: 0.25rem;
    background: #1a1a2e;
    color: #7ef39e; /* C64 green */
    border: 2px solid #7c70da;
    font-family: inherit;
  }

  #poke-btn {
    padding: 0.5rem 1rem;
    background: #68d391; /* C64 green */
    color: #1a1a2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
  }

  #poke-btn:hover {
    background: #7ef39e;
    transform: scale(1.05);
  }

  .examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .examples button {
    padding: 0.25rem 0.5rem;
    background: #554d9b;
    color: #b3a8f7;
    border: 1px solid #7c70da;
    border-radius: 2px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .examples button:hover {
    background: #7c70da;
    color: #fff;
  }

  .screen-display {
    position: relative;
    background: #000;
    padding: 1rem;
    border-radius: 4px;
  }

  #c64-screen {
    width: 100%;
    max-width: 640px;
    height: auto;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    border: 2px solid #7c70da;
  }

  .memory-info {
    margin-top: 0.5rem;
    color: #68d391;
    font-size: 0.875rem;
    text-align: center;
  }
</style>

<script>
  // C64 character ROM data - PETSCII screen codes
  // Note: These are screen codes, not ASCII values!
  const C64_CHARSET = {
    // Special characters and numbers
    0: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00], // @
    1: [0x18, 0x3c, 0x66, 0x7e, 0x66, 0x66, 0x66, 0x00], // A
    2: [0x7c, 0x66, 0x66, 0x7c, 0x66, 0x66, 0x7c, 0x00], // B
    3: [0x3c, 0x66, 0x60, 0x60, 0x60, 0x66, 0x3c, 0x00], // C
    4: [0x78, 0x6c, 0x66, 0x66, 0x66, 0x6c, 0x78, 0x00], // D
    5: [0x7e, 0x60, 0x60, 0x78, 0x60, 0x60, 0x7e, 0x00], // E
    6: [0x7e, 0x60, 0x60, 0x78, 0x60, 0x60, 0x60, 0x00], // F
    7: [0x3c, 0x66, 0x60, 0x6e, 0x66, 0x66, 0x3c, 0x00], // G
    8: [0x66, 0x66, 0x66, 0x7e, 0x66, 0x66, 0x66, 0x00], // H
    9: [0x3c, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3c, 0x00], // I
    10: [0x1e, 0x0c, 0x0c, 0x0c, 0x0c, 0x6c, 0x38, 0x00], // J
    11: [0x66, 0x6c, 0x78, 0x70, 0x78, 0x6c, 0x66, 0x00], // K
    12: [0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x7e, 0x00], // L
    13: [0x63, 0x77, 0x7f, 0x6b, 0x63, 0x63, 0x63, 0x00], // M
    14: [0x66, 0x76, 0x7e, 0x7e, 0x6e, 0x66, 0x66, 0x00], // N
    15: [0x3c, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3c, 0x00], // O
    16: [0x7c, 0x66, 0x66, 0x7c, 0x60, 0x60, 0x60, 0x00], // P
    17: [0x3c, 0x66, 0x66, 0x66, 0x66, 0x3c, 0x0e, 0x00], // Q
    18: [0x7c, 0x66, 0x66, 0x7c, 0x78, 0x6c, 0x66, 0x00], // R
    19: [0x3c, 0x66, 0x60, 0x3c, 0x06, 0x66, 0x3c, 0x00], // S
    20: [0x7e, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00], // T
    21: [0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3c, 0x00], // U
    22: [0x66, 0x66, 0x66, 0x66, 0x66, 0x3c, 0x18, 0x00], // V
    23: [0x63, 0x63, 0x63, 0x6b, 0x7f, 0x77, 0x63, 0x00], // W
    24: [0x66, 0x66, 0x3c, 0x18, 0x3c, 0x66, 0x66, 0x00], // X
    25: [0x66, 0x66, 0x66, 0x3c, 0x18, 0x18, 0x18, 0x00], // Y
    26: [0x7e, 0x06, 0x0c, 0x18, 0x30, 0x60, 0x7e, 0x00], // Z
    27: [0x3c, 0x30, 0x30, 0x30, 0x30, 0x30, 0x3c, 0x00], // [
    28: [0x0c, 0x12, 0x30, 0x7c, 0x30, 0x62, 0xfc, 0x00], // £ (British pound)
    29: [0x3c, 0x0c, 0x0c, 0x0c, 0x0c, 0x0c, 0x3c, 0x00], // ]
    30: [0x00, 0x18, 0x3c, 0x7e, 0x18, 0x18, 0x18, 0x18], // ↑ (up arrow)
    31: [0x00, 0x10, 0x30, 0x7f, 0x7f, 0x30, 0x10, 0x00], // ← (left arrow)
    32: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00], // Space
    33: [0x18, 0x18, 0x18, 0x18, 0x00, 0x00, 0x18, 0x00], // !
    34: [0x66, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00], // "
    35: [0x66, 0x66, 0xff, 0x66, 0xff, 0x66, 0x66, 0x00], // #
    36: [0x18, 0x3e, 0x60, 0x3c, 0x06, 0x7c, 0x18, 0x00], // $
    37: [0x62, 0x66, 0x0c, 0x18, 0x30, 0x66, 0x46, 0x00], // %
    38: [0x3c, 0x66, 0x3c, 0x38, 0x67, 0x66, 0x3f, 0x00], // &
    39: [0x06, 0x0c, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00], // '
    40: [0x0c, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0c, 0x00], // (
    41: [0x30, 0x18, 0x0c, 0x0c, 0x0c, 0x18, 0x30, 0x00], // )
    42: [0x00, 0x66, 0x3c, 0xff, 0x3c, 0x66, 0x00, 0x00], // *
    43: [0x00, 0x18, 0x18, 0x7e, 0x18, 0x18, 0x00, 0x00], // +
    44: [0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30], // ,
    45: [0x00, 0x00, 0x00, 0x7e, 0x00, 0x00, 0x00, 0x00], // -
    46: [0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00], // .
    47: [0x00, 0x03, 0x06, 0x0c, 0x18, 0x30, 0x60, 0x00], // /
    48: [0x3c, 0x66, 0x6e, 0x76, 0x66, 0x66, 0x3c, 0x00], // 0
    49: [0x18, 0x18, 0x38, 0x18, 0x18, 0x18, 0x7e, 0x00], // 1
    50: [0x3c, 0x66, 0x06, 0x0c, 0x30, 0x60, 0x7e, 0x00], // 2
    51: [0x3c, 0x66, 0x06, 0x1c, 0x06, 0x66, 0x3c, 0x00], // 3
    52: [0x06, 0x0e, 0x1e, 0x66, 0x7f, 0x06, 0x06, 0x00], // 4
    53: [0x7e, 0x60, 0x7c, 0x06, 0x06, 0x66, 0x3c, 0x00], // 5
    54: [0x3c, 0x66, 0x60, 0x7c, 0x66, 0x66, 0x3c, 0x00], // 6
    55: [0x7e, 0x66, 0x0c, 0x18, 0x18, 0x18, 0x18, 0x00], // 7
    56: [0x3c, 0x66, 0x66, 0x3c, 0x66, 0x66, 0x3c, 0x00], // 8
    57: [0x3c, 0x66, 0x66, 0x3e, 0x06, 0x66, 0x3c, 0x00], // 9
    58: [0x00, 0x00, 0x18, 0x00, 0x00, 0x18, 0x00, 0x00], // :
    59: [0x00, 0x00, 0x18, 0x00, 0x00, 0x18, 0x18, 0x30], // ;
    60: [0x0e, 0x18, 0x30, 0x60, 0x30, 0x18, 0x0e, 0x00], // <
    61: [0x00, 0x00, 0x7e, 0x00, 0x7e, 0x00, 0x00, 0x00], // =
    62: [0x70, 0x18, 0x0c, 0x06, 0x0c, 0x18, 0x70, 0x00], // >
    63: [0x3c, 0x66, 0x06, 0x0c, 0x18, 0x00, 0x18, 0x00], // ?
  };

  class C64ScreenSimulator {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d");
      this.screenMemory = new Uint8Array(1000); // 40x25 characters
      this.colorMemory = new Uint8Array(1000);

      // C64 colors
      this.colors = [
        "#000000",
        "#FFFFFF",
        "#880000",
        "#AAFFEE",
        "#CC44CC",
        "#00CC55",
        "#0000AA",
        "#EEEE77",
        "#DD8855",
        "#664400",
        "#FF7777",
        "#333333",
        "#777777",
        "#AAFF66",
        "#0088FF",
        "#BBBBBB",
      ];

      this.clear();
    }

    clear() {
      this.ctx.fillStyle = this.colors[6]; // Blue background
      this.ctx.fillRect(0, 0, 320, 200);

      // Initialize with spaces
      this.screenMemory.fill(32);
      this.colorMemory.fill(14); // Light blue text
    }

    poke(address, value) {
      if (address >= 1024 && address <= 2023) {
        const offset = address - 1024;
        this.screenMemory[offset] = value;
        this.drawCharacter(offset);
        return true;
      }
      return false;
    }

    drawCharacter(offset) {
      const x = (offset % 40) * 8;
      const y = Math.floor(offset / 40) * 8;
      const charCode = this.screenMemory[offset];
      const color = this.colorMemory[offset];

      // Clear character position
      this.ctx.fillStyle = this.colors[6]; // Background
      this.ctx.fillRect(x, y, 8, 8);

      // Draw character if we have it
      const charData = C64_CHARSET[charCode] || C64_CHARSET[0];
      this.ctx.fillStyle = this.colors[color];

      for (let row = 0; row < 8; row++) {
        const byte = charData[row];
        for (let col = 0; col < 8; col++) {
          if (byte & (1 << (7 - col))) {
            this.ctx.fillRect(x + col, y + row, 1, 1);
          }
        }
      }
    }

    refresh() {
      for (let i = 0; i < 1000; i++) {
        this.drawCharacter(i);
      }
    }
  }

  // Initialize simulator when DOM is ready
  document.addEventListener("DOMContentLoaded", () => {
    const canvas = document.getElementById("c64-screen");
    const sim = new C64ScreenSimulator(canvas);

    // Handle POKE button
    document.getElementById("poke-btn").addEventListener("click", () => {
      const addr = parseInt(document.getElementById("address").value);
      const val = parseInt(document.getElementById("value").value);

      if (sim.poke(addr, val)) {
        document.getElementById("mem-info").textContent =
          `POKE ${addr},${"0x" + val.toString(16).toUpperCase()} - Character at position ${addr - 1024}`;
      } else {
        document.getElementById("mem-info").textContent =
          `Invalid address! Use 1024-2023 for screen memory`;
      }
    });

    // Handle example buttons
    document.querySelectorAll(".examples button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const addr = parseInt(btn.dataset.addr);
        const val = parseInt(btn.dataset.val);
        document.getElementById("address").value = addr;
        document.getElementById("value").value = val;
        document.getElementById("poke-btn").click();
      });
    });
  });
</script>
