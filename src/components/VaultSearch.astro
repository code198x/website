---
// Vault Search Component - Provides unified search across all vault pages
export interface Props {
  data: any[]; // The search data (can be passed in or loaded from collections)
  category?: string; // Optional: filter to specific category
  showCategoryFilter?: boolean;
  showTypeFilter?: boolean;
  showTagFilter?: boolean;
  showYearFilter?: boolean;
  showStatusFilter?: boolean;
  placeholder?: string;
}

const {
  data = [],
  category = null,
  showCategoryFilter = true,
  showTypeFilter = true,
  showTagFilter = true,
  showYearFilter = false,
  showStatusFilter = false,
  placeholder = "Search the vault..."
} = Astro.props;
---

<div class="vault-search-container">
  <!-- Search Bar -->
  <div class="search-bar">
    <input
      type="search"
      id="search-input"
      placeholder={placeholder}
      class="search-input"
      autocomplete="off"
    />
    <button type="button" id="search-button" class="search-button">
      <span>🔍</span>
      <span>Search</span>
    </button>
  </div>

  <!-- Filters -->
  <div class="search-filters">
    {showCategoryFilter && (
      <div class="filter-group">
        <label for="category-filter">Category:</label>
        <select id="category-filter" class="filter-select">
          <option value="all">All Categories</option>
        </select>
      </div>
    )}

    {showTypeFilter && (
      <div class="filter-group">
        <label for="type-filter">Type:</label>
        <select id="type-filter" class="filter-select">
          <option value="all">All Types</option>
        </select>
      </div>
    )}

    {showTagFilter && (
      <div class="filter-group">
        <label for="tag-filter">Tag:</label>
        <input
          type="text"
          id="tag-filter"
          placeholder="Filter by tag..."
          class="filter-input"
          list="tag-suggestions"
        />
        <datalist id="tag-suggestions"></datalist>
      </div>
    )}

    {showYearFilter && (
      <div class="filter-group">
        <label for="year-filter">Year:</label>
        <select id="year-filter" class="filter-select">
          <option value="all">All Years</option>
          <option value="1970">1970s</option>
          <option value="1980">1980s</option>
          <option value="1990">1990s</option>
          <option value="2000">2000s</option>
          <option value="unknown">Unknown</option>
        </select>
      </div>
    )}

    {showStatusFilter && (
      <div class="filter-group">
        <label for="status-filter">Status:</label>
        <select id="status-filter" class="filter-select">
          <option value="all">All Status</option>
          <option value="available">Available</option>
          <option value="coming">Coming Soon</option>
          <option value="draft">Draft</option>
        </select>
      </div>
    )}

    <button type="button" id="clear-filters" class="clear-filters" style="display: none;">
      Clear All
    </button>
  </div>

  <!-- Results Count -->
  <div id="results-count" class="results-count">
    Showing <span id="count-number">0</span> entries
  </div>

  <!-- Popular Tags (optional, shown when no filters active) -->
  <div id="popular-tags" class="popular-tags">
    <h3>Popular Tags</h3>
    <div id="tag-cloud" class="tag-cloud">
      <!-- Will be populated by JavaScript -->
    </div>
  </div>

  <!-- Results Grid -->
  <div id="results-grid" class="results-grid">
    <!-- Will be populated by JavaScript -->
  </div>
</div>

<!-- Load the VaultSearch module -->
<script src="/src/scripts/vault-search.js"></script>

<!-- Initialize with data -->
<script define:vars={{ data, category, showCategoryFilter, showTypeFilter, showTagFilter, showYearFilter, showStatusFilter }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Initialize search using the global VaultSearch class
    const search = new window.VaultSearch({
      data: data,
      container: document.getElementById('results-grid'),
      initialFilters: category ? { category: category } : {},
      onFilter: (filteredData, filters) => {
        // Update count
        const countEl = document.getElementById('count-number');
        if (countEl) countEl.textContent = filteredData.length;

        // Show/hide clear button
        const clearBtn = document.getElementById('clear-filters');
        const hasFilters = filters.search || filters.category !== 'all' ||
                          filters.type !== 'all' || filters.tag ||
                          filters.year !== 'all' || filters.status !== 'all';
        if (clearBtn) {
          clearBtn.style.display = hasFilters ? 'inline-block' : 'none';
        }

        // Show/hide popular tags
        const popularTags = document.getElementById('popular-tags');
        if (popularTags) {
          popularTags.style.display = hasFilters ? 'none' : 'block';
        }
      }
    });

    // Populate filter dropdowns
    const populateFilters = () => {
      // Category filter
      const categorySelect = document.getElementById('category-filter');
      if (categorySelect && showCategoryFilter) {
        const categories = search.getUniqueValues('c');
        categorySelect.innerHTML = '<option value="all">All Categories</option>' +
          categories.map(cat => {
            const name = search.getCategoryName(cat);
            return `<option value="${cat}">${name}</option>`;
          }).join('');
      }

      // Type filter
      const typeSelect = document.getElementById('type-filter');
      if (typeSelect && showTypeFilter) {
        const types = search.getUniqueValues('t');
        typeSelect.innerHTML = '<option value="all">All Types</option>' +
          types.map(type => {
            const name = type.charAt(0).toUpperCase() + type.slice(1).replace(/-/g, ' ');
            return `<option value="${type}">${name}</option>`;
          }).join('');
      }

      // Tag suggestions
      const tagDatalist = document.getElementById('tag-suggestions');
      if (tagDatalist && showTagFilter) {
        const tags = Object.keys(search.getTagCounts()).sort();
        tagDatalist.innerHTML = tags.map(tag =>
          `<option value="${tag}"></option>`
        ).join('');
      }

      // Popular tags cloud
      const tagCloud = document.getElementById('tag-cloud');
      if (tagCloud) {
        const tagCounts = search.getTagCounts();
        const topTags = Object.entries(tagCounts)
          .sort(([, a], [, b]) => b - a)
          .slice(0, 20);

        tagCloud.innerHTML = topTags.map(([tag, count]) => {
          const size = 0.875 + (count / 10);
          return `<button class="tag-link" data-tag="${tag}" style="font-size: ${size}rem">
            ${tag} (${count})
          </button>`;
        }).join('');

        // Add click handlers to tag buttons
        tagCloud.querySelectorAll('.tag-link').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const tag = e.target.dataset.tag;
            const tagInput = document.getElementById('tag-filter');
            if (tagInput) {
              tagInput.value = tag;
              search.setFilter('tag', tag);
            }
          });
        });
      }
    };

    // Initialize filters and DOM
    populateFilters();
    search.initializeWithDOM({
      yearFilterId: showYearFilter ? 'year-filter' : null,
      statusFilterId: showStatusFilter ? 'status-filter' : null
    });
  });
</script>

<style>
  .vault-search-container {
    padding: 2rem 0;
  }

  /* Search Bar */
  .search-bar {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .search-input {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    transition: all 0.2s;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .search-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .search-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  /* Filters */
  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--color-bg-secondary);
    border-radius: 8px;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .filter-select,
  .filter-input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.875rem;
  }

  .filter-select {
    min-width: 120px;
  }

  .filter-input {
    width: 150px;
  }

  .clear-filters {
    padding: 0.5rem 1rem;
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .clear-filters:hover {
    background: var(--color-primary);
    color: white;
  }

  /* Results Count */
  .results-count {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  #count-number {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Popular Tags */
  .popular-tags {
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .popular-tags h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-link {
    padding: 0.25rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    color: var(--color-text-secondary);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .tag-link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  /* Results Grid */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  /* Entry Cards */
  .entry-card {
    display: block;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    position: relative;
  }

  .entry-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .entry-card--draft {
    opacity: 0.6;
  }

  .entry-card--coming {
    border-style: dashed;
  }

  .entry-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .entry-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .entry-info {
    flex: 1;
  }

  .entry-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.25rem 0;
  }

  .entry-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .entry-meta {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .entry-category,
  .entry-year,
  .entry-type {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--color-bg-secondary);
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .entry-category {
    background: var(--color-primary);
    color: white;
  }

  .entry-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .entry-tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .entry-status {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .entry-status--coming {
    background: rgba(251, 146, 60, 0.1);
    color: #fb923c;
  }

  .entry-status--draft {
    background: rgba(156, 163, 175, 0.1);
    color: #9ca3af;
  }

  /* No Results */
  .no-results {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
  }

  .no-results h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .no-results p {
    color: var(--color-text-secondary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .search-filters {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-group {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-select,
    .filter-input {
      width: 100%;
    }

    .clear-filters {
      width: 100%;
    }

    .results-grid {
      grid-template-columns: 1fr;
    }
  }
</style>