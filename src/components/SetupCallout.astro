---
/**
 * SetupCallout - Docker setup banner for platform pages
 *
 * Usage:
 *   import SetupCallout from '@components/SetupCallout.astro';
 *   <SetupCallout dockerImage="ghcr.io/code198x/commodore-64" />
 *   <SetupCallout dockerImage="ghcr.io/code198x/sinclair-zx-spectrum" />
 */
import { Terminal } from '@lucide/astro';

interface Props {
  dockerImage: string;
}

const { dockerImage } = Astro.props;
---

<section class="setup-callout">
  <div class="setup-content">
    <div class="setup-icon">
      <Terminal size={24} />
    </div>
    <div class="setup-text">
      <strong>Zero-config setup:</strong>
      <code>docker pull {dockerImage}</code>
    </div>
    <a href="/setup" class="setup-link">Full setup guide &rarr;</a>
  </div>
</section>

<style>
  .setup-callout {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    padding: var(--space-4) var(--space-4);
    margin-top: var(--space-8);
  }

  .setup-content {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .setup-icon {
    color: #22c55e;
    display: flex;
  }

  .setup-text {
    color: #cbd5e1;
    font-size: 0.95rem;
  }

  .setup-text strong {
    color: white;
  }

  .setup-text code {
    background: rgba(255, 255, 255, 0.1);
    padding: var(--space-1) var(--space-2);
    border-radius: 0.25rem;
    font-size: 0.875rem;
    margin-left: var(--space-2);
  }

  .setup-link {
    color: #22c55e;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .setup-link:hover {
    color: #4ade80;
  }
</style>
