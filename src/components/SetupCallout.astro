---
/**
 * SetupCallout - Docker setup banner for platform pages
 *
 * Usage:
 *   import SetupCallout from '@components/SetupCallout.astro';
 *   <SetupCallout dockerImage="ghcr.io/code198x/commodore-64" />
 *   <SetupCallout dockerImage="ghcr.io/code198x/sinclair-zx-spectrum" />
 */
import { Terminal } from '@lucide/astro';

interface Props {
  dockerImage: string;
}

const { dockerImage } = Astro.props;
---

<section class="setup-callout">
  <div class="setup-content">
    <div class="setup-icon">
      <Terminal size={24} />
    </div>
    <div class="setup-text">
      <strong>Zero-config setup:</strong>
      <code>docker pull {dockerImage}</code>
    </div>
    <a href="/setup" class="setup-link">Full setup guide &rarr;</a>
  </div>
</section>

<style>
  .setup-callout {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    background: var(--color-surface);
    border: 3px solid var(--color-text);
    box-shadow: var(--shadow-chunky);
    padding: var(--space-4) var(--space-5);
  }

  .setup-content {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .setup-icon {
    color: var(--color-house-2);
    display: flex;
  }

  .setup-text {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .setup-text strong {
    color: var(--color-text);
  }

  .setup-text code {
    background: var(--color-code-bg);
    color: var(--color-code-text);
    padding: var(--space-1) var(--space-2);
    border-radius: 0;
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    margin-left: var(--space-2);
  }

  .setup-link {
    color: var(--color-house-2);
    font-family: var(--font-family-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .setup-link:hover {
    text-decoration: underline;
  }
</style>
