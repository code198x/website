---
import PageFrame from './PageFrame.astro';
import ReadingLayout from './ReadingLayout.astro';
import MagazineSectionHeading from './MagazineSectionHeading.astro';
import DirectorySearch from './DirectorySearch.astro';
import DirectoryStatus from './DirectoryStatus.astro';
import EditorialArticle from './EditorialArticle.astro';
import '../styles/pattern-library.css';
const examples = [
  { label: 'The Basics', href: '/foundations/basics/' },
  { label: 'Pattern Library', href: '/patterns/' },
  { label: 'Vault', href: '/vault/' },
];
---
<Fragment>
  <PageFrame>
    <h1>Site components</h1>
    <p><a href="/catalogue/">Family catalogue</a> · <a href="/catalogue/page-frame/">Page frames</a></p>
    <p>These are the components used by the website, rendered inside its real layout. Resize the browser to check wrapping, gutters and reading space.</p>
  </PageFrame>
  <PageFrame as="section" opening="none">
    <MagazineSectionHeading id="preview-magazine">
      <Fragment slot="title">Different Machines.<br /><em>Different Ways In.</em></Fragment>
      A magazine heading keeps the introduction alongside the title when there is room, and below it on a narrow screen.
    </MagazineSectionHeading>
    <MagazineSectionHeading id="preview-long-heading" ending="none">
      <Fragment slot="title">A longer heading should still leave room for <em>the explanation.</em></Fragment>
      This second instance exercises natural wrapping and the variant without a bottom margin.
    </MagazineSectionHeading>
  </PageFrame>
  <PageFrame as="section" class="reading-preview">
    <h2>Reading layout and contents</h2>
    <ReadingLayout id="preview-reading">
      <section><h2 id="preview-observe">Observe the result</h2><p>The shared grid gives this text a reading column and generates a contents rail from its headings.</p></section>
      <section><h2 id="preview-investigate">Investigate one change</h2><p>Page-specific content stays in the slot. The layout owns the columns, spacing and responsive behaviour.</p></section>
    </ReadingLayout>
  </PageFrame>
  <PageFrame as="section">
    <h2>Directory controls</h2>
    <p>Try “Vault” or a word with no matches. Clear returns focus to the field. The two examples are independent.</p>
    {(['filter', 'inline'] as const).map(appearance => (
      <section class="control-preview" data-directory-preview>
        <h3>{appearance === 'filter' ? 'Within a filter form' : 'With an inline clear button'}</h3>
        <form class:list={{ 'pattern-filters': appearance === 'filter' }} role="search" aria-label={`${appearance} control example`}>
          <DirectorySearch id={`preview-${appearance}-search`} label={`Search ${appearance} example`} placeholder="Try Vault" appearance={appearance} controls={`preview-${appearance}-results`} />
          {appearance === 'filter' && <button type="button" data-clear>Clear filters</button>}
        </form>
        <DirectoryStatus class="pattern-result-count"><span data-count>{examples.length}</span> <span data-count-label>destinations</span></DirectoryStatus>
        <p data-empty hidden>No matching destinations.</p>
        <ul id={`preview-${appearance}-results`}>{examples.map(example => <li data-result><a href={example.href}>{example.label}</a></li>)}</ul>
      </section>
    ))}
  </PageFrame>
  <PageFrame as="section" ending="none"><h2>Editorial article variants</h2><p>The article component owns the opening and prose; the series supplies metadata, figures and its ending.</p></PageFrame>
  {(['from-the-metal', 'field-notes', 'updates'] as const).map(series => (
    <EditorialArticle series={series} title={`Reading preview: ${series}`} introduction="A shared article structure with an explicit reading measure for each series." accent="var(--h-spot)">
      <p slot="metadata">Component specimen</p>
      <h2>A section heading</h2>
      <p>A paragraph with <em>emphasis</em>, <strong>strong text</strong>, an <a href="/about/">ordinary link</a> and inline <code>PRINT</code>. Body text keeps the same line spacing across the three series.</p>
      <blockquote><p>A quotation remains part of the reading column.</p></blockquote>
      <p slot="ending">A series-specific ending belongs here.</p>
    </EditorialArticle>
  ))}
</Fragment>
<script>
  import { bindDirectoryReset } from '../lib/directory-controls';
  function initPreviews() {
    document.querySelectorAll<HTMLElement>('[data-directory-preview]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const query = root.querySelector<HTMLInputElement>('input')!;
      const rows = [...root.querySelectorAll<HTMLElement>('[data-result]')];
      const update = () => {
        rows.forEach(row => { row.hidden = !row.textContent?.toLowerCase().includes(query.value.trim().toLowerCase()); });
        const count = rows.filter(row => !row.hidden).length;
        root.querySelector('[data-count]')!.textContent = String(count);
        root.querySelector('[data-count-label]')!.textContent = count === 1 ? 'destination' : 'destinations';
        root.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
      };
      query.addEventListener('input', update);
      root.querySelector('form')!.addEventListener('submit', event => event.preventDefault());
      bindDirectoryReset(root, query, update, { escape: true });
    });
  }
  initPreviews();
  document.addEventListener('astro:page-load', initPreviews);
</script>
<style>
  :global(#main-content > section + section) { border-top: 1px solid var(--h-line); }
  .reading-preview > h2 { margin-bottom: 40px; }
  .reading-preview section { margin-top: 40px; }
  .reading-preview section h2 { margin-top: 0; }
  .control-preview { margin-top: 40px; }
  .control-preview [hidden] { display: none; }
</style>
