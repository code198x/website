---
import { ArrowRight } from '@lucide/astro';
interface Props {
  connections: Array<{ label: string; explanation: string; colour: string; to: { id: string; data: { title: string } } }>;
}
const { connections } = Astro.props;
---
{connections.length > 0 && <section class="vault-article-connections" aria-labelledby="connections-title">
  <h2 id="connections-title">Follow the connections.</h2>
  <ul>{connections.map(connection => <li data-vault-colour={connection.colour}>
    <a href={`/vault/${connection.to.id}/`}><span>{connection.to.data.title}</span><ArrowRight size={20} aria-hidden="true"/></a>
    <p><strong>{connection.label}.</strong> {connection.explanation}</p>
  </li>)}</ul>
</section>}
