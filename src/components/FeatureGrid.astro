---
/**
 * FeatureGrid — the "What You'll Master" cards shared by the track-overview pages.
 *
 * The card chrome was copy-pasted across platforms; only the content differs.
 * Synthesis-styled once (square, 3px border, mono title in the platform colour);
 * each page passes its own features array.
 */
interface Feature { title: string; description: string }
interface Props { features: Feature[]; platformColor: string }
import { inkStyle } from '../lib/contrast';
const { features, platformColor } = Astro.props;
---

<div class="feature-grid" style={`--pc: ${platformColor}; ${inkStyle(platformColor)}`}>
  {features.map(f => (
    <div class="feature-card">
      <h3 class="feature-title">{f.title}</h3>
      <p class="feature-description">{f.description}</p>
    </div>
  ))}
</div>

<style>
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-5); margin-top: var(--space-6); }
  .feature-card { background: var(--color-surface); border: 3px solid var(--color-border); padding: var(--space-6); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
  .feature-card:hover { border-color: var(--pc); transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--pc); }
  .feature-title { font-family: var(--font-family-mono); font-size: 1.05rem; font-weight: 700; color: var(--ink); margin: 0 0 var(--space-2); }
  .feature-description { color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; }
</style>
