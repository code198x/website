---
/**
 * Performance Dashboard Component
 * Displays real-time Web Vitals and performance metrics
 */
---

<div class="performance-dashboard" id="performance-dashboard">
  <div class="dashboard-header">
    <h3>⚡️ Performance Monitor</h3>
    <button class="toggle-dashboard" id="toggle-dashboard">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </div>

  <div class="dashboard-content" id="dashboard-content">
    <div class="metrics-grid">
      <div class="metric-card" id="cls-metric">
        <div class="metric-info">
          <div class="metric-label">CLS</div>
          <div class="metric-value">-</div>
        </div>
        <div class="metric-status">measuring...</div>
      </div>

      <div class="metric-card" id="fcp-metric">
        <div class="metric-info">
          <div class="metric-label">FCP</div>
          <div class="metric-value">-</div>
        </div>
        <div class="metric-status">measuring...</div>
      </div>

      <div class="metric-card" id="lcp-metric">
        <div class="metric-info">
          <div class="metric-label">LCP</div>
          <div class="metric-value">-</div>
        </div>
        <div class="metric-status">measuring...</div>
      </div>

      <div class="metric-card" id="inp-metric">
        <div class="metric-info">
          <div class="metric-label">INP</div>
          <div class="metric-value">-</div>
        </div>
        <div class="metric-status">waiting for interaction</div>
      </div>
    </div>

    <div class="dashboard-actions">
      <button class="action-button" id="clear-data">Clear Data</button>
      <button class="action-button" id="export-data">Export Data</button>
      <button class="action-button" id="view-details">View Details</button>
    </div>
  </div>
</div>

<style>
  .performance-dashboard {
    position: fixed;
    top: 80px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    width: 240px;
    z-index: var(--z-overlay);
    font-size: 0.75rem;
    transition: transform var(--transition-base);
  }

  .performance-dashboard.collapsed .dashboard-content {
    display: none;
  }

  .performance-dashboard.collapsed .toggle-dashboard svg {
    transform: rotate(-90deg);
  }

  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .dashboard-header h3 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .toggle-dashboard {
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
    color: var(--color-text-light);
  }

  .toggle-dashboard:hover {
    background: var(--color-bg-secondary);
  }

  .toggle-dashboard svg {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-base);
  }

  .dashboard-content {
    padding: 10px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    margin-bottom: 10px;
  }

  .metric-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    padding: 6px 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: border-color var(--transition-fast);
  }

  .metric-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .metric-details {
    text-align: left;
  }

  .metric-card.good {
    border-color: var(--color-success);
    background: var(--color-success-light);
  }

  .metric-card.needs-improvement {
    border-color: var(--color-warning);
    background: var(--color-warning-light);
  }

  .metric-card.poor {
    border-color: var(--color-error);
    background: var(--color-error-light);
  }

  .metric-label {
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.025em;
    margin-bottom: 2px;
  }

  .metric-value {
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    font-family: var(--font-family-mono);
    margin-bottom: 2px;
    line-height: 1.2;
  }

  .metric-status {
    font-size: 0.625rem;
    color: var(--color-text-lighter);
    line-height: 1.2;
  }

  .dashboard-actions {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .action-button {
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    font-size: 0.625rem;
    color: var(--color-text-light);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .action-button:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  /* Dark mode support */
  html.dark-mode .performance-dashboard {
    background: rgba(15, 23, 42, 0.95);
    border-color: #374151;
  }

  html.dark-mode .dashboard-header {
    border-bottom-color: #374151;
  }

  html.dark-mode .dashboard-header h3 {
    color: #f9fafb;
  }

  html.dark-mode .toggle-dashboard {
    color: #d1d5db;
  }

  html.dark-mode .toggle-dashboard:hover {
    background: #374151;
  }

  html.dark-mode .metric-card {
    background: #1f2937;
    border-color: #374151;
    color: #f9fafb;
  }

  html.dark-mode .metric-card.good {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10b981;
  }

  html.dark-mode .metric-card.needs-improvement {
    background: rgba(245, 158, 11, 0.15);
    border-color: #f59e0b;
  }

  html.dark-mode .metric-card.poor {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
  }

  html.dark-mode .metric-label {
    color: #d1d5db;
  }

  html.dark-mode .metric-value {
    color: #ffffff;
  }

  html.dark-mode .metric-status {
    color: #9ca3af;
  }

  html.dark-mode .action-button {
    background: #374151;
    border-color: #4b5563;
    color: #d1d5db;
  }

  html.dark-mode .action-button:hover {
    background: #3b82f6;
    border-color: #3b82f6;
    color: white;
  }

  /* Fallback for system dark mode */
  @media (prefers-color-scheme: dark) {
    .performance-dashboard {
      background: rgba(15, 23, 42, 0.95);
      border-color: #374151;
    }

    .dashboard-header {
      border-bottom-color: #374151;
    }

    .dashboard-header h3 {
      color: #f9fafb;
    }

    .toggle-dashboard {
      color: #d1d5db;
    }

    .toggle-dashboard:hover {
      background: #374151;
    }

    .metric-card {
      background: #1f2937;
      border-color: #374151;
      color: #f9fafb;
    }

    .metric-card.good {
      background: rgba(16, 185, 129, 0.15);
      border-color: #10b981;
    }

    .metric-card.needs-improvement {
      background: rgba(245, 158, 11, 0.15);
      border-color: #f59e0b;
    }

    .metric-card.poor {
      background: rgba(239, 68, 68, 0.15);
      border-color: #ef4444;
    }

    .metric-label {
      color: #d1d5db;
    }

    .metric-value {
      color: #ffffff;
    }

    .metric-status {
      color: #9ca3af;
    }

    .action-button {
      background: #374151;
      border-color: #4b5563;
      color: #d1d5db;
    }

    .action-button:hover {
      background: #3b82f6;
      border-color: #3b82f6;
      color: white;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .performance-dashboard {
      position: relative;
      top: auto;
      right: auto;
      margin: var(--space-md) 0;
      width: 100%;
    }
  }

  /* Hide in production by default */
  @media (prefers-reduced-motion: reduce) {
    .performance-dashboard {
      display: none;
    }
  }
</style>

<script>
  // Performance Dashboard functionality
  class PerformanceDashboard {
    constructor() {
      this.dashboard = document.getElementById('performance-dashboard');
      this.content = document.getElementById('dashboard-content');
      this.toggleButton = document.getElementById('toggle-dashboard');

      if (!this.dashboard) return;

      this.init();
    }

    init() {
      // Set up toggle functionality
      this.toggleButton?.addEventListener('click', () => this.toggle());

      // Set up action buttons
      document.getElementById('clear-data')?.addEventListener('click', () => this.clearData());
      document.getElementById('export-data')?.addEventListener('click', () => this.exportData());
      document.getElementById('view-details')?.addEventListener('click', () => this.viewDetails());

      // Listen for performance data from the performance monitor
      this.listenForMetrics();

      // Start collapsed on mobile
      if (window.innerWidth < 768) {
        this.dashboard.classList.add('collapsed');
      }
    }

    toggle() {
      this.dashboard?.classList.toggle('collapsed');
    }

    listenForMetrics() {
      // Listen for custom events from the performance monitor
      window.addEventListener('web-vital', (event) => {
        this.updateMetric(event.detail);
      });

      // Periodically check for stored data
      setInterval(() => {
        this.updateFromStorage();
      }, 2000);
    }

    updateMetric(metric) {
      const element = document.getElementById(`${metric.name.toLowerCase()}-metric`);
      if (!element) return;

      const valueElement = element.querySelector('.metric-value');
      const statusElement = element.querySelector('.metric-status');

      if (valueElement) {
        const value = metric.name === 'CLS' ? metric.value.toFixed(3) : Math.round(metric.value);
        const unit = metric.name === 'CLS' ? '' : 'ms';
        valueElement.textContent = `${value}${unit}`;
      }

      if (statusElement) {
        statusElement.textContent = metric.rating;
      }

      // Update card styling based on rating
      element.className = `metric-card ${metric.rating}`;
    }

    updateFromStorage() {
      if (typeof window.performanceMonitor === 'undefined') return;

      const storedData = window.performanceMonitor.getStoredData();
      if (storedData.length === 0) return;

      // Get latest metrics for each type
      const latestMetrics = {};
      storedData.forEach(metric => {
        if (!latestMetrics[metric.name] || metric.timestamp > latestMetrics[metric.name].timestamp) {
          latestMetrics[metric.name] = metric;
        }
      });

      // Update dashboard with latest metrics
      Object.values(latestMetrics).forEach(metric => {
        this.updateMetric(metric);
      });
    }

    clearData() {
      if (typeof window.performanceMonitor !== 'undefined') {
        window.performanceMonitor.clearStoredData();
      }

      // Reset all metric displays
      document.querySelectorAll('.metric-card').forEach(card => {
        const valueElement = card.querySelector('.metric-value');
        const statusElement = card.querySelector('.metric-status');

        if (valueElement) valueElement.textContent = '-';
        if (statusElement) statusElement.textContent = 'measuring...';

        card.className = 'metric-card';
      });
    }

    exportData() {
      if (typeof window.performanceMonitor === 'undefined') {
        alert('No performance data available');
        return;
      }

      const data = window.performanceMonitor.getStoredData();
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);

      const a = document.createElement('a');
      a.href = url;
      a.download = `performance-data-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    viewDetails() {
      if (typeof window.performanceMonitor === 'undefined') {
        alert('No performance data available');
        return;
      }

      const data = window.performanceMonitor.getStoredData();
      console.table(data);
      alert('Performance data logged to console (F12 > Console)');
    }
  }

  // Initialize dashboard when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new PerformanceDashboard());
  } else {
    new PerformanceDashboard();
  }

  // Only show dashboard in development or when explicitly enabled
  if (import.meta.env.PROD && !import.meta.env.VITE_SHOW_PERF_DASHBOARD) {
    document.getElementById('performance-dashboard')?.remove();
  }
</script>