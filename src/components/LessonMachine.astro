---
interface Props {
  id: string;
  title: string;
  label: string;
  poster?: string;
  choices?: Array<{ id: string; title: string; source: string }>;
}
const { id, title, label, poster, choices = [] } = Astro.props;
import '../styles/lesson-machine.css';
---
<div class="lesson-machine-home" data-machine-home={id}>
  <p class="lesson-machine-away" hidden>The machine is beside your current experiment. Your edits stay with it.</p>
  <aside class="lesson-machine" id={id} data-lesson-machine-panel aria-label={title}>
    <header class="lesson-machine-head"><div><span class="lesson-machine-label">{label}</span><h2 class="lesson-machine-title">{title}</h2></div><button type="button" class="lesson-machine-close" hidden>Close</button></header>
    <slot />
    {poster && <img data-machine-poster src={poster} width="352" height="296" alt="Recorded lesson screen. Run the program to start the live machine." />}
    <script type="application/json" data-machine-choices set:html={JSON.stringify(choices).replace(/</g, '\\u003c')} />
  </aside>
</div>
<script>
  import { initialiseLessonMachines } from '../scripts/lesson-machine';
  initialiseLessonMachines();
  document.addEventListener('astro:page-load', initialiseLessonMachines);
</script>
