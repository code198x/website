---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import UnifiedSearch from "./UnifiedSearch.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { generateVaultBreadcrumbs } from "../utils/breadcrumbs";

export interface Props {
  // Layout props
  title: string;
  description?: string;
  structuredData?: object;

  // Hero props
  heroTitle: string;
  heroSubtitle: string;
  heroDescription: string;
  heroIcon: string;
  heroColor: string;

  // Category props
  categorySlug: string;
  categoryData: any[];

  // Search props
  showCategoryFilter?: boolean;
  showTypeFilter?: boolean;
  showTagFilter?: boolean;
  showYearFilter?: boolean;
  showStatusFilter?: boolean;

  // Info section props
  infoTitle?: string;
  infoDescription?: string;
  stats?: Array<{ label: string; value: number; filter?: (item: any) => boolean }>;
}

const {
  title,
  description,
  structuredData,
  heroTitle,
  heroSubtitle,
  heroDescription,
  heroIcon,
  heroColor,
  categorySlug,
  categoryData,
  showCategoryFilter = false,
  showTypeFilter = true,
  showTagFilter = true,
  showYearFilter = false,
  showStatusFilter = false,
  infoTitle,
  infoDescription,
  stats = []
} = Astro.props;

// Configure search filters
const searchFilters = [
  showCategoryFilter && {
    id: 'category',
    label: 'Category',
    type: 'select' as const,
    options: [{ value: 'all', label: 'All Categories' }],
    show: true
  },
  showTypeFilter && {
    id: 'type',
    label: 'Type',
    type: 'select' as const,
    options: [{ value: 'all', label: 'All Types' }],
    show: true
  },
  showTagFilter && {
    id: 'tags',
    label: 'Tags',
    type: 'text' as const,
    placeholder: 'Filter by tag...',
    show: true
  },
  showYearFilter && {
    id: 'year',
    label: 'Year',
    type: 'select' as const,
    options: [
      { value: 'all', label: 'All Years' },
      { value: '1970s', label: '1970s' },
      { value: '1980s', label: '1980s' },
      { value: '1990s', label: '1990s' },
      { value: '2000s', label: '2000s' }
    ],
    show: true
  },
  showStatusFilter && {
    id: 'status',
    label: 'Status',
    type: 'select' as const,
    options: [
      { value: 'all', label: 'All Status' },
      { value: 'available', label: 'Available' },
      { value: 'coming-soon', label: 'Coming Soon' },
      { value: 'planned', label: 'Planned' }
    ],
    show: true
  }
].filter(Boolean) as any[];
---

<Layout title={title} description={description} structuredData={structuredData}>
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    description={heroDescription}
    variant="gradient"
    badge={{
      text: `${heroIcon} ${heroTitle}`,
      color: heroColor,
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs(categorySlug as any)} />

      <!-- Search Component -->
      <UnifiedSearch
        id={`${categorySlug}-search`}
        variant="full"
        placeholder={`Search ${heroTitle.toLowerCase()}...`}
        filters={searchFilters}
        showButton={false}
        showSuggestions={true}
        maxSuggestions={5}
        data={categoryData}
        onSearch={`${categorySlug}-search-results`}
        className="vault-category-search"
      />

      <!-- Results Grid -->
      <div id="category-results-grid" class="results-grid">
        {/* Server-side render all entries for SEO */}
        {categoryData.map((entry) => (
          <a
            href={`/vault/${entry.c}/${entry.s}`}
            class="vault-entry-card"
            data-category={entry.c}
            data-type={entry.t}
            data-tags={entry.g?.join(',')}
            data-year={entry.y}
            data-status={entry.st}
          >
            <div class="vault-entry-card__header">
              <h3 class="vault-entry-card__title">{entry.n}</h3>
              {entry.y > 0 && (
                <span class="vault-entry-card__year">{entry.y}</span>
              )}
            </div>
            <p class="vault-entry-card__description">{entry.d}</p>
            <div class="vault-entry-card__footer">
              <span class="vault-entry-card__type">{entry.t}</span>
              <span class="vault-entry-card__arrow">→</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Additional Information Section (optional) -->
      {(infoTitle || infoDescription || stats.length > 0) && (
        <section class="vault-category-info-section">
          {infoTitle && <h2>{infoTitle}</h2>}
          {infoDescription && <p>{infoDescription}</p>}

          {stats.length > 0 && (
            <div class="vault-stats-grid">
              {stats.map(stat => (
                <div class="vault-stat-card">
                  <span class="vault-stat-number">
                    {stat.filter ? categoryData.filter(stat.filter).length : stat.value}
                  </span>
                  <span class="vault-stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}
        </section>
      )}

      <!-- Additional content slot -->
      <slot />
    </div>
  </div>
</Layout>

<style>
  /* Results Grid */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
  }

  /* Vault Entry Card */
  .vault-entry-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    position: relative;
  }

  .vault-entry-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .vault-entry-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-sm);
  }

  .vault-entry-card__title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
  }

  .vault-entry-card__year {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    background: var(--color-background-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--border-radius-sm);
  }

  .vault-entry-card__description {
    flex: 1;
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: var(--space-sm) 0;
  }

  .vault-entry-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-md);
  }

  .vault-entry-card__type {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    font-weight: 500;
    text-transform: capitalize;
  }

  .vault-entry-card__arrow {
    font-size: var(--font-size-lg);
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }

  .vault-entry-card:hover .vault-entry-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Hidden by search filters */
  .vault-entry-card.hidden {
    display: none;
  }

  /* Responsive - Mobile First Improvements */
  @media (max-width: 768px) {
    .vault-category-container {
      padding: var(--space-lg) 0;
    }

    .container {
      padding: 0 var(--space-md);
    }

    .results-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      margin: var(--space-lg) 0;
    }

    .vault-entry-card {
      padding: var(--space-lg);
      /* Larger touch target for mobile */
      min-height: 120px;
    }

    .vault-entry-card__header {
      gap: var(--space-sm);
    }

    .vault-entry-card__title {
      font-size: var(--font-size-lg);
      /* Better line height for readability */
      line-height: 1.3;
    }

    .vault-entry-card__year {
      padding: 4px 8px;
      font-size: var(--font-size-xs);
    }

    .vault-entry-card__description {
      font-size: var(--font-size-sm);
      /* Limit lines on mobile for consistency */
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Show arrow on mobile for better affordance */
    .vault-entry-card__arrow {
      opacity: 0.5;
      transform: translateX(0);
    }

    /* Stronger visual feedback on touch */
    .vault-entry-card:active {
      transform: scale(0.98);
      background: var(--color-background-secondary);
    }
  }

  /* Small mobile devices */
  @media (max-width: 480px) {
    .vault-category-container {
      padding: var(--space-md) 0;
    }

    .container {
      padding: 0 var(--space-sm);
    }

    .results-grid {
      gap: var(--space-sm);
    }

    .vault-entry-card {
      padding: var(--space-md);
      border-radius: var(--border-radius-md);
    }
  }
</style>
