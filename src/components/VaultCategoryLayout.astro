---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import VaultSearch from "./VaultSearch.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { generateVaultBreadcrumbs } from "../utils/breadcrumbs";
import "../styles/vault.css";

export interface Props {
  // Layout props
  title: string;
  description?: string;
  structuredData?: object;

  // Hero props
  heroTitle: string;
  heroSubtitle: string;
  heroDescription: string;
  heroIcon: string;
  heroColor: string;

  // Category props
  categorySlug: string;
  categoryData: any[];

  // Search props
  showCategoryFilter?: boolean;
  showTypeFilter?: boolean;
  showTagFilter?: boolean;
  showYearFilter?: boolean;
  showStatusFilter?: boolean;

  // Info section props
  infoTitle?: string;
  infoDescription?: string;
  stats?: Array<{ label: string; value: number; filter?: (item: any) => boolean }>;
}

const {
  title,
  description,
  structuredData,
  heroTitle,
  heroSubtitle,
  heroDescription,
  heroIcon,
  heroColor,
  categorySlug,
  categoryData,
  showCategoryFilter = false,
  showTypeFilter = true,
  showTagFilter = true,
  showYearFilter = false,
  showStatusFilter = false,
  infoTitle,
  infoDescription,
  stats = []
} = Astro.props;
---

<Layout title={title} description={description} structuredData={structuredData}>
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    description={heroDescription}
    variant="gradient"
    badge={{
      text: `${heroIcon} ${heroTitle}`,
      color: heroColor,
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs(categorySlug as any)} />

      <!-- Search Component -->
      <VaultSearch
        data={categoryData}
        category={categorySlug}
        placeholder={`Search ${heroTitle.toLowerCase()}...`}
        showCategoryFilter={showCategoryFilter}
        showTypeFilter={showTypeFilter}
        showTagFilter={showTagFilter}
        showYearFilter={showYearFilter}
        showStatusFilter={showStatusFilter}
      />

      <!-- Additional Information Section (optional) -->
      {(infoTitle || infoDescription || stats.length > 0) && (
        <section class="vault-category-info-section">
          {infoTitle && <h2>{infoTitle}</h2>}
          {infoDescription && <p>{infoDescription}</p>}

          {stats.length > 0 && (
            <div class="vault-stats-grid">
              {stats.map(stat => (
                <div class="vault-stat-card">
                  <span class="vault-stat-number">
                    {stat.filter ? categoryData.filter(stat.filter).length : stat.value}
                  </span>
                  <span class="vault-stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}
        </section>
      )}

      <!-- Additional content slot -->
      <slot />
    </div>
  </div>
</Layout>

