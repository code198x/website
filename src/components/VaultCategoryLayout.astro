---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import { vaultData } from "../data/vault-data.js";
import Breadcrumb from "./Breadcrumb.astro";
import { generateVaultBreadcrumbs } from "../utils/breadcrumbs";

export interface Props {
  // Layout props
  title: string;
  description?: string;
  structuredData?: object;

  // Hero props
  heroTitle: string;
  heroSubtitle: string;
  heroDescription: string;
  heroIcon: string;
  heroColor: string;

  // Category props
  categorySlug: string;
  categoryData: any[];

  // Info section props
  infoTitle?: string;
  infoDescription?: string;
  stats?: Array<{ label: string; value: number; filter?: (item: any) => boolean }>;
}

const {
  title,
  description,
  structuredData,
  heroTitle,
  heroSubtitle,
  heroDescription,
  heroIcon,
  heroColor,
  categorySlug,
  categoryData,
  infoTitle,
  infoDescription,
  stats = [],
} = Astro.props;

// Get tag statistics for this category
const categoryTagCounts = new Map<string, number>();
categoryData.forEach((entry) => {
  if (entry.g && Array.isArray(entry.g)) {
    entry.g.forEach((tag: string) => {
      const normalizedTag = tag.toLowerCase();
      categoryTagCounts.set(normalizedTag, (categoryTagCounts.get(normalizedTag) || 0) + 1);
    });
  }
});

// Get top tags for this category
const topCategoryTags = Array.from(categoryTagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<Layout title={title} description={description} structuredData={structuredData}>
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    description={heroDescription}
    variant="gradient"
    badge={{
      text: `${heroIcon} ${heroTitle}`,
      color: heroColor,
      href: "/vault",
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs(categorySlug as any)} />

      <!-- Quick Tag Filters -->
      {
        topCategoryTags.length > 0 && (
          <div class="category-tag-filters">
            <h3 class="tag-filters-title">Popular Tags in {heroTitle}</h3>
            <div class="tag-filters-container">
              {topCategoryTags.map(([tag, count]) => (
                <a
                  href={`/vault/tags/${tag}`}
                  class="category-tag-filter"
                  title={`${count} ${heroTitle.toLowerCase()} entries`}
                >
                  #{tag}
                  <span class="tag-filter-count">{count}</span>
                </a>
              ))}
              <a href="/vault/tags" class="view-all-tags-link">
                View All Tags →
              </a>
            </div>
          </div>
        )
      }

      <!-- Results Grid -->
      <div id="category-results-grid" class="results-grid">
        {/* Server-side render all entries for SEO */}
        {
          categoryData.map((entry) => (
            <a
              href={`/vault/${entry.c}/${entry.s}`}
              class="vault-entry-card"
              data-category={entry.c}
              data-type={entry.t}
              data-tags={entry.g?.join(",")}
              data-year={entry.y}
              data-status={entry.st}
            >
              <div class="vault-entry-card__header">
                <h3 class="vault-entry-card__title">{entry.n}</h3>
                {entry.y > 0 && <span class="vault-entry-card__year">{entry.y}</span>}
              </div>
              <p class="vault-entry-card__description">{entry.d}</p>
              <div class="vault-entry-card__footer">
                <span class="vault-entry-card__type">{entry.t}</span>
                <span class="vault-entry-card__arrow">→</span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Additional Information Section (optional) -->
      {
        (infoTitle || infoDescription || stats.length > 0) && (
          <section class="vault-category-info-section">
            {infoTitle && <h2>{infoTitle}</h2>}
            {infoDescription && <p>{infoDescription}</p>}

            {stats.length > 0 && (
              <div class="vault-stats-grid">
                {stats.map((stat) => (
                  <div class="vault-stat-card">
                    <span class="vault-stat-number">
                      {stat.filter ? categoryData.filter(stat.filter).length : stat.value}
                    </span>
                    <span class="vault-stat-label">{stat.label}</span>
                  </div>
                ))}
              </div>
            )}
          </section>
        )
      }

      <!-- Additional content slot -->
      <slot />
    </div>
  </div>
</Layout>

<style>
  /* Results Grid */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
  }

  /* Vault Entry Card */
  .vault-entry-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    position: relative;
  }

  .vault-entry-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .vault-entry-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-sm);
  }

  .vault-entry-card__title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
  }

  .vault-entry-card__year {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    background: var(--color-background-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--border-radius-sm);
  }

  .vault-entry-card__description {
    flex: 1;
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: var(--space-sm) 0;
  }

  .vault-entry-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-md);
  }

  .vault-entry-card__type {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    font-weight: 500;
    text-transform: capitalize;
  }

  .vault-entry-card__arrow {
    font-size: var(--font-size-lg);
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }

  .vault-entry-card:hover .vault-entry-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Hidden by search filters */
  .vault-entry-card.hidden {
    display: none;
  }

  /* Category Tag Filters */
  .category-tag-filters {
    background: linear-gradient(
      135deg,
      var(--color-background-secondary) 0%,
      rgba(139, 92, 246, 0.03) 100%
    );
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
  }

  .tag-filters-title {
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .tag-filters-title::before {
    content: "🏷️";
    font-size: var(--font-size-xl);
  }

  .tag-filters-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .category-tag-filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: 600;
    transition: all 0.2s ease;
    position: relative;
  }

  .category-tag-filter:hover {
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 0.9));
    color: white;
    border-color: transparent;
    transform: scale(1.05) translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
  }

  .tag-filter-count {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    padding: 2px 6px;
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .category-tag-filter:hover .tag-filter-count {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .view-all-tags-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: 600;
    transition: all 0.2s ease;
    margin-left: var(--space-sm);
  }

  .view-all-tags-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
  }

  /* Responsive - Mobile First Improvements */
  @media (max-width: 768px) {
    .vault-category-container {
      padding: var(--space-lg) 0;
    }

    .container {
      padding: 0 var(--space-md);
    }

    .results-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      margin: var(--space-lg) 0;
    }

    .vault-entry-card {
      padding: var(--space-lg);
      /* Larger touch target for mobile */
      min-height: 120px;
    }

    .vault-entry-card__header {
      gap: var(--space-sm);
    }

    .vault-entry-card__title {
      font-size: var(--font-size-lg);
      /* Better line height for readability */
      line-height: 1.3;
    }

    .vault-entry-card__year {
      padding: 4px 8px;
      font-size: var(--font-size-xs);
    }

    .vault-entry-card__description {
      font-size: var(--font-size-sm);
      /* Limit lines on mobile for consistency */
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Show arrow on mobile for better affordance */
    .vault-entry-card__arrow {
      opacity: 0.5;
      transform: translateX(0);
    }

    /* Stronger visual feedback on touch */
    .vault-entry-card:active {
      transform: scale(0.98);
      background: var(--color-background-secondary);
    }
  }

  /* Small mobile devices */
  @media (max-width: 480px) {
    .vault-category-container {
      padding: var(--space-md) 0;
    }

    .container {
      padding: 0 var(--space-sm);
    }

    .results-grid {
      gap: var(--space-sm);
    }

    .vault-entry-card {
      padding: var(--space-md);
      border-radius: var(--border-radius-md);
    }
  }
</style>
