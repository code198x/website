---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import UnifiedSearch from "./UnifiedSearch.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { generateVaultBreadcrumbs } from "../utils/breadcrumbs";

export interface Props {
  // Layout props
  title: string;
  description?: string;
  structuredData?: object;

  // Hero props
  heroTitle: string;
  heroSubtitle: string;
  heroDescription: string;
  heroIcon: string;
  heroColor: string;

  // Category props
  categorySlug: string;
  categoryData: any[];

  // Search props
  showCategoryFilter?: boolean;
  showTypeFilter?: boolean;
  showTagFilter?: boolean;
  showYearFilter?: boolean;
  showStatusFilter?: boolean;

  // Info section props
  infoTitle?: string;
  infoDescription?: string;
  stats?: Array<{ label: string; value: number; filter?: (item: any) => boolean }>;
}

const {
  title,
  description,
  structuredData,
  heroTitle,
  heroSubtitle,
  heroDescription,
  heroIcon,
  heroColor,
  categorySlug,
  categoryData,
  showCategoryFilter = false,
  showTypeFilter = true,
  showTagFilter = true,
  showYearFilter = false,
  showStatusFilter = false,
  infoTitle,
  infoDescription,
  stats = []
} = Astro.props;

// Configure search filters
const searchFilters = [
  showCategoryFilter && {
    id: 'category',
    label: 'Category',
    type: 'select' as const,
    options: [{ value: 'all', label: 'All Categories' }],
    show: true
  },
  showTypeFilter && {
    id: 'type',
    label: 'Type',
    type: 'select' as const,
    options: [{ value: 'all', label: 'All Types' }],
    show: true
  },
  showTagFilter && {
    id: 'tags',
    label: 'Tags',
    type: 'text' as const,
    placeholder: 'Filter by tag...',
    show: true
  },
  showYearFilter && {
    id: 'year',
    label: 'Year',
    type: 'select' as const,
    options: [
      { value: 'all', label: 'All Years' },
      { value: '1970s', label: '1970s' },
      { value: '1980s', label: '1980s' },
      { value: '1990s', label: '1990s' },
      { value: '2000s', label: '2000s' }
    ],
    show: true
  },
  showStatusFilter && {
    id: 'status',
    label: 'Status',
    type: 'select' as const,
    options: [
      { value: 'all', label: 'All Status' },
      { value: 'available', label: 'Available' },
      { value: 'coming-soon', label: 'Coming Soon' },
      { value: 'planned', label: 'Planned' }
    ],
    show: true
  }
].filter(Boolean) as any[];
---

<Layout title={title} description={description} structuredData={structuredData}>
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    description={heroDescription}
    variant="gradient"
    badge={{
      text: `${heroIcon} ${heroTitle}`,
      color: heroColor,
      href: "/vault"
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs(categorySlug as any)} />

      <!-- Search Component -->
      <UnifiedSearch
        id={`${categorySlug}-search`}
        variant="full"
        placeholder={`Search ${heroTitle.toLowerCase()}...`}
        filters={searchFilters}
        showButton={false}
        showSuggestions={true}
        maxSuggestions={5}
        data={categoryData}
        onSearch={`${categorySlug}-search-results`}
        className="vault-category-search"
      />

      <!-- Results Grid -->
      <div id="category-results-grid" class="results-grid">
        <!-- Results will be populated here -->
      </div>

      <!-- Additional Information Section (optional) -->
      {(infoTitle || infoDescription || stats.length > 0) && (
        <section class="vault-category-info-section">
          {infoTitle && <h2>{infoTitle}</h2>}
          {infoDescription && <p>{infoDescription}</p>}

          {stats.length > 0 && (
            <div class="vault-stats-grid">
              {stats.map(stat => (
                <div class="vault-stat-card">
                  <span class="vault-stat-number">
                    {stat.filter ? categoryData.filter(stat.filter).length : stat.value}
                  </span>
                  <span class="vault-stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}
        </section>
      )}

      <!-- Additional content slot -->
      <slot />
    </div>
  </div>
</Layout>

