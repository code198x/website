---
// Global Search Component - loads data dynamically when opened
import { getCollection } from 'astro:content';

// Get lessons from content collections at build time
let lessons = [];
try {
  const allLessons = await getCollection('lessons');
  lessons = allLessons.map(lesson => ({
    category: 'lesson',
    type: 'lesson',
    name: lesson.data.title,
    slug: `/lessons/${lesson.slug}`,
    description: lesson.data.description || '',
    tags: lesson.data.tags || [],
    system: lesson.slug.split('/')[0],
    phase: lesson.data.phase,
    tier: lesson.data.tier
  }));
} catch (e) {
  // Lessons collection is empty or doesn't exist
}
---

<!-- Global Search Modal -->
<div id="global-search-modal" class="search-modal" aria-hidden="true">
  <div class="search-modal-backdrop"></div>
  <div class="search-modal-content">
    <div class="search-header">
      <input
        type="search"
        id="global-search-input"
        class="search-input"
        placeholder="Search lessons, hardware, people, software... (Press / to focus)"
        autocomplete="off"
        autofocus
      />
      <button id="search-close" class="search-close" aria-label="Close search">
        <span>ESC</span>
      </button>
    </div>

    <div class="search-body">
      <!-- Quick Links -->
      <div class="search-quick-links">
        <h3>Quick Links</h3>
        <div class="quick-link-grid">
          <a href="/lessons" class="quick-link">
            <span class="quick-link-icon">📚</span>
            <span>All Lessons</span>
          </a>
          <a href="/vault/search" class="quick-link">
            <span class="quick-link-icon">🔍</span>
            <span>Advanced Search</span>
          </a>
          <a href="/vault/hardware" class="quick-link">
            <span class="quick-link-icon">🖥️</span>
            <span>Hardware</span>
          </a>
          <a href="/vault/people" class="quick-link">
            <span class="quick-link-icon">👤</span>
            <span>People</span>
          </a>
          <a href="/vault/games" class="quick-link">
            <span class="quick-link-icon">🎮</span>
            <span>Games</span>
          </a>
          <a href="/vault/software" class="quick-link">
            <span class="quick-link-icon">💿</span>
            <span>Software</span>
          </a>
          <a href="/vault/timeline" class="quick-link">
            <span class="quick-link-icon">📅</span>
            <span>Timeline</span>
          </a>
          <a href="/vault/techniques" class="quick-link">
            <span class="quick-link-icon">💡</span>
            <span>Techniques</span>
          </a>
        </div>
      </div>

      <!-- Search Results -->
      <div id="search-results" class="search-results" style="display: none;">
        <h3>Search Results</h3>
        <div id="results-container" class="results-container"></div>
      </div>

      <!-- No Results -->
      <div id="no-results" class="no-results" style="display: none;">
        <p>No results found</p>
        <p class="no-results-hint">Try different keywords or browse categories</p>
      </div>
    </div>

    <div class="search-footer">
      <div class="search-hints">
        <span class="hint"><kbd>↑↓</kbd> Navigate</span>
        <span class="hint"><kbd>Enter</kbd> Select</span>
        <span class="hint"><kbd>ESC</kbd> Close</span>
        <span class="hint"><kbd>/</kbd> Focus search</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lessons }}>
  // Global search functionality
  let searchModal = null;
  let searchInput = null;
  let resultsContainer = null;
  let selectedIndex = -1;
  let searchableContent = [];
  let vaultDataLoaded = false;

  function initGlobalSearch() {
    searchModal = document.getElementById('global-search-modal');
    searchInput = document.getElementById('global-search-input');
    resultsContainer = document.getElementById('results-container');

    if (!searchModal || !searchInput) return;

    // Open search modal
    document.querySelectorAll('.nav-search').forEach(btn => {
      btn.addEventListener('click', openSearch);
    });

    // Close button
    document.getElementById('search-close')?.addEventListener('click', closeSearch);

    // Backdrop click
    document.querySelector('.search-modal-backdrop')?.addEventListener('click', closeSearch);

    // Search input
    searchInput.addEventListener('input', performSearch);

    // Keyboard shortcuts
    document.addEventListener('keydown', handleKeyboard);
  }

  async function loadVaultData() {
    if (vaultDataLoaded) return;

    try {
      // Dynamically import vault data only when needed
      const module = await import('/src/data/vault-data.js');
      const vaultData = module.vaultData;

      // Convert vault data to searchable format
      const vaultSearchable = vaultData.map(item => ({
        category: item.c,
        type: item.t || 'unknown',
        name: item.n,
        slug: `/vault/${item.c}/${item.s}`,
        description: item.d,
        tags: item.g || [],
        year: item.y
      }));

      // Combine lessons and vault data
      searchableContent = [...lessons, ...vaultSearchable];
      vaultDataLoaded = true;
    } catch (error) {
      console.error('Failed to load vault data:', error);
      // Fall back to just lessons
      searchableContent = lessons;
    }
  }

  async function openSearch() {
    if (!searchModal) return;

    // Load vault data if not already loaded
    await loadVaultData();

    searchModal.setAttribute('aria-hidden', 'false');
    searchModal.classList.add('is-open');
    searchInput?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeSearch() {
    if (!searchModal) return;
    searchModal.setAttribute('aria-hidden', 'true');
    searchModal.classList.remove('is-open');
    searchInput.value = '';
    document.getElementById('search-results').style.display = 'none';
    document.getElementById('no-results').style.display = 'none';
    document.querySelector('.search-quick-links').style.display = 'block';
    document.body.style.overflow = '';
    selectedIndex = -1;
  }

  function performSearch() {
    const query = searchInput.value.toLowerCase().trim();

    if (query.length < 2) {
      document.getElementById('search-results').style.display = 'none';
      document.getElementById('no-results').style.display = 'none';
      document.querySelector('.search-quick-links').style.display = 'block';
      return;
    }

    // Hide quick links, show results
    document.querySelector('.search-quick-links').style.display = 'none';

    // Search through content
    const results = searchableContent.filter(item => {
      const searchText = [
        item.name,
        item.description,
        ...(item.tags || []),
        item.category,
        item.type
      ].join(' ').toLowerCase();

      return searchText.includes(query);
    });

    displayResults(results);
  }

  function displayResults(results) {
    if (results.length === 0) {
      document.getElementById('search-results').style.display = 'none';
      document.getElementById('no-results').style.display = 'block';
      return;
    }

    document.getElementById('search-results').style.display = 'block';
    document.getElementById('no-results').style.display = 'none';

    // Group results by category
    const grouped = results.reduce((acc, item) => {
      if (!acc[item.category]) acc[item.category] = [];
      acc[item.category].push(item);
      return acc;
    }, {});

    // Build HTML
    let html = '';
    Object.entries(grouped).forEach(([category, items]) => {
      const categoryName = category === 'lesson' ? 'Lessons' :
                          category.charAt(0).toUpperCase() + category.slice(1);

      html += `
        <div class="result-group">
          <h4 class="result-category">${categoryName}</h4>
          <div class="result-list">
      `;

      items.forEach((item) => {
        const globalIndex = results.indexOf(item);
        const icon = category === 'lesson' ? '📚' : getIcon(item.category, item.type);

        html += `
          <a href="${item.slug}" class="result-item" data-index="${globalIndex}">
            <span class="result-icon">${icon}</span>
            <div class="result-content">
              <div class="result-name">${highlightMatch(item.name, searchInput.value)}</div>
              <div class="result-description">${item.description}</div>
              ${item.tags ? `
                <div class="result-tags">
                  ${item.tags.slice(0, 3).map(tag =>
                    `<span class="result-tag">${tag}</span>`
                  ).join('')}
                </div>
              ` : ''}
            </div>
          </a>
        `;
      });

      html += '</div></div>';
    });

    resultsContainer.innerHTML = html;
    selectedIndex = -1;
  }

  function highlightMatch(text, query) {
    const regex = new RegExp(`(${query})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
  }

  function getIcon(category, type) {
    const icons = {
      hardware: { computer: '🖥️', chip: '💾', console: '🎮', peripheral: '🖱️', default: '🔧' },
      people: { executive: '💼', engineer: '👷', designer: '🎨', programmer: '💻', default: '👤' },
      software: { game: '🎮', graphics: '🎨', music: '🎵', application: '💿', default: '💾' },
      techniques: { graphics: '🎨', sound: '🔊', programming: '💻', memory: '💾', default: '💡' },
      companies: { hardware: '🏭', software: '💿', publisher: '📦', default: '🏢' },
      games: { action: '⚔️', adventure: '🗺️', strategy: '♟️', default: '🎮' },
      emulators: { emulator: '💾', default: '💾' },
      groups: { demo: '🎨', cracking: '🔓', default: '👥' },
      publications: { magazine: '📖', book: '📘', newsletter: '📰', default: '📚' },
      events: { demoparty: '🎪', conference: '🎯', default: '🎪' },
      formats: { disk: '💿', audio: '🎵', graphics: '🎨', archive: '📦', default: '💾' },
      culture: { movement: '🌐', scene: '🎭', default: '🌐' },
      lesson: '📚',
      default: '📁'
    };

    const catIcons = icons[category] || icons.default;
    return typeof catIcons === 'object' ?
           (catIcons[type] || catIcons.default || '📁') :
           catIcons;
  }

  function handleKeyboard(e) {
    // Global shortcut: / to open search
    if (e.key === '/' && !searchModal?.classList.contains('is-open')) {
      e.preventDefault();
      openSearch();
      return;
    }

    // Only handle these if search is open
    if (!searchModal?.classList.contains('is-open')) return;

    // ESC to close
    if (e.key === 'Escape') {
      e.preventDefault();
      closeSearch();
      return;
    }

    // Arrow navigation
    const items = resultsContainer?.querySelectorAll('.result-item');
    if (!items || items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
      updateSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = Math.max(selectedIndex - 1, -1);
      updateSelection(items);
    } else if (e.key === 'Enter' && selectedIndex >= 0) {
      e.preventDefault();
      items[selectedIndex].click();
    }
  }

  function updateSelection(items) {
    items.forEach((item, index) => {
      if (index === selectedIndex) {
        item.classList.add('is-selected');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('is-selected');
      }
    });
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', initGlobalSearch);
  document.addEventListener('astro:page-load', initGlobalSearch);
</script>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .search-modal[aria-hidden="false"] {
    display: block;
  }

  .search-modal.is-open {
    opacity: 1;
  }

  .search-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .search-modal-content {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 700px;
    max-height: 70vh;
    background: var(--bg-primary, #ffffff);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
  }

  .search-input {
    flex: 1;
    padding: 0.75rem;
    font-size: 1.125rem;
    border: none;
    background: transparent;
    color: var(--text-primary, #1f2937);
    outline: none;
  }

  .search-close {
    padding: 0.5rem 0.75rem;
    background: var(--bg-secondary, #f3f4f6);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 6px;
    color: var(--text-secondary, #6b7280);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .search-close:hover {
    background: var(--bg-tertiary, #e5e7eb);
  }

  .search-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
  }

  .search-quick-links h3,
  .search-results h3 {
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .quick-link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--bg-secondary, #f3f4f6);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 8px;
    color: var(--text-primary, #1f2937);
    text-decoration: none;
    transition: all 0.2s;
  }

  .quick-link:hover {
    background: var(--bg-tertiary, #e5e7eb);
    transform: translateY(-1px);
  }

  .quick-link-icon {
    font-size: 1.25rem;
  }

  .result-group {
    margin-bottom: 1.5rem;
  }

  .result-category {
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .result-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .result-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--bg-secondary, #f3f4f6);
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-primary, #1f2937);
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }

  .result-item:hover,
  .result-item.is-selected {
    background: var(--bg-tertiary, #e5e7eb);
    border-color: var(--border-active, #8b5cf6);
  }

  .result-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .result-content {
    flex: 1;
    min-width: 0;
  }

  .result-name {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .result-name mark {
    background: rgba(139, 92, 246, 0.2);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }

  .result-description {
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-tags {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .result-tag {
    padding: 0.125rem 0.375rem;
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .no-results {
    text-align: center;
    padding: 3rem;
  }

  .no-results p {
    color: var(--text-secondary, #6b7280);
    margin-bottom: 0.5rem;
  }

  .no-results-hint {
    font-size: 0.875rem;
  }

  .search-footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
    background: var(--bg-secondary, #f3f4f6);
  }

  .search-hints {
    display: flex;
    gap: 1rem;
    justify-content: center;
    font-size: 0.875rem;
    color: var(--text-secondary, #6b7280);
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  kbd {
    padding: 0.125rem 0.375rem;
    background: var(--bg-primary, #ffffff);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: monospace;
  }
</style>