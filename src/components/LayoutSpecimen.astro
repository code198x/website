---
/**
 * The layout primitives (src/components/layout/), each with settings that make
 * its behaviour visible. tests/layout-primitives.spec.ts measures this page at
 * 320, 768 and 1440 px, so change the two together.
 */
import Stack from './layout/Stack.astro';
import Box from './layout/Box.astro';
import Center from './layout/Center.astro';
import Cluster from './layout/Cluster.astro';
import Sidebar from './layout/Sidebar.astro';
import Switcher from './layout/Switcher.astro';
import Grid from './layout/Grid.astro';
import Cover from './layout/Cover.astro';
import Reel from './layout/Reel.astro';
import Frame from './layout/Frame.astro';

const tags = ['Spectrum', 'Commodore 64', 'Amiga', 'NES', 'BBC Micro', 'Amstrad CPC', 'MSX', 'Atari 800'];
---
<Center as="main" max="frame" gutters="page" class="layout-specimen">
  <Stack space={12}>
    <header>
      <h1>Layout primitives</h1>
      <p><a href="/catalogue/">All components</a> · resize the window to watch each one adapt without a breakpoint.</p>
    </header>

    <section>
      <h2>Stack</h2>
      <Stack space={6} data-specimen="stack">
        <p>Children lose the browser's paragraph margins.</p>
        <p>One gap separates each from the next.</p>
        <p>Here it is step 6 of the scale, 1.5rem.</p>
      </Stack>
    </section>

    <section>
      <h2>Box</h2>
      <Box padding={6} border data-specimen="box"><p class="flush">Padding from the scale and the kit's hairline.</p></Box>
    </section>

    <section>
      <h2>Center</h2>
      <Center max="40rem" gutters={4} data-specimen="center" class="tinted"><p class="flush">At most 40rem wide, gutters included, and centred.</p></Center>
    </section>

    <section>
      <h2>Cluster</h2>
      <Cluster space={2} data-specimen="cluster">
        {tags.map(tag => <span class="chip">{tag}</span>)}
      </Cluster>
    </section>

    <section>
      <h2>Sidebar</h2>
      <Sidebar sideWidth="15rem" contentMin="50%" space={6} data-specimen="sidebar">
        <div class="tinted cell">The sidebar, 15rem while there is room.</div>
        <div class="tinted cell">The main pane. When it would be narrower than half the width, the two stack.</div>
      </Sidebar>
    </section>

    <section>
      <h2>Switcher</h2>
      <Switcher threshold="40rem" space={4} data-specimen="switcher">
        <div class="tinted cell">One</div>
        <div class="tinted cell">Two</div>
        <div class="tinted cell">Three</div>
      </Switcher>
    </section>

    <section>
      <h2>Grid</h2>
      <Grid min="12rem" space={4} data-specimen="grid">
        {Array.from({ length: 6 }, (_, i) => <div class="tinted cell">Cell {i + 1}</div>)}
      </Grid>
    </section>

    <section>
      <h2>Cover</h2>
      <Cover min="20rem" padding={6} class="tinted" data-specimen="cover">
        <p class="flush">Above</p>
        <h3 data-cover-centre>Centred in the space left</h3>
        <p class="flush">Below</p>
      </Cover>
    </section>

    <section>
      <h2>Reel</h2>
      <Reel itemWidth="12rem" space={4} data-specimen="reel">
        {Array.from({ length: 8 }, (_, i) => <div class="tinted cell">Item {i + 1}</div>)}
      </Reel>
    </section>

    <section>
      <h2>Frame</h2>
      <div class="frame-holder">
        <Frame ratio="4 / 3" data-specimen="frame">
          <svg viewBox="0 0 400 100" role="img" aria-label="A wide illustration cropped to 4:3"><rect width="400" height="100" fill="var(--h-wash)"/><circle cx="200" cy="50" r="40" fill="var(--h-ink-muted)"/></svg>
        </Frame>
      </div>
    </section>
  </Stack>
</Center>

<style>
  @layer blocks {
    .layout-specimen { padding-block: var(--h-space-8); }
    .flush { margin: 0; }
    .tinted { background: var(--h-wash); }
    .cell { padding: var(--h-space-2); }
    .chip { inline-size: 7rem; padding: var(--h-space-1) var(--h-space-2); border: 1px solid var(--h-line); }
    .frame-holder { max-inline-size: 24rem; }
  }
</style>
