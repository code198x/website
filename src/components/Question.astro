---
/**
 * A visible thinking prompt with an optional, keyboard-accessible explanation.
 *
 * The concept's question and answer (lesson.html, .question and
 * details.answer): the prompt in the interface face at weight, and a
 * disclosure whose caret turns as it opens. Kept as a quiet square panel, so
 * a question still stands apart from the explanation around it (Code198x
 * docs/specifications/unit.md, "Presenting questions"); square because it is
 * interface (family-visual-identity.md §7).
 *
 * Predict, then reveal: when the next thing in the lesson is a capture, the
 * page covers that capture until the reader asks to see it or opens the
 * explanation (lesson-predict.ts). Without JavaScript nothing is covered.
 */
interface Props { prompt: string; }
const { prompt } = Astro.props;
---
<div class="question" data-question>
  <p class="question-label" aria-hidden="true">Predict it!</p>
  <p class="question-prompt">{prompt}</p>
  <details>
    <summary>Show the explanation</summary>
    <div class="question-answer"><slot /></div>
  </details>
</div>
<style>
  .question {
    position: relative; box-sizing: border-box; margin-block: var(--h-space-12) var(--h-space-8);
    padding: calc(var(--h-cell) * 4) calc(var(--h-cell) * 3.5) calc(var(--h-cell) * 2);
    background: var(--h-mag-yellow); color: var(--h-ink); box-shadow: 7px 7px 0 var(--h-ink);
    --h-accent-ink: var(--h-ink);
  }
  .question .question-label {
    position: absolute; top: -1rem; left: calc(var(--h-cell) * 3); margin: 0; padding: 0.15rem 0.75rem 0.25rem;
    background: var(--h-ink); color: var(--h-mag-yellow); font-family: var(--h-font-mag); font-style: italic; font-weight: 900;
    font-size: 1.375rem; line-height: 1.1; letter-spacing: 0; text-transform: uppercase; transform: rotate(-2deg);
  }
  /* Interface, not reading: the prompt is a thing to answer. */
  .question .question-prompt {
    margin: 0;
    color: var(--h-ink);
    font-family: var(--h-font-ui);
    font-size: var(--h-text-h4);
    line-height: var(--h-lh-h4);
    font-weight: var(--h-weight-minor);
  }
  .question summary {
    display: inline-flex;
    align-items: center;
    gap: var(--h-cell);
    min-height: calc(var(--h-cell) * 6);
    margin-top: var(--h-cell);
    color: var(--h-ink);
    font-family: var(--h-font-ui);
    font-size: var(--h-text-small);
    font-weight: var(--h-weight-minor);
    list-style: none;
    cursor: pointer;
  }
  .question summary::-webkit-details-marker { display: none; }
  /* The caret turns instantly: feedback, not motion (§6). */
  .question summary::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    margin-right: 0.15em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }
  .question details[open] > summary::before { transform: rotate(45deg); }
  .question summary:hover { color: var(--h-ink); text-decoration: underline; }
  .question summary:focus-visible { outline: 2px solid var(--h-ink); outline-offset: 2px; }
  .question-answer { padding-bottom: calc(var(--h-cell) * 1.5); }
  .question-answer :global(:first-child) { margin-top: var(--h-cell); }
  .question-answer :global(:last-child) { margin-bottom: 0; }
  @media print {
    .question { background: none; break-inside: avoid; }
    .question summary { display: none; }
    .question details::details-content { content-visibility: visible; height: auto; }
  }
</style>
