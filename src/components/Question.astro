---
/** A visible thinking prompt with an optional, keyboard-accessible explanation. */
interface Props { prompt: string; }
const { prompt } = Astro.props;
---
<div class="question">
  <p class="question-prompt">{prompt}</p>
  <details>
    <summary>Show the explanation</summary>
    <div class="question-answer"><slot /></div>
  </details>
</div>
<style>
  .question {
    margin-block: var(--space-8, 2rem);
    padding: var(--space-4, 1rem) var(--space-6, 1.5rem);
    border-inline-start: 2px solid var(--color-border);
    background: color-mix(in srgb, var(--color-text) 4%, transparent);
    color: var(--color-text);
  }
  .question .question-prompt { margin: 0; font-weight: 600; }
  .question summary {
    display: list-item;
    width: fit-content;
    min-height: 44px;
    padding-block: 0.65rem;
    cursor: pointer;
    font-size: 0.9em;
  }
  .question summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .question-answer :global(:first-child) { margin-top: 0.5rem; }
  .question-answer :global(:last-child) { margin-bottom: 0; }
  @media print {
    .question { background: none; break-inside: avoid; }
    .question summary { display: none; }
    .question details::details-content { content-visibility: visible; height: auto; }
  }
</style>
