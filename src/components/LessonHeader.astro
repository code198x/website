---
import { getSystemColors, getDifficultyIcon } from "../utils/systemColors.js";
import type { BreadcrumbItem } from "./Breadcrumb.astro";

export interface Props {
  system: string;
  systemName?: string;
  badge?: {
    number?: number | string;
    text?: string;
    size?: "small" | "medium" | "large";
  };
  title: string;
  description?: string;
  meta?: Array<{
    label: string;
    value: string | number;
    icon?: string;
    type?: "default" | "success" | "warning";
  }>;
  breadcrumbs?: BreadcrumbItem[];
  concepts?: string[];
  difficulty?: string;
  className?: string;
}

const {
  system,
  badge,
  title,
  description,
  meta = [],
  breadcrumbs,
  concepts,
  difficulty,
  className = "",
} = Astro.props;

const colors = getSystemColors(system);
const badgeSize = badge?.size || "medium";
---

<div class={`lesson-header ${colors.className} ${className}`}>
  <div class="container">
    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <nav class="lesson-breadcrumb">
          <div class="lesson-breadcrumb-list">
            {breadcrumbs.map((item, index) => (
              <>
                {item.href ? (
                  <a href={item.href} class="lesson-breadcrumb-link">
                    {item.icon && <span class="breadcrumb-icon">{item.icon}</span>}
                    {item.label}
                  </a>
                ) : (
                  <span>
                    {item.icon && <span class="breadcrumb-icon">{item.icon}</span>}
                    {item.label}
                  </span>
                )}
                {index < breadcrumbs.length - 1 && (
                  <span class="lesson-breadcrumb-separator">→</span>
                )}
              </>
            ))}
          </div>
        </nav>
      )
    }

    <div class="lesson-header-content">
      {
        badge && (badge.number || badge.text) && (
          <div class={`lesson-header-badge ${badgeSize}`}>{badge.number || badge.text}</div>
        )
      }
      <div class="lesson-header-info">
        <h1 class="lesson-header-title">{title}</h1>
        {description && <p class="lesson-header-subtitle">{description}</p>}

        {
          meta.length > 0 && (
            <div class="lesson-header-meta">
              {meta.map((item) => {
                const metaClass = item.type
                  ? `lesson-meta-badge ${item.type}`
                  : "lesson-meta-badge";
                return (
                  <span class={metaClass}>
                    {item.icon && item.icon} {item.label}: {item.value}
                  </span>
                );
              })}
            </div>
          )
        }

        {
          difficulty && (
            <div class="lesson-header-meta">
              <span class="lesson-meta-badge">
                {getDifficultyIcon(difficulty)} {difficulty}
              </span>
            </div>
          )
        }

        {
          concepts && concepts.length > 0 && (
            <div class="tier-concepts">
              {concepts.map((concept) => (
                <span class="tier-concept-badge">{concept}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .breadcrumb-icon {
    margin-right: 0.25rem;
    font-size: 0.875rem;
  }

  .lesson-header {
    position: relative;
    padding: var(--space-xl) 0;
    margin-bottom: var(--space-xl);
    background: var(--lesson-gradient);
    overflow: hidden;
  }

  .lesson-header::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--lesson-pattern);
    opacity: 0.1;
  }

  .lesson-header .container {
    position: relative;
    z-index: 1;
  }

  .lesson-breadcrumb {
    margin-bottom: var(--space-md);
  }

  .lesson-breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--font-size-sm);
  }

  .lesson-breadcrumb-link {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lesson-breadcrumb-link:hover {
    color: rgba(255, 255, 255, 1);
  }

  .lesson-breadcrumb-separator {
    color: rgba(255, 255, 255, 0.5);
  }

  .lesson-header-content {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .lesson-header-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    color: white;
    font-weight: 700;
    border-radius: var(--border-radius-lg);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .lesson-header-badge.small {
    width: 60px;
    height: 60px;
    font-size: var(--font-size-lg);
  }

  .lesson-header-badge.medium {
    width: 80px;
    height: 80px;
    font-size: var(--font-size-xl);
  }

  .lesson-header-badge.large {
    width: 100px;
    height: 100px;
    font-size: var(--font-size-2xl);
  }

  .lesson-header-info {
    flex: 1;
    color: white;
  }

  .lesson-header-title {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-4xl);
    font-weight: 700;
    line-height: 1.1;
  }

  .lesson-header-subtitle {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }

  .lesson-header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .lesson-meta-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm);
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .lesson-meta-badge.success {
    background: rgba(72, 187, 120, 0.3);
    border: 1px solid rgba(72, 187, 120, 0.5);
  }

  .lesson-meta-badge.warning {
    background: rgba(245, 158, 11, 0.3);
    border: 1px solid rgba(245, 158, 11, 0.5);
  }

  .tier-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .tier-concept-badge {
    padding: var(--space-2xs) var(--space-sm);
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .lesson-header-content {
      flex-direction: column;
      gap: var(--space-md);
    }

    .lesson-header-badge {
      align-self: center;
    }

    .lesson-header-title {
      font-size: var(--font-size-2xl);
    }

    .lesson-header-subtitle {
      font-size: var(--font-size-base);
    }
  }
</style>
