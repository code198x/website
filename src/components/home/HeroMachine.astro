---
/**
 * The homepage hero's machine: the first program in the course, typed on the
 * left, and the real screen it makes on the right.
 *
 * Governed by family-visual-identity.md §6 and §7:
 *
 * - The machine is the hero. The listing is typed as a 48K takes it (a
 *   keyword arrives whole on one key, a string a letter at a time), then RUN
 *   reveals the screen. Both are on §6's allowed list, and both run once per
 *   visit and stop.
 * - Nothing above the fold moves the layout: the listing box is three lines
 *   tall from the start, and the two screens share one cell.
 * - The screens are the kit's Screen, at 1x of their true grid. Before RUN
 *   the tube shows the 48K as it starts, our own Emu198x capture; after RUN,
 *   the lesson's own capture of the program's output.
 * - Under prefers-reduced-motion: reduce nothing types and nothing swaps:
 *   the finished listing and the program's screen show at once. Without
 *   JavaScript the same finished state shows.
 *
 * The typed copy is aria-hidden; the finished listing is in the accessible
 * text once, so a screen reader hears the program, not each keystroke.
 */
import Shell from '@198x-ui/components/Shell.astro';
import Screen from '@198x-ui/components/Screen.astro';

type Kind = 'num' | 'kw' | 'str';
const lines: Array<Array<[string, Kind]>> = [
  [['10 ', 'num'], ['PRINT', 'kw'], [' "Hello"', 'str']],
  [['20 ', 'num'], ['PRINT', 'kw'], [' "from the Spectrum"', 'str']],
  [['RUN', 'kw']],
];
const plain = lines.map((l) => l.map(([t]) => t).join('')).join(', then ');
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const finished = lines
  .map((l) => l.map(([t, k]) => (k === 'num' ? esc(t) : `<span class="${k}">${esc(t)}</span>`)).join(''))
  .join('\n');
---

<Shell variant="device" as="figure" class="hero-machine">
  <div class="machine-top">
    <span><span class="lamp" aria-hidden="true"></span>ZX Spectrum 48K</span>
    <span>Meet BASIC, unit 1</span>
  </div>
  <div class="machine-fit">
  <div class="machine-body" data-hero-machine>
    <span class="col-label col-type" aria-hidden="true">You type</span>
    <span class="col-label col-print" aria-hidden="true">It prints</span>
    <div class="listing">
      <span class="sr-only">You type: {plain}.</span>
      <span class="typed" data-listing aria-hidden="true" set:html={finished} data-lines={JSON.stringify(lines)}></span>
    </div>
    <div class="screens ran" data-screens>
      <Screen
        class="boot"
        src="/images/sinclair-zx-spectrum/machine/meet-the-machine/unit-01/boot-screen.png"
        alt=""
        decorative
        width={352}
        height={296}
        loading="eager"
      />
      <Screen
        class="result"
        src="/images/sinclair-zx-spectrum/basic/meet-basic/unit-01/step-02-two-lines.png"
        alt="The Spectrum screen after RUN: Hello, then from the Spectrum, and the report 0 OK, 20:1."
        width={352}
        height={296}
        loading="eager"
      />
    </div>
  </div>
  </div>
  <Fragment slot="caption">The first program in the course, and the real screen it makes in our emulator.</Fragment>
</Shell>

<style>
  .hero-machine :global(.h-shell-core) { padding: calc(var(--h-cell) * 2.5); }
  .machine-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--h-cell);
    flex-wrap: wrap;
    padding: 0 0 calc(var(--h-cell) * 2);
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    line-height: 1;
    color: var(--h-ink-muted);
  }
  /* The power light: an object, so round, and the machine lighting itself. */
  .lamp {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: var(--h-cell);
    border-radius: 50%;
    background: #c20000;
    box-shadow: 0 0 10px #c20000;
    vertical-align: middle;
  }

  /* Side by side only where the screen fits at 1x beside a listing wide
     enough for its longest line; otherwise the listing sits above it. */
  .machine-fit { container-type: inline-size; }
  .machine-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(352px + 1.2rem);
    grid-template-areas: 'l1 l2' 'list crt';
    gap: calc(var(--h-cell) * 1.5) calc(var(--h-cell) * 3);
    align-items: start;
  }
  .col-type { grid-area: l1; }
  .col-print { grid-area: l2; }
  .listing { grid-area: list; }
  .screens { grid-area: crt; }

  .col-label {
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--h-ink-muted);
  }

  /* Three lines tall from the first frame, so typing never moves the page. */
  .listing {
    box-sizing: border-box;
    min-height: calc(3 * 1.8em + 2rem);
    padding: 1rem 1.1rem;
    border: 1px solid var(--h-line);
    background: var(--h-shell);
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    line-height: 1.8;
    color: var(--h-ink);
    white-space: pre;
    overflow: hidden;
    font-variant-ligatures: none;
  }
  .listing :global(.kw) { color: var(--h-accent-ink); }
  .listing :global(.str) { color: var(--h-syn-str); }
  /* The 48K's cursor: K for a keyword, L for a letter. It flashes as the
     machine's did, and only while typing; the finished listing has none. */
  .listing :global(.cursor) {
    display: inline-block;
    padding: 0 0.1em;
    line-height: 1.3;
    background: var(--h-ink);
    color: var(--h-ground);
    animation: hero-cursor 640ms steps(1) infinite;
  }
  @keyframes hero-cursor { 50% { background: var(--h-ground); color: var(--h-ink); } }

  /* Both screens in one cell. Before RUN the boot screen shows; RUN swaps to
     the program's screen at once, as the machine did. */
  .screens { display: grid; justify-items: start; }
  .screens > :global(.h-screen) { grid-area: 1 / 1; }
  .screens > :global(.result) { opacity: 0; }
  .screens.ran > :global(.result) { opacity: 1; }
  .screens.ran > :global(.boot) { opacity: 0; }

  .hero-machine :global(.h-shell-caption) { padding-top: calc(var(--h-cell) * 1.5); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @container (max-width: 680px) {
    .machine-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'l1' 'list' 'l2' 'crt';
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .listing :global(.cursor) { animation: none; }
  }
</style>

<script>
  /* Typed once per visit, then RUN. A soft navigation brings a new page, so
     this runs on every astro:page-load and binds each machine only once. */
  type Kind = 'num' | 'kw' | 'str';
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const span = ([t, k]: [string, Kind]) => (k === 'num' ? esc(t) : `<span class="${k}">${esc(t)}</span>`);

  async function type(body: HTMLElement) {
    const listing = body.querySelector<HTMLElement>('[data-listing]')!;
    const screens = body.querySelector<HTMLElement>('[data-screens]')!;
    const lines = JSON.parse(listing.dataset.lines ?? '[]') as Array<Array<[string, Kind]>>;
    if (reduce()) return; // the finished state is already in the markup
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    screens.classList.remove('ran');
    const done: string[] = [];
    for (const line of lines) {
      const typed: Array<[string, Kind]> = [];
      const render = (mode: string) => {
        listing.innerHTML = done.map((d) => d + '\n').join('') + typed.map(span).join('') + `<span class="cursor">${mode}</span>`;
      };
      render('K');
      await wait(500);
      for (const [text, kind] of line) {
        if (kind === 'kw') { typed.push([text, 'kw']); render('L'); await wait(420); continue; }
        typed.push(['', kind]);
        for (const ch of text) {
          typed[typed.length - 1] = [typed[typed.length - 1][0] + ch, kind];
          render(kind === 'num' ? 'K' : 'L');
          await wait(kind === 'num' ? 90 : 70);
        }
      }
      await wait(380);
      done.push(typed.map(span).join(''));
    }
    listing.innerHTML = done.join('\n');
    await wait(250);
    screens.classList.add('ran');
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-hero-machine]:not([data-bound])').forEach((body) => {
      body.dataset.bound = 'true';
      void type(body);
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
