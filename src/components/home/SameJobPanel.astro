---
/**
 * One machine's panel in the homepage explorer (SameJob.astro): its name,
 * the snippet in each language it is taught in, and the small TV.
 *
 * The languages are the kit's Tabs. Tabs takes one named slot per panel, and
 * Astro cannot name a slot from inside a .map(), so the slots are written out
 * below; a machine taught in more languages than there are slots fails the
 * build rather than lose one.
 */
import Tabs from '@198x-ui/components/Tabs.astro';
import Listing from '@198x-ui/components/Listing.astro';
import type { SameJob } from '../../data/same-job';

interface Props {
  id: string;
  name: string;
  shortName: string;
  cpu: string;
  year: number;
  job: SameJob;
}
const { id, name, shortName, cpu, year, job } = Astro.props;
const langs = Object.values(job.langs);
const SLOTS = 4;
if (langs.length > SLOTS) throw new Error(`[home] ${id} has ${langs.length} languages; SameJobPanel has slots for ${SLOTS}.`);

/* Keywords to colour: the statements and mnemonics the snippets use. */
const keywords = ['BORDER', 'POKE', 'Colour', 'RGB', 'ld', 'out', 'lda', 'sta', 'move.w'];
const listing = (k: number) => ({ code: langs[k].code, label: `${langs[k].label}: paint the screen red`, keywords, comment: ';' });
const tvStyle = [`--red:${job.red}`, job.border0 && `--border0:${job.border0}`, job.paper && `--paper:${job.paper}`].filter(Boolean).join(';');
---

<div class="panel">
  <div>
    <h3>{name}</h3>
    <p class="cpu">{cpu}, {year} · {langs.length} {langs.length === 1 ? 'language' : 'languages'}</p>
  </div>
  <div class="panel-body">
    <div class="code">
      {langs.length > 1 ? (
        <Tabs id={`same-job-${id}`} class="langs" label={`${shortName} language`} items={langs.map((l) => ({ label: l.label }))}>
          {langs[0] && <Listing slot="panel-0" {...listing(0)} />}
          {langs[1] && <Listing slot="panel-1" {...listing(1)} />}
          {langs[2] && <Listing slot="panel-2" {...listing(2)} />}
          {langs[3] && <Listing slot="panel-3" {...listing(3)} />}
        </Tabs>
      ) : (
        <>
          <p class="one-lang">{langs[0].label}</p>
          <Listing {...listing(0)} />
        </>
      )}
    </div>
    <div class="result">
      <div class="tv" data-tv data-fill={job.fill} style={tvStyle} aria-hidden="true"></div>
      <p class="note">{job.note}</p>
    </div>
  </div>
  <a class="open" href={`/systems/${id}/`}>Open the {shortName}</a>
</div>

<style>
  .panel { display: grid; gap: calc(var(--h-cell) * 3); }
  h3 {
    margin: 0;
    font-family: var(--h-font-ui);
    font-size: clamp(1.8rem, 3vw, var(--h-text-h2));
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--h-ink);
  }
  .cpu { margin: calc(var(--h-cell) * 1.5) 0 0; font-family: var(--h-font-mono); font-size: var(--h-text-micro); color: var(--h-ink-muted); }
  .panel-body { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: calc(var(--h-cell) * 4); align-items: start; }
  .code :global(.h-listing) { font-size: clamp(1rem, 1.5vw, 1.25rem); }
  /* With one language there is nothing to choose: its name, shown as the
     current tab would be. */
  .one-lang {
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--h-cell) * 5);
    margin: 0 0 calc(var(--h-cell) * 2);
    padding: 0 calc(var(--h-cell) * 2);
    border: 1px solid var(--h-line);
    color: var(--h-ink-body);
    font-size: var(--h-text-micro);
    font-weight: var(--h-weight-minor);
  }
  .result { display: grid; gap: calc(var(--h-cell) * 2); align-content: start; }
  .note { margin: 0; font-family: var(--h-font-read); font-style: italic; font-size: var(--h-text-small); line-height: var(--h-lh-small); color: var(--h-ink-muted); }
  .open {
    justify-self: start;
    font-weight: var(--h-weight-minor);
    color: var(--h-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* A small tube: an object, so round. Before the change it shows the machine
     as it starts; lit, what the snippet paints (the border, or the whole
     screen). Hardware, so dark in both themes. */
  .tv {
    position: relative;
    width: calc(100% - 0.8rem);
    max-width: 24rem;
    aspect-ratio: 4 / 3;
    margin: 0.4rem;
    border-radius: 1rem / 1.2rem;
    overflow: hidden;
    background: var(--border0, #1b1916);
    box-shadow: 0 0 0 0.4rem var(--h-screen-bezel), 0 0 0 calc(0.4rem + 1px) var(--h-screen-rim);
    transition: background-color 700ms var(--h-ease), box-shadow 700ms var(--h-ease);
  }
  .tv::before {
    content: "";
    position: absolute;
    inset: 15% 12.5%;
    background: var(--paper, var(--h-screen-glass));
    transition: background-color 700ms var(--h-ease);
  }
  .tv::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / 0.45) 100%);
    box-shadow: inset 0 0 30px rgb(0 0 0 / 0.5);
  }
  .tv.lit {
    background: var(--red);
    box-shadow:
      0 0 0 0.4rem var(--h-screen-bezel),
      0 0 0 calc(0.4rem + 1px) var(--h-screen-rim),
      0 0 60px -6px color-mix(in srgb, var(--red) 60%, transparent);
  }
  .tv.lit[data-fill="screen"]::before { background: var(--red); }

  @media (max-width: 767px) {
    .panel-body { grid-template-columns: minmax(0, 1fr); }
    .code :global(.h-listing) { font-size: var(--h-text-micro); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tv, .tv::before { transition: none; }
  }
</style>
