---
export interface Props {
  title?: string;
  highlightRegion?: string;
  showAddresses?: boolean;
  activeAddress?: string;
  showData?: boolean;
}

const { 
  title = "Commodore 64 Memory Map",
  highlightRegion = "",
  showAddresses = true,
  activeAddress = "",
  showData = false
} = Astro.props;

interface MemoryRegion {
  start: string;
  end: string;
  name: string;
  description: string;
  color: string;
  textColor: string;
  usage: string;
}

const memoryRegions: MemoryRegion[] = [
  {
    start: "$0000",
    end: "$00FF", 
    name: "Zero Page",
    description: "Fast access memory for variables and pointers",
    color: "bg-blue-600",
    textColor: "text-blue-100",
    usage: "Variables, temp storage"
  },
  {
    start: "$0100",
    end: "$01FF",
    name: "Stack",
    description: "Processor stack for subroutines and interrupts", 
    color: "bg-purple-600",
    textColor: "text-purple-100",
    usage: "Subroutine returns"
  },
  {
    start: "$0200",
    end: "$03FF",
    name: "User RAM",
    description: "General purpose RAM for programs",
    color: "bg-green-600", 
    textColor: "text-green-100",
    usage: "Program variables"
  },
  {
    start: "$0400",
    end: "$07E7",
    name: "Screen RAM",
    description: "Character codes displayed on screen (1000 bytes)",
    color: "bg-yellow-700",
    textColor: "text-yellow-50", 
    usage: "Screen characters"
  },
  {
    start: "$07E8",
    end: "$0FFF",
    name: "User RAM",
    description: "More general purpose RAM",
    color: "bg-green-600",
    textColor: "text-green-100",
    usage: "Program data"
  },
  {
    start: "$1000",
    end: "$9FFF",
    name: "User RAM",
    description: "Main program area (36KB)",
    color: "bg-green-700",
    textColor: "text-green-100",
    usage: "Programs & data"
  },
  {
    start: "$A000",
    end: "$BFFF", 
    name: "BASIC ROM",
    description: "BASIC interpreter (8KB)",
    color: "bg-red-700",
    textColor: "text-red-50",
    usage: "BASIC commands"
  },
  {
    start: "$C000",
    end: "$CFFF",
    name: "User RAM",
    description: "RAM under BASIC ROM (4KB)",
    color: "bg-green-600",
    textColor: "text-green-100", 
    usage: "Program storage"
  },
  {
    start: "$D000",
    end: "$DFFF",
    name: "I/O & Color",
    description: "VIC-II, SID, CIA chips & color RAM",
    color: "bg-orange-700",
    textColor: "text-orange-50",
    usage: "Hardware control"
  },
  {
    start: "$E000",
    end: "$FFFF",
    name: "KERNAL ROM", 
    description: "Operating system routines (8KB)",
    color: "bg-red-800",
    textColor: "text-red-50",
    usage: "OS functions"
  }
];

function isHighlighted(region: MemoryRegion): boolean {
  if (!highlightRegion) return false;
  return region.name.toLowerCase().includes(highlightRegion.toLowerCase()) ||
         region.description.toLowerCase().includes(highlightRegion.toLowerCase());
}

function isActiveAddress(region: MemoryRegion): boolean {
  if (!activeAddress) return false;
  const addr = parseInt(activeAddress.replace('$', ''), 16);
  const start = parseInt(region.start.replace('$', ''), 16);
  const end = parseInt(region.end.replace('$', ''), 16);
  return addr >= start && addr <= end;
}

function calculateHeight(region: MemoryRegion): string {
  const start = parseInt(region.start.replace('$', ''), 16);
  const end = parseInt(region.end.replace('$', ''), 16);
  const size = end - start + 1;
  
  // Logarithmic scaling for better visual representation
  const logSize = Math.log(size + 1);
  const maxLog = Math.log(65536); // 64KB total
  const percentage = (logSize / maxLog) * 100;
  return `${Math.max(8, Math.min(percentage, 20))}%`;
}
---

<div class="bg-gray-900 rounded-lg p-6 border border-gray-700">
  <h3 class="memory-map-title text-lg font-bold text-green-400 mb-4 text-center">{title}</h3>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Memory Map Visualization -->
    <div class="bg-black rounded-lg p-4">
      <h4 class="memory-map-subtitle text-sm font-bold text-gray-300 mb-3">64KB Address Space</h4>
      <div class="space-y-1">
        {memoryRegions.map((region) => (
          <div 
            class={`
              ${region.color} ${region.textColor} 
              rounded p-2 border-2 transition-all duration-300
              ${isHighlighted(region) ? 'border-yellow-400 ring-2 ring-yellow-400' : 'border-transparent'}
              ${isActiveAddress(region) ? 'border-red-400 ring-2 ring-red-400' : ''}
            `}
            style={`height: ${calculateHeight(region)}`}
          >
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="font-bold">{region.name}</span>
              {showAddresses && (
                <span>{region.start}-{region.end}</span>
              )}
            </div>
            <div class="text-xs opacity-75 mt-1">{region.description}</div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Memory Details -->
    <div class="space-y-4">
      <div class="bg-gray-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-gray-300 mb-3">Memory Overview</h4>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-400">Total RAM:</span>
            <span class="text-white font-mono">64KB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Available RAM:</span>
            <span class="text-white font-mono">~38KB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Screen Memory:</span>
            <span class="text-white font-mono">1KB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Zero Page:</span>
            <span class="text-white font-mono">256 bytes</span>
          </div>
        </div>
      </div>
      
      <!-- Key Addresses -->
      <div class="bg-gray-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-gray-300 mb-3">Important Addresses</h4>
        <div class="space-y-1 text-xs font-mono">
          <div class="flex justify-between">
            <span class="text-yellow-300">$0400:</span>
            <span class="text-yellow-100">Screen memory start</span>
          </div>
          <div class="flex justify-between">
            <span class="text-orange-300">$D000:</span>
            <span class="text-orange-100">VIC-II chip</span>
          </div>
          <div class="flex justify-between">
            <span class="text-orange-300">$D400:</span>
            <span class="text-orange-100">SID sound chip</span>
          </div>
          <div class="flex justify-between">
            <span class="text-orange-300">$D800:</span>
            <span class="text-orange-100">Color RAM</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-300">$FFD2:</span>
            <span class="text-red-100">CHROUT routine</span>
          </div>
        </div>
      </div>
      
      <!-- Programming Tips -->
      <div class="bg-gray-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-gray-300 mb-3">Programming Tips</h4>
        <div class="space-y-2 text-xs">
          <div class="text-blue-200">
            <strong>Zero Page:</strong> Fastest memory access
          </div>
          <div class="text-green-200">
            <strong>$0801:</strong> BASIC program start
          </div>
          <div class="text-yellow-200">
            <strong>Screen RAM:</strong> Direct character control
          </div>
          <div class="text-orange-200">
            <strong>I/O Area:</strong> Hardware programming
          </div>
        </div>
      </div>
    </div>
  </div>
  
  {showData && (
    <div class="mt-6 pt-4 border-t border-gray-700">
      <h4 class="memory-map-subtitle text-sm font-bold text-gray-300 mb-3">Memory Banking</h4>
      <div class="bg-black rounded-lg p-4 text-xs">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <div class="text-green-400 mb-2">Bank Switching:</div>
            <div class="space-y-1 text-gray-300">
              <div>• BASIC ROM can be switched out</div>
              <div>• Reveals 8KB more RAM at $A000-$BFFF</div>
              <div>• KERNAL ROM can be switched out</div>
              <div>• Reveals 8KB more RAM at $E000-$FFFF</div>
            </div>
          </div>
          <div>
            <div class="text-green-400 mb-2">Control Register:</div>
            <div class="space-y-1 text-gray-300">
              <div>• Address: $0001</div>
              <div>• Bit 0: BASIC ROM (0=RAM, 1=ROM)</div>
              <div>• Bit 1: KERNAL ROM (0=RAM, 1=ROM)</div>
              <div>• Bit 2: Character ROM (0=RAM, 1=ROM)</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .memory-region {
    transition: all 0.3s ease;
  }
  
  .memory-region:hover {
    transform: scale(1.02);
    z-index: 10;
  }

  /* Override lesson content heading styles */
  .memory-map-title {
    color: rgb(74 222 128) !important; /* text-green-400 */
    font-size: 1.125rem !important; /* text-lg */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 1rem !important; /* mb-4 */
    text-align: center !important;
  }

  .memory-map-subtitle {
    color: rgb(209 213 219) !important; /* text-gray-300 */
    font-size: 0.875rem !important; /* text-sm */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 0.75rem !important; /* mb-3 */
  }

  /* Override strong text in memory map content */
  .bg-gray-800 strong,
  .bg-black strong {
    color: rgb(255 255 255) !important; /* text-white */
    font-weight: 700 !important;
  }
</style>