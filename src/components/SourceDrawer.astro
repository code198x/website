---
interface Props { class?: string; label?: string; open?: boolean; }
const { class: className, label = 'Source · view and edit', open = false } = Astro.props;
---
<details class:list={['source-drawer', className]} open={open}>
  <summary>{label}</summary>
  <div class="source-drawer-content"><slot /></div>
</details>
<style>
  .source-drawer { min-width: 0; width: 100%; border-top: 1px solid var(--h-line); }
  summary { min-height: 44px; padding: 12px 0; color: var(--h-ink); cursor: pointer; font: 400 14px/1.5 var(--h-font-mono); }
  .source-drawer-content { min-width: 0; padding-block: 8px; }
</style>
