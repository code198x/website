---
import catalog from '../../public/emulators/catalog.json';
import RunPanel from './RunPanel.astro';
import {stageWidth} from '../lib/player-posters';
import {playerFirmwareNote} from '../lib/player-firmware';
interface Props {system:string;name:string}
const {system,name}=Astro.props;
const entry=catalog.find(item=>item.id===system||item.aliases.includes(system));
const variant=entry?.variantAliases?.[system]??entry?.defaultVariant;
const model=entry?.variants.find(item=>item.id===variant)?.name??name;
---
{entry&&<section class="system-launcher"><h2>Try the machine</h2><p>{playerFirmwareNote(entry,variant)}</p><button hidden type="button" class="system-play" data-run-system={entry.id} data-run-variant={variant} data-run-title={name} data-run-model={model} data-run-width={stageWidth(system,name)}>Play the {name}</button><p class="runit-status" role="status"></p><RunPanel/></section>}
<script>
function initialise(){for(const button of document.querySelectorAll<HTMLButtonElement>('.system-play:not([data-bound])')){button.dataset.bound='true';button.hidden=false;button.addEventListener('click',()=>document.dispatchEvent(new CustomEvent('runit:open',{detail:{button}})));}}
initialise();document.addEventListener('astro:page-load',initialise);
</script>
<style>.system-launcher{padding:32px 0;border-top:1px solid var(--h-line)}h2{font:700 1.5rem/1.3 var(--h-font-ui)}p{font:1rem/1.6 var(--h-font-ui);max-width:65ch}.system-play{font:600 1rem/1.5 var(--h-font-ui);background:var(--h-spot);color:white;border:1px solid var(--h-spot);border-radius:0;min-height:48px;padding:12px 20px;cursor:pointer}.system-play:focus-visible{outline:2px solid var(--h-spot);outline-offset:4px}</style>
