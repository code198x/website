---
// PrismLoader.astro - Loads custom assembly language definitions
---

<script>
  // Z80 Assembly Language Definition
  if (typeof Prism !== 'undefined') {
    Prism.languages.z80 = {
      'comment': /;.*/,
      'directive': {
        pattern: /\b(?:ORG|DEFB|DEFW|DEFS|EQU|INCLUDE|INCBIN|END|ALIGN|PHASE|DEPHASE|IF|ELSE|ENDIF|IFDEF|IFNDEF|MACRO|ENDM)\b/i,
        alias: 'property'
      },
      'string': /(["'`])(?:\\.|(?!\1)[^\\\r\n])*\1/,
      'op-code': {
        pattern: /\b(?:ADC|ADD|AND|BIT|CALL|CCF|CP|CPD|CPDR|CPI|CPIR|CPL|DAA|DEC|DI|DJNZ|EI|EX|EXX|HALT|IM|IN|INC|IND|INDR|INI|INIR|JP|JR|LD|LDD|LDDR|LDI|LDIR|NEG|NOP|OR|OTDR|OTIR|OUT|OUTD|OUTI|POP|PUSH|RES|RET|RETI|RETN|RL|RLA|RLC|RLCA|RLD|RR|RRA|RRC|RRCA|RRD|RST|SBC|SCF|SET|SLA|SLL|SRA|SRL|SUB|XOR|adc|add|and|bit|call|ccf|cp|cpd|cpdr|cpi|cpir|cpl|daa|dec|di|djnz|ei|ex|exx|halt|im|in|inc|ind|indr|ini|inir|jp|jr|ld|ldd|lddr|ldi|ldir|neg|nop|or|otdr|otir|out|outd|outi|pop|push|res|ret|reti|retn|rl|rla|rlc|rlca|rld|rr|rra|rrc|rrca|rrd|rst|sbc|scf|set|sla|sll|sra|srl|sub|xor)\b/,
        alias: 'keyword'
      },
      'condition': {
        pattern: /\b(?:NZ|Z|NC|C|PO|PE|P|M|nz|z|nc|c|po|pe|p|m)\b/,
        alias: 'builtin'
      },
      'register': {
        pattern: /\b(?:A|B|C|D|E|F|H|L|AF|BC|DE|HL|SP|PC|IX|IY|IXH|IXL|IYH|IYL|a|b|c|d|e|f|h|l|af|bc|de|hl|sp|pc|ix|iy|ixh|ixl|iyh|iyl)\b/,
        alias: 'variable'
      },
      'hex-number': {
        pattern: /#?\$[\da-f]{1,4}\b|0x[\da-f]{1,4}\b/i,
        alias: 'number'
      },
      'binary-number': {
        pattern: /#?%[01]+\b|0b[01]+\b/,
        alias: 'number'
      },
      'decimal-number': {
        pattern: /#?\b\d+\b/,
        alias: 'number'
      },
      'label': {
        pattern: /^[a-zA-Z_][a-zA-Z0-9_]*:/m,
        alias: 'function'
      },
      'punctuation': /[(),:]/
    };

    // 68000 Assembly Language Definition  
    Prism.languages.m68k = {
      'comment': /;.*/,
      'directive': {
        pattern: /\b(?:ORG|DC|DS|EQU|INCLUDE|INCDIR|SECTION|XDEF|XREF|END|ALIGN|EVEN|ODD|REPT|ENDR|IF|ELSE|ENDIF|IFNE|IFEQ|IFGT|IFGE|IFLT|IFLE|IFDEF|IFNDEF|MACRO|ENDM)\b/i,
        alias: 'property'
      },
      'string': /(["'`])(?:\\.|(?!\1)[^\\\r\n])*\1/,
      'op-code': {
        pattern: /\b(?:ABCD|ADD|ADDA|ADDI|ADDQ|ADDX|AND|ANDI|ASL|ASR|BCC|BCS|BEQ|BGE|BGT|BHI|BLE|BLS|BLT|BMI|BNE|BPL|BRA|BSR|BTST|BVC|BVS|CHK|CLR|CMP|CMPA|CMPI|CMPM|DBCC|DBCS|DBEQ|DBF|DBGE|DBGT|DBHI|DBLE|DBLS|DBLT|DBMI|DBNE|DBPL|DBRA|DBT|DBVC|DBVS|DIVS|DIVU|EOR|EORI|EXG|EXT|ILLEGAL|JMP|JSR|LEA|LINK|LSL|LSR|MOVE|MOVEA|MOVEM|MOVEP|MOVEQ|MULS|MULU|NBCD|NEG|NEGX|NOP|NOT|OR|ORI|PEA|RESET|ROL|ROR|ROXL|ROXR|RTE|RTR|RTS|SBCD|SCC|SCS|SEQ|SF|SGE|SGT|SHI|SLE|SLS|SLT|SMI|SNE|SPL|ST|STOP|SUB|SUBA|SUBI|SUBQ|SUBX|SVC|SVS|SWAP|TAS|TRAP|TRAPV|TST|UNLK|abcd|add|adda|addi|addq|addx|and|andi|asl|asr|bcc|bcs|beq|bge|bgt|bhi|ble|bls|blt|bmi|bne|bpl|bra|bsr|btst|bvc|bvs|chk|clr|cmp|cmpa|cmpi|cmpm|dbcc|dbcs|dbeq|dbf|dbge|dbgt|dbhi|dble|dbls|dblt|dbmi|dbne|dbpl|dbra|dbt|dbvc|dbvs|divs|divu|eor|eori|exg|ext|illegal|jmp|jsr|lea|link|lsl|lsr|move|movea|movem|movep|moveq|muls|mulu|nbcd|neg|negx|nop|not|or|ori|pea|reset|rol|ror|roxl|roxr|rte|rtr|rts|sbcd|scc|scs|seq|sf|sge|sgt|shi|sle|sls|slt|smi|sne|spl|st|stop|sub|suba|subi|subq|subx|svc|svs|swap|tas|trap|trapv|tst|unlk)\b/,
        alias: 'keyword'
      },
      'size-suffix': {
        pattern: /\.[bwl]\b/i,
        alias: 'operator'
      },
      'register': {
        pattern: /\b(?:D[0-7]|A[0-7]|SP|PC|SR|CCR|USP|d[0-7]|a[0-7]|sp|pc|sr|ccr|usp)\b/,
        alias: 'variable'
      },
      'hex-number': {
        pattern: /#?\$[\da-f]{1,8}\b|0x[\da-f]{1,8}\b/i,
        alias: 'number'
      },
      'binary-number': {
        pattern: /#?%[01]+\b|0b[01]+\b/,
        alias: 'number'
      },
      'decimal-number': {
        pattern: /#?\b\d+\b/,
        alias: 'number'
      },
      'label': {
        pattern: /^[a-zA-Z_][a-zA-Z0-9_]*:/m,
        alias: 'function'
      },
      'addressing-mode': {
        pattern: /\([aA][0-7](?:\+|\-)?[\da-fA-F$%]*\)|#[\da-fA-F$%]+/,
        alias: 'important'
      },
      'punctuation': /[(),:]/
    };

    // 6502 Assembly Language Definition (for C64 and NES)
    Prism.languages.asm6502 = {
      'comment': /;.*/,
      'directive': {
        pattern: /\b(?:ORG|BYTE|WORD|DBYT|TEXT|HEX|DS|DA|DW|DB|EQU|SET|INCLUDE|IF|ELSE|ENDIF|MACRO|ENDM|REPT|ENDR|ALIGN|SUBROUTINE|PROCESSOR|LIST|NOLIST)\b/i,
        alias: 'property'
      },
      'acme-directive': {
        pattern: /!(?:byte|word|16|32|text|raw|scrxor|pet|convtab|zone|zn|pseudopc|realpc|addr|addrs|fill|align|skip|warn|error|serious|sl|src|bin|to|ifdef|ifndef|if|for|set|do|while|endoffile|eof|cpu|al|as|rl|rs|svl|svs|h|initmem|wo|wor|le|be|sz|xor|if|for|macro|by|wo|tx|scr|pet|8|16|24|32|bin|cbm|plain|apple|prg|end|cpu|to|as|rs|al|rl|8|16|24|32|be|le|zone|zn|pseudopc|realpc|addr|addrs)\b/i,
        alias: 'property'
      },
      'string': /(["'`])(?:\\.|(?!\1)[^\\\r\n])*\1/,
      'op-code': {
        pattern: /\b(?:ADC|AND|ASL|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRK|BVC|BVS|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JMP|JSR|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PLA|PLP|ROL|ROR|RTI|RTS|SBC|SEC|SED|SEI|STA|STX|STY|TAX|TAY|TSX|TXA|TXS|TYA|adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|tax|tay|tsx|txa|txs|tya)\b/,
        alias: 'keyword'
      },
      'register': {
        pattern: /\b(?:A|X|Y|S|P|PC|SP|a|x|y|s|p|pc|sp)\b/,
        alias: 'variable'
      },
      'hex-number': {
        pattern: /#?\$[\da-f]{1,4}\b|0x[\da-f]{1,4}\b/i,
        alias: 'number'
      },
      'binary-number': {
        pattern: /#?%[01]+\b|0b[01]+\b/,
        alias: 'number'
      },
      'decimal-number': {
        pattern: /#?\b\d+\b/,
        alias: 'number'
      },
      'label': {
        pattern: /^[a-zA-Z_][a-zA-Z0-9_]*:/m,
        alias: 'function'
      },
      'addressing-mode': {
        pattern: /\([^)]+\)|#[\da-fA-F$%]+/,
        alias: 'important'
      },
      'punctuation': /[(),:]/
    };

    // BASIC Language Definition (for Phase 0 lessons)
    Prism.languages.basic = {
      'comment': /(?:REM|rem)\b.*/,
      'string': /"[^"]*"/,
      'line-number': {
        pattern: /^\s*\d+/m,
        alias: 'number'
      },
      'keyword': {
        pattern: /\b(?:AND|AS|ASC|ATN|BACK|CHR\$|CLEAR|CLOSE|CLR|CLS|CMD|CONT|COS|DATA|DEF|DIM|END|EXP|FN|FOR|FRE|GET|GOSUB|GOTO|IF|INPUT|INT|LEFT\$|LEN|LET|LIST|LOAD|LOG|MID\$|NEW|NEXT|NOT|ON|OPEN|OR|PEEK|POKE|PRINT|READ|REM|RESTORE|RETURN|RIGHT\$|RND|RUN|SAVE|SGN|SIN|SPC|SQR|STEP|STOP|STR\$|TAB|TAN|THEN|TI|TIME\$|TO|USR|VAL|VERIFY|WAIT|and|as|asc|atn|back|chr\$|clear|close|clr|cls|cmd|cont|cos|data|def|dim|end|exp|fn|for|fre|get|gosub|goto|if|input|int|left\$|len|let|list|load|log|mid\$|new|next|not|on|open|or|peek|poke|print|read|rem|restore|return|right\$|rnd|run|save|sgn|sin|spc|sqr|step|stop|str\$|tab|tan|then|ti|time\$|to|usr|val|verify|wait)\b/i,
        alias: 'keyword'
      },
      'c64-keyword': {
        pattern: /\b(?:COLOR|COLOUR|BORDER|BACKGROUND|SPRITE|SID|VIC|CIA|color|colour|border|background|sprite|sid|vic|cia)\b/i,
        alias: 'builtin'
      },
      'spectrum-keyword': {
        pattern: /\b(?:ATTR|BEEP|BRIGHT|FLASH|INK|INVERSE|OVER|PAPER|PAUSE|PLOT|POINT|SCREEN\$|UDG|attr|beep|bright|flash|ink|inverse|over|paper|pause|plot|point|screen\$|udg)\b/i,
        alias: 'builtin'  
      },
      'bbc-keyword': {
        pattern: /\b(?:MODE|VDU|SOUND|ENVELOPE|DRAW|MOVE|PLOT|GCOL|COLOUR|CALL|CHAIN|OSCLI|ADVAL|GET\$|INKEY|PAGE|TOP|HIMEM|LOMEM|PTR|EXT|BGET|BPUT|mode|vdu|sound|envelope|draw|move|plot|gcol|colour|call|chain|oscli|adval|get\$|inkey|page|top|himem|lomem|ptr|ext|bget|bput)\b/i,
        alias: 'builtin'
      },
      'operator': /[+\-*\/=<>]=?|<>|>=|<=|\^/,
      'number': /\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b/,
      'punctuation': /[(),:;]/,
      'variable': /\b[a-zA-Z][a-zA-Z0-9]*[$%]?\b/
    };

    // Forth Language Definition (for Jupiter ACE)
    Prism.languages.forth = {
      'comment': /\([^)]*\)|\\.*/,
      'string': /"[^"]*"|\.[^\\r\\n]*|S"[^"]*"/i,
      'number': {
        pattern: /\b-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b|\$[\da-fA-F]+|\%[01]+/,
        alias: 'number'
      },
      'builtin-word': {
        pattern: /\b(?:DUP|DROP|SWAP|OVER|ROT|PICK|ROLL|\+|\-|\*|\/|MOD|\/MOD|\*\/|ABS|NEGATE|MIN|MAX|AND|OR|XOR|NOT|LSHIFT|RSHIFT|\=|<>|<|>|<=|>=|0\=|0<>|0<|0>|@|!|C@|C!|\+!|2@|2!|?|FILL|MOVE|CMOVE|CMOVE>|HERE|ALLOT|,|C,|ALIGN|ALIGNED|CELLS|CELL\+|CHARS|CHAR\+|COUNT|TYPE|EMIT|KEY|CR|SPACE|SPACES|\.|\.\"|U\.|\.R|U\.R|EXECUTE|EXIT|;|:|IMMEDIATE|POSTPONE|LITERAL|COMPILE,|ABORT|ABORT\"|QUIT|BYE|IF|ELSE|THEN|BEGIN|WHILE|REPEAT|UNTIL|FOR|NEXT|LEAVE|UNLOOP|DO|LOOP|\+LOOP|I|J|RECURSE|TAIL|CASE|OF|ENDOF|ENDCASE|VARIABLE|CONSTANT|2VARIABLE|2CONSTANT|CREATE|DOES>|>BODY|WORDS|FORGET|MARKER|SEE|DUMP|DECIMAL|HEX|OCTAL|BINARY|BASE|DEPTH|\.S|STATE|SOURCE|>IN|BL|FIND|WORD|PARSE|dup|drop|swap|over|rot|pick|roll|abs|negate|min|max|and|or|xor|not|lshift|rshift|fill|move|cmove|here|allot|align|aligned|cells|chars|count|type|emit|key|cr|space|spaces|execute|exit|immediate|postpone|literal|abort|quit|bye|if|else|then|begin|while|repeat|until|for|next|leave|unloop|do|loop|i|j|recurse|tail|case|of|endof|endcase|variable|constant|create|body|words|forget|marker|see|dump|decimal|hex|octal|binary|base|depth|state|source|bl|find|word|parse)\b/i,
        alias: 'keyword'
      },
      'ace-word': {
        pattern: /\b(?:EDIT|FAST|SLOW|INVIS|VIS|PLOT|AT|CLS|LOAD|SAVE|CAT|VERIFY|LIST|LLIST|RUN|edit|fast|slow|invis|vis|plot|at|cls|load|save|cat|verify|list|llist|run)\b/i,
        alias: 'builtin'
      },
      'definition': {
        pattern: /:\s+[^\s;]+/,
        alias: 'function'
      },
      'stack-effect': {
        pattern: /\(\s*[^)]*--[^)]*\)/,
        alias: 'comment'
      },
      'punctuation': /[();]/
    };

    // AMOS BASIC Language Definition (for Amiga)
    Prism.languages.amos = {
      'comment': /(?:REM|Rem|rem)\b.*|'.*/,
      'string': /"[^"]*"/,
      'line-number': {
        pattern: /^\s*\d+/m,
        alias: 'number'
      },
      'keyword': {
        pattern: /\b(?:AND|AS|ASC|BACK|BOB|BRONZE|CHR\$|CLEAR|CLS|COPPER|DATA|DEF|DIM|DOUBLE|END|FOR|GET|GOSUB|GOTO|IF|INPUT|LEFT\$|LEN|LET|LIST|LOAD|MID\$|NEW|NEXT|NOT|OR|PALETTE|PRINT|RAINBOW|READ|REM|RESTORE|RETURN|RIGHT\$|RUN|SAVE|SCREEN|SPRITE|STOP|STR\$|THEN|TO|WAIT|and|as|asc|back|bob|bronze|chr\$|clear|cls|copper|data|def|dim|double|end|for|get|gosub|goto|if|input|left\$|len|let|list|load|mid\$|new|next|not|or|palette|print|rainbow|read|rem|restore|return|right\$|run|save|screen|sprite|stop|str\$|then|to|wait)\b/i,
        alias: 'keyword'
      },
      'amiga-command': {
        pattern: /\b(?:BLITTER|COPPER|FILL|HARDWARE|SCROLL|ZONE|blitter|copper|fill|hardware|scroll|zone)\b/i,
        alias: 'builtin'
      },
      'operator': /[+\-*\/=<>]=?|<>|>=|<=|\^/,
      'number': /\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b/,
      'punctuation': /[(),:;]/,
      'variable': /\b[a-zA-Z][a-zA-Z0-9]*[$%]?\b/
    };

    // Add aliases for common language tags
    Prism.languages.nasm = Prism.languages.z80;
    Prism.languages.assembly = Prism.languages.asm6502;
    Prism.languages.asm = Prism.languages.asm6502;
    Prism.languages['6502'] = Prism.languages.asm6502;
    Prism.languages['68000'] = Prism.languages.m68k;
    Prism.languages['68k'] = Prism.languages.m68k;
    
    // Phase 0 language aliases
    Prism.languages['c64-basic'] = Prism.languages.basic;
    Prism.languages['spectrum-basic'] = Prism.languages.basic;
    Prism.languages['bbc-basic'] = Prism.languages.basic;
    Prism.languages['amstrad-basic'] = Prism.languages.basic;
    Prism.languages['apple-basic'] = Prism.languages.basic;
    Prism.languages['atari-basic'] = Prism.languages.basic;
    Prism.languages['ti-basic'] = Prism.languages.basic;
    Prism.languages['dragon-basic'] = Prism.languages.basic;
    Prism.languages['amos-basic'] = Prism.languages.amos;
    Prism.languages['jupiter-forth'] = Prism.languages.forth;
  }
</script>