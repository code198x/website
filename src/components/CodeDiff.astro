---
/**
 * CodeDiff - Display code changes with line highlighting
 *
 * Usage:
 *   import CodeDiff from '@components/CodeDiff.astro';
 *   <CodeDiff
 *     title="Changes in Unit 3"
 *     additions={[5, 6, 7]}
 *     deletions={[2]}
 *     code={`line 1
 * line 2 (deleted)
 * line 3
 * line 4
 * line 5 (added)
 * line 6 (added)
 * line 7 (added)`}
 *   />
 *
 * Lines are 1-indexed. Additions are highlighted green, deletions red.
 */

interface Props {
  code: string;
  lang?: string;
  title?: string;
  additions?: number[];
  deletions?: number[];
  highlights?: number[];
  showLineNumbers?: boolean;
  platformColor?: string;
}

const {
  code,
  lang = 'asm',
  title,
  additions = [],
  deletions = [],
  highlights = [],
  showLineNumbers = true,
  platformColor
} = Astro.props;

const lines = code.split('\n');
const accentColor = platformColor || 'var(--color-primary)';

function getLineClass(lineNum: number): string {
  const classes: string[] = [];
  if (additions.includes(lineNum)) classes.push('line-added');
  if (deletions.includes(lineNum)) classes.push('line-deleted');
  if (highlights.includes(lineNum)) classes.push('line-highlight');
  return classes.join(' ');
}
---

<div class="code-diff" style={`--diff-accent: ${accentColor};`}>
  {title && (
    <div class="diff-header">
      <span class="diff-title">{title}</span>
      <div class="diff-stats">
        {additions.length > 0 && (
          <span class="stat-added">+{additions.length}</span>
        )}
        {deletions.length > 0 && (
          <span class="stat-deleted">-{deletions.length}</span>
        )}
      </div>
    </div>
  )}
  <div class="diff-content">
    <pre><code class={`language-${lang}`}>{lines.map((line, i) => {
      const lineNum = i + 1;
      const lineClass = getLineClass(lineNum);
      return (
        <div class={`diff-line ${lineClass}`} data-line={lineNum}>
          {showLineNumbers && (
            <span class="line-number">{lineNum}</span>
          )}
          <span class="line-content">{line || ' '}</span>
        </div>
      );
    })}</code></pre>
  </div>
</div>

<style>
  .code-diff {
    margin: var(--space-6) 0;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .diff-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .diff-title {
    font-family: var(--font-family-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .diff-stats {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .stat-added {
    color: var(--color-success);
  }

  .stat-deleted {
    color: var(--color-error);
  }

  .diff-content {
    background: var(--color-code-bg);
  }

  pre {
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
  }

  code {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-code-text);
  }

  .diff-line {
    display: flex;
    padding: 0 var(--space-4);
    min-height: 1.6em;
  }

  .line-number {
    flex-shrink: 0;
    width: 3ch;
    padding-right: var(--space-3);
    text-align: right;
    color: var(--color-text-muted);
    user-select: none;
    opacity: 0.5;
  }

  .line-content {
    flex: 1;
    white-space: pre;
  }

  /* Line states */
  .line-added {
    background: color-mix(in oklab, var(--color-success) 15%, var(--color-code-bg) 85%);
    border-left: 3px solid var(--color-success);
  }

  .line-added .line-number {
    color: var(--color-success);
    opacity: 1;
  }

  .line-deleted {
    background: color-mix(in oklab, var(--color-error) 15%, var(--color-code-bg) 85%);
    border-left: 3px solid var(--color-error);
    opacity: 0.7;
  }

  .line-deleted .line-number {
    color: var(--color-error);
    opacity: 1;
  }

  .line-deleted .line-content {
    text-decoration: line-through;
  }

  .line-highlight {
    background: color-mix(in oklab, var(--diff-accent) 15%, var(--color-code-bg) 85%);
    border-left: 3px solid var(--diff-accent);
  }

  .line-highlight .line-number {
    color: var(--diff-accent);
    opacity: 1;
  }

  /* When no highlight, add subtle left border for consistency */
  .diff-line:not(.line-added):not(.line-deleted):not(.line-highlight) {
    border-left: 3px solid transparent;
  }

  @media (max-width: 768px) {
    code {
      font-size: 0.8125rem;
    }

    .diff-line {
      padding: 0 var(--space-2);
    }

    .line-number {
      width: 2.5ch;
      padding-right: var(--space-2);
    }
  }
</style>
