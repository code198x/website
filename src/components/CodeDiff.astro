---
/**
 * CodeDiff - Show code differences with syntax highlighting
 *
 * Usage with file paths (automatic diff):
 *   <CodeDiff
 *     before="commodore-64/game-01-starfield/unit-07/starfield.asm"
 *     after="commodore-64/game-01-starfield/unit-08/starfield.asm"
 *   />
 *
 * Usage with inline markup (manual diff):
 *   <CodeDiff lang="6502">
 *   {`  LDA #$00
 *   + LDA #$01      ; Changed: new value
 *   - STA $D020     ; Removed: border colour
 *     STA $D021     ; Unchanged: background
 *   + JSR new_routine`}
 *   </CodeDiff>
 *
 * Lines starting with + are additions
 * Lines starting with - are deletions
 * Lines starting with space or no prefix are context
 *
 * Drawn as a House198x listing (styles/lesson.css). An added line carries the
 * kit's mark and a removed line a neutral wash and a strike; each also starts
 * with its sign and is an ins or del element, so the change is never shown by
 * colour alone (§3: state is not a machine or a project colour).
 */
import fs from 'node:fs';
import path from 'node:path';
import { tokenise, tokensHtml } from '../lib/kit-highlight';
import { getAllPlatforms } from '../lib/platforms';
import { inlineMarkdown } from '../lib/inline-markdown';
import '../styles/lesson.css';

interface Props {
  before?: string;    // Path to "before" file (relative to code-samples)
  after?: string;     // Path to "after" file (relative to code-samples)
  lang?: string;      // Language for syntax highlighting
  mode?: 'unified' | 'side-by-side';  // Display mode (default: unified)
  title?: string;     // Optional title
  context?: number;   // Lines of context around changes (default: 0 = show all)
}

const {
  before,
  after,
  lang,
  mode = 'unified',
  title,
  context = 0
} = Astro.props;

// Get inline content if provided via slot
const slotContent = await Astro.slots.render('default');
const inlineContent = slotContent?.trim();

// Resolve code-samples path
const codeSamplesPath = process.env.CODE_SAMPLES_PATH || path.resolve(process.cwd(), '../code-samples');

// Build platform -> language mapping
const platforms = await getAllPlatforms();
const platformLanguages = Object.fromEntries(
  platforms.map(p => [p.id, p.data.assemblerLanguage])
);

function inferLanguage(srcPath: string): string {
  const ext = path.extname(srcPath).slice(1);
  const platformSlug = srcPath.split('/')[0];

  if (ext === 'bas') {
    if (platformSlug === 'sinclair-zx-spectrum') return 'sinclair-basic';
    if (platformSlug === 'commodore-amiga') return 'amos';
    return 'basic';
  }
  if (ext === 'asm' || ext === 's') {
    return platformLanguages[platformSlug] || '6502';
  }
  return ext;
}

interface DiffLine {
  type: 'add' | 'del' | 'context' | 'separator';
  content: string;
  beforeLineNum?: number;
  afterLineNum?: number;
}

let diffLines: DiffLine[] = [];
let language = lang || '6502';
let error: string | null = null;

if (inlineContent) {
  // Parse inline diff markup
  // Strip HTML tags that might have been added
  const cleanContent = inlineContent.replace(/<[^>]+>/g, '');
  const lines = cleanContent.split('\n');

  let beforeNum = 1;
  let afterNum = 1;

  for (const line of lines) {
    if (line.startsWith('+')) {
      diffLines.push({
        type: 'add',
        content: line.slice(1), // Remove + prefix
        afterLineNum: afterNum++
      });
    } else if (line.startsWith('-')) {
      diffLines.push({
        type: 'del',
        content: line.slice(1), // Remove - prefix
        beforeLineNum: beforeNum++
      });
    } else {
      // Context line (may have leading space or not)
      const content = line.startsWith(' ') ? line.slice(1) : line;
      diffLines.push({
        type: 'context',
        content,
        beforeLineNum: beforeNum++,
        afterLineNum: afterNum++
      });
    }
  }
} else if (before && after) {
  // Compute diff from two files
  try {
    const beforePath = path.join(codeSamplesPath, before);
    const afterPath = path.join(codeSamplesPath, after);

    const beforeContent = fs.readFileSync(beforePath, 'utf-8');
    const afterContent = fs.readFileSync(afterPath, 'utf-8');

    language = lang || inferLanguage(after);

    // Simple line-by-line diff using LCS
    // Trailing newline first: splitting without it yields a final empty
    // string, which rendered as a numbered but blank row on every diff.
    const beforeLines = beforeContent.replace(/\n+$/, '').split('\n');
    const afterLines = afterContent.replace(/\n+$/, '').split('\n');

    diffLines = computeDiff(beforeLines, afterLines, context);
  } catch (e) {
    error = `Could not load diff files: ${before} / ${after}`;
    console.error('CodeDiff error:', e);
  }
} else {
  error = 'CodeDiff requires either before/after props or inline content';
}

// Diff algorithm using LCS (Longest Common Subsequence)
function computeDiff(beforeLines: string[], afterLines: string[], contextLines: number): DiffLine[] {
  const m = beforeLines.length;
  const n = afterLines.length;

  // Build LCS table
  const dp: number[][] = Array(m + 1).fill(null).map(() => Array(n + 1).fill(0));

  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      if (beforeLines[i - 1] === afterLines[j - 1]) {
        dp[i][j] = dp[i - 1][j - 1] + 1;
      } else {
        dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
      }
    }
  }

  // Backtrack to find diff
  const rawDiff: DiffLine[] = [];
  let i = m, j = n;

  while (i > 0 || j > 0) {
    if (i > 0 && j > 0 && beforeLines[i - 1] === afterLines[j - 1]) {
      rawDiff.unshift({
        type: 'context',
        content: beforeLines[i - 1],
        beforeLineNum: i,
        afterLineNum: j
      });
      i--; j--;
    } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
      rawDiff.unshift({
        type: 'add',
        content: afterLines[j - 1],
        afterLineNum: j
      });
      j--;
    } else {
      rawDiff.unshift({
        type: 'del',
        content: beforeLines[i - 1],
        beforeLineNum: i
      });
      i--;
    }
  }

  // If context = 0, return all lines
  if (contextLines === 0) return rawDiff;

  // Filter to show only context around changes
  const hasChange = rawDiff.map(line => line.type !== 'context');
  const keepLine = new Array(rawDiff.length).fill(false);

  for (let idx = 0; idx < rawDiff.length; idx++) {
    if (hasChange[idx]) {
      for (let c = Math.max(0, idx - contextLines); c <= Math.min(rawDiff.length - 1, idx + contextLines); c++) {
        keepLine[c] = true;
      }
    }
  }

  // Build result with separators
  const result: DiffLine[] = [];
  let lastKept = -1;
  for (let idx = 0; idx < rawDiff.length; idx++) {
    if (keepLine[idx]) {
      if (lastKept !== -1 && idx - lastKept > 1) {
        result.push({ type: 'separator', content: '...' });
      }
      result.push(rawDiff[idx]);
      lastKept = idx;
    }
  }

  return result;
}

// Colour each line in the kit's four roles. Lines are tokenised one at a
// time, as the old renderer did: assembly and BASIC are line-shaped, so a
// line needs no state from the one before it.
const highlightedLines = await Promise.all(
  diffLines.map(async (line) => ({
    ...line,
    highlighted: line.type === 'separator' ? '' : tokensHtml((await tokenise(line.content, language))[0] ?? []),
  }))
);

// Count stats
const addCount = diffLines.filter(l => l.type === 'add').length;
const delCount = diffLines.filter(l => l.type === 'del').length;
// The region's name is plain text: drop the Markdown emphasis and code marks.
const plainTitle = title?.replace(/[*_`]/g, '');
const label = plainTitle ? 'Changes: ' + plainTitle : 'Changes';
const widest = Math.max(1, ...diffLines.map((l) => String(l.afterLineNum ?? l.beforeLineNum ?? '').length));
const gutter = `--ll-gutter: ${widest}ch`;

/** One rendered row. The gutter shows the line's number in the version it
 *  belongs to: the new file for added and unchanged lines, the old one for a
 *  removed line. Its sign is read out, so the change never rests on colour. */
const row = (line: (typeof highlightedLines)[number], side: 'unified' | 'before' | 'after') => {
  if (line.type === 'separator') return `<span class="ll-line ll-sep"><span class="ll-text">…</span></span>`;
  const num = side === 'before' ? line.beforeLineNum : side === 'after' ? line.afterLineNum : (line.afterLineNum ?? line.beforeLineNum);
  const sign = line.type === 'add' ? '+' : line.type === 'del' ? '−' : ' ';
  const spoken = line.type === 'add' ? 'Added: ' : line.type === 'del' ? 'Removed: ' : '';
  const tag = line.type === 'add' ? 'ins' : line.type === 'del' ? 'del' : 'span';
  const cls = line.type === 'add' ? ' ll-add' : line.type === 'del' ? ' ll-del' : '';
  return `<${tag} class="ll-line${cls}"><span class="ll-gutter" aria-hidden="true">${num ?? ''}</span><span class="ll-marker" aria-hidden="true">${sign}</span>${spoken ? `<span class="ll-sr">${spoken}</span>` : ''}<span class="ll-text">${line.highlighted}\n</span></${tag}>`;
};
const unified = highlightedLines.map((l) => row(l, 'unified')).join('');
const beforeRows = highlightedLines.filter((l) => l.type !== 'add').map((l) => row(l, 'before')).join('');
const afterRows = highlightedLines.filter((l) => l.type !== 'del').map((l) => row(l, 'after')).join('');
---

{error ? (
  <div class="diff-error" role="alert">
    <p class="error-message">{error}</p>
  </div>
) : (
  <figure class:list={['lesson-listing', 'code-diff', mode]} style={gutter}>
    <figcaption class="ll-head">
      <span class="ll-label diff-title">{title ? <span set:html={inlineMarkdown(title)} /> : 'Changes'}</span>
      <span class="ll-head-end ll-stat">
        {addCount > 0 && <span class="stat-added">+{addCount}<span class="ll-sr"> added</span></span>}
        {delCount > 0 && <span class="stat-deleted">−{delCount}<span class="ll-sr"> removed</span></span>}
      </span>
    </figcaption>
    {mode === 'unified' ? (
      <div class="ll-scroll diff-container" data-ll-scroll data-label={label} tabindex="0" role="region" aria-label={label}><pre class="ll-pre"><code set:html={unified} /></pre></div>
    ) : (
      <div class="diff-panes">
        <div class="diff-pane">
          <p class="diff-pane-head">Before</p>
          <div class="ll-scroll" data-ll-scroll data-label={`${label}, before`} tabindex="0" role="region" aria-label={`${label}, before`}><pre class="ll-pre"><code set:html={beforeRows} /></pre></div>
        </div>
        <div class="diff-pane">
          <p class="diff-pane-head">After</p>
          <div class="ll-scroll" data-ll-scroll data-label={`${label}, after`} tabindex="0" role="region" aria-label={`${label}, after`}><pre class="ll-pre"><code set:html={afterRows} /></pre></div>
        </div>
      </div>
    )}
  </figure>
)}

<style>
  /* The head carries the title in the interface face: it names a change,
     not a file. */
  .code-diff .diff-title {
    font-family: var(--h-font-ui);
    font-size: var(--h-text-micro);
    font-weight: var(--h-weight-minor);
    letter-spacing: 0;
    color: var(--h-ink);
    white-space: normal;
    padding-block: var(--h-cell);
  }
  .code-diff .diff-title :global(code) { font-size: 0.95em; }
  .ll-stat { display: inline-flex; gap: calc(var(--h-cell) * 1.5); }

  .diff-panes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .diff-pane + .diff-pane { border-left: 1px solid var(--h-line); }
  .diff-pane-head {
    margin: 0;
    padding: var(--h-cell) calc(var(--h-cell) * 3);
    border-bottom: 1px solid var(--h-line);
    color: var(--h-ink-muted);
    font-family: var(--h-font-ui);
    font-size: var(--h-text-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 768px) {
    .diff-panes { grid-template-columns: minmax(0, 1fr); }
    .diff-pane + .diff-pane { border-left: 0; border-top: 1px solid var(--h-line); }
  }

  .diff-error {
    background: var(--color-error-muted);
    border: 1px solid var(--h-line);
    border-left: 4px solid var(--color-error);
    border-radius: 0;
    padding: 1rem;
    margin: 1.5rem 0;
  }
  .error-message { color: var(--h-ink); margin: 0; }
</style>

<script>
  import { initListings } from '../lib/lesson-listing';
  initListings();
  document.addEventListener('astro:page-load', () => initListings());
</script>
