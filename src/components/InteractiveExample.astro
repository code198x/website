---
import Emulator from './Emulator.astro';
import VisualConcept from './VisualConcept.astro';

export interface Props {
  system: 'commodore-64' | 'zx-spectrum' | 'nintendo-entertainment-system' | 'commodore-amiga';
  title: string;
  description: string;
  code: string;
  concepts?: string[];
  visualType?: 'memory-map' | 'register-state' | 'instruction-flow' | 'stack-operation' | 'addressing-mode';
  visualData?: any;
}

const { 
  system, 
  title, 
  description, 
  code, 
  concepts = [],
  visualType = 'register-state',
  visualData = {}
} = Astro.props;

// System-specific colors
const getSystemColors = (systemSlug: string) => {
  switch(systemSlug) {
    case 'commodore-64':
      return { bg: 'from-c64-brown to-c64-dark-brown', accent: 'bg-c64-brown' };
    case 'zx-spectrum':
      return { bg: 'from-spectrum-red to-spectrum-magenta', accent: 'bg-spectrum-red' };
    case 'nintendo-entertainment-system':
      return { bg: 'from-nes-red to-nes-dark-gray', accent: 'bg-nes-red' };
    case 'commodore-amiga':
      return { bg: 'from-amiga-blue to-amiga-orange', accent: 'bg-amiga-blue' };
    default:
      return { bg: 'from-gray-600 to-gray-800', accent: 'bg-gray-600' };
  }
};

const colors = getSystemColors(system);
---

<div class="interactive-example bg-white/60 rounded-xl border border-gray-200 shadow-lg overflow-hidden mb-8">
  <!-- Header -->
  <div class={`bg-gradient-to-r ${colors.bg} text-white px-6 py-4`}>
    <div class="flex items-center gap-4">
      <div class={`w-12 h-12 ${colors.accent} rounded-xl flex items-center justify-center text-white text-xl shadow-lg`}>
        🧪
      </div>
      <div>
        <h3 class="text-xl font-bold mb-1">{title}</h3>
        <p class="text-white/90">{description}</p>
      </div>
    </div>
    
    {concepts.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {concepts.map((concept) => (
          <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium">
            {concept}
          </span>
        ))}
      </div>
    )}
  </div>

  <div class="p-6">
    <!-- Code and Emulator Section -->
    <div class="grid lg:grid-cols-2 gap-6 mb-6">
      <!-- Code Editor -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold text-gray-800 flex items-center gap-2">
          <span>💻</span>
          Assembly Code
        </h4>
        <div class="bg-gray-900 text-green-400 p-4 rounded-lg font-mono text-sm overflow-x-auto">
          <pre class="whitespace-pre">{code}</pre>
        </div>
        <div class="flex gap-2">
          <button class="copy-code-btn px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium">
            📋 Copy Code
          </button>
          <button class="explain-code-btn px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium">
            📖 Explain Code
          </button>
        </div>
      </div>

      <!-- Emulator -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold text-gray-800 flex items-center gap-2">
          <span>🖥️</span>
          Live Emulator
        </h4>
        <Emulator 
          system={system}
          code={code}
          autoStart={false}
          showControls={true}
          height="300px"
        />
        <p class="text-sm text-gray-600">
          Click "Run Code" to execute the assembly program in the emulator above.
        </p>
      </div>
    </div>

    <!-- Visual Concept -->
    <div class="mb-6">
      <h4 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
        <span>🔍</span>
        Concept Visualization
      </h4>
      <VisualConcept 
        type={visualType}
        system={system}
        title={`${visualType.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')} Visualization`}
        data={visualData}
        interactive={true}
      />
    </div>

    <!-- Explanation Section -->
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
      <h4 class="text-lg font-bold text-blue-800 mb-3 flex items-center gap-2">
        <span>💡</span>
        How It Works
      </h4>
      <div class="prose prose-blue max-w-none">
        <div class="code-explanation space-y-3 text-gray-700">
          <!-- JavaScript will populate this with line-by-line explanation -->
          <p class="text-sm text-gray-500 italic">
            Run the code or click "Explain Code" to see a detailed breakdown of each instruction.
          </p>
        </div>
      </div>
    </div>

    <!-- Try It Yourself Section -->
    <div class="mt-6 bg-green-50 border border-green-200 rounded-xl p-6">
      <h4 class="text-lg font-bold text-green-800 mb-3 flex items-center gap-2">
        <span>🛠️</span>
        Try It Yourself
      </h4>
      <div class="space-y-3">
        <p class="text-green-700">
          Experiment with the code above! Here are some things you can try:
        </p>
        <ul class="list-disc list-inside text-green-700 space-y-1 text-sm">
          <li>Change the immediate values (#$XX) to see different results</li>
          <li>Modify memory addresses to store data in different locations</li>
          <li>Add your own instructions to extend the program</li>
          <li>Use the visual concept tools to understand how each instruction affects the system</li>
        </ul>
        <div class="mt-4">
          <button class="modify-code-btn px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-sm font-medium">
            🎨 Open Code Editor
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for interactive functionality -->
<script>
  // Code explanation data for different systems
  const CODE_EXPLANATIONS = {
    'commodore-64': {
      'LDA #$': 'Load immediate value into Accumulator (A register)',
      'STA $': 'Store Accumulator value to memory address',
      'LDX #$': 'Load immediate value into X register',
      'LDY #$': 'Load immediate value into Y register',
      'INX': 'Increment X register by 1',
      'INY': 'Increment Y register by 1',
      'DEX': 'Decrement X register by 1',
      'DEY': 'Decrement Y register by 1',
      'RTS': 'Return from subroutine',
      'JMP': 'Jump to memory address'
    },
    'zx-spectrum': {
      'LD A,': 'Load value into A register',
      'LD BC,': 'Load 16-bit value into BC register pair',
      'LD HL,': 'Load 16-bit value into HL register pair',
      'OUT (': 'Output to I/O port',
      'CALL': 'Call subroutine at address',
      'RET': 'Return from subroutine',
      'HALT': 'Halt CPU execution'
    },
    'nintendo-entertainment-system': {
      'LDA #$': 'Load immediate value into Accumulator',
      'STA $': 'Store Accumulator to PPU or memory',
      'LDX #$': 'Load immediate value into X register',
      'STX $': 'Store X register to memory',
      'BNE': 'Branch if not equal (Z flag clear)',
      'JSR': 'Jump to subroutine',
      'RTS': 'Return from subroutine'
    },
    'commodore-amiga': {
      'MOVE.W': 'Move 16-bit word between registers/memory',
      'MOVE.L': 'Move 32-bit long word',
      'LEA': 'Load effective address into register',
      'JSR': 'Jump to subroutine',
      'RTS': 'Return from subroutine',
      'MOVEQ': 'Move quick (8-bit immediate to 32-bit register)'
    }
  };

  // Copy code to clipboard
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('copy-code-btn')) {
      const codeElement = e.target.closest('.interactive-example').querySelector('pre');
      if (codeElement) {
        navigator.clipboard.writeText(codeElement.textContent).then(() => {
          e.target.textContent = '✅ Copied!';
          setTimeout(() => {
            e.target.textContent = '📋 Copy Code';
          }, 2000);
        });
      }
    }
  });

  // Explain code functionality
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('explain-code-btn')) {
      const example = e.target.closest('.interactive-example');
      const codeElement = example.querySelector('pre');
      const explanationElement = example.querySelector('.code-explanation');
      
      if (codeElement && explanationElement) {
        const code = codeElement.textContent;
        const system = getSystemFromExample(example);
        const explanation = generateCodeExplanation(code, system);
        
        explanationElement.innerHTML = explanation;
        
        // Update button
        e.target.textContent = '✅ Explained!';
        setTimeout(() => {
          e.target.textContent = '📖 Explain Code';
        }, 3000);
      }
    }
  });

  // Open code editor (placeholder for future implementation)
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('modify-code-btn')) {
      alert('Code editor feature coming soon! For now, you can copy the code and modify it in your own assembler.');
    }
  });

  // Get system from example element
  function getSystemFromExample(example) {
    const emulator = example.querySelector('[data-system]');
    return emulator ? emulator.dataset.system : 'commodore-64';
  }

  // Generate code explanation
  function generateCodeExplanation(code, system) {
    const explanations = CODE_EXPLANATIONS[system] || {};
    const lines = code.trim().split('\n');
    
    let explanation = '<div class="space-y-2">';
    
    lines.forEach((line, index) => {
      const trimmedLine = line.trim();
      if (trimmedLine && !trimmedLine.startsWith(';')) {
        let lineExplanation = 'Assembly instruction';
        
        // Find matching explanation
        for (const [pattern, desc] of Object.entries(explanations)) {
          if (trimmedLine.toUpperCase().includes(pattern.toUpperCase())) {
            lineExplanation = desc;
            break;
          }
        }
        
        explanation += `
          <div class="flex gap-3 p-2 bg-white rounded border">
            <div class="font-mono text-sm bg-gray-100 px-2 py-1 rounded flex-shrink-0">${trimmedLine}</div>
            <div class="text-sm text-gray-700">${lineExplanation}</div>
          </div>
        `;
      }
    });
    
    explanation += '</div>';
    return explanation;
  }
</script>

<style>
  .interactive-example {
    transition: all 0.3s ease;
  }
  
  .interactive-example:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .copy-code-btn, .explain-code-btn, .modify-code-btn {
    transition: all 0.2s ease;
  }
  
  .copy-code-btn:hover, .explain-code-btn:hover, .modify-code-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }
</style>