---
interface Props { step: number; title: string }
const {step, title} = Astro.props;
if (!Number.isInteger(step) || step < 1 || step > 4) throw new Error('Invalid movement step');
---
<div class="movement-experiment">
  <iframe src={`/experiments/game-feel/lessons.html?step=${step}`} title={`${title}: movement comparison`} loading="lazy" data-movement></iframe>
</div>
<p class="movement-note">Both ships receive the same input. Changing the slider resets them. Open “Inspect one update” to pause and trace a single step. This is a browser model, not a measurement of a particular retro computer.</p>
<script>
  addEventListener('message', event => {
    if(event.origin !== location.origin || event.data?.type !== 'game-feel-height') return;
    for(const frame of document.querySelectorAll<HTMLIFrameElement>('iframe[data-movement]')) {
      if(frame.contentWindow !== event.source) continue;
      const height = Number(event.data.height);
      if(Number.isFinite(height) && height >= 100 && height <= 4000) frame.style.height = `${Math.ceil(height)}px`;
    }
  });
</script>
<style>
.movement-experiment{margin:1.5rem 0;border:1px solid var(--color-border);border-radius:8px;overflow:hidden;background:#101b25}
iframe{width:100%;height:850px;border:0;display:block;color-scheme:dark}
.movement-note{font-size:.875rem;color:var(--color-text-secondary)}
@media(max-width:780px){iframe{height:1100px}}
</style>
