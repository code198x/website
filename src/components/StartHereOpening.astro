---
import OpeningBand from './OpeningBand.astro';
---
<OpeningBand class="start-here-opening" labelledby="start-here-title" focal="left center"
  art={{ src: '/images/start-here-opening/landscape-2172.webp', srcset: '/images/start-here-opening/landscape-1280.webp 1280w, /images/start-here-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }}
  phoneArt={{ src: '/images/start-here-opening/phone-600.webp', srcset: '/images/start-here-opening/phone-600.webp 600w, /images/start-here-opening/phone-1200.webp 1200w', width: 1200, height: 900 }}
  caption="A kit of possibilities, imagined in paper and pixels.">
  <h1 id="start-here-title">Start <span>Here.</span></h1>
</OpeningBand>

<style>@layer blocks {
  h1 { margin: 0; max-width: 5ch; font: 900 italic clamp(4rem, 7.5cqw, 9rem)/.92 var(--h-font-mag); letter-spacing: -.025em; color: var(--h-ink); }
  h1 span { display: block; }
  @media (max-width: 1000px) { h1 { font-size: clamp(3.2rem, 13cqw, 4rem); } }
}
</style>
