---
import HardwarePhoto from './HardwarePhoto.astro';
import type { resolveStories } from '../lib/timeline';
interface Props { stories: ReturnType<typeof resolveStories>; compact?: boolean }
const { stories, compact = false } = Astro.props;
---
<noscript><style is:global>.timeline-stories .timeline-story[hidden]{display:grid!important}</style></noscript>
<div class:list={['timeline-stories', { compact }]} data-timeline-stories>
  <nav class="timeline-story-choice" aria-label="Choose a connected story" hidden>
    {stories.map((story, i) => <button type="button" data-story-choice={story.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`story-${story.id}`}>{story.label}</button>)}
  </nav>
  {stories.map((story,i) => <section hidden={i !== 0} id={`story-${story.id}`} class="timeline-story" data-story={story.id} aria-labelledby={`story-title-${story.id}`}>
    <div class="timeline-story-intro">
      <h2 id={`story-title-${story.id}`}>{story.title}</h2>
      <p>{story.description}</p>
      {story.machine && !compact && <HardwarePhoto system={story.machine}/>}
    </div>
    <ol class="timeline-story-steps">
      {story.steps.map(step => <li>
        <a class="timeline-story-year" href={`/timeline/${Math.floor(step.year / 10) * 10}s/#year-${step.year}`} aria-label={`Browse ${step.year}`}>{step.year}</a>
        <div><h3><a href={step.url}>{step.title}</a></h3><p>{step.connection}</p></div>
      </li>)}
    </ol>
  </section>)}
</div>
<script>
function initTimelineStories() {
  document.querySelectorAll<HTMLElement>('[data-timeline-stories]').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-story-choice]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-story]')];
    const select = (id: string, update = false) => {
      const chosen = panels.some(panel => panel.dataset.story === id) ? id : panels[0]?.dataset.story;
      for (const panel of panels) panel.hidden = panel.dataset.story !== chosen;
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.storyChoice === chosen));
      if (update) { const url = new URL(location.href); url.searchParams.set('story', chosen!); history.replaceState(null, '', url); }
    };
    for (const button of buttons) button.addEventListener('click', () => select(button.dataset.storyChoice!, true));
    select(new URLSearchParams(location.search).get('story') ?? '');
    root.querySelector<HTMLElement>('nav')!.hidden = false;
  });
}
initTimelineStories();
document.addEventListener('astro:page-load', initTimelineStories);
</script>
