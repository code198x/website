---
/** A native modal owns focus while the shared machine runs. Close pauses it;
 * reopening preserves the player. Its own Resume control continues execution. */
interface Props { rule?: string }
const { rule } = Astro.props;
---
<run-panel style={rule ? `--runit-rule: ${rule}` : undefined}>
  <dialog class="rp-dialog" aria-label="Run this program">
  <div class="rp-head">
    <div><strong class="rp-title"></strong><br><span class="rp-model"></span></div>
    <button type="button" class="rp-close">Close <span aria-hidden="true">✕</span></button>
  </div>
  <div class="rp-screen"></div>
  <div class="rp-inspector" hidden></div>
  </dialog>
</run-panel>

<script>
  import { loadPlayer } from '../lib/load-player';

  class RunPanel extends HTMLElement {
    opener: HTMLElement | null = null;
    width = 416;
    controller?: AbortController;
    /** True from the start of a load until it settles; further opens wait. */
    loading = false;

    get dialog() { return this.querySelector<HTMLDialogElement>('.rp-dialog')!; }

    connectedCallback() {
      // Fresh listeners per connection, torn down in disconnectedCallback —
      // otherwise a panel detached by a soft navigation keeps reacting to
      // document/window events fired for whichever page replaced it.
      this.controller = new AbortController();
      const { signal } = this.controller;
      document.addEventListener('runit:open', e => this.open((e as CustomEvent).detail.button), { signal });
      this.querySelector('.rp-close')!.addEventListener('click', () => this.close(), { signal });
      this.dialog.addEventListener('cancel', e => {
        if(document.activeElement?.tagName === 'EMU198X-PLAYER') e.preventDefault();
      },{signal});
      this.dialog.addEventListener('close',()=>this.finishClose(),{signal});
      this.dialog.addEventListener('keydown', e => {
        if (e.key !== 'Escape' || !this.dialog.open) return;
        if (document.activeElement?.tagName === 'EMU198X-PLAYER') return; // Esc is a machine key there
        e.preventDefault();this.close();
      }, { signal });
      addEventListener('resize', () => { if (this.dialog.open) this.place(); }, { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.querySelector<any>('emu198x-player')?.pause?.();
      document.body.classList.remove('machine-active');
    }

    async open(button: HTMLElement) {
      if (this.loading) return;
      this.opener = button;
      const d = button.dataset;
      this.width = Number(d.runWidth) || 416;
      const status = button.closest('.runit, .system-launcher')?.querySelector<HTMLElement>('.runit-status');

      const existing = this.querySelector('emu198x-player');
      if (existing && existing.getAttribute('src') === (d.runSrc ?? null)) {
        // Same program already loaded: reuse it instead of rebooting the
        // machine. The player has no public resume, so the reader presses
        // its own Resume once the panel is visible again.
        this.reveal(d);
        return;
      }

      this.loading = true;
      button.setAttribute('aria-busy', 'true');
      if (status) status.textContent = '';
      try {
        await loadPlayer();
      } catch (error) {
        console.error(error);
        // The live region is already in the page, empty; filling it a frame
        // later is what makes screen readers announce the change.
        if (status) requestAnimationFrame(() => {
          status.textContent = "The player couldn't load. Check your connection and try again.";
        });
        return;
      } finally {
        this.loading = false;
        button.removeAttribute('aria-busy');
      }

      if(!this.isConnected || this.controller?.signal.aborted)return;
      const player = document.createElement('emu198x-player');
      player.setAttribute('system', d.runSystem!);
      if (d.runVariant) player.setAttribute('variant', d.runVariant);
      if(d.runSrc)player.setAttribute('src', d.runSrc);
      player.setAttribute('example-title', d.runTitle!);
      // The player's own stylesheet caps it at 760px; lift that to the
      // machine's frame width so the screen renders at 1×.
      player.style.maxWidth = `${this.width}px`;
      this.querySelector('.rp-screen')!.replaceChildren(player);
      this.reveal(d);
    }

    reveal(d: DOMStringMap) {
      this.querySelector('.rp-title')!.textContent = d.runTitle!;
      this.querySelector('.rp-model')!.textContent = d.runModel ?? '';
      this.dialog.showModal();
      document.body.classList.add('machine-active');
      this.place();
      (this.querySelector('.rp-close') as HTMLElement).focus();
    }

    place() {
      this.dataset.mode = innerWidth < 768 ? 'fullscreen' : 'modal';
      this.dialog.style.setProperty('--panel-width', `${this.width}px`);
      this.dialog.setAttribute('aria-label', `Run ${this.querySelector('.rp-title')!.textContent}`);
    }

    close() { this.dialog.close(); }
    finishClose() {
      (this.querySelector('emu198x-player') as (HTMLElement & {pause?:()=>void}) | null)?.pause?.();
      document.body.classList.remove('machine-active');
      this.opener?.focus();
    }
  }
  if (!customElements.get('run-panel')) customElements.define('run-panel', RunPanel);
</script>

<style is:global>
body.machine-active{overflow:hidden}
run-panel{--player-ink:var(--h-ink);--player-muted:var(--h-ink-body);--player-line:var(--h-line);--player-surface:var(--h-ground);--player-focus:var(--h-spot)}
.rp-dialog{box-sizing:border-box;position:fixed;inset:0;margin:auto;width:max(608px,calc(var(--panel-width,416px) + 64px));max-width:100vw;max-height:calc(100dvh - 48px);padding:32px 0;border:0;border-radius:0;background:var(--h-page);color:var(--h-ink);overflow:auto;overscroll-behavior:contain;box-shadow:0 16px 48px -12px #1b1a1780}
.rp-dialog:not([open]){display:none}.rp-dialog::backdrop{background:#1b1a17b3}
.rp-dialog .rp-head{display:flex;align-items:start;justify-content:space-between;gap:24px;margin-bottom:24px;padding-inline:24px;font:600 1.25rem/1.5 var(--h-font-ui)}
.rp-dialog .rp-model{font:1rem/1.5 var(--h-font-mono);color:var(--h-ink-muted)}
.rp-dialog .rp-close{font:1rem/1.5 var(--h-font-ui);min-height:48px;padding:10px 16px;border:1px solid var(--h-line);background:var(--h-ground);color:var(--h-ink);border-radius:0;cursor:pointer}
.rp-screen{width:var(--panel-width,416px);max-width:100%;margin:auto}
.rp-dialog :focus-visible{outline:2px solid var(--h-spot);outline-offset:4px}
@media(max-width:767px){.rp-dialog{width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;margin:0;padding:16px 0}.rp-dialog .rp-head{flex-wrap:wrap}}
@media(max-width:440px){.rp-dialog{padding-inline:0}.rp-dialog .rp-head{padding-inline:12px}}
@media(prefers-reduced-motion:no-preference){.rp-dialog[open]{animation:rp-arrive 180ms ease-out}@keyframes rp-arrive{from{box-shadow:0 4px 16px -8px #1b1a1740}to{box-shadow:0 16px 48px -12px #1b1a1780}}}
</style>
