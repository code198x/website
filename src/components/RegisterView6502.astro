---
export interface Props {
  registerA?: string;
  registerX?: string;
  registerY?: string;
  stackPointer?: string;
  programCounter?: string;
  status?: string;
  title?: string;
  showBeforeAfter?: boolean;
  beforeA?: string;
  beforeX?: string;
  beforeY?: string;
  afterA?: string;
  afterX?: string;
  afterY?: string;
}

const { 
  registerA = "00", 
  registerX = "00", 
  registerY = "00",
  stackPointer = "FF",
  programCounter = "0000",
  status = "00",
  title = "6502 Processor Registers",
  showBeforeAfter = false,
  beforeA = "00",
  beforeX = "00", 
  beforeY = "00",
  afterA = registerA,
  afterX = registerX,
  afterY = registerY
} = Astro.props;

function formatHex(value: string): string {
  return value.toUpperCase().padStart(2, '0');
}

function formatHex16(value: string): string {
  return value.toUpperCase().padStart(4, '0');
}
---

<div class="bg-slate-900 rounded-lg p-6 border border-slate-700">
  <h3 class="text-lg font-bold text-green-400 mb-4 text-center">{title}</h3>
  
  {showBeforeAfter ? (
    <!-- Before/After Comparison -->
    <div class="grid grid-cols-2 gap-6">
      <!-- Before State -->
      <div>
        <h4 class="text-sm font-bold text-slate-400 mb-3 text-center">BEFORE</h4>
        <div class="space-y-3">
          <div class="bg-blue-900 rounded p-3 border-2 border-blue-600">
            <div class="text-xs text-blue-300 font-mono">A (Accumulator)</div>
            <div class="text-xl font-mono text-blue-100">${formatHex(beforeA)}</div>
            <div class="text-xs text-blue-400">{parseInt(beforeA, 16)} decimal</div>
          </div>
          
          <div class="bg-purple-900 rounded p-3 border-2 border-purple-600">
            <div class="text-xs text-purple-300 font-mono">X (Index)</div>
            <div class="text-xl font-mono text-purple-100">${formatHex(beforeX)}</div>
            <div class="text-xs text-purple-400">{parseInt(beforeX, 16)} decimal</div>
          </div>
          
          <div class="bg-orange-900 rounded p-3 border-2 border-orange-600">
            <div class="text-xs text-orange-300 font-mono">Y (Index)</div>
            <div class="text-xl font-mono text-orange-100">${formatHex(beforeY)}</div>
            <div class="text-xs text-orange-400">{parseInt(beforeY, 16)} decimal</div>
          </div>
        </div>
      </div>
      
      <!-- After State -->
      <div>
        <h4 class="text-sm font-bold text-slate-400 mb-3 text-center">AFTER</h4>
        <div class="space-y-3">
          <div class="bg-blue-900 rounded p-3 border-2 border-blue-400 ring-2 ring-blue-400">
            <div class="text-xs text-blue-300 font-mono">A (Accumulator)</div>
            <div class="text-xl font-mono text-blue-100">${formatHex(afterA)}</div>
            <div class="text-xs text-blue-400">{parseInt(afterA, 16)} decimal</div>
          </div>
          
          <div class="bg-purple-900 rounded p-3 border-2 border-purple-400 ring-2 ring-purple-400">
            <div class="text-xs text-purple-300 font-mono">X (Index)</div>
            <div class="text-xl font-mono text-purple-100">${formatHex(afterX)}</div>
            <div class="text-xs text-purple-400">{parseInt(afterX, 16)} decimal</div>
          </div>
          
          <div class="bg-orange-900 rounded p-3 border-2 border-orange-400 ring-2 ring-orange-400">
            <div class="text-xs text-orange-300 font-mono">Y (Index)</div>
            <div class="text-xl font-mono text-orange-100">${formatHex(afterY)}</div>
            <div class="text-xs text-orange-400">{parseInt(afterY, 16)} decimal</div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <!-- Single State View -->
    <div class="space-y-4">
      <!-- Main Registers -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-blue-900 rounded p-4 border-2 border-blue-600">
          <div class="text-xs text-blue-300 font-mono mb-1">A (Accumulator)</div>
          <div class="text-2xl font-mono text-blue-100 mb-1">${formatHex(registerA)}</div>
          <div class="text-xs text-blue-400">{parseInt(registerA, 16)} decimal</div>
          <div class="text-xs text-blue-500 mt-2">Main arithmetic register</div>
        </div>
        
        <div class="bg-purple-900 rounded p-4 border-2 border-purple-600">
          <div class="text-xs text-purple-300 font-mono mb-1">X (Index)</div>
          <div class="text-2xl font-mono text-purple-100 mb-1">${formatHex(registerX)}</div>
          <div class="text-xs text-purple-400">{parseInt(registerX, 16)} decimal</div>
          <div class="text-xs text-purple-500 mt-2">Counter & indexing</div>
        </div>
        
        <div class="bg-orange-900 rounded p-4 border-2 border-orange-600">
          <div class="text-xs text-orange-300 font-mono mb-1">Y (Index)</div>
          <div class="text-2xl font-mono text-orange-100 mb-1">${formatHex(registerY)}</div>
          <div class="text-xs text-orange-400">{parseInt(registerY, 16)} decimal</div>
          <div class="text-xs text-orange-500 mt-2">Counter & indexing</div>
        </div>
      </div>
      
      <!-- System Registers -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-700">
        <div class="bg-slate-800 rounded p-3 border border-slate-600">
          <div class="text-xs text-slate-400 font-mono">SP (Stack Pointer)</div>
          <div class="text-lg font-mono text-slate-200">${formatHex(stackPointer)}</div>
        </div>
        
        <div class="bg-slate-800 rounded p-3 border border-slate-600">
          <div class="text-xs text-slate-400 font-mono">PC (Program Counter)</div>
          <div class="text-lg font-mono text-slate-200">${formatHex16(programCounter)}</div>
        </div>
        
        <div class="bg-slate-800 rounded p-3 border border-slate-600">
          <div class="text-xs text-slate-400 font-mono">P (Status)</div>
          <div class="text-lg font-mono text-slate-200">${formatHex(status)}</div>
        </div>
      </div>
    </div>
  )}
  
  <!-- Register Layout Diagram -->
  <div class="mt-6 pt-4 border-t border-slate-700">
    <h4 class="text-sm font-bold text-slate-400 mb-3">6502 Register Layout</h4>
    <div class="bg-black rounded p-4 font-mono text-xs">
      <div class="grid grid-cols-8 gap-1 text-center">
        <div class="text-green-400">Bit:</div>
        <div class="text-green-400">7</div>
        <div class="text-green-400">6</div>
        <div class="text-green-400">5</div>
        <div class="text-green-400">4</div>
        <div class="text-green-400">3</div>
        <div class="text-green-400">2</div>
        <div class="text-green-400">1</div>
        <div class="text-green-400">0</div>
      </div>
      <div class="grid grid-cols-9 gap-1 text-center mt-2">
        <div class="text-blue-400">A:</div>
        {Array.from({ length: 8 }, (_, i) => {
          const bit = 7 - i;
          const value = parseInt(registerA, 16);
          const bitValue = (value >> bit) & 1;
          return (
            <div class={`w-6 h-6 flex items-center justify-center rounded ${bitValue ? 'bg-blue-600 text-white' : 'bg-slate-700 text-slate-400'}`}>
              {bitValue}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</div>

<style>
  .register-bit {
    transition: all 0.3s ease;
  }
  
  .register-bit:hover {
    transform: scale(1.1);
  }
</style>