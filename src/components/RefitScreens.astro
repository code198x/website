---
/**
 * Put on a page that uses the kit's Screen, Figure or Loading.
 *
 * Those fit every capture on the page to a whole multiple of its grid when
 * their bundled script first runs. Astro's ClientRouter runs a bundled script
 * once per session, so after a soft navigation the new page's captures would
 * sit at their unfitted size. This re-runs the kit's fitting on every
 * astro:page-load; the kit exposes it as window.fitScreens.
 */
---

<script>
  document.addEventListener('astro:page-load', () => {
    (window as unknown as { fitScreens?: () => void }).fitScreens?.();
  });
</script>
