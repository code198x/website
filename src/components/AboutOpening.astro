---
import OpeningBand from './OpeningBand.astro';
---
<OpeningBand class="about-opening" labelledby="about-title" focal="left center"
  art={{ src: '/images/about-opening/landscape-2172.webp', srcset: '/images/about-opening/landscape-1280.webp 1280w, /images/about-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }}
  phoneArt={{ src: '/images/about-opening/phone-600.webp', srcset: '/images/about-opening/phone-600.webp 600w, /images/about-opening/phone-1200.webp 1200w', width: 1200, height: 1200 }}
  caption="An imagined machine, opened into layers, not a technical diagram.">
  <h1 id="about-title">Understand<br />the machine.<span>Make something<br />with it.</span></h1>
</OpeningBand>

<style>
  @layer legacy {
  h1 { margin: 0; max-width: 46%; font: 900 italic clamp(2.25rem, 4.4cqw, 4.75rem)/1 var(--h-font-mag); letter-spacing: -.025em; color: var(--h-ink); overflow-wrap: anywhere; }
  h1 span { display: block; margin-top: .35em; }
  @media (max-width: 1000px) {
    h1 { max-width: 100%; font-size: clamp(1.9rem, 9cqw, 2.8rem); line-height: .98; }
    h1 span { margin-top: .15em; }
  }
  }
</style>
