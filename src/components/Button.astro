---
export interface Props {
  variant?: "primary" | "secondary" | "success" | "ghost" | "outline";
  size?: "small" | "medium" | "large";
  href?: string;
  type?: "button" | "submit" | "reset";
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: "left" | "right";
  class?: string;
  style?: string;
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "medium",
  href,
  type = "button",
  fullWidth = false,
  icon,
  iconPosition = "left",
  class: className = "",
  style = "",
  disabled = false,
} = Astro.props;

const Component = href ? "a" : "button";
const componentProps = href 
  ? { href } 
  : { type, disabled };

const classes = [
  "btn",
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth && "btn--full-width",
  disabled && "btn--disabled",
  className
].filter(Boolean).join(" ");
---

<Component
  {...componentProps}
  class={classes}
  style={style}
>
  {icon && iconPosition === "left" && (
    <span class="btn__icon btn__icon--left">{icon}</span>
  )}
  <span class="btn__text">
    <slot />
  </span>
  {icon && iconPosition === "right" && (
    <span class="btn__icon btn__icon--right">{icon}</span>
  )}
</Component>

