---
export interface Props {
  variant?: "primary" | "secondary" | "success" | "ghost" | "outline";
  size?: "small" | "medium" | "large";
  href?: string;
  type?: "button" | "submit" | "reset";
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: "left" | "right";
  class?: string;
  style?: string;
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "medium",
  href,
  type = "button",
  fullWidth = false,
  icon,
  iconPosition = "left",
  class: className = "",
  style = "",
  disabled = false,
} = Astro.props;

const Component = href ? "a" : "button";
const componentProps = href 
  ? { href } 
  : { type, disabled };

const classes = [
  "btn",
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth && "btn--full-width",
  disabled && "btn--disabled",
  className
].filter(Boolean).join(" ");
---

<Component
  {...componentProps}
  class={classes}
  style={style}
>
  {icon && iconPosition === "left" && (
    <span class="btn__icon btn__icon--left">{icon}</span>
  )}
  <span class="btn__text">
    <slot />
  </span>
  {icon && iconPosition === "right" && (
    <span class="btn__icon btn__icon--right">{icon}</span>
  )}
</Component>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-weight: 500;
    text-decoration: none;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 1;
    position: relative;
    white-space: nowrap;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }

  /* Sizes */
  .btn--small {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
  }

  .btn--medium {
    padding: var(--space-md) var(--space-lg);
    font-size: 1rem;
  }

  .btn--large {
    padding: var(--space-lg) var(--space-xl);
    font-size: 1.125rem;
    font-weight: 600;
  }

  /* Variants */
  .btn--primary {
    background-color: var(--brand-blue);
    color: var(--text-inverse);
  }

  .btn--primary:hover {
    background-color: var(--brand-blue-dark, #1e40af);
    box-shadow: var(--shadow-md);
  }

  .btn--secondary {
    background-color: var(--brand-gray, #64748b);
    color: var(--text-inverse);
  }

  .btn--secondary:hover {
    background-color: var(--brand-gray-dark, #475569);
    box-shadow: var(--shadow-md);
  }

  .btn--success {
    background-color: var(--brand-green, #22c55e);
    color: var(--text-inverse);
  }

  .btn--success:hover {
    background-color: var(--brand-green-dark, #16a34a);
    box-shadow: var(--shadow-md);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--text-primary);
  }

  .btn--ghost:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .btn--outline {
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid currentColor;
  }

  .btn--outline:hover {
    background-color: var(--text-primary);
    color: white;
  }

  /* Special outline variant for dark backgrounds */
  .btn--outline.btn--inverse {
    color: var(--text-inverse);
    border-color: var(--text-inverse);
  }

  .btn--outline.btn--inverse:hover {
    background-color: var(--text-inverse);
    color: var(--text-primary);
  }

  /* Full width */
  .btn--full-width {
    width: 100%;
  }

  /* Disabled state */
  .btn--disabled,
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Icon handling */
  .btn__icon {
    display: inline-flex;
    align-items: center;
    font-size: 1.25em;
  }

  .btn__icon--left {
    margin-right: calc(var(--space-sm) / 2);
  }

  .btn__icon--right {
    margin-left: calc(var(--space-sm) / 2);
  }

  .btn--large .btn__icon {
    font-size: 1.5em;
  }

  .btn__text {
    display: inline-flex;
    align-items: center;
  }

  /* Focus styles for accessibility */
  .btn:focus-visible {
    outline: 2px solid var(--brand-blue);
    outline-offset: 2px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .btn--large {
      padding: var(--space-md) var(--space-lg);
      font-size: 1rem;
    }
  }
</style>