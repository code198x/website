---
import Grid from '@198x-ui/components/layout/Grid.astro';
import { ArrowRight } from '@lucide/astro';
interface Props { paths: Array<{ article: string; question: string; description: string; title: string }> }
const { paths } = Astro.props;
---
<section class="vault-reading-paths" aria-labelledby="reading-paths-title">
  <h2 id="reading-paths-title">Follow a question.</h2>
  <Grid min="13rem" space={8} maxColumns={3} class="vault-path-list">
    {paths.map(path => <a href={`/vault/${path.article}/`}>
      <h3>{path.question}</h3>
      <p>{path.description}</p>
      <span>{path.title} <ArrowRight size={19} aria-hidden="true"/></span>
    </a>)}
  </Grid>
</section>
