---
/**
 * Search - Site-wide search using Pagefind
 *
 * Usage:
 *   import Search from '@components/Search.astro';
 *   <Search />
 *
 * Opens a modal search dialog. Pagefind indexes the site at build time.
 */
---

<button class="search-trigger" aria-label="Search" title="Search (Ctrl+K)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-shortcut">⌘K</span>
</button>

<dialog class="search-modal">
  <div class="search-container">
    <div id="search"></div>
    <button class="search-close" aria-label="Close search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</dialog>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all var(--transition-base);
  }

  .search-trigger:hover {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .search-shortcut {
    font-size: 0.75rem;
    font-family: var(--font-family-mono);
    background: var(--color-surface);
    padding: 0.125rem 0.375rem;
    border-radius: 0;
    border: 1px solid var(--color-border);
  }

  /* Modal */
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    padding: 0;
    max-width: none;
    max-height: none;
    z-index: 200;
  }

  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .search-modal[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-container {
    background: var(--color-bg);
    border-radius: 0;
    box-shadow: var(--shadow-lg);
    width: 90%;
    max-width: 600px;
    max-height: 70vh;
    overflow: hidden;
    position: relative;
  }

  .search-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    padding: var(--space-2);
    border-radius: 0;
    transition: all var(--transition-base);
    z-index: 10;
  }

  .search-close:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  /* Pagefind UI overrides */
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--font-family-sans);
  }

  /* Hide on small screens */
  @media (max-width: 768px) {
    .search-shortcut {
      display: none;
    }

    .search-container {
      width: 95%;
      margin-top: var(--space-4);
    }

    .search-modal[open] {
      padding-top: var(--space-8);
    }
  }
</style>

<script is:inline>
  let pagefindLoaded = false;

  async function loadPagefind() {
    if (pagefindLoaded) return;

    try {
      // Dynamic import at runtime only
      const pagefind = await import('/pagefind/pagefind-ui.js');
      new pagefind.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
      });
      pagefindLoaded = true;
    } catch (e) {
      console.warn('Pagefind not available - run npm run build to generate search index');
      const searchEl = document.getElementById('search');
      if (searchEl) {
        searchEl.textContent = 'Search is only available in production builds. Run npm run build to enable search.';
        searchEl.style.cssText = 'padding: 2rem; text-align: center; color: var(--color-text-secondary);';
      }
    }
  }

  const trigger = document.querySelector('.search-trigger');
  const modal = document.querySelector('.search-modal');
  const closeBtn = document.querySelector('.search-close');

  function openSearch() {
    loadPagefind();
    modal?.showModal();
    // Focus the search input after modal opens
    setTimeout(() => {
      const input = modal?.querySelector('input');
      input?.focus();
    }, 100);
  }

  function closeSearch() {
    modal?.close();
  }

  // Trigger button
  trigger?.addEventListener('click', openSearch);

  // Close button
  closeBtn?.addEventListener('click', closeSearch);

  // Click outside to close
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeSearch();
    }
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Cmd/Ctrl + K to open
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (modal?.open) {
        closeSearch();
      } else {
        openSearch();
      }
    }

    // Escape to close
    if (e.key === 'Escape' && modal?.open) {
      closeSearch();
    }
  });
</script>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
