---
/**
 * Search - Site-wide search using Pagefind
 *
 * Usage:
 *   import Search from '@components/Search.astro';
 *   <Search />
 *
 * Opens a modal search dialog. Pagefind indexes the site at build time.
 */
---

<button class="search-trigger" type="button" aria-label="Search" title="Search (Ctrl+K)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</button>

<dialog class="search-modal" aria-label="Search the site">
  <div class="search-container">
    <div id="search"></div>
    <button class="search-close" aria-label="Close search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</dialog>

<style>
  /* An icon control in the nav bar: one square, five cells a side (§7). */
  .search-trigger {
    display: grid;
    place-items: center;
    width: calc(var(--h-cell) * 5);
    height: calc(var(--h-cell) * 5);
    padding: 0;
    background: var(--h-wash);
    border: 0;
    border-radius: 0;
    cursor: pointer;
    color: var(--h-ink);
    touch-action: manipulation;
  }

  .search-trigger:hover {
    background: var(--h-wash-2);
  }

  /* Modal */
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    padding: 0;
    max-width: none;
    max-height: none;
    z-index: 200;
  }

  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .search-modal[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-container {
    background: var(--color-bg);
    border-radius: 0;
    box-shadow: var(--shadow-lg);
    width: 90%;
    max-width: 600px;
    max-height: 70vh;
    overflow: auto;
    position: relative;
    padding: 56px 20px 20px;
  }

  .search-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    padding: var(--space-2);
    border-radius: 0;
    touch-action: manipulation;
    transition: background-color var(--transition-base), color var(--transition-base);
    z-index: 10;
  }

  .search-close:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  /* Pagefind UI overrides */
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--font-family-sans);
  }

  /* Hide on small screens */
  @media (max-width: 768px) {
    .search-container {
      width: 95%;
      margin-top: var(--space-4);
    }

    .search-modal[open] {
      padding-top: var(--space-8);
    }
  }
</style>

<script is:inline>
  // This inline script runs again on every soft navigation, and the modal and
  // its #search mount are replaced with the page. So it is wrapped in a
  // function (a second top-level `let` throws), elements are found when they
  // are used, Pagefind mounts into whichever #search is still empty, and the
  // document-level listeners are added once per document.
  (() => {
    const modal = () => document.querySelector('.search-modal');

    async function loadPagefind() {
      const mount = document.getElementById('search');
      if (!mount || mount.dataset.mounted) return;
      if (mount.dataset.loading) return;
      mount.dataset.loading = 'true';
      mount.setAttribute('aria-busy', 'true');
      mount.textContent = 'Loading search…';
      try {
        // The distributed UI is an IIFE which installs window.PagefindUI.
        await import('/pagefind/pagefind-ui.js');
        if (!mount.isConnected) return;
        mount.textContent = '';
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
        });
        mount.dataset.mounted = 'true';
      } catch (error) {
        console.warn('Search could not load', error);
        mount.textContent = 'Search could not load. Check your connection and try again. ';
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.textContent = 'Try again';
        retry.addEventListener('click', openSearch);
        mount.append(retry);
      } finally {
        delete mount.dataset.loading;
        mount.removeAttribute('aria-busy');
      }
    }

    async function openSearch() {
      const dialog = modal();
      if (!dialog) return;
      if (!dialog.open) {
        // A keyboard shortcut has no trigger click to restore focus to.
        document.querySelector('.search-trigger')?.focus();
        dialog.showModal();
      }
      await loadPagefind();
      if (dialog.isConnected && dialog.open) {
        dialog.querySelector('input')?.focus();
      }
    }

    function closeSearch() {
      modal()?.close();
    }

    if (window.__searchBound) return;
    window.__searchBound = true;

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      if (e.target.closest('.search-trigger')) openSearch();
      else if (e.target.closest('.search-close')) closeSearch();
      // A click on the backdrop lands on the dialog itself.
      else if (e.target === modal()) closeSearch();
    });

    // Cmd/Ctrl + K opens and closes. Escape is the dialog's own.
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal()?.open) closeSearch();
        else openSearch();
      }
    });
  })();
</script>

{/* Pagefind assets only exist after `astro build` runs Pagefind, so requesting
    this in dev 404s through the [...slug] catch-all. Load it in builds only;
    the search UI's JS import (above) already degrades gracefully in dev. */}
{import.meta.env.PROD && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
