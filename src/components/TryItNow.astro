---
export interface Props {
  title?: string;
}

const { title = "Try It Now" } = Astro.props;
---

<div class="try-it-now">
  <div class="try-it-now__header">
    <span class="try-it-now__icon">⌨️</span>
    <span class="try-it-now__title">{title}</span>
  </div>
  <div class="try-it-now__content">
    <slot />
  </div>
</div>

<style>
  .try-it-now {
    background: var(--color-bg-secondary, #1a1a2e);
    border: 2px solid var(--color-primary, #4a9eff);
    border-radius: var(--radius-lg, 8px);
    margin: var(--space-lg, 2rem) 0;
    overflow: hidden;
  }

  .try-it-now__header {
    background: var(--color-primary, #4a9eff);
    color: var(--color-text-on-primary, #ffffff);
    padding: var(--space-sm, 1rem) var(--space-md, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--space-sm, 1rem);
    font-weight: var(--font-weight-bold, 700);
  }

  .try-it-now__icon {
    font-size: 1.25rem;
  }

  .try-it-now__title {
    font-size: var(--font-size-lg, 1.125rem);
  }

  .try-it-now__content {
    padding: var(--space-md, 1.5rem);
  }

  /* Override code block margins when inside try-it-now */
  .try-it-now__content :global(.code-block) {
    margin: 0;
    border: none;
  }

  /* Dark mode adjustments */
  .dark-mode .try-it-now {
    background: var(--color-bg-tertiary, #0f0f1e);
    border-color: var(--color-primary-light, #6eb5ff);
  }

  .dark-mode .try-it-now__header {
    background: linear-gradient(135deg, var(--color-primary, #4a9eff), var(--color-primary-dark, #2a7edd));
  }

  /* Responsive */
  @media (max-width: 640px) {
    .try-it-now {
      margin: var(--space-md, 1.5rem) -var(--space-sm, 1rem);
      border-radius: 0;
      border-left: none;
      border-right: none;
    }

    .try-it-now__header {
      padding: var(--space-xs, 0.5rem) var(--space-sm, 1rem);
    }

    .try-it-now__content {
      padding: var(--space-sm, 1rem);
    }
  }
</style>