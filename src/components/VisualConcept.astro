---
export interface Props {
  type: 'memory-map' | 'register-state' | 'instruction-flow' | 'stack-operation' | 'addressing-mode';
  system: 'commodore-64' | 'zx-spectrum' | 'nintendo-entertainment-system' | 'commodore-amiga';
  title: string;
  data?: any;
  interactive?: boolean;
  highlightAddress?: string;
  currentInstruction?: string;
}

const { 
  type, 
  system, 
  title, 
  data = {}, 
  interactive = false,
  highlightAddress = '',
  currentInstruction = ''
} = Astro.props;

// System-specific colors
const getSystemColors = (systemSlug: string) => {
  switch(systemSlug) {
    case 'commodore-64':
      return { 
        primary: '#8B7355', 
        secondary: '#6B5B47', 
        accent: '#F6F4F0',
        text: 'text-c64-brown'
      };
    case 'zx-spectrum':
      return { 
        primary: '#FF0000', 
        secondary: '#FF00FF', 
        accent: '#FFFF00',
        text: 'text-spectrum-red'
      };
    case 'nintendo-entertainment-system':
      return { 
        primary: '#922B3E', 
        secondary: '#373737', 
        accent: '#E8E8E8',
        text: 'text-nes-red'
      };
    case 'commodore-amiga':
      return { 
        primary: '#0055AA', 
        secondary: '#FF8800', 
        accent: '#FFFFFF',
        text: 'text-amiga-blue'
      };
    default:
      return { 
        primary: '#6B7280', 
        secondary: '#374151', 
        accent: '#F3F4F6',
        text: 'text-gray-600'
      };
  }
};

const colors = getSystemColors(system);
const visualId = `visual-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="visual-concept bg-white/90 rounded-xl shadow-lg border border-gray-200 overflow-hidden">
  <!-- Header -->
  <div class="bg-gradient-to-r from-gray-700 to-gray-800 text-white px-4 py-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-white/20 rounded-lg flex items-center justify-center text-sm" style="width: 2rem; height: 2rem;">
          {type === 'memory-map' && '🧠'}
          {type === 'register-state' && '📊'}
          {type === 'instruction-flow' && '🔄'}
          {type === 'stack-operation' && '📚'}
          {type === 'addressing-mode' && '📍'}
        </div>
        <div>
          <h3 class="font-bold text-sm">{title}</h3>
          <p class="text-white/80 text-xs">
            {type ? type.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ') : 'Visual Concept'}
          </p>
        </div>
      </div>
      
      {interactive && (
        <div class="flex items-center gap-2">
          <button 
            class="visual-step-btn px-3 py-1 bg-white/20 hover:bg-white/30 rounded text-xs font-medium transition-colors"
            data-visual-id={visualId}
          >
            ▶ Step
          </button>
          <button 
            class="visual-reset-btn px-3 py-1 bg-white/20 hover:bg-white/30 rounded text-xs font-medium transition-colors"
            data-visual-id={visualId}
          >
            🔄 Reset
          </button>
        </div>
      )}
    </div>
  </div>

  <!-- Visual Content -->
  <div class="p-6">
    <div 
      id={visualId}
      class="visual-content"
      data-type={type}
      data-system={system}
      data-data={JSON.stringify(data)}
      data-interactive={interactive}
      data-highlight-address={highlightAddress}
      data-current-instruction={currentInstruction}
    >
      <!-- Content will be dynamically generated based on type -->
      {type === 'memory-map' && (
        <div class="memory-map-container">
          <div class="grid grid-cols-8 gap-1 text-xs font-mono">
            <!-- Memory addresses will be populated by JavaScript -->
            <div class="loading-placeholder text-center text-gray-500 col-span-8 py-8">
              Loading memory map visualization...
            </div>
          </div>
        </div>
      )}

      {type === 'register-state' && (
        <div class="register-state-container">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- Registers will be populated by JavaScript -->
            <div class="loading-placeholder text-center text-gray-500 col-span-full py-8">
              Loading register state visualization...
            </div>
          </div>
        </div>
      )}

      {type === 'instruction-flow' && (
        <div class="instruction-flow-container">
          <div class="flow-diagram space-y-4">
            <!-- Instruction flow will be populated by JavaScript -->
            <div class="loading-placeholder text-center text-gray-500 py-8">
              Loading instruction flow visualization...
            </div>
          </div>
        </div>
      )}

      {type === 'stack-operation' && (
        <div class="stack-operation-container">
          <div class="stack-visualization flex justify-center">
            <!-- Stack will be populated by JavaScript -->
            <div class="loading-placeholder text-center text-gray-500 py-8">
              Loading stack operation visualization...
            </div>
          </div>
        </div>
      )}

      {type === 'addressing-mode' && (
        <div class="addressing-mode-container">
          <div class="addressing-diagram space-y-4">
            <!-- Addressing modes will be populated by JavaScript -->
            <div class="loading-placeholder text-center text-gray-500 py-8">
              Loading addressing mode visualization...
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Controls (if interactive) -->
  {interactive && (
    <div class="bg-gray-50 px-4 py-3 border-t border-gray-200">
      <div class="flex items-center justify-between text-xs text-gray-600">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1">
            <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
            Interactive Mode
          </span>
          <span class="visual-step-counter">Step: 0</span>
        </div>
        <div class="visual-status">Ready</div>
      </div>
    </div>
  )}
</div>

<!-- CSS for visual styling -->
<style>
  .memory-cell {
    width: 2rem;
    height: 2rem;
    border: 1px solid #d1d5db;
    border-radius: 0.25rem;
    text-align: center;
    font-size: 0.75rem;
    font-family: monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .memory-cell.highlighted {
    background-color: #fef3c7;
    border-color: #f59e0b;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transform: scale(1.1);
  }
  
  .memory-cell.active {
    background-color: #dbeafe;
    border-color: #3b82f6;
  }
  
  .register-box {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    padding: 0.75rem;
    text-align: center;
    transition: all 0.3s ease;
  }
  
  .register-box.changed {
    background-color: #fef3c7;
    border-color: #d97706;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  .register-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #4b5563;
    margin-bottom: 0.25rem;
  }
  
  .register-value {
    font-size: 1.125rem;
    font-family: monospace;
    font-weight: 700;
  }
  
  .instruction-step {
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.3s ease;
  }
  
  .instruction-step.current {
    background-color: #eff6ff;
    border-color: #3b82f6;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  .instruction-step.completed {
    background-color: #f0fdf4;
    border-color: #16a34a;
  }
  
  .stack-item {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 0.25rem;
    padding: 0.5rem 0.75rem;
    text-align: center;
    font-family: monospace;
    font-size: 0.875rem;
    transition: all 0.3s ease;
  }
  
  .stack-item.top {
    background-color: #dbeafe;
    border-color: #3b82f6;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  .stack-item.pushed {
    background-color: #dcfce7;
    border-color: #16a34a;
    animation: slideIn 0.5s ease;
  }
  
  .stack-item.popped {
    background-color: #fee2e2;
    border-color: #dc2626;
    animation: slideOut 0.5s ease;
  }
  
  @keyframes slideIn {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  
  @keyframes slideOut {
    from { transform: translateY(0); opacity: 1; }
    to { transform: translateY(20px); opacity: 0; }
  }
  
  .loading-placeholder {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>

<!-- JavaScript for visual concepts -->
<script>
  // Visual concept data and configurations
  const VISUAL_CONFIGS = {
    'commodore-64': {
      memoryRanges: {
        'BASIC ROM': { start: 0xA000, end: 0xBFFF, color: '#8B7355' },
        'VIC-II': { start: 0xD000, end: 0xD3FF, color: '#6B5B47' },
        'SID': { start: 0xD400, end: 0xD7FF, color: '#F6F4F0' },
        'KERNAL ROM': { start: 0xE000, end: 0xFFFF, color: '#8B7355' }
      },
      registers: ['A', 'X', 'Y', 'PC', 'SP', 'P'],
      processorType: '6502'
    },
    'zx-spectrum': {
      memoryRanges: {
        'ROM': { start: 0x0000, end: 0x3FFF, color: '#FF0000' },
        'Screen': { start: 0x4000, end: 0x57FF, color: '#FFFF00' },
        'Attributes': { start: 0x5800, end: 0x5AFF, color: '#FF00FF' },
        'RAM': { start: 0x5B00, end: 0xFFFF, color: '#00FF00' }
      },
      registers: ['A', 'B', 'C', 'D', 'E', 'H', 'L', 'PC', 'SP'],
      processorType: 'Z80'
    },
    'nintendo-entertainment-system': {
      memoryRanges: {
        'Zero Page': { start: 0x0000, end: 0x00FF, color: '#922B3E' },
        'Stack': { start: 0x0100, end: 0x01FF, color: '#373737' },
        'RAM': { start: 0x0200, end: 0x07FF, color: '#E8E8E8' },
        'PPU': { start: 0x2000, end: 0x2007, color: '#922B3E' }
      },
      registers: ['A', 'X', 'Y', 'PC', 'SP', 'P'],
      processorType: '6502'
    },
    'commodore-amiga': {
      memoryRanges: {
        'Chip RAM': { start: 0x000000, end: 0x07FFFF, color: '#0055AA' },
        'CIA-A': { start: 0xBFE001, end: 0xBFE1FF, color: '#FF8800' },
        'CIA-B': { start: 0xBFD000, end: 0xBFDFFF, color: '#FF8800' },
        'Custom Chips': { start: 0xDFF000, end: 0xDFFFFF, color: '#0055AA' }
      },
      registers: ['D0', 'D1', 'D2', 'D3', 'D4', 'D5', 'D6', 'D7', 'A0', 'A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7', 'PC', 'SR'],
      processorType: '68000'
    }
  };

  // Initialize all visual concepts on page load
  document.addEventListener('DOMContentLoaded', () => {
    const visuals = document.querySelectorAll('[id^="visual-"]');
    
    visuals.forEach(visualElement => {
      const type = visualElement.dataset.type;
      const system = visualElement.dataset.system;
      const data = JSON.parse(visualElement.dataset.data || '{}');
      const interactive = visualElement.dataset.interactive === 'true';
      
      initializeVisualConcept(visualElement, type, system, data, interactive);
    });
  });

  // Initialize specific visual concept
  function initializeVisualConcept(element, type, system, data, interactive) {
    const config = VISUAL_CONFIGS[system];
    
    switch(type) {
      case 'memory-map':
        createMemoryMapVisualization(element, config, data);
        break;
      case 'register-state':
        createRegisterStateVisualization(element, config, data);
        break;
      case 'instruction-flow':
        createInstructionFlowVisualization(element, config, data);
        break;
      case 'stack-operation':
        createStackOperationVisualization(element, config, data);
        break;
      case 'addressing-mode':
        createAddressingModeVisualization(element, config, data);
        break;
    }
    
    if (interactive) {
      setupInteractiveControls(element, type);
    }
  }

  // Create memory map visualization
  function createMemoryMapVisualization(element, config, data) {
    const container = element.querySelector('.memory-map-container .grid');
    container.innerHTML = '';
    
    // Create memory cells for key ranges
    Object.entries(config.memoryRanges).forEach(([name, range]) => {
      const cell = document.createElement('div');
      cell.className = 'memory-cell';
      cell.style.backgroundColor = range.color + '40'; // Add transparency
      cell.style.borderColor = range.color;
      cell.textContent = name;
      cell.title = `${name}: $${range.start.toString(16).toUpperCase().padStart(4, '0')} - $${range.end.toString(16).toUpperCase().padStart(4, '0')}`;
      container.appendChild(cell);
    });
  }

  // Create register state visualization
  function createRegisterStateVisualization(element, config, data) {
    const container = element.querySelector('.register-state-container .grid');
    container.innerHTML = '';
    
    config.registers.forEach(register => {
      const registerDiv = document.createElement('div');
      registerDiv.className = 'register-box';
      registerDiv.innerHTML = `
        <div class="register-label">${register}</div>
        <div class="register-value">$00</div>
      `;
      container.appendChild(registerDiv);
    });
  }

  // Create instruction flow visualization
  function createInstructionFlowVisualization(element, config, data) {
    const container = element.querySelector('.instruction-flow-container .flow-diagram');
    container.innerHTML = '';
    
    const steps = [
      'Fetch instruction from memory',
      'Decode instruction opcode',
      'Execute instruction operation',
      'Update processor state'
    ];
    
    steps.forEach((step, index) => {
      const stepDiv = document.createElement('div');
      stepDiv.className = 'instruction-step';
      stepDiv.innerHTML = `
        <div class="flex-shrink-0 bg-blue-500 text-white rounded-full flex items-center justify-center text-sm font-bold" style="width: 2rem; height: 2rem;">
          ${index + 1}
        </div>
        <div class="flex-1">
          <p class="font-medium">${step}</p>
        </div>
      `;
      container.appendChild(stepDiv);
    });
  }

  // Create stack operation visualization
  function createStackOperationVisualization(element, config, data) {
    const container = element.querySelector('.stack-operation-container .stack-visualization');
    container.innerHTML = '';
    
    const stackDiv = document.createElement('div');
    stackDiv.className = 'space-y-2';
    stackDiv.innerHTML = `
      <div class="text-center text-sm font-bold mb-4">Stack Pointer: $01FF</div>
      <div class="stack-item top">$FF (Top)</div>
      <div class="stack-item">$FE</div>
      <div class="stack-item">$FD</div>
      <div class="stack-item">$FC</div>
      <div class="text-center text-xs text-gray-500 mt-4">Stack grows downward</div>
    `;
    container.appendChild(stackDiv);
  }

  // Create addressing mode visualization
  function createAddressingModeVisualization(element, config, data) {
    const container = element.querySelector('.addressing-mode-container .addressing-diagram');
    container.innerHTML = '';
    
    const modes = [
      { name: 'Immediate', example: 'LDA #$FF', description: 'Load literal value' },
      { name: 'Zero Page', example: 'LDA $80', description: 'Load from zero page' },
      { name: 'Absolute', example: 'LDA $1000', description: 'Load from absolute address' },
      { name: 'Indexed', example: 'LDA $80,X', description: 'Load with index offset' }
    ];
    
    modes.forEach(mode => {
      const modeDiv = document.createElement('div');
      modeDiv.className = 'bg-gray-50 border border-gray-200 rounded-lg p-4';
      modeDiv.innerHTML = `
        <div class="font-bold text-sm mb-1">${mode.name}</div>
        <div class="font-mono text-xs bg-gray-800 text-green-400 px-2 py-1 rounded mb-2">${mode.example}</div>
        <div class="text-xs text-gray-600">${mode.description}</div>
      `;
      container.appendChild(modeDiv);
    });
  }

  // Setup interactive controls
  function setupInteractiveControls(element, type) {
    // Add event listeners for step and reset buttons
    const stepBtn = element.closest('.visual-concept').querySelector('.visual-step-btn');
    const resetBtn = element.closest('.visual-concept').querySelector('.visual-reset-btn');
    
    if (stepBtn) {
      stepBtn.addEventListener('click', () => stepVisualization(element, type));
    }
    
    if (resetBtn) {
      resetBtn.addEventListener('click', () => resetVisualization(element, type));
    }
  }

  // Step through visualization
  function stepVisualization(element, type) {
    // Implementation depends on visualization type
    console.log('Stepping through', type, 'visualization');
  }

  // Reset visualization
  function resetVisualization(element, type) {
    // Implementation depends on visualization type
    console.log('Resetting', type, 'visualization');
  }
</script>