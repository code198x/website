---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  system?: "commodore-64" | "sinclair-zx-spectrum" | "nintendo-entertainment-system" | "amiga";
  type?: "program-output" | "code-editor" | "hardware" | "magazine";
}

const { src, alt, caption, system = "commodore-64", type = "program-output" } = Astro.props;

const systemColors = {
  "commodore-64": "#6c5ce7",
  "sinclair-zx-spectrum": "#e17055",
  "nintendo-entertainment-system": "#e84393",
  "amiga": "#fdcb6e"
};

const borderColor = systemColors[system];
---

<figure class="screenshot-box" data-system={system} data-type={type}>
  <div class="screenshot-frame">
    <div class="screenshot-scanlines"></div>
    <img src={src} alt={alt} class="screenshot-image" loading="lazy" />
    <div class="screenshot-overlay"></div>
  </div>
  {caption && (
    <figcaption class="screenshot-caption">
      {caption}
    </figcaption>
  )}
</figure>

<style define:vars={{ borderColor }}>
  .screenshot-box {
    margin: var(--space-xl, 2.5rem) 0;
    position: relative;
  }

  .screenshot-frame {
    position: relative;
    border: 3px solid var(--borderColor);
    border-radius: var(--radius-md, 6px);
    overflow: hidden;
    background: #000;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 2px 0 rgba(255, 255, 255, 0.1);
    transform: perspective(1000px) rotateX(1deg);
  }

  .screenshot-frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.15) 100%
    );
    pointer-events: none;
    z-index: 3;
  }

  .screenshot-image {
    width: 100%;
    height: auto;
    display: block;
    filter: contrast(1.1) brightness(0.95);
    position: relative;
    z-index: 1;
  }

  .screenshot-scanlines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
      );
    pointer-events: none;
    z-index: 2;
    opacity: 0.7;
  }

  .screenshot-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 0%,
      transparent 70%,
      rgba(0, 0, 0, 0.2) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .screenshot-caption {
    margin-top: var(--space-sm, 1rem);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #b0b0c0);
    text-align: center;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Type-specific styling */
  .screenshot-box[data-type="hardware"] .screenshot-frame {
    border-radius: var(--radius-lg, 8px);
    transform: perspective(1000px) rotateX(2deg) rotateY(-1deg);
  }

  .screenshot-box[data-type="magazine"] .screenshot-frame {
    border-radius: var(--radius-sm, 4px);
    transform: perspective(1000px) rotateX(-1deg) rotateZ(0.5deg);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.3),
      inset 0 2px 0 rgba(255, 255, 255, 0.1);
  }

  .screenshot-box[data-type="code-editor"] .screenshot-scanlines {
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 1px,
        rgba(0, 255, 0, 0.05) 1px,
        rgba(0, 255, 0, 0.05) 2px
      );
  }

  /* Hover effects */
  .screenshot-frame:hover {
    transform: perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1.02);
    transition: transform 0.3s ease;
  }

  .screenshot-box[data-type="hardware"]:hover .screenshot-frame {
    transform: perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1.02);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .screenshot-box {
      margin: var(--space-lg, 2rem) -var(--space-sm, 1rem);
    }

    .screenshot-frame {
      border-radius: 0;
      transform: none;
    }

    .screenshot-frame:hover {
      transform: none;
    }

    .screenshot-caption {
      padding: 0 var(--space-sm, 1rem);
    }
  }

  /* Animation */
  .screenshot-frame {
    animation: crtFlicker 4s ease-in-out infinite alternate;
  }

  @keyframes crtFlicker {
    0%, 100% {
      filter: brightness(1) contrast(1);
    }
    50% {
      filter: brightness(1.02) contrast(1.05);
    }
  }
</style>