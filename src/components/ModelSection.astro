---
import { hardwareModelFor } from '../data/hardware-models';
import ModelIllustration from './ModelIllustration.astro';
interface Props { system: string; }
const model = hardwareModelFor(Astro.props.system);
---
{model && <section class="machine-model" aria-labelledby={`model-${model.system}`}>
  <div class="model-heading"><div><h2 id={`model-${model.system}`}>Look around the machine</h2><p>{model.variant}</p></div><a href={`/systems/models/#${model.system}`}>Explore the model gallery</a></div>
  <ModelIllustration model={model} />
</section>}
<style>@layer blocks {
  .machine-model { padding-block: 48px 64px; border-top: 1px solid var(--h-line); } /* taste-skill-ignore: House section divider matches the existing Systems pages. */
  .model-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 16px 32px; margin-bottom: 24px; }
  h2 { margin: 0; color: var(--h-ink); font: 700 var(--heading-h3-size)/1.2 var(--h-font-ui); }
  p { margin: 8px 0 0; color: var(--h-ink-body); font: 1.125rem/1.6 var(--h-font-ui); }
  a { color: var(--h-spot-ink); font: 600 1rem/1.6 var(--h-font-ui); text-underline-offset: .2em; }
  a:focus-visible { outline: 3px solid var(--h-spot); outline-offset: 4px; }
}</style>
