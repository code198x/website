---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  items: FAQItem[];
  variant?: "default" | "compact" | "bordered";
  class?: string;
}

const {
  title = "Frequently Asked Questions",
  items,
  variant = "default",
  class: className = "",
} = Astro.props;
---

<div class={`faq faq--${variant} ${className}`}>
  {title && <h2 class="faq__title">{title}</h2>}
  
  <div class="faq__list">
    {items.map((item) => (
      <details class="faq__item">
        <summary class="faq__question">{item.question}</summary>
        <div class="faq__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  /* FAQ Block */
  .faq {
    margin-bottom: var(--space-4xl);
  }

  .faq__title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-xl);
    color: var(--text-primary);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* FAQ Item */
  .faq__item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq__item[open] {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .faq__question {
    padding: var(--space-md) var(--space-lg);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-primary);
    transition: all 0.2s ease;
    position: relative;
  }

  .faq__question:hover {
    background: rgba(139, 92, 246, 0.03);
  }

  .faq__question::after {
    content: "+";
    font-size: 1.5rem;
    font-weight: 300;
    color: rgb(139, 92, 246);
    transition: transform 0.2s ease;
    margin-left: var(--space-md);
  }

  .faq__item[open] .faq__question::after {
    transform: rotate(45deg);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__answer {
    padding: 0 var(--space-lg) var(--space-lg) var(--space-lg);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .faq__answer p {
    margin: 0;
  }

  /* FAQ Variants */
  .faq--compact .faq__list {
    gap: var(--space-sm);
  }

  .faq--compact .faq__item {
    border-radius: 6px;
  }

  .faq--compact .faq__question {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.95rem;
  }

  .faq--compact .faq__answer {
    padding: 0 var(--space-md) var(--space-md) var(--space-md);
    font-size: 0.9rem;
  }

  .faq--bordered .faq__item {
    border: 2px solid rgba(139, 92, 246, 0.2);
    background: rgba(139, 92, 246, 0.02);
  }

  .faq--bordered .faq__item[open] {
    border-color: rgba(139, 92, 246, 0.4);
    background: white;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .faq__title {
      font-size: 1.5rem;
    }

    .faq__question {
      padding: var(--space-sm) var(--space-md);
      font-size: 0.95rem;
    }

    .faq__answer {
      padding: 0 var(--space-md) var(--space-md) var(--space-md);
    }
  }
</style>