---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  items: FAQItem[];
  variant?: "default" | "compact" | "bordered";
  class?: string;
}

const {
  title = "Frequently Asked Questions",
  items,
  variant = "default",
  class: className = "",
} = Astro.props;
---

<div class={`faq faq--${variant} ${className}`}>
  {title && <h2 class="faq__title">{title}</h2>}

  <div class="faq__list">
    {
      items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">{item.question}</summary>
          <div class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>
