---
export interface Props {
  title?: string;
  subtitle?: string;
  highlight?: boolean;
  dashed?: boolean;
  opacity?: number;
  icon?: string;
  class?: string;
}

const {
  title,
  subtitle,
  highlight = false,
  dashed = false,
  opacity = 1,
  icon,
  class: className = "",
} = Astro.props;
---

<div 
  class={`content-card ${highlight ? "content-card--highlight" : ""} ${dashed ? "content-card--dashed" : ""} ${className}`}
  style={opacity < 1 ? `opacity: ${opacity}` : ""}
>
  {icon && <div class="content-card__icon">{icon}</div>}
  {title && <h4 class="content-card__title">{title}</h4>}
  {subtitle && <p class="content-card__subtitle">{subtitle}</p>}
  <div class="content-card__content">
    <slot />
  </div>
</div>

<style>
  /* Content Card Block */
  .content-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    transition: all 0.2s ease;
  }

  .content-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Highlight Variant */
  .content-card--highlight {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(139, 92, 246, 0.02));
    border-color: rgba(139, 92, 246, 0.3);
  }

  .content-card--highlight:hover {
    box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.15);
  }

  /* Dashed Variant */
  .content-card--dashed {
    border-style: dashed;
    border-width: 2px;
    border-color: #cbd5e1;
    background: rgba(248, 250, 252, 0.5);
  }

  .content-card--dashed:hover {
    box-shadow: none;
    background: rgba(248, 250, 252, 0.8);
  }

  /* Content Card Elements */
  .content-card__icon {
    font-size: 2rem;
    margin-bottom: var(--space-md);
    color: rgb(139, 92, 246);
  }

  .content-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .content-card__subtitle {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .content-card__content {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .content-card__content p {
    margin: 0;
  }

  .content-card__content p + p {
    margin-top: var(--space-sm);
  }

  /* Nested Lists */
  .content-card__content ul,
  .content-card__content ol {
    margin: var(--space-sm) 0;
    padding-left: var(--space-lg);
  }

  .content-card__content li {
    margin-bottom: var(--space-xs);
  }

  /* Links in Content */
  .content-card__content a {
    color: rgb(139, 92, 246);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .content-card__content a:hover {
    color: rgb(124, 58, 237);
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .content-card {
      padding: var(--space-md);
    }

    .content-card__icon {
      font-size: 1.5rem;
    }

    .content-card__title {
      font-size: 1rem;
    }
  }
</style>