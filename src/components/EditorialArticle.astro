---
/** Article composition shared by the three editorial series, also used in previews. */
import PageFrame from './PageFrame.astro';
import PageHeader from './PageHeader.astro';
import '../styles/editorial-article.css';
export interface Props {
  series: 'from-the-metal' | 'field-notes' | 'updates';
  title: string;
  introduction?: string;
  eyebrow?: string;
  accent?: string;
}
const { series, title, introduction, eyebrow, accent } = Astro.props;
---
<PageFrame as="article" class="editorial-article" width="full" data-series={series} style={accent ? `--accent: ${accent}` : undefined}>
  <PageHeader title={title} description={introduction} eyebrow={eyebrow}><slot name="metadata" /></PageHeader>
  <slot name="hero" />
  <div class="editorial-body"><slot /></div>
  <slot name="ending" />
</PageFrame>
