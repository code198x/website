---
interface PositionLink {
  href: string;
  label: string;
  note?: string;
}

export interface Props {
  stage: string;
  title: string;
  body: string;
  links?: PositionLink[];
  notes?: string[];
  accentColor?: string;
}

const { title, body, links = [], notes = [] } = Astro.props;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<section
  class="curriculum-position"
  aria-label="About this track"
>
  <div class="position-copy">
    <h2 set:html={inlineMarkdown(title)} />
    <p set:html={inlineMarkdown(body)} />
  </div>

  {notes.length > 0 && (
    <ul class="position-notes" aria-label="Before you begin">
      {notes.map((note) => <li set:html={inlineMarkdown(note)} />)}
    </ul>
  )}

  {links.length > 0 && (
    <div class="position-links">
      {links.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          {link.note && <small>{link.note}</small>}
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .curriculum-position {
    max-width: var(--container-max-width);
    margin: var(--space-10) auto 0;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-6) var(--space-12);
    align-items: start;
  }
  .position-copy { min-width: 0; }
  h2 { font-family: var(--font-family-sans); font-size: 1.4rem; line-height: 1.3; color: var(--h-ink); margin: 0 0 var(--space-4); }
  .position-copy p, li { font-family: var(--font-family-read); color: var(--h-ink-body); line-height: 1.7; }
  .position-copy p { margin: 0; max-width: 70ch; }
  .position-notes { padding-left: var(--space-5); margin: 0; }
  li + li { margin-top: var(--space-3); }
  .position-links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); }
  .position-links a { display: flex; flex-direction: column; justify-content: center; min-height: 44px; color: var(--h-ink); text-decoration: none; }
  .position-links span { font-family: var(--font-family-sans); font-weight: 600; text-decoration: underline; text-underline-offset: .15em; }
  .position-links small { font-size: var(--h-text-small); color: var(--h-ink-muted); }
  @media (max-width: 760px) { .curriculum-position { grid-template-columns: 1fr; } }
</style>
