---
interface PositionLink {
  href: string;
  label: string;
  note?: string;
}

export interface Props {
  stage: string;
  title: string;
  body: string;
  links?: PositionLink[];
  notes?: string[];
  accentColor?: string;
}

const { stage, title, body, links = [], notes = [], accentColor } = Astro.props;
---

<section
  class="curriculum-position"
  style={accentColor ? `--cp: ${accentColor};` : undefined}
  aria-label="Where this sits in the curriculum"
>
  <div class="position-copy">
    <p class="eyebrow">Where you are</p>
    <h2>{stage}</h2>
    <h3>{title}</h3>
    <p>{body}</p>
  </div>

  {notes.length > 0 && (
    <ul class="position-notes" aria-label="Before you begin">
      {notes.map((note) => <li>{note}</li>)}
    </ul>
  )}

  {links.length > 0 && (
    <div class="position-links">
      {links.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          {link.note && <small>{link.note}</small>}
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .curriculum-position {
    --cp: var(--platform-color, var(--color-house-2));
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(220px, 0.8fr);
    gap: var(--space-5);
    align-items: start;
    max-width: 1000px;
    margin: var(--space-6) auto 0;
    padding: var(--space-5);
    border: 3px solid var(--color-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-chunky);
  }

  .position-copy {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cp);
    margin: 0;
  }

  .position-copy h2 {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: var(--space-2) 0 0;
  }

  .position-copy h3 {
    font-size: 1.25rem;
    line-height: 1.15;
    color: var(--color-text);
    margin: var(--space-1) 0 var(--space-2);
  }

  .position-copy p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .position-notes {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .position-notes li {
    border-left: 7px solid var(--cp);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.5;
    padding: var(--space-3);
  }

  .position-links {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-3);
  }

  .position-links a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 72px;
    border: 3px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .position-links a:hover,
  .position-links a:focus-visible {
    border-color: var(--cp);
    transform: translate(-2px, -2px);
    outline: none;
  }

  .position-links span {
    color: var(--ink);
    font-weight: 800;
  }

  .position-links small {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .curriculum-position {
      grid-template-columns: 1fr;
      margin-top: var(--space-4);
    }

    .position-links {
      grid-template-columns: 1fr;
    }
  }
</style>
