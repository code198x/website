---
import OpeningBand from './OpeningBand.astro';
---
<OpeningBand class="teaching-opening" labelledby="teaching-title" focal="right center"
  art={{ src: '/images/teaching-opening/landscape-2172.webp', srcset: '/images/teaching-opening/landscape-1280.webp 1280w, /images/teaching-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }}
  caption="Shared investigation around an imagined table.">
  <h1 id="teaching-title">Explore it together.</h1>
</OpeningBand>

<style>
  @layer legacy {
  h1 { margin: 0; font: 900 italic clamp(2.75rem, 4.6cqw, 4.125rem)/.99 var(--h-font-mag); letter-spacing: -.025em; text-wrap: balance; overflow-wrap: anywhere; color: var(--h-ink); max-width: 6em; }
  @media (max-width: 1000px) { h1 { font-size: clamp(2.5rem, 10.8cqw, 3.625rem); max-width: 12ch; } }
  }
</style>
