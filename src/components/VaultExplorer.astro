---
import { ArrowRight } from '@lucide/astro';
import type { resolveVaultExploration } from '../lib/vault-features';
interface Props {
  exploration: ReturnType<typeof resolveVaultExploration>;
  categories: Array<{ id: string; name: string }>;
}
const { exploration, categories } = Astro.props;
const categoryName = (id: string) => categories.find(category => category.id === id)?.name ?? id;
---
<section class="vault-explorer" aria-labelledby="vault-story-title">
  <article class="vault-story" data-vault-colour={exploration.colour}>
    <h2 id="vault-story-title">{exploration.headline}</h2>
    <a class="vault-story-action" href={`/vault/${exploration.entry.id}`}>
      Read {exploration.entry.data.title}<ArrowRight size={22} aria-hidden="true" />
    </a>
    <p class="vault-story-deck">{exploration.deck}</p>
    <p class="vault-story-subject"><span class="vault-category-label">{categoryName(exploration.entry.data.category)}</span><strong>{exploration.entry.data.title}</strong><span>{exploration.entry.data.subtitle}</span></p>
  </article>
  <div class="vault-connections">
    <h3>Follow the connections.</h3>
    <ul>
      {exploration.connections.map(connection => (
        <li data-vault-colour={connection.colour}>
          <p class="vault-relationship"><a href={`/vault/${connection.from.id}`}>{connection.from.data.title}</a><span>{connection.label}<ArrowRight size={14} aria-hidden="true" /></span></p>
          <a class="vault-connection-title" href={`/vault/${connection.to.id}`}>{connection.to.data.title}</a>
          <p class="vault-connection-explanation">{connection.explanation}</p>
          <span class="vault-category-label">{categoryName(connection.to.data.category)}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
