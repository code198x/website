---
import PageLayout from './PageLayout.astro';
import type { BreadcrumbItem } from './Breadcrumb.astro';

export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  showHero?: boolean;
  heroVariant?: string;
  badge?: any;
  className?: string;
}

const {
  title,
  subtitle,
  description,
  breadcrumbs,
  showHero = true,
  heroVariant = 'gradient',
  badge,
  className = ''
} = Astro.props;

const hero = showHero ? {
  title,
  subtitle,
  description,
  badge,
  variant: heroVariant
} : undefined;
---

<PageLayout
  variant={showHero ? 'hero' : 'default'}
  hero={hero}
  breadcrumbs={breadcrumbs}
  className={className}
>
  <slot />
</PageLayout>