---
/**
 * VideoPlayer - Renders a video with controls
 *
 * Usage:
 *   import VideoPlayer from '@components/VideoPlayer.astro';
 *   <VideoPlayer src="/videos/commodore-amiga/game-01-signal/unit-16/gameplay.mp4" />
 *   <VideoPlayer src="/videos/..." caption="Frog hopping demonstration" />
 */

interface Props {
  src: string;        // Path to video (relative to public/)
  caption?: string;   // Optional caption below video
  autoplay?: boolean; // Auto-play (muted, default: false)
  loop?: boolean;     // Loop video (default: true)
  width?: number;     // Width in pixels (default: 640)
}

const {
  src,
  caption,
  autoplay = false,
  loop = true,
  width = 640
} = Astro.props;

// Determine video type from extension
const extension = src.split('.').pop()?.toLowerCase();
const mimeType = extension === 'webm' ? 'video/webm' :
                 extension === 'mp4' ? 'video/mp4' :
                 'video/mp4';
---

<figure class="video-container">
  <video
    width={width}
    controls
    loop={loop}
    muted={autoplay}
    autoplay={autoplay}
    playsinline
    preload="metadata"
  >
    <source src={src} type={mimeType} />
    Your browser does not support the video tag.
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-container {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  video {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    background: var(--color-code-bg, #000);
    display: block;
  }

  figcaption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-muted, #888);
    text-align: center;
    font-style: italic;
  }
</style>
