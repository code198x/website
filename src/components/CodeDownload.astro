---
export interface Props {
  system: string;
  phase: number;
  tier: number;
  lesson: number;
  title?: string;
  showScreenshot?: boolean;
}

const { system, phase, tier, lesson, title = "Download Code", showScreenshot = false } = Astro.props;

// GitHub repository configuration
const GITHUB_ORG = 'code198x';
const REPO_NAME = 'code-samples';

// Calculate global lesson number
const globalLesson = (tier - 1) * 32 + lesson;

// Generate URLs
const githubUrl = `https://github.com/${GITHUB_ORG}/${REPO_NAME}/tree/main/${system}/phase-${phase}/tier-${tier}/lesson-${lesson}`;
const downloadUrl = `https://github.com/${GITHUB_ORG}/${REPO_NAME}/archive/refs/heads/main.zip#${system}/phase-${phase}/tier-${tier}/lesson-${lesson}`;
const rawUrl = `https://raw.githubusercontent.com/${GITHUB_ORG}/${REPO_NAME}/main/${system}/phase-${phase}/tier-${tier}/lesson-${lesson}/main.asm`;

// System-specific emulator commands
const emulatorCommands = {
  'commodore-64': 'x64sc program.prg',
  'sinclair-zx-spectrum': 'fuse program.tap',
  'nintendo-entertainment-system': 'fceux program.nes',
  'commodore-amiga': 'fs-uae program.adf'
};

const assemblerCommands = {
  'commodore-64': 'acme -o program.prg main.asm',
  'sinclair-zx-spectrum': 'sjasmplus main.asm --tap=program.tap',
  'nintendo-entertainment-system': 'ca65 main.asm -o main.o && ld65 main.o -C nes.cfg -o program.nes',
  'commodore-amiga': 'vasmm68k_mot -Fhunkexe -o program main.asm'
};

const emulatorCommand = emulatorCommands[system] || 'emulator program';
const assemblerCommand = assemblerCommands[system] || 'assembler main.asm';
---

<div class="code-download-box">
  <div class="download-header">
    <h3 class="download-title">
      <span class="download-icon">💾</span>
      {title}
    </h3>
    <div class="download-meta">
      Lesson {globalLesson} • {system.replace(/-/g, ' ')}
    </div>
  </div>

  {showScreenshot && (
    <div class="screenshot-preview">
      <img
        src={`/screenshots/${system}/lesson-${globalLesson}.png`}
        alt={`Screenshot of Lesson ${globalLesson}`}
        loading="lazy"
      />
    </div>
  )}

  <div class="download-actions">
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-github"
      title="View on GitHub"
    >
      <svg class="btn-icon" viewBox="0 0 16 16" width="16" height="16">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      View on GitHub
    </a>

    <a
      href={rawUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-raw"
      title="View raw assembly"
    >
      <span class="btn-icon">📄</span>
      View Raw
    </a>

    <button
      class="btn btn-copy"
      data-raw-url={rawUrl}
      title="Copy code to clipboard"
    >
      <span class="btn-icon">📋</span>
      Copy Code
    </button>
  </div>

  <details class="quick-start">
    <summary>Quick Start Instructions</summary>
    <div class="quick-start-content">
      <div class="instruction-step">
        <div class="step-number">1</div>
        <div class="step-content">
          <strong>Clone or Download</strong>
          <pre><code>git clone {`https://github.com/${GITHUB_ORG}/${REPO_NAME}.git`}
cd {`${REPO_NAME}/${system}/phase-${phase}/tier-${tier}/lesson-${lesson}`}</code></pre>
        </div>
      </div>

      <div class="instruction-step">
        <div class="step-number">2</div>
        <div class="step-content">
          <strong>Assemble</strong>
          <pre><code>{assemblerCommand}</code></pre>
        </div>
      </div>

      <div class="instruction-step">
        <div class="step-number">3</div>
        <div class="step-content">
          <strong>Run</strong>
          <pre><code>{emulatorCommand}</code></pre>
        </div>
      </div>
    </div>
  </details>
</div>

<style>
  .code-download-box {
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
    font-family: var(--font-family-base);
  }

  .download-header {
    margin-bottom: var(--space-md);
  }

  .download-title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-xs);
    color: var(--color-primary);
    font-size: var(--font-size-lg);
  }

  .download-icon {
    font-size: 1.5em;
  }

  .download-meta {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    text-transform: capitalize;
  }

  .screenshot-preview {
    margin: var(--space-md) 0;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
  }

  .screenshot-preview img {
    width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }

  .download-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  .btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
  }

  .btn-github {
    background: #24292e;
    color: white;
  }

  .btn-github:hover {
    background: #1a1f24;
  }

  .btn-raw {
    background: var(--color-success);
    color: white;
  }

  .btn-raw:hover {
    background: var(--color-success-dark);
  }

  .btn-copy {
    background: var(--color-primary);
    color: white;
  }

  .btn-copy:hover {
    background: var(--color-primary-dark);
  }

  .btn-copy.copied {
    background: var(--color-success);
  }

  .btn-copy.copied::after {
    content: ' ✓';
  }

  .quick-start {
    margin-top: var(--space-md);
  }

  .quick-start summary {
    cursor: pointer;
    padding: var(--space-sm);
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
    user-select: none;
  }

  .quick-start summary:hover {
    background: var(--color-bg-quaternary);
  }

  .quick-start[open] summary {
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    margin-bottom: 0;
  }

  .quick-start-content {
    background: var(--color-bg-tertiary);
    padding: var(--space-md);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }

  .instruction-step {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .instruction-step:last-child {
    margin-bottom: 0;
  }

  .step-number {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
  }

  .step-content {
    flex: 1;
  }

  .step-content strong {
    display: block;
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }

  .step-content pre {
    background: var(--color-bg-primary);
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin: 0;
  }

  .step-content code {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .download-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Copy to clipboard functionality
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.btn-copy').forEach(button => {
      button.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const rawUrl = btn.dataset.rawUrl;

        try {
          const response = await fetch(rawUrl);
          const code = await response.text();

          await navigator.clipboard.writeText(code);

          btn.classList.add('copied');
          btn.querySelector('.btn-icon').textContent = '✓';

          setTimeout(() => {
            btn.classList.remove('copied');
            btn.querySelector('.btn-icon').textContent = '📋';
          }, 2000);
        } catch (error) {
          console.error('Failed to copy code:', error);
          btn.querySelector('.btn-icon').textContent = '❌';

          setTimeout(() => {
            btn.querySelector('.btn-icon').textContent = '📋';
          }, 2000);
        }
      });
    });
  });
</script>