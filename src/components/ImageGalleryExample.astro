---
import ResponsiveImage from './ResponsiveImage.astro';

// Example images - in real usage, these would be imports or dynamic paths
const exampleImages = [
  {
    src: '/logo-horizontal.svg',
    alt: 'Code198x Logo',
    variant: 'hero' as const
  },
  {
    src: '/favicon.svg',
    alt: 'Avatar Example',
    variant: 'avatar' as const
  },
  {
    src: '/logo-stacked.svg',
    alt: 'Card Image Example',
    variant: 'card' as const
  },
  {
    src: '/logo-198x.svg',
    alt: 'Thumbnail Example',
    variant: 'thumbnail' as const
  }
];
---

<div class="image-gallery-example p-xl">
  <h2 class="text-2xl font-bold mb-lg">Responsive Image Component Examples</h2>

  <div class="space-y-xl">
    <!-- Hero Image -->
    <section>
      <h3 class="text-xl font-semibold mb-md">Hero Image (16:9, full width)</h3>
      <ResponsiveImage
        src="/logo-horizontal.svg"
        alt="Hero image example"
        variant="hero"
        priority={true}
      />
      <p class="text-sm text-muted mt-sm">
        Optimized for above-the-fold hero sections with priority loading
      </p>
    </section>

    <!-- Avatar Grid -->
    <section>
      <h3 class="text-xl font-semibold mb-md">Avatar Images (1:1, rounded)</h3>
      <div class="flex gap-md">
        {[1, 2, 3, 4].map(i => (
          <ResponsiveImage
            src="/favicon.svg"
            alt={`Avatar ${i}`}
            variant="avatar"
          />
        ))}
      </div>
      <p class="text-sm text-muted mt-sm">
        Small, circular images optimized for user avatars
      </p>
    </section>

    <!-- Card Grid -->
    <section>
      <h3 class="text-xl font-semibold mb-md">Card Images (4:3, responsive grid)</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
        {[1, 2, 3].map(i => (
          <div class="border rounded-lg overflow-hidden">
            <ResponsiveImage
              src="/logo-stacked.svg"
              alt={`Card image ${i}`}
              variant="card"
            />
            <div class="p-md">
              <h4 class="font-semibold">Card Title {i}</h4>
              <p class="text-sm text-muted">Card description text</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-muted mt-sm">
        Responsive grid of cards with optimized aspect ratios
      </p>
    </section>

    <!-- Thumbnail List -->
    <section>
      <h3 class="text-xl font-semibold mb-md">Thumbnail Images (80x80, fixed size)</h3>
      <div class="space-y-md">
        {[1, 2, 3].map(i => (
          <div class="flex items-center gap-md">
            <ResponsiveImage
              src="/logo-198x.svg"
              alt={`Thumbnail ${i}`}
              variant="thumbnail"
            />
            <div>
              <h4 class="font-medium">Item {i}</h4>
              <p class="text-sm text-muted">Description text</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-muted mt-sm">
        Small, fixed-size thumbnails for lists and compact layouts
      </p>
    </section>

    <!-- Error Handling Demo -->
    <section>
      <h3 class="text-xl font-semibold mb-md">Error Handling (broken image)</h3>
      <div class="flex gap-md">
        <ResponsiveImage
          src="/non-existent-image.jpg"
          alt="This image will show fallback"
          variant="thumbnail"
          fallback="❌"
        />
        <ResponsiveImage
          src="/another-broken.png"
          alt="Custom fallback icon"
          variant="thumbnail"
          fallback="🚫"
        />
      </div>
      <p class="text-sm text-muted mt-sm">
        Graceful fallback when images fail to load
      </p>
    </section>
  </div>

  <div class="mt-xl p-lg bg-secondary rounded-lg">
    <h3 class="text-lg font-semibold mb-sm">Usage Example</h3>
    <pre class="text-sm overflow-x-auto"><code>{`import ResponsiveImage from '@components/ResponsiveImage.astro';

<!-- Basic usage -->
<ResponsiveImage
  src="/path/to/image.jpg"
  alt="Description"
/>

<!-- Hero image with priority loading -->
<ResponsiveImage
  src={heroImage}
  alt="Hero banner"
  variant="hero"
  priority={true}
/>

<!-- Avatar image -->
<ResponsiveImage
  src={userAvatar}
  alt="User name"
  variant="avatar"
/>

<!-- Card image -->
<ResponsiveImage
  src={cardImage}
  alt="Card title"
  variant="card"
/>

<!-- With custom classes -->
<ResponsiveImage
  src={image}
  alt="Custom styled"
  class="custom-class"
/>`}</code></pre>
  </div>
</div>

<style>
  .space-y-xl > * + * {
    margin-top: var(--space-xl);
  }

  .space-y-md > * + * {
    margin-top: var(--space-md);
  }

  .grid {
    display: grid;
  }

  .grid-cols-1 {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media (min-width: 768px) {
    .md\:grid-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .lg\:grid-cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .bg-secondary {
    background: var(--color-bg-secondary);
  }

  .text-muted {
    color: var(--color-text-secondary);
  }

  pre {
    background: var(--color-bg-tertiary, #1e293b);
    color: var(--color-text-inverse, #f1f5f9);
    padding: var(--space-md);
    border-radius: var(--radius-base);
  }
</style>