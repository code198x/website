---
// AlphabeticalList.astro
interface Props {
  title: string;
  groupedItems: Record<string, any[]>;
  baseUrl: string;
}

const { title, groupedItems, baseUrl } = Astro.props;

// Generate the alphabet with '#' for numeric entries
const alphabet = ['#', ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))];
---

<section>
  <nav class="alphabet-nav">
    {alphabet.map(letter => (
      <a 
        href={`#${title.toLowerCase()}-${letter}`} 
        class={`alphabet-link ${
          groupedItems[letter] 
            ? 'active' 
            : 'disabled'
        }`}
      >
        {letter}
      </a>
    ))}
  </nav>
  
  <div>
    {Object.entries(groupedItems).sort().map(([letter, items]) => (
      <div class="alphabetical-group" id={`${title.toLowerCase()}-${letter}`}>
        <h2>{letter}</h2>
        <div class="alphabetical-grid">
          {items.map(item => (
            <div class="alphabetical-item">
              <a 
                href={`${baseUrl}/${item.slug}`}
                class="alphabetical-item-title"
              >
                {item.data.name}
              </a>
              {item.data.nationality && (
                <p class="alphabetical-item-meta">{item.data.nationality}</p>
              )}
              {item.data.country && (
                <p class="alphabetical-item-meta">{item.data.country}</p>
              )}
              {item.data.occupation && (
                <p class="alphabetical-item-detail">{item.data.occupation[0]}</p>
              )}
              {item.data.business_focus && (
                <p class="alphabetical-item-detail">{item.data.business_focus[0]}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>