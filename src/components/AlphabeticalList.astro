---
// AlphabeticalList.astro
interface Props {
  title: string;
  groupedItems: Record<string, any[]>;
  baseUrl: string;
}

const { title, groupedItems, baseUrl } = Astro.props;

// Generate the alphabet with '#' for numeric entries
const alphabet = ['#', ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))];
---

<section>
  <nav class="mb-8 flex flex-wrap gap-2">
    {alphabet.map(letter => (
      <a 
        href={`#${title.toLowerCase()}-${letter}`} 
        class={`px-3 py-1 rounded text-sm font-medium ${
          groupedItems[letter] 
            ? 'bg-blue-600 text-white hover:bg-blue-700' 
            : 'bg-gray-200 text-gray-400 cursor-not-allowed'
        }`}
      >
        {letter}
      </a>
    ))}
  </nav>
  
  <div class="space-y-8">
    {Object.entries(groupedItems).sort().map(([letter, items]) => (
      <div class="alphabetical-group" id={`${title.toLowerCase()}-${letter}`}>
        <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b-2 border-gray-300 pb-2">
          {letter}
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {items.map(item => (
            <div class="bg-white rounded-lg shadow-md p-4 hover:shadow-lg transition-shadow">
              <a 
                href={`${baseUrl}/${item.slug}`}
                class="text-blue-600 hover:text-blue-800 font-medium text-lg"
              >
                {item.data.name}
              </a>
              {item.data.nationality && (
                <p class="text-sm text-gray-600 mt-1">{item.data.nationality}</p>
              )}
              {item.data.country && (
                <p class="text-sm text-gray-600 mt-1">{item.data.country}</p>
              )}
              {item.data.occupation && (
                <p class="text-xs text-gray-500 mt-2">{item.data.occupation[0]}</p>
              )}
              {item.data.business_focus && (
                <p class="text-xs text-gray-500 mt-2">{item.data.business_focus[0]}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>