---
import PageFrame from '../PageFrame.astro';
import '../../styles/feature-article.css';
export interface Props { class?: string; }
const { class: className } = Astro.props;
---
<!-- The opening sits outside the article frame so illustrated openings can span the page. -->
<slot name="opening" />
<PageFrame as="article" class:list={['feature-article', className]} inset="standard" opening="none" ending="large" data-feature-article>
  <div class="feature-prose"><slot /></div>
  <div class="feature-ending"><slot name="ending" /></div>
</PageFrame>
