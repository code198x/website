---
export type Props = {
  text: string;
  kind?: 'emphasis';
  duplicate?: boolean;
  attribution?: never;
  source?: never;
} | {
  text: string;
  kind: 'quotation';
  attribution: string;
  source?: string;
  duplicate?: boolean;
};
const {text, kind = 'emphasis', duplicate = false} = Astro.props;
const attribution = Astro.props.kind === 'quotation' ? Astro.props.attribution : undefined;
const source = Astro.props.kind === 'quotation' ? Astro.props.source : undefined;
---
{kind === 'quotation' ? <figure class="article-pullquote" aria-hidden={duplicate || undefined}><blockquote><p>{text}</p></blockquote><figcaption>{source ? <a href={source}>{attribution}</a> : attribution}</figcaption></figure> : <aside class="article-pullquote" aria-hidden={duplicate || undefined}><p>{text}</p><span>From this study</span></aside>}
