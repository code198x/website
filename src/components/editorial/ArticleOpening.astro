---
export interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image?: string;
  imageSet?: string;
  imageCredit?: string;
  metadata?: string;
  tone?: 'ink' | 'paper';
  class?: string;
}
const {title, subtitle, description, image, imageSet, imageCredit, metadata, tone = 'ink', class: className} = Astro.props;
---
<header class:list={['article-opening', {'masthead-frame': image}, className]} data-tone={tone} data-article-opening data-art={image ? '' : undefined}>
  {image && <img class="article-opening-art" src={image} srcset={imageSet} sizes="100vw" alt="" width="2172" height="724" fetchpriority="high" decoding="async" />}
  <div class="article-opening-copy">
    <h1>{title}{subtitle && <span>{subtitle}</span>}</h1>
    <p class="article-opening-description">{description}</p>
    {metadata && <p class="article-opening-metadata">{metadata}</p>}
  </div>
  {imageCredit && <p class="article-opening-credit">{imageCredit}</p>}
</header>
