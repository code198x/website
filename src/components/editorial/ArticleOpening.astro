---
export interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image?: string;
  imageSet?: string;
  imageCredit?: string;
  metadata?: string;
  tone?: 'ink' | 'paper';
}
const {title, subtitle, description, image, imageSet, imageCredit, metadata, tone = 'ink'} = Astro.props;
---
<header class="article-opening" data-tone={tone} data-article-opening>
  {image && <img class="article-opening-art" src={image} srcset={imageSet} sizes="(max-width: 1264px) 100vw, 1264px" alt="" width="2172" height="724" fetchpriority="high" decoding="async" />}
  <div class="article-opening-copy">
    <h1>{title}{subtitle && <span>{subtitle}</span>}</h1>
    <p class="article-opening-description">{description}</p>
    {metadata && <p class="article-opening-metadata">{metadata}</p>}
  </div>
  {imageCredit && <p class="article-opening-credit">{imageCredit}</p>}
</header>
