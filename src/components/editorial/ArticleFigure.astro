---
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  phoneSrc?: string;
  phoneWidth?: number;
  phoneHeight?: number;
  caption: string;
  title?: string;
  credit?: string;
  size?: 'reading' | 'wide' | 'aside' | 'bleed';
  pixels?: boolean;
  nativeSize?: boolean;
}
const {src, alt, width, height, phoneSrc, phoneWidth, phoneHeight, caption, title, credit, size = 'wide', pixels = false, nativeSize = false} = Astro.props;
---
<figure class="article-figure" data-size={size} data-pixels={pixels || undefined} data-native-size={nativeSize || undefined} style={nativeSize ? `--article-image-width:${width}px` : undefined} data-responsive-diagram={phoneSrc ? true : undefined}>
  <div class="article-figure-media">
    {phoneSrc ? <picture>
      <source media="(max-width: 760px)" srcset={phoneSrc} width={phoneWidth} height={phoneHeight} />
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </picture> : <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />}
  </div>
  <figcaption>
    {title && <p class="article-figure-title">{title}</p>}
    <p>{caption}</p>
    {credit && <p class="article-figure-credit">{credit}</p>}
  </figcaption>
</figure>
