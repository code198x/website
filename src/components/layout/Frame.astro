---
/**
 * An illustration or photograph cropped to an aspect ratio.
 *
 * Never a capture: the build fails if the content holds one (see frame.ts).
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { primitiveStyle } from './space';
import { refuseCaptures } from './frame';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Width over height. Default 16 / 9. */
  ratio?: `${number} / ${number}`;
};

const { as: Tag = 'div', ratio, class: className, style, ...attributes } = Astro.props;
const content = await Astro.slots.render('default');
refuseCaptures(content);
---
<Tag {...attributes} class:list={['l-frame', className]} style={primitiveStyle({ '--frame-ratio': ratio }, style)}><Fragment set:html={content} /></Tag>
