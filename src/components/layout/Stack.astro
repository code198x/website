---
/** Vertical rhythm: children in a column with one gap between each. */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Gap between children. Default 4. */
  space?: Space;
};

const { as: Tag = 'div', space: gap, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-stack', className]} style={primitiveStyle({ '--stack-space': gap === undefined ? undefined : space(gap) }, style)}><slot /></Tag>
