---
/**
 * A row that scrolls sideways instead of wrapping. Its settings reach the
 * children by inheritance, so don't make another Reel a direct child.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Each child's width. Default its content's width. */
  itemWidth?: Length;
  /** Gap between children. Default 4. */
  space?: Space;
};

const { as: Tag = 'div', itemWidth, space: gap, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-reel', className]} style={primitiveStyle({
  '--reel-item-width': itemWidth ?? 'auto',
  '--reel-space': gap === undefined ? undefined : space(gap),
}, style)}><slot /></Tag>
