---
/** As many equal columns of at least `min` as fit, with no breakpoints. */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** The narrowest a column may get. Default 16rem. */
  min?: Length;
  /** Gap between cells. Default 4. */
  space?: Space;
};

const { as: Tag = 'div', min, space: gap, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-grid', className]} style={primitiveStyle({
  '--grid-min': min,
  '--grid-space': gap === undefined ? undefined : space(gap),
}, style)}><slot /></Tag>
