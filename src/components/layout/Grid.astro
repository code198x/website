---
/**
 * As many equal columns of at least `min` as fit, with no breakpoints, and
 * never more than `maxColumns`.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** The narrowest a column may get. Default 16rem. */
  min?: Length;
  /** Gap between cells. Default 4. */
  space?: Space;
  /** The most columns there may be, however wide the grid. */
  maxColumns?: 2 | 3 | 4 | 5 | 6;
};

const { as: Tag = 'div', min, space: gap, maxColumns, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-grid', className]} data-max-columns={maxColumns} style={primitiveStyle({
  '--grid-min': min,
  '--grid-space': gap === undefined ? undefined : space(gap),
  '--grid-max-columns': maxColumns,
}, style)}><slot /></Tag>
