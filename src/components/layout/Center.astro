---
/**
 * A capped, centred measure. The cap includes the gutters, so `max="frame"`
 * with `gutters="page"` is the site's page frame.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** The cap: the kit's reading measure (default), the site frame, or a length. */
  max?: 'measure' | 'frame' | Length;
  /** Inline padding: a step of the spacing scale, or the page gutter. Default none. */
  gutters?: Space | 'page';
  /** Centre the children themselves at their own width, too. */
  intrinsic?: boolean;
};

const { as: Tag = 'div', max, gutters, intrinsic = false, class: className, style, ...attributes } = Astro.props;
const cap = max === undefined || max === 'measure' ? undefined : max === 'frame' ? 'var(--site-frame-width)' : max;
const inline = gutters === undefined ? undefined : gutters === 'page' ? 'var(--page-gutter)' : space(gutters);
---
<Tag {...attributes} class:list={['l-center', className]} data-intrinsic={intrinsic || undefined} style={primitiveStyle({ '--center-max': cap, '--center-gutters': inline }, style)}><slot /></Tag>
