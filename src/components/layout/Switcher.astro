---
/**
 * Equal children in a row that become a column, all at once, when the
 * container is narrower than `threshold`. Its settings reach the children by
 * inheritance, so another Switcher as a direct child fails the build
 * (nesting.ts); wrap it first.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';
import { refuseSameKindChild } from './nesting';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** The container width below which the children stack. Default 30rem. */
  threshold?: Length;
  /** Gap between children. Default 4. */
  space?: Space;
  /** With more children than this, they always stack. */
  limit?: 2 | 3 | 4;
};

const { as: Tag = 'div', threshold = '30rem', space: gap, limit, class: className, style, ...attributes } = Astro.props;
const content = await Astro.slots.render('default');
refuseSameKindChild(content, 'l-switcher', 'Switcher');
---
<Tag {...attributes} class:list={['l-switcher', className]} data-limit={limit} style={primitiveStyle({
  '--switcher-threshold': threshold,
  '--switcher-space': gap === undefined ? undefined : space(gap),
}, style)}><Fragment set:html={content} /></Tag>
