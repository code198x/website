---
/** Padding, and optionally a hairline rule, around content. */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Padding on every side. Default 4. */
  padding?: Space;
  /** Draw the kit's hairline round the box. */
  border?: boolean;
};

const { as: Tag = 'div', padding, border = false, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-box', className]} style={primitiveStyle({
  '--box-padding': padding === undefined ? undefined : space(padding),
  '--box-border': border ? '1px solid var(--h-line)' : undefined,
}, style)}><slot /></Tag>
