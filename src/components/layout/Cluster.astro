---
/** Items in rows that wrap: tags, buttons, links. */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Gap between items and rows. Default 4. */
  space?: Space;
  /** Default start. */
  justify?: 'start' | 'center' | 'end' | 'space-between';
  /** Default center. */
  align?: 'start' | 'center' | 'end' | 'baseline' | 'stretch';
};

const { as: Tag = 'div', space: gap, justify, align, class: className, style, ...attributes } = Astro.props;
const flex = (value?: string) => (value === 'start' || value === 'end' ? `flex-${value}` : value);
---
<Tag {...attributes} class:list={['l-cluster', className]} style={primitiveStyle({
  '--cluster-space': gap === undefined ? undefined : space(gap),
  '--cluster-justify': flex(justify),
  '--cluster-align': flex(align),
}, style)}><slot /></Tag>
