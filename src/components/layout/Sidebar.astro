---
/**
 * Two children side by side: a sidebar and the main pane. When the main pane
 * would be narrower than `contentMin`, the two stack, with no breakpoint.
 * Its settings reach the children by inheritance, so don't make another
 * Sidebar a direct child of this one; wrap it first.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Which child is the sidebar. Default left (the first). */
  side?: 'left' | 'right';
  /** The sidebar's width while side by side. Default its content's width. */
  sideWidth?: Length;
  /** The narrowest the main pane may get before they stack. Default 50%. */
  contentMin?: `${number}%`;
  /** Gap between the panes. Default 4. */
  space?: Space;
  /** Let each pane keep its own height instead of matching the taller. */
  noStretch?: boolean;
};

const { as: Tag = 'div', side = 'left', sideWidth, contentMin = '50%', space: gap, noStretch = false, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-with-sidebar', className]} data-side={side} data-no-stretch={noStretch || undefined} style={primitiveStyle({
  '--sidebar-width': sideWidth ?? 'auto',
  '--sidebar-content-min': contentMin,
  '--sidebar-space': gap === undefined ? undefined : space(gap),
}, style)}><slot /></Tag>
