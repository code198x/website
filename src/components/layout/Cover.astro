---
/**
 * A minimum height with one child centred in it. Mark that child with
 * `data-cover-centre`; children before and after it keep to the edges.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { type Length, type Space, space, primitiveStyle } from './space';

type Props<Tag extends HTMLTag = 'div'> = HTMLAttributes<Tag> & {
  as?: Tag;
  /** Default 100vh. */
  min?: Length;
  /** Padding on every side. Default 4. */
  padding?: Space;
  /** Least gap between children. Default 4. */
  space?: Space;
};

const { as: Tag = 'div', min, padding, space: gap, class: className, style, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['l-cover', className]} style={primitiveStyle({
  '--cover-min': min,
  '--cover-padding': padding === undefined ? undefined : space(padding),
  '--cover-space': gap === undefined ? undefined : space(gap),
}, style)}><slot /></Tag>
