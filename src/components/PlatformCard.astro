---
import MedalBadge from "./MedalBadge.astro";

export interface Props {
  platform: {
    name: string;
    slug: string;
    manufacturer: string;
    medal_tier?: "platinum" | "gold" | "silver" | "bronze";
    total_lessons?: number;
    total_games?: number;
    estimated_duration?: string;
    cpu_architecture?: string;
    image?: string;
    description?: string;
    release_date?: {
      global: Date;
    };
    status?: "active" | "vault";
  };
  showDetails?: boolean;
  isVault?: boolean;
}

const { platform, showDetails = false, isVault = false } = Astro.props;

// Default values if not specified
const medalTier = platform.medal_tier || "bronze";
const totalLessons = platform.total_lessons || 512;
const totalGames = platform.total_games || 8;
const duration = platform.estimated_duration || "2-4 weeks";
---

<article class="platform-card group">
  <a href={`/systems/${platform.slug}/`} class="block h-full">
    <div
      class="relative h-full
      bg-white dark:bg-gray-800
      border-2 border-gray-200 dark:border-gray-700
      rounded-lg overflow-hidden
      hover:shadow-xl transition-all duration-300
      hover:-translate-y-1"
    >
      {/* Medal Badge or Vault Badge - positioned absolutely */}
      <div class="absolute top-2 right-2 z-10">
        {
          isVault ? (
            <div
              class="
            inline-flex items-center gap-1 
            bg-purple-100 dark:bg-purple-900 
            text-purple-800 dark:text-purple-200
            px-2 py-1 rounded-full text-xs font-medium
          "
            >
              🗄️ Vault
            </div>
          ) : (
            <MedalBadge tier={medalTier} size="small" showLabel={false} />
          )
        }
      </div>

      {/* Platform Image */}
      {
        platform.image && (
          <div class="aspect-video bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800">
            <img src={platform.image} alt={platform.name} class="w-full h-full object-cover" />
          </div>
        )
      }

      {/* Content */}
      <div class="p-4">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">
          {platform.name}
        </h3>

        <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
          {platform.manufacturer}
        </p>

        {/* Quick Stats */}
        {
          isVault ? (
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">
                Historical Reference
              </span>
              {platform.cpu_architecture && (
                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
                  {platform.cpu_architecture}
                </span>
              )}
            </div>
          ) : (
            <>
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                  {totalLessons.toLocaleString()} lessons
                </span>
                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                  {totalGames} games
                </span>
                {platform.cpu_architecture && (
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">
                    {platform.cpu_architecture}
                  </span>
                )}
              </div>

              {/* Duration */}
              <div class="text-sm font-medium text-gray-700 dark:text-gray-300">⏱️ {duration}</div>
            </>
          )
        }

        {/* Description (if showing details) */}
        {
          showDetails && platform.description && (
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
              {platform.description}
            </p>
          )
        }

        {/* Release Year */}
        {
          platform.release_date?.global && (
            <div class="mt-3 text-xs text-gray-500 dark:text-gray-500">
              Released {new Date(platform.release_date.global).getFullYear()}
            </div>
          )
        }
      </div>

      {/* Hover Overlay */}
      <div
        class="absolute inset-0
        bg-gradient-to-t from-black/50 to-transparent
        opacity-0 group-hover:opacity-100
        transition-opacity duration-300
        pointer-events-none
        flex items-end"
      >
        <div class="p-4 text-white font-medium">Start Learning →</div>
      </div>
    </div>
  </a>
</article>

<style>
  .platform-card {
    height: 100%;
  }

  /* Tailwind line-clamp polyfill if needed */
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* Medal tier border colors on hover */
  .platform-card:has(.medal-platinum) > a > div:hover {
    border-color: #9ca3af;
  }

  .platform-card:has(.medal-gold) > a > div:hover {
    border-color: #fbbf24;
  }

  .platform-card:has(.medal-silver) > a > div:hover {
    border-color: #6b7280;
  }

  .platform-card:has(.medal-bronze) > a > div:hover {
    border-color: #fb923c;
  }
</style>
