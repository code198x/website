---
/**
 * UnitHeader — the block above a unit's content: what this unit is, how long
 * it takes, where it sits in the module, and the control that marks it done.
 *
 * Deliberately thin. Where you are in the module, how far through it you are,
 * and the control that marks it done all live in the breadcrumb bar, which is
 * sticky and therefore keeps them reachable; repeating them here would say the
 * same thing twice, once scrollable and once not. What is left is what the
 * unit is: which game it belongs to, how long it takes, its title and its
 * premise.
 */

import ReadingTime from './ReadingTime.astro';

interface Props {
  title: string;
  description?: string;
  unit: number;
  totalUnits: number;
  game: number;
  isSection: boolean;
  learningTime: number;
  systemColor: string;
  currentPath: string;
  moduleName: string;
}

const {
  title,
  description,
  unit,
  totalUnits,
  game,
  isSection,
  learningTime,
  systemColor,
  currentPath,
  moduleName,
} = Astro.props;
---

<header class="unit-header">
  <div class="unit-badge">
    {!isSection && game > 0 && <span class="game-label">Game {game}</span>}
    <ReadingTime minutes={learningTime} platformColor={systemColor} />
  </div>

  <h1 class="unit-title">{title}</h1>
  {description && <p class="unit-description">{description}</p>}
</header>

<style>
  .unit-header {
    margin-bottom: var(--space-10);
  }

  .unit-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .game-label {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-1) var(--space-2);
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .game-label {
    background: var(--systemFill);
    color: white;
  }

  .unit-title {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--color-text);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .unit-description {
    font-family: var(--font-family-read);
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 52ch;
  }

  @media (max-width: 768px) {
    .unit-badge {
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }
</style>
