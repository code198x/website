---
/**
 * UnitHeader — the block above a unit's content: what this unit is, how long
 * it takes, where it sits in the module, and the control that marks it done.
 *
 * Composed of the pieces that already existed separately (ReadingTime,
 * UnitSteps, ProgressTracker) rather than re-implementing them. Everything
 * that is not the title, the description, or one of those three has been
 * taken out: the full-width bar and the "9% of <module>" line are gone, and
 * what they were for now sits on the top row beside the labels.
 */

import ReadingTime from './ReadingTime.astro';
import ProgressTracker from './ProgressTracker.astro';
import UnitSteps from './UnitSteps.astro';

interface Props {
  title: string;
  description?: string;
  unit: number;
  totalUnits: number;
  game: number;
  isSection: boolean;
  learningTime: number;
  systemColor: string;
  currentPath: string;
  moduleName: string;
}

const {
  title,
  description,
  unit,
  totalUnits,
  game,
  isSection,
  learningTime,
  systemColor,
  currentPath,
  moduleName,
} = Astro.props;
---

<header class="unit-header">
  <div class="unit-badge">
    {!isSection && game > 0 && <span class="game-label">Game {game}</span>}
    <span class="unit-label">Unit {unit} of {totalUnits}</span>
    <ReadingTime minutes={learningTime} platformColor={systemColor} />

    <div class="unit-badge-end">
      <UnitSteps
        unit={unit}
        totalUnits={totalUnits}
        label={`Unit ${unit} of ${totalUnits} in ${moduleName}`}
      />
      <ProgressTracker unitPath={currentPath} platformColor={systemColor} />
    </div>
  </div>

  <h1 class="unit-title">{title}</h1>
  {description && <p class="unit-description">{description}</p>}
</header>

<script>
  const header = document.querySelector<HTMLElement>('.unit-header');
  const container = header?.closest<HTMLElement>('.unit-container');

  if (header && container && 'ResizeObserver' in window) {
    const publishHeight = () => {
      container.style.setProperty('--unit-bar-height', `${header.offsetHeight}px`);
    };
    new ResizeObserver(publishHeight).observe(header);
    publishHeight();
  }
</script>

<style>
  .unit-header {
    margin-bottom: var(--space-10);

    /* Rides under the site nav, so the unit you are in and what it is about
       stay on screen while you read it. Full-bleed across the container, or
       content scrolls past either side. */
    position: sticky;
    top: var(--nav-height);
    z-index: 50;
    margin-left: calc(var(--space-4) * -1);
    margin-right: calc(var(--space-4) * -1);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-translucent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .unit-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  /* The step blocks and the completion control sit together at the far end of
     the row, away from the labels that name the unit. */
  .unit-badge-end {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  .game-label,
  .unit-label {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-1) var(--space-2);
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .game-label {
    background: var(--systemFill);
    color: white;
  }

  .unit-label {
    background: var(--color-surface);
    color: var(--ink);
    border: 1px solid var(--systemColor);
  }

  .unit-title {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--color-text);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .unit-description {
    font-family: var(--font-family-read);
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 52ch;
  }

  @media (max-width: 768px) {
    /* Too tall a share of a small screen to hold on to. */
    .unit-header {
      position: static;
    }

    .unit-badge {
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    /* Below the labels rather than beside them, and using the full width, so
       the blocks stay readable instead of squeezing into a corner. */
    .unit-badge-end {
      margin-left: 0;
      width: 100%;
      justify-content: space-between;
      margin-top: var(--space-2);
    }
  }
</style>
