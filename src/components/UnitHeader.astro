---
/**
 * UnitHeader — the block above a unit's content: what this unit is, how long
 * it takes, where it sits in the module, and the control that marks it done.
 *
 * Deliberately thin. Where you are in the module, how far through it you are,
 * and the control that marks it done all live in the breadcrumb bar, which is
 * sticky and therefore keeps them reachable; repeating them here would say the
 * same thing twice, once scrollable and once not. What is left is what the
 * unit is: which game it belongs to, its title and its premise.
 */


interface Props {
  title: string;
  description?: string;
  game: number;
  isSection: boolean;
}

const {
  title,
  description,
  game,
  isSection,
} = Astro.props;
---

<header class="unit-header">
  {!isSection && game > 0 && (
    <div class="unit-badge">
      <span class="game-label">Game {game}</span>
    </div>
  )}

  <h1 class="unit-title">{title}</h1>
  {description && <p class="unit-description">{description}</p>}
</header>

<style>
  .unit-header {
    position: relative;
    margin-bottom: var(--space-8);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* Full-bleed tint: the header sits inside a centred container, so the band
     is painted by a pseudo-element escaping it to the window's edges. Behind
     the content, hence the negative z-index. */
  .unit-header::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    background: var(--color-header-band);
  }

  /* Full-bleed rule: the header sits inside a centred container, so the line
     is drawn by a pseudo-element escaping it to the window's edges rather than
     by a border, which would stop at the container. */
  .unit-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    height: 1px;
    background: var(--color-border);
  }

  .unit-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .game-label {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-1) var(--space-2);
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .game-label {
    background: var(--systemFill);
    color: white;
  }

  .unit-title {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--color-text);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .unit-description {
    /* 24px exactly. At the muted colour this lands at 4.4:1 on the header
       band, which is short of the 4.5 that normal text needs — but 24px
       regular is large text, where the bar is 3:1. The size is load-bearing:
       drop it and the colour has to come back. */
    font-size: 1.5rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 44ch;
  }

  @media (max-width: 768px) {
    .unit-badge {
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }
</style>
