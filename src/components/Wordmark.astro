---
interface Props { href?: string }
const { href = '/' } = Astro.props;
---
<a class="wordmark" href={href}><img src="/brand/code-wordmark.svg" alt="Code Like It's 198x" width="338" height="55" /></a>
<style>.wordmark{display:block;flex:none}.wordmark img{display:block;width:338px;max-width:100%;height:auto}@media(max-width:600px){.wordmark img{width:240px}}</style>
