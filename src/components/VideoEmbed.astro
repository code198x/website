---
/**
 * VideoEmbed — a film-perforation-framed video embed with caption (IA v3 media
 * primitive). For "Watch" / "See it run" sections. Accepts a YouTube id or a
 * full embed URL (archive.org etc.).
 *
 *   <VideoEmbed youtube="dQw4w9WgXcQ" title="Shadowkeep — attract loop" />
 *   <VideoEmbed src="https://archive.org/embed/…" title="Hubbard live" />
 */
interface Props { youtube?: string; src?: string; title: string; caption?: string }
const { youtube, src, title, caption } = Astro.props;
const embedSrc = youtube ? `https://www.youtube-nocookie.com/embed/${youtube}` : src;
const perfs = Array.from({ length: 14 });
import { inlineMarkdown } from '../lib/inline-markdown';
---

<figure class="video">
  <div class="perf">{perfs.map(() => <i></i>)}</div>
  <div class="screen">
    {embedSrc
      ? <iframe src={embedSrc} title={title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
      : <span class="missing">No video source</span>}
  </div>
  <div class="perf">{perfs.map(() => <i></i>)}</div>
  {caption && <figcaption set:html={inlineMarkdown(caption)} />}
</figure>

<style>
  .video { border: 3px solid var(--color-text); background: #15171c; box-shadow: var(--shadow-chunky); margin: var(--space-5) 0; }
  .perf { display: flex; justify-content: space-between; padding: 3px 5px; }
  .perf i { width: 7px; height: 8px; background: #fff; opacity: 0.85; }
  .screen { position: relative; aspect-ratio: 16 / 9; background: #1c2238; }
  .screen iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .missing { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-family-mono); font-size: 0.75rem; color: #aab; }
  figcaption { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); padding: 6px 8px; }
</style>
