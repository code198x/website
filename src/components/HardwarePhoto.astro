---
interface Props {system:string}
const {system}=Astro.props;
---
{system === 'sinclair-zx-spectrum' && <figure class="hardware-photo"><img src="/images/learning/hardware-spectrum.png" width="2168" height="1593" loading="lazy" alt="ZX Spectrum 48K with its rubber keyboard and rainbow case stripe"><figcaption>Photograph supplied by the project.</figcaption></figure>}
{system === 'commodore-64' && <figure class="hardware-photo"><img src="/images/learning/hardware-c64.jpg" width="4600" height="2600" loading="lazy" alt="Commodore 64 breadbin computer with brown keys"><figcaption>Photo: <a href="https://commons.wikimedia.org/wiki/File:Commodore-64-Computer-FR.jpg">Evan-Amos</a> · public domain.</figcaption></figure>}
{system === 'commodore-amiga' && <figure class="hardware-photo"><img src="/images/learning/hardware-amiga.jpg" width="1095" height="734" loading="lazy" alt="Commodore Amiga 500 Plus photographed on a white background"><figcaption>Amiga 500 Plus · Photo: <a href="https://commons.wikimedia.org/wiki/File:Amiga_500_Plus_(white_background).jpg">Sernot / Ubcule</a> · public domain.</figcaption></figure>}
{system === 'nintendo-entertainment-system' && <figure class="hardware-photo"><img src="/images/learning/hardware-nes.jpg" width="5560" height="3020" loading="lazy" alt="Nintendo Entertainment System console with its wired controller"><figcaption>Photo: <a href="https://commons.wikimedia.org/wiki/File:NES-Console-Set.jpg">Evan-Amos</a> · public domain.</figcaption></figure>}
<style>.hardware-photo{margin:0;width:100%;max-width:576px}.hardware-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;background:white}.hardware-photo figcaption{font:italic .875rem/1.5 var(--h-font-ui);padding-top:12px;color:var(--h-ink-muted)}</style>
