---
import photographs from '../../public/images/systems-opening/provenance.json';
import { getAllPlatforms } from '../lib/platforms';
const platforms = await getAllPlatforms();
---

<section class="systems-opening masthead-frame" aria-labelledby="systems-title">
  <div class="machine-landscape">
    {photographs.map(photo => (
      <img class:list={['machine', photo.id]} src={`/images/systems-opening/${photo.id}-960.webp`}
        srcset={`/images/systems-opening/${photo.id}-480.webp 480w, /images/systems-opening/${photo.id}-960.webp 960w`}
        sizes="(max-width: 600px) 65vw, 43vw" width={photo.files[1].width} height={photo.files[1].height}
        alt="" aria-hidden="true" />
    ))}
    <h1 id="systems-title"><span>Choose Your</span>{' '}<strong>Machine.</strong></h1>
  </div>
  <div class="opening-reading">
    <p class="pictured">In the picture: {photographs.map((photo, index) => (
      <Fragment>{index > 0 && ' · '}<a href={`/systems/${photo.system}/`}>{photo.name}</a></Fragment>
    ))}.</p>
    <div class="introduction">
      <p>Explore the machines through their games, languages and hardware. Start with a system that has lessons, or browse the wider directory for reference material and planned coverage. A listing does not mean that a course or a working toolchain is available.</p>
      <a class="catalogue-jump" href="#catalogue">Browse all {platforms.length} machines →</a>
    </div>
    <details class="photo-credits">
      <summary>Photographs and credits</summary>
      <p>Real hardware photographs, resized and arranged in layers. White backgrounds are blended into the page;
        the composition crops some edges. No hardware details have been generated or redrawn.</p>
      <ul>{photographs.map(photo => (
        <li><strong>{photo.name}</strong> — {photo.author}.{' '}
          {photo.source && <a href={photo.source}>Source photograph</a>}{' '}
          {photo.licenceUrl ? <a href={photo.licenceUrl}>{photo.licence}</a> : photo.licence}.
          {photo.id === 'atari' && ' Resized delivery copies retain CC BY-SA 3.0.'}
          {photo.id === 'msx' && ' Existing background removal and retouching by Ubcule.'}
          {photo.id === 'amiga' && ' Existing background removal and retouching by Ubcule.'}
        </li>
      ))}</ul>
      <p>The Atari 400 links to the Atari 8-bit family entry. These photographs identify machines;
        lesson availability is listed below.</p>
    </details>
  </div>
</section>

<style>
  @layer legacy {
  .machine-landscape { position: relative; isolation: isolate; overflow: hidden;
    height: clamp(480px, 48vw, 820px); background: var(--h-page); }
  .machine { position: absolute; display: block; height: auto; max-width: none;
    mix-blend-mode: multiply; pointer-events: none; }
  .nes { width: 25%; left: -5%; top: -7%; }
  .c64 { width: 39%; right: -6%; top: -12%; }
  .electron { width: 24%; left: 29%; top: -9%; transform: rotate(-7deg); }
  .atari { width: 23%; left: -6%; top: 31%; transform: rotate(8deg); }
  .msx { width: 28%; right: -9%; top: 34%; transform: rotate(-8deg); }
  .spectrum { width: 38%; left: 0; bottom: -15%; }
  .amiga { width: 39%; right: -2%; bottom: -20%; transform: rotate(-4deg); }
  h1 { position: absolute; z-index: 4; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; margin: 0; padding-bottom: 6%;
    color: var(--h-ink); font-family: var(--h-font-mag); font-style: italic;
    font-weight: 900; text-transform: uppercase; letter-spacing: -.025em; }
  h1 span { font-size: clamp(32px, 5vw, 80px); line-height: 1.1; }
  h1 strong { color: var(--h-spot-ink); font: inherit; font-size: clamp(96px, 22vw, 350px); line-height: .95; }
  .opening-reading { box-sizing: border-box; max-width: var(--site-frame-width); margin: 0 auto;
    padding: var(--h-space-4) var(--page-gutter) 0; }
  .pictured { margin: 0 0 var(--h-space-6); color: var(--h-ink-muted); font-size: .875rem; line-height: 1.8; }
  .pictured a { color: inherit; text-underline-offset: 3px; }
  .introduction { display: flex; align-items: center; gap: var(--h-space-8); }
  .introduction p { max-width: 65ch; margin: 0; font-size: 1.25rem; line-height: 1.6; }
  .catalogue-jump { display: inline-flex; align-items: center; min-height: 44px;
    flex-shrink: 0; font-weight: 700; text-underline-offset: 5px; }
  .photo-credits { margin-top: var(--h-space-4); font-size: .875rem; line-height: 1.7; }
  summary { width: fit-content; min-height: 44px; align-content: center; cursor: pointer; }
  .photo-credits p, .photo-credits ul { max-width: 80ch; }
  .photo-credits a { text-underline-offset: 3px; }
  @media (max-width: 850px) { .introduction { flex-direction: column; align-items: flex-start; gap: var(--h-space-4); } }
  @media (max-width: 600px) {
    .machine-landscape { height: 520px; }
    h1 { justify-content: flex-start; padding-top: 132px; padding-bottom: 0; }
    h1 span { font-size: 8vw; }
    h1 strong { font-size: 22vw; }
    .nes { width: 39%; left: -12%; top: -3%; }
    .c64 { width: 50%; right: -15%; top: -1%; }
    .electron { width: 34%; left: 31%; top: 8%; }
    .atari { width: 45%; left: -10%; top: 49%; }
    .msx { width: 58%; right: -12%; top: 49%; }
    .spectrum { width: 54%; left: -5%; bottom: -6%; }
    .amiga { width: 60%; right: -10%; bottom: -1%; }
  }
  }
</style>
