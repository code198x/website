---
/**
 * ProgressTracker - Track and display unit completion status
 *
 * Usage:
 *   import ProgressTracker from '@components/ProgressTracker.astro';
 *   <ProgressTracker unitPath="/systems/commodore-64/assembly/game-01-starfield/unit-01" />
 *
 * Stores completion status in localStorage. Shows a checkbox to mark units complete.
 */

interface Props {
  unitPath: string;
  platformColor?: string;
}

const { unitPath, platformColor } = Astro.props;
const accentColor = platformColor || 'var(--color-primary)';
---

<div
  class="progress-tracker"
  data-unit-path={unitPath}
  style={`--tracker-accent: ${accentColor};`}
>
  <label class="tracker-label">
    <input type="checkbox" class="tracker-checkbox" />
    <span class="tracker-checkmark">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </span>
    <span class="tracker-text">
      <span class="tracker-incomplete">Mark as complete</span>
      <span class="tracker-complete">Completed!</span>
    </span>
  </label>
</div>

<style>
  .progress-tracker {
    display: inline-flex;
  }

  .tracker-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border-radius: 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: all var(--transition-base);
    user-select: none;
  }

  .tracker-label:hover {
    border-color: var(--tracker-accent);
  }

  .tracker-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .tracker-checkmark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 2px solid var(--color-border);
    border-radius: 0.25rem;
    background: var(--color-bg);
    transition: all var(--transition-base);
  }

  .tracker-checkmark svg {
    opacity: 0;
    transform: scale(0.5);
    transition: all var(--transition-base);
    color: white;
  }

  .tracker-text {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
  }

  .tracker-complete {
    display: none;
    color: var(--tracker-accent);
  }

  /* Checked state */
  .tracker-checkbox:checked + .tracker-checkmark {
    background: var(--tracker-accent);
    border-color: var(--tracker-accent);
  }

  .tracker-checkbox:checked + .tracker-checkmark svg {
    opacity: 1;
    transform: scale(1);
  }

  .tracker-checkbox:checked ~ .tracker-text .tracker-incomplete {
    display: none;
  }

  .tracker-checkbox:checked ~ .tracker-text .tracker-complete {
    display: inline;
  }

  /* Focus state */
  .tracker-checkbox:focus-visible + .tracker-checkmark {
    outline: 2px solid var(--tracker-accent);
    outline-offset: 2px;
  }

  /* Hover when unchecked */
  .tracker-label:hover .tracker-checkmark {
    border-color: var(--tracker-accent);
  }
</style>

<script>
  const STORAGE_KEY = 'code198x-progress';

  function getProgress(): Record<string, boolean> {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : {};
    } catch {
      return {};
    }
  }

  function setProgress(unitPath: string, completed: boolean) {
    const progress = getProgress();
    if (completed) {
      progress[unitPath] = true;
    } else {
      delete progress[unitPath];
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));

    // Dispatch custom event for other components to react
    window.dispatchEvent(new CustomEvent('progress-updated', {
      detail: { unitPath, completed }
    }));
  }

  function isCompleted(unitPath: string): boolean {
    return getProgress()[unitPath] === true;
  }

  // Initialize all trackers
  document.querySelectorAll('.progress-tracker').forEach(tracker => {
    const checkbox = tracker.querySelector('.tracker-checkbox') as HTMLInputElement;
    const unitPath = (tracker as HTMLElement).dataset.unitPath || '';

    if (!checkbox || !unitPath) return;

    // Set initial state
    checkbox.checked = isCompleted(unitPath);

    // Handle changes
    checkbox.addEventListener('change', () => {
      setProgress(unitPath, checkbox.checked);
    });
  });
</script>
