---
import { getCategoryInfo } from "../utils/categoryInfo";

export interface Props {
  entry: {
    c: string; // category
    s: string; // slug
    n: string; // name
    d?: string; // description
    g?: string[]; // tags
    y?: number; // year
  };
  variant?: "featured" | "related";
  maxTags?: number;
  showYear?: boolean;
}

const { entry, variant = "featured", maxTags = 2, showYear = false } = Astro.props;

const category = getCategoryInfo(entry.c);
const baseClass = variant === "featured" ? "featured-entry-card" : "related-entry-card";
---

<a href={`/vault/${entry.c}/${entry.s}`} class={baseClass}>
  <div class={`${baseClass}__header`}>
    <span class={`${baseClass}__icon`} style={`color: ${category.color}`}>
      {category.icon}
    </span>
    <span class={`${baseClass}__category`}>
      {category.label}
    </span>
    {showYear && entry.y && <span class={`${baseClass}__year`}>{entry.y}</span>}
  </div>

  <h3 class={`${baseClass}__title`}>{entry.n}</h3>

  {entry.d && <p class={`${baseClass}__description`}>{entry.d}</p>}

  {
    entry.g && entry.g.length > 0 && (
      <div class={`${baseClass}__tags`}>
        {entry.g.slice(0, maxTags).map((tag: string) => (
          <span class={`${baseClass}__tag`}>{tag}</span>
        ))}
        {entry.g.length > maxTags && (
          <span class={`${baseClass}__tag ${baseClass}__tag--more`}>
            +{entry.g.length - maxTags}
          </span>
        )}
      </div>
    )
  }
</a>
