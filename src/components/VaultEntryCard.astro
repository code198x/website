---
import { getCategoryInfo } from "../utils/categoryInfo";

export interface Props {
  entry: {
    c: string; // category
    s: string; // slug
    n: string; // name
    d?: string; // description
    g?: string[]; // tags
    y?: number; // year
  };
  variant?: "featured" | "related";
  maxTags?: number;
  showYear?: boolean;
}

const { entry, variant = "featured", maxTags = 2, showYear = false } = Astro.props;

const category = getCategoryInfo(entry.c);
const baseClass = variant === "featured" ? "featured-entry-card" : "related-entry-card";
---

<a href={`/vault/${entry.c}/${entry.s}`} class={baseClass} data-category={entry.c}>
  <div class={`${baseClass}__header`}>
    <span class={`${baseClass}__icon`}>
      {category.icon}
    </span>
    <span class={`${baseClass}__category`}>
      {category.label}
    </span>
    {showYear && entry.y && <span class={`${baseClass}__year`}>{entry.y}</span>}
  </div>

  <h3 class={`${baseClass}__title`}>{entry.n}</h3>

  {entry.d && <p class={`${baseClass}__description`}>{entry.d}</p>}

  {
    entry.g && entry.g.length > 0 && (
      <div class={`${baseClass}__tags`}>
        {entry.g.slice(0, maxTags).map((tag: string) => (
          <span class={`${baseClass}__tag`}>{tag}</span>
        ))}
        {entry.g.length > maxTags && (
          <span class={`${baseClass}__tag ${baseClass}__tag--more`}>
            +{entry.g.length - maxTags}
          </span>
        )}
      </div>
    )
  }
</a>

<style>
  /* ============================================
     Vault Entry Card Component (BEM)
     ============================================ */

  /* Base card styles (shared between variants) */
  .featured-entry-card,
  .related-entry-card {
    display: block;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  /* Featured variant specific styling */
  .featured-entry-card {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .featured-entry-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .featured-entry-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    border-color: var(--color-primary);
  }

  .featured-entry-card:hover::before {
    transform: scaleX(1);
  }

  /* Related variant specific styling */
  .related-entry-card {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-lg);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .related-entry-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    border-color: var(--color-primary);
  }

  /* Category-specific icon colors */
  [data-category="articles"] .featured-entry-card__icon,
  [data-category="articles"] .related-entry-card__icon {
    color: var(--color-primary);
  }

  [data-category="projects"] .featured-entry-card__icon,
  [data-category="projects"] .related-entry-card__icon {
    color: var(--color-success);
  }

  [data-category="resources"] .featured-entry-card__icon,
  [data-category="resources"] .related-entry-card__icon {
    color: var(--color-accent);
  }

  [data-category="tutorials"] .featured-entry-card__icon,
  [data-category="tutorials"] .related-entry-card__icon {
    color: var(--color-warning);
  }

  [data-category="tools"] .featured-entry-card__icon,
  [data-category="tools"] .related-entry-card__icon {
    color: var(--color-info);
  }

  [data-category="games"] .featured-entry-card__icon,
  [data-category="games"] .related-entry-card__icon {
    color: var(--color-error);
  }

  /* Default fallback color */
  .featured-entry-card__icon,
  .related-entry-card__icon {
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
  }

  /* Header styles */
  .featured-entry-card__header,
  .related-entry-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .featured-entry-card__category,
  .related-entry-card__category {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
  }

  .featured-entry-card__year,
  .related-entry-card__year {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    margin-left: auto;
  }

  /* Title styles */
  .featured-entry-card__title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
    margin: var(--space-md) 0;
    line-height: 1.2;
  }

  .related-entry-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: var(--space-sm) 0;
    line-height: var(--line-height-tight);
  }

  /* Description styles */
  .featured-entry-card__description {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: var(--space-md) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-entry-card__description {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: var(--space-sm) 0;
  }

  /* Tag styles */
  .featured-entry-card__tags,
  .related-entry-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .featured-entry-card__tag,
  .related-entry-card__tag {
    font-size: var(--font-size-xs);
    padding: var(--space-0-5) var(--space-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-light);
    transition: var(--transition-fast);
  }

  .featured-entry-card__tag--more,
  .related-entry-card__tag--more {
    background: var(--color-bg-tertiary);
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-medium);
  }

  /* Hover states */
  .featured-entry-card:hover .featured-entry-card__title,
  .related-entry-card:hover .related-entry-card__title {
    color: var(--color-primary);
  }

  .featured-entry-card:hover .featured-entry-card__tag,
  .related-entry-card:hover .related-entry-card__tag {
    background: var(--color-bg-tertiary);
    border-color: var(--color-border);
  }

  /* Dark mode adjustments */
  .dark-mode .featured-entry-card__tag,
  .dark-mode .related-entry-card__tag {
    background: var(--color-bg-tertiary);
    border-color: var(--color-border);
  }

  .dark-mode .featured-entry-card:hover .featured-entry-card__tag,
  .dark-mode .related-entry-card:hover .related-entry-card__tag {
    background: var(--color-bg-secondary);
    border-color: var(--color-border-light);
  }
</style>
