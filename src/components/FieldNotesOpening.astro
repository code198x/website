---
import Sidebar from '@198x-ui/components/layout/Sidebar.astro';
import { ArrowDown } from '@lucide/astro';
import OpeningBand from './OpeningBand.astro';
---
<OpeningBand class="field-notes-opening" labelledby="field-notes-title" phone="tall" frame={false}
  art={{ src: '/images/field-notes-opening/landscape-2172.webp', srcset: '/images/field-notes-opening/landscape-1280.webp 1280w, /images/field-notes-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }} phoneArt={{ src: '/images/field-notes-opening/portrait-600.webp', srcset: '/images/field-notes-opening/portrait-600.webp 600w, /images/field-notes-opening/portrait-1122.webp 1122w', width: 1122, height: 1402 }}
  caption="An imagined investigation workbench.">
  <h1 id="field-notes-title"><span>Field</span>{' '}<span>Notes.</span></h1>
  {/* The link sits beside the text until the text would be under 80%, about 900px wide. */}
  <Sidebar side="right" contentMin="80%" class="opening-introduction" slot="below" style="--sidebar-space: clamp(.75rem, 2.7vw, 1.5rem)">
    <div>
      <h2 class="heading-h3">Development stories.</h2>
      <p>Stories from building the curriculum and its tools: what we tried,
        what happened, and what changed our understanding. Follow an investigation from
        the first surprising result to the evidence that helped explain it.</p>
    </div>
    <div><a href="#field-notes-stories">Read the stories <ArrowDown size={18} aria-hidden="true" /></a></div>
  </Sidebar>
</OpeningBand>

<style>@layer blocks {
  /* The heading is sized from the band, so it fits at every width. */
  h1 {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    margin: 0; font-family: var(--h-font-mag); font-style: italic; font-weight: 900;
    font-size: min(clamp(4rem, 8.6cqw, 12rem), 40cqh); line-height: .84; letter-spacing: -.025em;
    color: var(--h-ink); text-wrap: balance;
  }
  h1 span { display: block; }
  .opening-introduction { align-items: flex-end; padding: 2rem 0; }
  .opening-introduction h2 { overflow-wrap: anywhere; margin: 0 0 .75rem; }
  .opening-introduction p { max-width: 65ch; margin: 0; font-size: 1.125rem; line-height: 1.6; }
  .opening-introduction a { display: inline-flex; align-items: center; gap: .6rem; flex-shrink: 0; min-height: 2.75rem; font-size: 1rem; font-weight: 600; color: inherit; text-underline-offset: .25em; }
  .opening-introduction a:hover { color: var(--h-spot-ink); }
  .opening-introduction a:focus-visible { outline: 2px solid var(--h-spot-ink); outline-offset: .3rem; }
  @media (max-width: 700px) {
    h1 { justify-content: flex-start; padding-top: 10cqh; font-size: min(clamp(4rem, 19cqw, 8rem), 30cqh); }
    .opening-introduction { padding: 1.5rem 0; }
  }
}
</style>
