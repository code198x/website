---
import { ArrowDown } from '@lucide/astro';
---

<section class="field-notes-opening masthead-frame" aria-labelledby="field-notes-title">
  <div class="workbench">
    <picture>
      <source media="(max-width: 700px)"
        srcset="/images/field-notes-opening/portrait-600.webp 600w, /images/field-notes-opening/portrait-1122.webp 1122w"
        sizes="100vw" width="1122" height="1402" />
      <img src="/images/field-notes-opening/landscape-2172.webp"
        srcset="/images/field-notes-opening/landscape-1280.webp 1280w, /images/field-notes-opening/landscape-2172.webp 2172w"
        sizes="100vw" width="2172" height="724" alt="" aria-hidden="true" fetchpriority="high" />
    </picture>
    <h1 id="field-notes-title"><span>Field</span>{' '}<span>Notes.</span></h1>
  </div>
  <div class="opening-reading">
    <p class="artwork-caption">An imagined investigation workbench. Original AI-generated illustration.</p>
    <div class="opening-introduction">
      <div>
        <h2>Development stories.</h2>
        <p>Stories from building the curriculum and its tools: what we tried,
          what happened, and what changed our understanding. Follow an investigation from
          the first surprising result to the evidence that helped explain it.</p>
      </div>
      <a href="#field-notes-stories">Read the stories <ArrowDown size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .field-notes-opening { background: var(--h-page); color: var(--h-ink); }
  .workbench {
    position: relative; isolation: isolate; display: grid; place-items: center;
    box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0;
    aspect-ratio: 3 / 1; min-height: 21.25rem;
  }
  picture { position: absolute; inset: 0; overflow: hidden; z-index: -1; }
  picture, img { display: block; width: 100%; height: 100%; }
  img { object-fit: cover; }
  .workbench h1 {
    display: flex; flex-direction: column; align-items: center;
    margin: 0; padding: .22em 0; width: 100%;
    font-family: var(--h-font-mag); font-style: italic; font-weight: 900;
    font-size: clamp(4rem, 8.6vw, 12rem); line-height: .84; letter-spacing: -.025em;
    color: var(--h-ink); text-wrap: balance;
  }
  .workbench h1 span { display: block; }
  .opening-reading { box-sizing: border-box; max-width: var(--site-frame-width); margin: 0 auto; padding: 0 var(--page-gutter); }
  .artwork-caption {
    margin: 0; padding-top: .75rem; max-width: 80ch;
    font-size: .875rem; font-style: italic; line-height: 1.6; color: var(--h-ink-muted);
  }
  .opening-introduction { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; padding: 2rem 0; }
  .opening-introduction > div { min-width: 0; max-width: 100%; }
  .opening-introduction h2 { overflow-wrap: anywhere; font-family: var(--h-font-ui); font-size: clamp(1.5rem, 2vw, 2rem); font-weight: 700; line-height: 1.15; margin: 0 0 .75rem; }
  .opening-introduction p { max-width: 65ch; margin: 0; font-size: 1.125rem; line-height: 1.6; }
  .opening-introduction a { display: inline-flex; align-items: center; gap: .6rem; flex-shrink: 0; min-height: 2.75rem; font-size: 1rem; font-weight: 600; color: inherit; text-underline-offset: .25em; }
  .opening-introduction a:hover { color: var(--h-spot-ink); }
  .opening-introduction a:focus-visible { outline: 2px solid var(--h-spot-ink); outline-offset: .3rem; }
  @media (max-width: 900px) {
    .opening-introduction { align-items: flex-start; flex-direction: column; gap: .75rem; }
  }
  @media (max-width: 700px) {
    .workbench { aspect-ratio: 4 / 5; min-height: 0; }
    .workbench h1 { font-size: clamp(4rem, 19vw, 8rem); padding: .55em 0 .1em; }
    .opening-introduction { padding: 1.5rem 0; }
  }
</style>
