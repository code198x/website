---
/**
 * FirstStepCallout - the universal first step, on a machine's landing page
 *
 * A system page offers a choice of language track, which reads as though the
 * choice is the beginning. It isn't: General Programming comes before any
 * machine, for every learner, whichever track they end up on. Without this the
 * page silently tells a beginner to start with assembly or BASIC.
 *
 * Takes no props, like SetupCallout — the module is universal, so the copy is
 * the same on every machine's page. The unit count is read from the content
 * collection rather than written down, so it cannot drift from the module.
 *
 * See Code198x docs/decisions/front-of-curriculum-architecture.md
 *
 * Usage:
 *   import FirstStepCallout from '@components/FirstStepCallout.astro';
 *   <FirstStepCallout />
 */
import { Signpost } from '@lucide/astro';
import { getCollection } from 'astro:content';

const units = await getCollection('unit-pages');
const unitCount = units.filter((u) => u.id.startsWith('foundations/general-programming/unit-')).length;
---

<aside class="first-step">
  <div class="icon"><Signpost size={24} /></div>
  <p class="text">
    <strong>Everyone starts here.</strong> General Programming teaches what a program is —
    sequence, variables, loops, decisions — before any machine at all. {unitCount} units. If you
    already think in those, move straight on.
  </p>
  <a class="link" href="/foundations/general-programming">Start with General Programming &rarr;</a>
</aside>

<style>
  .first-step {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    max-width: 900px;
    margin: 0 auto var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--color-house-tint);
    border: 3px solid var(--color-text);
    box-shadow: var(--shadow-chunky);
  }

  .icon {
    display: flex;
    color: var(--color-house);
  }

  .text {
    flex: 1 1 22rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-align: left;
  }

  .text strong { color: var(--color-text); }

  .link {
    color: var(--color-house-2);
    font-family: var(--font-family-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .link:hover { text-decoration: underline; }
</style>
