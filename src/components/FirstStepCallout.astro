---
/**
 * FirstStepCallout — optional shared explanations on a system landing page.
 * Readers can begin with the system track or use Foundations when a concept
 * needs more explanation. Counts come from the authored unit collection.
 * See Code198x docs/specifications/curriculum.md.
 *
 * Usage:
 *   import FirstStepCallout from '@components/FirstStepCallout.astro';
 *   <FirstStepCallout />
 */
import { Signpost } from '@lucide/astro';
import { getCollection } from 'astro:content';

const units = await getCollection('unit-pages');
const PROGRAMMING = ['basics', 'working-it-out', 'decisions', 'repeating', 'structure'];
const unitCount = units.filter((u) => PROGRAMMING.some((m) => u.id.startsWith(`foundations/${m}/unit-`))).length;
---

<aside class="first-step">
  <div class="icon"><Signpost size={24} /></div>
  <p class="text">
    <strong>Explore the programming ideas.</strong> Five short Foundations modules use
    pseudocode to explain sequence, variables, decisions and loops, from The Basics to
    Structure. {unitCount} units to explore now or return to when a game raises a question.
    You can also begin with this machine’s track.
  </p>
  <a class="link" href="/foundations/basics">Explore The Basics &rarr;</a>
</aside>

<style>
  .first-step {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    max-width: 900px;
    margin: 0 auto var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--color-house-tint);
    border: 3px solid var(--color-text);
    box-shadow: var(--shadow-chunky);
  }

  .icon {
    display: flex;
    color: var(--color-house);
  }

  .text {
    flex: 1 1 22rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-align: left;
  }

  .text strong { color: var(--color-text); }

  .link {
    color: var(--color-house-2);
    font-family: var(--font-family-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .link:hover { text-decoration: underline; }
</style>
