---
/**
 * DynamicIcon - Renders a Lucide icon by name
 *
 * Usage:
 *   import DynamicIcon from '@components/DynamicIcon.astro';
 *   <DynamicIcon name="Monitor" size={24} />
 */
import {
  Monitor,
  Gamepad2,
  Volume2,
  Move,
  Bot,
  Layers,
  GraduationCap,
  TrendingUp,
  Flame,
  HardDrive,
  Cpu,
  Users,
  Building2,
  BookOpen,
  Wrench,
  FileText,
} from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

// Map icon names to components
const iconMap: Record<string, typeof Monitor> = {
  Monitor,
  Gamepad2,
  Volume2,
  Move,
  Bot,
  Layers,
  GraduationCap,
  TrendingUp,
  Flame,
  HardDrive,
  Cpu,
  Users,
  Building2,
  BookOpen,
  Wrench,
  FileText,
};

const IconComponent = iconMap[name];
---

{IconComponent ? (
  <IconComponent size={size} class={className} />
) : (
  <span class={className}>{name}</span>
)}
