---
/**
 * InlineNote - A callout/note component for highlighting important information
 *
 * Usage:
 *   <InlineNote>
 *     Important information here
 *   </InlineNote>
 */
---

<aside class="inline-note">
  <slot />
</aside>

<style>
  .inline-note {
    background: var(--note-bg, #1a1a2e);
    border-left: 4px solid var(--note-border, #4a9eff);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .inline-note :global(p:first-child) {
    margin-top: 0;
  }

  .inline-note :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
