---
/**
 * InlineNote - A callout/note component for highlighting important information
 *
 * Usage:
 *   <InlineNote>
 *     Important information here
 *   </InlineNote>
 */
---

<aside class="inline-note">
  <slot />
</aside>

<style>
  .inline-note {
    background: var(--color-note-bg, var(--color-surface));
    border-left: 4px solid var(--color-note-border, var(--color-primary));
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-note-text, var(--color-text));
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-note-border, var(--color-primary));
  }

  .inline-note :global(p:first-child) {
    margin-top: 0;
  }

  .inline-note :global(p:last-child) {
    margin-bottom: 0;
  }

  .inline-note :global(code) {
    background: var(--color-bg-secondary);
    color: var(--color-primary);
  }
</style>
