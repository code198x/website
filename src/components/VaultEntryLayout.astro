---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Breadcrumb from "./Breadcrumb.astro";
import RelatedEntries from "./RelatedEntries.astro";
import { generateVaultBreadcrumbs, convertToVaultData } from "../utils/breadcrumbs";

export interface Props {
  // Layout props
  title: string;
  description?: string;
  structuredData?: object;

  // Entry data
  entry: any;
  categorySlug: string;
  categoryName: string;
  categoryIcon: string;
  categoryColor: string;

  // Optional overrides
  heroTitle?: string;
  heroSubtitle?: string;
  heroDescription?: string;
}

const {
  title,
  description,
  structuredData,
  entry,
  categorySlug,
  categoryName,
  categoryIcon,
  categoryColor,
  heroTitle,
  heroSubtitle,
  heroDescription,
} = Astro.props;

// Get the appropriate year field for this collection
const displayYear = entry.data.year || null;

// Convert entry to vault data format for RelatedEntries component
const currentEntryData = convertToVaultData(entry, categorySlug as any);

// Default hero content
const defaultTitle = heroTitle || entry.data.name || entry.data.title;
const defaultSubtitle = heroSubtitle || entry.data.description;
const defaultDescription =
  heroDescription ||
  `Learn about ${entry.data.name || entry.data.title}, ${entry.data.type} from ${displayYear || "the golden age of computing"}.`;

// Extract additional metadata fields based on category
const additionalMetadata = [];
if (entry.data.manufacturer)
  additionalMetadata.push({ label: "Manufacturer", value: entry.data.manufacturer });
if (entry.data.cpu) additionalMetadata.push({ label: "CPU", value: entry.data.cpu });
if (entry.data.memory) additionalMetadata.push({ label: "Memory", value: entry.data.memory });
if (entry.data.publisher)
  additionalMetadata.push({ label: "Publisher", value: entry.data.publisher });
if (entry.data.developers)
  additionalMetadata.push({ label: "Developers", value: entry.data.developers.join(", ") });
if (entry.data.platform) additionalMetadata.push({ label: "Platform", value: entry.data.platform });
if (entry.data.license) additionalMetadata.push({ label: "License", value: entry.data.license });
if (entry.data.outputFormats)
  additionalMetadata.push({ label: "Output", value: entry.data.outputFormats.join(", ") });

// Render the entry content
const { Content } = await entry.render();
---

<Layout title={title} description={description} structuredData={structuredData}>
  <Hero
    title={defaultTitle}
    subtitle={defaultSubtitle}
    description={defaultDescription}
    variant="gradient"
    badge={{
      text: `${categoryIcon} ${categoryName}`,
      color: categoryColor,
      href: "/vault",
    }}
  />

  <div class="vault-category-container">
    <div class="container">
      <!-- Breadcrumb navigation -->
      <Breadcrumb items={generateVaultBreadcrumbs(categorySlug as any, entry.data.name)} />

      <article class="vault-entry-content">
        <div class="entry-metadata">
          <div class="metadata-grid">
            {
              entry.data.year && (
                <div class="metadata-item">
                  <span class="metadata-label">Year</span>
                  <span class="metadata-value">{entry.data.year}</span>
                </div>
              )
            }
            <div class="metadata-item">
              <span class="metadata-label">Type</span>
              <span class="metadata-value">{entry.data.type}</span>
            </div>
            {
              additionalMetadata.slice(0, 2).map((item) => (
                <div class="metadata-item">
                  <span class="metadata-label">{item.label}</span>
                  <span class="metadata-value">{item.value}</span>
                </div>
              ))
            }
          </div>

          {
            additionalMetadata.length > 2 && (
              <div class="metadata-grid secondary">
                {additionalMetadata.slice(2).map((item) => (
                  <div class="metadata-item secondary-item">
                    <span class="metadata-label">{item.label}</span>
                    <span class="metadata-value">{item.value}</span>
                  </div>
                ))}
              </div>
            )
          }

          {
            entry.data.tags && entry.data.tags.length > 0 && (
              <div class="entry-tags">
                <span class="tags-label">Tags:</span>
                <div class="tags-list">
                  {entry.data.tags.map((tag: string) => (
                    <a href={`/vault/tags/${tag.toLowerCase()}`} class="tag">
                      {tag.toLowerCase()}
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <div class="entry-main-content">
          <Content />
        </div>

        <RelatedEntries currentEntry={currentEntryData} />

        <div class="back-navigation">
          <a href={`/vault/${categorySlug}`} class="back-link">
            ← Back to {categoryName} Collection
          </a>
        </div>
      </article>

      <!-- Additional content slot -->
      <slot />
    </div>
  </div>
</Layout>

<style>
  /* Main container styling */
  .vault-entry-content {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  /* Metadata Section */
  .entry-metadata {
    background: linear-gradient(
      135deg,
      var(--color-background-secondary) 0%,
      var(--color-background) 100%
    );
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  /* Add subtle pattern overlay */
  .entry-metadata::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(0, 123, 255, 0.02) 10px,
      rgba(0, 123, 255, 0.02) 20px
    );
    pointer-events: none;
  }

  .metadata-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    position: relative;
  }

  .metadata-grid.secondary {
    margin-bottom: 0;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px dashed var(--color-border);
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    transition: all 0.2s ease;
  }

  .metadata-item.secondary-item {
    background: var(--color-background-secondary);
    border-style: dashed;
    opacity: 0.9;
  }

  .metadata-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .metadata-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .metadata-value {
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    font-weight: 500;
    text-transform: capitalize;
  }

  /* Tags Section */
  .entry-tags {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .tags-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-right: var(--space-md);
    display: inline-block;
    margin-bottom: var(--space-sm);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-xs) var(--space-md);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 0.9));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: 600;
    position: relative;
    overflow: hidden;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .tag:hover {
    transform: scale(1.05) translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
    color: white;
  }

  .tag::before {
    content: "#";
    margin-right: 2px;
    opacity: 0.7;
    font-weight: 400;
  }

  /* Main Content Area */
  .entry-main-content {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
    position: relative;
  }

  /* Style the rendered markdown content */
  .entry-main-content :global(h1) {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    margin-bottom: var(--space-lg);
    color: var(--color-text-primary);
    border-bottom: 3px solid var(--color-primary);
    padding-bottom: var(--space-md);
  }

  .entry-main-content :global(h2) {
    font-size: var(--font-size-2xl);
    font-weight: 600;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
    position: relative;
    padding-left: var(--space-lg);
  }

  .entry-main-content :global(h2::before) {
    content: "▶";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-size: var(--font-size-lg);
  }

  .entry-main-content :global(h3) {
    font-size: var(--font-size-xl);
    font-weight: 600;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .entry-main-content :global(p) {
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .entry-main-content :global(ul),
  .entry-main-content :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-xl);
  }

  .entry-main-content :global(li) {
    margin-bottom: var(--space-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .entry-main-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-lg);
    margin: var(--space-lg) 0;
    font-style: italic;
    color: var(--color-text-tertiary);
    background: var(--color-background-secondary);
    padding: var(--space-lg);
    border-radius: 0 var(--border-radius-md) var(--border-radius-md) 0;
  }

  .entry-main-content :global(code) {
    font-family: var(--font-family-mono);
    background: var(--color-background-secondary);
    padding: 2px 6px;
    border-radius: var(--border-radius-sm);
    font-size: 0.9em;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .entry-main-content :global(pre) {
    background: var(--color-background-secondary);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: var(--space-lg);
    overflow-x: auto;
    margin: var(--space-lg) 0;
  }

  .entry-main-content :global(pre code) {
    background: transparent;
    padding: 0;
    border: none;
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
  }

  /* Back Navigation */
  .back-navigation {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 2px solid var(--color-border);
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-md) var(--space-xl);
    background: linear-gradient(135deg, var(--color-primary), rgba(0, 100, 200, 1));
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.2);
  }

  .back-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 123, 255, 0.3);
    background: linear-gradient(135deg, rgba(0, 100, 200, 1), var(--color-primary));
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .vault-entry-content {
      padding: var(--space-lg) var(--space-md);
    }

    .entry-metadata {
      padding: var(--space-lg);
    }

    .metadata-grid {
      grid-template-columns: 1fr;
    }

    .entry-main-content {
      padding: var(--space-lg);
    }

    .tags-list {
      margin-top: var(--space-md);
    }
  }

  /* Print Styles */
  @media print {
    .back-navigation {
      display: none;
    }

    .entry-metadata {
      break-inside: avoid;
    }
  }
</style>
