---
/**
 * SpectrumBitmapLayout - Where the Spectrum's bitmap bytes fall on screen
 *
 * Left: the 256×192 screen divided into its three thirds ($4000 / $4800 /
 * $5000). Right: a zoom of the first two character rows, one label per
 * pixel line, making the interleave visible — consecutive lines of a
 * character row sit 256 bytes apart (inc h), while the next character
 * row's top line is only 32 bytes in.
 *
 *   <SpectrumBitmapLayout caption="..." />
 */

interface Props {
  caption?: string;
}

const { caption } = Astro.props;

// Palette — matches RegisterBits' field colours for cross-diagram coherence
const THIRD_COLORS = ['#e0b341', '#5aa9e6', '#7bd88f'];

// Layout
const PAD = 14;
const TITLE_H = 26;

// Screen panel (left): 256x192 at 1.5x
const SCREEN_X = PAD + 6;
const SCREEN_Y = TITLE_H + 26;
const SCREEN_W = 336;
const SCREEN_H = 252;
const THIRD_H = SCREEN_H / 3;

const thirds = [
  { base: '$4000', rows: 'char rows 0-7' },
  { base: '$4800', rows: 'char rows 8-15' },
  { base: '$5000', rows: 'char rows 16-23' },
];

// Zoom panel (right): char rows 0 and 1 of the top third, line by line
const ZOOM_X = SCREEN_X + SCREEN_W + 64;
const ZOOM_Y = SCREEN_Y;
const LINE_H = 16;
const ZOOM_W = 200;
const zoomLines = Array.from({ length: 16 }, (_, i) => {
  const charRow = i >> 3;      // 0 or 1
  const pixelRow = i & 7;      // 0-7 within the character row
  const addr = 0x4000 + pixelRow * 256 + charRow * 32;
  return {
    y: ZOOM_Y + i * LINE_H,
    charRow,
    pixelRow,
    addr: '$' + addr.toString(16).toUpperCase().padStart(4, '0'),
  };
});
const ZOOM_H = 16 * LINE_H;

const TOTAL_W = ZOOM_X + ZOOM_W + 100;
const TOTAL_H = SCREEN_Y + Math.max(SCREEN_H, ZOOM_H) + 30;
---

<figure class="spectrum-bitmap-figure">
  <svg
    viewBox={`0 0 ${TOTAL_W} ${TOTAL_H}`}
    class="spectrum-bitmap-svg"
    role="img"
    aria-label="Where the Spectrum's bitmap bytes fall on screen: three thirds of eight character rows, and within a third, each character row's pixel lines 256 bytes apart"
  >
    <rect x="0" y="0" width={TOTAL_W} height={TOTAL_H} fill="#1a1714" />

    <text
      x={TOTAL_W / 2}
      y={TITLE_H / 2 + 8}
      text-anchor="middle"
      fill="#e0e0e0"
      font-family="var(--font-family-mono, monospace)"
      font-size="13"
      font-weight="bold"
    >
      The bitmap on the screen — $4000-$57FF in three thirds
    </text>

    {/* Screen panel */}
    <text
      x={SCREEN_X + SCREEN_W / 2}
      y={SCREEN_Y - 8}
      text-anchor="middle"
      fill="#888"
      font-family="var(--font-family-mono, monospace)"
      font-size="10"
    >
      the whole screen, 256×192
    </text>

    {thirds.map((t, i) => (
      <g>
        <rect
          x={SCREEN_X}
          y={SCREEN_Y + i * THIRD_H}
          width={SCREEN_W}
          height={THIRD_H}
          fill={THIRD_COLORS[i]}
          fill-opacity="0.16"
          stroke={THIRD_COLORS[i]}
          stroke-width="1.5"
        />
        <text
          x={SCREEN_X + 10}
          y={SCREEN_Y + i * THIRD_H + THIRD_H / 2 - 7}
          fill={THIRD_COLORS[i]}
          font-family="var(--font-family-mono, monospace)"
          font-size="12"
          font-weight="bold"
        >
          {`third ${i} — from ${t.base}`}
        </text>
        <text
          x={SCREEN_X + 10}
          y={SCREEN_Y + i * THIRD_H + THIRD_H / 2 + 11}
          fill="#aaa"
          font-family="var(--font-family-mono, monospace)"
          font-size="10"
        >
          {t.rows}
        </text>
      </g>
    ))}

    {/* Guide lines from the top third to the zoom panel */}
    <line
      x1={SCREEN_X + SCREEN_W}
      y1={SCREEN_Y}
      x2={ZOOM_X}
      y2={ZOOM_Y}
      stroke="#666"
      stroke-width="1"
      stroke-dasharray="3 3"
    />
    <line
      x1={SCREEN_X + SCREEN_W}
      y1={SCREEN_Y + (THIRD_H * 2) / 8}
      x2={ZOOM_X}
      y2={ZOOM_Y + ZOOM_H}
      stroke="#666"
      stroke-width="1"
      stroke-dasharray="3 3"
    />

    {/* Zoom panel: char rows 0-1, line by line */}
    <text
      x={ZOOM_X + ZOOM_W / 2}
      y={ZOOM_Y - 8}
      text-anchor="middle"
      fill="#888"
      font-family="var(--font-family-mono, monospace)"
      font-size="10"
    >
      zoom: the third's first 16 pixel lines
    </text>

    {zoomLines.map((line) => (
      <g>
        <rect
          x={ZOOM_X}
          y={line.y}
          width={ZOOM_W}
          height={LINE_H - 2}
          fill={THIRD_COLORS[0]}
          fill-opacity={line.charRow === 0 ? 0.28 : 0.1}
          stroke={THIRD_COLORS[0]}
          stroke-opacity="0.5"
          stroke-width="0.5"
        />
        <text
          x={ZOOM_X + 8}
          y={line.y + LINE_H / 2 + 3}
          fill={line.charRow === 0 ? '#f0d488' : '#b09a55'}
          font-family="var(--font-family-mono, monospace)"
          font-size="10"
        >
          {line.addr}
        </text>
        <text
          x={ZOOM_X + ZOOM_W - 8}
          y={line.y + LINE_H / 2 + 3}
          text-anchor="end"
          fill="#888"
          font-family="var(--font-family-mono, monospace)"
          font-size="9"
        >
          {`row ${line.charRow} · line ${line.pixelRow}`}
        </text>
      </g>
    ))}

    {/* +256 bracket: line 0 -> line 1 of char row 0 */}
    <path
      d={`M ${ZOOM_X + ZOOM_W + 10} ${ZOOM_Y + LINE_H / 2} h 12 v ${LINE_H} h -12`}
      fill="none"
      stroke="#e0e0e0"
      stroke-width="1.2"
    />
    <text
      x={ZOOM_X + ZOOM_W + 28}
      y={ZOOM_Y + LINE_H + 4}
      fill="#e0e0e0"
      font-family="var(--font-family-mono, monospace)"
      font-size="10"
    >
      +256
    </text>
    <text
      x={ZOOM_X + ZOOM_W + 28}
      y={ZOOM_Y + LINE_H + 17}
      fill="#888"
      font-family="var(--font-family-mono, monospace)"
      font-size="9"
    >
      inc h
    </text>

    {/* +32 bracket: line 0 of char row 0 -> line 0 of char row 1 */}
    <path
      d={`M ${ZOOM_X + ZOOM_W + 46} ${ZOOM_Y + LINE_H / 2} h 12 v ${LINE_H * 8} h -12`}
      fill="none"
      stroke="#e0e0e0"
      stroke-width="1.2"
    />
    <text
      x={ZOOM_X + ZOOM_W + 64}
      y={ZOOM_Y + LINE_H * 4 + 4}
      fill="#e0e0e0"
      font-family="var(--font-family-mono, monospace)"
      font-size="10"
    >
      +32
    </text>
  </svg>
  {caption && <figcaption class="spectrum-bitmap-caption">{caption}</figcaption>}
</figure>

<style>
  .spectrum-bitmap-figure {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  .spectrum-bitmap-svg {
    max-width: 720px;
    width: 100%;
    height: auto;
    display: block;
  }

  .spectrum-bitmap-caption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-secondary, #555);
    font-style: italic;
  }
</style>
