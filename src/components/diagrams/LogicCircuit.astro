---
/**
 * LogicCircuit - Gates and wires, drawn from the circuit's own description
 *
 * Works across platforms — entirely content-driven, no platform assumptions.
 *
 * Layout is computed from the wiring: a gate sits one column right of the
 * furthest thing feeding it, so the picture cannot drift out of step with
 * the circuit it claims to draw.
 *
 * Usage — a half adder:
 *   <LogicCircuit
 *     id="half-adder"
 *     inputs={["A", "B"]}
 *     gates={[
 *       { id: "sum", type: "XOR", from: ["A", "B"] },
 *       { id: "carry", type: "AND", from: ["A", "B"] },
 *     ]}
 *     outputs={[
 *       { from: "sum", label: "SUM" },
 *       { from: "carry", label: "CARRY" },
 *     ]}
 *     interactive
 *     caption="Two gates. That is the whole of it."
 *   />
 *
 * With `interactive`, the input pins can be clicked or focused and toggled
 * with Enter or Space, and every wire redraws to match. The component also
 * announces the row it is now showing, so a TruthTable with
 * `syncWith` set to the same id highlights the matching row.
 *
 * A `BLOCK` gate is a labelled box rather than a gate shape, for drawing a
 * circuit whose insides have already been taught — eight full adders in a
 * ripple chain are unreadable as forty gates. A block may carry several
 * named output pins, referenced from a later gate as `"adder0:carry"`.
 */

import { inlineMarkdown } from '../../lib/inline-markdown';

type GateType = 'AND' | 'OR' | 'XOR' | 'NOT' | 'BLOCK';

interface Gate {
  id: string;
  type: GateType;
  /** Sources, each `"nodeId"` or `"nodeId:pin"`. */
  from: string[];
  /** Shown inside a BLOCK, or under a gate. */
  label?: string;
  /** Named output pins. Defaults to a single unnamed one. */
  out?: string[];
}

interface OutputPin {
  from: string;
  label: string;
}

interface Props {
  inputs: string[];
  gates: Gate[];
  outputs: OutputPin[];
  caption?: string;
  interactive?: boolean;
  id?: string;
}

const {
  inputs,
  gates,
  outputs,
  caption,
  interactive = false,
  id = 'circuit',
} = Astro.props;

// Layout constants
const GATE_W = 54;
const GATE_H = 38;
const BLOCK_W = 84;
const COL_GAP = 58;
const ROW_GAP = 62;
const PAD_X = 56;
const PAD_Y = 30;
const PIN_R = 7;

// Drawn small and scaled up as vector, so the geometry stays the numbers that
// were checked by eye while the diagram sits comfortably in the text column.
const SCALE = 1.5;

const sourceOf = (ref: string) => ref.split(':')[0];
const pinOf = (ref: string) => ref.split(':')[1] ?? 'out';

const gateById = new Map(gates.map((g) => [g.id, g]));

inputs.forEach((name) => {
  if (gateById.has(name)) {
    throw new Error(`LogicCircuit: "${name}" is both an input and a gate`);
  }
});

[...gates.flatMap((g) => g.from), ...outputs.map((o) => o.from)].forEach((ref) => {
  const src = sourceOf(ref);
  if (!inputs.includes(src) && !gateById.has(src)) {
    throw new Error(`LogicCircuit: "${ref}" names ${src}, which is not an input or a gate`);
  }
  const gate = gateById.get(src);
  if (gate && !(gate.out ?? ['out']).includes(pinOf(ref))) {
    throw new Error(`LogicCircuit: "${src}" has no output pin "${pinOf(ref)}"`);
  }
});

// A gate sits one column right of the furthest thing feeding it. Resolving by
// repeated relaxation also catches a loop, which a combinational circuit
// must not have and which would otherwise hang the layout.
const layer = new Map<string, number>(inputs.map((name) => [name, 0]));
for (let pass = 0; pass <= gates.length; pass += 1) {
  let moved = false;
  gates.forEach((gate) => {
    const depths = gate.from.map((ref) => layer.get(sourceOf(ref)));
    if (depths.some((d) => d === undefined)) return;
    const want = Math.max(...(depths as number[])) + 1;
    if (layer.get(gate.id) !== want) {
      layer.set(gate.id, want);
      moved = true;
    }
  });
  if (!moved) break;
  if (pass === gates.length) {
    throw new Error('LogicCircuit: the wiring feeds back on itself');
  }
}

const gateLayers = gates.map((g) => layer.get(g.id) ?? 1);
const outputLayer = Math.max(0, ...gateLayers) + 1;

// Place each column's nodes evenly down the diagram.
type Placed = { x: number; y: number };
const column = new Map<number, string[]>();
const put = (l: number, key: string) => column.set(l, [...(column.get(l) ?? []), key]);
inputs.forEach((name) => put(0, name));
gates.forEach((gate) => put(layer.get(gate.id) ?? 1, gate.id));
outputs.forEach((o, i) => put(outputLayer, `__out${i}`));

const widthOf = (gate: Gate) => (gate.type === 'BLOCK' ? BLOCK_W : GATE_W);

// x is the left edge of every node, pins included, so a column's width is the
// widest thing in it and the next column starts clear of it.
const nodeWidth = (key: string) => {
  const gate = gateById.get(key);
  return gate ? widthOf(gate) : PIN_R * 2;
};

const columnWidth = new Map<number, number>();
column.forEach((keys, l) =>
  columnWidth.set(l, Math.max(...keys.map(nodeWidth)))
);

const columnX = new Map<number, number>();
for (let l = 0; l <= outputLayer; l += 1) {
  const previous = l === 0 ? PAD_X : columnX.get(l - 1)! + (columnWidth.get(l - 1) ?? 0) + COL_GAP;
  columnX.set(l, previous);
}

const tallest = Math.max(...[...column.values()].map((c) => c.length));
const height = PAD_Y * 2 + (Math.max(1, tallest) - 1) * ROW_GAP + GATE_H;
const width = columnX.get(outputLayer)! + (columnWidth.get(outputLayer) ?? 0) + PAD_X;

// Vertical placement, column by column left to right. Inputs space out evenly;
// after that a node wants to sit level with whatever feeds it, so wires run
// straight rather than all converging on one centre line. Nodes that want the
// same row get pushed apart, and each column is re-centred once it is placed.
const pos = new Map<string, Placed>();
for (let l = 0; l <= outputLayer; l += 1) {
  const keys = column.get(l) ?? [];
  if (keys.length === 0) continue;

  if (l === 0) {
    const span = (keys.length - 1) * ROW_GAP;
    keys.forEach((key, i) =>
      pos.set(key, { x: columnX.get(l)!, y: (height - span) / 2 + i * ROW_GAP })
    );
    continue;
  }

  const feeders = (key: string): string[] => {
    const gate = gateById.get(key);
    if (gate) return gate.from;
    const out = outputs[Number(key.slice('__out'.length))];
    return out ? [out.from] : [];
  };

  const want = keys.map((key) => {
    const ys = feeders(key)
      .map((ref) => pos.get(sourceOf(ref))?.y)
      .filter((y): y is number => y !== undefined);
    return ys.length ? ys.reduce((a, b) => a + b, 0) / ys.length : height / 2;
  });

  const placed: number[] = [];
  let lowest = -Infinity;
  keys
    .map((_, i) => i)
    .sort((a, b) => want[a] - want[b])
    .forEach((i) => {
      placed[i] = Math.max(want[i], lowest + ROW_GAP);
      lowest = placed[i];
    });

  // Nudge into bounds if the wanted rows push past an edge, but do not centre:
  // centring a column that holds one node throws its barycentre away, which is
  // exactly the case a carry chain is made of.
  const edge = PAD_Y + GATE_H / 2;
  const over = Math.max(0, Math.max(...placed) - (height - edge));
  const under = Math.max(0, edge - Math.min(...placed));
  const shift = under - over;
  keys.forEach((key, i) => pos.set(key, { x: columnX.get(l)!, y: placed[i] + shift }));
}

// Where a wire leaves a node, and where it arrives.
function outAt(ref: string): Placed {
  const src = sourceOf(ref);
  const p = pos.get(src)!;
  const gate = gateById.get(src);
  if (!gate) return { x: p.x + PIN_R * 2, y: p.y };
  const pins = gate.out ?? ['out'];
  const i = pins.indexOf(pinOf(ref));
  const spread = pins.length > 1 ? (i - (pins.length - 1) / 2) * (GATE_H / pins.length) : 0;
  return { x: p.x + widthOf(gate), y: p.y + spread };
}

function inAt(gate: Gate, index: number): Placed {
  const p = pos.get(gate.id)!;
  const n = gate.from.length;
  const spread = n > 1 ? (index - (n - 1) / 2) * (GATE_H / (n + 0.4)) : 0;
  return { x: p.x, y: p.y + spread };
}

// Orthogonal routing: out, across a shared channel, then in. The channel sits
// in the gap between the columns so wires stack rather than overlap.
function wire(from: Placed, to: Placed, channel: number): string {
  if (Math.abs(from.y - to.y) < 0.5) return `M ${from.x} ${from.y} H ${to.x}`;
  return `M ${from.x} ${from.y} H ${channel} V ${to.y} H ${to.x}`;
}

interface Wire {
  d: string;
  ref: string;
}
const wires: Wire[] = [];
gates.forEach((gate) => {
  const gx = pos.get(gate.id)!.x;
  gate.from.forEach((ref, i) => {
    const from = outAt(ref);
    const to = inAt(gate, i);
    const channel = from.x + (gx - from.x) * (0.35 + 0.3 * (i / Math.max(1, gate.from.length - 1 || 1)));
    wires.push({ d: wire(from, to, channel), ref });
  });
});
outputs.forEach((o, i) => {
  const from = outAt(o.from);
  const to = pos.get(`__out${i}`)!;
  const channel = from.x + (to.x - from.x) * 0.5;
  wires.push({ d: wire(from, { x: to.x, y: to.y }, channel), ref: o.from });
});

// Gate outlines, in a box at (x, y) of the given size. These are the standard
// shapes a reader will meet in any other book on the subject.
function gatePath(type: GateType, x: number, y: number, w: number, h: number): string {
  const b = y + h;
  switch (type) {
    case 'AND':
      return `M ${x} ${y} H ${x + w / 2} A ${h / 2} ${h / 2} 0 0 1 ${x + w / 2} ${b} H ${x} Z`;
    case 'OR':
    case 'XOR':
      return (
        `M ${x} ${y} Q ${x + w * 0.55} ${y} ${x + w} ${y + h / 2} ` +
        `Q ${x + w * 0.55} ${b} ${x} ${b} Q ${x + w * 0.3} ${y + h / 2} ${x} ${y} Z`
      );
    case 'NOT':
      return `M ${x} ${y} L ${x + w - 9} ${y + h / 2} L ${x} ${b} Z`;
    default:
      return '';
  }
}

// Server-rendered state: every input off. The script re-evaluates from the
// same description, so what ships without JavaScript is the first row of the
// table rather than a blank picture.
function evaluate(values: Record<string, number>): Record<string, number> {
  const v: Record<string, number> = { ...values };
  const read = (ref: string) => v[ref] ?? v[sourceOf(ref)] ?? 0;
  [...gates]
    .sort((a, b) => (layer.get(a.id) ?? 0) - (layer.get(b.id) ?? 0))
    .forEach((gate) => {
      const bits = gate.from.map(read);
      let out = 0;
      if (gate.type === 'AND') out = bits.every((b) => b === 1) ? 1 : 0;
      else if (gate.type === 'OR') out = bits.some((b) => b === 1) ? 1 : 0;
      else if (gate.type === 'XOR') out = bits.reduce((a, b) => a ^ b, 0);
      else if (gate.type === 'NOT') out = bits[0] === 1 ? 0 : 1;
      else out = bits.reduce((a, b) => a ^ b, 0);
      v[gate.id] = out;
      (gate.out ?? ['out']).forEach((pin) => {
        v[`${gate.id}:${pin}`] = out;
      });
    });
  return v;
}

const initial = evaluate(Object.fromEntries(inputs.map((name) => [name, 0])));
const live = (ref: string) => initial[ref] ?? initial[sourceOf(ref)] ?? 0;

const wiring = { inputs, gates, id };
const svgLabel = caption ?? 'Logic circuit diagram';
---

<figure class="logic-circuit-figure" data-circuit={id}>
  <svg
    class="logic-circuit-svg"
    style={`max-width: ${Math.round(width * SCALE)}px`}
    viewBox={`0 0 ${width} ${height}`}
    {/* role="img" makes a picture of the whole SVG and hides its children, which
        would take the input pins out of the accessibility tree along with them.
        An interactive circuit is a group of controls, so it says so. */}
    role={interactive ? 'group' : 'img'}
    aria-label={svgLabel}
    xmlns="http://www.w3.org/2000/svg"
  >
    {
      wires.map((w) => (
        <path
          class:list={['lc-wire', live(w.ref) === 1 && 'lc-on']}
          data-wire={w.ref}
          d={w.d}
          fill="none"
        />
      ))
    }

    {
      inputs.map((name) => {
        const p = pos.get(name)!;
        return (
          <g
            class:list={['lc-pin', interactive && 'lc-live', live(name) === 1 && 'lc-on']}
            data-input={name}
            role={interactive ? 'button' : undefined}
            tabindex={interactive ? 0 : undefined}
            aria-pressed={interactive ? String(live(name) === 1) : undefined}
            aria-label={interactive ? `Input ${name}` : undefined}
          >
            <circle cx={p.x + PIN_R} cy={p.y} r={PIN_R} />
            <text class="lc-pin-name" x={p.x - 6} y={p.y} text-anchor="end">
              {name}
            </text>
            <text class="lc-pin-value" data-value={name} x={p.x + PIN_R} y={p.y}>
              {live(name)}
            </text>
          </g>
        );
      })
    }

    {
      gates.map((gate) => {
        const p = pos.get(gate.id)!;
        const w = widthOf(gate);
        const y = p.y - GATE_H / 2;
        return (
          <g class="lc-gate">
            {gate.type === 'BLOCK' ? (
              <rect class="lc-shape" x={p.x} y={y} width={w} height={GATE_H} rx="3" />
            ) : (
              <path class="lc-shape" d={gatePath(gate.type, p.x, y, w, GATE_H)} />
            )}
            {gate.type === 'XOR' && (
              <path
                class="lc-shape lc-xor-arc"
                fill="none"
                d={`M ${p.x - 7} ${y} Q ${p.x + w * 0.3 - 7} ${p.y} ${p.x - 7} ${y + GATE_H}`}
              />
            )}
            {gate.type === 'NOT' && (
              <circle class="lc-shape" cx={p.x + w - 5} cy={p.y} r="4.5" />
            )}
            <text
              class="lc-gate-name"
              x={gate.type === 'BLOCK' ? p.x + w / 2 : p.x + w * 0.42}
              y={p.y}
              text-anchor="middle"
            >
              {gate.label ?? (gate.type === 'BLOCK' ? gate.id : gate.type)}
            </text>
          </g>
        );
      })
    }

    {
      outputs.map((o, i) => {
        const p = pos.get(`__out${i}`)!;
        return (
          <g class:list={['lc-pin', 'lc-out', live(o.from) === 1 && 'lc-on']} data-output={o.from}>
            <circle cx={p.x + PIN_R} cy={p.y} r={PIN_R} />
            <text class="lc-pin-name" x={p.x + PIN_R * 2 + 6} y={p.y}>
              {o.label}
            </text>
            <text class="lc-pin-value" data-value={o.from} x={p.x + PIN_R} y={p.y}>
              {live(o.from)}
            </text>
          </g>
        );
      })
    }
  </svg>

  {
    interactive && (
      <p class="lc-hint">
        Click an input to turn it on or off, and watch the wires.
      </p>
    )
  }
  {caption && <figcaption class="logic-circuit-caption" set:html={inlineMarkdown(caption)} />}
</figure>

{
  interactive && (
    <script is:inline define:vars={{ wiring }}>
      (() => {
        const root = document.querySelector(`[data-circuit="${wiring.id}"]`);
        if (!root) return;

        const state = Object.fromEntries(wiring.inputs.map((n) => [n, 0]));
        const src = (ref) => ref.split(':')[0];

        function evaluate() {
          const v = { ...state };
          const read = (ref) => (ref in v ? v[ref] : v[src(ref)] ?? 0);
          for (const gate of wiring.gates) {
            const bits = gate.from.map(read);
            let out;
            if (gate.type === 'AND') out = bits.every((b) => b === 1) ? 1 : 0;
            else if (gate.type === 'OR') out = bits.some((b) => b === 1) ? 1 : 0;
            else if (gate.type === 'NOT') out = bits[0] === 1 ? 0 : 1;
            else out = bits.reduce((a, b) => a ^ b, 0);
            v[gate.id] = out;
            for (const pin of gate.out ?? ['out']) v[`${gate.id}:${pin}`] = out;
          }
          return v;
        }

        function paint() {
          // Gates are listed in wiring order, but a gate can feed another, so
          // evaluate in dependency order by running until nothing changes.
          let v = evaluate();
          for (let i = 0; i < wiring.gates.length; i += 1) v = { ...v, ...evaluate() };

          const on = (ref) => (ref in v ? v[ref] : v[src(ref)] ?? 0) === 1;

          root.querySelectorAll('[data-wire]').forEach((el) => {
            el.classList.toggle('lc-on', on(el.dataset.wire));
          });
          root.querySelectorAll('[data-input]').forEach((el) => {
            const lit = state[el.dataset.input] === 1;
            el.classList.toggle('lc-on', lit);
            el.setAttribute('aria-pressed', String(lit));
          });
          root.querySelectorAll('[data-output]').forEach((el) => {
            el.classList.toggle('lc-on', on(el.dataset.output));
          });
          root.querySelectorAll('[data-value]').forEach((el) => {
            el.textContent = String(on(el.dataset.value) ? 1 : 0);
          });

          const row = wiring.inputs.reduce((acc, n) => (acc << 1) | state[n], 0);
          document.dispatchEvent(
            new CustomEvent('logic-circuit-change', {
              detail: { id: wiring.id, row, values: { ...state } },
            })
          );
        }

        root.querySelectorAll('[data-input]').forEach((el) => {
          const toggle = () => {
            state[el.dataset.input] ^= 1;
            paint();
          };
          el.addEventListener('click', toggle);
          el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggle();
            }
          });
        });

        paint();
      })();
    </script>
  )
}

<style>
  /* Light is the base; the two dark cases below are the only overrides, matching
     how the site's tokens are arranged. */
  .logic-circuit-figure {
    --lc-ink: var(--diagram-ink, #2b2620);
    --lc-dim: #b9b1a2;
    --lc-fill: var(--color-bg, #fdfcfa);
    --lc-on: #1a6b3c;
    --lc-on-glow: #2ecc71;
    --lc-pin-fill: #f4f1ea;
  }

  :global(:root[data-theme='dark']) .logic-circuit-figure {
    --lc-ink: var(--diagram-ink, #e8e2d6);
    --lc-dim: #5a5347;
    --lc-fill: #1f1c19;
    --lc-on: #2ecc71;
    --lc-on-glow: #2ecc71;
    --lc-pin-fill: #262320;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .logic-circuit-figure {
      --lc-ink: var(--diagram-ink, #e8e2d6);
      --lc-dim: #5a5347;
      --lc-fill: #1f1c19;
      --lc-on: #2ecc71;
      --lc-on-glow: #2ecc71;
      --lc-pin-fill: #262320;
    }
  }

  .logic-circuit-figure {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
    overflow-x: auto;
  }

  .logic-circuit-svg {
    max-width: 100%;
    height: auto;
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .lc-wire {
    stroke: var(--lc-dim);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .lc-wire.lc-on {
    stroke: var(--lc-on);
    stroke-width: 2.5;
  }

  .lc-shape {
    fill: var(--lc-fill);
    stroke: var(--lc-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .lc-xor-arc {
    fill: none;
  }

  .lc-gate-name {
    fill: var(--lc-ink);
    font-size: 11px;
    dominant-baseline: middle;
  }

  .lc-pin circle {
    fill: var(--lc-pin-fill);
    stroke: var(--lc-dim);
    stroke-width: 2;
  }

  .lc-pin.lc-on circle {
    fill: var(--lc-on);
    stroke: var(--lc-on);
  }

  .lc-pin-name {
    fill: var(--lc-ink);
    font-size: 12px;
    font-weight: 600;
    dominant-baseline: middle;
  }

  .lc-pin-value {
    fill: var(--lc-ink);
    font-size: 10px;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .lc-pin.lc-on .lc-pin-value {
    fill: var(--lc-fill);
  }

  .lc-pin.lc-live {
    cursor: pointer;
  }

  .lc-pin.lc-live:hover circle {
    stroke: var(--lc-on-glow);
  }

  .lc-pin.lc-live:focus {
    outline: none;
  }

  .lc-pin.lc-live:focus-visible circle {
    stroke: var(--lc-on-glow);
    stroke-width: 3;
  }

  .lc-hint {
    margin: var(--space-2, 0.5rem) 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted, #6b6355);
  }

  .logic-circuit-caption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-muted, #6b6355);
    max-width: 44rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lc-wire,
    .lc-pin circle {
      transition: stroke 120ms ease, fill 120ms ease;
    }
  }
</style>
