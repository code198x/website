---
import ByteLessonTable from './ByteLessonTable.astro';
import RegisterBits from './RegisterBits.astro';
import { byteBits, hex, ulaOutput } from '../../lib/byte-lesson-examples';

const { afterSet, border, fields, port, speakerBit } = ulaOutput;
const borderBits = border.toString(2).padStart(3, '0');
const rows = fields.map(({ from, to, label }): [string, string, string] => {
  const width = from - to + 1;
  const value = (afterSet >>> to) & ((1 << width) - 1);
  return [from === to ? String(from) : `${from}–${to}`, label, value.toString(2).padStart(width, '0')];
});
---

<div class="register-diagram">
  <RegisterBits
    address={hex(port)}
    name="ULA output byte"
    fields={fields}
    value={afterSet}
    caption={`Example write: \`${byteBits(afterSet)}\` sets speaker bit ${speakerBit}. The border bits are \`${borderBits}\` (red); the MIC bit and the three unused bits are all zero.`}
  />
</div>
<div class="register-table">
  <ByteLessonTable columns={['Bits', 'Use', 'Value']} rows={rows}>
    {hex(port)} ULA output byte. The example write is {byteBits(afterSet)}; border {borderBits} is red.
  </ByteLessonTable>
</div>

<style>@layer blocks {
  .register-table { display: none; }

  /* The diagram's eight labels shrink together. Use the same fields in
     readable text rather than asking phone readers to zoom. */
  @media (max-width: 540px) {
    .register-diagram { display: none; }
    .register-table { display: block; }
  }
}
</style>
