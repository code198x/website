---
interface Props {
  columns: [string, string, string];
  rows: [string, string, string][];
}

const { columns, rows } = Astro.props;
---

<table class="byte-lesson-table">
  <caption><slot /></caption>
  <thead>
    <tr>{columns.map((label) => <th scope="col">{label}</th>)}</tr>
  </thead>
  <tbody>
    {rows.map(([label, left, right]) => (
      <tr>
        <th scope="row">{label}</th>
        <td>{left}</td>
        <td>{right}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>@layer blocks {
  .byte-lesson-table {
    width: 100%;
    margin-block: var(--h-space-4) var(--h-space-6);
    border-collapse: collapse;
    text-align: left;
    font: var(--h-text-small)/var(--h-lh-small) var(--h-font-mono);
  }

  .byte-lesson-table caption {
    margin-bottom: var(--h-space-2);
    color: var(--h-ink-muted);
    font-family: var(--h-font-ui);
    text-align: left;
  }

  .byte-lesson-table :is(th, td) {
    padding: var(--h-space-2);
    border-bottom: 1px solid var(--h-line);
  }

  .byte-lesson-table thead { background: var(--h-ground); }
}
</style>
