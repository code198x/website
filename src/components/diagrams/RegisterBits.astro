---
/**
 * RegisterBits - Visualise an 8-bit hardware register as labelled cells
 *
 * Works across platforms:
 *   C64:     <RegisterBits address="$D015" name="Sprite Enable" bits={[{index: 0, label: "Spr 0", active: true}]} />
 *   Amiga:   <RegisterBits address="$DFF096" name="DMACON" bits={[...]} />
 *   Spectrum: <RegisterBits address="$FE" name="Border/Ear/Mic" bits={[...]} />
 *
 * Grouped bit-fields (multi-bit values packed into one byte) render as
 * coloured spans with a labelled band beneath, place values (4 2 1)
 * inside multi-bit fields, and value digits tinted per field:
 *   <RegisterBits address="$5800+…" name="The attribute byte"
 *     fields={[
 *       { from: 7, to: 7, label: "FLASH" },
 *       { from: 5, to: 3, label: "PAPER 0-7" },
 *     ]}
 *     value={0x0f} />
 */

interface BitInfo {
  index: number;
  label: string;
  active?: boolean;
  activeLow?: boolean;
}

interface FieldInfo {
  from: number;   // high bit index of the field
  to: number;     // low bit index of the field
  label: string;
  color?: string; // override the palette
}

interface Props {
  address: string;
  name?: string;
  bits?: BitInfo[];
  fields?: FieldInfo[];
  value?: number;
  caption?: string;
  accentColor?: string;
}

const {
  address,
  name,
  bits = [],
  fields = [],
  value,
  caption,
  accentColor = 'var(--register-accent)',
} = Astro.props;

// Build a lookup from bit index to BitInfo
const bitMap = new Map<number, BitInfo>();
for (const bit of bits) {
  bitMap.set(bit.index, bit);
}

// Field palette (dark-background friendly) and per-bit field lookup
// Fields are told apart by hue; darker on paper, unchanged on the dark ground.
const FIELD_COLORS = ['var(--register-field-1)', 'var(--register-field-2)', 'var(--register-field-3)', 'var(--register-field-4)', 'var(--register-field-5)'];
const fieldList = fields.map((f, i) => ({
  ...f,
  color: f.color ?? FIELD_COLORS[i % FIELD_COLORS.length],
}));
const fieldMap = new Map<number, (typeof fieldList)[number]>();
for (const f of fieldList) {
  for (let b = f.to; b <= f.from; b++) fieldMap.set(b, f);
}
const hasFields = fieldList.length > 0;

// Layout constants
const CELL_W = 58;
const CELL_H = 32;
const GAP = 3;
const PADDING_X = 14;
const PADDING_TOP = 8;

// Row positions
const headerY = PADDING_TOP;
const headerH = 20;
const indexY = headerY + headerH + 6;
const indexH = 14;
const cellY = indexY + indexH + 4;
const bandY = cellY + CELL_H + 6;
const bandH = hasFields ? 20 : 0;
const labelY = bandY + bandH + (hasFields ? 6 : 0);
const labelH = 14;
const valueY = value !== undefined ? labelY + labelH + 4 : labelY;
const valueH = value !== undefined ? 20 : 0;
const totalH = (value !== undefined ? valueY + valueH : labelY + labelH) + PADDING_TOP;

const gridW = 8 * (CELL_W + GAP) - GAP;
const totalW = gridW + PADDING_X * 2;

const cellX = (bitIdx: number) => PADDING_X + (7 - bitIdx) * (CELL_W + GAP);

// Determine bit value for display
function bitValue(index: number): number {
  if (value === undefined) return 0;
  return (value >> index) & 1;
}

const ariaLabel = name ? `${address} ${name} register` : `${address} register`;
import { inlineMarkdown } from '../../lib/inline-markdown';
---

<figure class="register-bits-figure">
  <svg
    viewBox={`0 0 ${totalW} ${totalH}`}
    class="register-bits-svg"
    role="img"
    aria-label={ariaLabel}
  >
    {/* Background */}
    <rect x="0" y="0" width={totalW} height={totalH} rx="0" fill="var(--diagram-bg)" />

    {/* Header: address + name */}
    <text
      x={totalW / 2}
      y={headerY + headerH / 2}
      text-anchor="middle"
      dominant-baseline="central"
      fill="var(--diagram-ink)"
      font-family="var(--font-family-mono, monospace)"
      font-size="13"
      font-weight="bold"
    >
      {name ? `${address} — ${name}` : address}
    </text>

    {/* Field bands beneath the cells */}
    {fieldList.map((f) => {
      const x = cellX(f.from);
      const w = (f.from - f.to + 1) * (CELL_W + GAP) - GAP;
      const oneBit = f.from === f.to;
      return (
        <g>
          <rect
            x={x}
            y={bandY}
            width={w}
            height={bandH}
            fill={f.color}
            fill-opacity="0.18"
            stroke={f.color}
            stroke-width="1"
          />
          {!oneBit && (
            <text
              x={x + w / 2}
              y={bandY + bandH / 2}
              text-anchor="middle"
              dominant-baseline="central"
              fill={f.color}
              font-family="var(--font-family-mono, monospace)"
              font-size="11"
              font-weight="bold"
            >
              {f.label}
            </text>
          )}
        </g>
      );
    })}

    {/* Bit cells (7 → 0, left to right) */}
    {Array.from({ length: 8 }, (_, i) => {
      const bitIdx = 7 - i;
      const info = bitMap.get(bitIdx);
      const field = fieldMap.get(bitIdx);
      const isLabelled = !!info;
      const isActive = info?.active ?? false;
      const isActiveLow = info?.activeLow ?? false;
      const x = cellX(bitIdx);
      const oneBitField = field && field.from === field.to;

      const cellFill = isActive
        ? accentColor
        : field
          ? field.color
          : isLabelled
            ? 'var(--register-cell-labelled)'
            : 'var(--register-cell-empty)';
      const cellFillOpacity = isActive ? 1 : field ? 0.18 : 1;

      const cellStroke = isActive
        ? accentColor
        : field
          ? field.color
          : isLabelled
            ? 'var(--diagram-rule)'
            : 'var(--register-cell-labelled)';

      // In-cell text: explicit bit label wins; a one-bit field shows its
      // label; a multi-bit field shows the bit's place value (4 2 1);
      // otherwise the bit index, dim.
      const cellText = isLabelled
        ? info!.label
        : field
          ? oneBitField
            ? field.label
            : String(1 << (bitIdx - field.to))
          : String(bitIdx);
      const cellTextFill = isActive
        ? 'var(--register-ink-on-accent)'
        : field
          ? field.color
          : isLabelled
            ? 'var(--diagram-ink)'
            : 'var(--diagram-ink-faint)';
      const cellTextSize = isLabelled || oneBitField ? '9' : '11';

      return (
        <g>
          {/* Bit index */}
          <text
            x={x + CELL_W / 2}
            y={indexY + indexH / 2}
            text-anchor="middle"
            dominant-baseline="central"
            fill={isLabelled || field ? 'var(--diagram-ink-dim)' : 'var(--diagram-ink-faint)'}
            font-family="var(--font-family-mono, monospace)"
            font-size="10"
          >
            {bitIdx}
          </text>

          {/* Cell */}
          <rect
            x={x}
            y={cellY}
            width={CELL_W}
            height={CELL_H}
            rx="0"
            fill={cellFill}
            fill-opacity={cellFillOpacity}
            stroke={cellStroke}
            stroke-width="1"
          />

          {/* Cell label */}
          <text
            x={x + CELL_W / 2}
            y={cellY + CELL_H / 2}
            text-anchor="middle"
            dominant-baseline="central"
            fill={cellTextFill}
            font-family="var(--font-family-mono, monospace)"
            font-size={cellTextSize}
            font-weight={oneBitField ? 'bold' : 'normal'}
          >
            {cellText}
          </text>

          {/* Label row (active-low marker or blank) */}
          {isActiveLow && (
            <text
              x={x + CELL_W / 2}
              y={labelY + labelH / 2}
              text-anchor="middle"
              dominant-baseline="central"
              fill="var(--register-warn)"
              font-family="var(--font-family-mono, monospace)"
              font-size="9"
            >
              active low
            </text>
          )}

          {/* Value row */}
          {value !== undefined && (
            <text
              x={x + CELL_W / 2}
              y={valueY + valueH / 2}
              text-anchor="middle"
              dominant-baseline="central"
              fill={bitValue(bitIdx) ? (field ? field.color : '#6f6') : '#666'}
              font-family="var(--font-family-mono, monospace)"
              font-size="12"
              font-weight="bold"
            >
              {bitValue(bitIdx)}
            </text>
          )}
        </g>
      );
    })}
  </svg>
  {caption && <figcaption class="register-bits-caption" set:html={inlineMarkdown(caption)} />}
</figure>

<style>
  .register-bits-figure {
    --register-accent: #3538c9;
    --register-field-1: #8a6413;
    --register-field-2: #1d6fa5;
    --register-field-3: #1a7f4b;
    --register-field-4: #7b3fa0;
    --register-field-5: #b3261e;
    --register-cell-labelled: #efece1;
    --register-cell-empty: #f7f5ee;
    --register-ink-on-accent: #fff;
    --register-warn: #b3261e;
    --register-on: #1a7f4b;
  }

  :global(:root[data-theme="dark"]) .register-bits-figure {
    --register-accent: #4a4dff;
    --register-field-1: #e0b341;
    --register-field-2: #5aa9e6;
    --register-field-3: #7bd88f;
    --register-field-4: #d78cf0;
    --register-field-5: #f2836b;
    --register-cell-labelled: #2b2419;
    --register-cell-empty: #16120e;
    --register-ink-on-accent: #fff;
    --register-warn: #f88;
    --register-on: #6f6;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .register-bits-figure {
      --register-accent: #4a4dff;
      --register-field-1: #e0b341;
      --register-field-2: #5aa9e6;
      --register-field-3: #7bd88f;
      --register-field-4: #d78cf0;
      --register-field-5: #f2836b;
      --register-cell-labelled: #2b2419;
      --register-cell-empty: #16120e;
      --register-ink-on-accent: #fff;
      --register-warn: #f88;
      --register-on: #6f6;
    }
  }

  .register-bits-figure {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  .register-bits-svg {
    max-width: 720px;
    width: 100%;
    height: auto;
    display: block;
  }

  .register-bits-caption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-secondary, #555);
    font-style: italic;
  }
</style>
