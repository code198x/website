---
/**
 * TraceTable - a program's values, pass by pass
 *
 * For the moment a unit stops describing what a program *is* and starts
 * describing what it *does over time*. Prose carries that badly: "the computer
 * runs it with i set to 1, then again with i set to 2, and so on up to 10" is a
 * table written as a sentence, and a learner who does not already hold the
 * model has to build it from the sentence. A screenshot does not help — it
 * shows the finished output, not the passes that produced it.
 *
 * A real <table>, not an SVG like its neighbours in this folder. The others
 * draw pictures; this is tabular data, so the table element gives it row and
 * column semantics for a screen reader, selectable text, and reflow on a narrow
 * screen. It borrows the family's dark ground and mono face so it still reads
 * as one of the diagrams.
 *
 * Usage — the caption is the default slot, so it can carry markdown:
 *   <TraceTable
 *     columns={['Pass', 'i', 'i * 7', 'Line 20 shows']}
 *     watch="i"
 *     rows={[
 *       ['1', '1', '7', '1 times 7 is 7'],
 *       ['…', '…', '…', '…'],
 *       ['10', '10', '70', '10 times 7 is 70'],
 *     ]}
 *   >
 *     Only `i` changes.
 *   </TraceTable>
 *
 * `watch` names the column holding the value the unit is tracing — the one the
 * reader should follow down the page. Give it the column's header text.
 */

interface Props {
  columns: string[];
  rows: string[][];
  /** Header text of the column to tint: the value being traced. */
  watch?: string;
}

const { columns, rows, watch } = Astro.props;

const watchIndex = watch ? columns.indexOf(watch) : -1;
if (watch && watchIndex === -1) {
  throw new Error(`TraceTable: watch="${watch}" is not one of the columns (${columns.join(', ')})`);
}

for (const [i, row] of rows.entries()) {
  if (row.length !== columns.length) {
    throw new Error(`TraceTable: row ${i} has ${row.length} cells, but there are ${columns.length} columns`);
  }
}

/** A row of ellipses stands for the passes not shown, and is not read out. */
const isElision = (row: string[]) => row.every((c) => c === '…' || c === '...');
---

<figure class="trace">
  <div class="scroll">
    <table>
      <thead>
        <tr>
          {columns.map((c, i) => (
            <th scope="col" class:list={[{ watch: i === watchIndex }]}>{c}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr aria-hidden={isElision(row) ? 'true' : undefined}>
            {row.map((cell, i) => (
              <td class:list={[{ watch: i === watchIndex, elision: isElision(row) }]}>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {Astro.slots.has('default') && (
    <figcaption><slot /></figcaption>
  )}
</figure>

<style>
  .trace {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
    max-width: 720px;
  }

  /* A wide trace scrolls inside its own box rather than the page. */
  .trace .scroll { overflow-x: auto; }

  /* Every rule below is prefixed so it outranks the layout's own
     `.unit-content :global(table|th|td)` rules, which otherwise win on source
     order and repaint this as an ordinary prose table. */
  .trace table {
    /* The diagram family's ground, so this sits with its neighbours rather
       than looking like a stray prose table. */
    background: #1a1714;
    border-collapse: collapse;
    width: 100%;
    margin: 0;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  /* A bare `thead` rule in the global sheet paints a gradient band, and
     `tbody tr:nth-child(2n)` stripes the body. Both are for prose tables. */
  .trace table thead,
  .trace table tbody tr,
  .trace table tr { background: transparent; }

  .trace table th,
  .trace table td {
    padding: 0.45rem 0.9rem;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #2b2419;
    white-space: nowrap;
  }

  /* Only the last column carries prose, and it is the one that may wrap. */
  .trace table th:last-child,
  .trace table td:last-child { white-space: normal; }

  .trace table th {
    color: #e0e0e0;
    font-weight: 700;
    border-bottom-color: #55493a;
  }

  .trace table td { color: #aaa; }

  .trace table tbody tr:last-child td { border-bottom: none; }

  /* The traced column: the one the reader follows down the page. */
  .trace table th.watch,
  .trace table td.watch { color: #e0b341; }

  /* Dim, but still legibly an ellipsis rather than an empty broken row. */
  .trace table td.elision { color: #7a6a54; }

  .trace figcaption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-secondary, #555);
    font-style: italic;
  }

  /* Captions carry code spans; keep them legible against the prose ground. */
  .trace figcaption :global(code) {
    font-family: var(--font-family-mono, monospace);
    font-style: normal;
  }

  @media (max-width: 520px) {
    .trace table { font-size: 0.74rem; }
    .trace table th,
    .trace table td { padding: 0.35rem 0.55rem; }
  }
</style>
