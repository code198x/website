---
import InlineMarkdown from './InlineMarkdown.astro';
import type { VaultFeatureSelection } from '../lib/vault-features';
interface Props {
  title: string;
  subtitle?: string;
  summary: string;
  category: { name: string; slug: string };
  reviewed: boolean;
  image?: VaultFeatureSelection['images'][number];
  imageDetailHref?: string;
}
const { title, subtitle, summary, category, reviewed, image, imageDetailHref } = Astro.props;
---
<header class:list={['vault-reading-header', { 'has-image': image }]}>
  <div class="vault-reading-intro">
    <h1>{title}</h1>
    {subtitle && <p class="vault-reading-subtitle">{subtitle}</p>}
    <div class="vault-reading-meta">
      <a href={`/vault/category/${category.slug}/`}>{category.name}</a>
      <a href="#article-status">{reviewed ? 'Source-checked' : 'Not yet fact-checked'}</a>
    </div>
    <p class="vault-reading-summary"><InlineMarkdown text={summary}/></p>
  </div>
  {image && <figure class="vault-opening-image" style={`--capture-width:${image.width}px`}>
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" />
    <figcaption>{image.caption} {imageDetailHref && <a href={imageDetailHref}>See how it happens</a>}</figcaption>
  </figure>}
</header>
