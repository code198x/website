---
/**
 * A page's source notes. Put ordinary Markdown paragraphs or lists in the slot.
 * Use once per page; set id only when preserving an existing citation anchor.
 */
interface Props {
  id?: string;
}
const { id = 'sources' } = Astro.props;
---
<section class="sources" aria-labelledby={id}>
  <h2 id={id}>Sources</h2>{' '}
  <div class="sources-content"><slot /></div>
</section>

<style>
  .sources {
    margin-block: var(--space-8, 2rem);
    font-family: var(--font-family-read);
    font-size: var(--h-text-small);
    line-height: 1.65;
    color: var(--color-text);
  }

  .sources h2 {
    display: inline;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    line-height: inherit;
    letter-spacing: normal;
    scroll-margin-top: 8rem;
  }

  .sources h2::after {
    content: ':';
  }

  .sources .sources-content {
    font-family: var(--font-family-read);
    display: inline;
    font-size: inherit;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .sources .sources-content :global(p),
  .sources .sources-content :global(ul),
  .sources .sources-content :global(ol) {
    font-size: inherit;
    line-height: inherit;
    margin-block: 0 1rem;
  }

  .sources .sources-content :global(p:first-child) {
    display: inline;
  }

  .sources .sources-content :global(p + p) {
    margin-top: 1rem;
  }

  .sources .sources-content :global(:last-child) {
    margin-bottom: 0;
  }
</style>
