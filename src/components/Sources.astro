---
/**
 * A page's source notes. Put ordinary Markdown paragraphs or lists in the slot.
 * Use once per page; set id only when preserving an existing citation anchor.
 *
 * The concept's sources block (lesson.html, .sources): set apart by a rule,
 * the label small, spaced and uppercase in the muted ink, the notes in
 * Literata at the small step. The label stays inline, as the unit
 * specification describes it ("a compact inline Sources label"); the concept
 * sets it on a line of its own, and the specification was kept because Vault
 * pages use this component too.
 */
interface Props {
  id?: string;
}
const { id = 'sources' } = Astro.props;
---
<section class="sources" aria-labelledby={id}>
  <h2 id={id}>Sources</h2>{' '}
  <div class="sources-content"><slot /></div>
</section>

<style>
  .sources {
    margin-block: calc(var(--h-cell) * 10) var(--space-8, 2rem);
    padding-top: calc(var(--h-cell) * 3);
    border-top: 1px solid var(--h-line);
    font-family: var(--h-font-read);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
    color: var(--h-ink-body);
  }

  /* Specific enough to beat a page's own heading rules (UnitLayout's h2). */
  .sources h2[id] {
    display: inline;
    margin: 0 0.6em 0 0;
    color: var(--h-ink-muted);
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    font-weight: 400;
    line-height: inherit;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    scroll-margin-top: 8rem;
  }

  .sources .sources-content {
    display: inline;
    font-family: var(--h-font-read);
    font-size: inherit;
    line-height: inherit;
    overflow-wrap: anywhere;
  }

  .sources .sources-content :global(p),
  .sources .sources-content :global(li) {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .sources .sources-content :global(p),
  .sources .sources-content :global(ul),
  .sources .sources-content :global(ol) {
    margin-block: 0 1rem;
  }

  .sources .sources-content :global(p:first-child) {
    display: inline;
  }

  .sources .sources-content :global(p + p) {
    margin-top: 1rem;
  }

  .sources .sources-content :global(:last-child) {
    margin-bottom: 0;
  }
</style>
