---
/**
 * Renders a string with basic inline markdown (italics and bold).
 * Use for summaries and other short text that may contain *italic* or **bold**.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;

// Process inline markdown: **bold** and *italic*
// Order matters: process bold first (double asterisks) before italic (single)
const html = text
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/\*([^*]+)\*/g, '<em>$1</em>');
---

<span class={className} set:html={html} />
