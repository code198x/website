---
/**
 * Renders a string carrying inline markdown — `code`, **bold**, *italic*.
 *
 * For text that arrives as a value rather than as markup: a Vault summary out of
 * frontmatter, and anywhere else a string has to reach the page as prose.
 * Components that take their own prose props call inlineMarkdown directly; this
 * wrapper is for call sites that need it around arbitrary text.
 *
 * The escaping lives in the helper, so a summary containing < or & is safe here.
 */
import { inlineMarkdown } from '../lib/inline-markdown';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<span class={className} set:html={inlineMarkdown(text)} />
