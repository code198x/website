---
export interface Step {
  number?: string | number;
  emoji?: string;
  title: string;
  description: string;
  action?: {
    text: string;
    href: string;
    color?: string;
  };
}

export interface Props {
  steps: Step[];
  variant?: "vertical" | "horizontal" | "workflow";
  showArrows?: boolean;
  class?: string;
}

const { steps, variant = "vertical", showArrows = true, class: className = "" } = Astro.props;
---

<div class={`journey journey--${variant} ${className}`}>
  {
    steps.map((step, index) => (
      <>
        <div class="journey__step">
          <div class="journey__step-number">{step.emoji || step.number}</div>
          <div class="journey__step-content">
            <h3 class="journey__step-title">{step.title}</h3>
            <p class="journey__step-description">{step.description}</p>
            {step.action && (
              <a
                href={step.action.href}
                class="journey__step-action"
                style={step.action.color ? `background: ${step.action.color}` : ""}
              >
                {step.action.text}
              </a>
            )}
          </div>
        </div>
        {showArrows && index < steps.length - 1 && (
          <div class="journey__arrow">
            {variant === "workflow" || variant === "horizontal" ? "→" : "↓"}
          </div>
        )}
      </>
    ))
  }
</div>
