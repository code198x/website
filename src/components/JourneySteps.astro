---
export interface Step {
  number: string | number;
  emoji?: string;
  title: string;
  description: string;
  action?: {
    text: string;
    href: string;
    color?: string;
  };
}

export interface Props {
  steps: Step[];
  variant?: "vertical" | "horizontal" | "workflow";
  showArrows?: boolean;
  class?: string;
}

const {
  steps,
  variant = "vertical",
  showArrows = true,
  class: className = "",
} = Astro.props;
---

<div class={`journey journey--${variant} ${className}`}>
  {steps.map((step, index) => (
    <>
      <div class="journey__step">
        <div class="journey__step-number">
          {step.emoji || step.number}
        </div>
        <div class="journey__step-content">
          <h3 class="journey__step-title">{step.title}</h3>
          <p class="journey__step-description">{step.description}</p>
          {step.action && (
            <a 
              href={step.action.href} 
              class="journey__step-action"
              style={step.action.color ? `background: ${step.action.color}` : ""}
            >
              {step.action.text}
            </a>
          )}
        </div>
      </div>
      {showArrows && index < steps.length - 1 && (
        <div class="journey__arrow">
          {variant === "horizontal" ? "→" : "↓"}
        </div>
      )}
    </>
  ))}
</div>

<style>
  /* Journey Block */
  .journey {
    margin-bottom: var(--space-4xl);
  }

  /* Vertical Layout (Default) */
  .journey--vertical {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Horizontal Layout */
  .journey--horizontal {
    display: flex;
    flex-direction: row;
    gap: var(--space-lg);
    align-items: flex-start;
    overflow-x: auto;
    padding-bottom: var(--space-md);
  }

  .journey--horizontal .journey__step {
    flex: 1;
    min-width: 250px;
  }

  /* Workflow Layout */
  .journey--workflow {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding: var(--space-2xl) 0;
    background: var(--bg-subtle);
    border-radius: 12px;
  }

  .journey--workflow .journey__step {
    flex: 0 0 auto;
    text-align: center;
  }

  .journey--workflow .journey__arrow {
    font-size: 2rem;
    color: rgba(139, 92, 246, 0.4);
  }

  /* Journey Step */
  .journey__step {
    display: flex;
    gap: var(--space-lg);
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: var(--space-lg);
    transition: all 0.3s ease;
    position: relative;
  }

  .journey__step:hover {
    box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.1);
    transform: translateY(-2px);
  }

  .journey--workflow .journey__step {
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.9);
    max-width: 150px;
  }

  /* Step Number */
  .journey__step-number {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--brand-blue);
    color: white;
    border-radius: 50%;
  }

  .journey--workflow .journey__step-number {
    width: 50px;
    height: 50px;
    font-size: 1.25rem;
  }

  /* Step Content */
  .journey__step-content {
    flex: 1;
  }

  .journey__step-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .journey--workflow .journey__step-title {
    font-size: 0.9rem;
    margin-bottom: var(--space-xs);
  }

  .journey__step-description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .journey--workflow .journey__step-description {
    font-size: 0.8rem;
    margin-bottom: 0;
  }

  /* Step Action */
  .journey__step-action {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background: var(--brand-green);
    color: white;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .journey__step-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }

  .journey--workflow .journey__step-action {
    display: none;
  }

  /* Arrow */
  .journey__arrow {
    text-align: center;
    font-size: 2rem;
    color: rgba(139, 92, 246, 0.3);
    line-height: 1;
    padding: var(--space-sm) 0;
  }

  /* Color Variants for Actions */
  .journey__step-action.purple {
    background: #8b5cf6;
  }

  .journey__step-action.pink {
    background: #ec4899;
  }

  .journey__step-action.blue {
    background: #3b82f6;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .journey--horizontal {
      flex-direction: column;
    }

    .journey--horizontal .journey__arrow {
      transform: rotate(90deg);
    }

    .journey--workflow {
      padding: var(--space-lg);
    }

    .journey__step {
      flex-direction: column;
      text-align: center;
    }

    .journey__step-number {
      margin: 0 auto;
    }
  }
</style>