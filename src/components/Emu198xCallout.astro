---
/**
 * Emu198xCallout — surfaces our sibling emulator project, Emu198x.
 *
 * Copy is deliberately honest about maturity: cores run headless + scriptable
 * today; the desktop frontend isn't polished and in-browser play is still to
 * come. Until then learners run their builds on Fuse / VICE / FS-UAE / FCEUX.
 * Source of truth: github.com/emu198x/emu198x README.
 *
 * Layout: a tinted identity panel (wordmark + cores + CTA) beside a prose
 * column with lead/status hierarchy. Mono wordmark, not script — Emu198x is a
 * tool name, so it belongs in the machine voice, not the display hand.
 */
const REPO = 'https://github.com/emu198x/emu198x';
const systems = ['ZX Spectrum', 'C64', 'NES', 'Amiga', 'Game Boy', 'Dragon 32'];
---

<section class="emu" id="emu198x">
  <div class="emu-id">
    <p class="eyebrow">Our own emulator</p>
    <p class="wordmark">Emu<span>198x</span></p>
    <p class="tag">Cycle-accurate · built in the open</p>
    <div class="cores">
      {systems.map(s => <span class="core">{s}</span>)}
    </div>
    <a class="btn btn-primary" href={REPO} rel="noopener">On GitHub →</a>
  </div>
  <div class="emu-prose">
    <p class="lede">Most emulators are black boxes you trust and forget. <b>Emu198x</b> is ours,
      and it's built in the open — a Rust project growing cycle-accurate cores that model each
      machine directly, down to the pins and the timing. When a hardware path isn't modelled
      well enough yet, it stays honestly incomplete rather than faking it — the same bar we
      hold the lessons to.</p>
    <p class="status">Today it runs <b>headless and scriptable</b>: boot a machine, run a build,
      grab a screenshot, inspect memory. A polished desktop app and <b>in-browser play</b> —
      embedded right in the lessons — are on the way. Until then, your code runs on Fuse, VICE
      and the other native emulators.</p>
  </div>
</section>

<style>
  .emu { border: 3px solid var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-chunky);
    display: grid; grid-template-columns: 0.82fr 1.18fr; align-items: stretch; }

  .emu-id { background: var(--color-house-tint); border-right: 3px solid var(--color-text);
    padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .wordmark { font-family: var(--font-family-mono); font-weight: 800; font-size: clamp(2.8rem, 4.6vw, 3.7rem);
    letter-spacing: -0.04em; line-height: 0.9; color: var(--color-text); margin: var(--space-1) 0; }
  .wordmark span { color: var(--color-house-2); }
  .tag { font-family: var(--font-family-mono); font-size: 0.68rem; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--color-text-secondary); margin: 0; }
  .cores { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-1); }
  .core { font-family: var(--font-family-mono); font-size: 0.6rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-secondary); border: 2px solid var(--color-border); background: var(--color-surface); padding: 3px 7px; }
  .emu-id .btn { margin-top: auto; align-self: flex-start; }

  .emu-prose { padding: var(--space-6); display: flex; flex-direction: column; justify-content: center; }
  .emu-prose .lede { font-size: 1.02rem; line-height: 1.6; margin: 0; color: var(--color-text); }
  .emu-prose .lede b { color: var(--color-house-2); }
  .emu-prose .status { font-size: 0.88rem; line-height: 1.55; color: var(--color-text-secondary); margin: var(--space-4) 0 0; }
  .emu-prose .status b { color: var(--color-text); }

  @media (max-width: 820px) {
    .emu { grid-template-columns: 1fr; }
    .emu-id { border-right: none; border-bottom: 3px solid var(--color-text); }
    .emu-prose { padding: var(--space-5); }
  }
</style>
