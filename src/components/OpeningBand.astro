---
/**
 * OpeningBand — a page's full-bleed illustrated opening, as one fixed band
 * (umbrella decisions/family-visual-identity.md §7, "A full-bleed opening is
 * a fixed band").
 *
 * The band is 416px tall from tablet width up, whatever the page width; the
 * art fills it about a focal point. On a phone it depends on `phone`:
 *   stacked — the heading sits above a 240px art band (from 1000px down, the
 *             heading leaves the art: at tablet width the band crops too
 *             tightly to keep the busy part of the art clear of it);
 *   overlay — a 320px band, the heading and overlays still on the art;
 *   tall    — a 400px band, for collages with portrait art.
 *
 * The default slot is a layer over the band and a size container, so callers
 * size and place their heading and overlays in cqh/cqw units and keep their
 * own heading styling. With `frame` (the default) the layer is the page's
 * content column; without it, the whole band. Content under the band goes in
 * the `below` slot.
 */
interface Art {
  src: string;
  srcset?: string;
  width: number;
  height: number;
}

interface Props {
  /** The id of the opening's heading; without one the band is decoration. */
  labelledby?: string;
  art: Art;
  /** Portrait art for narrow screens (700px and below). */
  phoneArt?: Art;
  /** The part of the art to keep in view, as an object-position. */
  focal?: string;
  phoneFocal?: string;
  phone?: 'stacked' | 'overlay' | 'tall';
  /** Place the layer in the page's content column rather than the whole band. */
  frame?: boolean;
  /** What the art shows; generated art needs no credit line. */
  caption?: string;
  class?: string;
}

const {
  labelledby,
  art,
  phoneArt,
  focal = 'center',
  phoneFocal,
  phone = 'stacked',
  frame = true,
  caption,
  class: className,
} = Astro.props;
const below = Astro.slots.has('below');
const Tag = labelledby ? 'section' : 'div';
---

<Tag
  class:list={['opening-band', 'masthead-frame', className]}
  data-phone={phone}
  aria-labelledby={labelledby}
  style={`--focal: ${focal}; --phone-focal: ${phoneFocal ?? focal};`}
>
  <div class="band">
    <picture class="band-art">
      {phoneArt && (
        <source media="(max-width: 700px)" srcset={phoneArt.srcset ?? phoneArt.src}
          sizes="100vw" width={phoneArt.width} height={phoneArt.height} />
      )}
      <img src={art.src} srcset={art.srcset} sizes="100vw" width={art.width} height={art.height}
        alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class:list={['band-layer', { 'band-framed': frame }]}><slot /></div>
  </div>
  {(caption || below) && (
    <div class="band-below">
      {caption && <p class="band-caption">{caption}</p>}
      <slot name="below" />
    </div>
  )}
</Tag>

<style>@layer blocks {
  .opening-band { background: var(--h-page); color: var(--h-ink); }
  .band { position: relative; isolation: isolate; overflow: hidden; height: 416px; }
  .band-art { position: absolute; inset: 0; z-index: -1; }
  .band-art, .band-art img { display: block; width: 100%; height: 100%; }
  .band-art img { object-fit: cover; object-position: var(--focal); }
  .band-layer { position: absolute; inset: 0; container-type: size; }
  .band-framed {
    box-sizing: border-box; width: 100%; max-width: var(--site-frame-width); margin-inline: auto;
    padding-inline: var(--page-gutter); display: grid; align-items: center; inset-inline: 0;
  }
  .band-below {
    box-sizing: border-box; max-width: var(--site-frame-width); margin: 0 auto;
    padding-inline: var(--page-gutter);
  }
  .band-caption {
    max-width: 90ch; margin: 0; padding-top: .75rem;
    font: italic .875rem/1.6 var(--h-font-ui); color: var(--h-ink-muted);
  }

  @media (max-width: 700px) {
    .band-art img { object-position: var(--phone-focal); }
  }
  @media (max-width: 1000px) {
    [data-phone='stacked'] .band { height: auto; overflow: visible; display: flex; flex-direction: column; }
    [data-phone='stacked'] .band-layer { position: relative; inset: auto; order: -1; container-type: inline-size; padding-block: 1.25rem 1rem; }
    [data-phone='stacked'] .band-art { position: relative; inset: auto; z-index: 0; height: 416px; }
  }
  @media (max-width: 600px) {
    [data-phone='stacked'] .band-art { height: 240px; }
    [data-phone='overlay'] .band { height: 320px; }
    [data-phone='tall'] .band { height: 400px; }
  }
}
</style>
