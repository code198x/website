---
/**
 * ComingSoon - Placeholder for content that's not yet available
 *
 * Usage:
 *   import ComingSoon from '@components/ComingSoon.astro';
 *   <ComingSoon title="Game 2: Space Patrol" />
 *   <ComingSoon title="AMOS Path" variant="compact" />
 *
 * Shows a friendly message indicating content is being developed.
 */

interface Props {
  title?: string;
  description?: string;
  variant?: 'full' | 'compact' | 'inline';
  platformColor?: string;
}

const {
  title = 'Coming Soon',
  description = "We're working on this content. Check back soon!",
  variant = 'full',
  platformColor
} = Astro.props;

const accentColor = platformColor || 'var(--color-primary)';
---

<div class={`coming-soon coming-soon--${variant}`} style={`--cs-accent: ${accentColor};`}>
  <div class="cs-icon">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polygon points="10 8 16 12 10 16 10 8"></polygon>
    </svg>
  </div>
  <h3 class="cs-title">{title}</h3>
  <p class="cs-description">{description}</p>
  <div class="cs-dots">
    <span></span>
    <span></span>
    <span></span>
  </div>
</div>

<style>
  .coming-soon {
    text-align: center;
    color: var(--color-text-secondary);
  }

  /* Full variant - for entire page sections */
  .coming-soon--full {
    padding: var(--space-16) var(--space-4);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 0;
    margin: var(--space-8) 0;
  }

  /* Compact variant - for cards or smaller areas */
  .coming-soon--compact {
    padding: var(--space-8) var(--space-4);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 0;
  }

  .coming-soon--compact .cs-icon svg {
    width: 32px;
    height: 32px;
  }

  .coming-soon--compact .cs-title {
    font-size: 1rem;
  }

  .coming-soon--compact .cs-description {
    font-size: 0.875rem;
  }

  /* Inline variant - for use within text */
  .coming-soon--inline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 0;
  }

  .coming-soon--inline .cs-icon {
    margin-bottom: 0;
  }

  .coming-soon--inline .cs-icon svg {
    width: 20px;
    height: 20px;
  }

  .coming-soon--inline .cs-title {
    font-size: 0.875rem;
    margin: 0;
  }

  .coming-soon--inline .cs-description,
  .coming-soon--inline .cs-dots {
    display: none;
  }

  .cs-icon {
    margin-bottom: var(--space-4);
  }

  .cs-icon svg {
    color: var(--cs-accent);
    opacity: 0.6;
  }

  .cs-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
  }

  .cs-description {
    margin: 0;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  /* Animated dots */
  .cs-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .cs-dots span {
    width: 8px;
    height: 8px;
    background: var(--cs-accent);
    border-radius: 50%;
    opacity: 0.3;
    animation: pulse 1.5s ease-in-out infinite;
  }

  .cs-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .cs-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.2);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .cs-dots span {
      animation: none;
      opacity: 0.5;
    }
  }
</style>
