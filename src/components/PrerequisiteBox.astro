---
export interface Props {
  system?: "commodore-64" | "zx-spectrum" | "nintendo-entertainment-system" | "amiga";
  lessonNumber?: number;
}

const { system = "commodore-64", lessonNumber = 1 } = Astro.props;

const systemInfo = {
  "commodore-64": {
    name: "Commodore 64",
    assembler: "ACME",
    emulator: "VICE",
    setupLink: "/setup/c64",
    icon: "💾",
  },
  "zx-spectrum": {
    name: "ZX Spectrum",
    assembler: "sjasmplus",
    emulator: "Fuse",
    setupLink: "/setup#zx-spectrum",
    icon: "🖥️",
  },
  "nintendo-entertainment-system": {
    name: "NES",
    assembler: "ca65",
    emulator: "FCEUX",
    setupLink: "/setup#nintendo-entertainment-system",
    icon: "🎮",
  },
  amiga: {
    name: "Amiga",
    assembler: "vasm",
    emulator: "FS-UAE",
    setupLink: "/setup#amiga",
    icon: "🎨",
  },
};

const info = systemInfo[system];
---

<div class="prerequisite-box">
  <div class="prerequisite-header">
    <span class="icon">{info.icon}</span>
    <strong>Before You Start</strong>
  </div>

  <div class="prerequisite-content">
    <p>To follow along with this lesson, you'll need:</p>
    <ul>
      <li><strong>{info.assembler}</strong> - Assembler for {info.name}</li>
      <li><strong>{info.emulator}</strong> - Emulator to run your programs</li>
      {
        lessonNumber === 1 && (
          <li>
            <strong>15 minutes</strong> - One-time setup
          </li>
        )
      }
    </ul>

    <div class="prerequisite-actions">
      <a href={info.setupLink} class="setup-link">
        🚀 Setup {info.name} Development Environment
      </a>
      {lessonNumber > 1 && <p class="already-setup">Already set up? Great! Let's continue...</p>}
    </div>
  </div>
</div>
