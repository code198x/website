---
export interface Props {
  system?: "commodore-64" | "zx-spectrum" | "nintendo-entertainment-system" | "amiga";
  lessonNumber?: number;
}

const { system = "commodore-64", lessonNumber = 1 } = Astro.props;

const systemInfo = {
  "commodore-64": {
    name: "Commodore 64",
    assembler: "ACME",
    emulator: "VICE",
    setupLink: "/setup/c64",
    icon: "💾",
  },
  "zx-spectrum": {
    name: "ZX Spectrum",
    assembler: "sjasmplus",
    emulator: "Fuse",
    setupLink: "/setup#zx-spectrum",
    icon: "🖥️",
  },
  "nintendo-entertainment-system": {
    name: "NES",
    assembler: "ca65",
    emulator: "FCEUX",
    setupLink: "/setup#nintendo-entertainment-system",
    icon: "🎮",
  },
  amiga: {
    name: "Amiga",
    assembler: "vasm",
    emulator: "FS-UAE",
    setupLink: "/setup#amiga",
    icon: "🎨",
  },
};

const info = systemInfo[system];
---

<div class="prerequisite-box">
  <div class="prerequisite-header">
    <span class="icon">{info.icon}</span>
    <strong>Before You Start</strong>
  </div>

  <div class="prerequisite-content">
    <p>To follow along with this lesson, you'll need:</p>
    <ul>
      <li><strong>{info.assembler}</strong> - Assembler for {info.name}</li>
      <li><strong>{info.emulator}</strong> - Emulator to run your programs</li>
      {
        lessonNumber === 1 && (
          <li>
            <strong>15 minutes</strong> - One-time setup
          </li>
        )
      }
    </ul>

    <div class="prerequisite-actions">
      <a href={info.setupLink} class="setup-link">
        🚀 Setup {info.name} Development Environment
      </a>
      {lessonNumber > 1 && <p class="already-setup">Already set up? Great! Let's continue...</p>}
    </div>
  </div>
</div>

<style>
  .prerequisite-box {
    background: var(--brand-blue);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
    color: white;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .prerequisite-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.2);
  }

  .prerequisite-header .icon {
    font-size: 1.5rem;
  }

  .prerequisite-content {
    font-size: 0.95rem;
  }

  .prerequisite-content p {
    margin: 0 0 0.75rem 0;
    opacity: 0.95;
  }

  .prerequisite-content ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .prerequisite-content li {
    padding: 0.25rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .prerequisite-content li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #68d391;
    font-weight: bold;
  }

  .prerequisite-actions {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .setup-link {
    display: inline-block;
    background: white;
    color: #764ba2;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .setup-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
  }

  .already-setup {
    margin-top: 1rem;
    font-size: 0.875rem;
    opacity: 0.9;
    font-style: italic;
  }
</style>
