---
export interface Props {
  system?: "commodore-64" | "sinclair-zx-spectrum" | "nintendo-entertainment-system" | "amiga";
  phase?: number;
  lessonNumber?: number;
}

const { system = "commodore-64", phase = 0, lessonNumber = 1 } = Astro.props;

const systemInfo = {
  "commodore-64": {
    name: "Commodore 64",
    assembler: "ACME",
    emulator: "VICE",
    setupLink: "/setup/c64",
    icon: "💾",
  },
  "sinclair-zx-spectrum": {
    name: "ZX Spectrum",
    assembler: "sjasmplus",
    emulator: "Fuse",
    setupLink: "/setup#sinclair-zx-spectrum",
    icon: "🖥️",
  },
  "nintendo-entertainment-system": {
    name: "NES",
    assembler: "ca65",
    emulator: "FCEUX",
    setupLink: "/setup#nintendo-entertainment-system",
    icon: "🎮",
  },
  amiga: {
    name: "Amiga",
    assembler: "vasm",
    emulator: "FS-UAE",
    setupLink: "/setup#amiga",
    icon: "🎨",
  },
};

const info = systemInfo[system];
---

<div class="prerequisite-box" data-system={system}>
  <div class="prerequisite-header">
    <span class="icon">{info.icon}</span>
    <strong>Before You Start</strong>
  </div>

  <div class="prerequisite-content">
    <p>To follow along with this lesson, you'll need:</p>
    <ul>
      {phase === 0 ? (
        <>
          <li><strong>{info.name} BASIC</strong> - Built-in programming language</li>
          <li><strong>{info.emulator}</strong> - Emulator to run your programs</li>
        </>
      ) : (
        <>
          <li><strong>{info.assembler}</strong> - Assembler for {info.name}</li>
          <li><strong>{info.emulator}</strong> - Emulator to run your programs</li>
        </>
      )}
      {
        lessonNumber === 1 && (
          <li>
            <strong>15 minutes</strong> - One-time setup
          </li>
        )
      }
    </ul>

    <div class="prerequisite-actions">
      <a href={info.setupLink} class="setup-link">
        🚀 Setup {info.name} Development Environment
      </a>
      {lessonNumber > 1 && <p class="already-setup">Already set up? Great! Let's continue...</p>}
    </div>
  </div>
</div>

<style>
  .prerequisite-box {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary, #1a1a2e) 0%,
      var(--color-bg-tertiary, #16213e) 100%
    );
    border: 2px solid var(--color-accent, #ff6b35);
    border-radius: var(--radius-md, 6px);
    margin: var(--space-xl, 2.5rem) 0;
    overflow: hidden;
    box-shadow:
      0 4px 20px rgba(255, 107, 53, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    position: relative;
  }

  .prerequisite-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(255, 107, 53, 0.03) 2px,
        rgba(255, 107, 53, 0.03) 4px
      );
    pointer-events: none;
  }

  .prerequisite-header {
    background: linear-gradient(
      90deg,
      var(--color-accent, #ff6b35) 0%,
      var(--color-accent-light, #ff8c69) 100%
    );
    padding: var(--space-sm, 1rem) var(--space-md, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--space-sm, 1rem);
    position: relative;
    overflow: hidden;
  }

  .prerequisite-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 16px,
        rgba(255, 255, 255, 0.08) 16px,
        rgba(255, 255, 255, 0.08) 17px
      );
    pointer-events: none;
  }

  .prerequisite-header .icon {
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm, 4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
  }

  .prerequisite-header strong {
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-lg, 1.125rem);
    font-weight: var(--font-weight-bold, 700);
    color: var(--color-text-on-accent, #ffffff);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .prerequisite-content {
    padding: var(--space-lg, 2rem);
    color: var(--color-text, #ffffff);
    position: relative;
    z-index: 1;
  }

  .prerequisite-content p {
    margin: 0 0 var(--space-md, 1.5rem) 0;
    color: var(--color-text-muted, #b0b0c0);
    font-size: var(--font-size-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: var(--font-weight-medium, 500);
  }

  .prerequisite-content ul {
    list-style: none;
    margin: 0 0 var(--space-lg, 2rem) 0;
    padding: 0;
  }

  .prerequisite-content li {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-sm, 1rem);
    padding: var(--space-sm, 1rem);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.4;
  }

  .prerequisite-content li::before {
    content: '▶';
    color: var(--color-accent, #ff6b35);
    margin-right: var(--space-sm, 1rem);
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .prerequisite-content li strong {
    color: var(--color-primary, #4a9eff);
    font-weight: var(--font-weight-bold, 700);
    text-shadow: 0 0 8px rgba(74, 158, 255, 0.3);
  }

  .prerequisite-actions {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-md, 1.5rem);
  }

  .setup-link {
    display: inline-block;
    background: linear-gradient(
      90deg,
      var(--color-primary, #4a9eff) 0%,
      var(--color-primary-dark, #3b82f6) 100%
    );
    color: var(--color-text-on-primary, #ffffff);
    text-decoration: none;
    padding: var(--space-sm, 1rem) var(--space-md, 1.5rem);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-weight: var(--font-weight-bold, 700);
    font-size: var(--font-size-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow:
      0 2px 8px rgba(74, 158, 255, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .setup-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    transition: left 0.5s ease;
  }

  .setup-link:hover {
    transform: translateY(-1px);
    box-shadow:
      0 4px 12px rgba(74, 158, 255, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .setup-link:hover::before {
    left: 100%;
  }

  .setup-link:active {
    transform: translateY(0);
  }

  .already-setup {
    margin-top: var(--space-sm, 1rem);
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-success, #10b981);
    font-style: italic;
    text-align: center;
  }

  /* System-specific color themes */
  .prerequisite-box[data-system="commodore-64"] {
    border-color: var(--c64-blue, #6c5ce7);
  }

  .prerequisite-box[data-system="commodore-64"] .prerequisite-header {
    background: linear-gradient(90deg, var(--c64-blue, #6c5ce7) 0%, var(--c64-light-blue, #a29bfe) 100%);
  }

  .prerequisite-box[data-system="sinclair-zx-spectrum"] {
    border-color: var(--zx-red, #e17055);
  }

  .prerequisite-box[data-system="sinclair-zx-spectrum"] .prerequisite-header {
    background: linear-gradient(90deg, var(--zx-red, #e17055) 0%, var(--zx-light-red, #fab1a0) 100%);
  }

  .prerequisite-box[data-system="nintendo-entertainment-system"] {
    border-color: var(--nes-red, #e84393);
  }

  .prerequisite-box[data-system="nintendo-entertainment-system"] .prerequisite-header {
    background: linear-gradient(90deg, var(--nes-red, #e84393) 0%, var(--nes-light-red, #fd79a8) 100%);
  }

  .prerequisite-box[data-system="amiga"] {
    border-color: var(--amiga-orange, #fdcb6e);
  }

  .prerequisite-box[data-system="amiga"] .prerequisite-header {
    background: linear-gradient(90deg, var(--amiga-orange, #fdcb6e) 0%, var(--amiga-light-orange, #f39c12) 100%);
  }

  /* Animation */
  .prerequisite-box {
    animation: prerequisiteGlow 4s ease-in-out infinite alternate;
  }

  @keyframes prerequisiteGlow {
    from {
      box-shadow:
        0 4px 20px rgba(255, 107, 53, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    to {
      box-shadow:
        0 4px 25px rgba(255, 107, 53, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
  }

  /* Dark mode adjustments */
  .dark-mode .prerequisite-box {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary, #0f0f1e) 0%,
      var(--color-bg-tertiary, #1a1a2e) 100%
    );
  }

  /* Responsive */
  @media (max-width: 640px) {
    .prerequisite-box {
      margin: var(--space-lg, 2rem) -var(--space-sm, 1rem);
      border-radius: 0;
      border-left: 4px solid var(--color-accent, #ff6b35);
      border-right: none;
      border-top: none;
      border-bottom: none;
    }

    .prerequisite-header {
      padding: var(--space-sm, 1rem);
      flex-direction: column;
      text-align: center;
      gap: var(--space-xs, 0.5rem);
    }

    .prerequisite-content {
      padding: var(--space-md, 1.5rem);
    }

    .prerequisite-content li {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .prerequisite-content li::before {
      margin-bottom: var(--space-xs, 0.5rem);
    }

    .setup-link {
      display: block;
      text-align: center;
      width: 100%;
    }
  }
</style>
