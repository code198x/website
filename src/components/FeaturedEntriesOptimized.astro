---
import VaultEntryCard from './VaultEntryCard.astro';

interface Props {
  title: string;
  subtitle?: string;
  entries: any[];
  maxEntries?: number;
  showMoreLink?: string;
  className?: string;
}

const {
  title,
  subtitle,
  entries,
  maxEntries = 6,
  showMoreLink,
  className = ""
} = Astro.props;

// Limit entries for display
const displayEntries = entries.slice(0, maxEntries);
---

{displayEntries.length > 0 && (
  <section class={`py-xl border-t ${className}`} style="background: linear-gradient(135deg, var(--color-background) 0%, var(--color-background-secondary) 100%);">
    <div class="container">
      <div class="text-center mb-xl">
        <h2 class="flex-center gap-sm text-2xl font-bold mb-sm">
          <span class="text-xl">⭐</span>
          {title}
        </h2>
        {subtitle && (
          <p class="text-lg mx-auto" style="color: var(--color-text-secondary); max-width: 600px; line-height: 1.5;">
            {subtitle}
          </p>
        )}
      </div>

      <div class="grid gap-lg mb-xl" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
        {displayEntries.map((entry) => (
          <VaultEntryCard
            entry={entry}
            variant="featured"
            maxTags={2}
            showYear={true}
          />
        ))}
      </div>

      {showMoreLink && (
        <div class="text-center">
          <a href={showMoreLink} class="featured-more-link inline-flex items-center gap-sm text-lg font-semibold px-lg py-md rounded-lg transition-all">
            View all entries →
          </a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* Only custom styles that can't be replaced with utilities */
  .featured-more-link {
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
    text-decoration: none;
  }

  .featured-more-link:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    section {
      padding-top: var(--space-lg) !important;
      padding-bottom: var(--space-lg) !important;
    }

    .grid {
      grid-template-columns: 1fr !important;
      gap: var(--space-md) !important;
    }
  }
</style>