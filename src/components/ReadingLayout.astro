---
/** Reading column and optional contents rail; page typography stays with the page. */
import TableOfContents from './TableOfContents.astro';
interface Props { id: string }
const { id } = Astro.props;
---
<div class="reading-layout">
  <div class="reading-body" id={id}><slot /></div>
  <aside class="reading-toc"><TableOfContents selector={`#${id}`} /></aside>
</div>
<style>
  .reading-layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: var(--space-12); align-items: start; }
  .reading-body { min-width: 0; }
  .reading-body > :global(section:first-child) { margin-top: 0; }
  .reading-toc { position: sticky; top: 7rem; }
  @media (max-width: 1100px) {
    .reading-layout { grid-template-columns: 1fr; }
    .reading-toc { display: none; }
  }
</style>
