---
/** Shared page geometry. Content owns its composition; this owns its frame. */
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'article' | 'section';
  class?: string;
  inset?: 'standard' | 'none';
  opening?: 'none' | 'compact' | 'standard';
  ending?: 'none' | 'standard' | 'large';
}
const { as: Tag = 'div', class: className, inset = 'standard', opening = 'standard', ending = 'standard', ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={['page-frame', className]} data-page-frame data-inset={inset} data-opening={opening} data-ending={ending}>
  <slot />
</Tag>
<style>
  .page-frame {
    display: flow-root;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--site-frame-width, 1264px);
    min-width: 0;
    margin-inline: auto;
    padding: 40px var(--page-gutter, clamp(16px, 2vw, 32px)) 64px;
  }
  .page-frame[data-inset='none'] { padding-inline: 0; }
  .page-frame[data-opening='compact'] { padding-top: 24px; }
  .page-frame[data-opening='none'] { padding-top: 0; }
  .page-frame[data-ending='none'] { padding-bottom: 0; }
  .page-frame[data-ending='large'] { padding-bottom: 96px; }
</style>
