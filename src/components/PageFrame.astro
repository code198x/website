---
/**
 * Shared page geometry: a Center at the site frame width with the page gutter.
 * Content owns its composition; this owns its frame.
 */
import type { HTMLAttributes } from 'astro/types';
import Center from './layout/Center.astro';
interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'article' | 'section';
  class?: string;
  inset?: 'standard' | 'none';
  opening?: 'none' | 'compact' | 'standard';
  ending?: 'none' | 'standard' | 'large';
}
const { as = 'div', class: className, inset = 'standard', opening = 'standard', ending = 'standard', ...attributes } = Astro.props;
---
<Center as={as} max="frame" gutters={inset === 'none' ? undefined : 'page'} {...attributes} class:list={['page-frame', className]} data-page-frame data-inset={inset} data-opening={opening} data-ending={ending}>
  <slot />
</Center>
<style>
  @layer composition {
  .page-frame {
    display: flow-root;
    width: 100%;
    min-width: 0;
    padding-block: 40px 64px;
  }
  .page-frame[data-opening='compact'] { padding-top: 24px; }
  .page-frame[data-opening='none'] { padding-top: 0; }
  .page-frame[data-ending='none'] { padding-bottom: 0; }
  .page-frame[data-ending='large'] { padding-bottom: 96px; }
  }
</style>
