---
/**
 * UnitSteps — "Unit 5 of 36" and a strip with one segment per unit in the
 * module: which are done, and which one you are reading. It sits at the right
 * of the breadcrumb bar; the strip shares a fixed width between the units.
 *
 * Completion is read from the same localStorage the completion control writes,
 * so a block is filled because the unit was marked done — not because it comes
 * earlier in the module than this one. That has to happen on the client: the
 * server has no idea what any given reader has finished.
 */

interface Props {
  unit: number;
  totalUnits: number;
  label: string;
  /** Every unit's path, in order, so each block can be looked up in storage. */
  unitPaths: string[];
}

const { unit, totalUnits, label, unitPaths } = Astro.props;
// "Unit 5 of 36" is shown; the rest of the label ("in Meteor Storm") is
// for screen readers, which the bar's trail already gives sighted readers.
const shown = `Unit ${unit} of ${totalUnits}`;
const rest = label.startsWith(shown) ? label.slice(shown.length) : '';
---

<div class="unit-progress">
  <span class="unit-progress-count">{shown}{rest && <span class="visually-hidden">{rest}</span>}</span>
  <div class="unit-steps" aria-hidden="true" style={`--units: ${totalUnits};`}>
    {Array.from({ length: totalUnits }, (_, i) => (
      <span
        class:list={['unit-step', { 'is-current': i + 1 === unit }]}
        data-unit-path={unitPaths[i]}
      />
    ))}
  </div>
</div>

<script>
  const STORAGE_KEY = 'code198x-progress';

  function paint() {
    let progress: Record<string, boolean> = {};
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      progress = stored ? JSON.parse(stored) : {};
    } catch {
      // A reader with storage unavailable sees position only, which is the
      // same thing they saw before this read anything.
      return;
    }

    document.querySelectorAll<HTMLElement>('.unit-step').forEach(step => {
      const path = step.dataset.unitPath;
      step.classList.toggle('is-done', Boolean(path && progress[path] === true));
    });
  }

  paint();
  window.addEventListener('progress-updated', paint);
</script>

<style>
  /* In the breadcrumb bar (umbrella identity §7): paper on ink, the unit being
     read in the page's spot ink. On a phone only the count shows. */
  .unit-progress { display: flex; align-items: center; gap: 12px; color: var(--h-page); font: 600 15px/1.2 var(--h-font-ui); white-space: nowrap; }
  .unit-steps { display: flex; gap: 2px; width: min(180px, calc(var(--units) * 10px)); }
  .unit-step { flex: 1; min-width: 2px; height: 8px; background: color-mix(in srgb, var(--h-page) 22%, transparent); }
  .unit-step.is-done { background: color-mix(in srgb, var(--h-page) 70%, transparent); }
  .unit-step.is-current { background: var(--h-spot); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 640px) {
    .unit-steps { display: none; }
    .unit-progress { font-size: 14px; }
  }
</style>
