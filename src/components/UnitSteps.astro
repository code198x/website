---
/**
 * UnitSteps — one block per unit in the module, marking where this one sits.
 *
 * Replaces a continuous bar plus a percentage. "9% of General Programming"
 * answers a question nobody asked; a row of blocks answers the one they did —
 * how many units there are, and which of them you are on.
 *
 * The blocks divide a fixed track rather than each taking a fixed width, so a
 * module of eleven and a module of thirty-two both fit the same space.
 */

interface Props {
  unit: number;
  totalUnits: number;
  label: string;
}

const { unit, totalUnits, label } = Astro.props;
---

<div
  class="unit-steps"
  role="progressbar"
  aria-valuenow={unit}
  aria-valuemin="0"
  aria-valuemax={totalUnits}
  aria-label={label}
>
  {Array.from({ length: totalUnits }, (_, i) => (
    <span
      class:list={[
        'unit-step',
        { 'is-done': i + 1 < unit, 'is-current': i + 1 === unit },
      ]}
    />
  ))}
</div>

<style>
  .unit-steps {
    display: flex;
    align-items: center;
    gap: 3px;
    flex: 0 1 14rem;
    min-width: 6rem;
  }

  .unit-step {
    flex: 1 1 0;
    min-width: 3px;
    height: 6px;
    border-radius: 1px;
    background: var(--color-border);
  }

  /* Units already behind you read as the same colour, dimmed; the current one
     is the only block at full strength. */
  .unit-step.is-done {
    background: var(--systemColor, var(--color-text-secondary));
    opacity: 0.4;
  }

  .unit-step.is-current {
    background: var(--systemColor, var(--color-text-secondary));
  }
</style>
