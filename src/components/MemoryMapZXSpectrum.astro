---
export interface Props {
  title?: string;
  highlightRegion?: string;
  showAddresses?: boolean;
  activeAddress?: string;
  spectrumModel?: "48k" | "128k";
}

const {
  title = "ZX Spectrum Memory Map",
  highlightRegion = "",
  showAddresses = true,
  activeAddress = "",
  spectrumModel = "48k",
} = Astro.props;

interface MemoryRegion {
  start: string;
  end: string;
  name: string;
  description: string;
  color: string;
  textColor: string;
  usage: string;
  model?: string;
}

const memoryRegions: MemoryRegion[] = [
  {
    start: "$0000",
    end: "$3FFF",
    name: "ROM",
    description: "System ROM - Operating system and BASIC (16KB)",
    color: "bg-red-600",
    textColor: "text-red-100",
    usage: "OS & BASIC interpreter",
  },
  {
    start: "$4000",
    end: "$47FF",
    name: "Screen Pixels",
    description: "Screen bitmap data - top third (2KB)",
    color: "bg-yellow-700",
    textColor: "text-yellow-50",
    usage: "Display data (rows 0-7)",
  },
  {
    start: "$4800",
    end: "$4FFF",
    name: "Screen Pixels",
    description: "Screen bitmap data - middle third (2KB)",
    color: "bg-yellow-600",
    textColor: "text-yellow-50",
    usage: "Display data (rows 8-15)",
  },
  {
    start: "$5000",
    end: "$57FF",
    name: "Screen Pixels",
    description: "Screen bitmap data - bottom third (2KB)",
    color: "bg-yellow-500",
    textColor: "text-yellow-50",
    usage: "Display data (rows 16-23)",
  },
  {
    start: "$5800",
    end: "$5AFF",
    name: "Color Attributes",
    description: "Screen color data (768 bytes)",
    color: "bg-orange-700",
    textColor: "text-orange-50",
    usage: "Color information",
  },
  {
    start: "$5B00",
    end: "$5BFF",
    name: "Printer Buffer",
    description: "System printer buffer (256 bytes)",
    color: "bg-purple-600",
    textColor: "text-purple-100",
    usage: "Printer data",
  },
  {
    start: "$5C00",
    end: "$5CBF",
    name: "System Variables",
    description: "BASIC and system variables (192 bytes)",
    color: "bg-blue-600",
    textColor: "text-blue-100",
    usage: "BASIC state",
  },
  {
    start: "$5CC0",
    end: "$FFFF",
    name: "User RAM",
    description: "Available for programs and data (~42KB)",
    color: "bg-green-600",
    textColor: "text-green-100",
    usage: "Programs & variables",
  },
];

const memoryRegions128k: MemoryRegion[] = [
  ...memoryRegions.slice(0, -1),
  {
    start: "$5CC0",
    end: "$7FFF",
    name: "User RAM (Bank 5)",
    description: "Main program area - always mapped",
    color: "bg-green-600",
    textColor: "text-green-100",
    usage: "Programs & data",
    model: "128k",
  },
  {
    start: "$8000",
    end: "$BFFF",
    name: "Paged RAM",
    description: "Switchable RAM banks (0,1,3,4,6,7)",
    color: "bg-green-500",
    textColor: "text-green-100",
    usage: "Bank-switched memory",
    model: "128k",
  },
  {
    start: "$C000",
    end: "$FFFF",
    name: "RAM Bank 2",
    description: "Always mapped RAM bank (16KB)",
    color: "bg-green-700",
    textColor: "text-green-100",
    usage: "Always available",
    model: "128k",
  },
];

const regions = spectrumModel === "128k" ? memoryRegions128k : memoryRegions;

function isHighlighted(region: MemoryRegion): boolean {
  if (!highlightRegion) return false;
  return (
    region.name.toLowerCase().includes(highlightRegion.toLowerCase()) ||
    region.description.toLowerCase().includes(highlightRegion.toLowerCase())
  );
}

function isActiveAddress(region: MemoryRegion): boolean {
  if (!activeAddress) return false;
  const addr = parseInt(activeAddress.replace("$", ""), 16);
  const start = parseInt(region.start.replace("$", ""), 16);
  const end = parseInt(region.end.replace("$", ""), 16);
  return addr >= start && addr <= end;
}

function calculateHeight(region: MemoryRegion): string {
  const start = parseInt(region.start.replace("$", ""), 16);
  const end = parseInt(region.end.replace("$", ""), 16);
  const size = end - start + 1;

  // Different scaling for better visualization
  if (size >= 16384) return "20%"; // 16KB+ regions
  if (size >= 8192) return "15%"; // 8KB regions
  if (size >= 2048) return "12%"; // 2KB regions
  if (size >= 768) return "8%"; // 768 byte regions
  return "6%"; // Small regions
}
---

<div class="bg-slate-900 rounded-lg p-6 border border-slate-700">
  <div class="flex justify-between items-center mb-4">
    <h3 class="memory-map-title text-lg font-bold text-green-400">{title}</h3>
    <div class="flex gap-2">
      <span
        class={`px-2 py-1 rounded text-xs font-mono ${spectrumModel === "48k" ? "bg-blue-600 text-white" : "bg-slate-600 text-slate-300"}`}
      >
        48K
      </span>
      <span
        class={`px-2 py-1 rounded text-xs font-mono ${spectrumModel === "128k" ? "bg-blue-600 text-white" : "bg-slate-600 text-slate-300"}`}
      >
        128K
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Memory Map Visualization -->
    <div class="bg-black rounded-lg p-4">
      <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">
        {spectrumModel === "48k" ? "48KB" : "128KB"} Address Space
      </h4>
      <div class="space-y-1">
        {
          regions.map((region) => (
            <div
              class={`
              ${region.color} ${region.textColor} 
              rounded p-2 border-2 transition-all duration-300
              ${isHighlighted(region) ? "border-yellow-400 ring-2 ring-yellow-400" : "border-transparent"}
              ${isActiveAddress(region) ? "border-red-400 ring-2 ring-red-400" : ""}
            `}
              style={`height: ${calculateHeight(region)}`}
            >
              <div class="flex justify-between items-center text-xs font-mono">
                <span class="font-bold">{region.name}</span>
                {showAddresses && (
                  <span>
                    {region.start}-{region.end}
                  </span>
                )}
              </div>
              <div class="text-xs opacity-75 mt-1">{region.description}</div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Memory Details -->
    <div class="space-y-4">
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Memory Overview</h4>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-400">Total Memory:</span>
            <span class="text-white font-mono">{spectrumModel === "48k" ? "48KB" : "128KB"}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Available RAM:</span>
            <span class="text-white font-mono">{spectrumModel === "48k" ? "~42KB" : "~112KB"}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Screen Memory:</span>
            <span class="text-white font-mono">6.75KB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">System ROM:</span>
            <span class="text-white font-mono">16KB</span>
          </div>
        </div>
      </div>

      <!-- Screen Memory Layout -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Screen Layout</h4>
        <div class="space-y-1 text-xs font-mono">
          <div class="flex justify-between">
            <span class="text-yellow-300">$4000-$47FF:</span>
            <span class="text-yellow-100">Top third (rows 0-7)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-yellow-300">$4800-$4FFF:</span>
            <span class="text-yellow-100">Middle third (rows 8-15)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-yellow-300">$5000-$57FF:</span>
            <span class="text-yellow-100">Bottom third (rows 16-23)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-orange-300">$5800-$5AFF:</span>
            <span class="text-orange-100">Color attributes</span>
          </div>
        </div>
      </div>

      <!-- Important Addresses -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Key Addresses</h4>
        <div class="space-y-1 text-xs font-mono">
          <div class="flex justify-between">
            <span class="text-blue-300">$5C00:</span>
            <span class="text-blue-100">BASIC variables</span>
          </div>
          <div class="flex justify-between">
            <span class="text-green-300">$8000:</span>
            <span class="text-green-100">Safe program start</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-300">$0000:</span>
            <span class="text-red-100">Restart vectors</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-300">$0066:</span>
            <span class="text-red-100">NMI routine</span>
          </div>
        </div>
      </div>

      {
        spectrumModel === "128k" && (
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">128K Banking</h4>
            <div class="space-y-1 text-xs">
              <div class="text-green-200">
                <strong>Bank 5:</strong> Always at $4000-$7FFF
              </div>
              <div class="text-green-200">
                <strong>Bank 2:</strong> Always at $C000-$FFFF
              </div>
              <div class="text-blue-200">
                <strong>Switchable:</strong> Banks 0,1,3,4,6,7 at $8000
              </div>
              <div class="text-purple-200">
                <strong>Control:</strong> Port $7FFD (bit 0-2)
              </div>
            </div>
          </div>
        )
      }

      <!-- Programming Tips -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Programming Notes</h4>
        <div class="space-y-2 text-xs">
          <div class="text-yellow-200">
            <strong>Screen:</strong> Interleaved layout, not linear
          </div>
          <div class="text-orange-200">
            <strong>Attributes:</strong> 8×8 blocks, ink/paper/bright/flash
          </div>
          <div class="text-green-200">
            <strong>RAM Start:</strong> $5B00+ for user programs
          </div>
          <div class="text-red-200">
            <strong>ROM Calls:</strong> Use RST instructions
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .memory-region {
    transition: all 0.3s ease;
  }

  .memory-region:hover {
    transform: scale(1.02);
    z-index: 10;
  }

  /* Override lesson content heading styles */
  .memory-map-title {
    color: rgb(74 222 128) !important; /* text-green-400 */
    font-size: 1.125rem !important; /* text-lg */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 1rem !important; /* mb-4 */
  }

  .memory-map-subtitle {
    color: rgb(209 213 219) !important; /* text-slate-300 */
    font-size: 0.875rem !important; /* text-sm */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 0.75rem !important; /* mb-3 */
  }

  /* Override strong text in memory map content */
  .bg-slate-800 strong,
  .bg-black strong {
    color: rgb(255 255 255) !important; /* text-white */
    font-weight: 700 !important;
  }
</style>
