---
import { getCollection } from 'astro:content';
import { ArrowDown } from '@lucide/astro';
import { constellationNodes as nodes, constellationEdges as edges, constellationThreads as threads } from '../data/vault-constellation';
interface Props { articles: number; subjects: number }
const { articles, subjects } = Astro.props;
const entries = await getCollection('vault');
for (const node of nodes) {
  if (node.entry && !entries.some(entry => entry.id === node.entry)) throw new Error(`Missing constellation entry: ${node.entry}`);
}
const nodeById = (id: string) => nodes.find(node => node.id === id)!;
---

<section class="vault-atlas masthead-frame" aria-labelledby="vault-title">
  <div class="vault-mast atlas-frame">
    <div class="atlas-navigation">
      <h1 id="vault-title">The Vault<span>.</span></h1>
      <div><p>People, machines, ideas.<br />Centuries of connections.</p>
      <a href="#vault-query">Search the Vault <ArrowDown size={18} aria-hidden="true" /></a></div>
    </div>
    <div class="constellation">
      <svg class="constellation-lines" viewBox="0 0 1200 800" preserveAspectRatio="none" aria-hidden="true">
        {edges.map(edge => {
          const from = nodeById(edge.from); const to = nodeById(edge.to);
          return <g><polyline points={`${from.x},${from.y} ${edge.x},${edge.y} ${to.x},${to.y}`} /></g>;
        })}
      </svg>
      <div class="constellation-labels" aria-hidden="true">{edges.map(edge => (
        <span style={`--x:${edge.x / 12}%;--y:${edge.y / 20}rem`}>{edge.label}</span>
      ))}</div>
      <ul class="constellation-nodes" aria-label="Subjects in the constellation">
        {nodes.map(node => (
          <li class:list={['constellation-node', { 'not-covered': !node.entry }]}
            style={`--x:${node.x / 12}%;--y:${node.y / 20}rem`}>
            <span class="node-name">{node.entry ? <a href={`/vault/${node.entry}/`}>{node.name}</a> : <span>{node.name}</span>}</span>
            <small>{node.kind}{!node.entry && ' · Not yet covered'}</small>
          </li>
        ))}
      </ul>
    </div>
    <div class="atlas-key">
      <p><span class="key-published">Linked names</span> open articles. <span class="key-future">Dashed names</span> are subjects still to cover.</p>
      <p>{articles.toLocaleString('en-GB')} articles / {subjects} subjects</p>
    </div>
    <details class="constellation-reading">
      <summary>Follow the connections and their sources</summary>
      <ol>{threads.map(thread => (
        <li id={`constellation-${thread.id}`}>
          <h2>{thread.title}</h2>
          <p class="thread-names">{thread.nodes.map((id, index) => {
            const node = nodeById(id);
            return <Fragment>{index > 0 && <span aria-hidden="true"> / </span>}{node.entry ? <a href={`/vault/${node.entry}/`}>{node.name}</a> : <span class="future-name">{node.name}<small>Not yet covered</small></span>}</Fragment>;
          })}</p>
          <p>{thread.text}</p>
          <a class="thread-source" href={thread.source}>{thread.sourceTitle}</a>
        </li>
      ))}</ol>
    </details>
  </div>
</section>

<style>
  .vault-atlas { background: var(--h-page); color: var(--h-ink); }
  .atlas-frame { box-sizing: border-box; max-width: var(--site-frame-width); margin: 0 auto; padding: 0 var(--page-gutter); container-type: inline-size; }
  .atlas-navigation { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 12px; }
  .atlas-navigation p { margin: 0; font-size: 1rem; font-weight: 600; }
  .atlas-navigation a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: inherit; font-weight: 600; text-underline-offset: 5px; }
  .constellation { position: relative; isolation: isolate; height: 40rem; }
  h1 { margin: 0; padding: 12px 0;
    font: italic 900 clamp(5rem, 12vw, 10rem)/1 var(--h-font-mag); letter-spacing: -.025em; }
  h1 span { color: var(--h-spot-ink); }
  .constellation-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  polyline { fill: none; stroke: var(--h-ink-muted); stroke-width: 1; }
  .constellation-labels span { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%);
    padding: 3px; background: var(--h-page); font: 600 .8125rem/1.3 var(--h-font-ui); white-space: nowrap; }
  .constellation-nodes { list-style: none; margin: 0; padding: 0; }
  .constellation-node { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%);
    width: max-content; max-width: 11.25rem; text-align: center; padding: 8px; background: var(--h-page); }
  .node-name { display: block; font-size: 1.4375rem; line-height: 1.12; font-weight: 700; text-wrap: balance; }
  .node-name a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .node-name a:hover { color: var(--h-spot-ink); }
  .not-covered .node-name { text-decoration: underline dashed; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .constellation-node small { display: block; margin-top: 9px; font-size: .8125rem; line-height: 1.5; font-weight: 600; color: var(--h-ink-muted); }
  .atlas-key { display: flex; justify-content: space-between; gap: 24px; padding-block: 12px; border-block: 1px solid var(--h-ink); font-size: .8125rem; font-weight: 600; line-height: 1.7; }
  .atlas-key p { margin: 0; }
  .atlas-key p:last-child { flex-shrink: 0; }
  .key-published { text-decoration: underline; text-underline-offset: 4px; }
  .key-future { text-decoration: underline dashed; text-underline-offset: 4px; }
  .constellation-reading { margin-top: 8px; }
  summary { cursor: pointer; width: fit-content; min-height: 44px; align-content: center; font-size: .875rem; font-weight: 600; }
  .constellation-reading ol { padding: 8px 0 24px; margin: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 36px 48px; }
  .constellation-reading h2 { font: italic 900 1.75rem/1.15 var(--h-font-mag); margin: 0 0 16px; }
  .constellation-reading li > p { max-width: 65ch; font-size: 1.0625rem; line-height: 1.6; margin: 12px 0; }
  .constellation-reading a { color: inherit; text-underline-offset: 4px; }
  .thread-names { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; }
  .thread-names a, .future-name { font-weight: 700; }
  .future-name { text-decoration: underline dashed; text-underline-offset: 4px; }
  .future-name small { display: block; font-size: .8125rem; font-weight: 600; color: var(--h-ink-muted); text-decoration: none; }
  .thread-source { display: inline-block; font-size: .875rem; line-height: 1.6; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--h-spot-ink); outline-offset: 5px; }
  @container (max-width: 70rem) {
    .atlas-navigation { flex-direction: column; align-items: flex-start; gap: 0; }
    .atlas-navigation p { font-size: .9375rem; }
    .constellation { height: auto; }
    h1 { font-size: clamp(4rem, 17vw, 7.5rem); margin: 0 0 12px; }
    .constellation-lines, .constellation-nodes, .constellation-labels { display: none; }
    .atlas-key { flex-direction: column; gap: 8px; }
    .constellation-reading ol { grid-template-columns: 1fr; gap: 28px; }
    .constellation-reading { margin-top: 8px; }
  }
</style>

<script>
  function adaptConstellation() {
    document.querySelectorAll<HTMLDetailsElement>('.constellation-reading').forEach(reading => {
      const frame = reading.closest<HTMLElement>('.atlas-frame')!;
      const compact = getComputedStyle(frame.querySelector('.constellation-nodes')!).display === 'none';
      if (reading.dataset.compact !== String(compact)) {
        reading.open = compact;
        reading.dataset.compact = String(compact);
      }
      if (!frame.dataset.observed) {
        frame.dataset.observed = 'true';
        new ResizeObserver(adaptConstellation).observe(frame);
      }
    });
  }
  adaptConstellation();
  document.addEventListener('astro:page-load', adaptConstellation);
</script>
