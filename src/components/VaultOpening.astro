---
import { ArrowDown } from '@lucide/astro';
interface Props { articles: number; subjects: number }
const { articles, subjects } = Astro.props;
---

<section class="vault-atlas masthead-frame" aria-labelledby="vault-title">
  <div class="collage-stage">
    <picture>
      <source media="(max-width: 700px)" srcset="/images/vault-opening/portrait-600.webp 600w, /images/vault-opening/portrait-1122.webp 1122w" sizes="100vw" width="1122" height="1402" />
      <img src="/images/vault-opening/landscape-2172.webp"
        srcset="/images/vault-opening/landscape-1280.webp 1280w, /images/vault-opening/landscape-2172.webp 2172w"
        sizes="100vw" width="2172" height="724" alt="" aria-hidden="true" fetchpriority="high" />
    </picture>
    <h1 id="vault-title"><span>The</span>{' '}<strong>Vault.</strong></h1>
  </div>
  <div class="vault-mast opening-reading">
    <p class="collage-caption">Computing’s human, technical and cultural histories, imagined as a collage. Original AI-generated illustration.</p>
    <div class="opening-tools">
      <p>{articles.toLocaleString('en-GB')} articles / {subjects} subjects</p>
      <a href="#vault-query">Search the Vault <ArrowDown size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .vault-atlas { background: var(--h-page); color: var(--h-ink); }
  .collage-stage { position: relative; isolation: isolate; overflow: hidden; width: 100%; max-width: 100%; min-width: 0; aspect-ratio: 3 / 1; min-height: 21.25rem; }
  picture, img { display: block; width: 100%; height: 100%; }
  picture { position: absolute; inset: 0; }
  img { object-fit: cover; }
  h1 { position: absolute; z-index: 1; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: .05em; margin: 0;
    font-family: var(--h-font-mag); font-style: italic; font-weight: 900; letter-spacing: -.025em;
    color: var(--h-ink); }
  h1 span { font-size: clamp(3rem, 5vw, 7rem); line-height: .95; }
  h1 strong { font: inherit; font-size: clamp(5rem, 11vw, 14rem); line-height: .95; }
  .opening-reading { box-sizing: border-box; max-width: var(--site-frame-width); margin: 0 auto; padding: 0 var(--page-gutter); }
  .collage-caption { margin: 0; padding-top: 12px; font-size: .875rem; line-height: 1.6;
    font-style: italic; color: var(--h-ink-muted); max-width: 90ch; }
  .opening-tools { display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding-top: 4px; font-size: .875rem; font-weight: 600; line-height: 1.6; }
  .opening-tools p { margin: 0; }
  .opening-tools a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px;
    color: inherit; text-underline-offset: 5px; }
  .opening-tools a:hover { color: var(--h-spot-ink); }
  a:focus-visible { outline: 2px solid var(--h-spot-ink); outline-offset: 5px; }
  @media (max-width: 700px) {
    .collage-stage { aspect-ratio: 4 / 5; min-height: 0; }
    h1 { justify-content: flex-start; padding-top: 48%; transform: translateX(-1%); }
    h1 span, h1 strong { -webkit-text-stroke: .035em var(--h-page); paint-order: stroke fill; }
    h1 span { font-size: clamp(2rem, 8vw, 4rem); }
    h1 strong { font-size: clamp(4rem, 20vw, 8.5rem); }
    .opening-tools { flex-wrap: wrap; gap: 0 16px; }
  }
</style>
