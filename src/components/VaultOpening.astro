---
import { ArrowDown } from '@lucide/astro';
import OpeningBand from './OpeningBand.astro';
interface Props { articles: number; subjects: number }
const { articles, subjects } = Astro.props;
---
<OpeningBand class="vault-atlas" labelledby="vault-title" phone="tall" frame={false}
  art={{ src: '/images/vault-opening/landscape-2172.webp', srcset: '/images/vault-opening/landscape-1280.webp 1280w, /images/vault-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }} phoneArt={{ src: '/images/vault-opening/portrait-600.webp', srcset: '/images/vault-opening/portrait-600.webp 600w, /images/vault-opening/portrait-1122.webp 1122w', width: 1122, height: 1402 }}
  caption="Computing’s human, technical and cultural histories, imagined as a collage.">
  <h1 id="vault-title"><span>The</span>{' '}<strong>Vault.</strong></h1>
  <div class="opening-tools" slot="below">
    <p>{articles.toLocaleString('en-GB')} articles / {subjects} subjects</p>
    <a href="#vault-query">Search the Vault <ArrowDown size={18} aria-hidden="true" /></a>
  </div>
</OpeningBand>

<style>@layer blocks {
  /* Sized from the band, so the title fits whatever the width. */
  h1 { position: absolute; z-index: 1; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: .05em; margin: 0;
    font-family: var(--h-font-mag); font-style: italic; font-weight: 900; letter-spacing: -.025em;
    color: var(--h-ink); }
  h1 span { font-size: min(clamp(3rem, 5cqw, 7rem), 18cqh); line-height: .95; }
  h1 strong { font: inherit; font-size: min(clamp(5rem, 11cqw, 14rem), 44cqh); line-height: .95; }
  .opening-tools { display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding-top: 4px; font-size: .875rem; font-weight: 600; line-height: 1.6; }
  .opening-tools p { margin: 0; }
  .opening-tools a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px;
    color: inherit; text-underline-offset: 5px; }
  .opening-tools a:hover { color: var(--h-spot-ink); }
  a:focus-visible { outline: 2px solid var(--h-spot-ink); outline-offset: 5px; }
  @media (max-width: 700px) {
    h1 { justify-content: flex-start; padding-top: 30cqh; }
    h1 span, h1 strong { -webkit-text-stroke: .035em var(--h-page); paint-order: stroke fill; }
    h1 span { font-size: clamp(2rem, 8cqw, 4rem); }
    h1 strong { font-size: min(clamp(4rem, 20cqw, 8.5rem), 30cqh); }
    .opening-tools { flex-wrap: wrap; gap: 0 16px; }
  }
}
</style>
