---
import { ArrowDownRight, ArrowRight } from '@lucide/astro';
import photographs from '../../public/images/systems-opening/provenance.json';
interface Props { articles: number; subjects: number }
const { articles, subjects } = Astro.props;
const photo = photographs.find(photo => photo.id === 'c64')!;
---

<section class="vault-atlas masthead-frame" aria-labelledby="vault-title">
  <div class="vault-mast atlas-frame">
    <div class="atlas-picture">
      <h1 id="vault-title">The{' '}<span>Vault.</span></h1>
      <img src="/images/systems-opening/c64-960.webp"
        srcset="/images/systems-opening/c64-480.webp 480w, /images/systems-opening/c64-960.webp 960w"
        sizes="(max-width: 650px) 80vw, 55vw" width="960" height="543"
        alt="Commodore 64 computer" />
      <a class="machine-link" href="/vault/systems/commodore-64/">Commodore 64 <ArrowDownRight size={22} aria-hidden="true" /></a>
    </div>
    <nav class="atlas-path" aria-label="Follow the C64 music connection">
      <a href="/vault/hardware/sid-chip/"><small>Its sound chip</small><strong>SID</strong><ArrowRight size={24} aria-hidden="true" /></a>
      <a href="/vault/people/rob-hubbard/"><small>A composer who used it</small><strong>Rob Hubbard</strong><ArrowRight size={24} aria-hidden="true" /></a>
      <a href="/vault/games/commando/"><small>One of his C64 soundtracks</small><strong>Commando</strong><ArrowRight size={24} aria-hidden="true" /></a>
    </nav>
    <div class="atlas-colophon">
      <p>{articles.toLocaleString('en-GB')} articles / {subjects} subjects. Explore the connections below.</p>
      <details>
        <summary>Photograph credit</summary>
        <p>Commodore 64 by {photo.author}. <a href={photo.source}>Public-domain source photograph</a>.
          Resized to WebP; arranged and blended into the page. Hardware details are unchanged.</p>
      </details>
    </div>
  </div>
</section>

<style>
  .vault-atlas { background: var(--h-page); color: var(--h-ink); }
  .atlas-frame { box-sizing: border-box; max-width: var(--site-frame-width); margin: 0 auto;
    padding: 0 var(--page-gutter); }
  .atlas-picture { position: relative; isolation: isolate; overflow: clip; background: var(--h-page); height: clamp(280px, 29vw, 420px); }
  h1 { position: relative; z-index: 2; width: fit-content; margin: 0; padding: 30px 0 0;
    font: italic 900 clamp(72px, 8vw, 120px)/.88 var(--h-font-mag); letter-spacing: -.025em; }
  h1 span { display: block; font-size: clamp(128px, 16vw, 224px); color: var(--h-spot-ink); }
  img { position: absolute; width: 57%; max-width: 740px; height: auto; right: 0; top: 0;
    mix-blend-mode: multiply; transform: rotate(-9deg); pointer-events: none; }
  .machine-link { position: absolute; right: 0; bottom: 22px; display: flex; align-items: center;
    gap: 12px; min-height: 44px; font-size: 1rem; font-weight: 700; color: inherit;
    text-decoration: underline; text-underline-offset: 5px; }
  .atlas-path { display: grid; grid-template-columns: 1fr 1.45fr 1.45fr; border-block: 1px solid var(--h-ink); }
  .atlas-path a { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 6px 12px;
    color: inherit; padding: 20px 24px; text-decoration: none; min-width: 0; }
  .atlas-path a:first-child { padding-left: 0; }
  .atlas-path a:last-child { padding-right: 0; }
  .atlas-path a + a { border-left: 1px solid var(--h-ink); }
  .atlas-path small { grid-column: 1 / -1; font: 600 .875rem/1.5 var(--h-font-ui); }
  .atlas-path strong { font: italic 900 clamp(28px, 3.3vw, 48px)/1.1 var(--h-font-mag); letter-spacing: -.015em; }
  .atlas-path a:hover strong { color: var(--h-spot-ink); text-decoration: underline; text-underline-offset: 5px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--h-spot-ink); outline-offset: 4px; }
  .atlas-colophon { display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    padding-top: 8px; font-size: .8125rem; font-weight: 600; line-height: 1.6; }
  .atlas-colophon p { margin: 0; }
  details { flex-basis: 220px; flex-shrink: 0; }
  summary { min-height: 44px; align-content: center; cursor: pointer; }
  details p { padding-bottom: 12px; font-weight: 400; }
  details a { color: inherit; text-underline-offset: 3px; }
  @media (max-width: 850px) {
    .atlas-picture { height: 290px; }
    img { width: 59%; right: -1%; top: 32px; }
    .atlas-path a { padding: 16px; }
    .atlas-path small { font-size: .8125rem; }
  }
  @media (max-width: 650px) {
    .atlas-picture { height: 280px; }
    h1 { padding-top: 24px; font-size: 64px; line-height: .9; }
    h1 span { font-size: clamp(100px, 24vw, 150px); }
    img { width: 78%; top: 105px; right: 0; transform: rotate(-9deg); }
    .machine-link { bottom: 0; font-size: .875rem; }
    .atlas-path { grid-template-columns: 1fr; }
    .atlas-path a, .atlas-path a:first-child, .atlas-path a:last-child { padding: 10px 0; column-gap: 8px;
      grid-template-columns: minmax(0, 1fr) auto; }
    .atlas-path a + a { border-left: 0; border-top: 1px solid var(--h-line); }
    .atlas-path small { grid-column: 1; }
    .atlas-path strong { grid-column: 1; grid-row: 2; font-size: 30px; }
    .atlas-path svg { grid-column: 2; grid-row: 1 / 3; }
    .atlas-colophon { flex-direction: column; gap: 0; }
    .atlas-colophon > p { padding-top: 8px; }
    details { flex-basis: auto; }
  }
</style>
