---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  badge?: {
    text: string;
    dotColor?: string;
  };
  variant?: "default" | "hero" | "centered" | "feature";
  level?: 1 | 2 | 3 | 4;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  badge,
  variant = "default",
  level = 2,
  class: className = "",
} = Astro.props;

const Heading = `h${level}` as any;
---

<div class={`section-header section-header--${variant} ${className}`}>
  {badge && (
    <div class="section-header__badge">
      {badge.dotColor && (
        <span 
          class="section-header__badge-dot" 
          style={`background-color: ${badge.dotColor};`}
        />
      )}
      {badge.text}
    </div>
  )}
  
  <Heading class="section-header__title">
    {title}
  </Heading>
  
  {subtitle && (
    <p class="section-header__subtitle">
      {subtitle}
    </p>
  )}
  
  {description && (
    <p class="section-header__description">
      {description}
    </p>
  )}
  
  <slot />
</div>

