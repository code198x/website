---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  badge?: {
    text: string;
    dotColor?: string;
  };
  variant?: "default" | "hero" | "centered" | "feature";
  level?: 1 | 2 | 3 | 4;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  badge,
  variant = "default",
  level = 2,
  class: className = "",
} = Astro.props;

const Heading = `h${level}` as any;
---

<div class={`section-header section-header--${variant} ${className}`}>
  {badge && (
    <div class="section-header__badge">
      {badge.dotColor && (
        <span 
          class="section-header__badge-dot" 
          style={`background-color: ${badge.dotColor};`}
        />
      )}
      {badge.text}
    </div>
  )}
  
  <Heading class="section-header__title">
    {title}
  </Heading>
  
  {subtitle && (
    <p class="section-header__subtitle">
      {subtitle}
    </p>
  )}
  
  {description && (
    <p class="section-header__description">
      {description}
    </p>
  )}
  
  <slot />
</div>

<style>
  .section-header {
    margin-bottom: var(--space-2xl);
  }

  /* Variants */
  .section-header--default {
    /* Default left-aligned */
  }

  .section-header--hero {
    text-align: center;
    margin-bottom: var(--space-4xl);
  }

  .section-header--centered {
    text-align: center;
  }

  .section-header--feature {
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  /* Badge */
  .section-header__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    background-color: var(--brand-amber);
    color: #78350f;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }

  .section-header--hero .section-header__badge {
    margin-bottom: var(--space-xl);
  }

  .section-header__badge-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-green);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Title */
  .section-header__title {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin: 0 0 var(--space-lg) 0;
  }

  h1.section-header__title {
    font-size: 2.5rem;
  }

  h2.section-header__title {
    font-size: 2rem;
  }

  h3.section-header__title {
    font-size: 1.5rem;
  }

  h4.section-header__title {
    font-size: 1.25rem;
  }

  .section-header--hero .section-header__title {
    font-size: 3rem;
    margin-bottom: var(--space-xl);
  }

  /* Subtitle */
  .section-header__subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin: 0 0 var(--space-lg) 0;
    line-height: 1.5;
  }

  .section-header--hero .section-header__subtitle {
    font-size: 1.5rem;
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-xl);
  }

  .section-header--feature .section-header__subtitle {
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Description */
  .section-header__description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .section-header--hero .section-header__description {
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.125rem;
  }

  .section-header--feature .section-header__description {
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Dark mode support */
  .section-header--dark .section-header__title {
    color: var(--text-inverse);
  }

  .section-header--dark .section-header__subtitle,
  .section-header--dark .section-header__description {
    color: rgba(255, 255, 255, 0.8);
  }

  /* Responsive */
  @media (max-width: 768px) {
    h1.section-header__title {
      font-size: 2rem;
    }

    h2.section-header__title {
      font-size: 1.75rem;
    }

    .section-header--hero .section-header__title {
      font-size: 2.25rem;
    }

    .section-header__subtitle {
      font-size: 1.125rem;
    }

    .section-header--hero .section-header__subtitle {
      font-size: 1.25rem;
    }
  }
</style>