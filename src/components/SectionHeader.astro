---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  badge?: {
    text: string;
    dotColor?: string;
  };
  variant?: "default" | "hero" | "centered" | "feature";
  level?: 1 | 2 | 3 | 4;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  badge,
  variant = "default",
  level = 2,
  class: className = "",
} = Astro.props;

const Heading = `h${level}` as any;
---

<div class={`section-header section-header--${variant} ${className}`}>
  {
    badge && (
      <div class="section-header__badge">
        {badge.dotColor && (
          <span class="section-header__badge-dot" style={`background-color: ${badge.dotColor};`} />
        )}
        {badge.text}
      </div>
    )
  }

  <Heading class="section-header__title">
    {title}
  </Heading>

  {subtitle && <p class="section-header__subtitle">{subtitle}</p>}

  {description && <p class="section-header__description">{description}</p>}

  <slot />
</div>

<style>
  .section-header {
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .section-header--centered {
    text-align: center;
  }

  .section-header__title {
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .section-header__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .section-header__description {
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .section-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-bg-secondary);
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .section-header__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  /* First section header on page should have less top margin */
  .section-header:first-of-type {
    margin-top: 2rem;
  }
</style>
