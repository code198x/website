---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  badge?: {
    text: string;
    color?: string;
  };
  actions?: Array<{
    text: string;
    href: string;
    variant?: "primary" | "secondary" | "outline";
    icon?: string;
  }>;
  variant?: "default" | "centered" | "gradient" | "compact";
  class?: string;
}

const {
  title,
  subtitle,
  description,
  badge,
  actions = [],
  variant = "default",
  class: className = "",
} = Astro.props;
---

<div class={`hero hero--${variant} ${className}`}>
  {badge && (
    <div class="hero__badge">
      <span class="hero__badge-dot" style={badge.color ? `background-color: ${badge.color}` : ""}></span>
      <span class="hero__badge-text">{badge.text}</span>
    </div>
  )}
  
  {subtitle && <p class="hero__subtitle">{subtitle}</p>}
  
  <h1 class="hero__title">{title}</h1>
  
  {description && <p class="hero__description">{description}</p>}
  
  {actions.length > 0 && (
    <div class="hero__actions">
      {actions.map((action) => (
        <a 
          href={action.href} 
          class={`hero__action hero__action--${action.variant || "primary"}`}
        >
          {action.icon && <span class="hero__action-icon">{action.icon}</span>}
          <span>{action.text}</span>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  /* Hero Block */
  .hero {
    margin-bottom: var(--space-4xl);
  }

  /* Hero Variants */
  .hero--default {
    text-align: left;
  }

  .hero--centered {
    text-align: center;
  }

  .hero--gradient {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: var(--space-3xl) var(--space-2xl);
    border-radius: 12px;
    text-align: center;
  }

  .hero--compact {
    margin-bottom: var(--space-2xl);
  }

  /* Hero Elements */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(139, 92, 246, 0.1);
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(139, 92, 246);
    margin-bottom: var(--space-lg);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .hero__badge-text {
    color: inherit;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .hero--gradient .hero__subtitle {
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .hero--gradient .hero__title {
    color: white;
  }

  .hero--compact .hero__title {
    font-size: 2.5rem;
  }

  .hero__description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 48rem;
    margin-bottom: var(--space-xl);
  }

  .hero--centered .hero__description {
    margin-left: auto;
    margin-right: auto;
  }

  .hero--gradient .hero__description {
    color: rgba(255, 255, 255, 0.95);
  }

  /* Hero Actions */
  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
  }

  .hero--centered .hero__actions {
    justify-content: center;
  }

  .hero__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: var(--space-sm) var(--space-lg);
    border-radius: 6px;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero__action--primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .hero__action--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.25);
  }

  .hero__action--secondary {
    background: white;
    color: #764ba2;
    border: 2px solid #764ba2;
  }

  .hero__action--secondary:hover {
    background: rgba(139, 92, 246, 0.05);
  }

  .hero__action--outline {
    background: transparent;
    color: white;
    border: 2px solid white;
  }

  .hero__action--outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .hero__action-icon {
    font-size: 1.25rem;
  }

  /* Pulse Animation */
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>