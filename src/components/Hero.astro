---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  badge?: {
    text: string;
    color?: string;
  };
  actions?: Array<{
    text: string;
    href: string;
    variant?: "primary" | "secondary" | "outline";
    icon?: string;
  }>;
  variant?: "default" | "centered" | "gradient" | "compact";
  class?: string;
}

const {
  title,
  subtitle,
  description,
  badge,
  actions = [],
  variant = "default",
  class: className = "",
} = Astro.props;
---

<div class={`hero hero--${variant} ${className}`}>
  {badge && (
    <div class="hero__badge">
      <span class="hero__badge-dot" style={badge.color ? `background-color: ${badge.color}` : ""}></span>
      <span class="hero__badge-text">{badge.text}</span>
    </div>
  )}
  
  {subtitle && <p class="hero__subtitle">{subtitle}</p>}
  
  <h1 class="hero__title">{title}</h1>
  
  {description && <p class="hero__description" set:html={description} />}
  
  {actions.length > 0 && (
    <div class="hero__actions">
      {actions.map((action) => (
        <a 
          href={action.href} 
          class={`hero__action hero__action--${action.variant || "primary"}`}
        >
          {action.icon && <span class="hero__action-icon">{action.icon}</span>}
          <span>{action.text}</span>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  /* Hero Block - Minimal and clean */
  .hero {
    margin-bottom: var(--space-3xl);
  }

  /* Hero Variants */
  .hero--default {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .hero--centered {
    text-align: center;
  }

  .hero--gradient {
    background: linear-gradient(135deg, var(--retro-purple) 0%, var(--retro-blue) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    padding: var(--space-3xl) var(--space-2xl);
    border-radius: 12px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero--gradient::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero--compact {
    margin-bottom: var(--space-xl);
  }

  /* Hero Elements */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    margin-bottom: var(--space-lg);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .hero--default .hero__badge,
  .hero--centered .hero__badge,
  .hero--compact .hero__badge {
    background: var(--brand-amber);
    color: #78350f;
    border: 1px solid rgba(120, 53, 15, 0.2);
    backdrop-filter: none;
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .hero__badge-text {
    color: inherit;
  }

  .hero__subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    font-weight: 500;
    line-height: 1.5;
    max-width: 56rem;
    text-wrap: balance;
  }
  
  .hero--default .hero__subtitle,
  .hero--centered .hero__subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .hero--gradient .hero__subtitle {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero--gradient .hero__title {
    color: white;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.15);
  }

  .hero--compact .hero__title {
    font-size: 2.5rem;
  }

  .hero__description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 56rem;
    margin-bottom: var(--space-xl);
    text-wrap: pretty;
    text-wrap: balance; /* Even better for shorter blocks */
  }

  .hero__description :global(code) {
    font-family: var(--font-mono);
    background: var(--bg-muted);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.95em;
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero--default .hero__description,
  .hero--centered .hero__description {
    margin-left: auto;
    margin-right: auto;
  }

  .hero--gradient .hero__description {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  /* Hero Actions */
  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
  }

  .hero--default .hero__actions,
  .hero--centered .hero__actions {
    justify-content: center;
  }

  .hero__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: var(--space-sm) var(--space-lg);
    border-radius: 6px;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero__action--primary {
    background: var(--brand-green);
    color: white;
  }

  .hero__action--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(34, 197, 94, 0.25);
    background: var(--color-green);
  }

  .hero--gradient .hero__action--primary {
    background: white;
    color: var(--retro-purple);
    font-weight: 700;
  }

  .hero--gradient .hero__action--primary:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(255, 255, 255, 0.3);
  }

  .hero__action--secondary {
    background: var(--brand-blue);
    color: white;
  }

  .hero__action--secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.25);
  }

  .hero--gradient .hero__action--secondary {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
  }

  .hero--gradient .hero__action--secondary:hover {
    background: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(255, 255, 255, 0.2);
  }

  .hero__action--outline {
    background: transparent;
    color: var(--text-primary);
    border: 2px solid var(--border-color);
  }

  .hero__action--outline:hover {
    background: var(--bg-subtle);
    border-color: var(--brand-blue);
  }

  .hero--gradient .hero__action--outline {
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.4);
  }

  .hero--gradient .hero__action--outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.7);
    transform: translateY(-2px);
  }

  .hero__action-icon {
    font-size: 1.25rem;
  }

  /* Pulse Animation */
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Dark Mode Styles */
  :global(.dark-mode) .hero__title {
    color: white;
  }

  :global(.dark-mode) .hero__subtitle {
    color: rgba(255, 255, 255, 0.8);
  }

  :global(.dark-mode) .hero__description {
    color: rgba(255, 255, 255, 0.7);
  }

  :global(.dark-mode) .hero__description :global(code) {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  :global(.dark-mode) .hero__badge {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  :global(.dark-mode) .hero__action--primary {
    background: var(--retro-purple);
    color: white;
  }

  :global(.dark-mode) .hero__action--primary:hover {
    background: #7c3aed;
  }

  :global(.dark-mode) .hero__action--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  :global(.dark-mode) .hero__action--secondary:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  :global(.dark-mode) .hero__action--outline {
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
  }

  :global(.dark-mode) .hero__action--outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }
</style>