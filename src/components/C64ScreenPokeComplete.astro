    44: 44,
    45: 45,
    46: 46,
    47: 47,
    58: 58,
    59: 59,
    60: 60,
    61: 61,
    62: 62,
    63: 63,
    64: 0, // @ symbol
  };

  class C64ScreenSimulator {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d");
      this.screenMemory = new Uint8Array(1000); // 40x25 characters
      this.colorMemory = new Uint8Array(1000);
      this.charsetMode = 0; // 0 = uppercase/graphics, 1 = lowercase/uppercase
      this.currentColor = 14; // Light blue default

      // C64 colors (authentic palette)
      this.colors = [
        "#000000", // 0: Black
        "#FFFFFF", // 1: White
        "#880000", // 2: Red
        "#AAFFEE", // 3: Cyan
        "#CC44CC", // 4: Purple
        "#00CC55", // 5: Green
        "#0000AA", // 6: Blue
        "#EEEE77", // 7: Yellow
        "#DD8855", // 8: Orange
        "#664400", // 9: Brown
        "#FF7777", // 10: Light Red
        "#333333", // 11: Dark Gray
        "#777777", // 12: Gray
        "#AAFF66", // 13: Light Green
        "#0088FF", // 14: Light Blue
        "#BBBBBB", // 15: Light Gray
      ];

      this.clear();
    }

    clear() {
      this.ctx.fillStyle = this.colors[6]; // Blue background
      this.ctx.fillRect(0, 0, 320, 200);

      // Initialize with spaces
      this.screenMemory.fill(32);
      this.colorMemory.fill(14); // Light blue text
      this.refresh();
    }

    poke(address, value, color = null) {
      if (address >= 1024 && address <= 2023) {
        const offset = address - 1024;
        this.screenMemory[offset] = value;
        if (color !== null) {
          this.colorMemory[offset] = color;
        }
        this.drawCharacter(offset);
        return true;
      }
      return false;
    }

    drawCharacter(offset) {
      const x = (offset % 40) * 8;
      const y = Math.floor(offset / 40) * 8;
      const charCode = this.screenMemory[offset];
      const color = this.colorMemory[offset];

      // Handle reversed characters (128-255)
      const isReversed = charCode >= 128;
      const baseCode = charCode & 0x7f; // Remove reverse bit

      // Get character data
      const charset = this.charsetMode === 0 ? PETSCII_UPPER : PETSCII_UPPER; // For now, only uppercase
      let charData = charset[baseCode];

      // Fall back to space if character not defined
      if (!charData) {
        charData = charset[32]; // Space
      }

      // Draw background
      this.ctx.fillStyle = isReversed ? this.colors[color] : this.colors[6];
      this.ctx.fillRect(x, y, 8, 8);

      // Draw character
      this.ctx.fillStyle = isReversed ? this.colors[6] : this.colors[color];

      for (let row = 0; row < 8; row++) {
        const byte = charData[row];
        for (let col = 0; col < 8; col++) {
          if (byte & (1 << (7 - col))) {
            this.ctx.fillRect(x + col, y + row, 1, 1);
          }
        }
      }
    }

    refresh() {
      for (let i = 0; i < 1000; i++) {
        this.drawCharacter(i);
      }
    }

    writeText(text, startAddr = 1024) {
      let addr = startAddr;
      for (let i = 0; i < text.length && addr <= 2023; i++) {
        const charCode = text.charCodeAt(i);
        const petsciiCode = ASCII_TO_PETSCII[charCode] || 32; // Default to space
        this.poke(addr, petsciiCode, this.currentColor);
        addr++;
      }
    }
  }

  // Add remaining 128-255 (reversed characters) - these are generated programmatically
  for (let i = 128; i < 256; i++) {
    const baseCode = i - 128;
    if (PETSCII_UPPER[baseCode]) {
      PETSCII_UPPER[i] = PETSCII_UPPER[baseCode]; // Reversed drawing handled in drawCharacter
    }
  }

  // Initialize simulator when DOM is ready
  document.addEventListener("DOMContentLoaded", () => {
    const canvas = document.getElementById("c64-screen");
    const sim = new C64ScreenSimulator(canvas);

    // Handle POKE button
    document.getElementById("poke-btn").addEventListener("click", () => {
      const addr = parseInt(document.getElementById("address").value);
      const val = parseInt(document.getElementById("value").value);
      const color = parseInt(document.getElementById("color-select").value);

      sim.currentColor = color;

      if (sim.poke(addr, val, color)) {
        document.getElementById("mem-info").textContent =
          `POKE ${addr},${val} | Color: ${color} | Char Set: ${sim.charsetMode === 0 ? "UPPER/GFX" : "LOWER/UPPER"}`;
      } else {
        document.getElementById("mem-info").textContent =
          `Invalid address! Use 1024-2023 for screen memory`;
      }
    });

    // Handle clear button
    document.getElementById("clear-btn").addEventListener("click", () => {
      sim.clear();
      document.getElementById("mem-info").textContent = "Screen cleared";
    });

    // Handle charset toggle
    document.getElementById("charset-toggle").addEventListener("change", (e) => {
      sim.charsetMode = e.target.checked ? 1 : 0;
      sim.refresh();
      document.getElementById("mem-info").textContent =
        `Char Set: ${sim.charsetMode === 0 ? "UPPER/GFX" : "LOWER/UPPER"}`;
    });

    // Handle color selection
    document.getElementById("color-select").addEventListener("change", (e) => {
      sim.currentColor = parseInt(e.target.value);
    });

    // Handle text input
    document.getElementById("text-btn").addEventListener("click", () => {
      const text = document.getElementById("text-input").value;
      const addr = parseInt(document.getElementById("address").value);
      sim.writeText(text, addr);
      document.getElementById("mem-info").textContent = `Wrote "${text}" at address ${addr}`;
    });

    // Handle example buttons
    document.querySelectorAll(".examples button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const addr = parseInt(btn.dataset.addr);
        const val = parseInt(btn.dataset.val);
        document.getElementById("address").value = addr;
        document.getElementById("value").value = val;
        document.getElementById("poke-btn").click();
      });
    });
  });
</script>
