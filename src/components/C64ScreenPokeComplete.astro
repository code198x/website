---
// Complete C64 screen memory visualizer with full PETSCII character set
---

<div class="c64-screen-poker">
  <div class="controls">
    <h3>C64 Screen Memory Explorer - Complete Edition</h3>
    <p>Full PETSCII character set with all 256 screen codes!</p>

    <div class="poke-input">
      <label>
        POKE
        <input type="number" id="address" min="1024" max="2023" value="1024" />
        ,
        <input type="number" id="value" min="0" max="255" value="1" />
      </label>
      <button id="poke-btn">POKE!</button>
      <button id="clear-btn">CLEAR SCREEN</button>
    </div>

    <div class="charset-controls">
      <label>
        <input type="checkbox" id="charset-toggle" />
        Lowercase/Uppercase Mode (default: Uppercase/Graphics)
      </label>
      <label>
        Color:
        <select id="color-select">
          <option value="0">Black</option>
          <option value="1">White</option>
          <option value="2">Red</option>
          <option value="3">Cyan</option>
          <option value="4">Purple</option>
          <option value="5">Green</option>
          <option value="6">Blue</option>
          <option value="7">Yellow</option>
          <option value="8">Orange</option>
          <option value="9">Brown</option>
          <option value="10">Light Red</option>
          <option value="11">Dark Gray</option>
          <option value="12">Gray</option>
          <option value="13">Light Green</option>
          <option value="14" selected>Light Blue</option>
          <option value="15">Light Gray</option>
        </select>
      </label>
    </div>

    <div class="examples">
      <button data-addr="1024" data-val="8">POKE 1024,8 (H)</button>
      <button data-addr="1024" data-val="5">POKE 1024,5 (E)</button>
      <button data-addr="1024" data-val="12">POKE 1024,12 (L)</button>
      <button data-addr="1024" data-val="15">POKE 1024,15 (O)</button>
      <button data-addr="1024" data-val="160">POKE 1024,160 (Reversed Space)</button>
      <button data-addr="1024" data-val="77">POKE 1024,77 (Vertical Line)</button>
      <button data-addr="1024" data-val="102">POKE 1024,102 (Full Block)</button>
      <button data-addr="1024" data-val="81">POKE 1024,81 (Circle)</button>
    </div>

    <div class="text-input">
      <label>
        Type text:
        <input type="text" id="text-input" placeholder="Type to see PETSCII conversion" />
      </label>
      <button id="text-btn">Write Text</button>
    </div>
  </div>

  <div class="screen-display">
    <canvas id="c64-screen" width="320" height="200"></canvas>
    <div class="memory-info">
      <span id="mem-info">Screen Memory: $0400-$07E7 | Char Set: UPPER/GFX</span>
    </div>
  </div>
</div>

<style>
  .c64-screen-poker {
    background: #3e31a2; /* C64 blue */
    border: 4px solid #7c70da; /* C64 light blue */
    border-radius: 8px;
    padding: 1rem;
    font-family: "Courier New", monospace;
  }

  .controls {
    background: #352879; /* C64 dark blue */
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .controls h3 {
    color: #7c70da; /* C64 light blue */
    margin: 0 0 0.5rem 0;
  }

  .controls p {
    color: #b3a8f7; /* C64 lighter blue */
    margin: 0.5rem 0;
  }

  .poke-input {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 1rem 0;
  }

  .poke-input label {
    color: #fff;
    font-size: 1.2rem;
  }

  .poke-input input {
    width: 80px;
    padding: 0.25rem;
    background: #1a1a2e;
    color: #7ef39e; /* C64 green */
    border: 2px solid #7c70da;
    font-family: inherit;
  }

  #poke-btn,
  #clear-btn,
  #text-btn {
    padding: 0.5rem 1rem;
    background: #68d391; /* C64 green */
    color: #1a1a2e;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
  }

  #poke-btn:hover,
  #clear-btn:hover,
  #text-btn:hover {
    background: #7ef39e;
    transform: scale(1.05);
  }

  .charset-controls {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin: 1rem 0;
    color: #b3a8f7;
  }

  .charset-controls select {
    padding: 0.25rem;
    background: #1a1a2e;
    color: #7ef39e;
    border: 1px solid #7c70da;
  }

  .examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .examples button {
    padding: 0.25rem 0.5rem;
    background: #554d9b;
    color: #b3a8f7;
    border: 1px solid #7c70da;
    border-radius: 2px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .examples button:hover {
    background: #7c70da;
    color: #fff;
  }

  .text-input {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1rem;
  }

  .text-input label {
    color: #b3a8f7;
  }

  .text-input input {
    padding: 0.25rem;
    background: #1a1a2e;
    color: #7ef39e;
    border: 1px solid #7c70da;
    font-family: inherit;
  }

  .screen-display {
    position: relative;
    background: #000;
    padding: 1rem;
    border-radius: 4px;
  }

  #c64-screen {
    width: 100%;
    max-width: 640px;
    height: auto;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    border: 2px solid #7c70da;
  }

  .memory-info {
    margin-top: 0.5rem;
    color: #68d391;
    font-size: 0.875rem;
    text-align: center;
  }
</style>

