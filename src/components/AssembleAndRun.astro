---
/**
 * The write → assemble → run loop, in the page.
 *
 * Sits *after* a unit's build instructions, never instead of them: the local
 * toolchain is what the unit teaches, and this is a second way to try it. See
 * Code198x docs/decisions/lessons-assemble-in-the-page.md.
 *
 * The assembler is the same one the lesson tells the reader to install —
 * @asm198x/z80, producing the bytes `asm198x --tapbas` produces — so this is
 * the toolchain rather than a simulation of it. It is fetched on the first
 * assemble, not on page load, so a reader who never touches it pays nothing.
 *
 * Usage:
 *   <AssembleAndRun
 *     system="sinclair-zx-spectrum"
 *     src="sinclair-zx-spectrum/assembly/meet-the-machine/unit-01/border.asm"
 *   />
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  system: string;
  /** Path to the starting source, relative to the code-samples root. */
  src: string;
  /** Assembler dialect the course's sources are written in. */
  dialect?: string;
  /** Rows of source shown before the editor scrolls. */
  rows?: number;
}

const { system, src, dialect = 'pasmonext', rows = 16 } = Astro.props;

const codeSamplesPath =
  process.env.CODE_SAMPLES_PATH || path.resolve(process.cwd(), '../code-samples');

let source: string;
try {
  source = fs.readFileSync(path.join(codeSamplesPath, src), 'utf-8');
} catch {
  source = `; Could not load ${src}\n`;
  console.error(`AssembleAndRun: could not read "${src}" under ${codeSamplesPath}`);
}

// The tape's block header carries this, the way pasmo puts the output path
// there. It is what the machine prints while loading, so a reader sees a name
// they recognise rather than a path from someone else's disk.
const tapeName = path.basename(src).replace(/\.asm$/, '.tap');
---

<div class="sandbox" data-system={system} data-dialect={dialect} data-tape-name={tapeName}>
  <div class="sandbox-editor">
    <label class="sandbox-label" for={`src-${tapeName}`}>Your source</label>
    <textarea
      id={`src-${tapeName}`}
      class="sandbox-source"
      rows={rows}
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      wrap="off">{source}</textarea>
  </div>

  <div class="sandbox-machine">
    <canvas class="sandbox-screen" width="352" height="296" tabindex="0" aria-label="ZX Spectrum screen"></canvas>
    <div class="sandbox-controls">
      <button type="button" class="sandbox-run">Assemble and run</button>
      <button type="button" class="sandbox-revert" title="Put the original source back">Revert</button>
      <p class="sandbox-status" role="status">Edit the source, then assemble.</p>
    </div>
  </div>

  <!--
    Two outcomes, two boxes. A source that will not assemble and a program that
    assembled and then misbehaved are different problems with different fixes,
    and the unit's own "When it's wrong, see why" already tells them apart. One
    shared box said they were the same thing — and rendered an English sentence
    with `white-space: pre`, so it ran off the side rather than wrapping.
  -->
  <div class="sandbox-message sandbox-message--build" hidden>
    <p class="sandbox-message-label">The assembler refused it</p>
    <pre class="sandbox-diagnostics"></pre>
  </div>

  <div class="sandbox-message sandbox-message--run" hidden>
    <p class="sandbox-message-label">It assembled, then the machine did this</p>
    <p class="sandbox-verdict"></p>
  </div>
</div>

<script>
  import { SpectrumRunner, type Verdict } from '../lib/spectrum-runner';

  /**
   * What each verdict means, in the reader's terms rather than the machine's.
   *
   * These are the mistakes unit 1 warns about, which is the point: the reader
   * meets the explanation at the moment it applies to them, instead of in a
   * troubleshooting list they read before they had the problem.
   */
  const EXPLAIN: Record<Verdict['kind'], (verdict: Verdict) => string> = {
    'ran-off-the-end': (v) =>
      `Your program ran past its last instruction and is executing memory at $${(v as { pc: number }).pc
        .toString(16)
        .toUpperCase()
        .padStart(4, '0')} that nobody put anything in. That is what the halt and jr at the bottom prevent.`,
    'halted-forever': () =>
      'The machine halted with interrupts disabled, so nothing can wake it again. A halt on its own waits for the next interrupt; with interrupts off, none arrives.',
    reset: () =>
      'The machine restarted — your program jumped somewhere that sent it back to the beginning, and the Spectrum booted as if it had just been switched on.',
  };

  /** Loaded on the first assemble, never on page load. */
  let assembler: Promise<typeof import('@asm198x/z80')> | null = null;
  const loadAssembler = () =>
    (assembler ??= import('@asm198x/z80').then(async (module) => {
      await module.default();
      return module;
    }));

  for (const root of document.querySelectorAll<HTMLElement>('.sandbox')) {
    const source = root.querySelector<HTMLTextAreaElement>('.sandbox-source')!;
    const canvas = root.querySelector<HTMLCanvasElement>('.sandbox-screen')!;
    const runButton = root.querySelector<HTMLButtonElement>('.sandbox-run')!;
    const revert = root.querySelector<HTMLButtonElement>('.sandbox-revert')!;
    const status = root.querySelector<HTMLParagraphElement>('.sandbox-status')!;
    const buildBox = root.querySelector<HTMLElement>('.sandbox-message--build')!;
    const runBox = root.querySelector<HTMLElement>('.sandbox-message--run')!;
    const diagnostics = root.querySelector<HTMLPreElement>('.sandbox-diagnostics')!;
    const verdictText = root.querySelector<HTMLParagraphElement>('.sandbox-verdict')!;

    const dialect = root.dataset.dialect ?? 'pasmonext';
    const tapeName = root.dataset.tapeName ?? 'program.tap';
    const original = source.value;

    let runner: SpectrumRunner | null = null;

    const say = (message: string, state?: string) => {
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    /** The assembler's own output, kept monospace because its columns line up. */
    const showDiagnostics = (text: string | null) => {
      buildBox.hidden = text === null;
      diagnostics.textContent = text ?? '';
    };

    /** What the machine did, in prose, so it wraps like prose. */
    const showVerdict = (text: string | null) => {
      runBox.hidden = text === null;
      verdictText.textContent = text ?? '';
    };

    const clearMessages = () => {
      showDiagnostics(null);
      showVerdict(null);
    };

    // Only run while on screen: a page may hold several of these, and a
    // machine nobody can see should not be burning a core.
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.some((entry) => entry.isIntersecting);
      if (runner) runner.visible = visible;
    });
    observer.observe(root);

    async function assembleAndRun() {
      runButton.disabled = true;
      clearMessages();
      try {
        say('Assembling…');
        const asm = await loadAssembler();
        const text = source.value;

        const extentJson = asm.extent(dialect, text);
        const bytes = asm.tape(dialect, text, tapeName, 'tap');
        if (!bytes) {
          // `tape` returns null and leaves `assemble` to say why, so there is
          // one place to look for diagnostics rather than two.
          showDiagnostics(asm.assemble(dialect, text) ?? 'The source did not assemble.');
          say('Nothing to run.', 'error');
          return;
        }

        // A fresh machine every time. The Spectrum has no reset in this API,
        // and re-loading a tape into a machine that is already running the last
        // program would be loading into a running program — which is also how
        // a reader gets themselves out of having hung it. Disposed rather than
        // stopped, so the old one's memory goes with it.
        runner?.dispose();
        say('Loading…');
        runner = await SpectrumRunner.create(canvas, (message) => say(message, 'error'));
        runner.load(bytes, 'tape');

        // Watch what the reader's code does once it has control, so the page
        // can say why it stopped rather than offering a reset and moving on.
        if (extentJson) {
          runner.watch(JSON.parse(extentJson), (verdict) => {
            showVerdict(EXPLAIN[verdict.kind](verdict));
            say('Stopped running your program.', 'error');
          });
        }

        runner.visible = true;
        runner.wanted = true;

        say(`Running — ${bytes.length} bytes on tape.`);
        canvas.focus({ preventScroll: true });
      } catch (error) {
        say(`Could not run it: ${error}`, 'error');
      } finally {
        runButton.disabled = false;
      }
    }

    runButton.addEventListener('click', () => void assembleAndRun());
    revert.addEventListener('click', () => {
      source.value = original;
      clearMessages();
      say('Original source restored.');
    });
  }
</script>

<style>
  .sandbox {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 60rem) {
    .sandbox {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .sandbox-editor {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .sandbox-label {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary, #555);
  }

  .sandbox-source {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.8rem;
    line-height: 1.5;
    tab-size: 4;
    padding: 0.75rem;
    color: var(--color-code-text, #d4d4d4);
    background: var(--color-code-bg, #1e1e1e);
    border: 1px solid var(--color-border, #444);
    border-radius: 3px;
    resize: vertical;
    overflow: auto;
    min-width: 0;
  }

  .sandbox-source:focus-visible {
    outline: 2px solid var(--color-primary, #e0744a);
    outline-offset: 1px;
  }

  .sandbox-machine {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .sandbox-screen {
    display: block;
    width: 352px;
    max-width: 100%;
    height: auto;
    /* The machine's pixels are the point; do not let the browser blur them. */
    image-rendering: pixelated;
    background: #000;
    border: 1px solid var(--color-border, #444);
  }

  .sandbox-screen:focus-visible {
    outline: 2px solid var(--color-primary, #e0744a);
    outline-offset: 2px;
  }

  .sandbox-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .sandbox-controls button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    color: var(--color-text, #eee);
    background: var(--color-surface, #242019);
    border: 1px solid var(--color-border, #444);
    border-radius: 3px;
  }

  .sandbox-controls button:hover:not(:disabled) {
    border-color: var(--color-primary, #e0744a);
  }

  .sandbox-controls button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .sandbox-status {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary, #555);
  }

  .sandbox-status[data-state='error'] {
    color: var(--color-error, #c33);
  }

  /* Both messages span the editor and the machine, so a sentence has the
     width of the whole component to wrap in rather than the screen's column. */
  .sandbox-message {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.7rem 0.85rem;
    border-radius: 3px;
    border: 1px solid;
    /* A flex item will not shrink below its content by default, so a long
       diagnostic line pushed the box wider than the page instead of
       scrolling inside it. */
    min-width: 0;
  }

  .sandbox-message-label {
    margin: 0;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The source never became a program. Red: nothing ran. */
  .sandbox-message--build {
    border-color: var(--color-error, #c33);
    background: var(--color-error-muted, rgba(200, 50, 50, 0.08));
  }

  .sandbox-message--build .sandbox-message-label {
    color: var(--color-error, #c33);
  }

  /* Scoped through the parent deliberately. The site styles a `pre` inside a
     unit as a code block — `.unit-content pre` — which outranks a lone class
     and left this one dark text on a dark ground inside a red box. Naming both
     elements outranks it back. */
  .sandbox-message .sandbox-diagnostics {
    margin: 0;
    padding: 0;
    width: auto;
    max-width: 100%;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.75rem;
    line-height: 1.5;
    /* The assembler's columns line up; keep them, and scroll rather than wrap. */
    white-space: pre;
    overflow-x: auto;
    /* Same reason as the container: without this the pre sets the box's width
       from its longest line rather than scrolling within it. */
    min-width: 0;
    /* The site styles `pre` as a code block — a dark ground this box does not
       have, which left the text unreadable on the red one. */
    background: none;
    border: 0;
    color: var(--color-text, #eee);
  }

  /* The program ran. Amber: this is an outcome to read, not a build failure —
     and for a unit teaching against exactly these mistakes, it is the lesson. */
  .sandbox-message--run {
    border-color: var(--color-warning, #fbbf24);
    background: var(--color-warning-muted, rgba(251, 191, 36, 0.1));
  }

  .sandbox-message--run .sandbox-message-label {
    color: var(--color-warning, #a86800);
  }

  .sandbox-verdict {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 62ch;
    color: var(--color-text, #eee);
  }
</style>
