---
export interface Props {
  dataRegisters?: string[];
  addressRegisters?: string[];
  stackPointer?: string;
  programCounter?: string;
  statusRegister?: string;
  title?: string;
  showBeforeAfter?: boolean;
  beforeD0?: string;
  beforeD1?: string;
  beforeA0?: string;
  afterD0?: string;
  afterD1?: string;
  afterA0?: string;
}

const { 
  dataRegisters = ["00000000", "00000000", "00000000", "00000000", "00000000", "00000000", "00000000", "00000000"],
  addressRegisters = ["00000000", "00000000", "00000000", "00000000", "00000000", "00000000", "00000000", "00000000"],
  stackPointer = "00000000",
  programCounter = "00000000",
  statusRegister = "0000",
  title = "68000 Processor Registers",
  showBeforeAfter = false,
  beforeD0 = "00000000",
  beforeD1 = "00000000",
  beforeA0 = "00000000",
  afterD0 = dataRegisters[0],
  afterD1 = dataRegisters[1],
  afterA0 = addressRegisters[0]
} = Astro.props;

function formatHex32(value: string): string {
  return value.toUpperCase().padStart(8, '0');
}

function formatHex16(value: string): string {
  return value.toUpperCase().padStart(4, '0');
}

function getWordFromLong(value: string, isHigh: boolean): string {
  const longValue = parseInt(value, 16);
  if (isHigh) {
    return ((longValue >> 16) & 0xFFFF).toString(16).toUpperCase().padStart(4, '0');
  } else {
    return (longValue & 0xFFFF).toString(16).toUpperCase().padStart(4, '0');
  }
}

function getByteFromLong(value: string, bytePos: number): string {
  const longValue = parseInt(value, 16);
  const shift = (3 - bytePos) * 8;
  return ((longValue >> shift) & 0xFF).toString(16).toUpperCase().padStart(2, '0');
}
---

<div class="bg-slate-900 rounded-lg p-6 border border-slate-700">
  <h3 class="text-lg font-bold text-green-400 mb-4 text-center">{title}</h3>
  
  {showBeforeAfter ? (
    <!-- Before/After Comparison -->
    <div class="grid grid-cols-2 gap-6">
      <!-- Before State -->
      <div>
        <h4 class="text-sm font-bold text-slate-400 mb-3 text-center">BEFORE</h4>
        <div class="space-y-3">
          <div class="bg-blue-900 rounded p-3 border-2 border-blue-600">
            <div class="text-xs text-blue-300 font-mono">D0 (Data)</div>
            <div class="text-lg font-mono text-blue-100">${formatHex32(beforeD0)}</div>
            <div class="text-xs text-blue-400">{parseInt(beforeD0, 16)} decimal</div>
          </div>
          
          <div class="bg-purple-900 rounded p-3 border-2 border-purple-600">
            <div class="text-xs text-purple-300 font-mono">D1 (Data)</div>
            <div class="text-lg font-mono text-purple-100">${formatHex32(beforeD1)}</div>
            <div class="text-xs text-purple-400">{parseInt(beforeD1, 16)} decimal</div>
          </div>
          
          <div class="bg-orange-900 rounded p-3 border-2 border-orange-600">
            <div class="text-xs text-orange-300 font-mono">A0 (Address)</div>
            <div class="text-lg font-mono text-orange-100">${formatHex32(beforeA0)}</div>
            <div class="text-xs text-orange-400">{parseInt(beforeA0, 16)} decimal</div>
          </div>
        </div>
      </div>
      
      <!-- After State -->
      <div>
        <h4 class="text-sm font-bold text-slate-400 mb-3 text-center">AFTER</h4>
        <div class="space-y-3">
          <div class="bg-blue-900 rounded p-3 border-2 border-blue-400 ring-2 ring-blue-400">
            <div class="text-xs text-blue-300 font-mono">D0 (Data)</div>
            <div class="text-lg font-mono text-blue-100">${formatHex32(afterD0)}</div>
            <div class="text-xs text-blue-400">{parseInt(afterD0, 16)} decimal</div>
          </div>
          
          <div class="bg-purple-900 rounded p-3 border-2 border-purple-400 ring-2 ring-purple-400">
            <div class="text-xs text-purple-300 font-mono">D1 (Data)</div>
            <div class="text-lg font-mono text-purple-100">${formatHex32(afterD1)}</div>
            <div class="text-xs text-purple-400">{parseInt(afterD1, 16)} decimal</div>
          </div>
          
          <div class="bg-orange-900 rounded p-3 border-2 border-orange-400 ring-2 ring-orange-400">
            <div class="text-xs text-orange-300 font-mono">A0 (Address)</div>
            <div class="text-lg font-mono text-orange-100">${formatHex32(afterA0)}</div>
            <div class="text-xs text-orange-400">{parseInt(afterA0, 16)} decimal</div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <!-- Single State View -->
    <div class="space-y-6">
      <!-- Data Registers -->
      <div>
        <h4 class="text-sm font-bold text-blue-300 mb-3">Data Registers (D0-D7)</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {dataRegisters.map((register, index) => (
            <div class="bg-blue-900 rounded p-3 border-2 border-blue-600">
              <div class="text-xs text-blue-300 font-mono mb-1">D{index}</div>
              <div class="text-lg font-mono text-blue-100 mb-1">${formatHex32(register)}</div>
              <div class="text-xs text-blue-400">{parseInt(register, 16)} decimal</div>
              <div class="flex justify-between mt-2 text-xs">
                <span class="text-blue-500">Word: ${getWordFromLong(register, true)}.${getWordFromLong(register, false)}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Address Registers -->
      <div>
        <h4 class="text-sm font-bold text-orange-300 mb-3">Address Registers (A0-A7)</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {addressRegisters.map((register, index) => (
            <div class="bg-orange-900 rounded p-3 border-2 border-orange-600">
              <div class="text-xs text-orange-300 font-mono mb-1">A{index} {index === 7 ? '(SP)' : ''}</div>
              <div class="text-lg font-mono text-orange-100 mb-1">${formatHex32(register)}</div>
              <div class="text-xs text-orange-400">{parseInt(register, 16)} decimal</div>
              <div class="text-xs text-orange-500 mt-1">{index === 7 ? 'Stack Pointer' : 'Memory Address'}</div>
            </div>
          ))}
        </div>
      </div>
      
      <!-- System Registers -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-slate-800 rounded p-4 border border-slate-600">
          <div class="text-xs text-slate-400 font-mono mb-1">PC (Program Counter)</div>
          <div class="text-xl font-mono text-slate-200">${formatHex32(programCounter)}</div>
          <div class="text-xs text-slate-500">{parseInt(programCounter, 16)} decimal</div>
        </div>
        
        <div class="bg-slate-800 rounded p-4 border border-slate-600">
          <div class="text-xs text-slate-400 font-mono mb-1">SR (Status Register)</div>
          <div class="text-xl font-mono text-slate-200">${formatHex16(statusRegister)}</div>
          <div class="text-xs text-slate-500">Condition codes & system state</div>
        </div>
      </div>
    </div>
  )}
  
  <!-- 68000 Architecture Diagram -->
  <div class="mt-6 pt-4 border-t border-slate-700">
    <h4 class="text-sm font-bold text-slate-400 mb-3">68000 Register Architecture</h4>
    <div class="bg-black rounded p-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
        <div>
          <div class="text-green-400 mb-2">Data Size Support:</div>
          <div class="space-y-1">
            <div class="text-blue-300">.B (Byte): 8-bit operations</div>
            <div class="text-blue-300">.W (Word): 16-bit operations</div>
            <div class="text-blue-300">.L (Long): 32-bit operations</div>
          </div>
        </div>
        <div>
          <div class="text-green-400 mb-2">Register Usage:</div>
          <div class="space-y-1">
            <div class="text-blue-300">D0-D7: Arithmetic & Logic</div>
            <div class="text-orange-300">A0-A6: Memory Addressing</div>
            <div class="text-orange-300">A7: Stack Pointer (SP)</div>
          </div>
        </div>
        <div>
          <div class="text-green-400 mb-2">Address Space:</div>
          <div class="space-y-1">
            <div class="text-slate-300">16MB linear memory</div>
            <div class="text-slate-300">No segmentation</div>
            <div class="text-slate-300">32-bit addresses</div>
          </div>
        </div>
      </div>
      
      <!-- Sample register breakdown -->
      <div class="mt-4 pt-4 border-t border-slate-700">
        <div class="text-green-400 mb-2">Example: D0 Register Breakdown</div>
        <div class="bg-slate-900 rounded p-3">
          <div class="grid grid-cols-4 gap-2 text-center">
            <div class="bg-blue-800 p-2 rounded">
              <div class="text-xs">Byte 3</div>
              <div class="font-mono">${getByteFromLong(dataRegisters[0], 0)}</div>
            </div>
            <div class="bg-blue-700 p-2 rounded">
              <div class="text-xs">Byte 2</div>
              <div class="font-mono">${getByteFromLong(dataRegisters[0], 1)}</div>
            </div>
            <div class="bg-blue-600 p-2 rounded">
              <div class="text-xs">Byte 1</div>
              <div class="font-mono">${getByteFromLong(dataRegisters[0], 2)}</div>
            </div>
            <div class="bg-blue-500 p-2 rounded">
              <div class="text-xs">Byte 0</div>
              <div class="font-mono">${getByteFromLong(dataRegisters[0], 3)}</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 mt-2 text-center">
            <div class="bg-blue-700 p-2 rounded">
              <div class="text-xs">High Word</div>
              <div class="font-mono">${getWordFromLong(dataRegisters[0], true)}</div>
            </div>
            <div class="bg-blue-600 p-2 rounded">
              <div class="text-xs">Low Word</div>
              <div class="font-mono">${getWordFromLong(dataRegisters[0], false)}</div>
            </div>
          </div>
          <div class="bg-blue-800 p-2 rounded mt-2 text-center">
            <div class="text-xs">Full Long Word</div>
            <div class="font-mono">${formatHex32(dataRegisters[0])}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .register-breakdown {
    transition: all 0.3s ease;
  }
  
  .register-breakdown:hover {
    transform: scale(1.02);
  }

  /* Override lesson content heading styles */
  .bg-slate-900 h3,
  .bg-slate-800 h3,
  .bg-black h3 {
    color: rgb(74 222 128) !important; /* text-green-400 */
    font-size: 1.125rem !important; /* text-lg */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 1rem !important; /* mb-4 */
  }

  .bg-slate-900 h4,
  .bg-slate-800 h4,
  .bg-black h4 {
    color: rgb(209 213 219) !important; /* text-slate-300 */
    font-size: 0.875rem !important; /* text-sm */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 0.75rem !important; /* mb-3 */
  }

  /* Override strong text in register view content */
  .bg-slate-900 strong,
  .bg-slate-800 strong,
  .bg-black strong {
    color: rgb(255 255 255) !important; /* text-white */
    font-weight: 700 !important;
  }
</style>