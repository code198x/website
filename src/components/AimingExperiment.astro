---
interface Props { step: number; title: string }
const {step,title} = Astro.props;
if (!Number.isInteger(step) || step < 1 || step > 6) throw new Error('Invalid aiming step');
---
<div class="aiming-embed">
  <iframe src={`/experiments/aiming/lessons.html?step=${step}`} title={`${title}: interactive experiment`} loading="lazy" data-aiming></iframe>
</div>
<p class="experiment-note">Drag in the picture or use the labelled inputs and sliders. Grid squares span 25 world units. This is a mathematical model running in your browser.</p>
<script>
  addEventListener('message', event => {
    if(event.origin !== location.origin || event.data?.type !== 'aiming-height') return;
    for(const frame of document.querySelectorAll<HTMLIFrameElement>('iframe[data-aiming]')) {
      if(frame.contentWindow !== event.source) continue;
      const height = Number(event.data.height);
      if(Number.isFinite(height) && height >= 100 && height <= 4000) frame.style.height = `${Math.ceil(height)}px`;
    }
  });
</script>
<style>
.aiming-embed{margin:1.5rem 0;border:1px solid var(--color-border);border-radius:8px;overflow:hidden;background:#0c151c}
iframe{width:100%;height:1050px;border:0;display:block;color-scheme:dark}
.experiment-note{font-size:.875rem;color:var(--color-text-secondary)}
@media(max-width:780px){iframe{height:1450px}}
</style>
