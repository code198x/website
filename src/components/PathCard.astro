---
/**
 * PathCard - Learning path selection card for Assembly/BASIC paths
 *
 * Usage:
 *   import PathCard from '@components/PathCard.astro';
 *   <PathCard
 *     href="/commodore-64/assembly"
 *     title="6510 Assembly"
 *     subtitle="Full hardware control"
 *     description="Master the VIC-II for sprites..."
 *     stats={[{ value: '16', label: 'Games' }, { value: '1,536', label: 'Units' }]}
 *     platformColor="#4a4dff"
 *     isRecommended
 *   />
 */
import type { HTMLAttributes } from 'astro/types';
import { accessibleInk } from '../lib/contrast';

interface Stat {
  value: string;
  label: string;
}

interface Props extends HTMLAttributes<'a'> {
  href: string;
  title: string;
  subtitle: string;
  description: string;
  stats?: Stat[];
  platformColor: string;
  isRecommended?: boolean;
  ctaText?: string;
}

const {
  href,
  title,
  subtitle,
  description,
  stats = [],
  platformColor,
  isRecommended = false,
  ctaText = isRecommended ? 'Start Assembly Path' : 'Start BASIC Path',
  ...attrs
} = Astro.props;

// Theme-aware accessible ink for the outline CTA text (brand colour on the
// card surface) and a darkened fill so white text passes on the solid CTA.
const inkLight = accessibleInk(platformColor, '#fdfcf7');
const inkDark = accessibleInk(platformColor, '#242019');
const fillSafe = accessibleInk(platformColor, '#ffffff');
---

<a
  href={href}
  class:list={['path-card', { recommended: isRecommended }]}
  style={`--platform-color: ${platformColor}; --ink-l: ${inkLight}; --ink-d: ${inkDark}; --platform-fill: ${fillSafe};`}
  {...attrs}
>
  {isRecommended && <span class="path-badge">Recommended</span>}
  <slot name="icon" />
  <h3 class="path-title">{title}</h3>
  <p class="path-subtitle">{subtitle}</p>
  <p class="path-description">{description}</p>
  {stats.length > 0 && (
    <div class="path-stats">
      {stats.map((stat) => (
        <div class="path-stat">
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  )}
  <span class="path-cta">{ctaText}</span>
</a>

<style>
  .path-card {
    background: var(--color-surface);
    border: 3px solid var(--color-border);
    border-radius: 0;
    box-shadow: var(--shadow-chunky);
    padding: var(--space-8);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .path-card:hover {
    border-color: var(--platform-color);
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--platform-color);
  }

  /* Recommended path - technical appearance with grid pattern */
  .path-card.recommended {
    border-color: var(--platform-color);
    background: linear-gradient(
      135deg,
      var(--color-surface) 0%,
      color-mix(in oklab, var(--platform-color) 3%, var(--color-surface) 97%) 100%
    );
  }

  .path-card.recommended::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        90deg,
        color-mix(in srgb, var(--platform-color) 3%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(color-mix(in srgb, var(--platform-color) 3%, transparent) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  /* Non-recommended path - warmer, friendlier appearance */
  .path-card:not(.recommended) {
    background: linear-gradient(
      135deg,
      var(--color-surface) 0%,
      color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%) 100%
    );
  }

  .path-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-size: 0.75rem;
    padding: var(--space-1) var(--space-3);
    background: var(--platform-color);
    color: white;
    border-radius: 0.25rem;
    font-weight: 600;
  }

  .path-card :global(.path-icon) {
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .path-title {
    font-family: var(--font-family-mono);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .path-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .path-description {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .path-stats {
    display: flex;
    gap: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .path-stat {
    text-align: center;
  }

  .stat-value {
    font-family: var(--font-family-mono);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--ink);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .path-cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--platform-fill);
    color: white;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    margin-top: var(--space-4);
    text-align: center;
  }

  .path-card:not(.recommended) .path-cta {
    background: var(--color-surface);
    border: 2px solid var(--platform-color);
    color: var(--ink-l);
  }

  :global(:root[data-theme="dark"]) .path-card:not(.recommended) .path-cta {
    color: var(--ink-d);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .path-card:not(.recommended) .path-cta {
      color: var(--ink-d);
    }
  }
</style>
