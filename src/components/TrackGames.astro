---
/**
 * TrackGames — the games list shared by every track-overview page.
 *
 * Replaces the near-identical game-card grid that was copy-pasted across the
 * assembly/BASIC/AMOS track pages. Synthesis-styled once (square, chunky, with
 * the platform colour as the accent), so the look can't drift between platforms.
 *
 * - Groups by the catalogue `phase` field when any game has one (BASIC tracks),
 *   otherwise renders a flat list (assembly tracks).
 * - Shows a unit count only when canonical unit counts exist (units > 0);
 *   otherwise shows an honest status label — never "0 / 0 units".
 * - Thumbnail: the catalogue `thumbnail` if set, else the latest available unit's
 *   screenshot, else a "soon" placeholder.
 */
interface Game {
  number: number;
  slug: string;
  name: string;
  tagline: string;
  skills: string[];
  status: 'complete' | 'in-progress' | 'coming-soon';
  units: number;
  unitsAvailable: number;
  thumbnail?: string;
  phase?: string;
}

interface Props {
  games: Game[];
  platform: string;
  track: string;
  platformColor: string;
  /** Optional one-line description per phase name, shown under the phase header. */
  phaseSubtitles?: Record<string, string>;
  appearance?: 'classic' | 'house';
}

import fs from 'node:fs';
import {pngSize} from '../lib/pixel-frame';
import { inkStyle, chipInkStyle } from '../lib/contrast';
const { games, platform, track, platformColor, phaseSubtitles, appearance = 'classic' } = Astro.props;

const groupByPhase = games.some(g => g.phase);
const phaseNames: string[] = [];
for (const g of games) {
  if (g.phase && !phaseNames.includes(g.phase)) phaseNames.push(g.phase);
}
const groups = groupByPhase
  ? phaseNames.map((name, i) => ({ name, number: i + 1, games: games.filter(g => g.phase === name) }))
  : [{ name: null, number: 0, games }];

const statusLabel: Record<string, string> = { complete: 'Complete', 'in-progress': 'In progress', 'coming-soon': 'Coming soon' };
const thumbFor = (g: Game): string | null =>
  g.thumbnail ?? (g.unitsAvailable > 0
    ? `/images/${platform}/${track}/${g.slug}/unit-${String(g.unitsAvailable).padStart(2, '0')}/screenshot.png`
    : null);
---

<div class:list={["track-games", { house: appearance === "house" }]} style={`--pc: ${platformColor}; ${inkStyle(platformColor)} ${chipInkStyle(platformColor)}`}>
  {groups.map(group => (
    <div class="group">
      {group.name && (
        <div class="phead">
          <span class="pnum">{String(group.number).padStart(2, '0')}</span>
          <div class="ptext">
            <span class="pname">{group.name}</span>
            {phaseSubtitles?.[group.name] && <span class="psub">{phaseSubtitles[group.name]}</span>}
          </div>
          <span class="pcount label">{group.games.length} {appearance === 'house' ? (group.games.length === 1 ? 'module' : 'modules') : (group.games.length === 1 ? 'game' : 'games')}</span>
        </div>
      )}
      <div class="grid">
        {group.games.map(game => {
          // A module with no *published* units (units may be planned in the
          // catalogue, but no pages exist yet) has nothing to link to, so
          // treat it as coming-soon regardless of its catalogue status. The
          // link returns automatically once a unit page lands.
          const effStatus = game.unitsAvailable > 0 ? game.status : 'coming-soon';
          const live = effStatus !== 'coming-soon';
          const thumb = thumbFor(game);
          const size = thumb && thumb.endsWith('.png') ? pngSize(new Uint8Array(fs.readFileSync(`public${thumb}`))) : undefined;
          return (
            <a
              href={live ? `/systems/${platform}/${track}/${game.slug}` : undefined}
              class={`gcard ${live ? '' : 'soon'}`}
            >
              <figure class="gthumb" style={size ? `--shot-width:${size.width}px` : undefined}>
                {thumb ? <img src={thumb} alt={`${game.name} screenshot`} width={size?.width} height={size?.height} loading="lazy" /> : <span class="ph">Soon</span>}
                {thumb&&<figcaption>{game.name} · {platform.replaceAll('-',' ')} · {track}</figcaption>}
              </figure>
              <div class="ginfo">
                <h3 class="gname heading-h3">{game.name}</h3>
                <div class="gtag">{game.tagline}</div>
                {game.skills?.length > 0 && (
                  <div class="gskills">
                    {game.skills.map(skill => <span class="skill">{skill}</span>)}
                  </div>
                )}
              </div>
              <div class="gmeta">
                {game.units > 0 ? (
                  <span class="units">{effStatus === 'in-progress' ? `${game.unitsAvailable} ${game.unitsAvailable === 1 ? 'unit' : 'units'} available` : `${game.unitsAvailable} of ${game.units} ${game.units === 1 ? 'unit' : 'units'} published`}</span>
                ) : (
                  <span class={`status label pill ${effStatus}`}>{statusLabel[effStatus] ?? ''}</span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  ))}
</div>

<style>@layer blocks {
  /* Each game is a row between hairlines: its name, tagline, skills and
     progress on the left, its screen at native width on the right. Below
     1100px the screen moves under the name. */
  .track-games { display: flex; flex-direction: column; gap: var(--h-space-8); }
  .group { display: flex; flex-direction: column; gap: var(--h-space-4); }

  .phead { display: flex; align-items: center; gap: var(--h-space-4); padding: 24px 0; border-bottom: 1px solid var(--h-line); }
  .pnum { color: var(--ink); font: 600 1.6rem/1 var(--h-font-ui); }
  .ptext { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .pname { font: 700 1.5rem/1 var(--h-font-ui); }
  .psub { color: var(--h-ink-muted); font-size: 0.85rem; line-height: 1.4; }
  .pcount { margin-left: auto; align-self: flex-start; color: var(--h-ink-muted); white-space: nowrap; }

  .gcard { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 48px; align-items: center; padding: 32px 0; border-top: 1px solid var(--h-line); color: var(--h-ink); text-decoration: none; transition: border-color var(--transition-base); }
  a.gcard:hover, a.gcard:focus-visible { border-color: var(--pc); }

  .gthumb { grid-column: 2; grid-row: 1 / 3; align-self: center; justify-self: center; width: var(--shot-width, 100%); max-width: 100%; margin: 0; }
  .gthumb img { display: block; width: 100%; height: auto; object-fit: contain; image-rendering: pixelated; }
  .gcard.soon .gthumb img { opacity: 0.55; }
  .gthumb .ph { color: var(--h-ink-muted); font-family: var(--h-font-ui); font-size: 0.8125rem; font-weight: 600; }
  .gthumb figcaption { width: 100%; margin-top: 12px; color: var(--h-ink-muted); font: italic 0.875rem/1.5 var(--h-font-ui); }

  .ginfo { grid-column: 1; grid-row: 1; align-self: end; display: flex; flex-direction: column; gap: var(--h-space-1); min-width: 0; }
  .gname { margin: 0 0 12px; }
  .gtag { color: var(--h-ink-muted); font: 1.25rem/1.6 var(--h-font-ui); }
  .gskills { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: var(--h-space-2); }
  .skill, .units { color: var(--h-ink-muted); font: 1rem/1.5 var(--h-font-ui); }

  .gmeta { grid-column: 1; display: flex; flex-direction: column; align-items: start; justify-content: center; gap: var(--h-space-2); min-width: 0; }
  .status { border-color: var(--h-line); color: var(--h-ink-muted); }
  .status.complete { color: #16a34a; border-color: #16a34a; }
  .status.in-progress { color: var(--ink); border-color: var(--pc); }

  /* The house appearance: plain phase headings, smaller names, a quieter
     hover and a focus outline. */
  .house .phead { padding: 0 0 var(--h-space-4); }
  .house .pnum { display: none; }
  .house .pname { color: var(--h-ink); font-size: 1.15rem; }
  .house .psub, .house .pcount { font-family: var(--h-font-ui); text-transform: none; letter-spacing: normal; }
  .house .gcard { align-items: start; transition: border-color 150ms; }
  .house a.gcard:hover { border-color: var(--h-line); }
  @media (hover: hover) { .house a.gcard:hover { border-color: var(--h-ink); } }
  .house .gcard:focus-visible { outline: 2px solid var(--h-ink); outline-offset: 3px; }
  .house .gname { font-size: 1.15rem; }
  .house .gtag { color: var(--h-ink-body); }
  .house .units { font-size: var(--h-text-small); }
  @media (prefers-reduced-motion: reduce) { .house .gcard { transition: none; } }

  @media (max-width: 1100px) {
    .gcard { grid-template-columns: minmax(0, 1fr); }
    .gthumb { grid-column: 1; grid-row: 2; }
    .gmeta { grid-row: 3; }
  }
  @media (max-width: 850px) { .gthumb figcaption { padding-inline: 12px; } }
}
</style>
