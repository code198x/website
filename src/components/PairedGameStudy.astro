---
import Layout from '../layouts/Layout.astro';
import FeatureArticle from './editorial/FeatureArticle.astro';
import ArticleOpening from './editorial/ArticleOpening.astro';
import {gameStudies,GAME_STUDIES_ROOT} from '../data/game-studies.mjs';
import '../styles/paired-game-studies.css';
interface Props {
 slug: 'monty-mole' | 'elite' | 'manic-miner' | 'lemmings' | 'boulder-dash' | 'mule' | 'pac-man' | 'simcity';
 source: {canonical: string; revision: string};
 contents: {label: string; href: string}[];
}
const {slug,source,contents}=Astro.props;
const study=gameStudies.find(study=>study.slug===slug)!;
const breadcrumbs=[{label:'Home',href:'/'},{label:'The Vault',href:'/vault/'},{label:'Game Studies',href:GAME_STUDIES_ROOT},{label:study.title}];
const credit=slug==='elite'?'Original editorial illustration · an imagined voyage':slug==='simcity'?'Original editorial illustration · an imagined city':slug==='pac-man'?'Original editorial illustration · an imagined maze':'Original editorial illustration · an imagined landscape';
const gameCredit={
 simcity:'SimCity · Will Wright · Maxis · Infogrames Amiga edition · 1989',
 elite:'Elite · Ian Bell & David Braben · Acornsoft · BBC Micro · 1984',
 'monty-mole':'Wanted: Monty Mole · Peter Harrap · Gremlin Graphics · ZX Spectrum · 1984',
 'manic-miner':'Manic Miner · Matthew Smith · Bug-Byte · ZX Spectrum · 1983',
 'boulder-dash':'Boulder Dash · Peter Liepa with Chris Gray · First Star Software · Atari 8-bit · 1984',
 'pac-man':'Pac-Man · Namco · Midway · Arcade · 1980',
 mule:'M.U.L.E. · Ozark Softscape · Electronic Arts · Atari 8-bit · 1983',
 lemmings:'Lemmings · DMA Design · Psygnosis · Amiga · 1991',
}[slug];
---
<Layout title={`${study.title}: ${study.subtitle}`} description={study.description} breadcrumbs={breadcrumbs} noindex={!study.reviewed}>
 <FeatureArticle class="paired-game-study">
  <ArticleOpening slot="opening" title={study.title} subtitle={study.subtitle} description={study.description} image={study.image} imageSet={`/images/studies/${slug}/header-1280.webp 1280w, /images/studies/${slug}/header-2172.webp 2172w`} imageCredit={credit} metadata={study.context} />
  <nav class="study-contents" aria-label="In this study">
   <p>Explore the study</p>
   <ul>{contents.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul>
  </nav>
  <slot />
  <Fragment slot="ending">
   <p>This study has not yet been fact-checked. Selected early encounters were observed; a complete playthrough is not claimed. Original documents and source analysis support the wider account.</p>
   <p>{gameCredit}. Own screenshots illustrate criticism and review. Rights in the game remain with their owners. The header and explanatory diagrams are original illustrations. Photographs and advertising carry their own credits and rights records alongside each image.</p>
   <p><a href={source.canonical}>Canonical study</a> · <a href={`https://github.com/code198x/docs/blob/${source.revision}/studies/${slug}/evidence.md`}>Evidence and capture credits</a> · <a href={GAME_STUDIES_ROOT}>More game studies</a></p>
  </Fragment>
 </FeatureArticle>
</Layout>
