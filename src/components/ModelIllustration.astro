---
import type { HardwareModel } from '../data/hardware-models';
import { modelImage, modelSrcset } from '../data/hardware-models';
import provenance from '../../public/images/models/provenance.json';
interface Props { model: HardwareModel; view?: string; priority?: boolean; showViews?: boolean; }
const { model, view: viewId, priority = false, showViews = false } = Astro.props;
const view = model.views.find(view => view.id === viewId) ?? model.views[0];
const records = provenance as Record<string, Record<string, { images: Record<string, { width: number; height: number }> }>>;
const dimensions = records[model.system][view.id].images['1280'];
---
<figure class="model-illustration" data-model-illustration={model.system}>
  <a href={modelImage(model.system, view.id, 1920)} aria-label={`Open a larger illustration of ${model.name}`}>
    <img src={modelImage(model.system, view.id)} srcset={modelSrcset(model.system, view.id)} sizes="(max-width: 760px) 100vw, 800px" width={dimensions.width} height={dimensions.height} alt={view.alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
  </a>
  <figcaption>{model.variant} · Rendered illustration; some dimensions and details are estimated.
    {model.credit && <span class="model-credit"><a href={model.credit.href}>{model.credit.label}</a></span>}
    {showViews && model.views.length > 1 && <span class="alternate-views">Other views: {model.views.filter(item => item.id !== view.id).map(item => <a href={modelImage(model.system, item.id, 1920)}>{item.label}</a>)}</span>}
  </figcaption>
</figure>
<style>@layer blocks {
  .model-illustration { margin: 0; min-width: 0; width: 100%; }
  .model-illustration > a { display: block; }
  .model-illustration img { display: block; width: 100%; height: auto; object-fit: contain; }
  figcaption { margin: 0; padding-top: 12px; max-width: 65ch; color: var(--h-ink-muted); font: italic .875rem/1.5 var(--h-font-ui); }
  .model-credit { display: block; margin-top: 4px; }
  .alternate-views { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; margin-top: 8px; font-style: normal; }
  .alternate-views a { display: inline-flex; align-items: center; min-height: 44px; }
  a { color: inherit; text-underline-offset: .2em; }
  a:hover { color: var(--h-spot-ink); }
  a:focus-visible { outline: 3px solid var(--h-spot); outline-offset: 4px; }
}</style>
