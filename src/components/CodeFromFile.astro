---
/**
 * CodeFromFile - Renders code from an external file
 *
 * Usage:
 *   import CodeFromFile from '@components/CodeFromFile.astro';
 *   <CodeFromFile src="commodore-amiga/game-01-hop/unit-08/hop.asm" lang="asm" />
 *   <CodeFromFile src="commodore-amiga/game-01-hop/unit-08/snippets/01-collision.asm" lang="asm" />
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;      // Path relative to code-samples root
  lang?: string;    // Language for syntax highlighting (default: inferred from extension)
  title?: string;   // Optional title to display above code
}

const { src, lang, title } = Astro.props;

// Resolve code-samples path
const codeSamplesPath = process.env.CODE_SAMPLES_PATH || path.resolve(process.cwd(), '../code-samples');
const filePath = path.join(codeSamplesPath, src);

// Read the file
let code: string;
try {
  code = fs.readFileSync(filePath, 'utf-8');
} catch (error) {
  throw new Error(`CodeFromFile: Could not read file "${filePath}". Ensure code-samples is available.`);
}

// Infer language from path and extension if not provided
const extension = path.extname(src).slice(1);

// Platform-specific assembly language detection
function inferLanguage(srcPath: string, ext: string): string {
  if (ext === 'bas') {
    if (srcPath.includes('sinclair-zx-spectrum')) return 'sinclair-basic';
    if (srcPath.includes('commodore-amiga')) return 'amos';
    return 'basic'; // C64 BASIC
  }
  if (ext === 'asm' || ext === 's') {
    if (srcPath.includes('sinclair-zx-spectrum')) return 'z80';
    if (srcPath.includes('commodore-amiga')) return 'm68k';
    if (srcPath.includes('nintendo-entertainment-system')) return 'ca65';
    return '6502'; // C64 default
  }
  if (ext === 'cfg') return 'ini';
  return ext;
}

const language = lang || inferLanguage(src, extension);
---

{title && <p class="code-title"><strong>{title}</strong></p>}
<div class="code-container">
  <button class="copy-button" aria-label="Copy code to clipboard">
    <span class="copy-icon">Copy</span>
    <span class="copied-icon" style="display: none;">Copied!</span>
  </button>
  <pre class={`language-${language}`}><code class={`language-${language}`} set:text={code} /></pre>
</div>

<style>
  .code-title {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted, #888);
  }

  .code-container {
    position: relative;
  }

  .copy-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-family-sans, system-ui, sans-serif);
    background: var(--color-surface, #1e293b);
    border: 1px solid var(--color-border, #334155);
    border-radius: 0.25rem;
    color: var(--color-text-secondary, #94a3b8);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, background 0.15s ease;
    z-index: 10;
  }

  .code-container:hover .copy-button {
    opacity: 1;
  }

  .copy-button:hover {
    background: var(--color-border, #334155);
    color: var(--color-text, #f1f5f9);
  }

  .copy-button:active {
    transform: scale(0.95);
  }

  .copied-icon {
    color: #22c55e;
  }
</style>

<script>
  document.querySelectorAll('.code-container').forEach(container => {
    const button = container.querySelector('.copy-button');
    const code = container.querySelector('code');
    const copyIcon = button?.querySelector('.copy-icon');
    const copiedIcon = button?.querySelector('.copied-icon');

    button?.addEventListener('click', async () => {
      if (!code || !copyIcon || !copiedIcon) return;

      try {
        await navigator.clipboard.writeText(code.textContent || '');
        copyIcon.style.display = 'none';
        copiedIcon.style.display = 'inline';

        setTimeout(() => {
          copyIcon.style.display = 'inline';
          copiedIcon.style.display = 'none';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  });
</script>
