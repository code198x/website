---
/**
 * CodeFromFile - A listing read from the code-samples repository.
 *
 * Usage:
 *   import CodeFromFile from '@components/CodeFromFile.astro';
 *   <CodeFromFile src="commodore-amiga/game-01-hop/unit-08/hop.asm" lang="asm" />
 *   <CodeFromFile src="…/meteor-storm.asm" from="; --- draw" to="; --- move" />
 *
 * Drawn as the House198x Listing (styles/lesson.css): a square panel in the
 * page's theme, the kit's four syntax roles, and a head bar naming the file.
 * Highlighting is static spans from src/lib/kit-highlight.ts.
 */
import fs from 'node:fs';
import path from 'node:path';
import { listingHtml } from '../lib/kit-highlight';
import { getAllPlatforms } from '../lib/platforms';
import { inlineMarkdown } from '../lib/inline-markdown';
import '../styles/lesson.css';

interface Props {
  src: string;      // Path relative to code-samples root
  lang?: string;    // Language for syntax highlighting (default: inferred from extension)
  from?: string; // Optional exact start marker for a maintained-source excerpt.
  to?: string;   // Exclusive end marker, following from.
  title?: string;   // Optional title to display above code
}

const { src, lang, title, from, to } = Astro.props;

// Resolve code-samples path
const codeSamplesPath = process.env.CODE_SAMPLES_PATH || path.resolve(process.cwd(), '../code-samples');
const filePath = path.join(codeSamplesPath, src);

// Read the file
let code: string;
let fileError: string | null = null;
try {
  code = fs.readFileSync(filePath, 'utf-8');
} catch (error) {
  // A lesson that cannot show its program must not ship; the placeholder is for local dev only.
  if (!import.meta.env.DEV) throw new Error(`CodeFromFile: missing code sample ${src} under ${codeSamplesPath}`);
  fileError = `Could not load code sample: ${src}`;
  code = `; Code sample unavailable\n; File: ${src}\n; Please check that code-samples directory exists`;
  console.error(`CodeFromFile: Could not read file "${filePath}". Ensure code-samples is available.`);
}

// Each listing is a landmark region, and landmarks need distinct names: two
// excerpts from one file are told apart by the source lines they show.
let lines = '';
if (from && to && !fileError) {
  const start = code.indexOf(from), end = code.indexOf(to, start + from.length);
  if (start < 0 || end < 0) throw new Error(`Missing code excerpt in ${src}: ${from} → ${to}`);
  const excerpt = code.slice(start, end).trimEnd();
  const first = code.slice(0, start).split('\n').length;
  lines = `, lines ${first} to ${first + excerpt.split('\n').length - 1}`;
  code = excerpt;
}

// Build platform slug -> assembler language mapping from collection
const platforms = await getAllPlatforms();
const platformLanguages = Object.fromEntries(
  platforms.map(p => [p.id, p.data.assemblerLanguage])
);

// Infer language from path and extension if not provided
const extension = path.extname(src).slice(1);

// Platform-specific assembly language detection
function inferLanguage(srcPath: string, ext: string): string {
  // Extract platform slug from path (first directory component)
  const platformSlug = srcPath.split('/')[0];

  if (ext === 'bb2') return 'blitz'; // Blitz BASIC 2 source
  if (ext === 'bas') {
    if (platformSlug === 'sinclair-zx-spectrum') return 'sinclair-basic';
    if (platformSlug === 'commodore-amiga') return 'amos';
    return 'basic'; // C64 BASIC
  }
  if (ext === 'asm' || ext === 's') {
    // Use platform's configured assembler language, default to 6502
    return platformLanguages[platformSlug] || '6502';
  }
  if (ext === 'cfg') return 'ini';
  return ext;
}

const language = lang || inferLanguage(src, extension);

// Trailing newlines would draw as empty lines at the foot of the panel.
const shown = code.replace(/\n+$/, '');
const listing = fileError ? '' : await listingHtml(shown, language);
const fileName = path.basename(src);
const label = from ? `${fileName}, excerpt` : fileName;
---

{title && <p class="code-title"><strong set:html={inlineMarkdown(title)} /></p>}
{fileError ? (
  <div class="code-error" role="alert">
    <p class="error-message">{fileError}</p>
    <p class="error-hint">This code sample could not be loaded. The file may be missing or the path may be incorrect.</p>
  </div>
) : (
  <div class="lesson-listing code-container" data-code={code}>
    <div class="ll-head">
      <span class="ll-label">{label}</span>
      <button type="button" class="ll-copy copy-button" hidden aria-label={`Copy ${label}`}><span class="ll-copy-label" aria-live="polite">Copy</span></button>
    </div>
    <div class="ll-scroll" data-ll-scroll data-label={`${label}${lines}, listing`} tabindex="0" role="region" aria-label={`${label}${lines}, listing`}><pre class="ll-pre"><code set:html={listing} /></pre></div>
  </div>
)}

<style>
  .code-title {
    margin-bottom: 0.5rem;
    font-family: var(--h-font-ui);
    font-size: var(--h-text-small);
    color: var(--h-ink-body);
  }

  .code-error {
    background: var(--color-error-muted);
    border: 1px solid var(--h-line);
    border-left: 4px solid var(--color-error);
    border-radius: 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }

  .error-message {
    color: var(--h-ink);
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .error-hint {
    color: var(--h-ink-muted);
    font-size: 0.875rem;
    margin: 0;
  }
</style>

<script>
  import { initListings } from '../lib/lesson-listing';
  initListings();
  document.addEventListener('astro:page-load', () => initListings());
</script>
