---
import OpeningBand from './OpeningBand.astro';
---
<OpeningBand class="curriculum-opening" labelledby="curriculum-title" focal="right center"
  art={{ src: '/images/curriculum-opening/landscape-2172.webp', srcset: '/images/curriculum-opening/landscape-1280.webp 1280w, /images/curriculum-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }}
  caption="Complementary ideas in an imagined paper foldout, not a curriculum dependency map.">
  <h1 id="curriculum-title">How the curriculum fits together.</h1>
</OpeningBand>

<style>
  h1 { margin: 0; font: 900 italic clamp(2.75rem, 4.6cqw, 4.125rem)/.99 var(--h-font-mag); letter-spacing: -.025em; text-wrap: balance; overflow-wrap: anywhere; color: var(--h-ink); max-width: 6em; font-size: clamp(2.5rem, 3.9cqw, 3.5rem); }
  @media (max-width: 1000px) { h1 { font-size: clamp(2.5rem, 10.8cqw, 3.625rem); max-width: 12ch; } }
</style>
