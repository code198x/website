---
interface Props { title: string; description?: string; eyebrow?: string; }
const { title, description, eyebrow } = Astro.props;
---
<header class="page-heading">
  {eyebrow && <p class="page-heading-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {description && <p class="page-heading-intro">{description}</p>}
  <slot />
</header>
<style>
  .page-heading { margin: 40px 0; padding-bottom: 32px; border-bottom: 1px solid var(--h-line); }
  h1 { margin: 16px 0 24px; padding: 0; max-width: 24ch; font: 700 var(--display-size)/1.05 var(--h-font-ui); letter-spacing: -.035em; color: var(--h-ink); }
  .page-heading-eyebrow { margin: 0; color: var(--h-ink-muted); font: 400 12px/1.5 var(--h-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .page-heading-intro { margin: 0; max-width: var(--reading-width); font: 400 22px/1.55 var(--h-font-ui); color: var(--h-ink-body); }
</style>
