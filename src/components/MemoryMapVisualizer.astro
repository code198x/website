---
export interface Props {
  platform: 'c64' | 'spectrum' | 'nes' | 'atari800';
  activeAddress?: number;
  highlights?: Array<{start: number, end: number, label: string}>;
}

const { platform, activeAddress, highlights = [] } = Astro.props;

// Helper function to check if an address is within a memory block range
function isAddressActive(address: number | undefined, start: number, end: number): boolean {
  if (!address) return false;
  return address >= start && address <= end;
}

// Platform-specific memory maps
const memoryMaps = {
  c64: [
    { start: 0x0000, end: 0x9FFF, color: 'bg-blue-600', label: 'BASIC ROM (40KB)' },
    { start: 0xA000, end: 0xBFFF, color: 'bg-green-600', label: 'BASIC ROM / RAM (8KB)' },
    { start: 0xC000, end: 0xCFFF, color: 'bg-purple-600', label: 'RAM (4KB)' },
    { start: 0xD000, end: 0xDFFF, color: 'bg-red-600', label: 'I/O Area (VIC/SID/CIA)' },
    { start: 0xE000, end: 0xFFFF, color: 'bg-orange-600', label: 'KERNAL ROM (8KB)' }
  ],
  spectrum: [
    { start: 0x0000, end: 0x3FFF, color: 'bg-red-600', label: 'ROM (16KB)' },
    { start: 0x4000, end: 0x57FF, color: 'bg-green-600', label: 'Screen Memory (6KB)' },
    { start: 0x5800, end: 0x5AFF, color: 'bg-yellow-600', label: 'Attributes (768B)' },
    { start: 0x5B00, end: 0xFFFF, color: 'bg-blue-600', label: 'RAM (42KB)' }
  ],
  nes: [
    { start: 0x0000, end: 0x07FF, color: 'bg-green-600', label: 'RAM (2KB)' },
    { start: 0x2000, end: 0x2007, color: 'bg-red-600', label: 'PPU Registers' },
    { start: 0x4000, end: 0x4017, color: 'bg-purple-600', label: 'APU & I/O' },
    { start: 0x8000, end: 0xFFFF, color: 'bg-blue-600', label: 'PRG ROM (32KB)' }
  ],
  atari800: [
    { start: 0x0000, end: 0x7FFF, color: 'bg-green-600', label: 'RAM (32KB)' },
    { start: 0xD000, end: 0xD0FF, color: 'bg-red-600', label: 'GTIA' },
    { start: 0xD200, end: 0xD2FF, color: 'bg-purple-600', label: 'POKEY' },
    { start: 0xD400, end: 0xD4FF, color: 'bg-orange-600', label: 'ANTIC' },
    { start: 0xE000, end: 0xFFFF, color: 'bg-blue-600', label: 'OS ROM (8KB)' }
  ]
};

const currentMap = memoryMaps[platform];
---

<div class="memory-map-container p-4 bg-slate-900 rounded-lg">
  <h3 class="text-white text-lg font-bold mb-4">
    {platform.toUpperCase()} Memory Map
  </h3>
  
  <div class="memory-blocks space-y-2">
    {currentMap.map(block => {
      const isActive = isAddressActive(activeAddress, block.start, block.end);
      const percentage = ((block.end - block.start + 1) / 65536) * 100;
      
      return (
        <div class="memory-block">
          <div class="flex items-center mb-1">
            <span class="text-xs text-slate-400 font-mono w-20">
              ${block.start.toString(16).toUpperCase().padStart(4, '0')}
            </span>
            <div class="flex-1 mx-2">
              <div 
                class={`h-8 ${block.color} ${isActive ? 'animate-pulse ring-2 ring-white' : ''} 
                       rounded flex items-center justify-center transition-all`}
                style={`width: ${Math.max(percentage, 10)}%`}
              >
                <span class="text-xs text-white font-semibold px-2 truncate">
                  {block.label}
                </span>
              </div>
            </div>
            <span class="text-xs text-slate-400 font-mono w-20 text-right">
              ${block.end.toString(16).toUpperCase().padStart(4, '0')}
            </span>
          </div>
        </div>
      );
    })}
  </div>
  
  {activeAddress && (
    <div class="mt-4 p-2 bg-yellow-900 rounded">
      <span class="text-yellow-300 text-sm font-mono">
        Active: ${activeAddress.toString(16).toUpperCase().padStart(4, '0')}
      </span>
    </div>
  )}
  
  {highlights.length > 0 && (
    <div class="mt-4 space-y-1">
      <h4 class="text-white text-sm font-semibold">Highlighted Regions:</h4>
      {highlights.map(h => (
        <div class="text-xs text-slate-300 font-mono">
          ${h.start.toString(16).toUpperCase()}-${h.end.toString(16).toUpperCase()}: {h.label}
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .memory-map-container {
    font-family: 'Courier New', monospace;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
</style>