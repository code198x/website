---
/**
 * SystemHero - Platform-branded hero section for system landing pages
 *
 * Usage:
 *   import SystemHero from '@components/SystemHero.astro';
 *   <SystemHero
 *     title="COMMODORE 64"
 *     subtitle="Learn programming by building games"
 *     platformColor="#4a4dff"
 *     specs={[
 *       { label: 'CPU', value: 'MOS 6510' },
 *       { label: 'Speed', value: '1 MHz' },
 *     ]}
 *   />
 */

interface Spec {
  label: string;
  value: string;
}

interface Props {
  title: string;
  subtitle?: string;
  platformColor: string;
  specs?: Spec[];
  variant?: 'gradient' | 'dark' | 'scanlines' | 'stripes' | 'copper';
  rainbowStripe?: boolean;
}

const {
  title,
  subtitle = 'Learn programming by building games',
  platformColor,
  specs = [],
  variant = 'gradient',
  rainbowStripe = false,
} = Astro.props;

// Generate gradient based on platform colour
const gradientLight = platformColor;
const gradientDark = `color-mix(in oklch, ${platformColor} 70%, #2d2d2d 30%)`;
---

<section
  class:list={['system-hero', `variant-${variant}`, { 'has-rainbow': rainbowStripe }]}
  style={`--platform-color: ${platformColor}; --gradient-light: ${gradientLight}; --gradient-dark: ${gradientDark};`}
>
  <!-- Animated background shapes -->
  <div class="hero-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>
  </div>

  <!-- Grid overlay -->
  <div class="hero-grid"></div>

  <!-- Scanline effect -->
  <div class="hero-scanlines"></div>

  <!-- Animated beam -->
  <div class="hero-beam"></div>

  <div class="hero-content">
    <h1 class="system-title">{title}</h1>
    {subtitle && <p class="system-subtitle">{subtitle}</p>}
    {specs.length > 0 && (
      <div class="system-specs">
        {specs.map((spec) => (
          <div class="spec-item">
            <div class="spec-label">{spec.label}</div>
            <div class="spec-value">{spec.value}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /* Animations */
  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(15px, -20px) rotate(5deg); }
    50% { transform: translate(-10px, -35px) rotate(-3deg); }
    75% { transform: translate(20px, -15px) rotate(8deg); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(-20px, 15px) rotate(-8deg); }
    50% { transform: translate(15px, 25px) rotate(5deg); }
    75% { transform: translate(-25px, 10px) rotate(-5deg); }
  }

  @keyframes float-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(25px, -20px) scale(1.1); }
    66% { transform: translate(-15px, 15px) scale(0.95); }
  }

  @keyframes float-4 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-30px, -25px) rotate(180deg); }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.7; }
  }

  @keyframes scanline-beam {
    0% { top: -10%; }
    100% { top: 110%; }
  }

  .system-hero {
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* Animated shapes container */
  .hero-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .shape {
    position: absolute;
    opacity: 0.35;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  /* Shape 1: Square/Rectangle - top left */
  .shape-1 {
    top: 15%;
    left: 8%;
    width: 70px;
    height: 70px;
    border: 4px solid var(--platform-color);
    box-shadow: 0 0 25px var(--platform-color), inset 0 0 15px rgba(255, 255, 255, 0.1);
    animation: float-1 12s infinite, pulse-glow 4s infinite;
  }

  /* Shape 2: Circle - top right */
  .shape-2 {
    top: 20%;
    right: 12%;
    width: 55px;
    height: 55px;
    border: 4px solid var(--platform-color);
    border-radius: 50%;
    box-shadow: 0 0 20px var(--platform-color);
    animation: float-2 15s infinite, pulse-glow 5s infinite 1s;
  }

  /* Shape 3: Diamond - bottom left */
  .shape-3 {
    bottom: 20%;
    left: 15%;
    width: 50px;
    height: 50px;
    border: 4px solid var(--platform-color);
    transform: rotate(45deg);
    box-shadow: 0 0 20px var(--platform-color);
    animation: float-3 18s infinite, pulse-glow 6s infinite 2s;
  }

  /* Shape 4: Triangle - bottom right */
  .shape-4 {
    bottom: 25%;
    right: 10%;
    width: 0;
    height: 0;
    border-left: 30px solid transparent;
    border-right: 30px solid transparent;
    border-bottom: 50px solid var(--platform-color);
    filter: drop-shadow(0 0 15px var(--platform-color));
    animation: float-4 20s infinite, pulse-glow 7s infinite;
  }

  /* Grid overlay */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 1;
  }

  /* Scanlines effect */
  .hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 2px,
      rgba(0, 0, 0, 0.15) 4px
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Animated beam effect */
  .hero-beam {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.1) 20%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0.1) 80%,
      transparent 100%
    );
    animation: scanline-beam 8s linear infinite;
    pointer-events: none;
    z-index: 3;
  }

  /* Variant: gradient (default - C64) */
  .variant-gradient {
    background: linear-gradient(135deg, var(--gradient-light) 0%, var(--gradient-dark) 100%);
  }

  /* Variant: dark (Spectrum) */
  .variant-dark {
    background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%);
  }

  .variant-dark .shape {
    opacity: 0.5;
  }

  /* Variant: scanlines */
  .variant-scanlines {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
  }

  /* Variant: stripes (NES - diagonal stripes) */
  .variant-stripes {
    background: linear-gradient(135deg, var(--gradient-light) 0%, var(--gradient-dark) 100%);
  }

  .variant-stripes .hero-grid {
    background-image:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 15px,
        rgba(255, 255, 255, 0.05) 15px,
        rgba(255, 255, 255, 0.05) 30px
      );
    background-size: auto;
  }

  /* Variant: copper (Amiga - copper bar effect) */
  .variant-copper {
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--platform-color) 80%, #993d00) 0%,
      var(--platform-color) 15%,
      color-mix(in oklch, var(--platform-color) 100%, #ffaa55 30%) 30%,
      color-mix(in oklch, var(--platform-color) 100%, #ffcc88 20%) 45%,
      color-mix(in oklch, var(--platform-color) 100%, #ffaa55 30%) 55%,
      var(--platform-color) 70%,
      color-mix(in oklch, var(--platform-color) 80%, #993d00) 85%,
      color-mix(in oklch, var(--platform-color) 60%, #662200) 100%
    );
  }

  .variant-copper .hero-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  }

  /* Rainbow stripe (Spectrum branding) */
  .has-rainbow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 10px;
    background: linear-gradient(
      90deg,
      #00ff00 0%,
      #00ff00 14.28%,
      #ffff00 14.28%,
      #ffff00 28.57%,
      #00ffff 28.57%,
      #00ffff 42.85%,
      #ff0000 42.85%,
      #ff0000 57.14%,
      #ff00ff 57.14%,
      #ff00ff 71.42%,
      #00ff00 71.42%,
      #00ff00 85.71%,
      #00ffff 85.71%,
      #00ffff 100%
    );
    z-index: 10;
  }

  .hero-content {
    text-align: center;
    color: white;
    padding: var(--space-10) var(--space-4);
    position: relative;
    z-index: 5;
    max-width: 800px;
  }

  .system-title {
    font-family: var(--font-family-mono);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    margin-bottom: var(--space-4);
    text-shadow:
      2px 2px 4px rgba(0, 0, 0, 0.5),
      0 0 40px color-mix(in oklch, var(--platform-color) 50%, transparent);
    color: white;
    letter-spacing: 0.05em;
  }

  .system-subtitle {
    font-size: 1.25rem;
    opacity: 0.95;
    margin-bottom: var(--space-4);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
  }

  .system-specs {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-4);
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
    padding: var(--space-4) var(--space-8);
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .spec-item {
    text-align: center;
  }

  .spec-label {
    font-size: 0.7rem;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .spec-value {
    font-family: var(--font-family-mono);
    font-size: 1rem;
    font-weight: bold;
    text-shadow: 0 0 10px var(--platform-color);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .shape {
      animation: none;
    }

    .hero-beam {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .system-hero {
      min-height: 320px;
    }

    .system-specs {
      gap: var(--space-4);
      padding: var(--space-2) var(--space-3);
    }

    .shape {
      opacity: 0.2;
    }

    .shape-1 { width: 50px; height: 50px; }
    .shape-2 { width: 40px; height: 40px; }
    .shape-3 { width: 35px; height: 35px; }
    .shape-4 {
      border-left-width: 20px;
      border-right-width: 20px;
      border-bottom-width: 35px;
    }
  }
</style>
