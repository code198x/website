---
/**
 * SystemHero — platform-branded hero for system landing pages, in the house
 * style: flat, square, a platform-colour rule for identity, a chunky specs box.
 * Two grounds — `paper` (light, the default, used by every platform page) and
 * `dark` (the CRASH! Live event masthead) — share the same geometry so the site
 * reads as one system. The old neon/animated treatment (floating shapes,
 * scanlines, beam, gradient/stripes/copper variants) was retired: only these two
 * grounds were ever used.
 *
 * Usage:
 *   <SystemHero
 *     title="Commodore 64"
 *     subtitle="Where bedroom coders became legends"
 *     platformColor="#4a4dff"
 *     specs={[{ label: 'CPU', value: 'MOS 6510' }, ...]}
 *   />
 */
interface Spec {
  label: string;
  value: string;
}

interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  platformColor: string;
  specs?: Spec[];
  variant?: 'paper' | 'dark';
  rainbowStripe?: boolean;
}

const {
  title,
  subtitle = 'Learn programming by building games',
  kicker,
  platformColor,
  specs = [],
  variant = 'paper',
  rainbowStripe = false,
} = Astro.props;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<section
  class:list={['system-hero', `variant-${variant}`, { 'has-rainbow': rainbowStripe }]}
  style={`--platform-color: ${platformColor};`}
>
  <div class="hero-content">
    {kicker && <p class="hero-kicker label" set:html={inlineMarkdown(kicker)} />}
    <h1 class="system-title" set:html={inlineMarkdown(title)} />
    <div class="hero-rule"></div>
    {subtitle && <p class="system-subtitle" set:html={inlineMarkdown(subtitle)} />}
    <slot name="actions" />
    {specs.length > 0 && (
      <div class="system-specs">
        {specs.map((spec) => (
          <div class="spec-item">
            <div class="spec-label label">{spec.label}</div>
            <div class="spec-value">{spec.value}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>@layer blocks {
  .system-hero {
    position: relative;
    overflow: hidden;
    background: transparent;               /* let the page paper show through */
    padding-bottom: var(--h-space-12);
    text-align: center;
  }
  .hero-content { position: relative; z-index: 1; max-width: var(--site-frame-width); margin: 0 auto; padding-inline: var(--gutter); }

  .hero-kicker { color: var(--h-ink-muted);
    margin: 0 0 var(--h-space-3);
  }
  .system-title {
    font-family: var(--h-font-ui); font-weight: 700;
    font-size: clamp(3rem, 6vw, var(--h-text-display)); line-height: var(--h-lh-display);
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em;
    margin: 0; color: var(--h-ink); letter-spacing: 0;
  }
  /* Platform identity: a chunky rule in the machine's colour, with a house tail. */
  .hero-rule {
    height: 9px; width: 220px; max-width: 60%; margin: var(--h-space-4) auto 0;
    background: var(--platform-color); position: relative;
  }
  .hero-rule::after {
    content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 22%;
    background: var(--h-ink); opacity: 0.25;
  }
  .system-subtitle {
    font-size: 1.2rem; color: var(--h-ink-muted); margin: var(--h-space-4) 0 0;
  }

  .system-specs {
    display: inline-flex; gap: var(--h-space-6); flex-wrap: wrap; justify-content: center;
    margin-top: var(--h-space-6); padding: var(--h-space-4) var(--h-space-8);
    background: var(--h-ground); border: 3px solid var(--h-ink);  }
  .spec-item { text-align: center; }
  .spec-label { color: var(--h-ink-muted);
  }
  .spec-value {
    font-family: var(--h-font-mono); font-size: 1rem; font-weight: 700;
    color: var(--h-ink); margin-top: 3px;
  }

  /* Dark ground — the CRASH! Live event masthead. Same geometry, dark surface. */

  /* Rainbow stripe (Spectrum / CRASH! Live branding) */
  .has-rainbow::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 10px; z-index: 10;
    background: linear-gradient(90deg,
      #00ff00 0%, #00ff00 14.28%, #ffff00 14.28%, #ffff00 28.57%,
      #00ffff 28.57%, #00ffff 42.85%, #ff0000 42.85%, #ff0000 57.14%,
      #ff00ff 57.14%, #ff00ff 71.42%, #00ff00 71.42%, #00ff00 85.71%,
      #00ffff 85.71%, #00ffff 100%);
  }

  @media (max-width: 768px) {
    .system-hero { padding-bottom: var(--space-10); }
    .system-specs { gap: var(--h-space-4); padding: var(--h-space-3) var(--h-space-4); }
  }
}
</style>
