---
/**
 * SystemHero - Platform-branded hero section for system landing pages
 *
 * Usage:
 *   import SystemHero from '@components/SystemHero.astro';
 *   <SystemHero
 *     title="COMMODORE 64"
 *     subtitle="Learn programming by building games"
 *     platformColor="#4a4dff"
 *     specs={[
 *       { label: 'CPU', value: 'MOS 6510' },
 *       { label: 'Speed', value: '1 MHz' },
 *     ]}
 *   />
 */

interface Spec {
  label: string;
  value: string;
}

interface Props {
  title: string;
  subtitle?: string;
  platformColor: string;
  specs?: Spec[];
  variant?: 'gradient' | 'dark' | 'scanlines' | 'stripes' | 'copper';
  rainbowStripe?: boolean;
}

const {
  title,
  subtitle = 'Learn programming by building games',
  platformColor,
  specs = [],
  variant = 'gradient',
  rainbowStripe = false,
} = Astro.props;

// Generate gradient based on platform colour
const gradientLight = platformColor;
const gradientDark = `color-mix(in oklch, ${platformColor} 70%, #2d2d2d 30%)`;
---

<section
  class:list={['system-hero', `variant-${variant}`, { 'has-rainbow': rainbowStripe }]}
  style={`--platform-color: ${platformColor}; --gradient-light: ${gradientLight}; --gradient-dark: ${gradientDark};`}
>
  <div class="hero-content">
    <h1 class="system-title">{title}</h1>
    {subtitle && <p class="system-subtitle">{subtitle}</p>}
    {specs.length > 0 && (
      <div class="system-specs">
        {specs.map((spec) => (
          <div class="spec-item">
            <div class="spec-label">{spec.label}</div>
            <div class="spec-value">{spec.value}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .system-hero {
    min-height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* Variant: gradient (default - C64, Amiga) */
  .variant-gradient {
    background: linear-gradient(135deg, var(--gradient-light) 0%, var(--gradient-dark) 100%);
  }

  .variant-gradient::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.1) 2px,
      rgba(255, 255, 255, 0.1) 4px
    );
    pointer-events: none;
  }

  /* Variant: dark (Spectrum, NES) */
  .variant-dark {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
  }

  .variant-dark::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.05) 2px,
      rgba(255, 255, 255, 0.05) 4px
    );
    pointer-events: none;
  }

  /* Variant: scanlines (alternative dark with visible scanlines) */
  .variant-scanlines {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
  }

  .variant-scanlines::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(255, 255, 255, 0.03) 1px,
      rgba(255, 255, 255, 0.03) 2px
    );
    pointer-events: none;
  }

  /* Variant: stripes (NES - diagonal stripes) */
  .variant-stripes {
    background: linear-gradient(135deg, var(--gradient-light) 0%, var(--gradient-dark) 100%);
  }

  .variant-stripes::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 255, 255, 0.1) 10px,
      rgba(255, 255, 255, 0.1) 20px
    );
    pointer-events: none;
  }

  /* Variant: copper (Amiga - copper bar effect) */
  .variant-copper {
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--platform-color) 80%, #993d00) 0%,
      var(--platform-color) 15%,
      color-mix(in oklch, var(--platform-color) 100%, #ffaa55 30%) 30%,
      color-mix(in oklch, var(--platform-color) 100%, #ffcc88 20%) 45%,
      color-mix(in oklch, var(--platform-color) 100%, #ffaa55 30%) 55%,
      var(--platform-color) 70%,
      color-mix(in oklch, var(--platform-color) 80%, #993d00) 85%,
      color-mix(in oklch, var(--platform-color) 60%, #662200) 100%
    );
  }

  .variant-copper::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 4px,
      rgba(255, 255, 255, 0.08) 4px,
      rgba(255, 255, 255, 0.08) 8px
    );
    pointer-events: none;
  }

  .variant-copper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 255, 255, 0.05) 25%,
      transparent 50%,
      rgba(0, 0, 0, 0.1) 75%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Rainbow stripe (Spectrum branding) */
  .has-rainbow::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: linear-gradient(
      90deg,
      #00ff00 0%,
      #00ff00 14.28%,
      #ffff00 14.28%,
      #ffff00 28.57%,
      #00ffff 28.57%,
      #00ffff 42.85%,
      #ff0000 42.85%,
      #ff0000 57.14%,
      #ff00ff 57.14%,
      #ff00ff 71.42%,
      #00ff00 71.42%,
      #00ff00 85.71%,
      #00ffff 85.71%,
      #00ffff 100%
    );
    z-index: 2;
  }

  .hero-content {
    text-align: center;
    color: white;
    padding: var(--space-8) var(--space-4);
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .system-title {
    font-family: var(--font-family-mono);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    margin-bottom: var(--space-4);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    color: white;
  }

  .system-subtitle {
    font-size: 1.25rem;
    opacity: 0.95;
    margin-bottom: var(--space-4);
  }

  .system-specs {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .spec-item {
    text-align: center;
  }

  .spec-label {
    font-size: 0.75rem;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-value {
    font-family: var(--font-family-mono);
    font-size: 1rem;
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .system-specs {
      gap: var(--space-4);
    }
  }
</style>
