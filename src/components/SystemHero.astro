---
/**
 * SystemHero — the opening of a track page: the track's name in the magazine
 * face, a strapline, an optional call to action and a box of machine facts,
 * closed by an ink rule.
 *
 * Usage:
 *   <SystemHero
 *     title="Commodore 64"
 *     subtitle="Where bedroom coders became legends"
 *     specs={[{ label: 'CPU', value: 'MOS 6510' }, ...]}
 *   />
 */
interface Spec {
  label: string;
  value: string;
}

interface Props {
  title: string;
  subtitle?: string;
  specs?: Spec[];
}

const {
  title,
  subtitle = 'Learn programming by building games',
  specs = [],
} = Astro.props;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<section class="system-hero">
  <h1 class="system-title" set:html={inlineMarkdown(title)} />
  {subtitle && <p class="system-subtitle" set:html={inlineMarkdown(subtitle)} />}
  <slot name="actions" />
  {specs.length > 0 && (
    <div class="system-specs">
      {specs.map((spec) => (
        <div class="spec-item">
          <div class="spec-label label">{spec.label}</div>
          <div class="spec-value">{spec.value}</div>
        </div>
      ))}
    </div>
  )}
</section>

<style>@layer blocks {
  .system-hero { padding-bottom: 40px; border-bottom: 1px solid var(--h-ink); }
  .system-title {
    margin: 0;
    /* Reserve the descender the tight line-height does not. */
    padding-bottom: 0.25em;
    color: var(--h-ink);
    font: italic 900 4rem/1.08 var(--h-font-mag);
    letter-spacing: -0.025em;
  }
  .system-subtitle { max-width: 65ch; margin: var(--h-space-4) 0 0; color: var(--h-ink-muted); font: 1.25rem/1.6 var(--h-font-ui); }

  .system-specs {
    display: inline-flex; gap: var(--h-space-6); flex-wrap: wrap; justify-content: center;
    margin-top: var(--h-space-6); padding: var(--h-space-4) var(--h-space-8);
    background: var(--h-ground); border: 3px solid var(--h-ink);
  }
  .spec-item { text-align: center; }
  .spec-label { color: var(--h-ink-muted); }
  .spec-value { margin-top: 3px; color: var(--h-ink); font-family: var(--h-font-mono); font-size: 1rem; font-weight: 700; }

  @media (max-width: 850px) { .system-title { font-size: 3rem; } }
  @media (max-width: 768px) { .system-specs { gap: var(--h-space-4); padding: var(--h-space-3) var(--h-space-4); } }
}
</style>
