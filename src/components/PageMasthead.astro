---
interface Props {
  label: string;
  note?: string;
  heading?: boolean;
  noteClass?: string;
  class?: string;
}
const { label, note, heading = false, noteClass, class: className } = Astro.props;
const Tag = heading ? 'h1' : 'span';
---
<div class:list={['page-masthead', className]}>
  <Tag class="page-masthead-label">{label}</Tag>
  <div class:list={["page-masthead-note", noteClass]}><slot>{note}</slot></div>
</div>
<style>
  .page-masthead { display: flex; align-items: stretch; justify-content: space-between; background: var(--h-ink); color: var(--h-page); min-width: 0; }
  .page-masthead-label { margin: 0; padding: 16px var(--page-gutter); background: var(--h-spot); color: var(--h-ink-on-accent); font: italic 900 clamp(28px, 3vw, 36px)/1.1 var(--h-font-mag); text-transform: uppercase; overflow-wrap: anywhere; }
  .page-masthead-note { align-self: flex-end; padding: 12px var(--page-gutter); color: var(--h-mag-yellow); font: 400 12px/1.5 var(--h-font-mono); text-align: right; }
  .page-masthead-note:empty { display: none; }
  @media (max-width: 600px) { .page-masthead { flex-wrap: wrap; } .page-masthead-note { text-align: left; } }
</style>
