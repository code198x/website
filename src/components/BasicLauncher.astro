---
interface Props {name:string}
const {name}=Astro.props;
---
<section class="basic-launcher" aria-label="Try it on the Spectrum">
<p>Start an empty 48K Spectrum, or run the finished program. No installation or ROM file needed.</p>
<div><button type="button" data-basic-launch={name} data-basic-mode="empty">Start the Spectrum</button><button type="button" data-basic-launch={name} data-basic-mode="example">Run the finished program</button></div>
<p>Using a touchscreen? <a href={`#listing-${name}`}>Edit and run the listing below.</a></p>
</section>
<style>.basic-launcher{border-block:1px solid var(--h-line);padding:24px 0;margin:24px 0}.basic-launcher div{display:flex;flex-wrap:wrap;gap:16px}.basic-launcher p{font:1rem/1.6 var(--h-font-ui)}button{font:600 1rem/1.5 var(--h-font-ui);min-height:48px;padding:12px 20px;background:var(--h-ground);color:var(--h-ink);border:1px solid var(--h-line);border-radius:0;cursor:pointer}button:first-child{background:var(--h-spot);color:white;border-color:var(--h-spot)}button:disabled{opacity:.55}button:focus-visible{outline:2px solid var(--h-spot);outline-offset:4px}</style>
