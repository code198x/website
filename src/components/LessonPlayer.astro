---
import fs from 'node:fs';
import path from 'node:path';
import catalog from '../../public/emulators/catalog.json';
interface Props { system: string; language: string; module: string; unit: number }
const {system,language,module:moduleName,unit}=Astro.props;
const entry=catalog.find(item=>item.id===system || item.aliases.includes(system));
const relative=[system,language,moduleName,`unit-${String(unit).padStart(2,'0')}`].join('/');
const directory=path.resolve('public/code-samples',relative);
// Only expose files actually staged by the lesson build. A source listing,
// snippet or missing build must never masquerade as a runnable lesson.
const formats=entry?.media.split(',').map(ext=>ext.trim()) || [];
let files=entry && fs.existsSync(directory)?fs.readdirSync(directory).filter(file=>formats.includes(path.extname(file)) && fs.statSync(path.join(directory,file)).isFile()).sort():[];
// Cumulative-step lessons publish their completed final step.
const steps=path.join(directory,'steps');
if(!files.length && entry && fs.existsSync(steps))files=fs.readdirSync(steps).filter(file=>formats.includes(path.extname(file))).sort((a,b)=>a.localeCompare(b,undefined,{numeric:true})).slice(-1).map(file=>`steps/${file}`);
---
{entry && files.length>0 && <p class="lesson-downloads">
 {files.map(file=><a href={`/code-samples/${relative}/${file}`} download={path.basename(file)}>Download {path.basename(file)}</a>)}
</p>}
{entry && files.length>0 && <details class="lesson-player">
 <summary>Run this lesson</summary>
 <p>Run the built example for this unit. Computers that need firmware will ask for your ROM files.</p>
 {files.map(file=><emu198x-player system={entry.id} variant={entry.defaultVariant} src={`/code-samples/${relative}/${file}`} example-title={file}><p>Loading player…</p></emu198x-player>)}
 <p><a href="https://emu198x.github.io/downloads/">Download Emu198x for desktop</a></p>
</details>}
{files.length>0 && <script is:inline type="module" src="/emulators/embed.js"></script>}
<style>
 .lesson-downloads { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
 .lesson-downloads a { display: inline-flex; align-items: center; min-height: 44px; }
 .lesson-player { margin-block: 2rem; border-block: 1px solid var(--color-border); padding-block: .5rem; }
 summary { cursor: pointer; min-height: 44px; padding-block: .6rem; font-weight: 600; }
 emu198x-player { display: block; margin-block: 1rem; }
</style>
