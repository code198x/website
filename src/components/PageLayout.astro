---
import type { BreadcrumbItem } from "./Breadcrumb.astro";
import Hero from "./Hero.astro";
import Breadcrumb from "./Breadcrumb.astro";

export type PageSection = {
  id?: string;
  className?: string;
  containerClass?: string;
  content?: string;
  component?: any;
  props?: Record<string, any>;
  slot?: string;
};

export interface Props {
  variant?: "default" | "hero" | "vault" | "lesson" | "legal";
  hero?: {
    title: string;
    subtitle?: string;
    description?: string;
    badge?: any;
    variant?: string;
    className?: string;
  };
  breadcrumbs?: BreadcrumbItem[];
  containerClass?: string;
  contentClass?: string;
  sections?: PageSection[];
  className?: string;
}

const {
  variant = "default",
  hero,
  breadcrumbs,
  containerClass = "container",
  contentClass = "",
  sections = [],
  className = "",
} = Astro.props;

// Variant-specific classes
const variantClasses = {
  default: "page-layout--default",
  hero: "page-layout--hero",
  vault: "page-layout--vault",
  lesson: "page-layout--lesson",
  legal: "page-layout--legal",
};

// Determine if we should show standard container wrapper
const useContainer = variant !== "hero" && variant !== "lesson";
---

<div class={`page-layout ${variantClasses[variant]} ${className}`}>
  {/* Hero Section */}
  {
    hero && (
      <Hero
        title={hero.title}
        subtitle={hero.subtitle}
        description={hero.description}
        badge={hero.badge}
        variant={(hero.variant as any) || "gradient"}
        className={hero.className}
      />
    )
  }

  {/* Main Content Area */}
  <div class={`page-content ${contentClass}`}>
    {
      useContainer ? (
        <div class={containerClass}>
          {/* Breadcrumbs */}
          {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}

          {/* Main slot for page content */}
          <slot />

          {/* Additional sections */}
          {sections.map((section) => (
            <section id={section.id} class={`page-section ${section.className || ""}`}>
              {section.containerClass ? (
                <div class={section.containerClass}>
                  {section.content && <Fragment set:html={section.content} />}
                  {section.slot && <slot name={section.slot} />}
                </div>
              ) : (
                <>
                  {section.content && <Fragment set:html={section.content} />}
                  {section.slot && <slot name={section.slot} />}
                </>
              )}
            </section>
          ))}
        </div>
      ) : (
        <>
          {/* No container wrapper for hero/lesson variants */}
          {breadcrumbs && breadcrumbs.length > 0 && (
            <div class={containerClass}>
              <Breadcrumb items={breadcrumbs} />
            </div>
          )}

          {/* Main slot */}
          <slot />

          {/* Additional sections */}
          {sections.map((section) => (
            <section id={section.id} class={`page-section ${section.className || ""}`}>
              {section.containerClass ? (
                <div class={section.containerClass}>
                  {section.content && <Fragment set:html={section.content} />}
                  {section.slot && <slot name={section.slot} />}
                </div>
              ) : (
                <>
                  {section.content && <Fragment set:html={section.content} />}
                  {section.slot && <slot name={section.slot} />}
                </>
              )}
            </section>
          ))}
        </>
      )
    }
  </div>
</div>

<style>
  .page-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1;
    padding: var(--space-xl) 0;
  }

  .page-section {
    padding: var(--space-xl) 0;
  }

  .page-section + .page-section {
    border-top: 1px solid var(--color-border);
  }

  /* Variant: Hero */
  .page-layout--hero .page-content {
    padding-top: 0;
  }

  /* Variant: Vault */
  .page-layout--vault {
    background: var(--color-background-secondary);
  }

  .page-layout--vault .page-content {
    background: linear-gradient(
      to bottom,
      var(--color-background) 0%,
      var(--color-background-secondary) 100%
    );
  }

  /* Variant: Lesson */
  .page-layout--lesson .page-content {
    padding-top: 0;
  }

  /* Variant: Legal */
  .page-layout--legal .page-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-layout--legal h1 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-lg);
  }

  .page-layout--legal h2 {
    font-size: var(--font-size-xl);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .page-layout--legal p,
  .page-layout--legal li {
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-content {
      padding: var(--space-lg) 0;
    }

    .page-section {
      padding: var(--space-lg) 0;
    }
  }
</style>
