---
export interface Props {
  title?: string;
}

const { title = "Code Like It's 198x Moment" } = Astro.props;
---

<div class="retro-moment">
  <div class="retro-moment__header">
    <div class="retro-moment__icon">
      <span class="retro-moment__year">198x</span>
      <div class="retro-moment__scan-lines"></div>
    </div>
    <h3 class="retro-moment__title">{title}</h3>
  </div>
  <div class="retro-moment__content">
    <slot />
  </div>
</div>

<style>
  .retro-moment {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary, #1a1a2e) 0%,
      var(--color-bg-tertiary, #16213e) 100%
    );
    border: 2px solid var(--color-primary, #4a9eff);
    border-radius: var(--radius-md, 6px);
    margin: var(--space-xl, 2.5rem) 0;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 4px 20px rgba(74, 158, 255, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .retro-moment::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(74, 158, 255, 0.03) 2px,
        rgba(74, 158, 255, 0.03) 4px
      );
    pointer-events: none;
  }

  .retro-moment__header {
    background: linear-gradient(
      90deg,
      var(--color-primary, #4a9eff) 0%,
      var(--color-primary-light, #6eb5ff) 100%
    );
    padding: var(--space-sm, 1rem) var(--space-md, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--space-md, 1.5rem);
    position: relative;
    overflow: hidden;
  }

  .retro-moment__header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 20px,
        rgba(255, 255, 255, 0.05) 20px,
        rgba(255, 255, 255, 0.05) 21px
      );
    pointer-events: none;
  }

  .retro-moment__icon {
    position: relative;
    width: 60px;
    height: 40px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-sm, 4px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 0.75rem;
    color: var(--color-primary-light, #6eb5ff);
    text-shadow: 0 0 8px currentColor;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .retro-moment__year {
    position: relative;
    z-index: 2;
  }

  .retro-moment__scan-lines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 1px,
        rgba(0, 0, 0, 0.3) 1px,
        rgba(0, 0, 0, 0.3) 2px
      );
    pointer-events: none;
  }

  .retro-moment__title {
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-lg, 1.125rem);
    font-weight: var(--font-weight-bold, 700);
    color: var(--color-text-on-primary, #ffffff);
    margin: 0;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.5px;
  }

  .retro-moment__content {
    padding: var(--space-lg, 2rem);
    color: var(--color-text, #ffffff);
    line-height: 1.7;
    font-size: var(--font-size-base, 1rem);
  }

  .retro-moment__content :global(p:first-child) {
    margin-top: 0;
  }

  .retro-moment__content :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Animation */
  .retro-moment {
    animation: retroGlow 3s ease-in-out infinite alternate;
  }

  @keyframes retroGlow {
    from {
      box-shadow:
        0 4px 20px rgba(74, 158, 255, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    to {
      box-shadow:
        0 4px 25px rgba(74, 158, 255, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }
  }

  /* Dark mode adjustments */
  .dark-mode .retro-moment {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary, #0f0f1e) 0%,
      var(--color-bg-tertiary, #1a1a2e) 100%
    );
    border-color: var(--color-primary-light, #6eb5ff);
  }

  .dark-mode .retro-moment__content {
    color: var(--color-text, #e0e0e0);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .retro-moment {
      margin: var(--space-lg, 2rem) -var(--space-sm, 1rem);
      border-radius: 0;
      border-left: 4px solid var(--color-primary, #4a9eff);
      border-right: none;
      border-top: none;
      border-bottom: none;
    }

    .retro-moment__header {
      padding: var(--space-sm, 1rem);
      flex-direction: column;
      text-align: center;
      gap: var(--space-sm, 1rem);
    }

    .retro-moment__content {
      padding: var(--space-md, 1.5rem);
    }
  }
</style>