---
/**
 * Figure - Image with caption and optional platform frame
 *
 * Usage:
 *   import Figure from '@components/Figure.astro';
 *   <Figure src="/images/c64/game-01/unit-08/screenshot.png" alt="Menu screen" />
 *   <Figure src="..." alt="..." caption="The completed menu" frame="c64" />
 *
 * Frames add platform-appropriate styling (CRT effect, borders)
 */

interface Props {
  src: string;           // Path to image (relative to public/)
  alt: string;           // Alt text (required for accessibility)
  caption?: string;      // Optional caption below image
  frame?: 'c64' | 'spectrum' | 'amiga' | 'nes' | 'none';  // Platform frame style
  width?: number;        // Width constraint in pixels
  clickToEnlarge?: boolean;  // Enable lightbox on click (default: true)
}

const {
  src,
  alt,
  caption,
  frame = 'none',
  width,
  clickToEnlarge = true
} = Astro.props;

const frameClass = frame !== 'none' ? `frame-${frame}` : '';
const enlargeClass = clickToEnlarge ? 'can-enlarge' : '';
---

<figure class:list={['figure', frameClass]}>
  <div class="image-wrapper">
    <img
      src={src}
      alt={alt}
      width={width}
      loading="lazy"
      decoding="async"
      class:list={[enlargeClass]}
      data-lightbox={clickToEnlarge ? 'true' : undefined}
    />
    {frame !== 'none' && <div class="frame-overlay" />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  .image-wrapper {
    position: relative;
    display: block;
    line-height: 0;
  }

  img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  img.can-enlarge {
    cursor: zoom-in;
    transition: transform 0.15s ease;
  }

  img.can-enlarge:hover {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-muted, #888);
    text-align: center;
    font-style: italic;
  }

  /* Frame overlay base */
  .frame-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
  }

  /* C64 frame - warm CRT glow */
  .frame-c64 .image-wrapper {
    border: 4px solid #4a3728;
    border-radius: 8px;
    background: #2a1f18;
    box-shadow:
      inset 0 0 30px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(108, 94, 181, 0.3);
  }

  .frame-c64 img {
    border-radius: 4px;
  }

  .frame-c64 .frame-overlay {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  /* Spectrum frame - blue/yellow border like the rubber keys */
  .frame-spectrum .image-wrapper {
    border: 4px solid #1a1a1a;
    border-radius: 4px;
    background: linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 100%);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.1),
      0 4px 8px rgba(0, 0, 0, 0.4);
  }

  .frame-spectrum::before {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 10%;
    right: 10%;
    height: 4px;
    background: linear-gradient(90deg, #d4af37 0%, #ffd700 50%, #d4af37 100%);
    border-radius: 2px;
  }

  .frame-spectrum img {
    border-radius: 2px;
  }

  /* Amiga frame - distinctive beige/orange Amiga look */
  .frame-amiga .image-wrapper {
    border: 4px solid #8b7355;
    border-radius: 6px;
    background: linear-gradient(180deg, #d4c4a8 0%, #c4b498 100%);
    padding: 8px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      0 4px 12px rgba(0, 0, 0, 0.3);
  }

  .frame-amiga img {
    border: 2px solid #2a2a2a;
    border-radius: 2px;
  }

  /* NES frame - grey cartridge style */
  .frame-nes .image-wrapper {
    border: 4px solid #555;
    border-radius: 4px;
    background: linear-gradient(180deg, #888 0%, #666 100%);
    padding: 6px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 4px 8px rgba(0, 0, 0, 0.4);
  }

  .frame-nes img {
    border: 2px solid #222;
    border-radius: 2px;
  }

  .frame-nes .frame-overlay {
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 2px,
      rgba(0, 0, 0, 0.03) 4px
    );
  }
</style>

<script>
  // Simple lightbox functionality using safe DOM methods
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'IMG' && target.dataset.lightbox === 'true') {
      const src = target.getAttribute('src');
      const alt = target.getAttribute('alt') || '';

      if (!src) return;

      // Create lightbox using DOM methods (safe, no innerHTML)
      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.style.cssText = `
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        cursor: zoom-out;
        animation: fadeIn 0.2s ease;
      `;

      const content = document.createElement('div');
      content.className = 'lightbox-content';
      content.style.cssText = `
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
      `;

      const img = document.createElement('img');
      img.src = src;
      img.alt = alt;
      // Fixed viewport-sized box + object-fit so small captures scale UP
      // to fill it (a 352px Spectrum screen at natural size in an overlay
      // is smaller than the inline figure it "enlarges").
      img.style.cssText = `
        width: 90vw;
        height: 90vh;
        object-fit: contain;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
      `;

      const closeBtn = document.createElement('button');
      closeBtn.className = 'lightbox-close';
      closeBtn.setAttribute('aria-label', 'Close');
      closeBtn.textContent = '\u00d7'; // × character
      closeBtn.style.cssText = `
        position: absolute;
        top: -40px;
        right: 0;
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0.5rem;
        line-height: 1;
      `;

      content.appendChild(img);
      content.appendChild(closeBtn);
      overlay.appendChild(content);

      // Close handlers
      const close = () => overlay.remove();
      overlay.addEventListener('click', close);
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      }, { once: true });

      document.body.appendChild(overlay);
    }
  });
</script>
