---
/**
 * Figure - Image with caption and optional platform frame
 *
 * Usage:
 *   import Figure from '@components/Figure.astro';
 *   <Figure src="/images/c64/game-01/unit-08/screenshot.png" alt="Menu screen" />
 *   <Figure src="..." alt="..." caption="The completed menu" frame="c64" />
 *
 * Frames add platform-appropriate styling (CRT effect, borders)
 */

interface Props {
  src: string;           // Path to image (relative to public/)
  alt: string;           // Alt text (required for accessibility)
  caption?: string;      // Optional caption below image
  frame?: 'c64' | 'spectrum' | 'amiga' | 'nes' | 'none';  // Platform frame style
  width?: number;        // Width constraint in pixels
  clickToEnlarge?: boolean;  // Enable lightbox on click (default: true)
  rendering?: 'pixelated' | 'smooth';  // 'smooth' for photographs (default: pixelated)
  credit?: string;      // Who made the picture, when it isn't us
  creditUrl?: string;   // Where it came from
  licence?: string;     // Its own licence, e.g. "CC BY-SA 2.5", where it has one
  licenceUrl?: string;  // Link to the licence deed
}

const {
  src,
  alt,
  caption,
  frame = 'none',
  width,
  clickToEnlarge = true,
  rendering = 'pixelated',
  credit,
  creditUrl,
  licence,
  licenceUrl
} = Astro.props;

const frameClass = frame !== 'none' ? `frame-${frame}` : '';
const enlargeClass = clickToEnlarge ? 'can-enlarge' : '';
---

<figure class:list={['figure', frameClass]}>
  <div class="image-wrapper">
    <img
      src={src}
      alt={alt}
      width={width}
      loading="lazy"
      decoding="async"
      class:list={[enlargeClass, rendering === 'smooth' && 'smooth']}
      data-lightbox={clickToEnlarge ? 'true' : undefined}
      data-rendering={rendering}
    />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && (
        <span class="credit">
          Photo: {creditUrl
            ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a>
            : credit}
          {licence && (
            <> &middot; {licenceUrl
              ? <a href={licenceUrl} target="_blank" rel="license noopener noreferrer">{licence}</a>
              : licence}</>
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  .image-wrapper {
    position: relative;
    display: block;
    line-height: 0;
  }

  img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* Photographs are not pixel art. Scaling one with nearest-neighbour makes
     its edges jagged, so a photograph asks for the browser's own filtering. */
  img.smooth {
    image-rendering: auto;
  }

  img.can-enlarge {
    cursor: zoom-in;
    transition: transform 0.15s ease;
  }

  img.can-enlarge:hover {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-secondary, #555);
    text-align: center;
    font-style: italic;
  }

  /* A credit is not the caption talking; it is the small print that says whose
     picture this is. Subordinate to the caption, but still plainly readable —
     a licence that requires attribution is not met by a credit nobody can see. */
  .credit {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* C64 frame - warm CRT glow */
  .frame-c64 .image-wrapper {
    border: 4px solid #4a3728;
    border-radius: 8px;
    background: #2a1f18;
    box-shadow:
      inset 0 0 30px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(108, 94, 181, 0.3);
  }

  .frame-c64 img {
    border-radius: 4px;
  }

  /* Spectrum frame - dark border like the rubber keys */
  .frame-spectrum .image-wrapper {
    border: 4px solid #1a1a1a;
    border-radius: 4px;
    background: linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 100%);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.1),
      0 4px 8px rgba(0, 0, 0, 0.4);
  }

  .frame-spectrum img {
    border-radius: 2px;
  }

  /* Amiga frame - distinctive beige/orange Amiga look */
  .frame-amiga .image-wrapper {
    border: 4px solid #8b7355;
    border-radius: 6px;
    background: linear-gradient(180deg, #d4c4a8 0%, #c4b498 100%);
    padding: 8px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      0 4px 12px rgba(0, 0, 0, 0.3);
  }

  .frame-amiga img {
    border: 2px solid #2a2a2a;
    border-radius: 2px;
  }

  /* NES frame - grey cartridge style */
  .frame-nes .image-wrapper {
    border: 4px solid #555;
    border-radius: 4px;
    background: linear-gradient(180deg, #888 0%, #666 100%);
    padding: 6px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 4px 8px rgba(0, 0, 0, 0.4);
  }

  .frame-nes img {
    border: 2px solid #222;
    border-radius: 2px;
  }

</style>

<script>
  // Simple lightbox functionality using safe DOM methods
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'IMG' && target.dataset.lightbox === 'true') {
      const src = target.getAttribute('src');
      const alt = target.getAttribute('alt') || '';
      const rendering = target.dataset.rendering === 'smooth' ? 'auto' : 'pixelated';

      if (!src) return;

      // Create lightbox using DOM methods (safe, no innerHTML)
      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.style.cssText = `
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        cursor: zoom-out;
        animation: fadeIn 0.2s ease;
      `;

      const content = document.createElement('div');
      content.className = 'lightbox-content';
      content.style.cssText = `
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
      `;

      const img = document.createElement('img');
      img.src = src;
      img.alt = alt;
      // Fixed viewport-sized box + object-fit so small captures scale UP
      // to fill it (a 352px Spectrum screen at natural size in an overlay
      // is smaller than the inline figure it "enlarges").
      img.style.cssText = `
        width: 90vw;
        height: 90vh;
        object-fit: contain;
        image-rendering: ${rendering};
      `;

      const closeBtn = document.createElement('button');
      closeBtn.className = 'lightbox-close';
      closeBtn.setAttribute('aria-label', 'Close');
      closeBtn.textContent = '\u00d7'; // × character
      closeBtn.style.cssText = `
        position: absolute;
        top: -40px;
        right: 0;
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0.5rem;
        line-height: 1;
      `;

      content.appendChild(img);
      content.appendChild(closeBtn);
      overlay.appendChild(content);

      // Close handlers
      const close = () => overlay.remove();
      overlay.addEventListener('click', close);
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      }, { once: true });

      document.body.appendChild(overlay);
    }
  });
</script>
