---
/**
 * Figure - Image with caption
 *
 * Usage:
 *   import Figure from '@components/Figure.astro';
 *   <Figure src="/images/c64/game-01/unit-08/screenshot.png" alt="Menu screen" />
 */

interface Props {
  src: string;           // Path to image (relative to public/)
  alt: string;           // Alt text (required for accessibility)
  caption?: string;      // Optional caption below image
  width?: number;        // Width constraint in pixels
  clickToEnlarge?: boolean;  // Enable lightbox on click (default: true)
  rendering?: 'pixelated' | 'smooth';  // 'smooth' for photographs (default: pixelated)
  credit?: string;      // Who made the picture, when it isn't us
  creditUrl?: string;   // Where it came from
  licence?: string;     // Its own licence, e.g. "CC BY-SA 2.5", where it has one
  licenceUrl?: string;  // Link to the licence deed
}

const {
  src,
  alt,
  caption,
  width,
  clickToEnlarge = true,
  rendering = 'pixelated',
  credit,
  creditUrl,
  licence,
  licenceUrl
} = Astro.props;

const enlargeClass = clickToEnlarge ? 'can-enlarge' : '';
import { inlineMarkdown } from '../lib/inline-markdown';
---

<figure class="figure">
  <div class="image-wrapper">
    <img
      src={src}
      alt={alt}
      width={width}
      loading="lazy"
      decoding="async"
      class:list={[enlargeClass, rendering === 'smooth' && 'smooth']}
      data-lightbox={clickToEnlarge ? 'true' : undefined}
      data-rendering={rendering}
    />
  </div>
  {(caption || credit) && (
    <figcaption>
      <Fragment set:html={inlineMarkdown(caption)} />
      {credit && (
        <span class="credit">
          Photo: {creditUrl
            ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a>
            : credit}
          {licence && (
            <> &middot; {licenceUrl
              ? <a href={licenceUrl} target="_blank" rel="license noopener noreferrer">{licence}</a>
              : licence}</>
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: var(--space-6, 1.5rem) 0;
    padding: 0;
  }

  .image-wrapper {
    position: relative;
    display: block;
    line-height: 0;
  }

  img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* Photographs are not pixel art. Scaling one with nearest-neighbour makes
     its edges jagged, so a photograph asks for the browser's own filtering. */
  img.smooth {
    image-rendering: auto;
  }

  img.can-enlarge {
    cursor: zoom-in;
    transition: transform 0.15s ease;
  }

  /* A capture is evidence: scaling it by anything but a whole number makes
     some source pixels wider than others. Only photographs grow on hover. */
  img.can-enlarge.smooth:hover {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-text-secondary, #555);
    text-align: left;
    font-style: italic;
    max-width: 768px;
  }

  /* A credit is not the caption talking; it is the small print that says whose
     picture this is. Subordinate to the caption, but still plainly readable —
     a licence that requires attribution is not met by a credit nobody can see. */
  .credit {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

</style>

<script>
  // Pixel captures render at the largest whole multiple of their native size
  // that fits, so every source pixel stays the same size. Narrower than native
  // (a phone) cannot be whole, so the image falls back to fitting the column.
  function wholeScale(available: number, natural: number): number {
    return Math.floor(available / natural);
  }

  function fitPixelFigure(img: HTMLImageElement) {
    if (img.dataset.rendering === 'smooth' || !img.naturalWidth) return;
    const box = img.parentElement;
    if (!box) return;
    const k = wholeScale(box.clientWidth, img.naturalWidth);
    img.style.width = k >= 1 ? `${img.naturalWidth * k}px` : '';
  }

  function fitAllPixelFigures() {
    document.querySelectorAll<HTMLImageElement>('.figure img').forEach((img) => {
      if (img.complete) fitPixelFigure(img);
      else img.addEventListener('load', () => fitPixelFigure(img), { once: true });
    });
  }

  fitAllPixelFigures();
  document.addEventListener('astro:page-load', fitAllPixelFigures);
  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(fitAllPixelFigures, 100);
  });

  // Simple lightbox functionality using safe DOM methods
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'IMG' && target.dataset.lightbox === 'true') {
      const src = target.getAttribute('src');
      const alt = target.getAttribute('alt') || '';
      const rendering = target.dataset.rendering === 'smooth' ? 'auto' : 'pixelated';

      if (!src) return;

      // Create lightbox using DOM methods (safe, no innerHTML)
      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.style.cssText = `
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        cursor: zoom-out;
        animation: fadeIn 0.2s ease;
      `;

      const content = document.createElement('div');
      content.className = 'lightbox-content';
      content.style.cssText = `
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
      `;

      const img = document.createElement('img');
      img.src = src;
      img.alt = alt;
      // Fixed viewport-sized box + object-fit so small captures scale UP
      // to fill it (a 352px Spectrum screen at natural size in an overlay
      // is smaller than the inline figure it "enlarges").
      if (rendering === 'pixelated' && target instanceof HTMLImageElement && target.naturalWidth) {
        // Largest whole multiple that fits the overlay, as inline.
        const nw = target.naturalWidth, nh = target.naturalHeight;
        const k = Math.max(1, Math.floor(Math.min((window.innerWidth * 0.9) / nw, (window.innerHeight * 0.9) / nh)));
        img.style.cssText = `
          width: ${nw * k}px;
          height: ${nh * k}px;
          image-rendering: pixelated;
        `;
      } else {
        img.style.cssText = `
          width: 90vw;
          height: 90vh;
          object-fit: contain;
          image-rendering: ${rendering};
        `;
      }

      const closeBtn = document.createElement('button');
      closeBtn.className = 'lightbox-close';
      closeBtn.setAttribute('aria-label', 'Close');
      closeBtn.textContent = '\u00d7'; // × character
      closeBtn.style.cssText = `
        position: absolute;
        top: -40px;
        right: 0;
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0.5rem;
        line-height: 1;
      `;

      content.appendChild(img);
      content.appendChild(closeBtn);
      overlay.appendChild(content);

      // Close handlers
      const close = () => overlay.remove();
      overlay.addEventListener('click', close);
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      }, { once: true });

      document.body.appendChild(overlay);
    }
  });
</script>
