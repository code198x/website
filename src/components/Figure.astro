---
/**
 * Figure - A capture or picture, with its caption.
 *
 * Usage:
 *   import Figure from '@components/Figure.astro';
 *   <Figure src="/images/c64/game-01/unit-08/screenshot.png" alt="Menu screen" />
 *
 * Drawn by the kit's Figure (_198x-ui/components/Figure.astro), with the site's
 * props kept so no lesson changes:
 *
 * - A machine's screen (pixelated, a PNG under /images/<system>/) is a
 *   `capture`: the kit's Screen bezel, at a whole multiple of its true grid
 *   (family-visual-identity.md §7). The grid is read from the PNG at build
 *   time (src/lib/capture-grid.ts), so a capture stored doubled, as every
 *   Amiga capture is, is declared rather than guessed.
 * - Anything else, and anything marked `rendering="smooth"`, is an `image`:
 *   rounded, a hairline edge, never stretched.
 * - `width`, where given, caps the size: a capture takes the largest whole
 *   multiple of its grid that is no wider. Without it a capture may reach 2x.
 * - Captions and credits sit in the kit's Literata italic caption.
 * - `clickToEnlarge` (default true) opens the capture at the largest whole
 *   multiple that fits the window.
 */
import KitFigure from '@198x-ui/components/Figure.astro';
import { captureGrid } from '../lib/capture-grid';
import { inlineMarkdown } from '../lib/inline-markdown';

interface Props {
  src: string;           // Path to image (relative to public/)
  alt: string;           // Alt text (required for accessibility)
  caption?: string;      // Optional caption below image
  width?: number;        // Width constraint in pixels
  clickToEnlarge?: boolean;  // Enable lightbox on click (default: true)
  rendering?: 'pixelated' | 'smooth';  // 'smooth' for photographs (default: pixelated)
  credit?: string;      // Who made the picture, when it isn't us
  creditUrl?: string;   // Where it came from
  licence?: string;     // Its own licence, e.g. "CC BY-SA 2.5", where it has one
  licenceUrl?: string;  // Link to the licence deed
}

const {
  src,
  alt,
  caption,
  width,
  clickToEnlarge = true,
  rendering = 'pixelated',
  credit,
  creditUrl,
  licence,
  licenceUrl
} = Astro.props;

const grid = rendering === 'smooth' ? null : captureGrid(src);
// A machine screen lives under /images/<system>/; diagrams, photographs and
// scans elsewhere are pictures, not screens, and take no bezel.
const isCapture = Boolean(grid) && /^\/images\/(?!vault\/|field-notes\/|photos\/)[a-z0-9-]+\//.test(src);
const maxScale = isCapture && grid
  ? (width ? Math.max(1, Math.floor(width / grid.w)) : 2)
  : undefined;
const declared = isCapture && grid && (grid.w !== grid.width || grid.h !== grid.height) ? { w: grid.w, h: grid.h } : undefined;
const hasCaption = Boolean(caption || credit);
---

<div class:list={['figure', isCapture ? 'figure-capture' : 'figure-image', rendering === 'smooth' && 'smooth', clickToEnlarge && 'can-enlarge']} data-lightbox={clickToEnlarge ? 'true' : undefined} data-rendering={rendering} style={!isCapture && width ? `--figure-max: ${width}px` : undefined}>
  {isCapture && grid ? (
    <KitFigure kind="capture" src={src} alt={alt} width={grid.width} height={grid.height} grid={declared} maxScale={maxScale}>
      {hasCaption && <Fragment slot="caption"><Fragment set:html={inlineMarkdown(caption)} />{credit && <span class="credit">Photo: {creditUrl ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}{licence && <> &middot; {licenceUrl ? <a href={licenceUrl} target="_blank" rel="license noopener noreferrer">{licence}</a> : licence}</>}</span>}</Fragment>}
    </KitFigure>
  ) : !grid ? (
    /* A picture whose size the build cannot read (not a PNG): the kit's image
       treatment, drawn here because the kit's Figure needs the file's size. */
    <figure class="h-figure-like">
      <img class="figure-plain-img" src={src} alt={alt} width={width} loading="lazy" decoding="async" />
      {hasCaption && <figcaption class="figure-plain-caption"><Fragment set:html={inlineMarkdown(caption)} />{credit && <span class="credit">Photo: {creditUrl ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}{licence && <> &middot; {licenceUrl ? <a href={licenceUrl} target="_blank" rel="license noopener noreferrer">{licence}</a> : licence}</>}</span>}</figcaption>}
    </figure>
  ) : (
    <KitFigure kind="image" src={src} alt={alt} width={grid.width} height={grid.height}>
      {hasCaption && <Fragment slot="caption"><Fragment set:html={inlineMarkdown(caption)} />{credit && <span class="credit">Photo: {creditUrl ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}{licence && <> &middot; {licenceUrl ? <a href={licenceUrl} target="_blank" rel="license noopener noreferrer">{licence}</a> : licence}</>}</span>}</Fragment>}
    </KitFigure>
  )}
</div>

<style>
  .figure {
    margin: var(--h-space-8) 0;
    padding: 0;
  }

  /* The kit sizes an image to its file or its cell; a `width` prop caps it. */
  .figure-image :global(.h-figure-img) { max-width: min(100%, var(--figure-max, 100%)); }
  /* Pixel art that is not a screen still keeps its pixels square. */
  .figure-image:not(.smooth) :global(.h-figure-img) { image-rendering: pixelated; }
  .h-figure-like { display: grid; justify-items: start; gap: calc(var(--h-cell) * 1.5); margin: 0; }
  .figure-plain-img {
    display: block;
    max-width: min(100%, var(--figure-max, 100%));
    height: auto;
    border-radius: 0.75rem;
    outline: 1px solid var(--h-line);
    outline-offset: -1px;
  }
  .figure-image:not(.smooth) .figure-plain-img { image-rendering: pixelated; }
  .figure-plain-caption {
    max-width: var(--h-measure);
    font-family: var(--h-font-read);
    font-style: italic;
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
    color: var(--h-ink-muted);
  }

  .can-enlarge :global(.h-screen-img),
  .can-enlarge :global(.h-figure-img),
  .can-enlarge .figure-plain-img { cursor: zoom-in; }

  /* A credit is not the caption talking; it is the small print that says whose
     picture this is. Subordinate to the caption, but still plainly readable —
     a licence that requires attribution is not met by a credit nobody can see. */
  .credit {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: var(--h-text-micro);
    line-height: var(--h-lh-micro);
    /* Subordinate by size, not by fading: opacity took the muted ink to 3.27:1. */
    color: var(--h-ink-muted);
  }

  .credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>

<script>
  // Enlarge: the capture at the largest whole multiple of its true grid that
  // fits the window (§7), or a picture fitted to it. A native <dialog>, so it
  // traps focus, closes on Escape and returns focus to the page by itself.
  function open(target: HTMLImageElement, rendering: string) {
    const dialog = document.createElement('dialog');
    dialog.className = 'figure-lightbox';
    dialog.setAttribute('aria-label', target.alt ? `Enlarged: ${target.alt}` : 'Enlarged picture');
    const img = document.createElement('img');
    img.src = target.currentSrc || target.src;
    img.alt = target.alt;
    const screen = target.closest<HTMLElement>('[data-h-screen]');
    const gw = Number(screen?.dataset.gw) || target.naturalWidth;
    const gh = Number(screen?.dataset.gh) || target.naturalHeight;
    if (rendering !== 'smooth' && gw) {
      const k = Math.max(1, Math.floor(Math.min((innerWidth * 0.9) / gw, (innerHeight * 0.85) / gh)));
      img.style.width = `${gw * k}px`;
      img.style.height = `${gh * k}px`;
      img.style.imageRendering = 'pixelated';
    }
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'figure-lightbox-close';
    close.textContent = 'Close';
    close.addEventListener('click', () => dialog.close());
    dialog.append(close, img);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => dialog.remove());
    document.body.append(dialog);
    dialog.showModal();
  }

  if (!(window as unknown as { __figureLightbox?: boolean }).__figureLightbox) {
    (window as unknown as { __figureLightbox?: boolean }).__figureLightbox = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!(target instanceof HTMLImageElement)) return;
      const figure = target.closest<HTMLElement>('.figure[data-lightbox="true"]');
      if (!figure || !target.matches('.h-screen-img, .h-figure-img, .figure-plain-img')) return;
      open(target, figure.dataset.rendering ?? 'pixelated');
    });
  }
</script>

<style is:global>
  dialog.figure-lightbox {
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
  }
  dialog.figure-lightbox::backdrop { background: rgb(5 5 5 / 0.85); }
  dialog.figure-lightbox img { display: block; max-width: 90vw; max-height: 85vh; width: auto; height: auto; object-fit: contain; }
  dialog.figure-lightbox img[style*="pixelated"] { max-width: none; max-height: none; }
  .figure-lightbox-close {
    display: block;
    margin: 0 0 var(--h-cell) auto;
    min-height: calc(var(--h-cell) * 5);
    padding: 0 calc(var(--h-cell) * 2);
    border: 1px solid rgb(239 231 214 / 0.3);
    border-radius: 0;
    background: #0d0c0a;
    color: #efe7d6;
    font: var(--h-weight-minor) var(--h-text-micro) var(--h-font-ui);
    cursor: pointer;
  }
  .figure-lightbox-close:hover,
  .figure-lightbox-close:focus-visible { background: #242019; }
</style>
