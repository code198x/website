---
export interface Props {
  class?: string;
  "data-language"?: string;
}

const { class: className, "data-language": dataLanguage } = Astro.props;

// Extract language from MDX className (format: language-xxx)
const detectedLanguage =
  dataLanguage || (className && className.match(/language-(\w+)/)?.[1]) || "text";
---

<div class="code-block">
  <button class="code-block__copy" aria-label="Copy code to clipboard">
    <span class="code-block__copy-icon">📋</span>
    <span class="code-block__copy-text">Copy</span>
  </button>

  <pre
    class="code-block__pre"><code class={`code-block__code ${detectedLanguage ? `language-${detectedLanguage}` : ''}`}>
    <slot />
  </code></pre>
</div>

<script is:inline>
  // Enhanced copy functionality that works with proper pre/code structure
  document.addEventListener("click", function (e) {
    const button = e.target.closest(".code-block__copy");
    if (button) {
      const codeBlock = button.closest(".code-block");
      const codeElement = codeBlock.querySelector("code");

      if (codeElement) {
        // Get the text content from the code element, preserving whitespace
        let textContent = codeElement.textContent || codeElement.innerText || "";

        // Clean up any extra whitespace at the end
        textContent = textContent.replace(/\n\s*$/, "");

        // Copy to clipboard
        navigator.clipboard
          .writeText(textContent)
          .then(() => {
            // Show feedback
            const textSpan = button.querySelector(".code-block__copy-text");
            const iconSpan = button.querySelector(".code-block__copy-icon");
            const originalText = textSpan.textContent;
            const originalIcon = iconSpan.textContent;

            textSpan.textContent = "Copied!";
            iconSpan.textContent = "✅";
            button.classList.add("code-block__copy--success");

            // Reset after 2 seconds
            setTimeout(() => {
              textSpan.textContent = originalText;
              iconSpan.textContent = originalIcon;
              button.classList.remove("code-block__copy--success");
            }, 2000);
          })
          .catch((err) => {
            console.error("Failed to copy: ", err);
            const textSpan = button.querySelector(".code-block__copy-text");
            const iconSpan = button.querySelector(".code-block__copy-icon");

            textSpan.textContent = "Failed";
            iconSpan.textContent = "❌";
            button.classList.add("code-block__copy--error");

            setTimeout(() => {
              textSpan.textContent = "Copy";
              iconSpan.textContent = "📋";
              button.classList.remove("code-block__copy--error");
            }, 2000);
          });
      }
    }
  });

  document.addEventListener("DOMContentLoaded", function () {
    // Wait for Prism and custom languages to be available
    function tryHighlight() {
      if (
        typeof window.Prism !== "undefined" &&
        window.Prism.highlightAll &&
        window.Prism.languages.asm &&
        window.Prism.languages.assembly
      ) {
        window.Prism.highlightAll();
      } else {
        setTimeout(tryHighlight, 50);
      }
    }
    tryHighlight();
  });
</script>

<style>
  /* ============================================
     Code Block Component (BEM)
     ============================================ */
  .code-block {
    position: relative;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    font-family: var(--font-family-mono);
    margin: var(--space-md) 0;
    overflow: hidden;
    border: 1px solid var(--color-border-light);
  }

  /* Title */
  .code-block__title {
    color: var(--color-warning);
    margin-bottom: var(--space-sm);
    font-size: var(--font-size-sm);
    white-space: normal;
    padding-right: var(--space-3xl);
    font-weight: var(--font-weight-medium);
  }

  /* Pre and Code elements */
  .code-block__pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: inherit;
    color: inherit;
    overflow-x: auto;
  }

  .code-block__code {
    color: inherit;
    background: transparent;
    padding: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  /* Copy Button */
  .code-block__copy {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-base);
    font-size: var(--font-size-xs);
    cursor: pointer;
    transition: var(--transition-base);
    z-index: var(--z-10);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-family-sans);
  }

  .code-block__copy:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .code-block__copy:active {
    transform: translateY(1px);
  }

  .code-block__copy--success {
    background: var(--color-success-light);
    border-color: var(--color-success);
    color: var(--color-success-dark);
  }

  .code-block__copy--error {
    background: var(--color-error-light);
    border-color: var(--color-error);
    color: var(--color-error-dark);
  }

  .code-block__copy-icon {
    font-size: var(--font-size-sm);
    line-height: 1;
  }

  .code-block__copy-text {
    font-weight: var(--font-weight-medium);
  }

  /* Dark Mode Overrides */
  .dark-mode .code-block {
    background: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }

  .dark-mode .code-block__copy {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }

  .dark-mode .code-block__copy:hover {
    background: var(--color-bg-primary);
    color: var(--color-text);
    border-color: var(--color-primary-light);
  }

  /* Syntax Highlighting Support */
  .code-block code[class*="language-"] {
    color: inherit;
    text-shadow: none;
    background: none;
  }

  /* Syntax highlighting now handled in global lesson-code.css */

  /* Assembly-specific highlighting also handled in global lesson-code.css */

  /* Responsive */
  @media (max-width: 640px) {
    .code-block {
      padding: var(--space-sm);
      border-radius: var(--radius-md);
    }

    .code-block__copy {
      top: var(--space-xs);
      right: var(--space-xs);
      padding: var(--space-xs);
    }

    .code-block__copy-text {
      display: none;
    }
  }
</style>
