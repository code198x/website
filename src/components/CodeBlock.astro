---
export interface Props {
  title?: string;
  language?: string;
  copyable?: boolean;
}

const { title, language = "text", copyable = true } = Astro.props;
---

<div
  class="code-block"
  style="position: relative; background: #1a202c; color: #e2e8f0; padding: 1rem; border-radius: 8px; font-family: monospace; margin: 1rem 0; overflow-x: auto;"
>
  {
    copyable && (
      <button
        class="copy-button"
        style="position: absolute; top: 0.5rem; right: 0.5rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; cursor: pointer; transition: background 0.2s; z-index: 10;"
        onmouseover="this.style.background='rgba(255,255,255,0.2)'"
        onmouseout="this.style.background='rgba(255,255,255,0.1)'"
      >
        📋 Copy
      </button>
    )
  }

  {
    title && (
      <div style="color: #fbbf24; margin-bottom: 0.5rem; font-size: 0.875rem; white-space: normal; padding-right: 5rem;">
        {title}
      </div>
    )
  }

  <pre style="margin: 0; white-space: pre-wrap; font-family: inherit; color: inherit; overflow-x: auto;"><code class={language ? `language-${language}` : ''}><slot /></code></pre>
</div>

<script is:inline>
  // Enhanced copy functionality that works with proper pre/code structure
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('copy-button')) {
      const button = e.target;
      const codeBlock = button.closest('.code-block');
      const codeElement = codeBlock.querySelector('code');

      if (codeElement) {
        // Get the text content from the code element, preserving whitespace
        let textContent = codeElement.textContent || codeElement.innerText || '';

        // Clean up any extra whitespace at the end
        textContent = textContent.replace(/\n\s*$/, '');

        // Copy to clipboard
        navigator.clipboard.writeText(textContent).then(() => {
          // Show feedback
          const originalText = button.textContent;
          button.textContent = '✅ Copied!';
          button.style.background = 'rgba(34, 197, 94, 0.2)';

          // Reset after 2 seconds
          setTimeout(() => {
            button.textContent = originalText;
            button.style.background = 'rgba(255,255,255,0.1)';
          }, 2000);
        }).catch((err) => {
          console.error('Failed to copy: ', err);
          button.textContent = '❌ Failed';
          setTimeout(() => {
            button.textContent = '📋 Copy';
          }, 2000);
        });
      }
    }
  });

  document.addEventListener("DOMContentLoaded", function () {
    // Wait for Prism and custom languages to be available
    function tryHighlight() {
      if (
        typeof window.Prism !== "undefined" &&
        window.Prism.highlightAll &&
        window.Prism.languages.asm &&
        window.Prism.languages.assembly
      ) {
        window.Prism.highlightAll();
      } else {
        setTimeout(tryHighlight, 50);
      }
    }
    tryHighlight();
  });
</script>
