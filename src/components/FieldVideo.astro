---
/**
 * FieldVideo — an inline video figure for Field Notes, house-styled (square, 3px
 * border, chunky shadow) with crisp pixel scaling. Muted + loop + controls, no
 * autoplay (respects reduced-motion by default; the reader presses play). The
 * `reconstruction` flag marks restaged footage honestly, in the caption.
 */
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  reconstruction?: boolean;
}
const { src, poster, caption, reconstruction = false } = Astro.props;
---

<figure class="field-video">
  <video src={src} poster={poster} controls muted loop playsinline preload="metadata"></video>
  {caption && (
    <figcaption>
      {reconstruction && <span class="recon">Reconstruction</span>}
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .field-video { margin: 32px 0; }
  .field-video video {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
    border: 3px solid var(--color-text);
    box-shadow: var(--shadow-chunky);
    image-rendering: pixelated;             /* keep the retro pixels crisp when scaled */
  }
  .field-video figcaption {
    font-family: var(--font-family-mono);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-top: 10px;
  }
  .recon {
    display: inline-block;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 10px;
    color: var(--color-text);
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    padding: 1px 6px;
    margin-right: 8px;
    vertical-align: 1px;
  }
</style>
