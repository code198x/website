---
export interface Props {
  columns?: 1 | 2 | 3 | 4 | 6;
  gap?: "small" | "medium" | "large";
  variant?: "default" | "cards" | "features" | "compact";
  responsive?: boolean;
  class?: string;
}

const {
  columns = 3,
  gap = "medium",
  variant = "default",
  responsive = true,
  class: className = "",
} = Astro.props;
---

<div class={`grid grid--${variant} grid--cols-${columns} grid--gap-${gap} ${responsive ? "grid--responsive" : ""} ${className}`}>
  <slot />
</div>

