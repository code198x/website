---
import { vaultData } from "../data/vault-data.js";
import VaultEntryCard from "./VaultEntryCard.astro";

interface Props {
  currentEntry: {
    c: string; // category
    s: string; // slug
    n: string; // name
    g?: string[]; // tags
    t?: string; // type
    y?: number; // year
  };
  maxResults?: number;
  className?: string;
}

const { currentEntry, maxResults = 6, className = "" } = Astro.props;

// Using centralized category information

// Function to calculate similarity score between two entries
function calculateSimilarity(entry1: any, entry2: any): number {
  let score = 0;

  // Same category gets high score
  if (entry1.c === entry2.c) {
    score += 30;
  }

  // Same type gets medium score
  if (entry1.t && entry2.t && entry1.t === entry2.t) {
    score += 20;
  }

  // Shared tags get points
  const tags1 = entry1.g || [];
  const tags2 = entry2.g || [];
  const sharedTags = tags1.filter((tag: string) => tags2.includes(tag));
  score += sharedTags.length * 15;

  // Similar years get small bonus (within 3 years)
  if (entry1.y && entry2.y) {
    const yearDiff = Math.abs(entry1.y - entry2.y);
    if (yearDiff <= 3) {
      score += Math.max(0, 10 - yearDiff * 2);
    }
  }

  return score;
}

// Find related entries
const relatedEntries = vaultData
  .filter((entry) => entry.s !== currentEntry.s) // Exclude current entry
  .map((entry) => ({
    entry,
    similarity: calculateSimilarity(currentEntry, entry),
  }))
  .filter(({ similarity }) => similarity > 0) // Only entries with some similarity
  .sort((a, b) => b.similarity - a.similarity) // Sort by similarity score
  .slice(0, maxResults) // Limit results
  .map(({ entry }) => entry); // Extract entries

// Note: Could group entries by relationship type for enhanced presentation in future
---

{
  relatedEntries.length > 0 && (
    <section class={`related-entries ${className}`}>
      <h2 class="related-entries__title">Related Entries</h2>

      <div class="related-entries__grid">
        {relatedEntries.map((entry) => (
          <VaultEntryCard entry={entry} variant="related" maxTags={3} showYear={false} />
        ))}
      </div>

      {relatedEntries.length === maxResults && (
        <div class="related-entries__more">
          <p class="related-entries__more-text">
            Showing {maxResults} related entries.
            <a href="/vault" class="related-entries__more-link">
              Browse all entries
            </a>
          </p>
        </div>
      )}
    </section>
  )
}

<style>
  /* Main container - clean and simple */
  .related-entries {
    margin-top: var(--space-md);
    padding: var(--space-md) 0;
    background: var(--color-background);
  }

  /* Simple, clean title */
  .related-entries__title {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  /* Grid - simple and clean */
  .related-entries__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  /* Simple footer section */
  .related-entries__more {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .related-entries__more-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .related-entries__more-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    margin-left: var(--space-xs);
  }

  .related-entries__more-link:hover {
    text-decoration: underline;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .related-entries {
      margin-top: var(--space-md);
      padding: var(--space-md);
    }

    .related-entries__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .related-entries__title {
      font-size: var(--font-size-lg);
    }
  }
</style>
