---
export interface Props {
  variant?: "default" | "system" | "feature" | "content" | "lesson";
  href?: string;
  headerColor?: string;
  headerIcon?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  meta?: Array<{ label: string; value: string }>;
  badge?: { text: string; color?: string };
  image?: { src: string; alt: string };
  actions?: Array<{ text: string; href: string; variant?: string; style?: string }>;
  class?: string;
}

const {
  variant = "default",
  href,
  headerColor,
  headerIcon,
  title,
  subtitle,
  description,
  meta = [],
  badge,
  image,
  actions = [],
  class: className = "",
} = Astro.props;

const Component = href ? "a" : "div";
const componentProps = href ? { href } : {};
---

<Component
  {...componentProps}
  class={`card card--${variant} ${className}`}
  data-header-color={headerColor}
>
  {headerIcon && (
    <div class="card__header">
      <span class="card__icon">{headerIcon}</span>
    </div>
  )}
  
  {image && (
    <div class="card__image">
      <img src={image.src} alt={image.alt} />
    </div>
  )}
  
  <div class="card__body">
    {badge && (
      <div class="card__badge" style={badge.color ? `background-color: ${badge.color};` : ""}>
        {badge.text}
      </div>
    )}
    
    {title && <h3 class="card__title">{title}</h3>}
    {subtitle && <p class="card__subtitle">{subtitle}</p>}
    {description && <p class="card__description">{description}</p>}
    
    {meta.length > 0 && (
      <div class="card__meta">
        {meta.map((item) => (
          <div class="card__meta-item">
            <strong>{item.label}:</strong> {item.value}
          </div>
        ))}
      </div>
    )}
    
    <slot />
    
    {actions.length > 0 && (
      <div class="card__actions">
        {actions.map((action) => (
          <a 
            href={action.href} 
            class={`card__action card__action--${action.variant || 'default'}`}
            style={action.style}
          >
            {action.text}
          </a>
        ))}
      </div>
    )}
  </div>
</Component>

<style>
  .card {
    display: block;
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.2s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card--default {
    border: 1px solid var(--c64-beige-darker);
    box-shadow: var(--shadow-sm);
  }

  .card--default:hover {
    box-shadow: var(--shadow-md);
  }

  .card--system {
    border: 2px solid transparent;
    box-shadow: var(--shadow-md);
  }

  .card--system:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .card--feature {
    background: var(--card-background, white);
    border: 1px solid var(--border-color, #e2e8f0);
  }

  .card--content {
    padding: var(--space-lg);
    background: #f8f9fa;
    border: 1px solid #dee2e6;
  }

  .card--lesson {
    background: white;
    border: 2px solid var(--c64-beige-darker);
    transition: all 0.3s ease;
  }

  .card--lesson:hover {
    border-color: var(--brand-blue);
    box-shadow: var(--shadow-lg);
  }

  a.card {
    text-decoration: none;
    color: inherit;
  }

  .card__header {
    padding: var(--space-2xl);
    background: var(--header-bg, var(--c64-light-gray));
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
  }

  .card[data-header-color="system-c64"] .card__header {
    background: linear-gradient(135deg, var(--c64-blue) 0%, var(--c64-light-blue) 100%);
  }

  .card[data-header-color="system-spectrum"] .card__header {
    background: linear-gradient(135deg, var(--spectrum-black) 0%, var(--spectrum-blue) 100%);
  }

  .card[data-header-color="system-nes"] .card__header {
    background: linear-gradient(135deg, var(--nes-red) 0%, var(--nes-gray) 100%);
  }

  .card[data-header-color="system-amiga"] .card__header {
    background: linear-gradient(135deg, var(--amiga-orange) 0%, var(--amiga-red) 100%);
  }

  .card__icon {
    font-size: 3rem;
  }

  .card__image {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .card__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .card__body {
    padding: var(--space-lg);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card--content .card__body {
    padding: 0;
  }

  .card__badge {
    display: inline-block;
    padding: var(--space-xs) var(--space-md);
    background: var(--brand-amber);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 var(--space-md) 0;
    font-family: var(--font-heading);
  }

  .card--feature .card__title {
    font-size: 1.125rem;
  }

  .card__subtitle {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 var(--space-md) 0;
  }

  .card__description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-lg) 0;
    flex-grow: 1;
  }

  .card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-light);
  }

  .card__meta-item {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .card__meta-item strong {
    color: var(--text-primary);
  }

  .card__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: auto;
  }

  .card__action {
    display: block;
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    text-align: center;
    border-radius: var(--radius-md);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .card__action--default {
    background: var(--brand-blue);
    color: var(--text-inverse);
  }

  .card__action--default:hover {
    background: var(--brand-blue-dark);
    transform: translateY(-1px);
  }

  .card__action--secondary {
    background: var(--brand-gray);
    color: white;
  }

  .card__action--secondary:hover {
    background: var(--brand-gray-dark);
  }

  @media (max-width: 768px) {
    .card__header {
      padding: var(--space-xl);
      min-height: 6rem;
    }

    .card__icon {
      font-size: 2rem;
    }
  }
</style>