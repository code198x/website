---
export interface Props {
  variant?: "default" | "system" | "feature" | "content" | "lesson";
  href?: string;
  headerColor?: string;
  headerIcon?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  meta?: Array<{ label: string; value: string }>;
  badge?: { text: string; color?: string };
  image?: { src: string; alt: string };
  actions?: Array<{ text: string; href: string; variant?: string; style?: string }>;
  class?: string;
}

const {
  variant = "default",
  href,
  headerColor,
  headerIcon,
  title,
  subtitle,
  description,
  meta = [],
  badge,
  image,
  actions = [],
  class: className = "",
} = Astro.props;

const Component = href ? "a" : "div";
const componentProps = href ? { href } : {};
---

<Component
  {...componentProps}
  class={`card card--${variant} ${className}`}
  data-header-color={headerColor}
>
  {headerIcon && (
    <div class="card__header">
      <span class="card__icon">{headerIcon}</span>
    </div>
  )}
  
  {image && (
    <div class="card__image">
      <img src={image.src} alt={image.alt} />
    </div>
  )}
  
  <div class="card__body">
    {badge && (
      <div class="card__badge" style={badge.color ? `background-color: ${badge.color};` : ""}>
        {badge.text}
      </div>
    )}
    
    {title && <h3 class="card__title">{title}</h3>}
    {subtitle && <p class="card__subtitle">{subtitle}</p>}
    {description && <p class="card__description">{description}</p>}
    
    {meta.length > 0 && (
      <div class="card__meta">
        {meta.map((item) => (
          <div class="card__meta-item">
            <strong>{item.label}:</strong> {item.value}
          </div>
        ))}
      </div>
    )}
    
    <slot />
    
    {actions.length > 0 && (
      <div class="card__actions">
        {actions.map((action) => (
          <a 
            href={action.href} 
            class={`card__action card__action--${action.variant || 'default'}`}
            style={action.style}
          >
            {action.text}
          </a>
        ))}
      </div>
    )}
  </div>
</Component>

