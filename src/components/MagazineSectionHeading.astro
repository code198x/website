---
/** A display heading paired with its introduction. Slots allow authored line breaks. */
interface Props { id: string; ending?: 'standard' | 'none' }
const { id, ending = 'standard' } = Astro.props;
---
<div class="section-heading" data-ending={ending}>
  <h2 id={id}><slot name="title" /></h2>
  <p><slot /></p>
</div>
<style>
  .section-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: end; margin-bottom: 40px; }
  .section-heading[data-ending='none'] { margin-bottom: 0; }
  h2 { margin: 0; font-family: var(--h-font-mag); font-style: italic; font-weight: 900; font-size: 3rem; line-height: 1.1666667; letter-spacing: -.02em; text-wrap: balance; }
  h2 :global(em) { font-style: inherit; color: var(--h-spot-ink); }
  p { margin: 0; max-width: 70ch; color: var(--h-ink-body); font: 1.25rem/1.6 var(--h-font-ui); }
  @media (max-width: 900px) { .section-heading { gap: 24px; } }
  @media (max-width: 740px) {
    .section-heading { grid-template-columns: 1fr; gap: 20px; }
    h2 { font-size: 2.5rem; }
  }
</style>
