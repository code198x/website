---
export interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

// Support legacy interface
interface LegacySegment {
  text: string;
  href: string;
}

interface Props {
  items?: BreadcrumbItem[];
  segments?: LegacySegment[]; // Legacy support
  className?: string;
}

const { items: itemsProp, segments, className = "" } = Astro.props;

// Convert legacy segments to new items format, or use items directly
const items: BreadcrumbItem[] =
  itemsProp ||
  (segments
    ? segments.map((segment) => ({
        label: segment.text,
        href: segment.href,
        icon: undefined,
      }))
    : []);
---

{
  items.length > 0 && (
    <nav class={`breadcrumb ${className}`} aria-label="Breadcrumb navigation">
      <div class="container">
        <ol class="breadcrumb__list">
          {items.map((item, index) => (
            <li class="breadcrumb__item">
              {item.href ? (
                <a href={item.href} class="breadcrumb__link">
                  {item.icon && (
                    <span class="breadcrumb__icon" aria-hidden="true">
                      {item.icon}
                    </span>
                  )}
                  <span>{item.label}</span>
                </a>
              ) : (
                <span class="breadcrumb__current" aria-current="page">
                  {item.icon && (
                    <span class="breadcrumb__icon" aria-hidden="true">
                      {item.icon}
                    </span>
                  )}
                  <span>{item.label}</span>
                </span>
              )}
              {index < items.length - 1 && (
                <span class="breadcrumb__separator" aria-hidden="true">
                  ›
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<style>
  .breadcrumb {
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb__link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
    background: transparent;
  }

  .breadcrumb__link:hover {
    color: var(--color-primary);
    background: var(--color-bg-secondary);
  }

  .breadcrumb__current {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    background: var(--color-bg-secondary);
    border-radius: 0.375rem;
  }

  .breadcrumb__icon {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .breadcrumb__separator {
    color: var(--color-text-tertiary);
    font-weight: 300;
    user-select: none;
    margin: 0 0.25rem;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .breadcrumb {
      padding: 0.5rem 0;
    }

    .breadcrumb__list {
      gap: 0.375rem;
    }

    .breadcrumb__link,
    .breadcrumb__current {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }

    .breadcrumb__icon {
      font-size: 0.7rem;
    }

    .breadcrumb__separator {
      margin: 0 0.125rem;
    }
  }
</style>
