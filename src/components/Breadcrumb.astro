---
export interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

// Support legacy interface
interface LegacySegment {
  text: string;
  href: string;
}

interface Props {
  items?: BreadcrumbItem[];
  segments?: LegacySegment[]; // Legacy support
  className?: string;
}

const { items: itemsProp, segments, className = "" } = Astro.props;

// Convert legacy segments to new items format, or use items directly
const items: BreadcrumbItem[] = itemsProp || (segments ? segments.map(segment => ({
  label: segment.text,
  href: segment.href,
  icon: undefined
})) : []);
---

{
  items.length > 0 && (
    <nav class={`breadcrumb ${className}`} aria-label="Breadcrumb navigation">
      <ol class="breadcrumb__list">
        {items.map((item, index) => (
          <li class="breadcrumb__item">
            {item.href ? (
              <a href={item.href} class="breadcrumb__link">
                {item.icon && <span class="breadcrumb__icon" aria-hidden="true">{item.icon}</span>}
                <span>{item.label}</span>
              </a>
            ) : (
              <span class="breadcrumb__current" aria-current="page">
                {item.icon && <span class="breadcrumb__icon" aria-hidden="true">{item.icon}</span>}
                <span>{item.label}</span>
              </span>
            )}
            {index < items.length - 1 && (
              <span class="breadcrumb__separator" aria-hidden="true">›</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .breadcrumb {
    margin-bottom: var(--space-md);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .breadcrumb__link {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .breadcrumb__link:hover {
    color: var(--color-primary);
    background: var(--color-background-secondary);
  }

  .breadcrumb__current {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .breadcrumb__icon {
    font-size: var(--font-size-xs);
    opacity: 0.8;
  }

  .breadcrumb__separator {
    color: var(--color-text-tertiary);
    font-weight: 300;
    user-select: none;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .breadcrumb__list {
      gap: var(--space-2xs);
    }

    .breadcrumb__link,
    .breadcrumb__current {
      font-size: var(--font-size-xs);
      padding: var(--space-xs) var(--space-2xs);
    }

    .breadcrumb__icon {
      font-size: 0.75rem;
    }
  }
</style>
