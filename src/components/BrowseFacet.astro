---
/**
 * BrowseFacet — shared shell for the data-driven /browse/ facet pages
 * (by-platform, by-era, by-region). Server-rendered, so scoped styles apply.
 * Renders the house header + grouped system cards with the honest tier treatment.
 */
interface Sys { slug: string; name: string; year: number; maker: string; tier: string; country: string; color: string }
interface Group { label: string; sublabel?: string; systems: Sys[] }
interface Props { title: string; intro: string; groups: Group[] }

const { title, intro, groups } = Astro.props;
const active = (t: string) => t === 'live' || t === 'next';
const STAMP: Record<string, string> = { live: 'LIVE', next: 'NEXT' };
---

<div class="wrap">
  <div class="vhead">
    <h1>{title}</h1>
    <div class="herorule"></div>
    <p class="intro">{intro}</p>
  </div>

  {groups.map(group => (
    <section class="group">
      <div class="ghead">
        <h2>{group.label}</h2>
        {group.sublabel && <span class="gsub">{group.sublabel}</span>}
        <span class="gcount">{group.systems.length}</span>
      </div>
      <div class="grid">
        {group.systems.map(s => (
          <a href={`/${s.slug}`} class={`syscard ${s.tier} ${active(s.tier) ? 'active' : ''}`} style={active(s.tier) ? `--pc: ${s.color}` : ''}>
            {STAMP[s.tier] && <span class={`stamp ${s.tier}`}>{STAMP[s.tier]}</span>}
            <div class="top"><span>{s.year} · {s.maker}</span><span class="ctry">{s.country}</span></div>
            <div class="name">{s.name}</div>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-4) var(--space-6) var(--space-16); }
  .vhead { margin: 0 0 var(--space-8); }
  .vhead h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(2.8rem, 7vw, 4.4rem); line-height: 0.86; margin: 0; color: var(--color-text); }
  .herorule { height: 9px; width: 180px; max-width: 70%; background: var(--color-house); position: relative; margin: var(--space-3) 0 0; }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .intro { font-size: 1rem; max-width: 70ch; margin: var(--space-3) 0 0; color: var(--color-text-secondary); }

  .group { margin-top: var(--space-8); }
  .ghead { display: flex; align-items: baseline; gap: var(--space-3); border-bottom: 3px solid var(--color-text); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  .ghead h2 { font-family: var(--font-family-script); font-weight: 700; font-size: 1.8rem; line-height: 1; margin: 0; }
  .gsub { font-family: var(--font-family-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-secondary); }
  .gcount { margin-left: auto; font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-3); }
  .syscard { position: relative; display: block; border: 2px solid var(--color-text); background: var(--color-surface); padding: 7px 9px 8px; text-decoration: none; color: var(--color-text); transition: transform var(--transition-base), box-shadow var(--transition-base); }
  .syscard:hover, .syscard:focus-visible { transform: translate(-2px, -2px); box-shadow: var(--shadow-chunky); }
  .syscard.live { border-width: 3px; box-shadow: var(--shadow-chunky); }
  .syscard.next { background: var(--color-house-tint); }
  .syscard.planned { border-color: var(--color-border); }
  .syscard.edge, .syscard.beyond { border-style: dashed; border-color: var(--color-text-secondary); }
  .syscard.edge .name, .syscard.beyond .name { color: var(--color-text-secondary); }
  .syscard.active { border-left-width: 6px; border-left-color: var(--pc); }
  .top { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-family-mono); font-size: 0.56rem; color: var(--color-text-secondary); }
  .ctry { background: rgb(26 24 20 / 0.08); padding: 0 4px; letter-spacing: 0.05em; }
  .name { font-weight: 700; font-size: 0.9rem; line-height: 1.1; margin-top: 2px; }
  .stamp { position: absolute; top: -9px; right: -5px; font-family: var(--font-family-mono); font-size: 0.5rem; font-weight: 700; letter-spacing: 0.1em; padding: 1px 5px; border: 2px solid var(--color-text); background: var(--color-surface); transform: rotate(5deg); }
  .stamp.next { border-color: var(--color-house-2); color: var(--color-house-2); transform: rotate(-5deg); }
</style>
