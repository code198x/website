---
/** A field, never a form: directory owners retain their facets and submit handling. */
import { Search } from '@lucide/astro';
interface Props {
  id: string;
  label: string;
  placeholder: string;
  name?: string;
  controls?: string;
  class?: string;
  appearance?: 'filter' | 'inline';
  clearLabel?: string;
}
const { id, label, placeholder, name = 'q', controls, class: className, appearance = 'filter', clearLabel = 'Clear' } = Astro.props;
---
{appearance === 'inline' ? (
  <div class:list={['directory-search', className]}>
    <label for={id}>{label}</label>
    <div class="directory-search-field">
      <Search size={20} aria-hidden="true" />
      <input id={id} name={name} type="search" placeholder={placeholder} autocomplete="off" aria-controls={controls} />
      <button type="button" data-clear>{clearLabel}</button>
    </div>
  </div>
) : (
  <label class={className} for={id}>{label}<input id={id} name={name} type="search" placeholder={placeholder} autocomplete="off" aria-controls={controls} /></label>
)}
<style>
  .directory-search label { display: block; font-size: var(--h-text-small); margin-bottom: 8px; }
  .directory-search-field { display: flex; gap: 12px; align-items: center; border: 1px solid var(--h-ink); padding-left: 12px; }
  .directory-search-field :global(svg) { flex-shrink: 0; color: var(--h-ink-muted); }
  .directory-search-field input { min-width: 0; width: 100%; border: 0; padding: 12px 0; border-radius: 0; background: transparent; color: var(--h-ink); caret-color: var(--vault-category-ink, var(--h-spot-ink)); font: 400 var(--h-text-small)/var(--h-lh-small) var(--h-font-ui); }
  .directory-search-field input::placeholder { color: var(--h-ink-muted); opacity: 1; }
  .directory-search-field button { border: 0; align-self: stretch; border-left: 1px solid var(--h-line); background: var(--h-ground); color: var(--h-ink); padding: 0 12px; font: 400 var(--h-text-micro)/var(--h-lh-micro) var(--h-font-ui); cursor: pointer; }
</style>
