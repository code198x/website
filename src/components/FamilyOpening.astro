---
import OpeningBand from './OpeningBand.astro';
interface Props { title?: string }
const { title = 'One umbrella, several missions' } = Astro.props;
---
<OpeningBand class="family-opening" labelledby="family-title" focal="right center"
  art={{ src: '/images/family-opening/landscape-2172.webp', srcset: '/images/family-opening/landscape-1280.webp 1280w, /images/family-opening/landscape-2172.webp 2172w', width: 2172, height: 724 }}
  caption="A family of imagined workshop tools, not a diagram of software dependencies.">
  <h1 id="family-title">{title}</h1>
</OpeningBand>

<style>
  @layer legacy {
  h1 { margin: 0; font: 900 italic clamp(2.75rem, 4.6cqw, 4.125rem)/.99 var(--h-font-mag); letter-spacing: -.025em; text-wrap: balance; overflow-wrap: anywhere; color: var(--h-ink); max-width: 7.5em; }
  @media (max-width: 1000px) { h1 { font-size: clamp(2.5rem, 10.8cqw, 3.625rem); max-width: 12ch; } }
  }
</style>
