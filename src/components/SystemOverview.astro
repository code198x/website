---
import PlayerStage from './PlayerStage.astro';
import Eyebrow from '@198x-ui/components/Eyebrow.astro';
import Button from '@198x-ui/components/Button.astro';
import Tile from '@198x-ui/components/Tile.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { stageWidth } from '../lib/player-posters';
interface Props {
  slug: string;
  introduction: string;
  focus: string;
  configuration: string;
  tracks: Array<{ slug: string; title: string; description: string }>;
  references: Array<{ href: string; title: string; description: string }>;
}
const { slug, introduction, focus, configuration, tracks, references } = Astro.props;
const system = await getEntry('systems', slug);
if (!system) throw new Error(`Unknown system: ${slug}`);
const units = await getCollection('unit-pages');
const routes = tracks.map(track => ({ ...track, count: units.filter(unit => unit.id.startsWith(`${slug}/${track.slug}/`)).length }));
const name = system.data.shortName ?? system.data.name;
const heroStageMax = stageWidth(slug, name);
---
<Layout title={`${system.data.name} programming`} description={introduction} platformColor={system.data.color}>
  <article class="page" style={`--system-accent: ${system.data.color}`}>
    <div class="hero" style={heroStageMax ? `--stage-max: calc(${heroStageMax}px + 1.2rem)` : undefined}>
      <header>
        <Eyebrow>Systems · Lessons available</Eyebrow>
        <h1>{system.data.name}</h1>
        <p class="lead">{introduction}</p>
        <p>{focus}</p>
        <div class="route-links">
          {tracks.map((track, i) => <Button href={`/systems/${slug}/${track.slug}`} variant={i === 0 ? 'primary' : 'secondary'}>{track.title}</Button>)}
        </div>
      </header>
      <PlayerStage system={slug} name={name} color={system.data.color}
        facts={[{ label: 'Released', value: system.data.year }, { label: 'CPU', value: system.data.cpu }]} />
    </div>
    <section aria-labelledby="routes">
      <h2 id="routes">Choose a language</h2>
      <p>Each route has its own guided sequence. You can begin without completing another
        language track or <a href="/foundations">Foundations</a>. Use shared explanations
        when they help with the program you are building.</p>
      <div class="cards">
        {routes.map(track => <Tile href={`/systems/${slug}/${track.slug}`} title={track.title} as="h3">
          {track.description} <span class="count">{track.count > 0 ? `${track.count} lesson pages` : 'Outline, no lesson pages yet'}</span>
        </Tile>)}
      </div>
      <p class="note">Counts reflect authored lesson pages. They do not mean every planned game
        is finished or every example has been checked on original hardware. Each track shows
        its available material and planned projects.</p>
    </section>
    <section aria-labelledby="configuration">
      <h2 id="configuration">Prepare the right configuration</h2>
      <p>{configuration}</p>
      <p>The <a href={`/systems/${slug}/getting-started`}>system setup guide</a> introduces
        the development tools. Check the chosen language’s setup instructions before installing
        anything. The <a href="/setup">Setup Guide</a> explains host and target, source and
        built output; the <a href="/setup/roms">ROMs guide</a> covers firmware and system files.</p>
    </section>
    <section aria-labelledby="reference">
      <h2 id="reference">Explore the machine and its games</h2>
      <p>The <a href="/vault">Vault</a> provides fuller explanations and historical context.
        These articles are optional reading alongside the lessons.</p>
      <div class="cards references">
        {references.map(ref => <Tile href={ref.href} title={ref.title} as="h3">{ref.description}</Tile>)}
      </div>
    </section>
    <section aria-labelledby="connections">
      <h2 id="connections">Follow a question further</h2>
      <p><a href="/craft">The Craft</a> develops game-design explanations; its current{' '}
        <a href="/craft/maths-for-games">Maths for Games</a> and <a href="/craft/game-feel">Game Feel</a>{' '}
        pages are outlines. The <a href="/patterns">Pattern Library</a> offers techniques
        to adapt, with their machine and language requirements.</p>
      <p>Explore <a href="/systems">other systems</a> to compare how a familiar idea changes
        with the language, memory layout or hardware. For additions to the site, read{' '}
        <a href="/updates">What’s New</a>. The <a href="/contribute">contribution guide</a>{' '}
        explains how to help.</p>
    </section>
  </article>
</Layout>
<style>
  .page { max-width: var(--container-max-width); margin: auto; padding: calc(var(--h-cell) * 10) var(--gutter) calc(var(--h-cell) * 12); }
  .hero { display: grid; gap: calc(var(--h-cell) * 6); align-items: start; margin-bottom: calc(var(--h-cell) * 6); }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(20rem, 1fr) minmax(0, var(--stage-max, auto)); } }
  /* The machine's own colour marks its page: the subject axis (§3). */
  header::before { content: ""; display: block; width: 3rem; height: 3px; margin-bottom: calc(var(--h-cell) * 3); background: var(--system-accent); }
  h1 {
    margin: calc(var(--h-cell) * 3) 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, var(--h-text-display));
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  h2 {
    margin: 0 0 calc(var(--h-cell) * 2);
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, var(--h-text-h2));
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--h-ink);
  }
  p { max-width: 68ch; color: var(--h-ink-body); }
  .lead { font-size: var(--h-text-lead); line-height: var(--h-lh-lead); }
  section { margin-top: calc(var(--h-cell) * 10); }
  .route-links { display: flex; flex-wrap: wrap; gap: calc(var(--h-cell) * 1.5); margin-top: calc(var(--h-cell) * 4); }
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: calc(var(--h-cell) * 2); margin: calc(var(--h-cell) * 4) 0; }
  .count { display: block; margin-top: var(--h-cell); font-family: var(--h-font-mono); font-size: var(--h-text-micro); color: var(--h-ink-muted); }
  .note { font-size: var(--h-text-small); color: var(--h-ink-muted); }
</style>
