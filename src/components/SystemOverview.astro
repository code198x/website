---
import Grid from './layout/Grid.astro';
import Sidebar from './layout/Sidebar.astro';
import Switcher from './layout/Switcher.astro';
import SystemLauncher from './SystemLauncher.astro';
import {learningImagery} from '../data/learning-imagery';
import HardwarePhoto from './HardwarePhoto.astro';
import { captureGrid } from '../lib/capture-grid';
import '../styles/approved-pages.css';
import '../styles/approved-learning.css';
import PageMasthead from '../components/PageMasthead.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { stageWidth } from '../lib/player-posters';
import { getSpotColour } from '../lib/platforms';
interface Props {
  slug: string;
  introduction: string;
  configuration: string;
  routeAdvice?: string;
  tracks: Array<{ slug: string; title: string; description: string }>;
  references: Array<{ href: string; title: string; description: string }>;
}
const { slug, introduction, configuration, tracks, references, routeAdvice } = Astro.props;
const system = await getEntry('systems', slug);
if (!system) throw new Error(`Unknown system: ${slug}`);
const units = await getCollection('unit-pages');
const routes = tracks.map(track => ({ ...track, count: units.filter(unit => unit.id.startsWith(`${slug}/${track.slug}/`)).length }));
const name = system.data.shortName ?? system.data.name;
const heroStageMax = stageWidth(slug, name);

const evidence = learningImagery[slug];
const evidenceGrid = evidence && captureGrid(`/images/learning/${evidence.capture}`);
---
<Layout title={`${system.data.name} programming`} description={introduction} spotColor={getSpotColour(system)}>
 <article class="approved-page learning-page">
  <Switcher as="section" threshold="35.5rem" limit={2} class="machine-masthead" style="--switcher-space: clamp(1.75rem, 3.5vw, 3rem)"><div><h1>{system.data.name}</h1><p class="machine-facts">{system.data.year} · {system.data.cpu}</p></div><HardwarePhoto system={slug} /></Switcher>
  <Sidebar as="section" side="right" sideWidth="416px" contentMin="43%" class="machine-introduction" style="--sidebar-space: clamp(2rem, 5.5vw, 5rem)"><div><h2>Make games.<br/>Understand the machine.</h2><p>{introduction}</p><a class="action" href="#language-routes">Choose a language route</a></div>
  {evidence && <div class="game-evidence"><figure class="capture" style={`--capture-width:${evidenceGrid?.w ?? evidence.width}px`}><img src={`/images/learning/${evidence.capture}`} alt={`${evidence.game}, a game from the ${name} lessons`} width={evidence.width} height={evidence.height}/><figcaption>{evidence.game} · {name}. A game you can learn to build.</figcaption></figure><a class="text-link" href={`/systems/${slug}/${evidence.route}`}>Explore {evidence.game}</a></div>}</Sidebar>
  <section class="language-routes" id="language-routes" aria-label="Language routes"><h2>Choose Your <em>Route.</em></h2>{routes.map(track=><Sidebar as="article" side="right" contentMin="69%" style="--sidebar-space: clamp(1.25rem, 3.4vw, 3rem)"><div><h3>{track.title}</h3><p>{track.description}</p><p>{track.count ? `${track.count} published lesson pages` : 'Outline; no lesson pages yet'}</p></div><div><a class="action" href={`/systems/${slug}/${track.slug}`}>Explore {track.title}</a></div></Sidebar>)}{routeAdvice&&<p>{routeAdvice}</p>}</section>
  <SystemLauncher system={slug} name={name}/>
  <section class="machine-setup"><h2>Set Up Your Machine</h2><p>{configuration}</p><div class="actions"><a class="action secondary" href={`/systems/${slug}/getting-started`}>Open the setup guide</a></div></section>
  <section class="machine-references"><h2>Follow Your <em>Curiosity.</em></h2><Grid min="17rem" maxColumns={2} style="--grid-space: clamp(1.5rem, 4.5vw, 4rem); --grid-row-space: clamp(1.5rem, 4vw, 2rem)">{references.map(ref=><article><h3><a href={ref.href}>{ref.title}</a></h3><p>{ref.description}</p></article>)}</Grid></section>
 </article>
</Layout>
