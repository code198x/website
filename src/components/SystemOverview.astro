---
import Grid from './layout/Grid.astro';
import Sidebar from './layout/Sidebar.astro';
import Switcher from './layout/Switcher.astro';
import SystemLauncher from './SystemLauncher.astro';
import {learningImagery} from '../data/learning-imagery';
import HardwarePhoto from './HardwarePhoto.astro';
import { captureGrid } from '../lib/capture-grid';
import PageMasthead from '../components/PageMasthead.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { stageWidth } from '../lib/player-posters';
import { getSpotColour } from '../lib/platforms';
interface Props {
  slug: string;
  introduction: string;
  configuration: string;
  routeAdvice?: string;
  tracks: Array<{ slug: string; title: string; description: string }>;
  references: Array<{ href: string; title: string; description: string }>;
}
const { slug, introduction, configuration, tracks, references, routeAdvice } = Astro.props;
const system = await getEntry('systems', slug);
if (!system) throw new Error(`Unknown system: ${slug}`);
const units = await getCollection('unit-pages');
const routes = tracks.map(track => ({ ...track, count: units.filter(unit => unit.id.startsWith(`${slug}/${track.slug}/`)).length }));
const name = system.data.shortName ?? system.data.name;
const heroStageMax = stageWidth(slug, name);

const evidence = learningImagery[slug];
const evidenceGrid = evidence && captureGrid(`/images/learning/${evidence.capture}`);
---
<Layout title={`${system.data.name} programming`} description={introduction} spotColor={getSpotColour(system)}>
 <article class="learning-page">
  <Switcher as="section" threshold="35.5rem" limit={2} class="machine-masthead" style="--switcher-space: clamp(1.75rem, 3.5vw, 3rem)"><div><h1 class="machine-masthead-title">{system.data.name}</h1><p class="machine-facts">{system.data.year} · {system.data.cpu}</p></div><HardwarePhoto system={slug} /></Switcher>
  <Sidebar as="section" side="right" sideWidth="416px" contentMin="43%" class="machine-introduction" style="--sidebar-space: clamp(2rem, 5.5vw, 5rem)"><div class="introduction"><h2>Make games.<br/>Understand the machine.</h2><p>{introduction}</p><a class="action" href="#language-routes">Choose a language route</a></div>
  {evidence && <div class="game-evidence"><figure class="capture" style={`--capture-width:${evidenceGrid?.w ?? evidence.width}px`}><img src={`/images/learning/${evidence.capture}`} alt={`${evidence.game}, a game from the ${name} lessons`} width={evidence.width} height={evidence.height}/><figcaption>{evidence.game} · {name}. A game you can learn to build.</figcaption></figure><a class="text-link" href={`/systems/${slug}/${evidence.route}`}>Explore {evidence.game}</a></div>}</Sidebar>
  <section class="language-routes" id="language-routes" aria-label="Language routes"><h2>Choose Your <em>Route.</em></h2>{routes.map(track=><Sidebar as="article" side="right" contentMin="69%" style="--sidebar-space: clamp(1.25rem, 3.4vw, 3rem)"><div><h3>{track.title}</h3><p>{track.description}</p><p>{track.count ? `${track.count} published lesson pages` : 'Outline; no lesson pages yet'}</p></div><div><a class="action" href={`/systems/${slug}/${track.slug}`}>Explore {track.title}</a></div></Sidebar>)}{routeAdvice&&<p>{routeAdvice}</p>}</section>
  <SystemLauncher system={slug} name={name}/>
  <section class="machine-setup"><h2>Set Up Your Machine</h2><p>{configuration}</p><div class="actions"><a class="action secondary" href={`/systems/${slug}/getting-started`}>Open the setup guide</a></div></section>
  <section class="machine-references"><h2>Follow Your <em>Curiosity.</em></h2><Grid min="17rem" maxColumns={2} style="--grid-space: clamp(1.5rem, 4.5vw, 4rem); --grid-row-space: clamp(1.5rem, 4vw, 2rem)">{references.map(ref=><article><h3><a href={ref.href}>{ref.title}</a></h3><p>{ref.description}</p></article>)}</Grid></section>
 </article>
</Layout>

<style>@layer blocks {
  /* The machine overview: a masthead with the hardware, an introduction with
     a game from the lessons, the language routes, setup and further reading,
     each closed by a hairline. */
  .learning-page {
    padding-bottom: 32px;
    background: var(--h-page);
    color: var(--h-ink);
    font: 1.25rem/1.6 var(--h-font-ui);
    scroll-behavior: smooth;
    scroll-padding-top: 24px;
    scrollbar-color: var(--h-spot) var(--h-page);
  }
  @media (prefers-reduced-motion: reduce) { .learning-page { scroll-behavior: auto; } }

  /* Base: these reach the launcher and the hardware photo too, at element
     weight, so those components' own rules still win. */
  .learning-page :global(*) { box-sizing: border-box; }
  :where(.learning-page) :global(:is(h1, h2, h3, p, figure)) { margin: 0; }
  :where(.learning-page) :global(:is(h1, h2, h3)) { text-wrap: balance; }
  :where(.learning-page) :global(p) { max-width: 70ch; color: var(--h-ink-body); }
  :where(.learning-page) :global(img) { display: block; }
  :where(.learning-page) :global(button) { border-radius: 0; color: inherit; font: inherit; cursor: pointer; }
  :where(.learning-page) :global([hidden]) { display: none !important; }
  :where(.learning-page) :global(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  :where(.learning-page) :global(a:hover) { color: var(--h-spot-ink); }
  :where(.learning-page) :global(:is(a, button):focus-visible) { outline: 3px solid var(--h-spot); outline-offset: 5px; }
  h1 em, h2 em { color: var(--h-spot-ink); font-style: inherit; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 24px; }
  .learning-page .action { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 12px 20px; border: 1px solid var(--h-spot); background: var(--h-spot); color: #fff; font-size: 1rem; font-weight: 700; text-decoration: none; }
  .learning-page .action:hover { background: var(--h-ink); color: #fff; }
  .learning-page .action.secondary { border-color: var(--h-ink); background: transparent; color: var(--h-ink); }
  .learning-page .action.secondary:hover { background: var(--h-wash); color: var(--h-ink); }

  .learning-page :global(.machine-masthead) { align-items: center; padding: 16px 0 48px; border-bottom: 1px solid var(--h-ink); }
  .machine-masthead-title { font: italic 900 6rem/1 var(--h-font-mag); letter-spacing: -0.025em; }
  .machine-facts { font-size: 1rem; }

  .learning-page :global(.machine-introduction) { align-items: center; padding: 64px 0; }
  .introduction h2 { margin-bottom: 24px; font-size: 3rem; line-height: 1.15; }
  .introduction p { margin-bottom: 24px; }
  .game-evidence .capture { position: relative; width: min(var(--capture-width), 100%); max-width: 100%; margin: 0 auto; }
  .capture img { width: 100%; height: auto; border-radius: 0; object-fit: contain; image-rendering: pixelated; }
  .capture figcaption { width: 100%; padding-top: 12px; color: var(--h-ink-muted); font-size: 0.875rem; font-style: italic; line-height: 1.45; }
  .text-link { display: inline-block; margin-top: 20px; font-size: 1rem; font-weight: 600; }

  .language-routes, .machine-references { padding: 48px 0 64px; border-top: 1px solid var(--h-line); }
  .language-routes > h2, .machine-references > h2 { margin-bottom: 36px; font: italic 900 4rem/1.05 var(--h-font-mag); letter-spacing: -0.02em; }
  .language-routes :global(article) { align-items: center; padding: 28px 0; border-top: 1px solid var(--h-line); }
  .language-routes h3 { margin-bottom: 12px; font-size: 1.5rem; line-height: 1.3; }
  .language-routes p { max-width: 55ch; }

  .machine-setup { padding: 40px 0 56px; border-top: 1px solid var(--h-line); }
  .machine-setup h2 { margin-bottom: 12px; font-size: 1.5rem; }

  .machine-references article { padding-top: 20px; border-top: 1px solid var(--h-line); }
  .machine-references h3 { margin-bottom: 8px; font-size: 1.5rem; }

  @media (max-width: 1000px) { .machine-masthead-title { font-size: 4rem; } }
  @media (max-width: 850px) { .introduction { max-width: 65ch; } }
  @media (max-width: 740px) { .actions { gap: 20px; } }
  @media (max-width: 600px) {
    .learning-page :global(.machine-masthead) { padding-bottom: 32px; }
    .machine-masthead-title { font-size: 3rem; }
    .learning-page :global(.machine-introduction) { padding: 40px 0; }
    .introduction h2 { font-size: 2.5rem; }
    .language-routes > h2, .machine-references > h2 { font-size: 3rem; }
  }
  @media (max-width: 416px) { .capture figcaption { padding-inline: 16px; } }
  @media (max-width: 351px) { .learning-page .action { gap: 16px; max-width: 100%; } }
}
</style>
