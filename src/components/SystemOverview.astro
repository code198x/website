---
import SystemLauncher from './SystemLauncher.astro';
import {learningImagery} from '../data/learning-imagery';
import HardwarePhoto from './HardwarePhoto.astro';
import '../styles/approved-pages.css';
import '../styles/approved-learning.css';
import PageMasthead from '../components/PageMasthead.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { stageWidth } from '../lib/player-posters';
import { getSpotColour } from '../lib/platforms';
interface Props {
  slug: string;
  introduction: string;
  configuration: string;
  routeAdvice?: string;
  tracks: Array<{ slug: string; title: string; description: string }>;
  references: Array<{ href: string; title: string; description: string }>;
}
const { slug, introduction, configuration, tracks, references, routeAdvice } = Astro.props;
const system = await getEntry('systems', slug);
if (!system) throw new Error(`Unknown system: ${slug}`);
const units = await getCollection('unit-pages');
const routes = tracks.map(track => ({ ...track, count: units.filter(unit => unit.id.startsWith(`${slug}/${track.slug}/`)).length }));
const name = system.data.shortName ?? system.data.name;
const heroStageMax = stageWidth(slug, name);

const evidence = learningImagery[slug];
---
<Layout masthead={false} title={`${system.data.name} programming`} description={introduction} spotColor={getSpotColour(system)}>
 <article class="approved-page learning-page">
  <section class="machine-masthead"><div><h1>{system.data.name}</h1><p class="machine-facts">{system.data.year} · {system.data.cpu}</p></div><HardwarePhoto system={slug} /></section>
  <section class="machine-introduction"><div><h2>Make games.<br/>Understand the machine.</h2><p>{introduction}</p><a class="action" href="#language-routes">Choose a language route</a></div>
  {evidence && <div class="game-evidence"><figure class="capture" style={`--capture-width:${evidence.width}px`}><img src={`/images/learning/${evidence.capture}`} alt={`${evidence.game}, a game from the ${name} lessons`} width={evidence.width} height={evidence.height}/><figcaption>{evidence.game} · {name}. A game you can learn to build.</figcaption></figure><a class="text-link" href={`/systems/${slug}/${evidence.route}`}>Explore {evidence.game}</a></div>}</section>
  <section class="language-routes" id="language-routes" aria-label="Language routes"><h2>Choose Your <em>Route.</em></h2>{routes.map(track=><article><div><h3>{track.title}</h3><p>{track.description}</p><p>{track.count ? `${track.count} published lesson pages` : 'Outline; no lesson pages yet'}</p></div><a class="action" href={`/systems/${slug}/${track.slug}`}>Explore {track.title}</a></article>)}{routeAdvice&&<p>{routeAdvice}</p>}</section>
  <SystemLauncher system={slug} name={name}/>
  <section class="machine-setup"><h2>Set Up Your Machine</h2><p>{configuration}</p><div class="actions"><a class="action secondary" href={`/systems/${slug}/getting-started`}>Open the setup guide</a></div></section>
  <section class="machine-references"><h2>Follow Your <em>Curiosity.</em></h2><div>{references.map(ref=><article><h3><a href={ref.href}>{ref.title}</a></h3><p>{ref.description}</p></article>)}</div></section>
 </article>
</Layout>
