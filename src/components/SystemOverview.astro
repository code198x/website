---
import PlayerStage from './PlayerStage.astro';
import Tile from '@198x-ui/components/Tile.astro';
import PageMasthead from '../components/PageMasthead.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { stageWidth } from '../lib/player-posters';
import { getSpotColour } from '../lib/platforms';
interface Props {
  slug: string;
  introduction: string;
  configuration: string;
  routeAdvice?: string;
  tracks: Array<{ slug: string; title: string; description: string }>;
  references: Array<{ href: string; title: string; description: string }>;
}
const { slug, introduction, configuration, tracks, references, routeAdvice } = Astro.props;
const system = await getEntry('systems', slug);
if (!system) throw new Error(`Unknown system: ${slug}`);
const units = await getCollection('unit-pages');
const routes = tracks.map(track => ({ ...track, count: units.filter(unit => unit.id.startsWith(`${slug}/${track.slug}/`)).length }));
const name = system.data.shortName ?? system.data.name;
const heroStageMax = stageWidth(slug, name);
---
<Layout masthead={false} title={`${system.data.name} programming`} description={introduction} platformColor={system.data.color} spotColor={getSpotColour(system)}>
  <article class="page system-clean" style={`--system-accent: ${system.data.color}`}>
    <PageMasthead class="system-magazine-mast" label={slug === 'sinclair-zx-spectrum' ? system.data.name : name} note={`${system.data.year} / ${system.data.cpu}`} />
    <div class="hero" style={heroStageMax ? `--stage-max: calc(${heroStageMax}px + 1.2rem)` : undefined}>
      <header>
        <h1>Make games.</h1>
        <p class="lead">{introduction}</p>
        <div class="cards route-cards" aria-label="Language routes">
          {routes.map(track => <Tile href={`/systems/${slug}/${track.slug}`} title={track.title} as="h2">
            {track.description}<span class="count">{track.count > 0 ? `${track.count} lesson pages` : 'Outline, no lesson pages yet'}</span>
          </Tile>)}
        </div>
        {routeAdvice && <p class="route-advice">{routeAdvice}</p>}
      </header>
      <PlayerStage system={slug} name={name} color={system.data.color}
        facts={[]} />
    </div>
    <section class="system-setup" aria-labelledby="configuration">
      <h2 id="configuration">Before you start</h2>
      <p>{configuration} <a href={`/systems/${slug}/getting-started`}>Setup guide ↗</a></p>
    </section>
    <section aria-labelledby="reference">
      <h2 id="reference">From the Vault</h2>
      <div class="system-reference-links">
        {references.map(ref => <a href={ref.href}><strong>{ref.title} ↗</strong><span>{ref.description}</span></a>)}
      </div>
    </section>

  </article>
</Layout>
<style>
  .page { max-width: var(--container-max-width); margin: auto; padding: calc(var(--h-cell) * 10) var(--gutter) calc(var(--h-cell) * 12); }
  .hero { display: grid; gap: calc(var(--h-cell) * 6); align-items: start; margin-bottom: calc(var(--h-cell) * 6); }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(20rem, 1fr) minmax(0, var(--stage-max, auto)); } }
  /* The machine's own colour marks its page: the subject axis (§3). */
  header::before { content: ""; display: block; width: 3rem; height: 3px; margin-bottom: calc(var(--h-cell) * 3); background: var(--system-accent); }
  h1 {
    margin: calc(var(--h-cell) * 3) 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, var(--h-text-display));
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--h-ink);
    text-wrap: balance;
  }
  h2 {
    margin: 0 0 calc(var(--h-cell) * 2);
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, var(--h-text-h2));
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--h-ink);
  }
  p { max-width: 68ch; color: var(--h-ink-body); }
  .lead { font-size: var(--h-text-lead); line-height: var(--h-lh-lead); }
  section { margin-top: calc(var(--h-cell) * 10); }
  .route-links { display: flex; flex-wrap: wrap; gap: calc(var(--h-cell) * 1.5); margin-top: calc(var(--h-cell) * 4); }
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: calc(var(--h-cell) * 2); margin: calc(var(--h-cell) * 4) 0; }
  .count { display: block; margin-top: var(--h-cell); font-family: var(--h-font-mono); font-size: var(--h-text-micro); color: var(--h-ink-muted); }
  .note { font-size: var(--h-text-small); color: var(--h-ink-muted); }
</style>
