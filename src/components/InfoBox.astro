---
export interface Props {
  type?: 'info' | 'warning' | 'tip' | 'note' | 'celebration';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const icons = {
  info: 'ℹ️',
  warning: '⚠️',
  tip: '💡',
  note: '📝',
  celebration: '🏆'
};

const defaultTitles = {
  info: 'Information',
  warning: 'Warning',
  tip: 'Pro Tip',
  note: 'Note',
  celebration: 'Achievement'
};

const icon = icons[type];
const displayTitle = title || defaultTitles[type];
---

<div class={`info-box info-box--${type}`}>
  <div class="info-box__header">
    <span class="info-box__icon">{icon}</span>
    <span class="info-box__title">{displayTitle}</span>
  </div>
  <div class="info-box__content">
    <slot />
  </div>
</div>

<style>
  .info-box {
    margin: var(--space-xl, 2.5rem) 0;
    border-radius: var(--radius-md, 6px);
    overflow: hidden;
    position: relative;
    box-shadow:
      0 4px 15px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .info-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(255, 255, 255, 0.02) 2px,
        rgba(255, 255, 255, 0.02) 4px
      );
    pointer-events: none;
    z-index: 1;
  }

  .info-box__header {
    padding: var(--space-sm, 1rem) var(--space-md, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--space-sm, 1rem);
    font-weight: var(--font-weight-bold, 700);
    position: relative;
    overflow: hidden;
    z-index: 2;
  }

  .info-box__header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 12px,
        rgba(255, 255, 255, 0.05) 12px,
        rgba(255, 255, 255, 0.05) 13px
      );
    pointer-events: none;
  }

  .info-box__icon {
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.15);
    border-radius: var(--radius-sm, 4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  .info-box__title {
    font-size: var(--font-size-base, 1rem);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
  }

  .info-box__content {
    padding: var(--space-md, 1.5rem);
    position: relative;
    z-index: 2;
    line-height: 1.6;
    font-size: var(--font-size-sm, 0.875rem);
  }

  .info-box__content :global(p:first-child) {
    margin-top: 0;
  }

  .info-box__content :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Info variant - Terminal Blue */
  .info-box--info {
    background: linear-gradient(
      135deg,
      rgba(74, 158, 255, 0.1) 0%,
      rgba(74, 158, 255, 0.05) 100%
    );
    border: 2px solid var(--color-primary, #4a9eff);
  }

  .info-box--info .info-box__header {
    background: linear-gradient(
      90deg,
      var(--color-primary, #4a9eff) 0%,
      var(--color-primary-light, #6eb5ff) 100%
    );
    color: var(--color-text-on-primary, #ffffff);
  }

  .info-box--info .info-box__content {
    color: var(--color-primary-light, #6eb5ff);
  }

  /* Warning variant - Amber Alert */
  .info-box--warning {
    background: linear-gradient(
      135deg,
      rgba(255, 193, 7, 0.15) 0%,
      rgba(255, 193, 7, 0.08) 100%
    );
    border: 2px solid var(--color-warning, #ffc107);
  }

  .info-box--warning .info-box__header {
    background: linear-gradient(
      90deg,
      var(--color-warning, #ffc107) 0%,
      var(--color-warning-light, #ffdd54) 100%
    );
    color: var(--color-warning-dark, #b8860b);
  }

  .info-box--warning .info-box__content {
    color: var(--color-warning-light, #ffdd54);
  }

  /* Tip variant - Matrix Green */
  .info-box--tip {
    background: linear-gradient(
      135deg,
      rgba(16, 185, 129, 0.12) 0%,
      rgba(16, 185, 129, 0.06) 100%
    );
    border: 2px solid var(--color-success, #10b981);
  }

  .info-box--tip .info-box__header {
    background: linear-gradient(
      90deg,
      var(--color-success, #10b981) 0%,
      var(--color-success-light, #34d399) 100%
    );
    color: var(--color-text-on-success, #ffffff);
  }

  .info-box--tip .info-box__content {
    color: var(--color-success-light, #34d399);
  }

  /* Note variant - Retro Purple */
  .info-box--note {
    background: linear-gradient(
      135deg,
      rgba(139, 92, 246, 0.1) 0%,
      rgba(139, 92, 246, 0.05) 100%
    );
    border: 2px solid var(--color-secondary, #8b5cf6);
  }

  .info-box--note .info-box__header {
    background: linear-gradient(
      90deg,
      var(--color-secondary, #8b5cf6) 0%,
      var(--color-secondary-light, #a78bfa) 100%
    );
    color: var(--color-text-on-secondary, #ffffff);
  }

  .info-box--note .info-box__content {
    color: var(--color-secondary-light, #a78bfa);
  }

  /* Celebration variant - Golden Trophy */
  .info-box--celebration {
    background: linear-gradient(
      135deg,
      rgba(255, 215, 0, 0.15) 0%,
      rgba(255, 193, 7, 0.08) 100%
    );
    border: 2px solid #ffd700;
    position: relative;
    overflow: hidden;
  }

  .info-box--celebration::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      rgba(255, 215, 0, 0.1) 0%,
      transparent 70%
    );
    animation: celebrationShimmer 3s ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }

  .info-box--celebration .info-box__header {
    background: linear-gradient(
      90deg,
      #ffd700 0%,
      #ffed4e 50%,
      #ffd700 100%
    );
    color: #b8860b;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
    position: relative;
    z-index: 2;
  }

  .info-box--celebration .info-box__content {
    color: #ffed4e;
    position: relative;
    z-index: 2;
  }

  /* Glow animations */
  .info-box--info {
    animation: infoGlow 3s ease-in-out infinite alternate;
  }

  .info-box--warning {
    animation: warningGlow 2.5s ease-in-out infinite alternate;
  }

  .info-box--tip {
    animation: tipGlow 3.5s ease-in-out infinite alternate;
  }

  .info-box--note {
    animation: noteGlow 4s ease-in-out infinite alternate;
  }

  .info-box--celebration {
    animation: celebrationGlow 2s ease-in-out infinite alternate;
  }

  @keyframes infoGlow {
    from {
      box-shadow:
        0 4px 15px rgba(74, 158, 255, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    to {
      box-shadow:
        0 4px 20px rgba(74, 158, 255, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
  }

  @keyframes warningGlow {
    from {
      box-shadow:
        0 4px 15px rgba(255, 193, 7, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    to {
      box-shadow:
        0 4px 20px rgba(255, 193, 7, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
  }

  @keyframes tipGlow {
    from {
      box-shadow:
        0 4px 15px rgba(16, 185, 129, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    to {
      box-shadow:
        0 4px 20px rgba(16, 185, 129, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
  }

  @keyframes noteGlow {
    from {
      box-shadow:
        0 4px 15px rgba(139, 92, 246, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    to {
      box-shadow:
        0 4px 20px rgba(139, 92, 246, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
  }

  @keyframes celebrationGlow {
    from {
      box-shadow:
        0 4px 15px rgba(255, 215, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 0 20px rgba(255, 215, 0, 0.1);
    }
    to {
      box-shadow:
        0 8px 30px rgba(255, 215, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        0 0 40px rgba(255, 215, 0, 0.2);
    }
  }

  @keyframes celebrationShimmer {
    0% {
      transform: rotate(0deg) scale(1);
      opacity: 0.3;
    }
    50% {
      transform: rotate(180deg) scale(1.1);
      opacity: 0.1;
    }
    100% {
      transform: rotate(360deg) scale(1);
      opacity: 0.3;
    }
  }

  /* Dark mode adjustments */
  .dark-mode .info-box {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary, #0f0f1e) 0%,
      var(--color-bg-tertiary, #1a1a2e) 100%
    );
  }

  .dark-mode .info-box__content {
    color: var(--color-text, #e0e0e0);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .info-box {
      margin: var(--space-lg, 2rem) -var(--space-sm, 1rem);
      border-radius: 0;
      border-left: 4px solid;
      border-right: none;
      border-top: none;
      border-bottom: none;
    }

    .info-box__header {
      padding: var(--space-sm, 1rem);
      flex-direction: column;
      text-align: center;
      gap: var(--space-xs, 0.5rem);
    }

    .info-box__content {
      padding: var(--space-md, 1.5rem);
    }

    .info-box__icon {
      width: 32px;
      height: 32px;
      font-size: 1.25rem;
    }

    .info-box__title {
      font-size: var(--font-size-sm, 0.875rem);
    }
  }

  /* Enhanced content styling */
  .info-box__content :global(strong) {
    color: currentColor;
    filter: brightness(1.2);
    text-shadow: 0 0 4px currentColor;
  }

  .info-box__content :global(code) {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-xs, 2px);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .info-box__content :global(a) {
    color: currentColor;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.5);
    transition: all 0.2s ease;
  }

  .info-box__content :global(a:hover) {
    text-shadow: 0 0 8px currentColor;
    text-decoration-color: currentColor;
  }
</style>