---
import UnifiedSearch from './UnifiedSearch.astro';
import { getCollection } from 'astro:content';
import { VAULT_CATEGORIES } from '../data/vault-categories.js';

// Define type for searchable items
interface SearchableItem {
  category: string;
  type: string;
  name: string;
  slug: string;
  description: string;
  tags: string[];
  system?: string;
  phase?: number;
  tier?: number;
  year?: number;
}

// Get lessons from content collections at build time
let lessons: SearchableItem[] = [];
try {
  const allLessons = await getCollection('lessons');
  lessons = allLessons.map(lesson => ({
    category: 'lesson',
    type: 'lesson',
    name: lesson.data.title,
    slug: `/lessons/${lesson.slug}`,
    description: lesson.data.description || '',
    tags: [],
    system: lesson.slug.split('/')[0],
    phase: lesson.data.phase,
    tier: lesson.data.tier
  }));
} catch (e) {
  // Lessons collection is empty or doesn't exist
}

// Generate quick links from vault categories
const featuredCategories = ['hardware', 'people', 'games', 'applications', 'techniques', 'emulators'];
const categoryQuickLinks = featuredCategories
  .filter(key => VAULT_CATEGORIES[key as keyof typeof VAULT_CATEGORIES])
  .map(key => {
    const category = VAULT_CATEGORIES[key as keyof typeof VAULT_CATEGORIES];
    return {
      key,
      title: category.heroTitle,
      icon: category.heroIcon,
      url: `/vault/${key}`
    };
  });

// Configure search filters for global search
const searchFilters = [
  {
    id: 'category',
    label: 'Category',
    type: 'select' as const,
    options: [
      { value: 'all', label: 'All Categories' },
      { value: 'lesson', label: '📚 Lessons' },
      ...Object.entries(VAULT_CATEGORIES).map(([key, cat]) => ({
        value: key,
        label: `${cat.heroIcon} ${cat.heroTitle}`
      }))
    ],
    show: false // Hide filters in modal view for cleaner interface
  }
];
---

<!-- Global Search Modal -->
<div id="global-search-modal" class="global-search-modal" aria-hidden="true">
  <div class="modal-backdrop"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 class="sr-only">Global Search</h2>
      <button id="search-close" class="modal-close" aria-label="Close search">
        <span class="close-text">ESC</span>
      </button>
    </div>

    <div class="modal-body">
      <!-- Unified Search Component -->
      <UnifiedSearch
        id="global-search"
        variant="inline"
        placeholder="Search lessons, hardware, people, software... (Press / to focus)"
        filters={searchFilters}
        showButton={false}
        showSuggestions={true}
        maxSuggestions={8}
        data={lessons}
        dataUrl="/src/data/vault-data.js"
        onSearch="global-search-results"
        className="global-search-input"
      />

      <!-- Quick Links Section -->
      <div class="quick-links-section" id="quick-links">
        <h3 class="quick-links-title">Quick Links</h3>
        <div class="quick-links-grid">
          <!-- Static quick links -->
          <a href="/lessons" class="quick-link">
            <span class="quick-link-icon">📚</span>
            <span class="quick-link-label">All Lessons</span>
          </a>
          <a href="/vault/search" class="quick-link">
            <span class="quick-link-icon">🔍</span>
            <span class="quick-link-label">Advanced Search</span>
          </a>

          <!-- Dynamic category quick links -->
          {categoryQuickLinks.map(category => (
            <a href={category.url} class="quick-link">
              <span class="quick-link-icon">{category.icon}</span>
              <span class="quick-link-label">{category.title}</span>
            </a>
          ))}

          <!-- Timeline link -->
          <a href="/vault/timeline" class="quick-link">
            <span class="quick-link-icon">📅</span>
            <span class="quick-link-label">Timeline</span>
          </a>
        </div>
      </div>

      <!-- Search Results Section -->
      <div id="search-results-section" class="search-results-section" style="display: none;">
        <h3 class="results-title">Search Results</h3>
        <div id="search-results-container" class="results-container"></div>
      </div>

      <!-- No Results Message -->
      <div id="no-results-section" class="no-results-section" style="display: none;">
        <p class="no-results-message">No results found</p>
        <p class="no-results-hint">Try different keywords or browse categories</p>
      </div>
    </div>

    <div class="modal-footer">
      <div class="search-hints">
        <span class="hint"><kbd>↑↓</kbd> Navigate</span>
        <span class="hint"><kbd>Enter</kbd> Select</span>
        <span class="hint"><kbd>ESC</kbd> Close</span>
        <span class="hint"><kbd>/</kbd> Focus search</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Modal Structure */
  .global-search-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .global-search-modal.is-open {
    display: block;
    opacity: 1;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: absolute;
    top: 10vh;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 800px;
    max-height: 70vh;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-xl);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Modal Header */
  .modal-header {
    position: relative;
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .modal-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .modal-close:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  /* Modal Body */
  .modal-body {
    flex: 1;
    padding: var(--space-lg);
    overflow-y: auto;
  }

  /* Override UnifiedSearch styles in modal context */
  .global-search-input :global(.search__input) {
    height: 56px;
    font-size: var(--font-size-lg);
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.1);
  }

  .global-search-input :global(.search__suggestions) {
    top: calc(100% + var(--space-sm));
  }

  /* Quick Links */
  .quick-links-section {
    margin-top: var(--space-xl);
  }

  .quick-links-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-sm);
  }

  .quick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-md);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.15s ease;
    text-align: center;
  }

  .quick-link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .quick-link-icon {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-xs);
  }

  .quick-link-label {
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  /* Search Results */
  .search-results-section {
    margin-top: var(--space-xl);
  }

  .results-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .results-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .search-result {
    padding: var(--space-sm) var(--space-md);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .search-result:hover,
  .search-result.is-selected {
    background: var(--color-background-secondary);
    border-color: var(--color-primary);
  }

  .search-result-title {
    font-weight: 600;
    margin-bottom: var(--space-2xs);
  }

  .search-result-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  /* No Results */
  .no-results-section {
    text-align: center;
    padding: var(--space-xl) 0;
  }

  .no-results-message {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .no-results-hint {
    color: var(--color-text-secondary);
  }

  /* Modal Footer */
  .modal-footer {
    padding: var(--space-sm) var(--space-lg);
    border-top: 1px solid var(--color-border);
    background: var(--color-background-secondary);
  }

  .search-hints {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .hint {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .hint kbd {
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .modal-content {
      top: 5vh;
      width: 95%;
      max-height: 85vh;
    }

    .quick-links-grid {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    }

    .search-hints {
      gap: var(--space-md);
    }

    .hint:nth-child(n+3) {
      display: none; /* Hide less important hints on mobile */
    }
  }
</style>

<script>
  // Global search modal functionality
  class GlobalSearchModal {
    constructor() {
      this.modal = document.getElementById('global-search-modal');
      this.searchElement = document.getElementById('global-search');
      this.searchInput = null;
      this.quickLinks = document.getElementById('quick-links');
      this.resultsSection = document.getElementById('search-results-section');
      this.resultsContainer = document.getElementById('search-results-container');
      this.noResults = document.getElementById('no-results-section');
      this.closeButton = document.getElementById('search-close');
      this.backdrop = this.modal?.querySelector('.modal-backdrop');
      this.vaultData = [];
      this.allData = [];

      this.init();
    }

    init() {
      if (!this.modal) return;

      // Wait for UnifiedSearch to initialize
      setTimeout(() => {
        this.searchInput = this.modal.querySelector('.search__input');
        this.attachEventListeners();
      }, 100);

      // Load vault data dynamically
      this.loadVaultData();
    }

    async loadVaultData() {
      try {
        const module = await import('/src/data/vault-data.js');
        this.vaultData = module.vaultData.map(item => ({
          category: item.c,
          type: item.t || 'unknown',
          name: item.n,
          slug: `/vault/${item.c}/${item.s}`,
          description: item.d,
          tags: item.g || [],
          year: item.y
        }));

        // Update UnifiedSearch data
        if (this.searchElement) {
          const currentData = JSON.parse(this.searchElement.dataset.searchData || '[]');
          this.allData = [...currentData, ...this.vaultData];
          this.searchElement.dataset.searchData = JSON.stringify(this.allData);
        }
      } catch (error) {
        console.error('Failed to load vault data:', error);
      }
    }

    attachEventListeners() {
      // Open search triggers
      document.querySelectorAll('.nav-search').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          this.open();
        });
      });

      // Close button
      this.closeButton?.addEventListener('click', () => this.close());

      // Backdrop click
      this.backdrop?.addEventListener('click', () => this.close());

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => this.handleKeyboard(e));

      // Listen for search results from UnifiedSearch
      document.addEventListener('global-search-results', (e) => this.handleSearchResults(e));
    }

    handleKeyboard(e) {
      // Open with / key
      if (e.key === '/' && !this.isOpen()) {
        e.preventDefault();
        this.open();
        return;
      }

      // Close with ESC
      if (e.key === 'Escape' && this.isOpen()) {
        e.preventDefault();
        this.close();
        return;
      }
    }

    handleSearchResults(event) {
      const { query, results } = event.detail;

      if (!query || query.length < 2) {
        // Show quick links
        this.quickLinks.style.display = 'block';
        this.resultsSection.style.display = 'none';
        this.noResults.style.display = 'none';
        return;
      }

      // Hide quick links
      this.quickLinks.style.display = 'none';

      if (results.length === 0) {
        // Show no results
        this.resultsSection.style.display = 'none';
        this.noResults.style.display = 'block';
      } else {
        // Display results
        this.displayResults(results);
        this.resultsSection.style.display = 'block';
        this.noResults.style.display = 'none';
      }
    }

    displayResults(results) {
      const html = results.slice(0, 20).map((item, index) => {
        const categoryLabel = item.category === 'lesson' ? 'Lesson' :
          item.category.charAt(0).toUpperCase() + item.category.slice(1);

        return `
          <a href="${item.slug}" class="search-result" data-index="${index}">
            <div class="search-result-title">${item.name}</div>
            <div class="search-result-meta">
              ${categoryLabel}
              ${item.type ? ` • ${item.type}` : ''}
              ${item.year ? ` • ${item.year}` : ''}
            </div>
          </a>
        `;
      }).join('');

      this.resultsContainer.innerHTML = html;
    }

    open() {
      if (!this.modal) return;

      this.modal.classList.add('is-open');
      this.modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Focus search input
      setTimeout(() => {
        this.searchInput?.focus();
      }, 100);
    }

    close() {
      if (!this.modal) return;

      this.modal.classList.remove('is-open');
      this.modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      // Clear search
      if (this.searchInput) {
        this.searchInput.value = '';
        const event = new Event('input', { bubbles: true });
        this.searchInput.dispatchEvent(event);
      }

      // Reset display
      this.quickLinks.style.display = 'block';
      this.resultsSection.style.display = 'none';
      this.noResults.style.display = 'none';
    }

    isOpen() {
      return this.modal?.classList.contains('is-open');
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    new GlobalSearchModal();
  });

  // Reinitialize on Astro navigation
  document.addEventListener('astro:page-load', () => {
    new GlobalSearchModal();
  });
</script>