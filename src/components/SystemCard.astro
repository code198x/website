---
/**
 * SystemCard - Platform selection card for homepage grid
 *
 * Usage:
 *   import SystemCard from '@components/SystemCard.astro';
 *   <SystemCard
 *     href="/commodore-64"
 *     name="Commodore 64"
 *     year="1982"
 *     chip="MOS 6510"
 *     tagline="The best-selling home computer"
 *     platformColor="#4a4dff"
 *   />
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  name: string;
  year?: string;
  chip?: string;
  tagline?: string;
  platformColor: string;
  status?: string;
}

const { href, name, year, chip, tagline, platformColor, status, ...attrs } = Astro.props;
---

<a href={href} class="system-card" style={`--system-color: ${platformColor};`} {...attrs}>
  <slot name="icon" />
  <span class="system-name">{name}</span>
  {year && <span class="system-year">{year}</span>}
  {chip && <span class="system-chip">{chip}</span>}
  {tagline && <span class="system-tagline">{tagline}</span>}
  {status && <span class="system-status">{status}</span>}
</a>

<style>
  .system-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--space-6);
    text-align: center;
    transition: all var(--transition-base);
    cursor: pointer;
    text-decoration: none;
    color: var(--color-text);
    position: relative;
    overflow: hidden;
    display: block;
  }

  .system-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--system-color);
    transform: scaleX(0);
    transition: transform var(--transition-base);
  }

  .system-card:hover,
  .system-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--system-color);
  }

  .system-card:focus-visible {
    outline: 2px solid var(--system-color);
    outline-offset: 2px;
  }

  .system-card:hover::before,
  .system-card:focus-visible::before {
    transform: scaleX(1);
  }

  .system-card :global(.system-icon) {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-3);
    color: var(--system-color);
  }

  .system-name {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--system-color);
  }

  .system-year {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-1);
  }

  .system-chip {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .system-tagline {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    line-height: 1.4;
  }

  .system-status {
    display: block;
    margin-top: var(--space-3);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
