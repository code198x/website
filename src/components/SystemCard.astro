---
/**
 * SystemCard - Platform selection card for homepage grid
 *
 * Usage:
 *   import SystemCard from '@components/SystemCard.astro';
 *   <SystemCard
 *     href="/systems/commodore-64"
 *     name="Commodore 64"
 *     year="1982"
 *     chip="MOS 6510"
 *     tagline="The best-selling home computer"
 *     platformColor="#4a4dff"
 *   />
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  name: string;
  year?: string;
  chip?: string;
  tagline?: string;
  platformColor: string;
  status?: string;
}

const { href, name, year, chip, tagline, platformColor, status, ...attrs } = Astro.props;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<a href={href} class="system-card" style={`--system-color: ${platformColor};`} {...attrs}>
  <div class="card-glow"></div>
  <div class="card-scanlines"></div>
  <div class="card-content">
    <slot name="icon" />
    <span class="system-name">{name}</span>
    {year && <span class="system-year">{year}</span>}
    {chip && <span class="system-chip">{chip}</span>}
    {tagline && <span class="system-tagline" set:html={inlineMarkdown(tagline)} />}
    {status && <span class="system-status">{status}</span>}
  </div>
  <div class="card-corner tl"></div>
  <div class="card-corner tr"></div>
  <div class="card-corner bl"></div>
  <div class="card-corner br"></div>
</a>

<style>
  @keyframes pulse-border {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%) rotate(45deg); }
    100% { transform: translateX(200%) rotate(45deg); }
  }

  .system-card {
    background: var(--color-surface);
    border: 3px solid var(--color-border);
    border-radius: 0;
    box-shadow: var(--shadow-chunky);
    padding: var(--space-8) var(--space-6);
    text-align: center;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    text-decoration: none;
    color: var(--color-text);
    position: relative;
    overflow: hidden;
    display: block;
  }

  /* Glow effect */
  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in oklab, var(--system-color) 15%, transparent 85%) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  /* CRT scanline overlay */
  .card-scanlines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.02) 2px,
      rgba(0, 0, 0, 0.02) 4px
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-content {
    position: relative;
    z-index: 1;
  }

  /* Corner decorations */
  .card-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--system-color);
    border-style: solid;
    border-width: 0;
    opacity: 0;
    transition: all 0.3s ease;
  }

  .card-corner.tl { top: 6px; left: 6px; border-top-width: 3px; border-left-width: 3px; }
  .card-corner.tr { top: 6px; right: 6px; border-top-width: 3px; border-right-width: 3px; }
  .card-corner.bl { bottom: 6px; left: 6px; border-bottom-width: 3px; border-left-width: 3px; }
  .card-corner.br { bottom: 6px; right: 6px; border-bottom-width: 3px; border-right-width: 3px; }

  /* Top accent bar */
  .system-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--system-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shimmer effect */
  .system-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      45deg,
      transparent 40%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 60%
    );
    transform: translateX(-100%) rotate(45deg);
    pointer-events: none;
  }

  .system-card:hover,
  .system-card:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--system-color);
    border-color: var(--system-color);
  }

  .system-card:focus-visible {
    outline: none;
  }

  .system-card:hover::before,
  .system-card:focus-visible::before {
    transform: scaleX(1);
  }

  .system-card:hover::after {
    animation: shimmer 0.8s ease-out;
  }

  .system-card:hover .card-glow {
    opacity: 1;
  }

  .system-card:hover .card-scanlines {
    opacity: 1;
  }

  .system-card:hover .card-corner {
    opacity: 1;
  }

  .system-card :global(.system-icon) {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-3);
    color: var(--system-color);
  }

  .system-name {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 2rem;
    font-weight: 900;
    margin-bottom: var(--space-3);
    color: var(--system-color);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.3s ease;
    text-shadow: 0 0 0 transparent;
  }

  .system-card:hover .system-name {
    text-shadow: 0 0 20px color-mix(in oklab, var(--system-color) 50%, transparent 50%);
  }

  .system-year {
    display: inline-block;
    background: color-mix(in oklab, var(--system-color) 15%, transparent 85%);
    color: var(--system-color);
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    font-weight: 700;
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
    letter-spacing: 0.1em;
  }

  .system-chip {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 600;
    margin-bottom: var(--space-3);
    letter-spacing: 0.05em;
  }

  .system-tagline {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    font-style: italic;
  }

  .system-status {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .system-card::after {
      display: none;
    }

    .system-card:hover,
    .system-card:focus-visible {
      transform: translateY(-4px);
    }
  }
</style>
