---
export interface Props {
  system: 'commodore-64' | 'zx-spectrum' | 'nintendo-entertainment-system' | 'commodore-amiga';
  code?: string;
  showControls?: boolean;
  height?: string;
  width?: string;
  defaultAssembler?: string;
  defaultFormat?: string;
}

const { 
  system, 
  code = '', 
  showControls = true,
  height = '400px',
  width = '100%',
  defaultAssembler = '',
  defaultFormat = ''
} = Astro.props;

// Generate unique ID for this compiler instance
const compilerId = `compiler-${Math.random().toString(36).substr(2, 9)}`;

// System-specific configuration
const getSystemConfig = (systemSlug: string) => {
  switch(systemSlug) {
    case 'commodore-64':
      return {
        name: 'Commodore 64',
        colors: { bg: 'bg-c64-brown', accent: 'text-c64-brown' },
        assembler: '6502',
        assemblers: ['ca65', 'acme'],
        formats: ['prg', 'd64', 'tap'],
        defaultAssembler: defaultAssembler || 'ca65',
        defaultFormat: defaultFormat || 'prg',
        fileExtension: '.asm'
      };
    case 'zx-spectrum':
      return {
        name: 'ZX Spectrum',
        colors: { bg: 'bg-spectrum-red', accent: 'text-spectrum-red' },
        assembler: 'Z80',
        assemblers: ['sjasmplus', 'pasmo'],
        formats: ['tap', 'tzx', 'sna'],
        defaultAssembler: defaultAssembler || 'sjasmplus',
        defaultFormat: defaultFormat || 'tap',
        fileExtension: '.asm'
      };
    case 'nintendo-entertainment-system':
      return {
        name: 'Nintendo Entertainment System',
        colors: { bg: 'bg-nes-red', accent: 'text-nes-red' },
        assembler: '6502',
        assemblers: ['ca65', 'nesasm'],
        formats: ['nes', 'nsf'],
        defaultAssembler: defaultAssembler || 'ca65',
        defaultFormat: defaultFormat || 'nes',
        fileExtension: '.asm'
      };
    case 'commodore-amiga':
      return {
        name: 'Commodore Amiga',
        colors: { bg: 'bg-amiga-blue', accent: 'text-amiga-blue' },
        assembler: '68000',
        assemblers: ['vasm', 'phxass'],
        formats: ['exe', 'adf'],
        defaultAssembler: defaultAssembler || 'vasm',
        defaultFormat: defaultFormat || 'exe',
        fileExtension: '.s'
      };
    default:
      return {
        name: 'Unknown System',
        colors: { bg: 'bg-gray-600', accent: 'text-gray-600' },
        assembler: 'Unknown',
        assemblers: ['unknown'],
        formats: ['bin'],
        defaultAssembler: 'unknown',
        defaultFormat: 'bin',
        fileExtension: '.asm'
      };
  }
};

const config = getSystemConfig(system);
---

<div class="compiler-container bg-white/90 rounded-xl shadow-lg border border-gray-200 overflow-hidden">
  <!-- Compiler Header -->
  <div class={`${config.colors.bg} text-white px-4 py-3 flex items-center justify-between`}>
    <div class="flex items-center gap-3">
      <div class="bg-white/20 rounded-lg flex items-center justify-center text-sm font-bold" style="width: 2rem; height: 2rem;">
        🔧
      </div>
      <div>
        <h3 class="font-bold text-sm">{config.name} Compiler</h3>
        <p class="text-white/80 text-xs">{config.assembler} Assembly → Machine Code</p>
      </div>
    </div>
    
    {showControls && (
      <div class="flex items-center gap-2">
        <button 
          class="compile-btn px-3 py-1 bg-white/20 hover:bg-white/30 rounded text-xs font-medium transition-colors"
          data-compiler-id={compilerId}
          data-system={system}
        >
          ⚡ Compile
        </button>
        <button 
          class="download-btn px-3 py-1 bg-white/20 hover:bg-white/30 rounded text-xs font-medium transition-colors hidden"
          data-compiler-id={compilerId}
        >
          📥 Download
        </button>
      </div>
    )}
  </div>

  <!-- Configuration Panel -->
  {showControls && (
    <div class="bg-gray-50 px-4 py-2 border-b border-gray-200 text-sm">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <label class="text-gray-700 font-medium">Assembler:</label>
          <select 
            class="assembler-select border border-gray-300 rounded px-2 py-1 text-xs"
            data-compiler-id={compilerId}
          >
            {config.assemblers.map(assembler => (
              <option 
                value={assembler} 
                selected={assembler === config.defaultAssembler}
              >
                {assembler.toUpperCase()}
              </option>
            ))}
          </select>
        </div>
        
        <div class="flex items-center gap-2">
          <label class="text-gray-700 font-medium">Format:</label>
          <select 
            class="format-select border border-gray-300 rounded px-2 py-1 text-xs"
            data-compiler-id={compilerId}
          >
            {config.formats.map(format => (
              <option 
                value={format} 
                selected={format === config.defaultFormat}
              >
                {format.toUpperCase()}
              </option>
            ))}
          </select>
        </div>
        
        <div class="ml-auto text-xs text-gray-500">
          Output: <span class="font-mono font-medium">program.{config.defaultFormat}</span>
        </div>
      </div>
    </div>
  )}

  <!-- Code Editor -->
  <div class="border-b border-gray-200">
    <div class="bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700 flex items-center justify-between">
      <span>{config.assembler} Assembly Source</span>
      <div class="flex items-center gap-2">
        <button 
          class="text-xs text-gray-500 hover:text-gray-700 transition-colors"
          onclick={`document.getElementById('code-${compilerId}').classList.toggle('hidden')`}
        >
          Toggle Code
        </button>
        <button 
          class="copy-code-btn text-xs text-gray-500 hover:text-gray-700 transition-colors"
          data-compiler-id={compilerId}
        >
          📋 Copy
        </button>
      </div>
    </div>
    <div id={`code-${compilerId}`} class="bg-gray-900 text-green-400 p-4 font-mono text-sm">
      <textarea 
        class="code-editor w-full h-48 bg-transparent text-green-400 resize-none border-none outline-none font-mono text-sm"
        data-compiler-id={compilerId}
        placeholder={`; ${config.name} ${config.assembler} Assembly
; Write your assembly code here...

${code || `; Example: Load value into register
LDA #$41    ; Load 'A' character
`}`}
      >{code}</textarea>
    </div>
  </div>

  <!-- Compilation Output -->
  <div class="compilation-output" data-compiler-id={compilerId} style={`height: ${height}`}>
    <div class="w-full h-full bg-gray-50 flex items-center justify-center text-gray-600">
      <div class="text-center">
        <div class="bg-gray-200 rounded-xl flex items-center justify-center text-2xl mb-4 mx-auto" style="width: 4rem; height: 4rem;">
          🔧
        </div>
        <p class="text-gray-600 mb-2">Ready to Compile</p>
        <p class="text-gray-500 text-sm">
          Click "Compile" to build your {config.assembler} assembly code
        </p>
      </div>
    </div>
  </div>

  <!-- Status Bar -->
  <div class="bg-gray-50 px-4 py-2 text-xs text-gray-600 flex items-center justify-between border-t border-gray-200">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1">
        <div class="compilation-status-indicator w-2 h-2 bg-gray-400 rounded-full"></div>
        <span class="compilation-status">Ready</span>
      </span>
      <span>System: {config.name}</span>
      <span>CPU: {config.assembler}</span>
    </div>
    <div class="text-right">
      <span class="compilation-info">Professional toolchain ready</span>
    </div>
  </div>
</div>

<!-- Compilation JavaScript -->
<script>
  // Compilation API configuration
  const COMPILATION_API = {
    baseUrl: 'http://localhost:3001/api',
    pollInterval: 1000, // 1 second
    maxPollTime: 60000  // 60 seconds
  };

  // Initialize all compilers on the page
  document.addEventListener('DOMContentLoaded', () => {
    const compilers = document.querySelectorAll('[id^="compiler-"]');
    
    compilers.forEach(compilerElement => {
      const compilerId = compilerElement.dataset.compilerId;
      setupCompilerEventListeners(compilerId);
    });
  });

  // Setup event listeners for a compiler
  function setupCompilerEventListeners(compilerId) {
    const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
    
    // Compile button
    const compileBtn = container.querySelector('.compile-btn');
    if (compileBtn) {
      compileBtn.addEventListener('click', () => startCompilation(compilerId));
    }
    
    // Copy code button
    const copyBtn = container.querySelector('.copy-code-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => copyCode(compilerId));
    }
    
    // Download button
    const downloadBtn = container.querySelector('.download-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => downloadResults(compilerId));
    }
  }

  // Start compilation process
  async function startCompilation(compilerId) {
    try {
      const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
      const system = container.querySelector('.compile-btn').dataset.system;
      const code = container.querySelector('.code-editor').value;
      const assembler = container.querySelector('.assembler-select').value;
      const format = container.querySelector('.format-select').value;
      
      if (!code.trim()) {
        updateCompilationStatus(compilerId, 'error', 'No code to compile');
        return;
      }
      
      updateCompilationStatus(compilerId, 'compiling', 'Starting compilation...');
      updateCompilationOutput(compilerId, 'compiling', 'Sending code to compilation service...');
      
      // Create form data
      const formData = new FormData();
      const sourceBlob = new Blob([code], { type: 'text/plain' });
      formData.append('source', sourceBlob, 'source.asm');
      formData.append('system', system);
      formData.append('assembler', assembler);
      formData.append('format', format);
      formData.append('filename', 'program');
      
      // Submit compilation request
      const response = await fetch(`${COMPILATION_API.baseUrl}/compile`, {
        method: 'POST',
        body: formData
      });
      
      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || 'Compilation request failed');
      }
      
      const result = await response.json();
      const jobId = result.jobId;
      
      updateCompilationStatus(compilerId, 'compiling', 'Compilation in progress...');
      updateCompilationOutput(compilerId, 'compiling', 'Running assembler and linker...');
      
      // Poll for results
      await pollCompilationStatus(compilerId, jobId);
      
    } catch (error) {
      console.error('Compilation error:', error);
      updateCompilationStatus(compilerId, 'error', error.message);
      updateCompilationOutput(compilerId, 'error', `❌ Error: ${error.message}`);
    }
  }

  // Poll compilation status
  async function pollCompilationStatus(compilerId, jobId) {
    const startTime = Date.now();
    
    const poll = async () => {
      try {
        const response = await fetch(`${COMPILATION_API.baseUrl}/jobs/${jobId}`);
        
        if (!response.ok) {
          throw new Error('Failed to get job status');
        }
        
        const job = await response.json();
        
        switch (job.status) {
          case 'pending':
            updateCompilationOutput(compilerId, 'compiling', '⏳ Queued for compilation...');
            break;
            
          case 'compiling':
            updateCompilationOutput(compilerId, 'compiling', '🔧 Assembling and linking...');
            break;
            
          case 'completed':
            updateCompilationStatus(compilerId, 'success', 'Compilation successful!');
            updateCompilationOutput(compilerId, 'success', generateSuccessOutput(job));
            showDownloadButton(compilerId, jobId, job.outputFiles);
            return; // Stop polling
            
          case 'failed':
            updateCompilationStatus(compilerId, 'error', 'Compilation failed');
            updateCompilationOutput(compilerId, 'error', generateErrorOutput(job));
            return; // Stop polling
        }
        
        // Continue polling if not finished
        if (Date.now() - startTime < COMPILATION_API.maxPollTime) {
          setTimeout(poll, COMPILATION_API.pollInterval);
        } else {
          throw new Error('Compilation timeout');
        }
        
      } catch (error) {
        updateCompilationStatus(compilerId, 'error', error.message);
        updateCompilationOutput(compilerId, 'error', `❌ Error: ${error.message}`);
      }
    };
    
    setTimeout(poll, COMPILATION_API.pollInterval);
  }

  // Generate success output
  function generateSuccessOutput(job) {
    return `
<div class="text-center p-8">
  <div class="text-6xl mb-4">🎉</div>
  <h3 class="text-xl font-bold text-green-800 mb-4">Compilation Successful!</h3>
  <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
    <h4 class="font-bold mb-2">Generated Files:</h4>
    <ul class="space-y-1">
      ${job.outputFiles.map(file => `
        <li class="font-mono text-sm text-green-700">📄 ${file}</li>
      `).join('')}
    </ul>
  </div>
  <p class="text-sm text-gray-600 mb-4">
    Your ${job.system} assembly code has been successfully compiled!
  </p>
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
    <h4 class="font-bold mb-2">🎮 Next Steps:</h4>
    <ol class="text-sm text-left space-y-1">
      <li>1. Download your compiled files</li>
      <li>2. Load into your ${job.system} emulator</li>
      <li>3. Run and test your program!</li>
    </ol>
  </div>
</div>
    `;
  }

  // Generate error output
  function generateErrorOutput(job) {
    return `
<div class="text-center p-8">
  <div class="text-6xl mb-4">❌</div>
  <h3 class="text-xl font-bold text-red-800 mb-4">Compilation Failed</h3>
  <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4 text-left">
    <h4 class="font-bold mb-2">Error Details:</h4>
    <pre class="font-mono text-sm text-red-700 whitespace-pre-wrap">${job.error || 'Unknown error'}</pre>
    ${job.logs ? `<pre class="font-mono text-xs text-gray-600 mt-2 whitespace-pre-wrap">${job.logs}</pre>` : ''}
  </div>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
    <h4 class="font-bold mb-2">💡 Tips:</h4>
    <ul class="text-sm text-left space-y-1">
      <li>• Check your assembly syntax</li>
      <li>• Verify instruction names and addressing modes</li>
      <li>• Make sure labels are properly defined</li>
      <li>• Check for missing semicolons or directives</li>
    </ul>
  </div>
</div>
    `;
  }

  // Update compilation status
  function updateCompilationStatus(compilerId, status, message) {
    const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
    const statusEl = container.querySelector('.compilation-status');
    const indicatorEl = container.querySelector('.compilation-status-indicator');
    
    if (statusEl) statusEl.textContent = message;
    
    if (indicatorEl) {
      indicatorEl.className = 'compilation-status-indicator w-2 h-2 rounded-full';
      switch (status) {
        case 'compiling':
          indicatorEl.classList.add('bg-yellow-500', 'animate-pulse');
          break;
        case 'success':
          indicatorEl.classList.add('bg-green-500');
          break;
        case 'error':
          indicatorEl.classList.add('bg-red-500');
          break;
        default:
          indicatorEl.classList.add('bg-gray-400');
      }
    }
  }

  // Update compilation output area
  function updateCompilationOutput(compilerId, status, content) {
    const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
    const outputEl = container.querySelector('.compilation-output');
    
    if (status === 'compiling') {
      outputEl.innerHTML = `
        <div class="w-full h-full bg-yellow-50 flex items-center justify-center">
          <div class="text-center">
            <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-yellow-600 mx-auto mb-4"></div>
            <p class="text-yellow-700 font-medium">${content}</p>
          </div>
        </div>
      `;
    } else {
      outputEl.innerHTML = content;
    }
  }

  // Show download button
  function showDownloadButton(compilerId, jobId, files) {
    const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
    const downloadBtn = container.querySelector('.download-btn');
    
    if (downloadBtn) {
      downloadBtn.classList.remove('hidden');
      downloadBtn.dataset.jobId = jobId;
      downloadBtn.dataset.files = JSON.stringify(files);
    }
  }

  // Copy code to clipboard
  function copyCode(compilerId) {
    const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
    const codeEditor = container.querySelector('.code-editor');
    
    navigator.clipboard.writeText(codeEditor.value).then(() => {
      const copyBtn = container.querySelector('.copy-code-btn');
      const originalText = copyBtn.textContent;
      copyBtn.textContent = '✅ Copied!';
      setTimeout(() => {
        copyBtn.textContent = originalText;
      }, 2000);
    });
  }

  // Download compilation results
  function downloadResults(compilerId) {
    const container = document.querySelector(`[data-compiler-id="${compilerId}"]`);
    const downloadBtn = container.querySelector('.download-btn');
    const jobId = downloadBtn.dataset.jobId;
    const files = JSON.parse(downloadBtn.dataset.files);
    
    // Download each file
    files.forEach(filename => {
      const link = document.createElement('a');
      link.href = `${COMPILATION_API.baseUrl}/download/${jobId}/${filename}`;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }
</script>

<style>
  .compiler-container {
    transition: all 0.3s ease;
  }
  
  .compiler-container:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .compile-btn, .download-btn, .copy-code-btn {
    transition: all 0.2s ease;
  }
  
  .compile-btn:hover, .download-btn:hover, .copy-code-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }
  
  .code-editor {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    line-height: 1.5;
  }
  
  .code-editor:focus {
    outline: none;
    background-color: rgba(0, 0, 0, 0.05);
  }
</style>