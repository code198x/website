---
// One source for the starting state, legal moves and pictured next states.
const start = 7;
const moves = [1, 2];
---

<figure class="counter-choices" aria-labelledby="counter-title counter-caption">
  <p class="figure-label" id="counter-title">Seven counters. Your turn.</p>
  <div class="counters starting" aria-hidden="true" data-count={start}>
    {Array.from({ length: start }, () => <span class="counter" />)}
  </div>
  <p class="turn-note">You can take one or two.</p>
  <div class="moves">
    {moves.map(take => (
      <div class="move" data-take={take}>
        <p><strong>Take {take === 1 ? 'one' : 'two'}</strong><span>{start - take} left for the other player</span></p>
        <div class="counters" aria-hidden="true" data-count={start - take}>
          {Array.from({ length: start - take }, () => <span class="counter" />)}
        </div>
      </div>
    ))}
  </div>
  <figcaption id="counter-caption">Your move changes the choice you leave behind.
    What happens when taking the last counter loses instead of wins?
    <a href="#try-it">Try changing one rule →</a>
  </figcaption>
</figure>

<style>@layer blocks {
  .counter-choices { margin: 0; padding: var(--h-space-6); border-top: 3px solid var(--sys); background: var(--h-ground); }
  .figure-label { margin: 0 0 var(--space-5); color: var(--h-ink); font-weight: 700; font-size: 1.15rem; }
  .counters { display: flex; gap: clamp(6px, 1vw, 12px); }
  .counter { display: block; flex: 0 1 30px; aspect-ratio: 1; border-radius: 50%; background: var(--sys); border: 2px solid var(--sys); }
  .turn-note, .move p, figcaption { font-size: .9375rem; line-height: 1.6; color: var(--h-ink-muted); }
  .turn-note { margin: var(--h-space-3) 0 var(--space-5); }
  .moves { display: grid; gap: var(--space-5); }
  .move { border-top: 1px solid var(--h-line); padding-top: var(--h-space-4); }
  .move p { margin: 0 0 var(--h-space-3); }
  .move strong { display: block; color: var(--h-ink); }
  .move p span { display: block; }
  figcaption { margin-top: var(--h-space-6); }
  figcaption a { display: block; padding-block: var(--h-space-3); font-weight: 700; }
}
</style>
