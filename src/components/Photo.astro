---
/**
 * Photo — polaroid-framed image with a handwritten caption (IA v3 media primitive).
 * Use in Vault entries, game landings, unit pages for portraits / build photos.
 *
 *   <Photo src="/images/vault/rob-hubbard.jpg" alt="Rob Hubbard at the C64"
 *          caption="At the C64, mid-80s" tilt="left" />
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  tilt?: 'left' | 'right' | 'none';
  width?: number;
}
const { src, alt, caption, tilt = 'right', width = 260 } = Astro.props;
const rot = tilt === 'left' ? '-1.5deg' : tilt === 'right' ? '1.8deg' : '0deg';
import { inlineMarkdown } from '../lib/inline-markdown';
---

<figure class="polaroid" style={`--rot: ${rot}; --w: ${width}px;`}>
  <img src={src} alt={alt} loading="lazy" />
  {caption && <figcaption set:html={inlineMarkdown(caption)} />}
</figure>

<style>
  .polaroid { width: var(--w); max-width: 100%; background: #fff; border: 1px solid var(--color-border); box-shadow: 3px 4px 0 rgb(0 0 0 / 0.16); padding: 8px 8px 0; transform: rotate(var(--rot)); margin: var(--space-4) 0; }
  .polaroid img { display: block; width: 100%; height: auto; background: #e6dcc4; image-rendering: auto; }
  .polaroid figcaption { font-family: var(--font-family-read); font-size: 1.15rem; color: var(--color-text-secondary); text-align: center; padding: 7px 4px 10px; line-height: 1.05; }
  /* Float into the reading column when there's room */
  @media (min-width: 720px) {
    .polaroid { float: right; margin: 4px 0 var(--space-4) var(--space-6); }
  }
</style>
