---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  year?: string;
  photographer?: string;
  style?: "polaroid" | "magazine" | "technical" | "casual";
  system?: "commodore-64" | "sinclair-zx-spectrum" | "nintendo-entertainment-system" | "amiga";
}

const {
  src,
  alt,
  caption,
  year,
  photographer,
  style = "polaroid",
  system = "commodore-64"
} = Astro.props;

const systemColors = {
  "commodore-64": "#6c5ce7",
  "sinclair-zx-spectrum": "#e17055",
  "nintendo-entertainment-system": "#e84393",
  "amiga": "#fdcb6e"
};

const borderColor = systemColors[system];
---

<figure class="vintage-photo" data-style={style} data-system={system}>
  <div class="photo-frame">
    <div class="photo-container">
      <img src={src} alt={alt} class="photo-image" loading="lazy" />
      <div class="photo-aging"></div>
      <div class="photo-glare"></div>
    </div>

    {style === "polaroid" && (
      <div class="polaroid-footer">
        <div class="polaroid-writing">
          {caption && <span class="polaroid-caption">{caption}</span>}
          {year && <span class="polaroid-year">{year}</span>}
        </div>
      </div>
    )}
  </div>

  {style !== "polaroid" && (caption || year || photographer) && (
    <figcaption class="vintage-caption">
      {caption && <span class="caption-text">{caption}</span>}
      <div class="caption-meta">
        {year && <span class="caption-year">{year}</span>}
        {photographer && <span class="caption-photographer">Photo: {photographer}</span>}
      </div>
    </figcaption>
  )}
</figure>

<style define:vars={{ borderColor }}>
  .vintage-photo {
    margin: var(--space-xl, 2.5rem) 0;
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    position: relative;
    max-width: 600px;
    filter: sepia(0.1) contrast(1.1) brightness(0.95);
  }

  .photo-container {
    position: relative;
    overflow: hidden;
  }

  .photo-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .photo-aging {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(139, 92, 46, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(139, 92, 46, 0.08) 0%, transparent 50%),
      linear-gradient(45deg, transparent 0%, rgba(222, 184, 135, 0.05) 100%);
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .photo-glare {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      transparent 30%,
      transparent 70%,
      rgba(255, 255, 255, 0.05) 100%
    );
    pointer-events: none;
  }

  /* Polaroid Style */
  .vintage-photo[data-style="polaroid"] .photo-frame {
    background: #f8f8f0;
    padding: 16px 16px 60px 16px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 0 0 1px rgba(0, 0, 0, 0.1);
    transform: rotate(-1deg);
    transition: transform 0.3s ease;
  }

  .vintage-photo[data-style="polaroid"] .photo-frame:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .polaroid-footer {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .polaroid-writing {
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: #4a4a4a;
    text-align: center;
    transform: rotate(-0.5deg);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .polaroid-caption {
    font-weight: normal;
  }

  .polaroid-year {
    font-size: 0.75rem;
    color: #666;
  }

  /* Magazine Style */
  .vintage-photo[data-style="magazine"] .photo-frame {
    border: 3px solid var(--borderColor);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.4),
      inset 0 0 0 2px #fff;
    transform: rotate(0.5deg);
  }

  .vintage-photo[data-style="magazine"] .photo-frame:hover {
    transform: rotate(0deg);
  }

  /* Technical Style */
  .vintage-photo[data-style="technical"] .photo-frame {
    border: 1px solid #ccc;
    background: #fff;
    padding: 8px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.2);
  }

  .vintage-photo[data-style="technical"] .photo-aging {
    background: none;
  }

  .vintage-photo[data-style="technical"] .photo-image {
    filter: contrast(1.2) brightness(0.9);
  }

  /* Casual Style */
  .vintage-photo[data-style="casual"] .photo-frame {
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    transform: rotate(-0.5deg);
  }

  /* Caption Styling */
  .vintage-caption {
    margin-top: var(--space-md, 1.5rem);
    font-family: var(--font-family-mono, 'Courier New', monospace);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #b0b0c0);
    text-align: center;
    max-width: 600px;
  }

  .caption-text {
    display: block;
    margin-bottom: var(--space-xs, 0.5rem);
    font-style: italic;
  }

  .caption-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-md, 1.5rem);
    font-size: var(--font-size-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .caption-year {
    color: var(--borderColor);
    font-weight: var(--font-weight-bold, 700);
  }

  .caption-photographer {
    color: var(--color-text-muted, #888);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .vintage-photo {
      margin: var(--space-lg, 2rem) -var(--space-sm, 1rem);
    }

    .photo-frame {
      max-width: none;
      width: 100%;
    }

    .vintage-photo[data-style="polaroid"] .photo-frame,
    .vintage-photo[data-style="magazine"] .photo-frame,
    .vintage-photo[data-style="casual"] .photo-frame {
      transform: none;
    }

    .vintage-photo[data-style="polaroid"] .photo-frame:hover,
    .vintage-photo[data-style="magazine"] .photo-frame:hover {
      transform: none;
    }

    .vintage-caption {
      padding: 0 var(--space-sm, 1rem);
    }

    .caption-meta {
      flex-direction: column;
      gap: var(--space-xs, 0.5rem);
    }
  }

  /* Animation */
  .vintage-photo {
    animation: fadeIn 1s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtle film grain effect */
  .photo-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size: 3px 3px;
    opacity: 0.3;
    pointer-events: none;
    animation: grain 0.5s steps(10) infinite;
  }

  @keyframes grain {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-1px, -1px); }
    20% { transform: translate(1px, 1px); }
    30% { transform: translate(-1px, 1px); }
    40% { transform: translate(1px, -1px); }
    50% { transform: translate(-1px, -1px); }
    60% { transform: translate(1px, 1px); }
    70% { transform: translate(-1px, 1px); }
    80% { transform: translate(1px, -1px); }
    90% { transform: translate(-1px, -1px); }
  }
</style>