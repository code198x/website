---
export interface Props {
  title?: string;
  highlightRegion?: string;
  showAddresses?: boolean;
  activeAddress?: string;
  showPPU?: boolean;
}

const { 
  title = "Nintendo Entertainment System Memory Map",
  highlightRegion = "",
  showAddresses = true,
  activeAddress = "",
  showPPU = false
} = Astro.props;

interface MemoryRegion {
  start: string;
  end: string;
  name: string;
  description: string;
  color: string;
  textColor: string;
  usage: string;
  memoryType?: "cpu" | "ppu";
}

const cpuMemoryRegions: MemoryRegion[] = [
  {
    start: "$0000",
    end: "$07FF", 
    name: "RAM",
    description: "Internal RAM (2KB, mirrored 4 times)",
    color: "bg-green-600",
    textColor: "text-green-100",
    usage: "Variables, stack, zero page",
    memoryType: "cpu"
  },
  {
    start: "$0800",
    end: "$1FFF",
    name: "RAM Mirrors",
    description: "Mirrors of $0000-$07FF",
    color: "bg-green-500",
    textColor: "text-green-100", 
    usage: "Same as $0000-$07FF",
    memoryType: "cpu"
  },
  {
    start: "$2000",
    end: "$2007",
    name: "PPU Registers",
    description: "Picture Processing Unit control",
    color: "bg-blue-600",
    textColor: "text-blue-100",
    usage: "Graphics control",
    memoryType: "cpu"
  },
  {
    start: "$2008",
    end: "$3FFF",
    name: "PPU Mirrors",
    description: "Mirrors of $2000-$2007 (every 8 bytes)",
    color: "bg-blue-500",
    textColor: "text-blue-100",
    usage: "Same as PPU registers",
    memoryType: "cpu"
  },
  {
    start: "$4000",
    end: "$4017",
    name: "APU & I/O",
    description: "Audio Processing Unit and I/O registers",
    color: "bg-purple-600",
    textColor: "text-purple-100",
    usage: "Sound & input",
    memoryType: "cpu"
  },
  {
    start: "$4018",
    end: "$401F",
    name: "Test Mode",
    description: "APU and I/O test functionality",
    color: "bg-purple-500",
    textColor: "text-purple-100",
    usage: "Testing only",
    memoryType: "cpu"
  },
  {
    start: "$4020",
    end: "$5FFF",
    name: "Expansion ROM",
    description: "Mapper expansion area",
    color: "bg-orange-700",
    textColor: "text-orange-50",
    usage: "Cartridge expansion",
    memoryType: "cpu"
  },
  {
    start: "$6000",
    end: "$7FFF",
    name: "SRAM",
    description: "Save RAM (battery backed)",
    color: "bg-yellow-700",
    textColor: "text-yellow-50",
    usage: "Game saves",
    memoryType: "cpu"
  },
  {
    start: "$8000",
    end: "$BFFF",
    name: "PRG ROM Lower",
    description: "Program ROM (16KB, switchable)",
    color: "bg-red-600",
    textColor: "text-red-100",
    usage: "Game code",
    memoryType: "cpu"
  },
  {
    start: "$C000",
    end: "$FFFF",
    name: "PRG ROM Upper", 
    description: "Program ROM (16KB, often fixed)",
    color: "bg-red-700",
    textColor: "text-red-100",
    usage: "Game code & vectors",
    memoryType: "cpu"
  }
];

const ppuMemoryRegions: MemoryRegion[] = [
  {
    start: "$0000",
    end: "$0FFF",
    name: "Pattern Table 0",
    description: "Sprite and background tile patterns (4KB)",
    color: "bg-cyan-700",
    textColor: "text-cyan-50",
    usage: "Tile graphics",
    memoryType: "ppu"
  },
  {
    start: "$1000",
    end: "$1FFF",
    name: "Pattern Table 1", 
    description: "More sprite and background patterns (4KB)",
    color: "bg-cyan-600",
    textColor: "text-cyan-50",
    usage: "More tile graphics",
    memoryType: "ppu"
  },
  {
    start: "$2000",
    end: "$23FF",
    name: "Nametable 0",
    description: "Background tilemap (1KB)",
    color: "bg-teal-700",
    textColor: "text-teal-50",
    usage: "Screen layout",
    memoryType: "ppu"
  },
  {
    start: "$2400",
    end: "$27FF",
    name: "Nametable 1",
    description: "Second background tilemap (1KB)",
    color: "bg-teal-600",
    textColor: "text-teal-50",
    usage: "Second screen",
    memoryType: "ppu"
  },
  {
    start: "$2800",
    end: "$2BFF",
    name: "Nametable 2",
    description: "Third background tilemap (1KB)",
    color: "bg-teal-400",
    textColor: "text-teal-900",
    usage: "Third screen",
    memoryType: "ppu"
  },
  {
    start: "$2C00",
    end: "$2FFF",
    name: "Nametable 3",
    description: "Fourth background tilemap (1KB)",
    color: "bg-teal-300",
    textColor: "text-teal-900",
    usage: "Fourth screen",
    memoryType: "ppu"
  },
  {
    start: "$3000",
    end: "$3EFF",
    name: "Nametable Mirrors",
    description: "Mirrors of $2000-$2EFF",
    color: "bg-slate-600",
    textColor: "text-slate-100",
    usage: "Same as nametables",
    memoryType: "ppu"
  },
  {
    start: "$3F00",
    end: "$3F1F",
    name: "Palette RAM",
    description: "Background and sprite color palettes",
    color: "bg-pink-700",
    textColor: "text-pink-50",
    usage: "Color data",
    memoryType: "ppu"
  },
  {
    start: "$3F20",
    end: "$3FFF",
    name: "Palette Mirrors",
    description: "Mirrors of $3F00-$3F1F",
    color: "bg-pink-600",
    textColor: "text-pink-50",
    usage: "Same as palette",
    memoryType: "ppu"
  }
];

const regions = showPPU ? ppuMemoryRegions : cpuMemoryRegions;

function isHighlighted(region: MemoryRegion): boolean {
  if (!highlightRegion) return false;
  return region.name.toLowerCase().includes(highlightRegion.toLowerCase()) ||
         region.description.toLowerCase().includes(highlightRegion.toLowerCase());
}

function isActiveAddress(region: MemoryRegion): boolean {
  if (!activeAddress) return false;
  const addr = parseInt(activeAddress.replace('$', ''), 16);
  const start = parseInt(region.start.replace('$', ''), 16);
  const end = parseInt(region.end.replace('$', ''), 16);
  return addr >= start && addr <= end;
}

function calculateHeight(region: MemoryRegion): string {
  const start = parseInt(region.start.replace('$', ''), 16);
  const end = parseInt(region.end.replace('$', ''), 16);
  const size = end - start + 1;
  
  // Scale for 64KB address space
  if (size >= 0x4000) return "20%";       // 16KB+
  if (size >= 0x2000) return "15%";       // 8KB
  if (size >= 0x1000) return "12%";       // 4KB
  if (size >= 0x800) return "10%";        // 2KB
  if (size >= 0x400) return "8%";         // 1KB
  if (size >= 0x20) return "6%";          // 32+ bytes
  return "4%";                            // Small regions
}
---

<div class="bg-slate-900 rounded-lg p-6 border border-slate-700">
  <div class="flex justify-between items-center mb-4">
    <h3 class="memory-map-title text-lg font-bold text-green-400">{title}</h3>
    <div class="flex gap-2">
      <span class={`px-2 py-1 rounded text-xs font-mono cursor-pointer transition-colors ${!showPPU ? "bg-blue-600 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500"}`}>
        CPU Memory
      </span>
      <span class={`px-2 py-1 rounded text-xs font-mono cursor-pointer transition-colors ${showPPU ? "bg-blue-600 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500"}`}>
        PPU Memory
      </span>
    </div>
  </div>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Memory Map Visualization -->
    <div class="bg-black rounded-lg p-4">
      <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">
        {showPPU ? "PPU" : "CPU"} Address Space (64KB)
      </h4>
      <div class="space-y-1">
        {regions.map((region) => (
          <div 
            class={`
              ${region.color} ${region.textColor} 
              rounded p-2 border-2 transition-all duration-300
              ${isHighlighted(region) ? 'border-yellow-400 ring-2 ring-yellow-400' : 'border-transparent'}
              ${isActiveAddress(region) ? 'border-red-400 ring-2 ring-red-400' : ''}
            `}
            style={`height: ${calculateHeight(region)}`}
          >
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="font-bold">{region.name}</span>
              {showAddresses && (
                <span>{region.start}-{region.end}</span>
              )}
            </div>
            <div class="text-xs opacity-75 mt-1">{region.description}</div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Memory Details -->
    <div class="space-y-4">
      {!showPPU ? (
        <!-- CPU Memory Details -->
        <>
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">CPU Memory Overview</h4>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Internal RAM:</span>
                <span class="text-white font-mono">2KB</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Program ROM:</span>
                <span class="text-white font-mono">32KB</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Save RAM:</span>
                <span class="text-white font-mono">8KB</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Total Space:</span>
                <span class="text-white font-mono">64KB</span>
              </div>
            </div>
          </div>
          
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Important CPU Addresses</h4>
            <div class="space-y-1 text-xs font-mono">
              <div class="flex justify-between">
                <span class="text-green-300">$0000-$00FF:</span>
                <span class="text-green-100">Zero page (fast)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-green-300">$0100-$01FF:</span>
                <span class="text-green-100">Stack</span>
              </div>
              <div class="flex justify-between">
                <span class="text-blue-300">$2002:</span>
                <span class="text-blue-100">PPU status</span>
              </div>
              <div class="flex justify-between">
                <span class="text-blue-300">$2007:</span>
                <span class="text-blue-100">PPU data</span>
              </div>
              <div class="flex justify-between">
                <span class="text-purple-300">$4016:</span>
                <span class="text-purple-100">Controller 1</span>
              </div>
              <div class="flex justify-between">
                <span class="text-red-300">$FFFA:</span>
                <span class="text-red-100">Interrupt vectors</span>
              </div>
            </div>
          </div>
          
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Programming Notes</h4>
            <div class="space-y-2 text-xs">
              <div class="text-green-200">
                <strong>Zero Page:</strong> Single-byte addressing
              </div>
              <div class="text-blue-200">
                <strong>PPU:</strong> Memory-mapped I/O
              </div>
              <div class="text-purple-200">
                <strong>Audio:</strong> 5 channels via APU
              </div>
              <div class="text-red-200">
                <strong>Banking:</strong> Mapper controls ROM
              </div>
            </div>
          </div>
        </>
      ) : (
        <!-- PPU Memory Details -->
        <>
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">PPU Memory Overview</h4>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Pattern Tables:</span>
                <span class="text-white font-mono">8KB</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Nametables:</span>
                <span class="text-white font-mono">4KB</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Palette RAM:</span>
                <span class="text-white font-mono">32 bytes</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Total Space:</span>
                <span class="text-white font-mono">16KB</span>
              </div>
            </div>
          </div>
          
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Graphics System</h4>
            <div class="space-y-1 text-xs font-mono">
              <div class="flex justify-between">
                <span class="text-cyan-300">$0000:</span>
                <span class="text-cyan-100">Background tiles</span>
              </div>
              <div class="flex justify-between">
                <span class="text-cyan-300">$1000:</span>
                <span class="text-cyan-100">Sprite tiles</span>
              </div>
              <div class="flex justify-between">
                <span class="text-teal-300">$2000:</span>
                <span class="text-teal-100">Screen layout</span>
              </div>
              <div class="flex justify-between">
                <span class="text-pink-300">$3F00:</span>
                <span class="text-pink-100">Color palettes</span>
              </div>
            </div>
          </div>
          
          <div class="bg-slate-800 rounded-lg p-4">
            <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Graphics Features</h4>
            <div class="space-y-2 text-xs">
              <div class="text-cyan-200">
                <strong>Tiles:</strong> 8×8 pixel, 2-bit color
              </div>
              <div class="text-teal-200">
                <strong>Nametables:</strong> 32×30 tile screens
              </div>
              <div class="text-pink-200">
                <strong>Palettes:</strong> 4 colors × 8 palettes
              </div>
              <div class="text-purple-200">
                <strong>Sprites:</strong> 64 sprites, 8 per scanline
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
  
  <!-- Game Development Focus -->
  <div class="mt-6 pt-4 border-t border-slate-700">
    <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Game Development Features</h4>
    <div class="bg-black rounded-lg p-4 text-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-green-400 mb-2">Performance Constraints:</div>
          <div class="space-y-1 text-slate-300">
            <div>• 1.79 MHz CPU (29,000 cycles/frame)</div>
            <div>• 2KB RAM for all variables</div>
            <div>• 256-byte stack maximum</div>
            <div>• Memory-mapped I/O timing critical</div>
          </div>
        </div>
        <div>
          <div class="text-green-400 mb-2">Graphics Capabilities:</div>
          <div class="space-y-1 text-slate-300">
            <div>• 256×240 resolution</div>
            <div>• 52 colors (16 at once)</div>
            <div>• Hardware scrolling</div>
            <div>• 64 sprites with priority</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .memory-region {
    transition: all 0.3s ease;
  }
  
  .memory-region:hover {
    transform: scale(1.02);
    z-index: 10;
  }

  /* Override lesson content heading styles */
  .memory-map-title {
    color: rgb(74 222 128) !important; /* text-green-400 */
    font-size: 1.125rem !important; /* text-lg */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 1rem !important; /* mb-4 */
  }

  .memory-map-subtitle {
    color: rgb(209 213 219) !important; /* text-slate-300 */
    font-size: 0.875rem !important; /* text-sm */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 0.75rem !important; /* mb-3 */
  }

  /* Override strong text in memory map content */
  .bg-slate-800 strong,
  .bg-black strong {
    color: rgb(255 255 255) !important; /* text-white */
    font-weight: 700 !important;
  }
</style>