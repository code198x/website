---
export interface Props {
  challenges: string[];
  platform?: string;
  tier?: number;
  lesson?: number;
}

const { challenges, platform = 'c64', tier = 1, lesson = 1 } = Astro.props;

// Platform-specific styling
const platformStyles = {
  'c64': {
    bg: 'bg-blue-50',
    border: 'border-blue-200',
    text: 'text-blue-800',
    accent: 'text-blue-600'
  },
  'spectrum': {
    bg: 'bg-indigo-50',
    border: 'border-indigo-200', 
    text: 'text-indigo-800',
    accent: 'text-indigo-600'
  },
  'amiga': {
    bg: 'bg-orange-50',
    border: 'border-orange-200',
    text: 'text-orange-800',
    accent: 'text-orange-600'
  },
  'bbcmicro': {
    bg: 'bg-red-50',
    border: 'border-red-200',
    text: 'text-red-800',
    accent: 'text-red-600'
  },
  'amstradcpc': {
    bg: 'bg-green-50',
    border: 'border-green-200',
    text: 'text-green-800',
    accent: 'text-green-600'
  },
  'appleii': {
    bg: 'bg-blue-50',
    border: 'border-blue-200',
    text: 'text-blue-800',
    accent: 'text-blue-600'
  },
  'atarist': {
    bg: 'bg-slate-50',
    border: 'border-slate-200',
    text: 'text-slate-800',
    accent: 'text-slate-600'
  },
  'atari800': {
    bg: 'bg-red-50',
    border: 'border-red-200',
    text: 'text-red-800',
    accent: 'text-red-600'
  },
  'ti994a': {
    bg: 'bg-blue-50',
    border: 'border-blue-200',
    text: 'text-blue-800',
    accent: 'text-blue-600'
  },
  'dragon': {
    bg: 'bg-yellow-50',
    border: 'border-yellow-200',
    text: 'text-yellow-800',
    accent: 'text-yellow-600'
  },
  'jupiterace': {
    bg: 'bg-purple-50',
    border: 'border-purple-200',
    text: 'text-purple-800',
    accent: 'text-purple-600'
  }
};

const currentStyle = platformStyles[platform as keyof typeof platformStyles] || platformStyles.c64;
---

<section class={`p-6 rounded-xl border ${currentStyle.border} ${currentStyle.bg}`}>
  <div class="flex items-center gap-3 mb-4">
    <span class="text-2xl">🎯</span>
    <h2 class={`text-xl font-bold ${currentStyle.text}`}>Try These Challenges</h2>
  </div>
  
  <p class={`${currentStyle.accent} mb-6 text-sm`}>
    Now that you've worked through the lesson, try these challenges to test your understanding:
  </p>
  
  <div class="space-y-4">
    {challenges.map((challenge, index) => (
      <div class="flex items-start gap-4 p-4 bg-white/70 rounded-lg border border-white/50">
        <div class="flex-shrink-0">
          <div class={`w-8 h-8 rounded-full border-2 ${currentStyle.border} ${currentStyle.bg} flex items-center justify-center font-mono text-sm font-bold ${currentStyle.text}`}>
            {index + 1}
          </div>
        </div>
        <div class="flex-1">
          <p class="text-slate-700 leading-relaxed">
            {challenge}
          </p>
          <div class="mt-3 flex items-center gap-3">
            <button 
              class={`text-xs px-3 py-1 ${currentStyle.bg} ${currentStyle.accent} border ${currentStyle.border} rounded-full hover:bg-white/50 transition-colors`}
              data-challenge-toggle={index}
            >
              💡 Hint
            </button>
            <button 
              class={`text-xs px-3 py-1 bg-white ${currentStyle.accent} border border-slate-300 rounded-full hover:bg-slate-50 transition-colors`}
              data-challenge-complete={index}
            >
              ✓ Mark Complete
            </button>
          </div>
          
          <!-- Hidden hint content -->
          <div 
            class={`mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-800 hidden`}
            data-hint={index}
          >
            <strong>Hint:</strong> Try modifying one of the programs from this lesson as a starting point. 
            Remember to use line numbers and test your program step by step!
          </div>
        </div>
      </div>
    ))}
  </div>
  
  <div class="mt-6 p-4 bg-white/50 rounded-lg border border-white/70">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-lg">💪</span>
      <h3 class={`font-bold ${currentStyle.text}`}>Challenge Progress</h3>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex-1 bg-slate-200 rounded-full h-2">
        <div 
          class={`h-2 rounded-full transition-all duration-300 ${currentStyle.bg.replace('bg-', 'bg-').replace('50', '500')}`}
          data-progress-bar
          style="width: 0%"
        ></div>
      </div>
      <span class={`text-sm font-medium ${currentStyle.text}`} data-progress-text>
        0 of {challenges.length}
      </span>
    </div>
    <p class="text-xs text-slate-600 mt-2">
      Complete the challenges at your own pace. There's no rush!
    </p>
  </div>
</section>

<style>
  [data-challenge-complete].completed {
    @apply bg-green-100 text-green-700 border-green-300;
  }
  
  [data-challenge-complete].completed::before {
    content: "✓ ";
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const challenges = document.querySelectorAll('[data-challenge-complete]');
    const progressBar = document.querySelector('[data-progress-bar]');
    const progressText = document.querySelector('[data-progress-text]');
    const hintButtons = document.querySelectorAll('[data-challenge-toggle]');
    
    let completedCount = 0;
    const totalChallenges = challenges.length;
    
    // Hint toggle functionality
    hintButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        const index = e.target.dataset.challengeToggle;
        const hint = document.querySelector(`[data-hint="${index}"]`);
        
        if (hint) {
          hint.classList.toggle('hidden');
          button.textContent = hint.classList.contains('hidden') ? '💡 Hint' : '🙈 Hide Hint';
        }
      });
    });
    
    // Challenge completion functionality
    challenges.forEach((button, index) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        
        if (button.classList.contains('completed')) {
          // Uncomplete
          button.classList.remove('completed');
          button.textContent = '✓ Mark Complete';
          completedCount--;
        } else {
          // Complete
          button.classList.add('completed');
          button.textContent = '✓ Completed';
          completedCount++;
          
          // Show a little celebration
          button.style.transform = 'scale(1.1)';
          setTimeout(() => {
            button.style.transform = 'scale(1)';
          }, 200);
        }
        
        // Update progress
        const percentage = (completedCount / totalChallenges) * 100;
        if (progressBar) {
          progressBar.style.width = `${percentage}%`;
        }
        if (progressText) {
          progressText.textContent = `${completedCount} of ${totalChallenges}`;
        }
        
        // Save progress to localStorage
        const storageKey = `phase0-challenges-${window.location.pathname}`;
        const completed = Array.from(challenges).map(btn => btn.classList.contains('completed'));
        localStorage.setItem(storageKey, JSON.stringify(completed));
        
        // Show completion message
        if (completedCount === totalChallenges && totalChallenges > 0) {
          setTimeout(() => {
            alert('🎉 Congratulations! You\'ve completed all the challenges for this lesson. Ready for the next one?');
          }, 300);
        }
      });
    });
    
    // Load saved progress
    const storageKey = `phase0-challenges-${window.location.pathname}`;
    const savedProgress = localStorage.getItem(storageKey);
    
    if (savedProgress) {
      try {
        const completed = JSON.parse(savedProgress);
        completed.forEach((isCompleted, index) => {
          if (isCompleted && challenges[index]) {
            challenges[index].click();
          }
        });
      } catch (e) {
        console.log('Could not load saved challenge progress');
      }
    }
  });
</script>