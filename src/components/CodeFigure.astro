---
/**
 * CodeFigure — an annotated assembly figure for the "From the Metal" series.
 *
 * A dark "terminal" figure: a header bar (left label, optional right metric
 * chip whose colour signals good/bad/middling), the syntax-highlighted body,
 * and an italic caption. The figure stays dark in both light and dark site
 * themes — it's a screen.
 *
 * Highlighting uses classic shiki inline spans (dark-plus + the custom 6502 /
 * Z80 / 68000 grammars), NOT the site's default CSS Custom Highlight API path:
 * inline spans render identically in every browser AND carry their colour into
 * print/PDF, where custom highlights are not painted. Comment colour is uniform
 * by design; the headline emphasis is the metric chip, not tinted comments.
 *
 * Usage (in MDX):
 *   <CodeFigure lang="6502" label="6502 · ROLLED" metric="3,584 cycles" state="bad"
 *     caption="Two instructions copy a byte. Two more just keep the loop going."
 *     code={`        ldx #0
 * loop:   lda source,x   ; 4 cycles`} />
 */
import { highlightFtm } from '../lib/ftm-highlighter';

interface Props {
  code: string;                          // raw source
  label: string;                         // header left, e.g. "6502 · ROLLED"
  lang?: string;                         // highlight language (default 6502)
  metric?: string;                       // header right chip, e.g. "3,584 cycles"
  state?: 'bad' | 'good' | 'mid';        // metric chip colour
  caption?: string;                      // italic figcaption
}

const { code, label, lang = '6502', metric, state, caption } = Astro.props;

const html = await highlightFtm(code, lang);
// Make the scrollable <pre> keyboard-focusable (WCAG scrollable-region-focusable).
const bodyHtml = html.replace(/<pre(?![^>]*\btabindex)/, '<pre tabindex="0"');
import { inlineMarkdown } from '../lib/inline-markdown';
---

<figure class="cf">
  <div class="cf-head">
    <span class="cf-label">{label}</span>
    {metric && <span class={`cf-metric ${state ?? ''}`}>{metric}</span>}
  </div>
  <div class="cf-body" set:html={bodyHtml} />
  {caption && <figcaption set:html={inlineMarkdown(caption)} />}
</figure>

<style>
  .cf { margin: 0 0 0.9rem; }

  .cf-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #1e293b;
    padding: 8px 16px;
    border: 3px solid #1e293b;
    border-bottom: none;
  }
  .cf-label {
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #94a3b8;
  }
  .cf-metric {
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: #94a3b8;
    white-space: nowrap;
  }
  .cf-metric.bad { color: #fca5a5; }
  .cf-metric.good { color: #86efac; }
  .cf-metric.mid { color: #fcd34d; }

  /* The highlighted <pre> comes from shiki (inline spans, with its own theme
     background inline). Pin the chrome to the figure's terminal look. */
  .cf-body :global(pre) {
    margin: 0 !important;
    background: #0f172a !important;
    font-family: var(--font-family-mono);
    font-size: 14px;
    line-height: 1.75;
    padding: 20px 22px;
    overflow-x: auto;
    border: 3px solid #1e293b;
  }
  .cf-body :global(pre):focus-visible {
    outline: 2px solid var(--color-house-2);
    outline-offset: -2px;
  }
  /* Keep figure colours on paper. */
  @media print {
    .cf-body :global(pre), .cf-body :global(pre span) {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }

  figcaption {
    font-family: var(--font-family-sans);
    font-style: italic;
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-top: 10px;
  }
</style>
