---
import fs from 'node:fs';
import path from 'node:path';
interface Props {src: string; name: string;}
const {src,name}=Astro.props;
const source=fs.readFileSync(path.join(process.env.CODE_SAMPLES_PATH || path.resolve('../code-samples'),src),'utf8').trimEnd();
---
<section class="lesson-listing" data-basic-listing data-name={name} aria-label="Editable BASIC listing">
  <div class="listing-caption"><label for={`listing-${name}`}>Your BASIC listing</label><span class="listing-changes" role="status">Original code</span></div>
  <div class="listing-editor">
    <pre class="listing-mirror" aria-hidden="true"></pre>
    <textarea id={`listing-${name}`} aria-describedby={`listing-help-${name}`} rows={source.split('\n').length} spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off">{source}</textarea>
  </div>
  <p class="listing-error" role="alert" hidden></p>
  <div class="listing-actions"><button class="listing-run primary-action" type="button">Run this code</button><p class="listing-status" role="status">Opens in your Spectrum.</p></div>
  <p class="listing-hint" id={`listing-help-${name}`}>Edit this listing, then run it. Changes are marked against the original code.</p>
  <details class="listing-options"><summary>Listing options</summary><div><button class="listing-reset" type="button">Reset to original</button><button class="listing-download" type="button">Download tape</button></div><p>Original code</p><pre>{source}</pre></details>
  <script type="application/json" class="listing-original" set:html={JSON.stringify(source).replaceAll('<','\\u003c')}/>
</section>
<script src="../lib/basic-listing.ts"></script>
<style>
.lesson-listing{max-width:70ch;margin:24px 0 32px;min-width:0}
.listing-caption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;margin-bottom:12px;font:16px/1.5 var(--h-font-ui)}
.listing-caption label{font-weight:600}.listing-changes{color:var(--h-ink-muted)}
.listing-editor{position:relative;background:var(--h-ground);border-block:1px solid var(--h-line);min-width:0}
.listing-editor:focus-within{outline:2px solid var(--h-spot);outline-offset:3px}
.listing-editor>textarea,.listing-editor>pre{box-sizing:border-box;width:100%;margin:0!important;padding:20px 24px!important;font:18px/30px var(--h-font-mono)!important;letter-spacing:normal;tab-size:4;white-space:pre;word-wrap:normal;border:0;border-radius:0;text-transform:none;text-align:left}
.listing-editor>textarea{position:relative;display:block;resize:none;background:transparent;color:var(--h-ink);caret-color:var(--h-ink);outline:none;overflow:auto;min-height:130px}
.listing-editor>pre{position:absolute;inset:0;overflow:hidden;pointer-events:none;color:var(--h-ink);background:transparent}
.listing-editor.highlighted>textarea{color:transparent;-webkit-text-fill-color:transparent}
.listing-editor>textarea::selection{background:color-mix(in srgb,var(--h-spot) 20%,transparent)}
.listing-editor :global(mark){color:inherit;background:color-mix(in srgb,var(--h-spot) 11%,var(--h-ground));text-decoration:underline;text-decoration-color:var(--h-spot);text-underline-offset:5px}
.listing-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px 20px;margin-top:16px}.listing-actions button{font:600 16px/1.5 var(--h-font-ui);border-radius:0}
.listing-status,.listing-hint{font:16px/1.6 var(--h-font-ui);margin:0;color:var(--h-ink-muted)}.listing-hint{margin-top:12px;max-width:65ch}
.listing-options{margin-top:16px;font:16px/1.5 var(--h-font-ui)}.listing-options summary{cursor:pointer;min-height:44px;padding-block:10px;width:fit-content;text-decoration:underline;text-underline-offset:4px}.listing-options>div{display:flex;flex-wrap:wrap;gap:12px}.listing-options button{font:16px/1.5 var(--h-font-ui);border:1px solid var(--h-line);border-radius:0;background:var(--h-ground);color:var(--h-ink);padding:8px 12px}.listing-options p{margin:20px 0 8px;font-weight:600}.listing-options pre{font:16px/1.7 var(--h-font-mono);white-space:pre-wrap;overflow-wrap:anywhere;padding:0;background:transparent}
.listing-error{font:16px/1.6 var(--h-font-ui);color:var(--h-ink);border-top:2px solid var(--h-spot);padding-top:12px;margin:16px 0 0;overflow-wrap:anywhere}
@media(max-width:600px){.listing-editor>textarea,.listing-editor>pre{font-size:16px!important;line-height:28px!important;padding:16px 12px!important}.listing-caption{font-size:14px}}
@media(forced-colors:active){.listing-editor>pre{display:none}.listing-editor.highlighted>textarea{color:CanvasText;-webkit-text-fill-color:CanvasText}}
</style>
