---
/**
 * Output — what a program produces when it runs.
 *
 * Stands where a machine screenshot stands in a track that names a machine.
 * General Programming names none, so the result is shown plainly rather than
 * dressed as any particular screen: this is what the program produces, not a
 * picture of one machine producing it.
 *
 * Usage:
 *   <Output>Hello</Output>
 *   <Output label="After three guesses">Too low
 *   Too high
 *   Correct!</Output>
 */

interface Props {
  label?: string;
}

const { label = 'Output' } = Astro.props;
---

<figure class="program-output">
  <span class="program-output-label">{label}</span>
  <pre><slot /></pre>
</figure>

<style>
  /* Light is the default; dark is the override, for an explicit dark choice or
     a system preference with no choice made — the arrangement the rest of the
     site's tokens use. */
  .program-output {
    --output-bg: var(--color-surface);
    --output-border: var(--color-border);
    --output-ink: var(--color-text);
    --output-label: var(--color-text-secondary);

    margin: 1.5rem 0;
    border: 1px solid var(--output-border);
    border-radius: 4px;
    background: var(--output-bg);
    overflow: hidden;
  }

  :root[data-theme='dark'] .program-output {
    --output-bg: var(--color-surface);
    --output-border: var(--color-border);
    --output-ink: var(--color-text);
    --output-label: var(--color-text-secondary);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .program-output {
      --output-bg: var(--color-surface);
      --output-border: var(--color-border);
      --output-ink: var(--color-text);
      --output-label: var(--color-text-secondary);
    }
  }

  .program-output-label {
    display: block;
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid var(--output-border);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--output-label);
  }

  .program-output pre {
    margin: 0;
    padding: 0.85rem 0.75rem;
    background: none;
    border: none;
    color: var(--output-ink);
    font-family: var(--font-family-mono, monospace);
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-x: auto;
  }
</style>
