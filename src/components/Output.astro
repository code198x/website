---
/**
 * Output — what a program produces when it runs.
 *
 * Stands where a machine screenshot stands in a track that names a machine.
 * General Programming names none, so the result is shown plainly rather than
 * dressed as any particular screen: this is what the program produces, not a
 * picture of one machine producing it.
 *
 * Pass the text as a template literal, always:
 *
 *   <Output>{`Hello`}</Output>
 *   <Output label="After three guesses">{`Too low
 *   Too high
 *   Correct!`}</Output>
 *
 * MDX parses a JSX element's children as markdown, and a transcript is not
 * markdown — it is whatever the program printed. Written as bare children, a
 * row of hyphens under a line of text is a setext heading underline that
 * markdown swallows, and `--` becomes an en dash on the way past. That failure
 * deletes lines rather than restyling them, and the page still builds. An
 * expression hands MDX a string instead of markup, so the transcript arrives
 * intact. output-blocks.test.ts holds every call site to this form.
 *
 * Drawn as the concept's "It prints" side: the House198x listing panel
 * (styles/lesson.css), square and in the page's theme, with the text in the
 * mono face and no syntax colour, because it is output, not source.
 */
import '../styles/lesson.css';

interface Props {
  label?: string;
}

const { label = 'Output' } = Astro.props;
---

<figure class="program-output lesson-listing">
  <figcaption class="ll-head"><span class="ll-label program-output-label">{label}</span></figcaption>
  <div class="ll-scroll" data-ll-scroll data-label={label} tabindex="0" role="region" aria-label={label}><pre class="ll-pre program-output-text"><slot /></pre></div>
</figure>

<style>
  .program-output { max-width: var(--measure, 100%); }
  .program-output .program-output-text {
    padding: calc(var(--h-cell) * 2) calc(var(--h-cell) * 3);
    white-space: pre;
  }
</style>
