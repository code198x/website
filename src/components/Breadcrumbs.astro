---
/**
 * Breadcrumbs - Navigation breadcrumb trail
 *
 * Usage:
 *   import Breadcrumbs from '@components/Breadcrumbs.astro';
 *   <Breadcrumbs />
 *
 * Automatically generates breadcrumbs from the current URL path.
 * Can override with custom items prop for special cases.
 */
import { getAllPlatforms } from '../lib/platforms';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items?: BreadcrumbItem[];
  platformColor?: string;
  /** Replaces the label of the final crumb, which the URL alone cannot name
      well: "Unit 1" is all a path knows, "Unit 1 of 11: A Program Is
      Instructions" is what the reader needs. */
  currentLabel?: string;
}

const { items: customItems, platformColor, currentLabel } = Astro.props;

// Build platform slug -> name mapping from collection
const platforms = await getAllPlatforms();
const platformLabels = Object.fromEntries(
  platforms.map(p => [p.id, p.data.name])
);

// Words that should be uppercase in game names
const uppercaseWords = new Set(['sid', 'nes', 'zx', 'vic', 'cpu', 'api', 'dma', 'rgb']);

// Map URL segments to human-readable labels
const segmentLabels: Record<string, string> = {
  ...platformLabels,
  'assembly': 'Assembly',
  'basic': 'BASIC',
  'amos': 'AMOS',
  'vault': 'The Vault',
  'patterns': 'Patterns',
  'craft': 'The Craft',
  'setup': 'Setup',
  'timeline': 'Timeline',
  'about': 'About',
  'hardware': 'Hardware',
  'people': 'People',
  'games': 'Games',
  'culture': 'Culture',
  'techniques': 'Techniques',
  'systems': 'Systems',
  'standards': 'Sources & Standards',
  'start-here': 'Start Here',
  'from-the-metal': 'From the Metal',
  'demoscene': 'The demoscene',
  'teaching': 'Teaching',
  'foundations': 'Foundations',
  'basics': 'The Basics',
  'working-it-out': 'Working It Out',
  'decisions': 'Decisions',
  'repeating': 'Repeating',
  'structure': 'Structure',
  'counting-in-twos': 'Counting in Twos',
  'working-the-bits': 'Working the Bits',
  'press': 'Press',
  'getting-started': 'Getting Started',
  'native': 'Native',
  'crash-live': 'CRASH! Live',
  'browse': 'Browse',
  'contribute': 'Contribute',
  'curriculum': 'Curriculum Map',
  'by-platform': 'By platform',
  'by-maker': 'By maker',
  'by-tier': 'By tier',
  'by-era': 'By era',
  'by-region': 'By region',
  'by-genre': 'By genre',
  'by-technique': 'By technique',
  'by-difficulty': 'By difficulty',
};

// Humanise a slug segment not in `segmentLabels`: split on hyphens and
// title-case each word (acronyms in `uppercaseWords` go fully uppercase). Turns
// "from-the-metal" → "From The Metal" and "second-reality" → "Second Reality"
// rather than the old first-letter-only "From-the-metal".
function humanise(segment: string): string {
  return segment
    .split('-')
    .map(word => uppercaseWords.has(word.toLowerCase())
      ? word.toUpperCase()
      : word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Generate breadcrumbs from URL if not provided
function generateBreadcrumbs(pathname: string): BreadcrumbItem[] {
  const segments = pathname.split('/').filter(Boolean);
  const crumbs: BreadcrumbItem[] = [{ label: 'Home', href: '/' }];

  let currentPath = '';
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i];
    currentPath += `/${segment}`;

    // Check for game/unit pattern (e.g., game-01-starfield)
    const gameMatch = segment.match(/^game-(\d+)-(.+)$/);
    const unitMatch = segment.match(/^unit-(\d+)$/);

    let label: string;
    if (gameMatch) {
      // Convert game-01-starfield to "Game 1: Starfield"
      const gameNum = parseInt(gameMatch[1], 10);
      const gameName = humanise(gameMatch[2]);
      label = `Game ${gameNum}: ${gameName}`;
    } else if (unitMatch) {
      label = `Unit ${parseInt(unitMatch[1], 10)}`;
    } else {
      label = segmentLabels[segment] || humanise(segment);
    }

    // Last item has no href (current page)
    const isLast = i === segments.length - 1;
    crumbs.push({
      label,
      href: isLast ? undefined : currentPath,
    });
  }

  return crumbs;
}

const breadcrumbs = customItems || generateBreadcrumbs(Astro.url.pathname);

if (currentLabel && breadcrumbs.length > 0) {
  breadcrumbs[breadcrumbs.length - 1].label = currentLabel;
}

// Don't render if only home
if (breadcrumbs.length <= 1) {
  return;
}

const accentColor = platformColor || 'var(--color-primary)';
---

<nav class="breadcrumbs" aria-label="Breadcrumb" style={`--accent-color: ${accentColor};`}>
  <div class="breadcrumbs-inner">
    <ol>
    {breadcrumbs.map((crumb, index) => (
      <li>
        {crumb.href ? (
          <a href={crumb.href}>{crumb.label}</a>
        ) : (
          <span aria-current="page">{crumb.label}</span>
        )}
        {index < breadcrumbs.length - 1 && (
          <span class="separator" aria-hidden="true">›</span>
        )}
      </li>
      ))}
    </ol>
    <div class="breadcrumbs-end"><slot name="end" /></div>
  </div>
</nav>

<script>
  // The contents list is sticky too and has to clear this bar; the height
  // depends on the font and the padding, so it is measured, not assumed.
  const bar = document.querySelector<HTMLElement>('.breadcrumbs');
  if (bar && 'ResizeObserver' in window) {
    const publish = () =>
      document.documentElement.style.setProperty('--crumbs-height', `${bar.offsetHeight}px`);
    new ResizeObserver(publish).observe(bar);
    publish();
  }
</script>

<style>
  /* Rides under the site nav. On a unit this is the bar that keeps where you
     are, how far through you are, and the control that marks it done on screen
     while you read. */
  .breadcrumbs {
    position: sticky;
    top: var(--nav-height);
    z-index: 60;
    padding: var(--space-2) 0;
    background: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  /* The same box the nav uses, padding included, so the trail starts under
     the logo and the end group finishes under the theme button. The two bars
     stack, and 16px of drift between them reads as a wobble. */
  .breadcrumbs-inner {
    /* Explicit: there is no universal reset, and the nav's container is
       border-box. Without this the padding widens the box instead of insetting
       the content, and the two bars stay 16px out of step. */
    box-sizing: border-box;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .breadcrumbs-end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
    flex-shrink: 0;
  }

  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
    border-radius: 0.125rem;
  }

  span[aria-current="page"] {
    color: var(--color-text);
    font-weight: 500;
  }

  .separator {
    color: var(--color-text-muted);
    margin: 0 var(--space-1);
  }

  @media (max-width: 768px) {
    .breadcrumbs {
      font-size: 0.8125rem;
    }

    /* On mobile, truncate long breadcrumb labels */
    a, span[aria-current="page"] {
      max-width: 120px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
