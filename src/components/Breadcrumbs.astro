---
/**
 * Breadcrumbs - Navigation breadcrumb trail
 *
 * Usage:
 *   import Breadcrumbs from '@components/Breadcrumbs.astro';
 *   <Breadcrumbs />
 *
 * Automatically generates breadcrumbs from the current URL path.
 * Can override with custom items prop for special cases.
 */
import { getAllPlatforms } from '../lib/platforms';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items?: BreadcrumbItem[];
  platformColor?: string;
  /** Replaces the label of the final crumb, which the URL alone cannot name
      well: "Unit 1" is all a path knows, "Unit 1 of 11: A Program Is
      Instructions" is what the reader needs. */
  currentLabel?: string;
}

const { items: customItems, platformColor, currentLabel } = Astro.props;

// Build platform slug -> name mapping from collection
const platforms = await getAllPlatforms();
const platformLabels = Object.fromEntries(
  platforms.map(p => [p.id, p.data.name])
);

// Words that should be uppercase in game names
const uppercaseWords = new Set(['sid', 'nes', 'zx', 'vic', 'cpu', 'api', 'dma', 'rgb', 'basic']);

// Map URL segments to human-readable labels
const segmentLabels: Record<string, string> = {
  ...platformLabels,
  'assembly': 'Assembly',
  'basic': 'BASIC',
  'amos': 'AMOS',
  'vault': 'The Vault',
  'patterns': 'Patterns',
  'craft': 'The Craft',
  'setup': 'Setup',
  'timeline': 'Timeline',
  'about': 'About',
  'hardware': 'Hardware',
  'people': 'People',
  'games': 'Games',
  'culture': 'Culture',
  'techniques': 'Techniques',
  'tools': 'Tools',
  'languages': 'Languages',
  'software': 'Software',
  'design': 'Design',
  'technologies': 'Technologies',
  'reference': 'Reference',
  'systems': 'Systems',
  'standards': 'Sources and Standards',
  'start-here': 'Start Here',
  'from-the-metal': 'From the Metal',
  'demoscene': 'The Demoscene',
  'teaching': 'For Teachers',
  'foundations': 'Foundations',
  'basics': 'The Basics',
  'working-it-out': 'Working It Out',
  'decisions': 'Decisions',
  'repeating': 'Repeating',
  'structure': 'Structure',
  'counting-in-twos': 'Counting in Twos',
  'working-the-bits': 'Working the Bits',
  'press': 'Press',
  'getting-started': 'Getting Started',
  'native': 'Native',
  'crash-live': 'CRASH! Live',
  'browse': 'Browse',
  'contribute': 'Contribute',
  'curriculum': 'Curriculum Map',
  'by-platform': 'By Platform',
  'by-maker': 'By Maker',
  'by-tier': 'By Tier',
  'by-era': 'By Era',
  'by-region': 'By Region',
  'by-genre': 'By Genre',
  'by-technique': 'By Technique',
  'by-difficulty': 'By Difficulty',
  'updates': "What's New",
  'family': 'The 198x Family',
  'colophon': 'Colophon',
};

// Humanise a slug segment not in `segmentLabels`: split on hyphens and
// title-case each word (acronyms in `uppercaseWords` go fully uppercase). Turns
// "from-the-metal" → "From The Metal" and "second-reality" → "Second Reality"
// rather than the old first-letter-only "From-the-metal".
function humanise(segment: string): string {
  return segment
    .split('-')
    .map(word => uppercaseWords.has(word.toLowerCase())
      ? word.toUpperCase()
      : word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Track overview pages are hand-built, one per system/track, so a track can
// have lessons without one (the Spectrum's Machine track). A crumb for a track
// with no page is shown as plain text rather than a link to a 404.
const trackPages = new Set(
  Object.keys(import.meta.glob('/src/pages/systems/*/*/index.astro'))
    .map((file) => file.replace(/^\/src\/pages/, '').replace(/\/index\.astro$/, '')),
);
const isTrackPath = (path: string) => /^\/systems\/[^/]+\/[^/]+$/.test(path);

// Generate breadcrumbs from URL if not provided
function generateBreadcrumbs(pathname: string): BreadcrumbItem[] {
  const segments = pathname.split('/').filter(Boolean);
  const crumbs: BreadcrumbItem[] = [{ label: 'Home', href: '/' }];

  let currentPath = '';
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i];
    currentPath += `/${segment}`;

    // Check for game/unit pattern (e.g., game-01-starfield)
    const gameMatch = segment.match(/^game-(\d+)-(.+)$/);
    const unitMatch = segment.match(/^unit-(\d+)$/);

    let label: string;
    if (gameMatch) {
      // Convert game-01-starfield to "Game 1: Starfield"
      const gameNum = parseInt(gameMatch[1], 10);
      const gameName = humanise(gameMatch[2]);
      label = `Game ${gameNum}: ${gameName}`;
    } else if (unitMatch) {
      label = `Unit ${parseInt(unitMatch[1], 10)}`;
    } else {
      label = segmentLabels[segment] || humanise(segment);
    }

    // Last item has no href (current page)
    const isLast = i === segments.length - 1;
    const hasPage = !isTrackPath(currentPath) || trackPages.has(currentPath);
    crumbs.push({
      label,
      href: isLast || !hasPage ? undefined : currentPath,
    });
  }

  return crumbs;
}

const breadcrumbs = customItems || generateBreadcrumbs(Astro.url.pathname);

if (currentLabel && breadcrumbs.length > 0) {
  breadcrumbs[breadcrumbs.length - 1].label = currentLabel;
}

// Don't render if only home
if (breadcrumbs.length <= 1) {
  return;
}

const accentColor = platformColor || 'var(--color-primary)';

/* The bar (umbrella decisions/family-visual-identity.md §7): the section in a
   spot-ink block, then the trail. Home and the current page are hidden from
   sight but kept for screen readers, since the wordmark links home and the
   headline names the page. A section front is its own section, so its one
   crumb is both. On a phone only the section and the parent show. */
const last = breadcrumbs.length - 1;
const roleOf = (index: number) =>
  index === 0 ? 'home' : index === 1 ? 'section' : index === last ? 'current' : 'trail';
const end = await Astro.slots.render('end');
---

<nav class="breadcrumbs" aria-label="Breadcrumb" style={`--accent-color: ${accentColor};`}>
  <div class="breadcrumbs-inner" data-site-frame>
    <ol>
    {breadcrumbs.map((crumb, index) => (
      <li class={`crumb crumb-${roleOf(index)}`} data-parent={index === last - 1 && index > 1 ? '' : undefined}>
        {index > 2 && index < last && <span class="separator" aria-hidden="true">›</span>}
        {crumb.href && index < last ? (
          <a href={crumb.href}>{crumb.label}</a>
        ) : (
          <span aria-current={index === last ? 'page' : undefined}>{crumb.label}</span>
        )}
      </li>
      ))}
    </ol>
  </div>
</nav>
{end.trim() && <div class="breadcrumbs-end" data-site-frame><Fragment set:html={end} /></div>}

<script>
  // The contents list is sticky too and has to clear this bar; the height
  // depends on the font and the padding, so it is measured, not assumed.
  // A soft navigation (ClientRouter) replaces the bar and resets the root's
  // inline style, so measure and observe the new bar on every page load.
  let observer: ResizeObserver | undefined;
  function measure() {
    observer?.disconnect();
    const bar = document.querySelector<HTMLElement>('.breadcrumbs');
    if (!bar) { document.documentElement.style.setProperty('--crumbs-height', '0px'); return; }
    if (!('ResizeObserver' in window)) return;
    const publish = () =>
      document.documentElement.style.setProperty('--crumbs-height', `${bar.offsetHeight}px`);
    observer = new ResizeObserver(publish);
    observer.observe(bar);
    publish();
  }
  measure();
  document.addEventListener('astro:page-load', measure);
</script>

<style>
.breadcrumbs{position:relative;z-index:1;background:var(--h-ink);color:var(--h-page);font:600 1rem/1.25 var(--h-font-ui)}
.breadcrumbs-inner{box-sizing:border-box;max-width:var(--site-frame-width,1264px);margin:auto;padding:0 var(--page-gutter)}
ol{display:flex;flex-wrap:wrap;align-items:center;column-gap:12px;min-height:56px;list-style:none;margin:0;padding:0}
li{display:flex;align-items:center;gap:12px;min-width:0}
/* Hidden from sight, not from screen readers. */
.crumb-home,.crumb-current{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
/* The section: a spot-ink block in the magazine face, its text level with the page's left edge. */
.crumb-section{align-self:stretch;margin-inline-end:8px}
.crumb-section>:is(a,span){display:flex;align-items:center;min-height:56px;box-sizing:border-box;margin-inline-start:calc(-1 * min(20px, var(--page-gutter)));padding:0 20px;background:var(--h-spot);color:var(--h-ink-on-accent);font:italic 900 28px/1 var(--h-font-mag);text-transform:uppercase;text-decoration:none}
.crumb-trail>:is(a,span){display:inline-flex;align-items:center;min-height:44px;color:var(--h-page);text-decoration:none}
.separator{color:color-mix(in srgb, var(--h-page) 55%, transparent)}
a:hover,a:focus-visible{text-decoration:underline;text-underline-offset:5px}
.crumb-section>a:hover{text-decoration:none}
a:focus-visible{outline:2px solid var(--h-page);outline-offset:2px}
.crumb-section>a:focus-visible{outline-offset:-5px}
.breadcrumbs-end{box-sizing:border-box;max-width:var(--site-frame-width,1264px);margin:auto;padding:16px var(--page-gutter) 16px}
@media (max-width:640px){
  ol{min-height:48px}
  .breadcrumbs{font-size:.9375rem}
  .crumb-section>:is(a,span){min-height:48px;padding:0 14px;margin-inline-start:calc(-1 * min(14px, var(--page-gutter)));font-size:22px}
  /* The section and a way back up one level. */
  .crumb-trail:not([data-parent]){position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .separator{display:none}
  [data-parent]>a::before{content:"‹\00a0"}
}
</style>
