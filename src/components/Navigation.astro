---
export interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navItems = [
  { href: "/", label: "Home", icon: "🏠" },
  { href: "/getting-started", label: "Get Started", icon: "🚀" },
  { href: "/lessons", label: "Learn", icon: "📚" },
  { href: "/about", label: "About", icon: "ℹ️" },
];

const isActive = (href: string) => {
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<nav class="nav-modern" aria-label="Main navigation">
  <!-- Desktop Navigation -->
  <div class="nav-desktop">
    <div class="nav-container">
      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label="Code198x Home">
        <img src="/logo-horizontal.svg" alt="Code Like It's 198x" />
      </a>
      
      <!-- Center Menu -->
      <ul class="nav-menu">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class={`nav-item ${isActive(item.href) ? "nav-item--active" : ""}`}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              <span class="nav-item__icon">{item.icon}</span>
              <span class="nav-item__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      
      <!-- Right Actions -->
      <div class="nav-actions">
        <button class="nav-search" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>
        <button class="nav-theme" aria-label="Toggle theme">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile Navigation -->
  <div class="nav-mobile">
    <div class="nav-mobile-header">
      <a href="/" class="nav-mobile-logo">
        <img src="/logo-horizontal.svg" alt="Code Like It's 198x" />
      </a>
      <button class="nav-mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
    
    <!-- Mobile Menu Overlay -->
    <div class="nav-mobile-overlay" aria-hidden="true"></div>
    
    <!-- Mobile Menu Panel -->
    <div class="nav-mobile-menu" aria-hidden="true">
      <ul class="nav-mobile-list">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class={`nav-mobile-item ${isActive(item.href) ? "nav-mobile-item--active" : ""}`}
            >
              <span class="nav-mobile-item__icon">{item.icon}</span>
              <span class="nav-mobile-item__label">{item.label}</span>
              {isActive(item.href) && (
                <span class="nav-mobile-item__indicator"></span>
              )}
            </a>
          </li>
        ))}
      </ul>
      
      <div class="nav-mobile-footer">
        <button class="nav-mobile-search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          Search
        </button>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Uses design system variables from Layout.astro */
  
  /* Base Navigation */
  .nav-modern {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-light);
  }
  
  /* Desktop Navigation */
  .nav-desktop {
    display: block;
  }
  
  .nav-mobile {
    display: none;
  }
  
  @media (max-width: 767px) {
    .nav-desktop {
      display: none;
    }
    
    .nav-mobile {
      display: block;
    }
  }
  
  .nav-container {
    max-width: var(--container-xl, 80rem);
    margin: 0 auto;
    padding: 0 var(--space-6, 1.5rem);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    width: 100%;
  }
  
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  
  .nav-logo img {
    height: 32px;
    width: 256px;
    object-fit: contain; /* Preserve aspect ratio within bounds */
  }
  
  /* Desktop Menu */
  .nav-menu {
    display: flex;
    flex-direction: row;
    align-items: center;
    list-style: none;
    gap: var(--space-2, 0.5rem);
    margin: 0;
    padding: 0;
  }
  
  .nav-menu li {
    display: flex;
  }
  
  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    border-radius: var(--radius-lg, 0.5rem);
    text-decoration: none;
    color: var(--text-secondary, #4A4A4A);
    font-weight: var(--font-medium, 500);
    transition: all var(--transition-fast, 150ms ease);
    position: relative;
  }
  
  .nav-item:hover {
    color: var(--text-primary);
    background: var(--state-hover);
  }
  
  .nav-item--active {
    color: var(--retro-purple);
    background: rgba(139, 92, 246, 0.08);
  }
  
  .nav-item--active::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: var(--space-4);
    right: var(--space-4);
    height: 3px;
    background: var(--retro-purple);
    border-radius: var(--radius-full);
  }
  
  .nav-item__icon {
    font-size: 1.25rem;
  }
  
  .nav-item__label {
    font-size: var(--text-base);
  }
  
  /* Desktop Actions */
  .nav-actions {
    display: flex;
    gap: var(--space-3);
  }
  
  .nav-search,
  .nav-theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .nav-search:hover,
  .nav-theme:hover {
    border-color: var(--retro-purple);
    color: var(--retro-purple);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  
  /* Mobile Navigation */
  .nav-mobile {
    position: relative;
  }
  
  .nav-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    height: 64px;
  }
  
  .nav-mobile-logo img {
    height: 24px;
    width: 192px; /* 256 * 0.75 for mobile */
    object-fit: contain; /* Preserve aspect ratio within bounds */
  }
  
  /* Hamburger Menu */
  .nav-mobile-toggle {
    position: relative;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hamburger {
    position: relative;
    width: 24px;
    height: 20px;
  }
  
  .hamburger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--text-primary);
    transition: all var(--transition-base);
  }
  
  .hamburger span:nth-child(1) {
    top: 0;
  }
  
  .hamburger span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }
  
  .hamburger span:nth-child(3) {
    bottom: 0;
  }
  
  /* Hamburger Active State */
  .nav-mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  
  .nav-mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(2) {
    opacity: 0;
  }
  
  .nav-mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(3) {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }
  
  /* Mobile Menu Overlay */
  .nav-mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-base);
    z-index: var(--z-overlay);
  }
  
  .nav-mobile-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }
  
  /* Mobile Menu Panel */
  .nav-mobile-menu {
    position: fixed;
    top: 64px;
    right: 0;
    bottom: 0;
    width: 80%;
    max-width: 320px;
    background: var(--bg-surface);
    transform: translateX(100%);
    transition: transform var(--transition-base);
    z-index: var(--z-modal);
    overflow-y: auto;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.1);
  }
  
  .nav-mobile-menu[aria-hidden="false"] {
    transform: translateX(0);
  }
  
  .nav-mobile-list {
    list-style: none;
    padding: var(--space-4);
    margin: 0;
  }
  
  .nav-mobile-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text-primary);
    font-weight: var(--font-medium);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    position: relative;
  }
  
  .nav-mobile-item:hover {
    background: var(--bg-muted);
  }
  
  .nav-mobile-item--active {
    color: var(--retro-purple);
    background: rgba(139, 92, 246, 0.08);
  }
  
  .nav-mobile-item__icon {
    font-size: 1.5rem;
  }
  
  .nav-mobile-item__label {
    flex: 1;
    font-size: var(--text-lg);
  }
  
  .nav-mobile-item__indicator {
    width: 4px;
    height: 24px;
    background: var(--retro-purple);
    border-radius: var(--radius-full);
    position: absolute;
    right: var(--space-2);
  }
  
  .nav-mobile-footer {
    padding: var(--space-4);
    border-top: 1px solid var(--border-light);
    margin-top: auto;
  }
  
  .nav-mobile-search {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--bg-muted);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .nav-mobile-search:hover {
    background: var(--bg-surface);
    border-color: var(--retro-purple);
    color: var(--retro-purple);
  }
  
  /* Animations */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Dark Mode Styles */
  :global(.dark-mode) .nav-modern {
    background: rgba(15, 23, 42, 0.95);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode) .nav-item {
    color: rgba(255, 255, 255, 0.7);
  }

  :global(.dark-mode) .nav-item:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode) .nav-item--active {
    color: var(--retro-purple);
    background: rgba(139, 92, 246, 0.15);
  }

  :global(.dark-mode) .nav-search,
  :global(.dark-mode) .nav-theme {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.7);
  }

  :global(.dark-mode) .nav-search:hover,
  :global(.dark-mode) .nav-theme:hover {
    border-color: var(--retro-purple);
    color: var(--retro-purple);
    background: rgba(139, 92, 246, 0.1);
  }

  :global(.dark-mode) .nav-mobile-menu {
    background: #0f172a;
  }

  :global(.dark-mode) .nav-mobile-item {
    color: rgba(255, 255, 255, 0.9);
  }

  :global(.dark-mode) .nav-mobile-item:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode) .nav-mobile-search {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.7);
  }

  :global(.dark-mode) .hamburger span {
    background: white;
  }
</style>

<script>
  // Mobile menu functionality
  const toggle = document.querySelector('.nav-mobile-toggle');
  const overlay = document.querySelector('.nav-mobile-overlay');
  const menu = document.querySelector('.nav-mobile-menu');
  const menuItems = document.querySelectorAll('.nav-mobile-item');
  
  let isOpen = false;
  
  function toggleMenu() {
    isOpen = !isOpen;
    toggle?.setAttribute('aria-expanded', String(isOpen));
    overlay?.setAttribute('aria-hidden', String(!isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
    
    // Prevent body scroll when menu is open
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }
  
  toggle?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);
  
  // Close menu when clicking a link
  menuItems.forEach(item => {
    item.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });
  
  // Theme toggle
  const themeToggle = document.querySelector('.nav-theme');
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark-mode');
    localStorage.setItem('theme', 
      document.documentElement.classList.contains('dark-mode') ? 'dark' : 'light'
    );
  });
  
  // Restore theme preference
  if (localStorage.getItem('theme') === 'dark') {
    document.documentElement.classList.add('dark-mode');
  }
</script>