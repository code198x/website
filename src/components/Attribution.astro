---
/**
 * Attribution - Source attribution for historical media
 *
 * Usage:
 *   import Attribution from '@components/Attribution.astro';
 *
 *   <Attribution
 *     source="Zzap!64 Magazine"
 *     date="March 1987"
 *     page="42"
 *     copyright="Newsfield Publications"
 *   />
 *
 *   <Attribution
 *     source="Compute!'s Gazette"
 *     url="https://archive.org/..."
 *   />
 *
 *   Third-party images carry their own licence, which has to be named and
 *   linked rather than implied by the page's:
 *
 *   <Attribution
 *     source="Wikimedia Commons"
 *     url="https://commons.wikimedia.org/wiki/File:Example.jpg"
 *     photographer="A. Photographer"
 *     licence="CC BY-SA 2.5"
 *     licenceUrl="https://creativecommons.org/licenses/by-sa/2.5/"
 *   />
 *
 * Typically placed below Figure components for historical images
 */

interface Props {
  source: string;       // Publication or source name
  date?: string;        // Publication date
  page?: string;        // Page number(s)
  issue?: string;       // Issue number
  copyright?: string;   // Copyright holder
  url?: string;         // Link to original/archive
  photographer?: string; // Photographer credit
  licence?: string;     // Licence the source work carries, e.g. "CC BY-SA 2.5"
  licenceUrl?: string;  // Link to the licence deed
  note?: string;        // Additional notes
}

const {
  source,
  date,
  page,
  issue,
  copyright,
  url,
  photographer,
  licence,
  licenceUrl,
  note
} = Astro.props;

// Build attribution parts
const parts: string[] = [];

if (date) parts.push(date);
if (issue) parts.push(`Issue ${issue}`);
if (page) parts.push(`p. ${page}`);
---

<aside class="attribution">
  <span class="attribution-icon" aria-hidden="true">&#x1F4D6;</span>
  <div class="attribution-content">
    <span class="source">
      {url ? (
        <a href={url} target="_blank" rel="noopener noreferrer">{source}</a>
      ) : (
        source
      )}
    </span>
    {parts.length > 0 && (
      <span class="details">{parts.join(' \u2022 ')}</span>
    )}
    {photographer && (
      <span class="photographer">Photo: {photographer}</span>
    )}
    {licence && (
      <span class="licence">
        {licenceUrl ? (
          <a href={licenceUrl} target="_blank" rel="license noopener noreferrer">{licence}</a>
        ) : (
          licence
        )}
      </span>
    )}
    {copyright && (
      <span class="copyright">&copy; {copyright}</span>
    )}
    {note && (
      <span class="note">{note}</span>
    )}
  </div>
</aside>

<style>
  .attribution {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: var(--space-3, 0.75rem) 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-muted, rgba(255, 255, 255, 0.03));
    border-left: 3px solid var(--color-border, rgba(255, 255, 255, 0.1));
    border-radius: 0;
    font-size: 0.8125rem;
    color: var(--color-text-secondary, #555);
  }

  .attribution-icon {
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  .attribution-content {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    line-height: 1.5;
  }

  .source {
    font-weight: 500;
    color: var(--color-text, #ccc);
  }

  .source a {
    color: var(--color-link, #6ea8fe);
    text-decoration: none;
  }

  .source a:hover {
    text-decoration: underline;
  }

  .details {
    color: var(--color-text-secondary, #555);
  }

  .photographer {
    font-style: italic;
  }

  .licence a {
    color: var(--color-link, #6ea8fe);
    text-decoration: none;
  }

  .licence a:hover {
    text-decoration: underline;
  }

  .copyright {
    opacity: 0.8;
  }

  .note {
    flex-basis: 100%;
    font-style: italic;
    opacity: 0.9;
  }

  /* Dark mode adjustment */
  @media (prefers-color-scheme: light) {
    .attribution {
      background: rgba(0, 0, 0, 0.03);
      border-left-color: rgba(0, 0, 0, 0.1);
    }
  }
</style>
