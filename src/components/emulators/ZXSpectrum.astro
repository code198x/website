---
export interface Props {
  snapshotUrl?: string;
  tapeUrl?: string;
  width?: string;
  height?: string;
  id?: string;
  title?: string;
  model?: "48" | "128" | "pentagon";
}

const {
  snapshotUrl,
  tapeUrl,
  width = "100%",
  height = "400px",
  id,
  title,
  model = "48",
} = Astro.props;

const elementId = id || `spectrum-${Math.random().toString(36).substr(2, 9)}`;
const hasMedia = snapshotUrl || tapeUrl;
---

<div class="emulator-container border rounded-lg p-4 bg-slate-50">
  {title && <h3 class="text-lg font-semibold mb-3 text-slate-800">🎮 {title}</h3>}

  <div
    id={elementId}
    style={`width: ${width}; height: ${height}; background: #000; border-radius: 4px;`}
    class="emulator-screen"
  >
    <div class="flex items-center justify-center h-full text-white">
      <div class="text-center">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-2"></div>
        <p>Loading ZX Spectrum emulator...</p>
      </div>
    </div>
  </div>

  <div class="mt-3 text-sm text-slate-600">
    <p>
      <strong>Model:</strong> ZX Spectrum {
        model === "48" ? "48K" : model === "128" ? "128K" : "Pentagon"
      }
    </p>
    <p><strong>Controls:</strong> Use keyboard or click the emulator to focus</p>
    {
      hasMedia && (
        <p>
          <strong>Media:</strong> {snapshotUrl ? "Snapshot" : "Tape"} will auto-load
        </p>
      )
    }
  </div>
</div>

<script define:vars={{ elementId, snapshotUrl, tapeUrl, model }}>
  // Load JSSpeccy3 when DOM is ready
  document.addEventListener("DOMContentLoaded", async function () {
    try {
      // Load JSSpeccy3 script from CDN or local source
      const script = document.createElement("script");
      script.src = "https://jsspeccy.zxdemo.org/jsspeccy.js"; // Official CDN

      script.onload = function () {
        const container = document.getElementById(elementId);
        if (container && window.JSSpeccy) {
          try {
            // Initialize JSSpeccy
            const spectrum = window.JSSpeccy(container, {
              zoom: 1,
              machine: model === "48" ? "spectrum48" : model === "128" ? "spectrum128" : "pentagon",
              autoStart: true,
              autoLoadTapes: true,
            });

            // Load media if provided
            if (snapshotUrl) {
              fetch(snapshotUrl)
                .then((response) => response.arrayBuffer())
                .then((data) => {
                  spectrum.loadSnapshot(data);
                })
                .catch((err) => {
                  console.error("Failed to load snapshot:", err);
                  showError(container, "Failed to load snapshot file");
                });
            } else if (tapeUrl) {
              fetch(tapeUrl)
                .then((response) => response.arrayBuffer())
                .then((data) => {
                  spectrum.loadTape(data);
                })
                .catch((err) => {
                  console.error("Failed to load tape:", err);
                  showError(container, "Failed to load tape file");
                });
            }

            console.log("JSSpeccy3 initialized successfully");
          } catch (err) {
            console.error("Failed to initialize JSSpeccy:", err);
            showError(container, "Failed to initialize emulator");
          }
        }
      };

      script.onerror = function () {
        const container = document.getElementById(elementId);
        showError(container, "Failed to load JSSpeccy3 emulator");
      };

      document.head.appendChild(script);
    } catch (err) {
      console.error("Error setting up ZX Spectrum emulator:", err);
      const container = document.getElementById(elementId);
      showError(container, "Error setting up emulator");
    }
  });

  function showError(container, message) {
    if (container) {
      container.innerHTML = `
        <div class="flex items-center justify-center h-full text-red-500">
          <div class="text-center">
            <p class="mb-2">❌ ${message}</p>
            <p class="text-sm">Check media URL and internet connection</p>
          </div>
        </div>
      `;
    }
  }
</script>

<style>
  .emulator-container {
    margin: 1rem 0;
  }

  .emulator-screen {
    position: relative;
    overflow: hidden;
  }

  /* JSSpeccy specific styling */
  .emulator-screen :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
  }
</style>
