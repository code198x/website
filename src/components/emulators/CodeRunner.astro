---
export interface Props {
  system: 'commodore-64' | 'zx-spectrum' | 'commodore-amiga' | 'nintendo-entertainment-system';
  code: string;
  title?: string;
  autoRun?: boolean;
  showCode?: boolean;
  language?: string;
}

const { 
  system, 
  code, 
  title, 
  autoRun = false, 
  showCode = true,
  language = 'basic'
} = Astro.props;

const elementId = `coderunner-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="code-runner-container border rounded-lg overflow-hidden bg-white shadow-sm">
  {title && (
    <div class="bg-gray-100 px-4 py-2 border-b">
      <h4 class="text-md font-semibold text-gray-800">💻 {title}</h4>
    </div>
  )}
  
  <div class="flex flex-col lg:flex-row">
    {showCode && (
      <div class="lg:w-1/2 border-b lg:border-b-0 lg:border-r">
        <div class="bg-gray-50 px-3 py-2 text-sm font-medium text-gray-700 border-b">
          Source Code ({language.toUpperCase()})
        </div>
        <pre class="p-4 text-sm overflow-x-auto bg-gray-900 text-green-400 font-mono min-h-[200px]"><code id={`code-${elementId}`}>{code}</code></pre>
        <div class="p-3 bg-gray-50 border-t">
          <button 
            id={`run-btn-${elementId}`}
            class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors text-sm font-medium"
          >
            ▶️ Run Code
          </button>
          <button 
            id={`copy-btn-${elementId}`}
            class="ml-2 px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors text-sm font-medium"
          >
            📋 Copy Code
          </button>
        </div>
      </div>
    )}
    
    <div class={showCode ? "lg:w-1/2" : "w-full"}>
      <div class="bg-gray-50 px-3 py-2 text-sm font-medium text-gray-700 border-b">
        {system.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')} Emulator
      </div>
      <div 
        id={`emulator-${elementId}`}
        class="bg-black relative"
        style="height: 300px;"
      >
        <div class="flex items-center justify-center h-full text-white">
          <div class="text-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-2"></div>
            <p>Loading emulator...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ elementId, system, code, autoRun }}>
  document.addEventListener('DOMContentLoaded', function() {
    const runButton = document.getElementById(`run-btn-${elementId}`);
    const copyButton = document.getElementById(`copy-btn-${elementId}`);
    const emulatorContainer = document.getElementById(`emulator-${elementId}`);
    
    // Initialize emulator based on system
    let emulator = null;
    
    async function initializeEmulator() {
      try {
        if (system === 'zx-spectrum') {
          // Use JSSpeccy3 for ZX Spectrum
          await loadJSSpeccy();
        } else {
          // Use EmulatorJS for other systems
          await loadEmulatorJS();
        }
      } catch (err) {
        console.error('Failed to initialize emulator:', err);
        showError('Failed to load emulator');
      }
    }
    
    async function loadEmulatorJS() {
      return new Promise((resolve, reject) => {
        // Set up EmulatorJS configuration
        const coreMap = {
          'commodore-64': 'vice_x64sc',
          'nintendo-entertainment-system': 'nestopia',
          'commodore-amiga': 'puae'
        };
        
        window.EJS_player = `#emulator-${elementId}`;
        window.EJS_core = coreMap[system];
        window.EJS_pathtodata = 'https://cdn.emulatorjs.org/stable/data/';
        window.EJS_startOnLoaded = false;
        
        const script = document.createElement('script');
        script.src = 'https://cdn.emulatorjs.org/stable/data/loader.js';
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }
    
    async function loadJSSpeccy() {
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://jsspeccy.zxdemo.org/jsspeccy.js';
        script.onload = () => {
          if (window.JSSpeccy) {
            emulator = window.JSSpeccy(emulatorContainer, {
              zoom: 1,
              machine: 'spectrum48',
              autoStart: true
            });
            resolve();
          } else {
            reject(new Error('JSSpeccy not loaded'));
          }
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }
    
    function runCode() {
      if (!emulator && system !== 'zx-spectrum') {
        showError('Emulator not ready. Please wait...');
        return;
      }
      
      try {
        if (system === 'zx-spectrum' && emulator) {
          // For ZX Spectrum, type the BASIC code
          emulator.typeText(code);
        } else if (system === 'commodore-64') {
          // For C64, we would need to create a virtual program file
          // This is a simplified approach - in practice, you'd create a .prg file
          showError('Code injection for C64 requires .prg file creation (advanced feature)');
        } else {
          showError('Code injection not yet implemented for this system');
        }
      } catch (err) {
        console.error('Failed to run code:', err);
        showError('Failed to execute code');
      }
    }
    
    function copyCode() {
      navigator.clipboard.writeText(code).then(() => {
        copyButton.textContent = '✅ Copied!';
        setTimeout(() => {
          copyButton.textContent = '📋 Copy Code';
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy code:', err);
        alert('Failed to copy code to clipboard');
      });
    }
    
    function showError(message) {
      if (emulatorContainer) {
        emulatorContainer.innerHTML = `
          <div class="flex items-center justify-center h-full text-red-500">
            <div class="text-center">
              <p class="mb-2">❌ ${message}</p>
            </div>
          </div>
        `;
      }
    }
    
    // Event listeners
    if (runButton) {
      runButton.addEventListener('click', runCode);
    }
    
    if (copyButton) {
      copyButton.addEventListener('click', copyCode);
    }
    
    // Initialize emulator
    initializeEmulator();
    
    // Auto-run if specified
    if (autoRun) {
      setTimeout(() => {
        runCode();
      }, 2000); // Wait 2 seconds for emulator to load
    }
  });
</script>

<style>
  .code-runner-container {
    margin: 1.5rem 0;
  }
  
  pre code {
    display: block;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  
  /* Syntax highlighting for BASIC */
  .code-runner-container :global(.keyword) {
    color: #ff6b6b;
    font-weight: bold;
  }
  
  .code-runner-container :global(.string) {
    color: #4ecdc4;
  }
  
  .code-runner-container :global(.number) {
    color: #ffe66d;
  }
  
  .code-runner-container :global(.comment) {
    color: #95a5a6;
    font-style: italic;
  }
</style>