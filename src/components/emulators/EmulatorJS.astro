---
export interface Props {
  system: 'commodore-64' | 'nintendo-entertainment-system' | 'commodore-amiga';
  romUrl: string;
  width?: string;
  height?: string;
  id?: string;
  title?: string;
}

const { system, romUrl, width = '100%', height = '400px', id, title } = Astro.props;

// Map our system names to EmulatorJS cores
const coreMap = {
  'commodore-64': 'vice_x64sc',
  'nintendo-entertainment-system': 'nestopia',
  'commodore-amiga': 'puae'
};

const core = coreMap[system];
const elementId = id || `emulator-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="emulator-container border rounded-lg p-4 bg-slate-50">
  {title && (
    <h3 class="text-lg font-semibold mb-3 text-slate-800">🎮 {title}</h3>
  )}
  
  <div 
    id={elementId}
    style={`width: ${width}; height: ${height}; background: #000; border-radius: 4px;`}
    class="emulator-screen"
  >
    <div class="flex items-center justify-center h-full text-white">
      <div class="text-center">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto mb-2"></div>
        <p>Loading emulator...</p>
      </div>
    </div>
  </div>
  
  <div class="mt-3 text-sm text-slate-600">
    <p><strong>System:</strong> {system.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}</p>
    <p><strong>Controls:</strong> Use keyboard or click the emulator to focus, then use system-specific controls</p>
  </div>
</div>

<script define:vars={{ elementId, core, romUrl }}>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Set up EmulatorJS configuration
    window.EJS_player = `#${elementId}`;
    window.EJS_gameUrl = romUrl;
    window.EJS_core = core;
    window.EJS_pathtodata = 'https://cdn.emulatorjs.org/stable/data/';
    
    // Optional: Configure additional settings
    window.EJS_startOnLoaded = false; // Don't auto-start
    window.EJS_fullscreenOnDoubleClick = true;
    window.EJS_gameParentId = elementId;
    
    // Load the EmulatorJS loader script
    const script = document.createElement('script');
    script.src = 'https://cdn.emulatorjs.org/stable/data/loader.js';
    script.onload = function() {
      console.log(`EmulatorJS loaded for ${core} with ROM: ${romUrl}`);
    };
    script.onerror = function() {
      const container = document.getElementById(elementId);
      if (container) {
        container.innerHTML = `
          <div class="flex items-center justify-center h-full text-red-500">
            <div class="text-center">
              <p class="mb-2">❌ Failed to load emulator</p>
              <p class="text-sm">Check ROM URL and internet connection</p>
            </div>
          </div>
        `;
      }
    };
    document.head.appendChild(script);
  });
</script>

<style>
  .emulator-container {
    margin: 1rem 0;
  }
  
  .emulator-screen {
    position: relative;
    overflow: hidden;
  }
  
  /* Hide EmulatorJS toolbar if needed */
  .emulator-screen :global(.ejs_toolbar) {
    background: rgba(0, 0, 0, 0.8) !important;
  }
</style>