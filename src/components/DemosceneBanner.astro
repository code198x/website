---
import OpeningBand from './OpeningBand.astro';
---
<OpeningBand class="demoscene-opening" phone="overlay" frame={false} phoneFocal="30% center"
  art={{ src: '/images/demoscene/background-1774.webp', srcset: '/images/demoscene/background-960.webp 960w, /images/demoscene/background-1774.webp 1774w', width: 1774, height: 887 }}
  caption="Artwork inspired by Spectrum, C64 and Amiga demo aesthetics; these are illustrations, not captures of historical productions.">
  <img class="scene-title" src="/images/demoscene/title-1600.webp"
    srcset="/images/demoscene/title-800.webp 800w, /images/demoscene/title-1600.webp 1600w"
    sizes="(max-width: 600px) 96vw, 60vw" width="1600" height="533" alt="" />
  <img class="scene-dancer" src="/images/demoscene/dancer-640.webp"
    srcset="/images/demoscene/dancer-360.webp 360w, /images/demoscene/dancer-640.webp 640w"
    sizes="(max-width: 600px) 250px, 30vw" width="640" height="960" alt="" />
</OpeningBand>

<style>
  /* Overlays are sized and placed from the band's height, not the page width. */
  img { position: absolute; display: block; pointer-events: none; }
  .scene-title { z-index: 1; width: auto; height: 52cqh; max-width: 86cqw; object-fit: contain; left: 50%; top: 50%; transform: translate(-56%, -46%); }
  .scene-dancer { z-index: 2; width: auto; height: 104cqh; top: -2cqh; right: max(-2cqw, calc(50cqw - 640px)); }
  @media (max-width: 600px) {
    .scene-title { width: 92cqw; height: auto; max-width: none; top: 10cqh; left: 4cqw; transform: none; }
    .scene-dancer { height: 78cqh; top: auto; bottom: -4cqh; right: -6cqw; }
  }
</style>
