---
import type { VaultFeatureSelection } from '../lib/vault-features';
interface Props {
  feature: Omit<VaultFeatureSelection, 'related'> & { colour: string; entry: { id: string; data: { category: string } } };
  categoryName: string;
  compact?: boolean;
}
const { feature, categoryName, compact = false } = Astro.props;
const href = `/vault/${feature.entry.id}`;
const images = compact ? feature.images.slice(-1) : feature.images;
---
{compact ? (
  <a class="category-feature" href={href} data-vault-colour={feature.colour}>
    <span><small>Featured reading</small><strong>{feature.headline}</strong><span>{feature.deck}</span></span>
    <img src={images[0].src} width={images[0].width} height={images[0].height} alt={images[0].alt} />
  </a>
) : (
  <article class="vault-feature" data-vault-colour={feature.colour}>
    <p class="vault-feature-label"><a href={`/vault/category/${feature.entry.data.category}`}>{categoryName}</a></p>
    <h2><a href={href}>{feature.headline}</a></h2>
    <p class="vault-feature-intro">{feature.deck}</p>
    <div class="vault-captures">
      {images.map(image => <figure><img src={image.src} width={image.width} height={image.height} alt={image.alt} /><figcaption>{image.caption}</figcaption></figure>)}
    </div>
    <p class="vault-feature-link"><a href={href}>{feature.linkText} <span aria-hidden="true">↗</span></a></p>
  </article>
)}
