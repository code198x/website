---
export interface Props {
  platform: string;
  tier: number;
  lesson: number;
  totalTiers?: number;
  totalLessons?: number;
}

const { 
  platform, 
  tier, 
  lesson, 
  totalTiers = 8, 
  totalLessons = 16 
} = Astro.props;

// Platform display names and styling
const platformInfo = {
  'c64': { 
    name: 'Commodore 64',
    color: 'text-c64-blue',
    bg: 'bg-c64-blue',
    lightBg: 'bg-c64-blue/10'
  },
  'spectrum': { 
    name: 'ZX Spectrum',
    color: 'text-spectrum-blue', 
    bg: 'bg-spectrum-blue',
    lightBg: 'bg-spectrum-blue/10'
  },
  'amiga': { 
    name: 'Commodore Amiga',
    color: 'text-amiga-orange',
    bg: 'bg-amiga-orange',
    lightBg: 'bg-amiga-orange/10'
  },
  'bbcmicro': { 
    name: 'BBC Micro',
    color: 'text-red-600',
    bg: 'bg-red-600',
    lightBg: 'bg-red-50'
  },
  'amstradcpc': { 
    name: 'Amstrad CPC',
    color: 'text-green-600',
    bg: 'bg-green-600',
    lightBg: 'bg-green-50'
  },
  'appleii': { 
    name: 'Apple II',
    color: 'text-blue-600',
    bg: 'bg-blue-600',
    lightBg: 'bg-blue-50'
  },
  'atarist': { 
    name: 'Atari ST',
    color: 'text-gray-600',
    bg: 'bg-gray-600',
    lightBg: 'bg-gray-50'
  },
  'atari800': { 
    name: 'Atari 800',
    color: 'text-red-700',
    bg: 'bg-red-700',
    lightBg: 'bg-red-50'
  },
  'ti994a': { 
    name: 'TI-99/4A',
    color: 'text-blue-700',
    bg: 'bg-blue-700',
    lightBg: 'bg-blue-50'
  },
  'dragon': { 
    name: 'Dragon 32/64',
    color: 'text-yellow-700',
    bg: 'bg-yellow-700',
    lightBg: 'bg-yellow-50'
  },
  'jupiterace': { 
    name: 'Jupiter ACE',
    color: 'text-purple-600',
    bg: 'bg-purple-600',
    lightBg: 'bg-purple-50'
  }
};

const currentPlatform = platformInfo[platform as keyof typeof platformInfo] || {
  name: platform.toUpperCase(),
  color: 'text-gray-600',
  bg: 'bg-gray-600',
  lightBg: 'bg-gray-50'
};

// Calculate progress percentages
const tierProgress = ((lesson - 1) / totalLessons) * 100;
const overallLessonsCompleted = ((tier - 1) * totalLessons) + (lesson - 1);
const totalPhase0Lessons = totalTiers * totalLessons; // 128 total
const overallProgress = (overallLessonsCompleted / totalPhase0Lessons) * 100;

// Get next lesson/tier info
const nextLesson = lesson < totalLessons ? lesson + 1 : null;
const nextTier = lesson === totalLessons && tier < totalTiers ? tier + 1 : null;
---

<div class={`${currentPlatform.lightBg} border-2 border-gray-200 rounded-xl p-6 mb-6`} data-progress-tracker>
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class={`w-12 h-12 ${currentPlatform.bg} rounded-lg flex items-center justify-center text-white font-bold shadow-lg`}>
        {String(lesson).padStart(2, '0')}
      </div>
      <div>
        <h3 class={`text-lg font-bold ${currentPlatform.color}`}>
          Lesson Progress
        </h3>
        <p class="text-gray-600 text-sm">
          {currentPlatform.name} • Phase 0
        </p>
      </div>
    </div>
    <div class="text-right">
      <div class={`text-2xl font-bold ${currentPlatform.color}`}>
        {Math.round(overallProgress)}%
      </div>
      <div class="text-xs text-gray-500">
        Phase 0 Complete
      </div>
    </div>
  </div>
  
  <!-- Current Tier Progress -->
  <div class="mb-6">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium text-gray-700">
        Tier {tier} Progress
      </span>
      <span class="text-sm text-gray-500">
        {lesson} of {totalLessons} lessons
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-3">
      <div 
        class={`h-3 rounded-full transition-all duration-300 ${currentPlatform.bg}`}
        style={`width: ${Math.max(tierProgress, 6.25)}%`}
      ></div>
    </div>
  </div>
  
  <!-- Overall Phase 0 Progress -->
  <div class="mb-6">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium text-gray-700">
        Overall Phase 0 Progress
      </span>
      <span class="text-sm text-gray-500">
        {overallLessonsCompleted + 1} of {totalPhase0Lessons} lessons
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2">
      <div 
        class={`h-2 rounded-full transition-all duration-300 ${currentPlatform.bg}`}
        style={`width: ${Math.max(overallProgress, 1)}%`}
      ></div>
    </div>
  </div>
  
  <!-- Tier Status Grid -->
  <div class="mb-6">
    <h4 class="text-sm font-medium text-gray-700 mb-3">Tier Status</h4>
    <div class="grid grid-cols-8 gap-2">
      {Array.from({ length: totalTiers }, (_, i) => {
        const tierNum = i + 1;
        const isCurrentTier = tierNum === tier;
        const isCompleted = tierNum < tier;
        const isNext = tierNum === tier + 1 && lesson === totalLessons;
        
        return (
          <div 
            class={`
              relative w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold transition-all duration-200
              ${isCompleted ? `${currentPlatform.bg} text-white shadow-md` : ''}
              ${isCurrentTier ? `border-2 border-${currentPlatform.bg.replace('bg-', '')} ${currentPlatform.lightBg} ${currentPlatform.color}` : ''}
              ${!isCompleted && !isCurrentTier ? 'bg-gray-100 text-gray-400' : ''}
              ${isNext ? 'ring-2 ring-yellow-300 bg-yellow-50' : ''}
            `}
            title={`Tier ${tierNum} ${isCompleted ? '(Completed)' : isCurrentTier ? '(Current)' : isNext ? '(Next)' : ''}`}
          >
            {tierNum}
            {isCompleted && (
              <div class="absolute -top-1 -right-1 w-3 h-3 bg-green-500 rounded-full flex items-center justify-center">
                <span class="text-white text-xs">✓</span>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
  
  <!-- Next Steps -->
  <div class="border-t border-gray-200 pt-4">
    <h4 class="text-sm font-medium text-gray-700 mb-3">What's Next?</h4>
    <div class="space-y-2">
      {nextLesson && (
        <div class="flex items-center gap-2">
          <span class="text-green-600">→</span>
          <span class="text-sm text-gray-600">
            Continue to 
            <a 
              href={`/lessons/${platform}/phase-0/tier-${tier}/lesson-${String(nextLesson).padStart(2, '0')}`}
              class={`font-medium ${currentPlatform.color} hover:underline`}
            >
              Lesson {nextLesson}
            </a>
          </span>
        </div>
      )}
      
      {nextTier && (
        <div class="flex items-center gap-2">
          <span class="text-blue-600">🎯</span>
          <span class="text-sm text-gray-600">
            Ready for 
            <a 
              href={`/lessons/${platform}/phase-0/tier-${nextTier}`}
              class={`font-medium ${currentPlatform.color} hover:underline`}
            >
              Tier {nextTier}
            </a>
          </span>
        </div>
      )}
      
      {tier === totalTiers && lesson === totalLessons && (
        <div class="flex items-center gap-2">
          <span class="text-purple-600">🎉</span>
          <span class="text-sm text-gray-600">
            Phase 0 Complete! Ready for 
            <a 
              href={`/lessons/${platform}/phase-1`}
              class={`font-medium ${currentPlatform.color} hover:underline`}
            >
              Phase 1
            </a>?
          </span>
        </div>
      )}
    </div>
  </div>
  
  <!-- Achievement badges (if applicable) -->
  {tier >= 4 && (
    <div class="border-t border-gray-200 pt-4 mt-4">
      <h4 class="text-sm font-medium text-gray-700 mb-3">Achievements</h4>
      <div class="flex flex-wrap gap-2">
        <div class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs rounded-full flex items-center gap-1">
          <span>🥉</span>
          <span>Halfway There</span>
        </div>
        {tier >= totalTiers && (
          <div class="px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded-full flex items-center gap-1">
            <span>🏆</span>
            <span>Phase 0 Master</span>
          </div>
        )}
      </div>
    </div>
  )}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const progressTracker = document.querySelector('[data-progress-tracker]');
    
    // Add smooth scroll animation when the component comes into view
    if (progressTracker && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fade-in');
          }
        });
      });
      
      observer.observe(progressTracker);
    }
    
    // Save lesson completion to localStorage for persistence
    const platform = progressTracker?.dataset.platform;
    const tier = progressTracker?.dataset.tier;
    const lesson = progressTracker?.dataset.lesson;
    
    if (platform && tier && lesson) {
      const storageKey = `phase0-progress-${platform}`;
      let progress = {};
      
      try {
        progress = JSON.parse(localStorage.getItem(storageKey) || '{}');
      } catch (e) {
        progress = {};
      }
      
      // Update progress for current tier/lesson
      if (!progress[tier]) progress[tier] = {};
      progress[tier][lesson] = {
        visited: true,
        timestamp: Date.now()
      };
      
      localStorage.setItem(storageKey, JSON.stringify(progress));
    }
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }
</style>