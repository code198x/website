---
interface Props { compact?: boolean }
const {compact = false} = Astro.props;
---
<figure class:list={['pattern-example', {compact}]}>
  <div class="pattern-bars" role="img" aria-label="Progress bar illustration: 0 of 100 lights no cells, 50 of 100 lights 14 cells, and 100 of 100 lights all 28 cells.">
    {[0,50,100].map(value => <div class="pattern-bar-row"><span>{value}<small> / 100</small></span><svg viewBox="0 0 280 16" aria-hidden="true">{Array.from({length:28},(_,i) => <rect x={i*10} y="0" width="9" height="16" fill={i < Math.floor(value*28/100) ? (i<9?'#0000d7':i<18?'#d7d700':i<24?'#d70000':'#d7d7d7') : '#000000'}/>)}</svg></div>)}
  </div>
  <figcaption>Illustration of the 28-cell BASIC bar, from empty to full. Colours follow the listing; this is not an emulator capture.</figcaption>
</figure>
