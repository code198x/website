---
import { progressBarCells } from '../lib/progress-bar';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const examples = [0, 25, 50, 100].map(value => ({ value, cells: progressBarCells(value) }));
const description = examples.map(({ value, cells }) =>
  `${value} of 100 lights ${cells.filter(colour => colour !== '#000000').length} of 28 cells`,
).join('; ');
---
<figure class:list={['pattern-example', { compact }]}>
  <div class="pattern-bars" role="img" aria-label={`Progress bar illustration: ${description}.`}>
    {examples.map(({ value, cells }) => (
      <div class="pattern-bar-row">
        <span>{value}<small> / 100</small></span>
        <svg viewBox="0 0 280 16" aria-hidden="true">
          {cells.map((colour, i) => <rect x={i * 10} y="0" width="9" height="16" fill={colour} />)}
        </svg>
      </div>
    ))}
  </div>
  <figcaption>Illustration of the 28-cell BASIC bar, from empty to full. Colours follow the listing; this is not an emulator capture.</figcaption>
</figure>
