---
export interface Props {
  registerA?: string;
  registerB?: string;
  registerC?: string;
  registerD?: string;
  registerE?: string;
  registerH?: string;
  registerL?: string;
  registerF?: string;
  stackPointer?: string;
  programCounter?: string;
  title?: string;
  showBeforeAfter?: boolean;
  beforeA?: string;
  beforeB?: string;
  beforeC?: string;
  afterA?: string;
  afterB?: string;
  afterC?: string;
}

const { 
  registerA = "00", 
  registerB = "00", 
  registerC = "00",
  registerD = "00",
  registerE = "00", 
  registerH = "00",
  registerL = "00",
  registerF = "00",
  stackPointer = "0000",
  programCounter = "0000",
  title = "Z80 Processor Registers",
  showBeforeAfter = false,
  beforeA = "00",
  beforeB = "00", 
  beforeC = "00",
  afterA = registerA,
  afterB = registerB,
  afterC = registerC
} = Astro.props;

function formatHex(value: string): string {
  return value.toUpperCase().padStart(2, '0');
}

function formatHex16(value: string): string {
  return value.toUpperCase().padStart(4, '0');
}

function getRegisterPairValue(high: string, low: string): string {
  const highVal = parseInt(high, 16);
  const lowVal = parseInt(low, 16);
  return ((highVal << 8) | lowVal).toString(16).toUpperCase().padStart(4, '0');
}
---

<div class="bg-gray-900 rounded-lg p-6 border border-gray-700">
  <h3 class="text-lg font-bold text-green-400 mb-4 text-center">{title}</h3>
  
  {showBeforeAfter ? (
    <!-- Before/After Comparison -->
    <div class="grid grid-cols-2 gap-6">
      <!-- Before State -->
      <div>
        <h4 class="text-sm font-bold text-gray-400 mb-3 text-center">BEFORE</h4>
        <div class="space-y-3">
          <div class="bg-blue-900 rounded p-3 border-2 border-blue-600">
            <div class="text-xs text-blue-300 font-mono">A (Accumulator)</div>
            <div class="text-xl font-mono text-blue-100">${formatHex(beforeA)}</div>
            <div class="text-xs text-blue-400">{parseInt(beforeA, 16)} decimal</div>
          </div>
          
          <div class="bg-purple-900 rounded p-3 border-2 border-purple-600">
            <div class="text-xs text-purple-300 font-mono">B (General)</div>
            <div class="text-xl font-mono text-purple-100">${formatHex(beforeB)}</div>
            <div class="text-xs text-purple-400">{parseInt(beforeB, 16)} decimal</div>
          </div>
          
          <div class="bg-orange-900 rounded p-3 border-2 border-orange-600">
            <div class="text-xs text-orange-300 font-mono">C (General)</div>
            <div class="text-xl font-mono text-orange-100">${formatHex(beforeC)}</div>
            <div class="text-xs text-orange-400">{parseInt(beforeC, 16)} decimal</div>
          </div>
        </div>
      </div>
      
      <!-- After State -->
      <div>
        <h4 class="text-sm font-bold text-gray-400 mb-3 text-center">AFTER</h4>
        <div class="space-y-3">
          <div class="bg-blue-900 rounded p-3 border-2 border-blue-400 ring-2 ring-blue-400">
            <div class="text-xs text-blue-300 font-mono">A (Accumulator)</div>
            <div class="text-xl font-mono text-blue-100">${formatHex(afterA)}</div>
            <div class="text-xs text-blue-400">{parseInt(afterA, 16)} decimal</div>
          </div>
          
          <div class="bg-purple-900 rounded p-3 border-2 border-purple-400 ring-2 ring-purple-400">
            <div class="text-xs text-purple-300 font-mono">B (General)</div>
            <div class="text-xl font-mono text-purple-100">${formatHex(afterB)}</div>
            <div class="text-xs text-purple-400">{parseInt(afterB, 16)} decimal</div>
          </div>
          
          <div class="bg-orange-900 rounded p-3 border-2 border-orange-400 ring-2 ring-orange-400">
            <div class="text-xs text-orange-300 font-mono">C (General)</div>
            <div class="text-xl font-mono text-orange-100">${formatHex(afterC)}</div>
            <div class="text-xs text-orange-400">{parseInt(afterC, 16)} decimal</div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <!-- Single State View -->
    <div class="space-y-4">
      <!-- Main Registers -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="bg-blue-900 rounded p-3 border-2 border-blue-600">
          <div class="text-xs text-blue-300 font-mono mb-1">A</div>
          <div class="text-xl font-mono text-blue-100">${formatHex(registerA)}</div>
          <div class="text-xs text-blue-400">{parseInt(registerA, 16)}</div>
        </div>
        
        <div class="bg-purple-900 rounded p-3 border-2 border-purple-600">
          <div class="text-xs text-purple-300 font-mono mb-1">B</div>
          <div class="text-xl font-mono text-purple-100">${formatHex(registerB)}</div>
          <div class="text-xs text-purple-400">{parseInt(registerB, 16)}</div>
        </div>
        
        <div class="bg-orange-900 rounded p-3 border-2 border-orange-600">
          <div class="text-xs text-orange-300 font-mono mb-1">C</div>
          <div class="text-xl font-mono text-orange-100">${formatHex(registerC)}</div>
          <div class="text-xs text-orange-400">{parseInt(registerC, 16)}</div>
        </div>
        
        <div class="bg-red-900 rounded p-3 border-2 border-red-600">
          <div class="text-xs text-red-300 font-mono mb-1">D</div>
          <div class="text-xl font-mono text-red-100">${formatHex(registerD)}</div>
          <div class="text-xs text-red-400">{parseInt(registerD, 16)}</div>
        </div>
        
        <div class="bg-green-900 rounded p-3 border-2 border-green-600">
          <div class="text-xs text-green-300 font-mono mb-1">E</div>
          <div class="text-xl font-mono text-green-100">${formatHex(registerE)}</div>
          <div class="text-xs text-green-400">{parseInt(registerE, 16)}</div>
        </div>
        
        <div class="bg-yellow-900 rounded p-3 border-2 border-yellow-600">
          <div class="text-xs text-yellow-300 font-mono mb-1">H</div>
          <div class="text-xl font-mono text-yellow-100">${formatHex(registerH)}</div>
          <div class="text-xs text-yellow-400">{parseInt(registerH, 16)}</div>
        </div>
        
        <div class="bg-indigo-900 rounded p-3 border-2 border-indigo-600">
          <div class="text-xs text-indigo-300 font-mono mb-1">L</div>
          <div class="text-xl font-mono text-indigo-100">${formatHex(registerL)}</div>
          <div class="text-xs text-indigo-400">{parseInt(registerL, 16)}</div>
        </div>
        
        <div class="bg-pink-900 rounded p-3 border-2 border-pink-600">
          <div class="text-xs text-pink-300 font-mono mb-1">F</div>
          <div class="text-xl font-mono text-pink-100">${formatHex(registerF)}</div>
          <div class="text-xs text-pink-400">Flags</div>
        </div>
      </div>
      
      <!-- Register Pairs -->
      <div class="bg-gray-800 rounded-lg p-4 border border-gray-600">
        <h4 class="text-sm font-bold text-gray-300 mb-3">16-bit Register Pairs</h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-gray-700 rounded p-3">
            <div class="text-xs text-purple-300 font-mono">BC Pair</div>
            <div class="text-lg font-mono text-purple-100">${getRegisterPairValue(registerB, registerC)}</div>
            <div class="text-xs text-purple-400">{parseInt(getRegisterPairValue(registerB, registerC), 16)} decimal</div>
          </div>
          
          <div class="bg-gray-700 rounded p-3">
            <div class="text-xs text-red-300 font-mono">DE Pair</div>
            <div class="text-lg font-mono text-red-100">${getRegisterPairValue(registerD, registerE)}</div>
            <div class="text-xs text-red-400">{parseInt(getRegisterPairValue(registerD, registerE), 16)} decimal</div>
          </div>
          
          <div class="bg-gray-700 rounded p-3">
            <div class="text-xs text-yellow-300 font-mono">HL Pair</div>
            <div class="text-lg font-mono text-yellow-100">${getRegisterPairValue(registerH, registerL)}</div>
            <div class="text-xs text-yellow-400">{parseInt(getRegisterPairValue(registerH, registerL), 16)} decimal</div>
          </div>
        </div>
      </div>
      
      <!-- System Registers -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-gray-800 rounded p-3 border border-gray-600">
          <div class="text-xs text-gray-400 font-mono">SP (Stack Pointer)</div>
          <div class="text-lg font-mono text-gray-200">${formatHex16(stackPointer)}</div>
          <div class="text-xs text-gray-500">{parseInt(stackPointer, 16)} decimal</div>
        </div>
        
        <div class="bg-gray-800 rounded p-3 border border-gray-600">
          <div class="text-xs text-gray-400 font-mono">PC (Program Counter)</div>
          <div class="text-lg font-mono text-gray-200">${formatHex16(programCounter)}</div>
          <div class="text-xs text-gray-500">{parseInt(programCounter, 16)} decimal</div>
        </div>
      </div>
    </div>
  )}
  
  <!-- Z80 Architecture Diagram -->
  <div class="mt-6 pt-4 border-t border-gray-700">
    <h4 class="text-sm font-bold text-gray-400 mb-3">Z80 Register Architecture</h4>
    <div class="bg-black rounded p-4">
      <div class="grid grid-cols-2 gap-4 text-xs font-mono">
        <div>
          <div class="text-green-400 mb-2">8-bit Registers:</div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-blue-300">A (Accumulator):</span>
              <span class="text-blue-100">${formatHex(registerA)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-purple-300">B, C (General):</span>
              <span class="text-purple-100">${formatHex(registerB)}, ${formatHex(registerC)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-red-300">D, E (General):</span>
              <span class="text-red-100">${formatHex(registerD)}, ${formatHex(registerE)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-yellow-300">H, L (Address):</span>
              <span class="text-yellow-100">${formatHex(registerH)}, ${formatHex(registerL)}</span>
            </div>
          </div>
        </div>
        <div>
          <div class="text-green-400 mb-2">16-bit Operations:</div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-purple-300">BC Pair:</span>
              <span class="text-purple-100">${getRegisterPairValue(registerB, registerC)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-red-300">DE Pair:</span>
              <span class="text-red-100">${getRegisterPairValue(registerD, registerE)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-yellow-300">HL Pair:</span>
              <span class="text-yellow-100">${getRegisterPairValue(registerH, registerL)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .register-highlight {
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { 
      opacity: 1; 
    }
    50% { 
      opacity: 0.7; 
    }
  }
</style>