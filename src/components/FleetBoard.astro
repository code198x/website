---
/**
 * FleetBoard — the /systems/ fleet wall, server-rendered.
 *
 * Three lenses over one dataset (decade / maker / tier). Each lens is its own
 * URL (/systems, /systems/by-maker, /systems/by-tier) rather than a query param
 * — path-based, linkable, and server-rendered, so scoped styles apply and no
 * client JS is needed. The tabs are links; the active one is the current view.
 *
 * Status is the primary visual language; system colour appears only on active
 * (live/next) machines, tying "has colour" to "has content". Nothing 404s.
 */
import { getAllPlatforms, getAllManufacturers } from '../lib/platforms';

interface Props { view: 'decade' | 'maker' | 'tier' }
const { view } = Astro.props;

const platforms = await getAllPlatforms();
const manufacturers = await getAllManufacturers();
const makerName = new Map(manufacturers.map(m => [m.id, m.data.shortName]));
const REGION_CODE: Record<string, string> = { US: 'US', UK: 'UK', Japan: 'JP', Europe: 'EU', Netherlands: 'NL' };
const KIND: Record<string, string> = { computer: 'home', console: 'console', handheld: 'handheld' };

interface Sys { year: number; slug: string; name: string; kind: string; maker: string; tier: string; country: string; color: string }
const fleet: Sys[] = platforms.map(p => ({
  year: p.data.year, slug: p.id, name: p.data.shortName,
  kind: KIND[p.data.type] ?? p.data.type,
  maker: makerName.get(p.data.manufacturer) ?? p.data.manufacturer,
  tier: p.data.tier ?? 'planned',
  country: REGION_CODE[p.data.region] ?? p.data.region,
  color: p.data.color,
})).sort((a, b) => a.year - b.year);

const tierCount = (t: string) => fleet.filter(e => e.tier === t).length;
const counts = { total: fleet.length, live: tierCount('live'), next: tierCount('next'), planned: tierCount('planned'), edge: tierCount('edge'), beyond: tierCount('beyond') };

interface Column { title: string; blurb?: string; items: Sys[] }
let columns: Column[] = [];
if (view === 'decade') {
  const decs: Array<[string, number, number, string]> = [
    ['1975–79', 1975, 1979, 'genesis'], ['1980–84', 1980, 1984, 'home-computer boom'],
    ['1985–89', 1985, 1989, 'where the curriculum lives'], ['1990–94', 1990, 1994, '16-bit · the bridge'],
    ['1995–99', 1995, 1999, 'edge of the canon'], ['2000–05', 2000, 2005, 'the strain test'],
  ];
  columns = decs.map(([title, lo, hi, blurb]) => ({ title, blurb, items: fleet.filter(e => e.year >= lo && e.year <= hi) }));
} else if (view === 'tier') {
  const tiers: Array<[string, string, string]> = [
    ['live', 'Live', 'shipping now'], ['next', 'Next', 'validated, in build'], ['planned', 'Planned', 'skeleton + subscribe'],
    ['edge', 'Edge', 'strains the method'], ['beyond', 'Beyond', 'outside the canon'],
  ];
  columns = tiers.map(([st, title, blurb]) => ({ title, blurb, items: fleet.filter(e => e.tier === st) }));
} else {
  columns = [...new Set(fleet.map(e => e.maker))]
    .map(m => ({ title: m, items: fleet.filter(e => e.maker === m) }))
    .sort((a, b) => b.items.length - a.items.length);
}

const STAMP: Record<string, string> = { live: 'LIVE', next: 'NEXT' };
const isActive = (t: string) => t === 'live' || t === 'next';
const tabs: Array<[string, string, string]> = [['decade', '/systems', 'By decade'], ['maker', '/systems/by-maker', 'By maker'], ['tier', '/systems/by-tier', 'By tier']];
---

<div class="wrap">
  <div class="eyebrow">The whole runway · 1975 → 2005</div>
  <h1>The fleet.</h1>
  <div class="herorule"></div>
  <p class="intro">Every machine we mean to teach, eventually. The methodology proves out on
    <b>the Spectrum</b>, generalises cleanly across the home-computer fleet, strains at the
    vector and 3D-first edges, and breaks honestly outside its domain. Nothing here ever 404s —
    a machine with no lessons yet is a real page with a date and a subscribe box.</p>
  <p class="summary" set:html={
    `<b>${counts.total}</b> machines · <b>${counts.live}</b> live · <b>${counts.next}</b> next · ` +
    `<b>${counts.planned}</b> planned · <b>${counts.edge}</b> edge · <b>${counts.beyond}</b> beyond`
  } />

  <div class="controls">
    <div class="legend">
      <span class="sw"><i class="live"></i> Live</span>
      <span class="sw"><i class="next"></i> Next</span>
      <span class="sw"><i class="planned"></i> Planned</span>
      <span class="sw"><i class="edge"></i> Edge of domain</span>
      <span class="sw"><i class="beyond"></i> Beyond</span>
    </div>
    <div class="tabs">
      {tabs.map(([v, href, label]) => (
        <a href={href} class={view === v ? 'on' : ''} aria-current={view === v ? 'page' : undefined}>{label}</a>
      ))}
    </div>
  </div>

  <div class={`board ${view}`}>
    {columns.map(col => (
      <div class="col">
        <div class="chead">
          <span class="t">{col.title}</span><span class="n">{col.items.length}</span>
          {col.blurb && <span class="blurb">{col.blurb}</span>}
        </div>
        <div class="stack">
          {col.items.map(e => (
            <a href={`/${e.slug}`} class={`pill ${e.tier} ${isActive(e.tier) ? 'active' : ''}`} style={isActive(e.tier) ? `border-left-color: ${e.color}` : undefined}>
              {STAMP[e.tier] && <span class={`stamp ${e.tier === 'next' ? 'next' : ''}`}>{STAMP[e.tier]}</span>}
              <div class="top"><span>{e.year} · {e.maker}</span><span class="ctry">{e.country}</span></div>
              <div class="name">{e.name}</div>
              <div class="kind">{e.kind}</div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="foot">
    <span>{counts.live} live · the rest honestly tiered</span>
    <span>Free · open source · forever</span>
  </div>
</div>

<style>
  .wrap { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-5) var(--space-6) var(--space-16); }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }
  .wrap h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(3.2rem, 8vw, 4.6rem); line-height: 0.86; margin: var(--space-1) 0 0; color: var(--color-text); }
  .herorule { height: 9px; width: 240px; background: var(--color-house); position: relative; margin-top: var(--space-2); }
  .herorule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 24%; background: var(--color-house-2); }
  .intro { font-size: 0.95rem; max-width: 78ch; margin: var(--space-3) 0 0; color: var(--color-text); }
  .intro b { color: var(--color-house-2); }
  .summary { font-family: var(--font-family-mono); font-size: 0.75rem; color: var(--color-text-secondary); margin-top: var(--space-2); letter-spacing: 0.03em; }
  .summary b { color: var(--color-text); }

  .controls { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-4); padding-bottom: var(--space-3); border-bottom: 3px solid var(--color-text); }
  .legend { display: flex; gap: var(--space-3); flex-wrap: wrap; font-family: var(--font-family-mono); font-size: 0.66rem; letter-spacing: 0.04em; color: var(--color-text-secondary); align-items: center; }
  .legend .sw { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 16px; height: 12px; display: inline-block; border: 2px solid var(--color-text); background: var(--color-surface); }
  .legend i.live { box-shadow: 2px 2px 0 rgb(0 0 0 / 0.2); }
  .legend i.next { background: var(--color-house-tint); }
  .legend i.planned { border-color: var(--color-border); }
  .legend i.edge { border-style: dashed; border-color: var(--color-text-secondary); opacity: 0.7; }
  .legend i.beyond { border-style: dashed; border-color: var(--color-text-muted); opacity: 0.5; }
  .tabs { margin-left: auto; display: flex; gap: 0; }
  .tabs a { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 8px 13px; border: 3px solid var(--color-text); background: var(--color-surface); color: var(--color-text); text-decoration: none; border-right-width: 0; }
  .tabs a:last-child { border-right-width: 3px; }
  .tabs a.on { background: var(--color-house); color: #f6efe2; }

  .board { display: grid; gap: var(--space-4); margin-top: var(--space-4); align-items: start; }
  .board.decade { grid-template-columns: repeat(6, 1fr); }
  .board.tier { grid-template-columns: repeat(5, 1fr); }
  .board.maker { grid-template-columns: repeat(auto-fill, minmax(185px, 1fr)); }

  .col .chead { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; border-bottom: 2px solid var(--color-text); padding-bottom: 4px; margin-bottom: 8px; }
  .col .chead .t { font-family: var(--font-family-script); font-weight: 700; font-size: 1.5rem; line-height: 1; }
  .col .chead .n { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); }
  .col .chead .blurb { font-family: var(--font-family-mono); font-size: 0.56rem; letter-spacing: 0.06em; color: var(--color-text-secondary); text-transform: uppercase; width: 100%; margin-top: 2px; }
  .stack { display: flex; flex-direction: column; gap: 7px; }

  .pill { border: 2px solid var(--color-text); background: var(--color-surface); padding: 6px 8px 7px; position: relative; text-decoration: none; color: var(--color-text); display: block; transition: transform var(--transition-base), box-shadow var(--transition-base); }
  .pill:hover, .pill:focus-visible { transform: translate(-2px, -2px); box-shadow: var(--shadow-chunky); }
  .pill .top { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-family-mono); font-size: 0.56rem; color: var(--color-text-secondary); }
  .pill .ctry { background: rgb(26 24 20 / 0.08); padding: 0 4px; letter-spacing: 0.05em; }
  .pill .name { font-weight: 700; font-size: 0.84rem; line-height: 1.05; margin-top: 2px; }
  .pill .kind { font-family: var(--font-family-mono); font-size: 0.5rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); margin-top: 2px; }
  .pill.live { border-width: 3px; box-shadow: var(--shadow-chunky); }
  .pill.next { background: var(--color-house-tint); }
  .pill.planned { border-color: var(--color-border); }
  .pill.edge { border-style: dashed; border-color: var(--color-text-secondary); }
  .pill.beyond { border-style: dashed; border-color: var(--color-border); }
  .pill.edge .name, .pill.beyond .name { color: var(--color-text-secondary); font-weight: 600; }
  .pill.active { border-left-width: 6px; }
  .pill .stamp { position: absolute; top: -9px; right: -5px; font-family: var(--font-family-mono); font-size: 0.5rem; font-weight: 700; letter-spacing: 0.1em;
    padding: 1px 5px; border: 2px solid var(--color-text); background: var(--color-surface); transform: rotate(5deg); }
  .pill .stamp.next { border-color: var(--color-house-2); color: var(--color-house-2); transform: rotate(-5deg); }

  .foot { margin-top: var(--space-8); border-top: 3px solid var(--color-text); padding-top: var(--space-4); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);
    font-family: var(--font-family-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); }

  @media (max-width: 1000px) { .board.decade { grid-template-columns: repeat(3, 1fr); } .board.tier { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .board.decade, .board.tier { grid-template-columns: repeat(2, 1fr); } .wrap h1 { font-size: 3rem; } }
</style>
