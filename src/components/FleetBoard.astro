---
/**
 * The systems directory: /systems and its three other arrangements
 * (by-region, by-maker, by-tier). One page, four URLs; `view` picks the
 * arrangement of the catalogue at the bottom.
 *
 * On the approved concept (Code198x/website-preview/public/concepts/
 * systems.html) and family-visual-identity.md §7:
 *
 * - The machine is the hero. The machines with lessons, and those prioritised
 *   next, each show our own capture through the kit's Screen, at 1x of the
 *   true grid (a doubled capture is halved; the Amiga declares 320x256). A
 *   machine with no capture yet says so rather than borrow another's.
 * - Cards are objects (the kit's device Shell): round. The lenses, the search
 *   and the chips are interface: square, with inverse video for current only.
 * - Nothing is told apart by colour. In the catalogue, a machine with lessons
 *   and one prioritised next carry a word in their chip; the availability
 *   arrangement lists every tier.
 *
 * Every number is counted from the catalogue at build time. Lesson
 * availability is authored lesson pages; catalogue priority is the manifest's
 * `tier`, and the two are kept apart (src/lib/system-directory.ts).
 */
import HardwarePhoto from './HardwarePhoto.astro';
import {learningImagery} from '../data/learning-imagery';
import catalog from '../../public/emulators/catalog.json';
import Eyebrow from '@198x-ui/components/Eyebrow.astro';
import Shell from '@198x-ui/components/Shell.astro';
import Screen from '@198x-ui/components/Screen.astro';
import Chip from '@198x-ui/components/Chip.astro';
import SearchField from '@198x-ui/components/SearchField.astro';
import RefitScreens from './RefitScreens.astro';
import { getCollection } from 'astro:content';
import { getAllPlatforms, getAllManufacturers } from '../lib/platforms';
import { systemStatus, systemLessonCounts } from '../lib/system-directory';
import { posterFor, declaredGrid } from '../lib/player-posters';
import { pngSize } from '../lib/pixel-frame';
import { sameJob } from '../data/same-job';
import { readFileSync } from 'node:fs';

import PageFrame from './PageFrame.astro';
import Cluster from './layout/Cluster.astro';
import Sidebar from './layout/Sidebar.astro';
interface Props { view: 'decade' | 'maker' | 'tier' | 'region'; showOpening?: boolean }
const { view, showOpening = true } = Astro.props;

const lessonCounts = await systemLessonCounts();
const platforms = await getAllPlatforms();
const manufacturers = await getAllManufacturers();
const makerName = new Map(manufacturers.map((m) => [m.id, m.data.shortName]));
const REGION_LABEL: Record<string, string> = { US: 'United States', UK: 'United Kingdom', USSR: 'Soviet Union', Europe: 'Europe (multi-country)' };
const regionName = (r: string) => REGION_LABEL[r] ?? r;
const catalogues = (await getCollection('modules')).filter((m) => m.data.platform && m.data.track !== 'machine');

/** Our own capture for a machine, through the browser player's poster list,
    with its stored size; null when there is none yet. */
const capture = (id: string, name: string) => {
  const entry = catalog.find((e) => e.id === id || e.aliases.includes(id));
  const poster = entry ? posterFor(entry.id, name) : null;
  if (!poster) return null;
  const { width, height } = pngSize(new Uint8Array(readFileSync(`public${poster.src}`)));
  return { ...poster, width, height, grid: declaredGrid(id, width, height) };
};

/* In the homepage explorer's order (src/data/same-job.ts), then navOrder. */
const order = Object.keys(sameJob);
const rank = (id: string) => order.indexOf(id) + 1 || order.length + 1;
const live = platforms
  .filter((p) => lessonCounts.has(p.id))
  .sort((a, b) => rank(a.id) - rank(b.id) || a.data.navOrder - b.data.navOrder)
  .map((p) => {
    const tracks = new Set(catalogues.filter((c) => c.data.platform === p.id).map((c) => c.data.track!));
    const langs = Object.entries(sameJob[p.id]?.langs ?? {}).filter(([t]) => tracks.has(t as never)).map(([track, l]) => ({track,label:l.label}));
    return { p, maker: makerName.get(p.data.manufacturer) ?? p.data.manufacturer, langs, shot: capture(p.id, p.data.shortName) };
  });

const prioritised = platforms
  .filter((p) => p.data.tier === 'next' && !lessonCounts.has(p.id))
  .sort((a, b) => a.data.navOrder - b.data.navOrder)
  .map((p) => ({ p, maker: makerName.get(p.data.manufacturer) ?? p.data.manufacturer, shot: capture(p.id, p.data.shortName) }));

interface Sys { year: number; slug: string; name: string; maker: string; tier: string; region: string; lessons: boolean; q: string }
const fleet: Sys[] = platforms.map((p) => {
  const maker = makerName.get(p.data.manufacturer) ?? p.data.manufacturer;
  return {
    year: p.data.year, slug: p.id, name: p.data.shortName, maker,
    tier: p.data.tier ?? 'planned', region: p.data.region, lessons: lessonCounts.has(p.id),
    q: [p.data.name, p.data.shortName, maker, p.data.year, p.data.region, regionName(p.data.region)].join(' ').toLowerCase(),
  };
}).sort((a, b) => a.year - b.year || a.slug.localeCompare(b.slug));

const years = fleet.map((e) => e.year);

interface Group { title: string; blurb?: string; items: Sys[] }
let groups: Group[] = [];
if (view === 'decade') {
  const starts = [...new Set(fleet.map((e) => Math.floor(e.year / 5) * 5))].sort((a, b) => a - b);
  groups = starts.map((start) => ({ title: `${start} to ${start + 4}`, items: fleet.filter((e) => e.year >= start && e.year <= start + 4) }));
} else if (view === 'tier') {
  groups = ['live', 'next', 'planned', 'edge', 'beyond'].map((tier) => ({
    title: systemStatus[tier].label,
    blurb: tier === 'live' ? 'Published lessons; not a claim of a complete course.' : systemStatus[tier].description,
    items: fleet.filter((e) => tier === 'live' ? e.lessons : !e.lessons && (e.tier === tier || (tier === 'planned' && e.tier === 'live'))),
  }));
} else if (view === 'region') {
  groups = [...new Set(fleet.map((e) => e.region))]
    .map((r) => ({ title: regionName(r), items: fleet.filter((e) => e.region === r) }))
    .sort((a, b) => b.items.length - a.items.length || a.title.localeCompare(b.title));
} else {
  groups = [...new Set(fleet.map((e) => e.maker))]
    .map((m) => ({ title: m, items: fleet.filter((e) => e.maker === m) }))
    .sort((a, b) => b.items.length - a.items.length || a.title.localeCompare(b.title));
}
groups = groups.filter((g) => g.items.length > 0);

const lenses: Array<[Props['view'], string, string]> = [
  ['decade', '/systems/', 'By era'],
  ['region', '/systems/by-region/', 'By region'],
  ['maker', '/systems/by-maker/', 'By maker'],
  ['tier', '/systems/by-tier/', 'By availability'],
];
const count = (n: number) => `${n} ${n === 1 ? 'machine' : 'machines'}`;
---

<RefitScreens />
<PageFrame class="systems systems-directory" opening="none" ending="large">
  {showOpening && <header class="page-head">
    <div>
      <h1>Choose Your <em>Machine.</em></h1>
      <p class="intro">Explore the machines through their games, languages and hardware. Start with a system that has lessons, or browse the wider directory for reference material and planned coverage. A listing does not mean that a course or a working toolchain is available.</p>
      <a class="catalogue-jump" href="#catalogue">Browse all {fleet.length} machines</a>
    </div>

  </header>}

  <section class="block" aria-labelledby="live-h">
    <h2 id="live-h">Lessons you can start today.</h2>
    <div class="published-machines">{live.map(({p,maker,langs})=><Sidebar as="article" sideWidth="360px" contentMin="40%" class="published-machine" style="--sidebar-space: clamp(1.5rem, 12vw - 1.5rem, 4rem)"><HardwarePhoto system={p.id}/><div><h3><a href={`/systems/${p.id}`}>{p.data.name}</a></h3><p>{maker} · {p.data.year} · {p.data.cpu}</p><ul class="machine-language-links" aria-label={`${p.data.shortName} language routes`}>{langs.map(lang=><li><a href={`/systems/${p.id}/${lang.track}/`}>{lang.label}</a></li>)}</ul><p>{lessonCounts.get(p.id)} published lesson pages</p><a class="route-link" href={`/systems/${p.id}`}>Choose a {p.data.shortName} route →</a></div></Sidebar>)}</div>

  </section>

  {prioritised.length > 0 && (
    <section class="block" aria-labelledby="next-h">
      <h2 id="next-h">Prioritised next.</h2>
      <p class="sec-intro">These machines are next for lessons. There is no published lesson sequence or release date yet.</p>
      <Cluster as="ul" space={3} align="stretch" class="next">
        {prioritised.map(({ p, maker, shot }) => (
          <li>
            <Shell variant="device" href={`/systems/${p.id}`} class="nx">
              {shot ? (
                <Screen src={shot.src} alt={shot.caption} width={shot.width} height={shot.height} grid={shot.grid} class="tube" />
              ) : (
                <div class="tube-off"><span>No capture yet</span></div>
              )}
              <p class="name">{p.data.name}</p>
              <p class="meta">{maker}, {p.data.year}</p>
            </Shell>
          </li>
        ))}
      </Cluster>
    </section>
  )}

  <section class="block" aria-labelledby="all-h" id="catalogue" data-catalogue>
    <h2 id="all-h">The wider catalogue.</h2>
    <p class="sec-intro">Browse all machines for hardware, history and reference. Published lessons are marked explicitly.</p>
    <details class="catalogue-disclosure" open={view !== 'decade'}><summary>Browse {fleet.length} machines</summary>
    <Cluster space={3} justify="space-between" class="tools">
      <Cluster as="nav" space={2} class="lenses" aria-label="Arrange the catalogue">
        {lenses.map(([v, href, label]) => (
          <a href={`${href}#catalogue`} aria-current={view === v ? 'page' : undefined}>{label}</a>
        ))}
      </Cluster>
      <SearchField label="Find a machine" placeholder="Find a machine, maker or year" name="find" id="find-machine" class="find" />
    </Cluster>
    <p class="legend">A machine marked <b>Lessons</b> has published lessons; one marked <b>Next</b> is prioritised for them. Every other machine is listed for reference or planned coverage; <a href="/systems/by-tier/">by availability</a> sorts them all.</p>
    <div class="groups" data-groups>
      {groups.map((g) => (
        <div class="group" data-group>
          <div class="ghead">
            <h3>{g.title}</h3>
            <p class="n" data-n data-total={g.items.length}>{count(g.items.length)}</p>
            {g.blurb && <p class="blurb">{g.blurb}</p>}
          </div>
          <ul class="chips">
            {g.items.map((e) => (
              <li data-q={e.q}>
                <Chip href={`/systems/${e.slug}`}>{e.name}<span slot="meta">{e.year}{e.lessons ? ' · Lessons' : e.tier === 'next' ? ' · Next' : ' · Reference / planned'}</span></Chip>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="none" data-none role="status"></p></details>
  </section>

  <Cluster as="p" space={4} justify="space-between" align="stretch" class="foot">
    <a href="/curriculum/">Explore the curriculum map</a>
    <a href="/contribute/">Help develop the curriculum</a>
  </Cluster>
</PageFrame>

<style>@layer blocks {
  /* The opening: the title down the left, the introduction and a jump to the
     full catalogue on the right; one column below 850px. */
  .page-head { padding: 40px 0 48px; border-bottom: 1px solid var(--h-line); }
  .page-head > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 64px; }
  h1 { grid-row: 1 / 3; margin: 0; color: var(--h-ink); font: italic 900 4rem/1.08 var(--h-font-mag); letter-spacing: -0.025em; }
  h1 em { color: var(--h-spot-ink); font-style: inherit; }
  .intro { max-width: 70ch; margin: 0; color: var(--h-ink-body); font: 1.25rem/1.6 var(--h-font-ui); }
  .catalogue-jump { grid-column: 2; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 850px) {
    .page-head > div { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    h1 { grid-row: auto; font-size: 3rem; }
    .catalogue-jump { grid-column: 1; }
  }

  .block { margin-top: 40px; padding-top: calc(var(--h-cell) * 8); }
  /* The full catalogue opens under a heavy rule. */
  .block:has([data-groups]) { margin-top: 48px; padding-top: 32px; border-top: 5px solid var(--h-ink); }
  .block h2 {
    margin: 0;
    font-family: var(--h-font-ui);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, var(--h-text-h1));
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--h-ink);
  }
  .sec-intro { max-width: 52ch; margin: calc(var(--h-cell) * 1.5) 0 0; color: var(--h-ink-body); }

  /* ---- with lessons ---- */
  .next li { display: flex; }
  .meta { margin: 0; font-family: var(--h-font-ui); font-size: var(--h-text-micro); line-height: 1.5; color: var(--h-ink-muted); font-weight: 600; }

  /* An empty tube: the same object, dark, saying what is missing. */
  .tube-off {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    width: calc(100% - 1.2rem);
    max-width: 352px;
    margin: 0.6rem;
    justify-self: center;
    border-radius: 1.4rem / 1.6rem;
    background: var(--h-screen-glass);
    box-shadow: 0 0 0 0.6rem var(--h-screen-bezel), 0 0 0 calc(0.6rem + 1px) var(--h-screen-rim);
  }
  .tube-off span { font-family: var(--h-font-mono); font-size: var(--h-text-micro); color: #a39883; }
  .nx .name, .nx .meta { justify-self: start; }
  .name { margin: var(--h-cell) 0 0; font-weight: 600; font-size: var(--h-text-body); line-height: 1.2; color: var(--h-ink); }

  /* ---- the catalogue ---- */
  .tools {
    margin: calc(var(--h-cell) * 4) 0 calc(var(--h-cell) * 2);
  }
  .lenses a {
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--h-cell) * 5);
    padding: 0 calc(var(--h-cell) * 2);
    border: 1px solid var(--h-line);
    background: var(--h-shell);
    color: var(--h-ink-body);
    font-size: var(--h-text-micro);
    font-weight: var(--h-weight-minor);
    text-decoration: none;
  }
  .lenses a:hover { background: var(--h-wash); color: var(--h-ink); }
  .lenses a:focus-visible { outline: 2px solid var(--h-accent); outline-offset: 2px; }
  /* Current: inverse video (§7). */
  .lenses a[aria-current] { background: var(--h-ink); border-color: var(--h-ink); color: var(--h-ground); }
  .legend { max-width: 70ch; margin: 0 0 calc(var(--h-cell) * 3); font-size: var(--h-text-small); line-height: var(--h-lh-small); color: var(--h-ink-muted); }
  .legend b { color: var(--h-ink-body); font-weight: 600; }
  .legend a { color: var(--h-ink-body); }

  .group {
    display: grid;
    grid-template-columns: minmax(10rem, 2fr) minmax(0, 10fr);
    gap: calc(var(--h-cell) * 4);
    padding: calc(var(--h-cell) * 3) 0;
    border-top: 1px solid var(--h-line);
  }
  .group:last-child { border-bottom: 1px solid var(--h-line); }
  .group[hidden] { display: none; }
  .ghead h3 { margin: 0; font: 700 1.35rem/1.15 var(--h-font-ui); letter-spacing: -0.015em; color: var(--h-ink); }
  .n { margin: var(--h-cell) 0 0; font-family: var(--h-font-ui); font-size: var(--h-text-micro); color: var(--h-ink-muted); font-weight: 600; }
  .blurb { margin: var(--h-cell) 0 0; font-size: var(--h-text-micro); line-height: var(--h-lh-micro); color: var(--h-ink-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--h-cell); align-content: start; }
  .chips li[hidden] { display: none; }
  .none { margin: 0; padding: calc(var(--h-cell) * 4) 0; color: var(--h-ink-muted); }
  .none:empty { padding: 0; }

  .foot {
    margin: calc(var(--h-cell) * 8) 0 0;
    padding-top: calc(var(--h-cell) * 3);
    border-top: 1px solid var(--h-line);
  }
  .foot a { color: var(--h-ink-body); }

  @media (max-width: 767px) {
    .group { grid-template-columns: minmax(0, 1fr); gap: calc(var(--h-cell) * 2); }
  }
  /* On a phone the card's own padding goes from the sides, so a 320-pixel
     screen (the Amiga, a halved BBC Micro) still shows at 1x. */
  @media (max-width: 420px) {
    .nx .name, .nx .meta { padding-inline: calc(var(--h-cell) * 1.5); }
  }
}
@layer blocks {

  ul { margin: 0; padding: 0; list-style: none; }

  /* ---- prioritised ---- */
  .next {
    margin-top: calc(var(--h-cell) * 4);
  }
}
/* Overrides of 198x-ui components stay outside the layers: the kit's own
   component styles are unlayered, and unlayered CSS beats every layer. */
.next li > :global(.nx) { flex: 1; }
.next :global(.nx > .h-shell-core) { height: 100%; padding: calc(var(--h-cell) * 1.5); display: grid; align-content: start; justify-items: center; gap: calc(var(--h-cell) * 1.5); }
.tools :global(.find) { flex: 0 1 22rem; }
  @media (max-width: 767px) {
.tools :global(.find) { flex-basis: 100%; }
  }
  @media (max-width: 420px) {
.next :global(.nx > .h-shell-core) { padding-inline: 0; }
  }
</style>

<script>
  /* The find field filters the catalogue in place; Enter does not reload. */
  function init() {
    const root = document.querySelector<HTMLElement>('[data-catalogue]:not([data-bound])');
    if (!root) return;
    // A lens links to #catalogue, so switching arrangement lands on the
    // catalogue, open, rather than at the top of the page.
    if (location.hash === '#catalogue') root.querySelector<HTMLDetailsElement>('details')!.open = true;
    root.dataset.bound = 'true';
    const form = root.querySelector<HTMLFormElement>('form[role="search"]')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const none = root.querySelector<HTMLElement>('[data-none]')!;
    const filter = () => {
      const q = input.value.trim().toLowerCase();
      let any = false;
      root.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        const items = [...g.querySelectorAll<HTMLElement>('li[data-q]')];
        let shown = 0;
        items.forEach((li) => { const hit = !q || (li.dataset.q ?? '').includes(q); li.hidden = !hit; if (hit) shown++; });
        g.hidden = shown === 0;
        const n = g.querySelector<HTMLElement>('[data-n]')!;
        const total = items.length;
        n.textContent = q ? `${shown} of ${total}` : `${total} ${total === 1 ? 'machine' : 'machines'}`;
        if (shown) any = true;
      });
      none.textContent = any ? '' : 'No machine matches that search.';
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); filter(); });
    input.addEventListener('input', filter);
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>@layer blocks{
.published-machines{margin-top:32px}.published-machine{align-items:center;border-top:1px solid var(--h-line);padding:32px 0}.published-machine h3{font-size:2rem;margin:0 0 12px}.published-machine p{margin:8px 0;font-size:1rem}.machine-language-links{list-style:none;padding:0}.machine-language-links a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:5px}.route-link{display:inline-flex;min-height:48px;align-items:center;font-weight:600}.catalogue-disclosure{margin-top:32px}.catalogue-disclosure summary{font-weight:700;min-height:48px;cursor:pointer}.systems .next .tube-off{display:none}
}
@layer blocks{.systems .block h2{font:italic 900 3rem/1.1 var(--h-font-mag);letter-spacing:-.025em;margin-bottom:24px}
.systems .groups{border-top:1px solid var(--h-line);padding-top:24px}
.systems :global(.tools){border-block:1px solid var(--h-line);padding:20px 0}
@media(max-width:740px){.systems .block h2{font-size:2.5rem}}
}
/* Overrides of 198x-ui components stay outside the layers: the kit's own
   component styles are unlayered, and unlayered CSS beats every layer. */
.systems .next :global(.h-shell){border:0;border-radius:0;box-shadow:none}
.systems :global(.nx){border-radius:0;box-shadow:none;background:var(--h-ground);color:var(--h-ink)}
.systems .next :global(.tube){display:none}
.systems .chips :global(.h-chip){border-radius:0;box-shadow:none}
</style>
