---
interface Props { machine: string; choice: string; label: string; note?: string; }
const { machine, choice, label, note } = Astro.props;
---
<div class="lesson-experiment-launch"><button type="button" data-lesson-machine={machine} data-source-choice={choice} aria-controls={machine} aria-expanded="false">Try this · {label}</button>{note && <span>{note}</span>}</div>
