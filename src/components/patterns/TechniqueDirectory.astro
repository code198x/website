---
import {prototypeRoot} from '../../data/pattern-techniques';
import {resolveTechniques} from '../../lib/pattern-techniques';
import {getCollection} from 'astro:content';
const items=resolveTechniques(await getCollection('patterns'));
const machines=[['sinclair-zx-spectrum','ZX Spectrum'],['commodore-64','Commodore 64'],['commodore-amiga','Amiga'],['nintendo-nes','NES']];
---
<section class="technique-directory" data-technique-directory aria-labelledby="technique-heading">
 <h2 id="technique-heading">What do you want to make work?</h2>
 <form class="technique-filters" hidden role="search" aria-label="Find a technique">
  <label>Find a task<input type="search" name="q" placeholder="Try keys, one press, beep or chase" /></label>
  <label>Machine<select name="machine"><option value="">Any machine</option>{machines.map(([id,title])=><option value={id}>{title}</option>)}</select></label>
  <label>Language<select name="language"><option value="">Any language</option><option>Assembly</option><option>Pseudocode</option></select></label>
  <button type="reset">Clear filters</button>
 </form>
 <p class="technique-count" role="status" data-result-count>4 techniques in this prototype</p>
 <p data-empty hidden>No techniques match. Try another task or clear the filters.</p>
 <ol class="technique-list">
 {items.map(t=><li data-technique={t.slug} data-search={`${t.title} ${t.task} ${t.summary} ${t.terms}`.toLowerCase()} data-variants={JSON.stringify([...(t.slug==='choose-a-target'?[{machine:'commodore-64',language:'Assembly'}]:machines.map(([machine])=>({machine,language:'Assembly'}))),...t.implementations.filter(i=>i.entry.data.platform==='cross-platform').map(i=>({machine:'cross-platform',language:i.language}))])}>
   <div><h3><a data-base={`${prototypeRoot}${t.slug}/`} href={`${prototypeRoot}${t.slug}/`}>{t.title}</a></h3><p class="technique-task">{t.task}</p><p>{t.summary}</p></div>
   <div class="technique-links"><p>{t.implementations.length ? 'Machine implementations' : 'C64 implementation'}</p><ul>{(t.slug==='choose-a-target'?machines.filter(([id])=>id==='commodore-64'):machines).map(([id,title])=><li><a href={`${prototypeRoot}${t.slug}/${t.slug==='choose-a-target'?'':id+'/'}`}>{title}</a><span>Assembly · code and calling instructions</span></li>)}</ul></div>
 </li>)}
 </ol>
 <noscript><p>All four techniques and their implementation links are available without JavaScript. The small experiments need JavaScript.</p></noscript>
</section>
<script>
function init(){document.querySelectorAll<HTMLElement>('[data-technique-directory]').forEach(root=>{
 if(root.dataset.ready)return;root.dataset.ready='true';
 const form=root.querySelector<HTMLFormElement>('form')!;form.hidden=false;
 const input=form.elements.namedItem('q') as HTMLInputElement;
 const machine=form.elements.namedItem('machine') as HTMLSelectElement;
 const language=form.elements.namedItem('language') as HTMLSelectElement;
 const url=new URL(location.href);
 for(const field of [machine,language]){const value=url.searchParams.get(field.name);if(value!==null&&[...field.options].some(o=>o.value===value))field.value=value;}
 input.value=url.searchParams.get('q')??'';
 function update(){let count=0;const words=input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
  root.querySelectorAll<HTMLElement>('[data-technique]').forEach(row=>{
   const variants=JSON.parse(row.dataset.variants!) as {machine:string;language:string}[];
   const taskLink=row.querySelector<HTMLAnchorElement>('h3 a')!;
   taskLink.href=taskLink.dataset.base!+(machine.value&&row.dataset.technique!=='choose-a-target'?machine.value+'/':'');
   const matches=variants.some(v=>(!machine.value||v.machine===machine.value||v.machine==='cross-platform')&&(!language.value||v.language===language.value));
   row.hidden=!matches||!words.every(w=>row.dataset.search!.includes(w));if(!row.hidden)count++;
  });
  root.querySelector('[data-result-count]')!.textContent=`${count} ${count===1?'technique':'techniques'} in this prototype`;
  root.querySelector<HTMLElement>('[data-empty]')!.hidden=count!==0;
  const next=new URL(location.href);for(const field of [input,machine,language]){if(field.value)next.searchParams.set(field.name,field.value);else next.searchParams.delete(field.name);}
  if(location.protocol!=='file:')history.replaceState(history.state,'',next);
 }
 form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',update);
 form.addEventListener('reset',()=>{input.value='';machine.value='';language.value='';update();});update();
});}init();document.addEventListener('astro:page-load',init);
</script>
