---
export interface Props {
  code: string;
  language?: 'basic' | 'asm' | 'forth' | 'amos';
  platform?: string;
  title?: string;
  explanation?: string;
  output?: string;
  runnable?: boolean;
}

const { 
  code, 
  language = 'basic', 
  platform = 'c64',
  title,
  explanation,
  output,
  runnable = false
} = Astro.props;

// Platform-specific styling
const platformStyles = {
  'c64': {
    bg: 'bg-c64-blue',
    border: 'border-c64-blue',
    text: 'text-c64-blue'
  },
  'spectrum': {
    bg: 'bg-spectrum-blue',
    border: 'border-spectrum-blue', 
    text: 'text-spectrum-blue'
  },
  'amiga': {
    bg: 'bg-amiga-orange',
    border: 'border-amiga-orange',
    text: 'text-amiga-orange'
  },
  'bbcmicro': {
    bg: 'bg-red-600',
    border: 'border-red-600',
    text: 'text-red-600'
  },
  'amstradcpc': {
    bg: 'bg-green-600',
    border: 'border-green-600',
    text: 'text-green-600'
  },
  'appleii': {
    bg: 'bg-blue-600',
    border: 'border-blue-600',
    text: 'text-blue-600'
  },
  'atarist': {
    bg: 'bg-gray-600',
    border: 'border-gray-600',
    text: 'text-gray-600'
  },
  'atari800': {
    bg: 'bg-red-700',
    border: 'border-red-700',
    text: 'text-red-700'
  },
  'ti994a': {
    bg: 'bg-blue-700',
    border: 'border-blue-700',
    text: 'text-blue-700'
  },
  'dragon': {
    bg: 'bg-yellow-700',
    border: 'border-yellow-700',
    text: 'text-yellow-700'
  },
  'jupiterace': {
    bg: 'bg-purple-600',
    border: 'border-purple-600',
    text: 'text-purple-600'
  }
};

const currentStyle = platformStyles[platform as keyof typeof platformStyles] || platformStyles.c64;
---

<div class={`rounded-lg border-2 ${currentStyle.border} overflow-hidden mb-6`}>
  {title && (
    <div class={`${currentStyle.bg} text-white px-4 py-2`}>
      <h3 class="font-bold text-sm">{title}</h3>
    </div>
  )}
  
  <div class="bg-black text-green-400 p-4 font-mono text-sm overflow-x-auto">
    <pre class="whitespace-pre-wrap"><code class={`language-${language}`}>{code}</code></pre>
  </div>
  
  {output && (
    <div class="bg-gray-900 text-green-300 p-4 font-mono text-sm border-t border-gray-700">
      <div class="text-xs text-gray-500 mb-2">OUTPUT:</div>
      <pre class="whitespace-pre-wrap">{output}</pre>
    </div>
  )}
  
  {runnable && (
    <div class={`${currentStyle.bg.replace('bg-', 'bg-').replace('-', '-')}/10 p-3 border-t border-gray-200`}>
      <button 
        class={`px-4 py-2 ${currentStyle.bg} text-white rounded-lg font-medium text-sm hover:opacity-90 transition-opacity`}
        data-code-runner
        data-code={code}
        data-language={language}
      >
        ▶ Try This Program
      </button>
      <span class="text-xs text-gray-600 ml-3">
        Run in browser emulator
      </span>
    </div>
  )}
  
  {explanation && (
    <div class="bg-gray-50 p-4 border-t border-gray-200">
      <div class="text-sm text-gray-700 leading-relaxed">
        {explanation}
      </div>
    </div>
  )}
</div>

<style>
  /* BASIC syntax highlighting */
  .language-basic .token.keyword {
    color: #ff6b9d;
    font-weight: bold;
  }
  
  .language-basic .token.number {
    color: #4ecdc4;
  }
  
  .language-basic .token.string {
    color: #95e1d3;
  }
  
  .language-basic .token.comment {
    color: #6c7b7f;
    font-style: italic;
  }
  
  .language-basic .token.operator {
    color: #f38ba8;
  }
  
  .language-basic .token.punctuation {
    color: #a6a6a6;
  }
  
  /* Forth syntax highlighting */
  .language-forth .token.word {
    color: #ff9f40;
    font-weight: bold;
  }
  
  .language-forth .token.number {
    color: #4ecdc4;
  }
  
  .language-forth .token.comment {
    color: #6c7b7f;
    font-style: italic;
  }
  
  .language-forth .token.string {
    color: #95e1d3;
  }
</style>

<script>
  // Add interactivity for runnable code blocks
  document.addEventListener('DOMContentLoaded', () => {
    const runButtons = document.querySelectorAll('[data-code-runner]');
    
    runButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        const code = e.target.dataset.code;
        const language = e.target.dataset.language;
        
        // For now, just show an alert. In the future, this would launch an emulator
        alert(`Would run ${language.toUpperCase()} code:\n\n${code}\n\n(Emulator integration coming soon!)`);
      });
    });
  });
</script>