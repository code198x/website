---
import { getCollection } from 'astro:content';

export interface Props {
  content: string;
  currentCategory?: string;
  currentSlug?: string;
}

const { content, currentCategory, currentSlug } = Astro.props;

// Load all Vault entries
const categories = [
  'hardware', 'people', 'companies', 'software', 'techniques',
  'publications', 'events', 'groups', 'formats', 'culture', 'games'
];

const vaultEntries = new Map();

for (const category of categories) {
  try {
    const collection = await getCollection(category, ({ data }) => 
      data.status === 'available'
    );
    
    for (const entry of collection) {
      const name = entry.data.name || entry.id;
      const slug = entry.slug || entry.id;
      
      // Skip self-linking
      if (category === currentCategory && slug === currentSlug) {
        continue;
      }
      
      // Store by name
      vaultEntries.set(name.toLowerCase(), {
        category,
        slug,
        name,
        url: `/vault/${category}/${slug}`
      });
      
      // Store by aliases
      if (entry.data.aliases) {
        for (const alias of entry.data.aliases) {
          vaultEntries.set(alias.toLowerCase(), vaultEntries.get(name.toLowerCase()));
        }
      }
    }
  } catch (err) {
    // Collection might not exist yet
  }
}

// Function to process content and add links
function autoLink(text: string): string {
  if (vaultEntries.size === 0) return text;
  
  // Sort entries by length (longest first) to match longer phrases
  const sortedEntries = Array.from(vaultEntries.entries())
    .sort((a, b) => b[0].length - a[0].length);
  
  let result = text;
  const linkedTerms = new Set();
  
  for (const [key, entry] of sortedEntries) {
    // Skip if already linked this term
    if (linkedTerms.has(entry.name)) continue;
    
    // Create regex for whole word matching
    const regex = new RegExp(`\\b(${entry.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})\\b(?![^<]*>|[^<]*<\/a>)`, 'gi');
    
    if (regex.test(result)) {
      result = result.replace(regex, (match) => {
        linkedTerms.add(entry.name);
        return `<a href="${entry.url}" class="vault-link" title="View ${entry.name} in The Vault">${match}</a>`;
      });
    }
  }
  
  return result;
}

const processedContent = autoLink(content);
---

<div class="vault-content" set:html={processedContent} />

<style>
  :global(.vault-link) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
    transition: all 0.2s ease;
  }
  
  :global(.vault-link:hover) {
    text-decoration-style: solid;
    color: var(--color-primary-dark);
  }
</style>