---
export interface Props {
  tier: 'platinum' | 'gold' | 'silver' | 'bronze';
  size?: 'small' | 'medium' | 'large';
  showLabel?: boolean;
}

const { tier, size = 'medium', showLabel = true } = Astro.props;

const tierConfig = {
  platinum: {
    icon: '🏆',
    label: 'Platinum',
    description: 'Complete Mastery',
    gradient: 'from-gray-300 to-gray-100',
    border: 'border-gray-400',
    text: 'text-gray-800',
    duration: '6-12 months',
    lessons: '4,096 lessons'
  },
  gold: {
    icon: '🥇',
    label: 'Gold',
    description: 'Professional Skills',
    gradient: 'from-yellow-400 to-yellow-200',
    border: 'border-yellow-600',
    text: 'text-yellow-900',
    duration: '3-6 months',
    lessons: '2,048 lessons'
  },
  silver: {
    icon: '🥈',
    label: 'Silver',
    description: 'Solid Understanding',
    gradient: 'from-gray-400 to-gray-200',
    border: 'border-gray-500',
    text: 'text-gray-800',
    duration: '6-12 weeks',
    lessons: '1,024 lessons'
  },
  bronze: {
    icon: '🥉',
    label: 'Bronze',
    description: 'Quick Exploration',
    gradient: 'from-orange-600 to-orange-400',
    border: 'border-orange-700',
    text: 'text-orange-900',
    duration: '2-4 weeks',
    lessons: '512 lessons'
  }
};

const config = tierConfig[tier];

const sizeClasses = {
  small: 'text-xs px-2 py-1',
  medium: 'text-sm px-3 py-2',
  large: 'text-base px-4 py-3'
};

const iconSizes = {
  small: 'text-base',
  medium: 'text-lg',
  large: 'text-2xl'
};
---

<div class={`medal-badge medal-${tier} ${size}`}>
  <div class={`
    inline-flex items-center gap-2 
    bg-gradient-to-r ${config.gradient} 
    ${config.border} border-2 
    rounded-full shadow-lg 
    ${sizeClasses[size]}
    hover:scale-105 transition-transform duration-200
  `}>
    <span class={`medal-icon ${iconSizes[size]}`}>
      {config.icon}
    </span>
    {showLabel && (
      <div class="medal-info">
        <div class={`font-bold ${config.text}`}>
          {config.label}
        </div>
        {size !== 'small' && (
          <div class={`text-xs opacity-80 ${config.text}`}>
            {config.duration} • {config.lessons}
          </div>
        )}
      </div>
    )}
  </div>
  {size === 'large' && (
    <div class={`mt-1 text-xs ${config.text} text-center opacity-70`}>
      {config.description}
    </div>
  )}
</div>

<style>
  .medal-badge {
    display: inline-block;
    position: relative;
  }

  .medal-platinum {
    --medal-primary: #e5e7eb;
    --medal-secondary: #9ca3af;
    --medal-accent: #4b5563;
  }

  .medal-gold {
    --medal-primary: #fbbf24;
    --medal-secondary: #f59e0b;
    --medal-accent: #d97706;
  }

  .medal-silver {
    --medal-primary: #9ca3af;
    --medal-secondary: #6b7280;
    --medal-accent: #4b5563;
  }

  .medal-bronze {
    --medal-primary: #fb923c;
    --medal-secondary: #ea580c;
    --medal-accent: #c2410c;
  }

  /* Shine effect on hover */
  .medal-badge:hover .medal-icon {
    animation: medal-shine 0.5s ease-in-out;
  }

  @keyframes medal-shine {
    0%, 100% {
      transform: rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(5deg) scale(1.2);
    }
  }

  /* Optional: Add a subtle glow effect for platinum */
  .medal-platinum > div {
    box-shadow: 
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05),
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.5);
  }

  /* Gold gets a golden glow */
  .medal-gold > div {
    box-shadow: 
      0 10px 25px -5px rgba(251, 191, 36, 0.3),
      0 4px 6px -2px rgba(251, 191, 36, 0.1),
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.5);
  }
</style>