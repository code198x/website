---
/**
 * "In this lesson": the unit's sections, in the rail beside the prose.
 *
 * From the approved lesson concept (website-preview/public/concepts/
 * lesson.html, the .toc rail). Interface, so a square panel with one line
 * (family-visual-identity.md §7). The section being read is marked with
 * aria-current="location" and a wash and a rule, not inverse video, which
 * means only "the page you are on" (§7).
 *
 * Rendered at build time from the MDX's own headings, so it is there without
 * JavaScript and on a soft navigation. TableOfContents, which builds itself
 * in the browser, stays for the reading pages that use it.
 *
 * Props:
 *   headings  Astro's rendered headings for the entry.
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
// Sections are the h2s. A unit written in h3s alone still gets a list.
const top = Math.min(...headings.map((h) => h.depth), 6);
const items = headings.filter((h) => h.depth === top && h.slug !== 'sources');
---
{items.length > 0 && (
  <nav class="lesson-contents toc" aria-labelledby="lesson-contents-h" data-lesson-contents>
    <h2 class="lc-head" id="lesson-contents-h">In this lesson</h2>
    <ol class="lc-list">
      {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </nav>
)}

<style>
  .lesson-contents {
    box-sizing: border-box;
    padding: calc(var(--h-cell) * 2);
    border: 1px solid var(--h-line);
    border-radius: 0;
    background: var(--h-ground);
  }
  .lc-head {
    margin: calc(var(--h-cell) * 0.5) var(--h-cell) calc(var(--h-cell) * 1.5);
    color: var(--h-ink-muted);
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    line-height: 1;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .lc-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lc-list li { margin: 0; }
  .lc-list a {
    display: block;
    padding: var(--h-cell) calc(var(--h-cell) * 1.5);
    color: var(--h-ink-body);
    font-family: var(--h-font-ui);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
    text-decoration: none;
    transition: color var(--h-decay) var(--h-ease), background-color var(--h-decay) var(--h-ease);
  }
  .lc-list a:hover,
  .lc-list a:focus-visible {
    color: var(--h-ink);
    background: var(--h-wash);
    transition-duration: var(--h-rise);
  }
  .lc-list a:focus-visible { outline: 2px solid var(--h-accent); outline-offset: -2px; }
  .lc-list a[aria-current] {
    color: var(--h-ink);
    background: var(--h-wash-2);
    box-shadow: inset 2px 0 0 var(--h-accent-ink);
  }

  /* Above the prose on a narrow screen: the sections as a wrapped row. */
  @media (max-width: 1099px) {
    .lc-list { display: flex; flex-wrap: wrap; gap: 2px var(--h-cell); }
    .lc-list a { padding: calc(var(--h-cell) * 0.5) var(--h-cell); font-size: var(--h-text-micro); line-height: var(--h-lh-micro); }
  }
</style>

<script>
  // Mark the section being read: the last heading above a line 35% down the
  // window, as the concept does. An IntersectionObserver is the trigger, so
  // nothing runs on every scroll frame.
  let io: IntersectionObserver | undefined;
  function init() {
    io?.disconnect();
    const nav = document.querySelector<HTMLElement>('[data-lesson-contents]');
    if (!nav) return;
    const links = new Map([...nav.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
    if (!targets.length) return;
    const update = () => {
      const line = innerHeight * 0.35;
      let current: HTMLElement | undefined;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t;
      links.forEach((a, id) => {
        if (current && id === current.id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    io = new IntersectionObserver(update, { rootMargin: '-35% 0px -64% 0px' });
    targets.forEach((t) => io!.observe(t));
    update();
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
