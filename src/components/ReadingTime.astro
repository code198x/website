---
/**
 * ReadingTime - Displays estimated reading/learning time for content
 *
 * Usage:
 *   <ReadingTime minutes={45} />
 *   <ReadingTime minutes={90} type="learning" />
 */

export interface Props {
  minutes: number;
  type?: 'reading' | 'learning';
  platformColor?: string;
}

const { minutes, type = 'learning', platformColor = 'var(--color-primary)' } = Astro.props;

// Format the time nicely
const formatTime = (mins: number) => {
  if (mins < 60) {
    return `${mins} min`;
  }
  const hours = Math.floor(mins / 60);
  const remainingMins = mins % 60;
  if (remainingMins === 0) {
    return `${hours} hr`;
  }
  return `${hours} hr ${remainingMins} min`;
};

const timeString = formatTime(minutes);
const label = type === 'learning' ? 'learning time' : 'read';
---

<span class="reading-time" style={`--platform-color: ${platformColor}`}>
  <svg
    class="clock-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <polyline points="12 6 12 12 16 14"></polyline>
  </svg>
  <span class="time-text">{timeString} {label}</span>
</span>

<style>
  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }

  .clock-icon {
    color: var(--platform-color);
    flex-shrink: 0;
  }

  .time-text {
    white-space: nowrap;
  }
</style>
