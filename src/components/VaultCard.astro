---
/**
 * VaultCard - Article preview card for vault/reference content
 *
 * Usage:
 *   import VaultCard from '@components/VaultCard.astro';
 *   <VaultCard
 *     href="/vault/hardware/vic-ii"
 *     kicker="Hardware"
 *     title="Inside the VIC-II"
 *     description="The graphics chip that gave the C64 its visual identity."
 *     platformColor="#4a4dff"
 *   />
 *
 * Can also be used without platformColor for generic styling:
 *   <VaultCard href="..." kicker="..." title="..." description="..." />
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  kicker?: string;
  title: string;
  description?: string;
  platformColor?: string;
}

const { href, kicker, title, description, platformColor, ...attrs } = Astro.props;

// Use primary colour if no platform colour specified
const accentColor = platformColor || 'var(--color-primary)';
---

<a href={href} class="vault-card" style={`--accent-color: ${accentColor};`} {...attrs}>
  {kicker && <span class="vault-kicker">{kicker}</span>}
  <span class="vault-name">{title}</span>
  {description && <span class="vault-desc">{description}</span>}
</a>

<style>
  .vault-card {
    display: block;
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-base);
  }

  .vault-card:hover,
  .vault-card:focus-visible {
    border-color: var(--accent-color);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .vault-card:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  .vault-kicker {
    display: block;
    font-size: 0.7rem;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .vault-name {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .vault-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
