---
/**
 * VaultCard - Article preview card for vault/reference content
 *
 * Usage:
 *   import VaultCard from '@components/VaultCard.astro';
 *   <VaultCard
 *     href="/vault/hardware/vic-ii"
 *     kicker="Hardware"
 *     title="Inside the VIC-II"
 *     description="The graphics chip that gave the C64 its visual identity."
 *     platformColor="#4a4dff"
 *   />
 *
 * Can also be used without platformColor for generic styling:
 *   <VaultCard href="..." kicker="..." title="..." description="..." />
 */
import type { HTMLAttributes } from 'astro/types';
import { accessibleInk, mix, SURFACE_LIGHT, SURFACE_DARK } from '../lib/contrast';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  kicker?: string;
  title: string;
  description?: string;
  platformColor?: string;
}

const { href, kicker, title, description, platformColor, ...attrs } = Astro.props;

// Use primary colour if no platform colour specified
const accentColor = platformColor || 'var(--color-primary)';

// Theme-aware accessible ink for accent text. The worst-case background is the
// kicker chip (a 10% accent tint over the card surface), so compute against
// that — an ink that passes there also passes on the plainer card surface.
// Only derivable when we have a real hex; otherwise fall back to the accent.
const accentHex = platformColor && /^#[0-9a-fA-F]{3,6}$/.test(platformColor) ? platformColor : null;
const inkLight = accentHex ? accessibleInk(accentHex, mix(accentHex, SURFACE_LIGHT, 0.1)) : accentColor;
const inkDark = accentHex ? accessibleInk(accentHex, mix(accentHex, SURFACE_DARK, 0.1)) : accentColor;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<a
  href={href}
  class="vault-card"
  style={`--accent-color: ${accentColor}; --ink-l: ${inkLight}; --ink-d: ${inkDark};`}
  {...attrs}
>
  <div class="vault-card-inner">
    {kicker && <span class="vault-kicker brand-ink" set:html={inlineMarkdown(kicker)} />}
    <span class="vault-name" set:html={inlineMarkdown(title)} />
    {description && <span class="vault-desc" set:html={inlineMarkdown(description)} />}
    <span class="vault-read-more brand-ink">Read article →</span>
  </div>
  <div class="vault-card-border"></div>
</a>

<style>
  @keyframes border-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .vault-card {
    display: block;
    padding: 3px;
    background: var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-chunky);
  }

  .vault-card-inner {
    background: var(--color-bg);
    padding: var(--space-6);
    height: 100%;
    position: relative;
    z-index: 1;
    transition: background 0.3s ease;
  }

  /* Animated border gradient on hover */
  .vault-card-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      var(--accent-color) 0%,
      color-mix(in oklab, var(--accent-color) 70%, var(--color-primary) 30%) 50%,
      var(--accent-color) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .vault-card:hover,
  .vault-card:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--accent-color);
  }

  .vault-card:hover .vault-card-border,
  .vault-card:focus-visible .vault-card-border {
    opacity: 1;
  }

  .vault-card:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  .vault-kicker {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    margin-bottom: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background: color-mix(in oklab, var(--accent-color) 10%, transparent 90%);
    border-left: 3px solid var(--accent-color);
  }

  .vault-name {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .vault-card:hover .vault-name {
    color: var(--ink-l);
  }

  :global(:root[data-theme="dark"]) .vault-card:hover .vault-name {
    color: var(--ink-d);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .vault-card:hover .vault-name {
      color: var(--ink-d);
    }
  }

  .vault-desc {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .vault-read-more {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .vault-card:hover .vault-read-more,
  .vault-card:focus-visible .vault-read-more {
    opacity: 1;
    transform: translateX(0);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .vault-card:hover,
    .vault-card:focus-visible {
      transform: none;
    }

    .vault-read-more {
      opacity: 1;
      transform: none;
    }
  }
</style>
