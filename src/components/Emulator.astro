---
/**
 * Embeds a running Emu198x emulator in a lesson page.
 *
 * Usage:
 *   <Emulator system="sinclair-zx-spectrum" src="/code-samples/spectrum/starfield.sna" />
 *   <Emulator system="sinclair-zx-spectrum" src="/code-samples/spectrum/hello.z80" autoplay />
 *
 * Props:
 *   system   — system identifier (e.g. "sinclair-zx-spectrum")
 *   src      — path to the binary file (resolved from public/)
 *   width    — display width in CSS pixels (default: 640)
 *   height   — display height in CSS pixels (default: 480)
 *   autoplay — start running immediately
 *   controls — show control bar (default: true)
 *   caption  — optional caption below the emulator
 */

interface Props {
  system: string;
  src?: string;
  width?: number;
  height?: number;
  autoplay?: boolean;
  controls?: boolean;
  caption?: string;
}

const {
  system,
  src,
  width = 640,
  height = 480,
  autoplay = false,
  controls = true,
  caption,
} = Astro.props;
---

<figure class="emulator-figure">
  <emu198x-player
    system={system}
    src={src}
    width={width.toString()}
    height={height.toString()}
    controls={controls ? 'true' : 'false'}
    {...(autoplay ? { autoplay: '' } : {})}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script is:inline src="/emulator/emulator.js"></script>

<style>
  .emulator-figure {
    margin: 1.5rem 0;
  }
  .emulator-figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #555);
    text-align: center;
  }
</style>
