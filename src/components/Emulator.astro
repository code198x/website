---
export interface Props {
  system: 'commodore-64' | 'zx-spectrum' | 'nintendo-entertainment-system' | 'commodore-amiga';
  code?: string;
  autoStart?: boolean;
  showControls?: boolean;
  height?: string;
  width?: string;
}

const { 
  system, 
  code = '', 
  autoStart = false, 
  showControls = true,
  height = '400px',
  width = '100%'
} = Astro.props;

// Generate unique ID for this emulator instance
const emulatorId = `emulator-${Math.random().toString(36).substr(2, 9)}`;

// System-specific configuration
const getSystemConfig = (systemSlug: string) => {
  switch(systemSlug) {
    case 'commodore-64':
      return {
        name: 'Commodore 64',
        emulatorType: 'vice',
        colors: { bg: 'bg-c64-brown', accent: 'text-c64-brown' },
        assembler: '6502',
        romRequired: true
      };
    case 'zx-spectrum':
      return {
        name: 'ZX Spectrum',
        emulatorType: 'jsspeccy',
        colors: { bg: 'bg-spectrum-red', accent: 'text-spectrum-red' },
        assembler: 'Z80',
        romRequired: false
      };
    case 'nintendo-entertainment-system':
      return {
        name: 'Nintendo Entertainment System',
        emulatorType: 'jsnes',
        colors: { bg: 'bg-nes-red', accent: 'text-nes-red' },
        assembler: '6502',
        romRequired: true
      };
    case 'commodore-amiga':
      return {
        name: 'Commodore Amiga',
        emulatorType: 'vamiga',
        colors: { bg: 'bg-amiga-blue', accent: 'text-amiga-blue' },
        assembler: '68000',
        romRequired: true
      };
    default:
      return {
        name: 'Unknown System',
        emulatorType: 'unknown',
        colors: { bg: 'bg-slate-600', accent: 'text-slate-600' },
        assembler: 'Unknown',
        romRequired: false
      };
  }
};

const config = getSystemConfig(system);
---

<div class="emulator-container bg-white/90 rounded-xl shadow-lg border border-slate-200 overflow-hidden">
  <!-- Emulator Header -->
  <div class={`${config.colors.bg} text-white px-4 py-3 flex items-center justify-between`}>
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center text-sm font-bold" style="width: 2rem; height: 2rem;">
        💻
      </div>
      <div>
        <h3 class="font-bold text-sm">{config.name} Emulator</h3>
        <p class="text-white/80 text-xs">{config.assembler} Assembly</p>
      </div>
    </div>
    
    {showControls && (
      <div class="flex items-center gap-2">
        <button 
          class="emulator-run-btn px-3 py-1 bg-white/20 hover:bg-white/30 rounded text-xs font-medium transition-colors"
          data-emulator-id={emulatorId}
          data-system={system}
        >
          ▶ Run Code
        </button>
        <button 
          class="emulator-reset-btn px-3 py-1 bg-white/20 hover:bg-white/30 rounded text-xs font-medium transition-colors"
          data-emulator-id={emulatorId}
        >
          🔄 Reset
        </button>
      </div>
    )}
  </div>

  <!-- Code Editor (if code is provided) -->
  {code && (
    <div class="border-b border-slate-200">
      <div class="bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 flex items-center justify-between">
        <span>Assembly Code</span>
        <button 
          class="text-xs text-slate-500 hover:text-slate-700 transition-colors"
          onclick={`document.getElementById('code-${emulatorId}').classList.toggle('hidden')`}
        >
          Toggle Code
        </button>
      </div>
      <div id={`code-${emulatorId}`} class="bg-slate-900 text-green-400 p-4 font-mono text-sm">
        <pre class="whitespace-pre-wrap">{code}</pre>
      </div>
    </div>
  )}

  <!-- Emulator Display -->
  <div class="relative" style={`height: ${height}`}>
    <div 
      id={emulatorId}
      class="w-full h-full bg-black flex items-center justify-center text-white"
      data-system={system}
      data-config={JSON.stringify(config)}
      data-code={code}
      data-auto-start={autoStart}
    >
      <div class="text-center">
        <div class="w-16 h-16 bg-white/10 rounded-xl flex items-center justify-center text-2xl mb-4 mx-auto">
          💻
        </div>
        <p class="text-white/80 mb-2">Loading {config.name} Emulator...</p>
        <p class="text-white/60 text-sm">
          {config.romRequired ? 'ROM files required for full functionality' : 'Ready to run'}
        </p>
      </div>
    </div>
  </div>

  <!-- Status Bar -->
  <div class="bg-slate-50 px-4 py-2 text-xs text-slate-600 flex items-center justify-between border-t border-slate-200">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1">
        <div class="w-2 h-2 bg-green-500 rounded-full"></div>
        Ready
      </span>
      <span>System: {config.name}</span>
      <span>CPU: {config.assembler}</span>
    </div>
    <div class="text-right">
      <span class="emulator-status">Initializing...</span>
    </div>
  </div>
</div>

<!-- Emulator JavaScript -->
<script>
  // Emulator system configurations
  const EMULATOR_CONFIGS = {
    'commodore-64': {
      initFunction: 'initVICEEmulator',
      scriptSrc: '/js/emulators/vice.js',
      romPath: '/roms/c64/'
    },
    'zx-spectrum': {
      initFunction: 'initJSSpeccyEmulator', 
      scriptSrc: '/js/emulators/jsspeccy.js',
      romPath: null
    },
    'nintendo-entertainment-system': {
      initFunction: 'initJSNESEmulator',
      scriptSrc: '/js/emulators/jsnes.js', 
      romPath: '/roms/nes/'
    },
    'commodore-amiga': {
      initFunction: 'initVAmigaEmulator',
      scriptSrc: '/js/emulators/vamiga.js',
      romPath: '/roms/amiga/'
    }
  };

  // Initialize all emulators on the page
  document.addEventListener('DOMContentLoaded', () => {
    const emulators = document.querySelectorAll('[id^="emulator-"]');
    
    emulators.forEach(emulatorElement => {
      const system = emulatorElement.dataset.system;
      const config = JSON.parse(emulatorElement.dataset.config);
      const code = emulatorElement.dataset.code;
      const autoStart = emulatorElement.dataset.autoStart === 'true';
      
      if (EMULATOR_CONFIGS[system]) {
        loadEmulator(emulatorElement, system, config, code, autoStart);
      }
    });
  });

  // Load and initialize specific emulator
  async function loadEmulator(element, system, config, code, autoStart) {
    try {
      const emulatorConfig = EMULATOR_CONFIGS[system];
      
      // Update status
      updateEmulatorStatus(element, 'Loading emulator...');
      
      // Load emulator script if not already loaded
      if (!window[emulatorConfig.initFunction]) {
        await loadScript(emulatorConfig.scriptSrc);
      }
      
      // Initialize emulator
      updateEmulatorStatus(element, 'Initializing...');
      const emulator = await window[emulatorConfig.initFunction](element, {
        romPath: emulatorConfig.romPath,
        autoStart: autoStart,
        code: code
      });
      
      updateEmulatorStatus(element, 'Ready');
      
      // Store emulator instance for later use
      element.emulatorInstance = emulator;
      
    } catch (error) {
      console.error('Failed to load emulator:', error);
      updateEmulatorStatus(element, 'Error loading emulator');
    }
  }

  // Load external script
  function loadScript(src) {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  // Update emulator status
  function updateEmulatorStatus(element, status) {
    const statusEl = element.closest('.emulator-container').querySelector('.emulator-status');
    if (statusEl) {
      statusEl.textContent = status;
    }
  }

  // Handle run code button clicks
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('emulator-run-btn')) {
      const emulatorId = e.target.dataset.emulatorId;
      const system = e.target.dataset.system;
      const emulatorElement = document.getElementById(emulatorId);
      
      if (emulatorElement && emulatorElement.emulatorInstance) {
        const code = emulatorElement.dataset.code;
        runCodeInEmulator(emulatorElement.emulatorInstance, system, code);
      }
    }
  });

  // Handle reset button clicks
  document.addEventListener('click', (e) => {
    if (e.target.classList.contains('emulator-reset-btn')) {
      const emulatorId = e.target.dataset.emulatorId;
      const emulatorElement = document.getElementById(emulatorId);
      
      if (emulatorElement && emulatorElement.emulatorInstance) {
        resetEmulator(emulatorElement.emulatorInstance);
      }
    }
  });

  // Run code in emulator (system-specific implementation)
  function runCodeInEmulator(emulator, system, code) {
    try {
      switch(system) {
        case 'commodore-64':
          emulator.loadAndRunAssembly(code);
          break;
        case 'zx-spectrum':
          emulator.loadProgram(code);
          break;
        case 'nintendo-entertainment-system':
          emulator.loadROM(code);
          break;
        case 'commodore-amiga':
          emulator.loadAndRun(code);
          break;
      }
    } catch (error) {
      console.error('Error running code:', error);
    }
  }

  // Reset emulator
  function resetEmulator(emulator) {
    try {
      if (emulator.reset) {
        emulator.reset();
      }
    } catch (error) {
      console.error('Error resetting emulator:', error);
    }
  }
</script>