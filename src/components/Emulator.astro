---
/**
 * Embeds a running Emu198x emulator in a lesson page.
 *
 * Usage:
 *   <Emulator system="sinclair-zx-spectrum" />
 *   <Emulator system="sinclair-zx-spectrum" src="/code-samples/spectrum/border.sna" autoplay />
 *
 * Props:
 *   system   — system identifier (only "sinclair-zx-spectrum" so far)
 *   src      — snapshot or media to load, resolved from public/
 *   poster    — still image shown until the machine starts, so the outcome is
 *               visible without JavaScript
 *   width    — display width in CSS pixels (default: 704, i.e. 2x)
 *   height   — display height in CSS pixels (default: 592)
 *   autoplay — start without waiting for the reader to press Run
 *   controls — show the control bar (default: true)
 *   caption  — optional caption below the emulator
 *
 * The machine and its ROM travel in the @emu198x/zx-spectrum package, so a
 * lesson page fetches no firmware. The script below is bundled by Astro
 * rather than copied in from Emu198x by hand, which is what the old
 * public/emulator/README.md described.
 */

interface Props {
  system: string;
  src?: string;
  poster?: string;
  width?: number;
  height?: number;
  autoplay?: boolean;
  controls?: boolean;
  caption?: string;
}

const {
  system,
  src,
  poster,
  width = 704,
  height = 592,
  autoplay = false,
  controls = true,
  caption,
} = Astro.props;
import { inlineMarkdown } from '../lib/inline-markdown';
---

<figure class="emulator-figure">
  <code198x-spectrum-player
    data-system={system}
    data-src={src}
    data-poster={poster}
    data-width={width.toString()}
    data-height={height.toString()}
    data-controls={controls ? 'true' : 'false'}
    data-autoplay={autoplay ? 'true' : 'false'}
  ></code198x-spectrum-player>
  {caption && <figcaption set:html={inlineMarkdown(caption)} />}
</figure>

<script>
  import { SpectrumRunner } from '../lib/spectrum-runner';

  /** Systems this player can run. Anything else is a content error. */
  const SUPPORTED = new Set(['sinclair-zx-spectrum']);

  class Emu198xPlayer extends HTMLElement {
    #runner: SpectrumRunner | null = null;
    #canvas!: HTMLCanvasElement;
    #poster: HTMLImageElement | null = null;
    #status!: HTMLParagraphElement;
    #tapeButtons: {stop: HTMLButtonElement; play: HTMLButtonElement} | null = null;
    #tapeState: HTMLSpanElement | null = null;
    #sinceTapeCheck = 0;
    /** Only run while on screen: a lesson page may hold several of these. */
    #observer: IntersectionObserver | null = null;

    connectedCallback() {
      const system = this.dataset.system ?? '';
      this.#render();

      if (!SUPPORTED.has(system)) {
        this.#fail(`No browser emulator for "${system}" yet.`);
        return;
      }

      this.#observer = new IntersectionObserver((entries) => {
        const visible = entries.some((entry) => entry.isIntersecting);
        if (this.#runner) this.#runner.visible = visible;
      });
      this.#observer.observe(this);

      if (this.dataset.autoplay === 'true') void this.#start();
    }

    disconnectedCallback() {
      this.#runner?.stop();
      this.#observer?.disconnect();
    }

    #render() {
      const width = this.dataset.width ?? '704';
      const height = this.dataset.height ?? '592';

      this.#canvas = document.createElement('canvas');
      this.#canvas.className = 'emulator-screen';
      this.#canvas.style.width = `${width}px`;
      this.#canvas.style.height = `${height}px`;
      this.#canvas.tabIndex = 0;
      this.#canvas.setAttribute('aria-label', 'ZX Spectrum screen');

      const poster = this.dataset.poster;
      if (poster) {
        this.#poster = document.createElement('img');
        this.#poster.src = poster;
        this.#poster.alt = '';
        this.#poster.className = 'emulator-poster';
        this.#poster.style.width = `${width}px`;
        this.#poster.style.height = `${height}px`;
        this.append(this.#poster);
        // The canvas is empty until the machine runs; show the still instead.
        this.#canvas.hidden = true;
      }

      this.#status = document.createElement('p');
      this.#status.className = 'emulator-status';
      this.#status.textContent = 'Ready';

      this.append(this.#canvas);

      if (this.dataset.controls === 'true') {
        const bar = document.createElement('div');
        bar.className = 'emulator-controls';

        const run = document.createElement('button');
        run.type = 'button';
        run.textContent = 'Run';
        run.addEventListener('click', () => {
          const wanted = !(this.#runner?.wanted ?? false);
          run.textContent = wanted ? 'Stop' : 'Run';
          if (wanted) void this.#start();
          else if (this.#runner) this.#runner.wanted = false;
        });

        bar.append(run);
        if (/\.(tap|tzx)$/i.test(this.dataset.src ?? '')) bar.append(this.#tapeControls());
        bar.append(this.#status);
        this.append(bar);
      } else {
        this.append(this.#status);
      }

    }

    /**
     * Stop and Play for the tape, as on a cassette deck.
     *
     * A 48K owner stopped the tape to change a loader before the game came in:
     * `MERGE ""`, stop at `0 OK`, add a POKE, `RUN`, and play the rest. Stop
     * keeps the tape's place and Play resumes from it.
     */
    #tapeControls(): HTMLElement {
      const group = document.createElement('div');
      group.className = 'emulator-tape';
      group.setAttribute('role', 'group');
      group.setAttribute('aria-label', 'Tape');

      const stop = document.createElement('button');
      stop.type = 'button';
      stop.textContent = 'Stop tape';
      const play = document.createElement('button');
      play.type = 'button';
      play.textContent = 'Play tape';
      this.#tapeState = document.createElement('span');
      this.#tapeState.className = 'emulator-tape-state';

      this.#tapeButtons = {stop, play};
      stop.disabled = play.disabled = true;
      const press = (playing: boolean) => {
        try {
          this.#runner?.setTapePlaying(playing);
          this.#showTape();
        } catch (error) {
          this.#fail(String(error));
        }
      };
      stop.addEventListener('click', () => press(false));
      play.addEventListener('click', () => press(true));

      group.append(stop, play, this.#tapeState);
      return group;
    }

    /** Shows the tape's state, changing the text only when the state changes. */
    #showTape() {
      const runner = this.#runner;
      if (!runner || !this.#tapeButtons || !this.#tapeState) return;
      if (!runner.hasTapeControls) {
        this.#tapeButtons.stop.disabled = this.#tapeButtons.play.disabled = true;
        return;
      }
      const {loaded, playing, position} = runner.tapeState();
      const finished = position >= 1;
      this.#tapeButtons.stop.disabled = !loaded || !playing;
      this.#tapeButtons.play.disabled = !loaded || playing || finished;
      const text = !loaded ? '' : playing ? 'Tape playing'
        : finished ? 'Tape at the end'
        : `Tape stopped, ${Math.floor(position * 100)}% through`;
      if (this.#tapeState.textContent !== text) this.#tapeState.textContent = text;
    }

    #fail(message: string) {
      this.#status.textContent = message;
      this.#status.dataset.state = 'error';
    }

    async #start() {
      if (this.#runner) {
        this.#runner.wanted = true;
        return;
      }
      try {
        this.#status.textContent = 'Loading…';
        // The ROM is in the package: nothing is fetched for it.
        this.#runner = await SpectrumRunner.create(this.#canvas, (message) =>
          this.#fail(message),
        );

        const src = this.dataset.src;
        if (src) await this.#load(src);
        if (this.#tapeButtons) {
          // The tape stops by itself at the end; a few checks a second catch it.
          this.#runner.observeFrame(() => {
            if (++this.#sinceTapeCheck < 10) return;
            this.#sinceTapeCheck = 0;
            this.#showTape();
          });
          this.#showTape();
        }

        this.#poster?.remove();
        this.#canvas.hidden = false;
        this.#status.textContent = 'Running';
        this.#runner.visible = true;
        this.#runner.wanted = true;
      } catch (error) {
        this.#fail(`Could not start the emulator: ${error}`);
      }
    }

    async #load(src: string) {
      const response = await fetch(src);
      if (!response.ok) throw new Error(`${src} returned ${response.status}`);
      const bytes = new Uint8Array(await response.arrayBuffer());
      const extension = src.split('.').pop()?.toLowerCase() ?? '';

      if (extension === 'sna' || extension === 'z80') {
        this.#runner!.load(bytes, 'snapshot', extension);
      } else if (extension === 'tap' || extension === 'tzx') {
        this.#runner!.load(bytes, 'tape');
      } else {
        throw new Error(`unsupported program "${extension}"`);
      }
    }

  }

  if (!customElements.get('code198x-spectrum-player')) {
    customElements.define('code198x-spectrum-player', Emu198xPlayer);
  }
</script>

<style>
  .emulator-figure {
    margin: 1.5rem 0;
  }
  code198x-spectrum-player {
    display: block;
  }
  .emulator-poster {
    display: block;
    image-rendering: pixelated;
    border: 1px solid var(--color-border, #444);
    max-width: 100%;
  }
  .emulator-screen {
    display: block;
    /* The machine's pixels are the point; do not let the browser blur them. */
    image-rendering: pixelated;
    background: #000;
    border: 1px solid var(--color-border, #444);
    max-width: 100%;
  }
  .emulator-screen:focus-visible {
    outline: 2px solid var(--color-accent, #6cf);
    outline-offset: 2px;
  }
  .emulator-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .emulator-controls {
    flex-wrap: wrap;
  }
  .emulator-controls button {
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--h-ink, #1a1a1a);
    background: var(--h-ground, #f6f4ee);
    border: 1px solid var(--h-line, #444);
    border-radius: 0;
    cursor: pointer;
  }
  .emulator-controls button:hover:not(:disabled) {
    border-color: var(--h-ink, #1a1a1a);
  }
  .emulator-controls button:focus-visible {
    outline: 2px solid var(--color-accent, #6cf);
    outline-offset: 2px;
  }
  .emulator-controls button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .emulator-tape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .emulator-tape-state {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #555);
  }
  .emulator-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #555);
  }
  .emulator-status[data-state='error'] {
    color: var(--color-error, #c33);
  }
  .emulator-figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #555);
    text-align: center;
  }
</style>
