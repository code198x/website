---
import type { CollectionEntry } from 'astro:content';

export interface SearchFilter {
  id: string;
  label: string;
  type: 'select' | 'text' | 'multiselect' | 'range';
  options?: Array<{ value: string; label: string; icon?: string }>;
  placeholder?: string;
  defaultValue?: string;
  show?: boolean;
}

export interface Props {
  id?: string;
  variant?: 'full' | 'compact' | 'inline' | 'timeline';
  placeholder?: string;
  filters?: SearchFilter[];
  showButton?: boolean;
  buttonText?: string;
  showSuggestions?: boolean;
  maxSuggestions?: number;
  className?: string;
  ariaLabel?: string;
  // Data can be passed in or loaded via JavaScript
  data?: any[];
  dataUrl?: string;
  // Callbacks handled via custom events
  onSearch?: string; // Event name to dispatch
}

const {
  id = 'unified-search',
  variant = 'full',
  placeholder = 'Search...',
  filters = [],
  showButton = true,
  buttonText = 'Search',
  showSuggestions = true,
  maxSuggestions = 5,
  className = '',
  ariaLabel = 'Search',
  data = [],
  dataUrl,
  onSearch
} = Astro.props;

// Generate unique IDs for accessibility
const searchInputId = `${id}-input`;
const searchHelpId = `${id}-help`;
const searchResultsId = `${id}-results`;

// Default filters based on variant
const defaultFilters: SearchFilter[] = variant === 'timeline' ? [
  {
    id: 'category',
    label: 'Category',
    type: 'select',
    options: [{ value: 'all', label: 'All Categories' }],
    show: true
  },
  {
    id: 'decade',
    label: 'Decade',
    type: 'select',
    options: [
      { value: 'all', label: 'All Decades' },
      { value: '1970', label: '1970s' },
      { value: '1980', label: '1980s' },
      { value: '1990', label: '1990s' },
      { value: '2000', label: '2000s' }
    ],
    show: true
  }
] : variant === 'full' ? [
  {
    id: 'category',
    label: 'Category',
    type: 'select',
    options: [{ value: 'all', label: 'All Categories' }],
    show: true
  },
  {
    id: 'type',
    label: 'Type',
    type: 'select',
    options: [{ value: 'all', label: 'All Types' }],
    show: true
  },
  {
    id: 'tags',
    label: 'Tags',
    type: 'text',
    placeholder: 'Filter by tag...',
    show: true
  }
] : [];

// Merge default filters with custom filters
const activeFilters = filters.length > 0 ? filters : defaultFilters;

// Variant-specific classes
const variantClasses = {
  full: 'search--full',
  compact: 'search--compact',
  inline: 'search--inline',
  timeline: 'search--timeline'
};
---

<div
  class={`unified-search ${variantClasses[variant]} ${className}`}
  id={id}
  role="search"
  aria-label={ariaLabel}
  data-variant={variant}
  data-search-data={JSON.stringify(data)}
  data-search-url={dataUrl}
  data-search-event={onSearch}
>
  <!-- Search Input Area -->
  <div class="search__input-group">
    <label for={searchInputId} class="sr-only">{placeholder}</label>
    <div class="search__input-wrapper">
      <input
        type="search"
        id={searchInputId}
        class="search__input"
        placeholder={placeholder}
        autocomplete="off"
        aria-describedby={searchHelpId}
        aria-controls={showSuggestions ? searchResultsId : undefined}
        aria-autocomplete={showSuggestions ? "list" : undefined}
      />
      {showButton && (
        <button
          type="button"
          class="search__button btn btn--primary"
          aria-label={buttonText}
        >
          <span class="search__button-icon" aria-hidden="true">🔍</span>
          {variant !== 'compact' && <span class="search__button-text">{buttonText}</span>}
        </button>
      )}
    </div>
    <div id={searchHelpId} class="sr-only">
      {placeholder}. {activeFilters.length > 0 && 'Use filters below to refine your search.'}
    </div>

    {showSuggestions && (
      <div
        id={searchResultsId}
        class="search__suggestions"
        role="listbox"
        aria-label="Search suggestions"
        style="display: none;"
      >
        <!-- Populated by JavaScript -->
      </div>
    )}
  </div>

  <!-- Filters Area -->
  {activeFilters.length > 0 && activeFilters.some(f => f.show !== false) && (
    <div class="search__filters" role="group" aria-label="Search filters">
      {activeFilters.filter(f => f.show !== false).map(filter => (
        <div class="search__filter-group">
          <label for={`${id}-filter-${filter.id}`} class="search__filter-label">
            {filter.label}:
          </label>

          {filter.type === 'select' && (
            <select
              id={`${id}-filter-${filter.id}`}
              class="search__filter-select"
              data-filter={filter.id}
              aria-label={`Filter by ${filter.label}`}
            >
              {filter.options?.map(option => (
                <option value={option.value}>
                  {option.icon && `${option.icon} `}{option.label}
                </option>
              ))}
            </select>
          )}

          {filter.type === 'text' && (
            <input
              type="text"
              id={`${id}-filter-${filter.id}`}
              class="search__filter-input"
              placeholder={filter.placeholder}
              data-filter={filter.id}
              aria-label={`Filter by ${filter.label}`}
            />
          )}

          {filter.type === 'multiselect' && (
            <div
              id={`${id}-filter-${filter.id}`}
              class="search__filter-tags"
              data-filter={filter.id}
              role="group"
              aria-label={`Filter by ${filter.label}`}
            >
              {/* Populated by JavaScript */}
            </div>
          )}
        </div>
      ))}

      <button
        type="button"
        class="search__clear-filters btn btn--ghost btn--sm"
        aria-label="Clear all filters"
      >
        Clear Filters
      </button>
    </div>
  )}

  <!-- Results Count -->
  <div class="search__status" role="status" aria-live="polite" aria-atomic="true">
    <!-- Populated by JavaScript with result count -->
  </div>
</div>

<style>
  /* Base Styles */
  .unified-search {
    --search-gap: var(--space-md);
    --search-input-height: 48px;
    --search-border-radius: var(--border-radius-md);
  }

  /* Input Group */
  .search__input-group {
    position: relative;
  }

  .search__input-wrapper {
    display: flex;
    gap: var(--space-xs);
  }

  .search__input {
    flex: 1;
    height: var(--search-input-height);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-base);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--search-border-radius);
    transition: all 0.2s ease;
  }

  .search__input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.1);
  }

  .search__button {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    height: var(--search-input-height);
    padding: 0 var(--space-lg);
  }

  .search__button-icon {
    font-size: var(--font-size-lg);
  }

  /* Suggestions Dropdown */
  .search__suggestions {
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: 0;
    right: 0;
    max-height: 300px;
    overflow-y: auto;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--search-border-radius);
    box-shadow: var(--shadow-lg);
    z-index: 100;
  }

  .search__suggestion {
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .search__suggestion:hover,
  .search__suggestion[aria-selected="true"] {
    background: var(--color-background-secondary);
  }

  /* Filters */
  .search__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .search__filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .search__filter-label {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .search__filter-select,
  .search__filter-input {
    height: 36px;
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-sm);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
  }

  .search__filter-select {
    min-width: 150px;
  }

  .search__filter-input {
    width: 200px;
  }

  .search__filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .search__clear-filters {
    margin-left: auto;
  }

  /* Status */
  .search__status {
    margin-top: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  /* Variant: Compact */
  .search--compact {
    --search-input-height: 40px;
  }

  .search--compact .search__button {
    padding: 0 var(--space-md);
  }

  .search--compact .search__filters {
    gap: var(--space-sm);
  }

  /* Variant: Inline */
  .search--inline .search__input-wrapper {
    max-width: 400px;
  }

  .search--inline .search__filters {
    display: none;
  }

  /* Variant: Timeline */
  .search--timeline .search__filters {
    justify-content: space-between;
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .search__filters {
      flex-direction: column;
      align-items: stretch;
    }

    .search__filter-group {
      flex-direction: column;
      align-items: stretch;
    }

    .search__filter-select,
    .search__filter-input {
      width: 100%;
    }

    .search__clear-filters {
      margin-left: 0;
      margin-top: var(--space-sm);
    }
  }
</style>

<script>
  class UnifiedSearchElement extends HTMLElement {
    constructor() {
      super();

      this.searchInput = this.querySelector('.search__input') as HTMLInputElement;
      this.searchButton = this.querySelector('.search__button') as HTMLButtonElement;
      this.suggestions = this.querySelector('.search__suggestions') as HTMLElement;
      this.filters = this.querySelectorAll('[data-filter]');
      this.clearButton = this.querySelector('.search__clear-filters') as HTMLButtonElement;
      this.statusElement = this.querySelector('.search__status') as HTMLElement;

      this.data = [];
      this.filteredData = [];
      this.debounceTimer = null;
    }

    connectedCallback() {
      this.loadData();
      this.attachEventListeners();
    }

    async loadData() {
      const dataAttr = this.dataset.searchData;
      const urlAttr = this.dataset.searchUrl;

      if (dataAttr) {
        try {
          this.data = JSON.parse(dataAttr);
        } catch (e) {
          console.error('Failed to parse search data:', e);
        }
      } else if (urlAttr) {
        try {
          const response = await fetch(urlAttr);
          this.data = await response.json();
        } catch (e) {
          console.error('Failed to load search data:', e);
        }
      }

      this.updateFilterOptions();

      // Trigger initial search after data is loaded
      setTimeout(() => {
        this.handleSearch();
      }, 100);
    }

    attachEventListeners() {
      // Search input
      this.searchInput?.addEventListener('input', (e) => {
        clearTimeout(this.debounceTimer);
        this.debounceTimer = setTimeout(() => this.handleSearch(), 300);

        if (this.suggestions) {
          this.updateSuggestions((e.target as HTMLInputElement).value);
        }
      });

      // Search button
      this.searchButton?.addEventListener('click', () => this.handleSearch());

      // Filters
      this.filters.forEach(filter => {
        if (filter instanceof HTMLInputElement) {
          // For text inputs, listen to input event for real-time updates
          filter.addEventListener('input', () => {
            clearTimeout(this.debounceTimer);
            this.debounceTimer = setTimeout(() => this.handleSearch(), 300);
          });
        } else {
          // For selects, listen to change event
          filter.addEventListener('change', () => this.handleSearch());
        }
      });

      // Clear filters
      this.clearButton?.addEventListener('click', () => this.clearFilters());

      // Keyboard navigation for suggestions
      this.searchInput?.addEventListener('keydown', (e) => this.handleSuggestionNavigation(e));
    }

    updateFilterOptions() {
      // Dynamically populate filter options based on data
      // This would analyze the data and update select options
      // Implementation depends on data structure
    }

    handleSearch() {
      const query = this.searchInput?.value || '';
      const filters = this.getActiveFilters();

      // Filter data
      this.filteredData = this.filterData(this.data, query, filters);

      // Update status
      this.updateStatus(this.filteredData.length);

      // Dispatch custom event - dispatch to document so it can be caught by listeners
      const eventName = this.dataset.searchEvent || 'search';
      const event = new CustomEvent(eventName, {
        detail: {
          query,
          filters,
          results: this.filteredData
        },
        bubbles: true
      });

      // Dispatch to both the element and document for compatibility
      this.dispatchEvent(event);
      document.dispatchEvent(new CustomEvent(eventName, {
        detail: {
          query,
          filters,
          results: this.filteredData
        }
      }));
    }

    filterData(data: any[], query: string, filters: Record<string, string>) {
      return data.filter(item => {
        // Text search
        if (query) {
          // Handle both full field names and abbreviated field names
          const searchFields = [
            ['name', 'n'],       // name
            ['title', 'n'],      // title (also maps to n)
            ['description', 'd'], // description
            ['tags', 'g']        // tags
          ];
          const matches = searchFields.some(([fullField, shortField]) => {
            const value = item[fullField] || item[shortField];
            if (typeof value === 'string') {
              return value.toLowerCase().includes(query.toLowerCase());
            }
            if (Array.isArray(value)) {
              return value.some(v => v.toLowerCase().includes(query.toLowerCase()));
            }
            return false;
          });
          if (!matches) return false;
        }

        // Apply filters - handle both full and abbreviated field names
        for (const [key, value] of Object.entries(filters)) {
          if (value && value !== 'all' && value !== '') {
            // Map filter keys to data fields
            const fieldMapping: Record<string, string> = {
              'category': 'c',
              'type': 't',
              'tags': 'g',
              'year': 'y',
              'status': 'st'
            };

            const dataField = fieldMapping[key] || key;

            // Special handling for tags filter
            if (key === 'tags' && value) {
              const itemTags = item[dataField] || item.g || [];
              if (!Array.isArray(itemTags)) return false;
              // Check if any tag contains the filter value (case-insensitive)
              const hasTag = itemTags.some((tag: string) =>
                tag.toLowerCase().includes(value.toLowerCase())
              );
              if (!hasTag) return false;
            }
            // Special handling for year filter (decade matching)
            else if (key === 'year' && value.endsWith('s')) {
              const decade = parseInt(value);
              const itemYear = item[dataField] || item.y;
              if (!itemYear) return false;
              const itemDecade = Math.floor(itemYear / 10) * 10;
              if (itemDecade !== decade) return false;
            }
            // Standard field matching
            else if (item[dataField] !== value) {
              return false;
            }
          }
        }

        return true;
      });
    }

    getActiveFilters(): Record<string, string> {
      const filters: Record<string, string> = {};
      this.filters.forEach(filter => {
        const key = filter.dataset.filter;
        const value = (filter as HTMLInputElement | HTMLSelectElement).value;
        if (key && value) {
          filters[key] = value;
        }
      });
      return filters;
    }

    updateSuggestions(query: string) {
      if (!this.suggestions) return;

      if (query.length < 2) {
        this.suggestions.style.display = 'none';
        return;
      }

      const matches = this.filterData(this.data, query, {}).slice(0, 5);

      if (matches.length > 0) {
        this.suggestions.innerHTML = matches.map((item, index) => `
          <div class="search__suggestion"
               role="option"
               aria-selected="${index === 0}"
               data-value="${item.name || item.title}">
            <strong>${item.name || item.title}</strong>
            ${item.description ? `<br><small>${item.description.substring(0, 60)}...</small>` : ''}
          </div>
        `).join('');
        this.suggestions.style.display = 'block';

        // Add click handlers
        this.suggestions.querySelectorAll('.search__suggestion').forEach(suggestion => {
          suggestion.addEventListener('click', () => {
            this.searchInput.value = suggestion.dataset.value || '';
            this.suggestions.style.display = 'none';
            this.handleSearch();
          });
        });
      } else {
        this.suggestions.style.display = 'none';
      }
    }

    handleSuggestionNavigation(e: KeyboardEvent) {
      if (!this.suggestions || this.suggestions.style.display === 'none') return;

      const suggestions = this.suggestions.querySelectorAll('.search__suggestion');
      const current = this.suggestions.querySelector('[aria-selected="true"]');
      let index = Array.from(suggestions).indexOf(current);

      switch(e.key) {
        case 'ArrowDown':
          e.preventDefault();
          index = Math.min(index + 1, suggestions.length - 1);
          break;
        case 'ArrowUp':
          e.preventDefault();
          index = Math.max(index - 1, 0);
          break;
        case 'Enter':
          if (current) {
            e.preventDefault();
            (current as HTMLElement).click();
          }
          break;
        case 'Escape':
          this.suggestions.style.display = 'none';
          break;
        default:
          return;
      }

      // Update aria-selected
      suggestions.forEach((s, i) => {
        s.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    }

    clearFilters() {
      this.filters.forEach(filter => {
        if (filter instanceof HTMLSelectElement) {
          filter.selectedIndex = 0;
        } else if (filter instanceof HTMLInputElement) {
          filter.value = '';
        }
      });
      this.handleSearch();
    }

    updateStatus(count: number) {
      if (this.statusElement) {
        if (count === 0) {
          this.statusElement.textContent = 'No results found';
        } else if (count === 1) {
          this.statusElement.textContent = '1 result found';
        } else {
          this.statusElement.textContent = `${count} results found`;
        }
      }
    }
  }

  // Register custom element
  if (!customElements.get('unified-search')) {
    customElements.define('unified-search', UnifiedSearchElement);
  }
</script>