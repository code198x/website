---
export interface Props {
  name:
    | "search"
    | "sun"
    | "moon"
    | "github"
    | "discord"
    | "menu"
    | "close"
    | "chevron-right"
    | "chevron-left"
    | "chevron-down"
    | "arrow-right"
    | "external-link"
    | "check"
    | "x"
    | "info"
    | "warning"
    | "error";
  size?: number | string;
  class?: string;
  strokeWidth?: number;
  "aria-label"?: string;
  "aria-hidden"?: boolean;
}

const {
  name,
  size = 20,
  class: className = "",
  strokeWidth = 2,
  "aria-label": ariaLabel,
  "aria-hidden": ariaHidden = !ariaLabel,
} = Astro.props;

// Icon path definitions
const icons = {
