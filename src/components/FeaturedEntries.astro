---

interface Props {
  title: string;
  subtitle?: string;
  entries: any[];
  maxEntries?: number;
  showMoreLink?: string;
  className?: string;
}

const {
  title,
  subtitle,
  entries,
  maxEntries = 6,
  showMoreLink,
  className = ""
} = Astro.props;

// Category information for display
const categoryInfo: Record<string, { label: string; icon: string; color: string }> = {
  companies: { label: 'Company', icon: '🏢', color: '#3b82f6' },
  hardware: { label: 'Hardware', icon: '🖥️', color: '#6366f1' },
  games: { label: 'Game', icon: '🎮', color: '#f59e0b' },
  groups: { label: 'Group', icon: '👥', color: '#ec4899' },
  people: { label: 'Person', icon: '👤', color: '#10b981' },
  techniques: { label: 'Technique', icon: '⚡', color: '#14b8a6' },
  applications: { label: 'Application', icon: '🎨', color: '#8b5cf6' },
  emulators: { label: 'Emulator', icon: '💾', color: '#8b5cf6' },
  culture: { label: 'Culture', icon: '🌐', color: '#a855f7' },
  events: { label: 'Event', icon: '🎪', color: '#f97316' },
  formats: { label: 'Format', icon: '💾', color: '#84cc16' },
  publications: { label: 'Publication', icon: '📚', color: '#ef4444' }
};

// Limit entries and add category info
const displayEntries = entries.slice(0, maxEntries).map(entry => ({
  ...entry,
  category: categoryInfo[entry.c] || { label: 'Entry', icon: '📄', color: '#6b7280' }
}));
---

{displayEntries.length > 0 && (
  <section class={`featured-entries ${className}`}>
    <div class="container">
      <div class="featured-entries__header">
        <h2 class="featured-entries__title">{title}</h2>
        {subtitle && <p class="featured-entries__subtitle">{subtitle}</p>}
      </div>

      <div class="featured-entries__grid">
        {displayEntries.map((entry) => (
          <a href={`/vault/${entry.c}/${entry.s}`} class="featured-entry-card">
            <div class="featured-entry-card__header">
              <span
                class="featured-entry-card__icon"
                style={`color: ${entry.category.color}`}
              >
                {entry.category.icon}
              </span>
              <span class="featured-entry-card__category">
                {entry.category.label}
              </span>
              {entry.y && (
                <span class="featured-entry-card__year">{entry.y}</span>
              )}
            </div>

            <h3 class="featured-entry-card__title">{entry.n}</h3>

            {entry.d && (
              <p class="featured-entry-card__description">{entry.d}</p>
            )}

            {entry.g && entry.g.length > 0 && (
              <div class="featured-entry-card__tags">
                {entry.g.slice(0, 2).map((tag: string) => (
                  <span class="featured-entry-card__tag">{tag}</span>
                ))}
                {entry.g.length > 2 && (
                  <span class="featured-entry-card__tag featured-entry-card__tag--more">
                    +{entry.g.length - 2}
                  </span>
                )}
              </div>
            )}
          </a>
        ))}
      </div>

      {showMoreLink && (
        <div class="featured-entries__more">
          <a href={showMoreLink} class="featured-entries__more-link">
            View all entries →
          </a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .featured-entries {
    padding: var(--space-xl) 0;
    background: linear-gradient(135deg, var(--color-background) 0%, var(--color-background-secondary) 100%);
    border-top: 1px solid var(--color-border);
  }

  .featured-entries__header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .featured-entries__title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .featured-entries__title::before {
    content: "⭐";
    font-size: var(--font-size-xl);
  }

  .featured-entries__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .featured-entries__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .featured-entry-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    display: block;
    position: relative;
    overflow: hidden;
  }

  .featured-entry-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .featured-entry-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-color: var(--color-primary);
  }

  .featured-entry-card:hover::before {
    transform: scaleX(1);
  }

  .featured-entry-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .featured-entry-card__icon {
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  .featured-entry-card__category {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .featured-entry-card__year {
    margin-left: auto;
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    background: var(--color-background-secondary);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--border-radius-sm);
  }

  .featured-entry-card__title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    line-height: 1.2;
  }

  .featured-entry-card__description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-entry-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .featured-entry-card__tag {
    font-size: var(--font-size-xs);
    background: var(--color-background-tertiary);
    color: var(--color-text-secondary);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-border);
    font-weight: 500;
  }

  .featured-entry-card__tag--more {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .featured-entries__more {
    text-align: center;
  }

  .featured-entries__more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    padding: var(--space-md) var(--space-lg);
    border: 2px solid var(--color-primary);
    border-radius: var(--border-radius-lg);
    transition: all 0.2s ease;
  }

  .featured-entries__more-link:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .featured-entries {
      padding: var(--space-lg) 0;
    }

    .featured-entries__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .featured-entry-card {
      padding: var(--space-md);
    }

    .featured-entries__title {
      font-size: var(--font-size-xl);
    }

    .featured-entry-card__title {
      font-size: var(--font-size-lg);
    }
  }
</style>