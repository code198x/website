---
import VaultEntryCard from "./VaultEntryCard.astro";

interface Props {
  title: string;
  subtitle?: string;
  entries: any[];
  maxEntries?: number;
  showMoreLink?: string;
  className?: string;
}

const { title, subtitle, entries, maxEntries = 6, showMoreLink, className = "" } = Astro.props;

// Using centralized category information

// Limit entries for display
const displayEntries = entries.slice(0, maxEntries);
---

{
  displayEntries.length > 0 && (
    <section class={`featured-entries ${className}`}>
      <div class="container">
        <div class="featured-entries__header">
          <h2 class="featured-entries__title">{title}</h2>
          {subtitle && <p class="featured-entries__subtitle">{subtitle}</p>}
        </div>

        <div class="featured-entries__grid">
          {displayEntries.map((entry) => (
            <VaultEntryCard entry={entry} variant="featured" maxTags={2} showYear={true} />
          ))}
        </div>

        {showMoreLink && (
          <div class="featured-entries__more">
            <a href={showMoreLink} class="featured-entries__more-link">
              View all entries →
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .featured-entries {
    padding: var(--space-xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      var(--color-background-secondary) 100%
    );
    border-top: 1px solid var(--color-border);
  }

  .featured-entries__header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .featured-entries__title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .featured-entries__title::before {
    content: "⭐";
    font-size: var(--font-size-xl);
  }

  .featured-entries__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .featured-entries__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  /* Featured entry card styles are now handled in VaultEntryCard.astro */

  .featured-entries__more {
    text-align: center;
  }

  .featured-entries__more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    padding: var(--space-md) var(--space-lg);
    border: 2px solid var(--color-primary);
    border-radius: var(--border-radius-lg);
    transition: all 0.2s ease;
  }

  .featured-entries__more-link:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .featured-entries {
      padding: var(--space-lg) 0;
    }

    .featured-entries__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .featured-entry-card {
      padding: var(--space-md);
    }

    .featured-entries__title {
      font-size: var(--font-size-xl);
    }

    .featured-entry-card__title {
      font-size: var(--font-size-lg);
    }
  }
</style>
