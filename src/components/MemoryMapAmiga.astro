---
export interface Props {
  title?: string;
  highlightRegion?: string;
  showAddresses?: boolean;
  activeAddress?: string;
  amigaModel?: "500" | "1200";
}

const { 
  title = "Commodore Amiga Memory Map",
  highlightRegion = "",
  showAddresses = true,
  activeAddress = "",
  amigaModel = "500"
} = Astro.props;

interface MemoryRegion {
  start: string;
  end: string;
  name: string;
  description: string;
  color: string;
  textColor: string;
  usage: string;
  model?: string;
}

const memoryRegions: MemoryRegion[] = [
  {
    start: "$000000",
    end: "$07FFFF", 
    name: "Chip RAM",
    description: "Fast RAM accessible by custom chips (512KB)",
    color: "bg-green-600",
    textColor: "text-green-100",
    usage: "Graphics, sound, programs"
  },
  {
    start: "$080000",
    end: "$0FFFFF",
    name: "Extended Chip",
    description: "Additional chip RAM on expanded systems (512KB)",
    color: "bg-green-500",
    textColor: "text-green-100", 
    usage: "More chip RAM (A500+)"
  },
  {
    start: "$100000",
    end: "$1FFFFF",
    name: "Autoconfig",
    description: "Expansion board configuration space",
    color: "bg-purple-600",
    textColor: "text-purple-100",
    usage: "Board detection"
  },
  {
    start: "$200000",
    end: "$9FFFFF",
    name: "Fast RAM",
    description: "CPU-only RAM for programs (8MB max)",
    color: "bg-blue-600",
    textColor: "text-blue-100",
    usage: "Program code & data"
  },
  {
    start: "$A00000",
    end: "$BFFFFF",
    name: "CIA/Clock",
    description: "Complex Interface Adapters and real-time clock",
    color: "bg-orange-700",
    textColor: "text-orange-50",
    usage: "I/O control"
  },
  {
    start: "$C00000",
    end: "$DFFFFF",
    name: "Custom Chips",
    description: "Paula, Agnus, Denise graphics/sound registers",
    color: "bg-red-700",
    textColor: "text-red-50",
    usage: "Hardware control"
  },
  {
    start: "$E00000",
    end: "$E7FFFF",
    name: "Reserved",
    description: "Reserved for future expansion",
    color: "bg-slate-600",
    textColor: "text-slate-300",
    usage: "Future use"
  },
  {
    start: "$E80000",
    end: "$EFFFFF",
    name: "Autoconfig", 
    description: "Additional expansion space",
    color: "bg-purple-500",
    textColor: "text-purple-100",
    usage: "More expansions"
  },
  {
    start: "$F00000",
    end: "$F7FFFF",
    name: "Slow RAM",
    description: "Expansion RAM with wait states",
    color: "bg-yellow-700",
    textColor: "text-yellow-50",
    usage: "Cheaper RAM"
  },
  {
    start: "$F80000",
    end: "$FFFFFF",
    name: "Kickstart ROM",
    description: "Operating system ROM (512KB)",
    color: "bg-red-800",
    textColor: "text-red-50",
    usage: "AmigaOS kernel"
  }
];

function isHighlighted(region: MemoryRegion): boolean {
  if (!highlightRegion) return false;
  return region.name.toLowerCase().includes(highlightRegion.toLowerCase()) ||
         region.description.toLowerCase().includes(highlightRegion.toLowerCase());
}

function isActiveAddress(region: MemoryRegion): boolean {
  if (!activeAddress) return false;
  const addr = parseInt(activeAddress.replace('$', ''), 16);
  const start = parseInt(region.start.replace('$', ''), 16);
  const end = parseInt(region.end.replace('$', ''), 16);
  return addr >= start && addr <= end;
}

function calculateHeight(region: MemoryRegion): string {
  const start = parseInt(region.start.replace('$', ''), 16);
  const end = parseInt(region.end.replace('$', ''), 16);
  const size = end - start + 1;
  
  // Scale for 16MB address space
  if (size >= 0x800000) return "25%";     // 8MB+
  if (size >= 0x200000) return "20%";     // 2MB+  
  if (size >= 0x100000) return "15%";     // 1MB+
  if (size >= 0x80000) return "12%";      // 512KB
  if (size >= 0x20000) return "8%";       // 128KB+
  return "6%";                            // Smaller
}
---

<div class="bg-slate-900 rounded-lg p-6 border border-slate-700">
  <div class="flex justify-between items-center mb-4">
    <h3 class="memory-map-title text-lg font-bold text-green-400">{title}</h3>
    <div class="flex gap-2">
      <span class={`px-2 py-1 rounded text-xs font-mono ${amigaModel === "500" ? "bg-red-600 text-white" : "bg-slate-600 text-slate-300"}`}>
        A500
      </span>
      <span class={`px-2 py-1 rounded text-xs font-mono ${amigaModel === "1200" ? "bg-red-600 text-white" : "bg-slate-600 text-slate-300"}`}>
        A1200
      </span>
    </div>
  </div>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Memory Map Visualization -->
    <div class="bg-black rounded-lg p-4">
      <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">16MB Address Space</h4>
      <div class="space-y-1">
        {memoryRegions.map((region) => (
          <div 
            class={`
              ${region.color} ${region.textColor} 
              rounded p-2 border-2 transition-all duration-300
              ${isHighlighted(region) ? 'border-yellow-400 ring-2 ring-yellow-400' : 'border-transparent'}
              ${isActiveAddress(region) ? 'border-red-400 ring-2 ring-red-400' : ''}
            `}
            style={`height: ${calculateHeight(region)}`}
          >
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="font-bold">{region.name}</span>
              {showAddresses && (
                <span>{region.start}-{region.end}</span>
              )}
            </div>
            <div class="text-xs opacity-75 mt-1">{region.description}</div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Memory Details -->
    <div class="space-y-4">
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Memory Overview</h4>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-400">Address Space:</span>
            <span class="text-white font-mono">16MB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Chip RAM:</span>
            <span class="text-white font-mono">512KB-2MB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Fast RAM:</span>
            <span class="text-white font-mono">0-8MB</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Kickstart ROM:</span>
            <span class="text-white font-mono">512KB</span>
          </div>
        </div>
      </div>
      
      <!-- Custom Chips -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Custom Chip Registers</h4>
        <div class="space-y-1 text-xs font-mono">
          <div class="flex justify-between">
            <span class="text-red-300">$DFF000:</span>
            <span class="text-red-100">Paula (audio/disk)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-300">$DFF080:</span>
            <span class="text-red-100">Agnus (DMA/blitter)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-300">$DFF100:</span>
            <span class="text-red-100">Denise (graphics)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-orange-300">$BFE001:</span>
            <span class="text-orange-100">CIA-A (ports/timer)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-orange-300">$BFD000:</span>
            <span class="text-orange-100">CIA-B (disk/serial)</span>
          </div>
        </div>
      </div>
      
      <!-- Important Addresses -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Key Memory Areas</h4>
        <div class="space-y-1 text-xs font-mono">
          <div class="flex justify-between">
            <span class="text-green-300">$000004:</span>
            <span class="text-green-100">ExecBase pointer</span>
          </div>
          <div class="flex justify-between">
            <span class="text-green-300">$000100:</span>
            <span class="text-green-100">Exception vectors</span>
          </div>
          <div class="flex justify-between">
            <span class="text-blue-300">$020000:</span>
            <span class="text-blue-100">Graphics bitmaps</span>
          </div>
          <div class="flex justify-between">
            <span class="text-red-300">$FC0000:</span>
            <span class="text-red-100">ROM entry point</span>
          </div>
        </div>
      </div>
      
      <!-- Memory Types -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Memory Types</h4>
        <div class="space-y-2 text-xs">
          <div class="text-green-200">
            <strong>Chip RAM:</strong> Shared with custom chips
          </div>
          <div class="text-blue-200">
            <strong>Fast RAM:</strong> CPU-only, faster access
          </div>
          <div class="text-yellow-200">
            <strong>Slow RAM:</strong> 16-bit with wait states
          </div>
          <div class="text-purple-200">
            <strong>Autoconfig:</strong> Automatic board detection
          </div>
        </div>
      </div>
      
      <!-- Programming Tips -->
      <div class="bg-slate-800 rounded-lg p-4">
        <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Programming Notes</h4>
        <div class="space-y-2 text-xs">
          <div class="text-green-200">
            <strong>Graphics:</strong> Must use Chip RAM
          </div>
          <div class="text-blue-200">
            <strong>Code:</strong> Can run from Fast RAM
          </div>
          <div class="text-red-200">
            <strong>AmigaOS:</strong> Library-based system
          </div>
          <div class="text-orange-200">
            <strong>Multitasking:</strong> Preemptive OS
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Advanced Memory Management -->
  <div class="mt-6 pt-4 border-t border-slate-700">
    <h4 class="memory-map-subtitle text-sm font-bold text-slate-300 mb-3">Advanced Features</h4>
    <div class="bg-black rounded-lg p-4 text-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-green-400 mb-2">Memory Management:</div>
          <div class="space-y-1 text-slate-300">
            <div>• Virtual memory support</div>
            <div>• Memory protection (68020+)</div>
            <div>• Automatic chip/fast allocation</div>
            <div>• Memory fragmentation handling</div>
          </div>
        </div>
        <div>
          <div class="text-green-400 mb-2">DMA Channels:</div>
          <div class="space-y-1 text-slate-300">
            <div>• Blitter (graphics operations)</div>
            <div>• Audio (4 channel DMA)</div>
            <div>• Disk (floppy controller)</div>
            <div>• Sprite (hardware sprites)</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .memory-region {
    transition: all 0.3s ease;
  }
  
  .memory-region:hover {
    transform: scale(1.02);
    z-index: 10;
  }

  /* Override lesson content heading styles */
  .memory-map-title {
    color: rgb(74 222 128) !important; /* text-green-400 */
    font-size: 1.125rem !important; /* text-lg */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 1rem !important; /* mb-4 */
  }

  .memory-map-subtitle {
    color: rgb(209 213 219) !important; /* text-slate-300 */
    font-size: 0.875rem !important; /* text-sm */
    font-weight: 700 !important; /* font-bold */
    margin-bottom: 0.75rem !important; /* mb-3 */
  }

  /* Override strong text in memory map content */
  .bg-slate-800 strong,
  .bg-black strong {
    color: rgb(255 255 255) !important; /* text-white */
    font-weight: 700 !important;
  }
</style>