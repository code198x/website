{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AMOS Professional",
  "scopeName": "source.basic.amos",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#procedures"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#graphics"
    },
    {
      "include": "#audio"
    },
    {
      "include": "#input"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.amos",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.amos",
          "match": "\\b(Rem)\\b.*$",
          "captures": {
            "1": {
              "name": "keyword.control.amos"
            }
          }
        }
      ]
    },
    "procedures": {
      "patterns": [
        {
          "name": "entity.name.function.amos",
          "match": "\\b(Procedure|End Proc)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.amos",
          "match": "\\b(If|Then|Else|End If|For|To|Step|Next|Do|Loop|Until|While|Wend|Repeat|Until|Exit|Goto|Gosub|Return|On|Select|Case|Default|End Select)\\b"
        },
        {
          "name": "keyword.other.amos",
          "match": "\\b(Print|Input|Read|Data|Restore|Dim|Let|Add|Dec|Inc|Cls|Locate|Wait|End|Stop|Curs Off|Curs On|Flash Off|Flash On)\\b"
        }
      ]
    },
    "graphics": {
      "patterns": [
        {
          "name": "support.function.graphics.amos",
          "match": "\\b(Screen Open|Screen Close|Screen|Colour|Ink|Paper|Pen|Plot|Draw|Line|Box|Bar|Circle|Ellipse|Polyline|Polygon|Paint|Get Bob|Paste Bob|Bob|Bob Off|Bob On|Bob Update|Bob X|Bob Y|Col|Sprite|Get Block|Put Block|Scroll|Gr Writing|Cls)\\b"
        }
      ]
    },
    "audio": {
      "patterns": [
        {
          "name": "support.function.audio.amos",
          "match": "\\b(Sam Play|Sam Stop|Sam Bank|Vol|Music|Music Bank|Music Stop|Tempo|Boom|Bell|Shoot|Explode|Noise|Play|Sound|Wave)\\b"
        }
      ]
    },
    "input": {
      "patterns": [
        {
          "name": "support.function.input.amos",
          "match": "\\b(Inkey\\$|Scancode|Key State|Jleft|Jright|Jup|Jdown|Fire|Joy|Joykey|Mouse Click|X Mouse|Y Mouse|Mouse Key|Mouse Zone)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.amos",
          "match": "\\b(Abs|Asc|Atn|Chr\\$|Cos|Exp|Int|Instr|Left\\$|Len|Log|Mid\\$|Right\\$|Rnd|Sgn|Sin|Space\\$|Sqr|Str\\$|String\\$|Tan|Val|Upper\\$|Lower\\$|Bin\\$|Hex\\$|Timer|Peek|Deek|Leek|Varptr|Free|Chip Free)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.amos",
          "match": "[+\\-*/^]"
        },
        {
          "name": "keyword.operator.comparison.amos",
          "match": "(<>|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.logical.amos",
          "match": "\\b(And|Or|Not|Xor)\\b"
        },
        {
          "name": "keyword.operator.assignment.amos",
          "match": "="
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.amos",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.amos",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.amos",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.amos",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.float.amos",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.amos",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.string.amos",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$"
        },
        {
          "name": "variable.other.integer.amos",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*%"
        },
        {
          "name": "variable.other.amos",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
