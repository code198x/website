{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ca65 Assembly",
  "scopeName": "source.asm.ca65",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#opcodes"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#registers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.ca65",
          "match": ";.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.ca65",
          "match": "\\.(segment|proc|endproc|byte|word|addr|res|include|import|export|importzp|exportzp|zeropage|code|data|rodata|bss|define|ifdef|ifndef|else|endif|macro|endmacro|repeat|endrep|scope|endscope|struct|endstruct|union|endunion|enum|endenum|tag|out|assert|warning|error|fatal|feature|list|listbytes|org|reloc|setcpu|case|constructor|destructor|condes|fileopt|global|globalzp|local|localchar)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.ca65",
          "match": "^[a-zA-Z_][a-zA-Z0-9_]*:"
        },
        {
          "name": "entity.name.label.ca65",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*:"
        }
      ]
    },
    "opcodes": {
      "patterns": [
        {
          "name": "keyword.mnemonic.ca65",
          "match": "\\b(ADC|AND|ASL|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRK|BVC|BVS|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JMP|JSR|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PLA|PLP|ROL|ROR|RTI|RTS|SBC|SEC|SED|SEI|STA|STX|STY|TAX|TAY|TSX|TXA|TXS|TYA)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ca65",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.ca65",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.decimal.ca65",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ca65",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ca65",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.ca65",
          "match": "\\b[AXY]\\b"
        }
      ]
    }
  }
}
