{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Blitz BASIC 2",
  "scopeName": "source.basic.blitz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#procedures" },
    { "include": "#keywords" },
    { "include": "#graphics" },
    { "include": "#audio" },
    { "include": "#input" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.blitz",
          "match": ";.*$"
        }
      ]
    },
    "procedures": {
      "patterns": [
        {
          "name": "entity.name.function.blitz",
          "match": "\\b(Statement|Function|End Statement|End Function)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.blitz",
          "match": "\\b(If|Then|Else|EndIf|End If|For|To|Step|Next|While|Wend|Repeat|Until|Forever|Select|Case|Default|End Select|Gosub|Goto|Return|Exit|Pop|WBStartup)\\b"
        },
        {
          "name": "keyword.other.blitz",
          "match": "\\b(Print|NPrint|Input|Read|Data|Restore|Dim|Let|Cls|Locate|VWait|MouseWait|Wait|End|Stop|Edit\\$)\\b"
        }
      ]
    },
    "graphics": {
      "patterns": [
        {
          "name": "support.function.graphics.blitz",
          "match": "\\b(Blitz|AMIGA|QAMIGA|Screen|Screens|Window|Use|Show|ShowBlitz|Slice|BitMap|LoadBitMap|GetaShape|LoadShape|Shape|Shapes|Blit|QBlit|BBlit|Block|Boxf|Box|Line|Plot|Circle|Disk|Bob|Bobs|Sprite|Sprites|Queue|UnQueue|Buffer|DoubleBuffer|Flip|CreateDisplay|DisplayBitMap|Palette|RGB|MidHandle|Handle|Colour|Color)\\b"
        }
      ]
    },
    "audio": {
      "patterns": [
        {
          "name": "support.function.audio.blitz",
          "match": "\\b(Sound|LoadSound|Sample|VolumeControl|Beep)\\b"
        }
      ]
    },
    "input": {
      "patterns": [
        {
          "name": "support.function.input.blitz",
          "match": "\\b(Joyb|Joyx|Joyy|Joystick|Joyr|MouseX|MouseY|MouseXSpeed|MouseYSpeed|Inkey\\$|RawStatus)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.blitz",
          "match": "\\b(Abs|Asc|Atan|Cos|Exp|Int|Len|Log|Mid\\$|Left\\$|Right\\$|Rnd|Sgn|Sin|Sqr|Str\\$|Tan|Val|Hex\\$|Chr\\$|Peek|Poke|PeekL|PokeL|PeekW|PokeW)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.blitz",
          "match": "[+\\-*/^]"
        },
        {
          "name": "keyword.operator.comparison.blitz",
          "match": "(<>|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.logical.blitz",
          "match": "\\b(AND|OR|NOT|XOR|And|Or|Not|Xor)\\b"
        },
        {
          "name": "keyword.operator.assignment.blitz",
          "match": "="
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.blitz",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.blitz",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.blitz",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.blitz",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.float.blitz",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.blitz",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.string.blitz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$"
        },
        {
          "name": "variable.other.blitz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
