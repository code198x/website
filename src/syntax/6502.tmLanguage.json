{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "6502 Assembly",
  "scopeName": "source.asm.6502",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#opcodes"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.6502",
          "match": ";.*$"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.6502",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*):"
        },
        {
          "name": "entity.name.label.local.6502",
          "match": "^\\s*(\\.[a-zA-Z_][a-zA-Z0-9_]*):"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.6502",
          "match": "(?i)\\b(\\*=|!byte|!word|!text|!pet|!scr|!fill|!align|!zone|!source|!binary|!convtab|!cpu|!to|!ifdef|!ifndef|!if|!else|!endif|!macro|!endoffile)\\b"
        },
        {
          "name": "keyword.control.directive.ca65.6502",
          "match": "(?i)\\b(\\.org|\\.byte|\\.word|\\.dbyte|\\.addr|\\.asciiz|\\.res|\\.include|\\.import|\\.export|\\.segment|\\.proc|\\.endproc|\\.macro|\\.endmacro|\\.ifdef|\\.ifndef|\\.if|\\.else|\\.endif)\\b"
        }
      ]
    },
    "opcodes": {
      "patterns": [
        {
          "name": "keyword.mnemonic.6502",
          "match": "(?i)\\b(adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|tax|tay|tsx|txa|txs|tya)\\b"
        },
        {
          "name": "keyword.mnemonic.illegal.6502",
          "match": "(?i)\\b(slo|rla|sre|rra|sax|lax|dcp|isc|anc|alr|arr|xaa|axs|ahx|shy|shx|tas|las)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.6502",
          "match": "(?i)\\b(a|x|y)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.6502",
          "match": "\\$[0-9a-fA-F]+"
        },
        {
          "name": "constant.numeric.hex.prefix.6502",
          "match": "0x[0-9a-fA-F]+"
        },
        {
          "name": "constant.numeric.binary.6502",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.decimal.6502",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.6502",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.6502",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.6502",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.6502",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.addressing.6502",
          "match": "#|,|\\(|\\)|\\[|\\]"
        },
        {
          "name": "keyword.operator.arithmetic.6502",
          "match": "\\+|-|\\*|/|<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.comparison.6502",
          "match": "<|>|="
        }
      ]
    }
  }
}
