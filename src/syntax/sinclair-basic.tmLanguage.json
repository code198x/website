{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sinclair BASIC",
  "scopeName": "source.basic.sinclair",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#line-numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.rem.sinclair",
          "match": "\\b(REM)\\b.*$",
          "captures": {
            "1": {
              "name": "keyword.control.sinclair"
            }
          }
        }
      ]
    },
    "line-numbers": {
      "patterns": [
        {
          "name": "constant.numeric.line-number.sinclair",
          "match": "^\\s*\\d+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sinclair",
          "match": "\\b(IF|THEN|ELSE|FOR|TO|STEP|NEXT|GO TO|GOSUB|RETURN|ON|GO SUB|DIM|DATA|READ|RESTORE|STOP|END|RUN|LIST|NEW|CLEAR|INPUT|PRINT|LET|RANDOMIZE|CONTINUE|PAUSE|POKE|OUT|LOAD|SAVE|VERIFY|MERGE|BEEP|BORDER|PAPER|INK|FLASH|BRIGHT|INVERSE|OVER|AT|TAB|CLS|PLOT|DRAW|CIRCLE|DEF FN|CAT|FORMAT|MOVE|ERASE|OPEN|CLOSE|COPY)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.sinclair",
          "match": "\\b(ABS|ACS|AND|ASN|ATN|ATTR|BIN|CHR\\$|CODE|COS|EXP|FN|INKEY\\$|INT|IN|LEN|LN|NOT|OR|PEEK|PI|POINT|RND|SCREEN\\$|SGN|SIN|SQR|STR\\$|TAN|USR|VAL)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.sinclair",
          "match": "[+\\-*/^]"
        },
        {
          "name": "keyword.operator.comparison.sinclair",
          "match": "(<=|>=|<>|<|>|=)"
        },
        {
          "name": "keyword.operator.logical.sinclair",
          "match": "\\b(AND|OR|NOT)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sinclair",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sinclair",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.binary.sinclair",
          "match": "\\bBIN\\s+[01]+"
        },
        {
          "name": "constant.numeric.float.sinclair",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.sinclair",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.string.sinclair",
          "match": "\\b[a-zA-Z][a-zA-Z0-9]*\\$"
        },
        {
          "name": "variable.other.sinclair",
          "match": "\\b[a-zA-Z][a-zA-Z0-9]*\\b"
        }
      ]
    }
  }
}
