{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "C64 BASIC",
  "scopeName": "source.basic.c64",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#line-numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.rem.basic",
          "match": "^\\s*\\d+\\s+(REM)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.basic"
            },
            "2": {
              "name": "comment.content.basic"
            }
          }
        },
        {
          "name": "comment.line.rem.basic",
          "match": "\\b(REM)\\b.*$",
          "captures": {
            "1": {
              "name": "keyword.control.basic"
            }
          }
        }
      ]
    },
    "line-numbers": {
      "name": "constant.numeric.line-number.basic",
      "match": "^\\s*\\d+"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.basic",
          "match": "\\b(GOTO|GOSUB|RETURN|IF|THEN|FOR|TO|STEP|NEXT|END|STOP|ON)\\b"
        },
        {
          "name": "keyword.other.basic",
          "match": "\\b(PRINT|INPUT|GET|READ|DATA|RESTORE|DIM|LET|NEW|RUN|LIST|LOAD|SAVE|VERIFY|POKE|PEEK|SYS|WAIT|OPEN|CLOSE|CLR|CMD)\\b"
        },
        {
          "name": "keyword.operator.logical.basic",
          "match": "\\b(AND|OR|NOT)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.basic",
          "match": "\\b(ABS|ATN|CHR\\$|COS|EXP|FRE|INT|LEFT\\$|LEN|LOG|MID\\$|RIGHT\\$|RND|SGN|SIN|SPC|SQR|STR\\$|TAB|TAN|USR|VAL|ASC|FN|TI|TI\\$|ST|POS|PEEK)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.basic",
          "match": "[+\\-*/^]"
        },
        {
          "name": "keyword.operator.comparison.basic",
          "match": "(<>|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.assignment.basic",
          "match": "="
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.basic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.basic",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.basic",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.basic",
          "match": "\\b\\d+\\.\\d+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.string.basic",
          "match": "\\b[A-Z][A-Z0-9]*\\$"
        },
        {
          "name": "variable.other.integer.basic",
          "match": "\\b[A-Z][A-Z0-9]*%"
        },
        {
          "name": "variable.other.basic",
          "match": "\\b[A-Z][A-Z0-9]*\\b"
        }
      ]
    }
  }
}
