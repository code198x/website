{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Motorola 68000 Assembly",
  "scopeName": "source.asm.m68k",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#mnemonics" },
    { "include": "#symbols" },
    { "include": "#operators" },
    { "include": "#directives" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.m68k",
          "match": "[;\\*].*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.m68k",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.m68k",
          "match": "\\\\."
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "entity.name.function.label.m68k",
          "match": "^\\@?[A-Za-z\\._][A-Za-z0-9\\._]*(?=(\\$|\\:{0,2}))"
        },
        {
          "name": "constant.numeric.hex.m68k",
          "match": "\\-?\\$\\b[a-fA-F0-9]+\\b"
        },
        {
          "name": "constant.numeric.binary.m68k",
          "match": "\\%[01]+"
        },
        {
          "name": "constant.numeric.octal.m68k",
          "match": "\\-?\\@[0-7]+"
        },
        {
          "name": "constant.numeric.decimal.m68k",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "variable.language.register.m68k",
          "match": "\\b(?i)([da][0-7]|u?sp|ccr|pc|sr|a[0-7]|d[0-7])\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.m68k",
      "match": "!|&|&&|\\^|\\*|\\/{1,2}|\\-|\\+|~|=|<=|>=|<<|>>|<>|<|>|\\||\\|\\|"
    },
    "directives": {
      "patterns": [
        {
          "name": "support.function.pseudo.m68k",
          "match": "\\b(?i)(section|equ|dc\\.[bwl]|ds\\.[bwl]|dcb\\.[bwl]|org|align|even|odd|end|include|incbin|macro|endm|rept|endr|if|else|endif|cnop|opt)\\b"
        }
      ]
    },
    "mnemonics": {
      "patterns": [
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)(unlk|reset|nop|stop|rte|rts|trap(v)?|rtr|jsr|jmp|illegal)\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)([ans]bcd|tas|s(t|f|hi|ls|cc|cs|ne|eq|vc|vs|pl|mi|ge|lt|gt|le))(\\.[b])?\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)(link|swap|chk|(di|mul)[su])(\\.[wl])?\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)([lp]ea|moveq|exg)(\\.[l])?\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)(d?b(ra|sr|t|f|hi|ls|cc|cs|ne|eq|vc|vs|pl|mi|ge|lt|gt|le|hs|lo))(\\.[bws])?\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)(b(tst|chg|clr|set))(\\.[bl])?\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)(cmpa|move[apm]|adda|suba|ext|movem)(\\.[wl])?\\b"
        },
        {
          "name": "keyword.mnemonic.m68k",
          "match": "\\b(?i)((e)?or(i)?|and(i)?|sub([iqx])?|add([iqx])?|cmp([mi])?|move|negx|clr|neg|not|tst|or|(as|ls|rox|ro)[lr])(\\.[bwl])?\\b"
        }
      ]
    }
  }
}
