{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Forth (Jupiter Ace)",
  "scopeName": "source.forth.ace",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#control"
    },
    {
      "include": "#defining"
    },
    {
      "include": "#tape"
    },
    {
      "include": "#hardware"
    },
    {
      "include": "#floats"
    },
    {
      "include": "#core"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.stack.forth",
          "begin": "(?<![^\\s])\\((?=\\s)",
          "end": "\\)"
        },
        {
          "name": "comment.line.backslash.forth",
          "match": "(?<![^\\s])\\\\(?=\\s).*$"
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "match": "(?<![^\\s])(:|DEFINER|COMPILER)\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.other.definition.forth"
            },
            "2": {
              "name": "entity.name.function.forth"
            }
          }
        },
        {
          "name": "keyword.other.definition.forth",
          "match": "(?<![^\\s]);(?![^\\s])"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.forth",
          "begin": "(?<![^\\s])(\\.\\\"|S\\\"|ABORT\\\"|\\\")",
          "end": "\\\"",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.forth"
            }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.forth",
          "match": "(?<![^\\s])(?:EXECUTE|REPEAT|\\+LOOP|BEGIN|UNTIL|WHILE|LEAVE|ABORT|RUNS>|DOES>|ELSE|THEN|LOOP|EXIT|QUIT|IF|DO|I|J)(?![^\\s])"
        }
      ]
    },
    "defining": {
      "patterns": [
        {
          "name": "storage.type.forth",
          "match": "(?<![^\\s])(?:DEFINITIONS|VOCABULARY|2VARIABLE|2CONSTANT|IMMEDIATE|VARIABLE|CONSTANT|REDEFINE|<BUILDS|CREATE|FORGET|ALLOT|HERE)(?![^\\s])"
        }
      ]
    },
    "tape": {
      "patterns": [
        {
          "name": "support.function.tape.forth",
          "match": "(?<![^\\s])(?:BVERIFY|VERIFY|BSAVE|BLOAD|SAVE|LOAD|LIST|EDIT)(?![^\\s])"
        }
      ]
    },
    "hardware": {
      "patterns": [
        {
          "name": "support.function.hardware.forth",
          "match": "(?<![^\\s])(?:NUMBER|RETYPE|ASCII|INKEY|INVIS|BEEP|CALL|FAST|LINE|PLOT|SLOW|CLS|OUT|VIS|AT|IN)(?![^\\s])"
        }
      ]
    },
    "floats": {
      "patterns": [
        {
          "name": "support.function.float.forth",
          "match": "(?<![^\\s])(?:FNEGATE|UFLOAT|F\\+|F\\-|F\\*|F\\.|INT|F/)(?![^\\s])"
        }
      ]
    },
    "core": {
      "patterns": [
        {
          "name": "support.function.forth",
          "match": "(?<![^\\s])(?:DNEGATE|DECIMAL|CONTEXT|CURRENT|\\*/MOD|NEGATE|SPACES|\\?DUP|2DROP|2SWAP|2OVER|2PICK|2ROLL|U/MOD|SPACE|VLIST|DROP|SWAP|OVER|PICK|ROLL|2DUP|2ROT|/MOD|EMIT|TYPE|WORD|FIND|BASE|SIGN|DUP|ROT|PAD|MOD|\\*/|1\\+|1\\-|2\\+|2\\-|ABS|MIN|MAX|AND|XOR|U\\*|D\\+|U\\.|\\.S|<\\#|\\#S|\\#>|>R|R>|R@|\\+|\\-|\\*|OR|D<|0=|0<|0>|C@|C!|2@|2!|\\.|CR|\\#|/|=|<|>|@|!)(?![^\\s])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.forth",
          "match": "(?<![^\\s])-?(?:\\d+\\.\\d*|\\.\\d+|\\d+\\.)(?:e-?\\d+)?(?![^\\s])"
        },
        {
          "name": "constant.numeric.integer.forth",
          "match": "(?<![^\\s])-?\\d+(?![^\\s])"
        }
      ]
    }
  }
}
