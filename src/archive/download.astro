---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<Layout title="Download Development Environment - Code Like It's 198x" isDark={true}>
  <Breadcrumb segments={[{ text: "Download", href: "/download" }]} />

  <div class="container" style="max-width: 56rem;">
    <header class="page-header">
      <h1 class="page-title">Professional Retro Development Environment</h1>
      <p class="page-subtitle">
        Complete Docker-based development environment with 16+ retro platforms, 190+ working example
        programs, and professional cross-assemblers.
      </p>
    </header>

    <!-- Quick Start Section -->
    <section class="feature-card large" style="margin-bottom: var(--space-3xl);">
      <h2
        class="feature-title text-green"
        style="font-size: 1.5rem; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-xl);"
      >
        <span style="font-size: 1.875rem; margin-right: var(--space-md);">🚀</span>
        30-Second Setup
      </h2>

      <div class="terminal">
        <pre><code># 1. Navigate to development environment
cd development-environment

# 2. Start all development containers
docker-compose up -d

# 3. Enter main workspace
docker-compose exec workspace bash

# 4. Create your first C64 project
make create-c64-project NAME=hello
make build-prg PROJECT=hello</code></pre>
      </div>

      <div class="text-center">
        <p class="feature-description" style="margin-bottom: var(--space-lg); font-size: 1rem;">
          This repository contains the complete development environment. Follow the
          development-environment/README.md for detailed setup instructions.
        </p>
      </div>
    </section>

    <!-- What's Included -->
    <section class="feature-section" style="margin-bottom: var(--space-3xl);">
      <h2 class="section-title text-green">What's Included</h2>

      <div class="grid-2">
        <!-- Development Tools -->
        <div class="feature-card">
          <h3 class="feature-title text-blue flex items-center">
            <span
              class="feature-icon"
              style="font-size: 1.5rem; margin-right: var(--space-md); margin-bottom: 0;">🛠️</span
            >
            Professional Assemblers
          </h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• <strong>ACME</strong> - C64 cross-assembler</li>
            <li>• <strong>ca65</strong> - 6502 assembler (NES, Apple II)</li>
            <li>• <strong>sjasmplus</strong> - Z80 assembler (ZX Spectrum)</li>
            <li>• <strong>VASM</strong> - 68000 assembler (Amiga, Atari ST)</li>
            <li>• <strong>RGBDS</strong> - Game Boy development suite</li>
            <li>• <strong>DASM, MADS, BeebAsm</strong> - Platform-specific tools</li>
          </ul>
        </div>

        <!-- VS Code Integration -->
        <div class="feature-card">
          <h3 class="feature-title text-purple flex items-center">
            <span
              class="feature-icon"
              style="font-size: 1.5rem; margin-right: var(--space-md); margin-bottom: 0;">💻</span
            >
            VS Code Integration
          </h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• Assembly syntax highlighting</li>
            <li>• One-click build commands</li>
            <li>• Integrated emulator launching</li>
            <li>• Code snippets & templates</li>
            <li>• Error detection & debugging</li>
          </ul>
        </div>

        <!-- Example Programs -->
        <div class="feature-card">
          <h3 class="feature-title text-yellow flex items-center">
            <span
              class="feature-icon"
              style="font-size: 1.5rem; margin-right: var(--space-md); margin-bottom: 0;">📚</span
            >
            190+ Example Programs
          </h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• Complete lesson code examples</li>
            <li>• Working build system integration</li>
            <li>• Advanced graphics & sound demos</li>
            <li>• Hardware-specific programming</li>
            <li>• Phase 0 gateway lessons (BASIC to ASM)</li>
          </ul>
        </div>

        <!-- Docker Environment -->
        <div class="feature-card">
          <h3 class="feature-title text-red flex items-center">
            <span
              class="feature-icon"
              style="font-size: 1.5rem; margin-right: var(--space-md); margin-bottom: 0;">🐳</span
            >
            Docker Environment
          </h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• Complete isolated environment</li>
            <li>• No software conflicts</li>
            <li>• Works on Windows, Mac, Linux</li>
            <li>• Zero configuration required</li>
            <li>• Professional build toolchain</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Supported Systems -->
    <section class="feature-section" style="margin-bottom: var(--space-3xl);">
      <h2 class="section-title text-green">Supported Systems</h2>

      <div class="system-grid">
        <div class="system-card yellow">
          <div class="system-card-icon">🟤</div>
          <h3 class="system-card-title text-yellow">Commodore 64</h3>
          <p class="system-card-subtitle">ACME & ca65</p>
        </div>
        <div class="system-card purple">
          <div class="system-card-icon">🌈</div>
          <h3 class="system-card-title text-purple">ZX Spectrum</h3>
          <p class="system-card-subtitle">sjasmplus</p>
        </div>
        <div class="system-card red">
          <div class="system-card-icon">🎮</div>
          <h3 class="system-card-title text-red">Nintendo NES</h3>
          <p class="system-card-subtitle">ca65</p>
        </div>
        <div class="system-card blue">
          <div class="system-card-icon">🟦</div>
          <h3 class="system-card-title text-blue">Commodore Amiga</h3>
          <p class="system-card-subtitle">vasm</p>
        </div>
        <div class="system-card green">
          <div class="system-card-icon">🍎</div>
          <h3 class="system-card-title text-green">Apple II</h3>
          <p class="system-card-subtitle">ca65</p>
        </div>
        <div class="system-card slate">
          <div class="system-card-icon">🎯</div>
          <h3 class="system-card-title text-muted">Atari 2600</h3>
          <p class="system-card-subtitle">DASM</p>
        </div>
        <div class="system-card orange">
          <div class="system-card-icon">🕹️</div>
          <h3 class="system-card-title text-orange">Game Boy</h3>
          <p class="system-card-subtitle">RGBDS</p>
        </div>
        <div class="system-card indigo">
          <div class="system-card-icon">📺</div>
          <h3 class="system-card-title text-indigo">BBC Micro</h3>
          <p class="system-card-subtitle">BeebAsm</p>
        </div>
      </div>
      <p class="text-center text-muted text-small">
        + Amstrad CPC, Atari 800/ST, Dragon 32/64, Master System, Jupiter Ace, TI-99/4A, Vectrex
      </p>
    </section>

    <!-- Requirements -->
    <section class="feature-section" style="margin-bottom: var(--space-3xl);">
      <h2 class="section-title text-green">System Requirements</h2>

      <div class="grid-3">
        <div class="feature-card">
          <h3 class="feature-title text-green">💻 Hardware</h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• 8GB RAM (recommended)</li>
            <li>• 5GB free disk space</li>
            <li>• 64-bit processor</li>
            <li>• Internet connection (setup)</li>
          </ul>
        </div>

        <div class="feature-card">
          <h3 class="feature-title text-blue">🖥️ Software</h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• Docker Desktop</li>
            <li>• VS Code</li>
            <li>• Git</li>
            <li>• Modern operating system</li>
          </ul>
        </div>

        <div class="feature-card">
          <h3 class="feature-title text-yellow">🕹️ Optional</h3>
          <ul class="feature-description" style="text-align: left; line-height: 1.8;">
            <li>• VICE (C64 emulator)</li>
            <li>• Fuse (Spectrum emulator)</li>
            <li>• FCEux (NES emulator)</li>
            <li>• FS-UAE (Amiga emulator)</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Quick Start Guide -->
    <section class="feature-section" style="margin-bottom: var(--space-3xl);">
      <h2 class="section-title text-green">Getting Started</h2>

      <div style="display: flex; flex-direction: column; gap: var(--space-xl);">
        <div class="feature-card">
          <h3 class="feature-title text-green">Step 1: Install Prerequisites</h3>
          <div class="grid-3">
            <div>
              <h4 class="text-bold text-blue" style="margin-bottom: var(--space-sm);">
                Docker Desktop
              </h4>
              <p class="text-small feature-description" style="margin-bottom: var(--space-sm);">
                Download from docker.com
              </p>
              <a
                href="https://www.docker.com/products/docker-desktop/"
                class="text-blue text-small"
              >
                → Download Docker
              </a>
            </div>
            <div>
              <h4 class="text-bold text-purple" style="margin-bottom: var(--space-sm);">VS Code</h4>
              <p class="text-small feature-description" style="margin-bottom: var(--space-sm);">
                Free code editor
              </p>
              <a href="https://code.visualstudio.com/" class="text-purple text-small">
                → Download VS Code
              </a>
            </div>
            <div>
              <h4 class="text-bold text-red" style="margin-bottom: var(--space-sm);">Git</h4>
              <p class="text-small feature-description" style="margin-bottom: var(--space-sm);">
                Version control
              </p>
              <a href="https://git-scm.com/downloads" class="text-red text-small">
                → Download Git
              </a>
            </div>
          </div>
        </div>

        <div class="feature-card">
          <h3 class="feature-title text-green">Step 2: Navigate to Development Environment</h3>
          <div class="terminal">
            <pre><code># Already in the repository!
cd development-environment</code></pre>
          </div>
        </div>

        <div class="feature-card">
          <h3 class="feature-title text-green">Step 3: Start Development Environment</h3>
          <div class="terminal">
            <pre><code># Start all development containers
docker-compose up -d

# Enter main workspace
docker-compose exec workspace bash</code></pre>
          </div>
          <p class="feature-description">
            You're now in a complete retro development environment with all platforms ready!
          </p>
        </div>

        <div class="feature-card">
          <h3 class="feature-title text-green">Step 4: Start Coding!</h3>
          <div class="terminal">
            <pre><code># Create your first C64 project
make create-c64-project NAME=hello

# Build it!
make build-prg PROJECT=hello

# Or try other platforms:
make create-spectrum-project NAME=demo
make create-amiga-project NAME=graphics</code></pre>
          </div>
          <p class="feature-description">
            Your .prg/.tap/.nes files are ready to run in emulators!
          </p>
        </div>
      </div>
    </section>

    <!-- Learning Path -->
    <section class="feature-section" style="margin-bottom: var(--space-3xl);">
      <h2 class="section-title text-green">Recommended Learning Path</h2>

      <div class="grid-2">
        <div>
          <h3 class="feature-title text-yellow">🎯 Beginners</h3>
          <div style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div class="step-guide">
              <span class="step-number">1</span>
              <div class="step-content">
                <strong>Start with C64 Hello World</strong>
                <span class="text-small">Learn basic assembly structure</span>
              </div>
            </div>
            <div class="step-guide">
              <span class="step-number">2</span>
              <div class="step-content">
                <strong>Try color and graphics examples</strong>
                <span class="text-small">Understand memory mapping</span>
              </div>
            </div>
            <div class="step-guide">
              <span class="step-number">3</span>
              <div class="step-content">
                <strong>Explore other systems</strong>
                <span class="text-small">Compare different architectures</span>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h3 class="feature-title text-blue">🚀 Advanced</h3>
          <div style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div class="step-guide">
              <span class="step-number bg-blue">1</span>
              <div class="step-content">
                <strong>Study hardware-specific examples</strong>
                <span class="text-small">Copper lists, Blitter, PPU</span>
              </div>
            </div>
            <div class="step-guide">
              <span class="step-number bg-blue">2</span>
              <div class="step-content">
                <strong>Create your own projects</strong>
                <span class="text-small">Build games, demos, tools</span>
              </div>
            </div>
            <div class="step-guide">
              <span class="step-number bg-blue">3</span>
              <div class="step-content">
                <strong>Test on real hardware</strong>
                <span class="text-small">Use generated files on actual machines</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Highlight -->
    <section class="feature-section" style="margin-bottom: var(--space-3xl);">
      <h2 class="section-title text-green">Why This Environment?</h2>

      <div class="grid-responsive">
        <div class="feature-card">
          <div class="feature-icon large">⚡</div>
          <h3 class="feature-title text-green">Instant Setup</h3>
          <p class="feature-description">
            No manual configuration. Everything works out of the box.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon large">🎯</div>
          <h3 class="feature-title text-blue">Professional Tools</h3>
          <p class="feature-description">Same assemblers used by retro developers and demoscene.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon large">📚</div>
          <h3 class="feature-title text-yellow">Learn by Example</h3>
          <p class="feature-description">190+ documented examples from basic to advanced.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon large">🔄</div>
          <h3 class="feature-title text-purple">Cross-Platform</h3>
          <p class="feature-description">Works identically on Windows, Mac, and Linux.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon large">💰</div>
          <h3 class="feature-title text-red">Completely Free</h3>
          <p class="feature-description">Open source. No licenses, no subscriptions.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon large">🚀</div>
          <h3 class="feature-title text-green">Modern IDE</h3>
          <p class="feature-description">1980s tools with 2024 development experience.</p>
        </div>
      </div>
    </section>

    <!-- Support -->
    <section class="feature-card large text-center">
      <h2 class="feature-title text-green">Need Help?</h2>
      <p class="feature-description" style="margin-bottom: var(--space-xl);">
        Check out the comprehensive documentation and community resources.
      </p>

      <div class="flex" style="flex-wrap: wrap; justify-content: center; gap: var(--space-lg);">
        <div class="btn bg-blue" style="display: inline-flex; align-items: center;">
          📖 Quick Start: development-environment/README.md
        </div>
        <div class="btn bg-slate-dark" style="display: inline-flex; align-items: center;">
          🔧 Build System: Makefile with 16 platforms
        </div>
        <div class="btn bg-purple" style="display: inline-flex; align-items: center;">
          💻 VS Code: code198x.code-workspace
        </div>
      </div>
    </section>
  </div>
</Layout>
