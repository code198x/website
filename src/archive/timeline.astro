---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get all events
const events = await getCollection("events");

// Get all people with birth/death dates
const people = await getCollection("people");

// Get all companies with founding/dissolution dates
const companies = await getCollection("companies");

// Get all systems with release dates
const systems = await getCollection("systems");

// Create timeline entries from all sources
const timelineEntries = [];

// Add events
events.forEach((event) => {
  timelineEntries.push({
    date: new Date(event.data.date),
    dateStr: event.data.date,
    type: "event",
    category: event.data.category,
    title: event.data.title,
    description: event.data.description,
    link: null,
  });
});

// Add people births
people.forEach((person) => {
  if (person.data.birth_date && person.data.birth_date !== "1974-01-01") {
    // Exclude 68000 team placeholder
    timelineEntries.push({
      date: new Date(person.data.birth_date),
      dateStr: person.data.birth_date,
      type: "birth",
      category: "People",
      title: `${person.data.name} born`,
      description: `Birth of ${person.data.occupation[0].toLowerCase()}`,
      link: `/vault/people/${person.slug}`,
    });
  }
});

// Add people deaths
people.forEach((person) => {
  if (person.data.death_date && person.data.death_date !== "null") {
    timelineEntries.push({
      date: new Date(person.data.death_date),
      dateStr: person.data.death_date,
      type: "death",
      category: "People",
      title: `${person.data.name} dies`,
      description: `Death of pioneering ${person.data.occupation[0].toLowerCase()}`,
      link: `/vault/people/${person.slug}`,
    });
  }
});

// Add company foundations
companies.forEach((company) => {
  if (company.data.founded) {
    timelineEntries.push({
      date: new Date(company.data.founded),
      dateStr: company.data.founded,
      type: "founding",
      category: "Companies",
      title: `${company.data.name} founded`,
      description: `Establishment of ${company.data.business_focus[0]} company`,
      link: `/vault/companies/${company.slug}`,
    });
  }
});

// Add company dissolutions/acquisitions
companies.forEach((company) => {
  if (company.data.dissolved && company.data.dissolved !== "null") {
    timelineEntries.push({
      date: new Date(company.data.dissolved),
      dateStr: company.data.dissolved,
      type: "dissolution",
      category: "Companies",
      title: `${company.data.name} ${company.data.acquired_by ? "acquired" : "dissolved"}`,
      description: company.data.acquired_by
        ? `Acquired by ${company.data.acquired_by}`
        : "Company ceased operations",
      link: `/vault/companies/${company.slug}`,
    });
  }
});

// Add system launches
systems.forEach((system) => {
  if (system.data.release_date) {
    timelineEntries.push({
      date: new Date(system.data.release_date),
      dateStr: system.data.release_date,
      type: "system",
      category: "Technology",
      title: `${system.data.name} launched`,
      description: system.data.tagline,
      link: `/lessons/${system.slug}/`,
    });
  }
});

// Sort chronologically
timelineEntries.sort((a, b) => a.date - b.date);

// Filter to focus on relevant period (1970-1999) plus some context
const filteredEntries = timelineEntries.filter((entry) => {
  const year = entry.date.getFullYear();
  return year >= 1920 && year <= 1999;
});

// Group by decade
const decades = {};
filteredEntries.forEach((entry) => {
  const decade = Math.floor(entry.date.getFullYear() / 10) * 10;
  if (!decades[decade]) {
    decades[decade] = [];
  }
  decades[decade].push(entry);
});

// Category colours (for CSS classes)
const categoryColours = {
  Technology: "technology",
  "Gaming History": "gaming",
  "World History": "world",
  People: "people",
  Companies: "companies",
};
---

<Layout title="Timeline - Code Like It's 198x">
  <main class="container" style="padding-top: var(--space-2xl);">
    <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-sm);">Timeline</h1>
    <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: var(--space-2xl);">
      Explore the intertwined history of computing, gaming, and world events that shaped the digital
      revolution.
    </p>

    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">Timeline</span>
    </nav>

    <div class="timeline-legend">
      <h2>Legend</h2>
      <div class="legend-items">
        <span class="legend-item">
          <span class="legend-dot technology"></span>
          Technology
        </span>
        <span class="legend-item">
          <span class="legend-dot gaming"></span>
          Gaming History
        </span>
        <span class="legend-item">
          <span class="legend-dot world"></span>
          World History
        </span>
        <span class="legend-item">
          <span class="legend-dot people"></span>
          People
        </span>
        <span class="legend-item">
          <span class="legend-dot companies"></span>
          Companies
        </span>
      </div>
    </div>

    {
      Object.entries(decades).map(([decade, entries]) => (
        <section class="timeline-decade">
          <h2>{decade}s</h2>
          <div class="timeline-entries">
            {entries.map((entry) => {
              const year = entry.date.getFullYear();
              const month = entry.date.toLocaleString("en-GB", { month: "long" });
              const day = entry.date.getDate();

              return (
                <div class="timeline-entry">
                  <div class="timeline-date">
                    <div class="timeline-date-year">{year}</div>
                    <div class="timeline-date-detail">
                      {day} {month}
                    </div>
                  </div>
                  <div class="timeline-content">
                    <div
                      class={`timeline-title ${categoryColours[entry.category] || "technology"}`}
                    >
                      {entry.link ? (
                        <a href={entry.link} class="hover:underline">
                          {entry.title}
                        </a>
                      ) : (
                        entry.title
                      )}
                    </div>
                    <div class="timeline-description">{entry.description}</div>
                    <div class="timeline-category">{entry.category}</div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }

    <div class="timeline-about">
      <h2>About This Timeline</h2>
      <p>
        This timeline combines technological milestones with significant world events to provide
        context for the computing revolution of the 1970s, 1980s, and 1990s. Understanding how
        technology developed alongside major historical events helps us appreciate both the
        challenges and opportunities that shaped the digital age.
      </p>
    </div>
  </main>
</Layout>
