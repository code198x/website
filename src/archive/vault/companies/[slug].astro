---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const companies = await getCollection("companies");
  return companies.map((company) => ({
    params: { slug: company.slug },
  }));
}

const company = await getEntry("companies", Astro.params.slug);
if (!company) {
  throw new Error(`Company not found: ${Astro.params.slug}`);
}

const { Content } = await render(company);

// Format dates for display
const formatDate = (date: Date | string | undefined) => {
  if (!date) return null;
  const dateObj = typeof date === "string" ? new Date(date) : date;
  return dateObj.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const foundedDate = formatDate(company.data.founded);
const dissolvedDate = formatDate(company.data.dissolved);
const acquisitionDate = formatDate(company.data.acquisition_date);
---

<Layout title={`${company.data.name} - Companies - The Vault - Code Like It's 198x`}>
  <main class="container" style="padding-top: var(--space-2xl);">
    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href="/vault">The Vault</a>
      <span class="separator">/</span>
      <a href="/vault/companies">Companies</a>
      <span class="separator">/</span>
      <span class="current">{company.data.name}</span>
    </nav>

    <header style="margin-bottom: var(--space-2xl);">
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);">
        {company.data.name}
      </h1>

      <div class="vault-detail-header">
        <div class="vault-detail-grid">
          <div class="vault-detail-section">
            <h2>Company Details</h2>
            <dl class="vault-detail-list">
              <div class="vault-detail-item">
                <dt class="vault-detail-label">Founded:</dt>
                <dd class="vault-detail-value">{foundedDate}</dd>
              </div>
              {
                dissolvedDate && (
                  <div class="vault-detail-item">
                    <dt class="vault-detail-label">Dissolved:</dt>
                    <dd class="vault-detail-value">{dissolvedDate}</dd>
                  </div>
                )
              }
              {
                company.data.acquired_by && acquisitionDate && (
                  <div class="vault-detail-item">
                    <dt class="vault-detail-label">Acquired:</dt>
                    <dd class="vault-detail-value">
                      {acquisitionDate} by {company.data.acquired_by}
                    </dd>
                  </div>
                )
              }
              <div class="vault-detail-item">
                <dt class="vault-detail-label">Location:</dt>
                <dd class="vault-detail-value">
                  {company.data.headquarters}, {company.data.country}
                </dd>
              </div>
            </dl>
          </div>

          <div class="vault-detail-section">
            <h2>Key People</h2>
            <dl class="vault-detail-list">
              <div>
                <dt class="vault-detail-label" style="margin-bottom: var(--space-xs);">
                  Founders:
                </dt>
                <dd class="vault-detail-value">
                  {
                    company.data.founders
                      .map((founder) =>
                        typeof founder === "string"
                          ? founder
                          : `${founder.name}${founder.role ? ` (${founder.role})` : ""}`
                      )
                      .join(", ")
                  }
                </dd>
              </div>
              {
                company.data.key_people && company.data.key_people.length > 0 && (
                  <div>
                    <dt class="vault-detail-label" style="margin-bottom: var(--space-xs);">
                      Key People:
                    </dt>
                    <dd class="vault-detail-value">
                      {company.data.key_people
                        .map((person) =>
                          typeof person === "string"
                            ? person
                            : `${person.name}${person.role ? ` (${person.role})` : ""}${person.tenure ? ` ${person.tenure}` : ""}`
                        )
                        .join(", ")}
                    </dd>
                  </div>
                )
              }
            </dl>
          </div>
        </div>

        <div class="vault-detail-grid" style="margin-top: var(--space-xl);">
          <div class="vault-detail-section">
            <h2>Business Focus</h2>
            <ul
              style="list-style: disc; list-style-position: inside; font-size: 0.875rem; color: var(--text-muted);"
            >
              {company.data.business_focus.map((focus) => <li>{focus}</li>)}
            </ul>
          </div>

          <div class="vault-detail-section">
            <h2>Notable Products</h2>
            <ul
              style="list-style: disc; list-style-position: inside; font-size: 0.875rem; color: var(--text-muted);"
            >
              {
                company.data.notable_products.map((product) => (
                  <li>
                    {typeof product === "string"
                      ? product
                      : `${product.name}${product.type ? ` (${product.type})` : ""}${product.year ? ` - ${product.year}` : ""}`}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {
          company.data.legacy && (
            <div style="margin-top: var(--space-xl);">
              <h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-md); color: var(--text-primary);">
                Legacy
              </h2>
              <p style="font-size: 0.875rem; color: var(--text-muted); font-style: italic;">
                {company.data.legacy}
              </p>
            </div>
          )
        }
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>

    {
      company.data.external_links && company.data.external_links.length > 0 && (
        <div class="vault-external-links">
          <h2>External Resources</h2>
          <ul>
            {company.data.external_links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.title} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </main>
</Layout>
