---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const software = await getCollection("software");
  return software.map((item) => ({
    params: { slug: item.slug },
    props: { software: item },
  }));
}

const { software } = Astro.props;
const { Content } = await software.render();
---

<Layout title={`${software.data.name} - Software - The Vault - Code Like It's 198x`}>
  <main class="container" style="padding-top: var(--space-2xl);">
    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href="/vault">The Vault</a>
      <span class="separator">/</span>
      <a href="/vault/software">Software</a>
      <span class="separator">/</span>
      <span class="current">{software.data.name}</span>
    </nav>

    <div style="margin-bottom: var(--space-2xl);">
      <div
        style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-lg);"
      >
        <h1 style="font-size: 2.5rem; font-weight: 700;">{software.data.name}</h1>
        <span class="vault-card-badge software">
          {software.data.type}
        </span>
      </div>

      <div class="vault-detail-grid" style="margin-bottom: var(--space-2xl);">
        <div class="vault-detail-header" style="background: var(--bg-secondary);">
          <h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-lg);">
            Quick Facts
          </h2>
          <dl style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div>
              <dt style="font-size: 0.875rem; font-weight: 500; color: var(--text-muted);">
                Original Platform
              </dt>
              <dd style="font-size: 0.875rem; color: var(--text-primary);">
                {software.data.original_platform}
              </dd>
            </div>
            <div>
              <dt style="font-size: 0.875rem; font-weight: 500; color: var(--text-muted);">
                Release Date
              </dt>
              <dd style="font-size: 0.875rem; color: var(--text-primary);">
                {
                  software.data.original_release_date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                }
              </dd>
            </div>
            {
              software.data.original_developer && (
                <div>
                  <dt style="font-size: 0.875rem; font-weight: 500; color: var(--text-muted);">
                    Developer{software.data.original_developer.length > 1 ? "s" : ""}
                  </dt>
                  <dd style="font-size: 0.875rem; color: var(--text-primary);">
                    {software.data.original_developer.map((dev) => dev.name).join(", ")}
                  </dd>
                </div>
              )
            }
            {
              software.data.original_publisher && (
                <div>
                  <dt style="font-size: 0.875rem; font-weight: 500; color: var(--text-muted);">
                    Publisher
                  </dt>
                  <dd style="font-size: 0.875rem; color: var(--text-primary);">
                    {software.data.original_publisher}
                  </dd>
                </div>
              )
            }
            {
              software.data.genre && (
                <div>
                  <dt style="font-size: 0.875rem; font-weight: 500; color: var(--text-muted);">
                    Genre
                  </dt>
                  <dd style="font-size: 0.875rem; color: var(--text-primary);">
                    {software.data.genre}
                  </dd>
                </div>
              )
            }
          </dl>
        </div>

        <div
          style="background: #dbeafe; border-radius: var(--radius-lg); padding: var(--space-xl);"
        >
          <h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-lg);">
            Significance
          </h2>
          <p style="font-size: 0.875rem; color: var(--text-primary);">
            {software.data.significance}
          </p>

          {
            software.data.technical_innovations &&
              software.data.technical_innovations.length > 0 && (
                <div style="margin-top: var(--space-lg);">
                  <h3 style="font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-bottom: var(--space-sm);">
                    Technical Innovations
                  </h3>
                  <ul style="font-size: 0.875rem; color: var(--text-primary); list-style: none; padding: 0;">
                    {software.data.technical_innovations.map((innovation) => (
                      <li style="display: flex; align-items: flex-start; margin-bottom: var(--space-xs);">
                        <span style="color: #2563eb; margin-right: var(--space-sm);">•</span>
                        {innovation}
                      </li>
                    ))}
                  </ul>
                </div>
              )
          }
        </div>
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      software.data.platform_releases && software.data.platform_releases.length > 0 && (
        <div class="mt-12 bg-slate-50 rounded-lg p-6">
          <h2 class="text-xl font-semibold mb-4">Platform Releases</h2>
          <div class="grid md:grid-cols-2 gap-4">
            {software.data.platform_releases.map((release) => (
              <div class="bg-white rounded p-4 border">
                <h3 class="font-medium text-slate-900 mb-2">{release.system}</h3>
                <p class="text-sm text-slate-600 mb-1">
                  Released:{" "}
                  {release.release_date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </p>
                {release.developer && (
                  <p class="text-sm text-slate-600 mb-1">
                    Developer: {release.developer.map((dev) => dev.name).join(", ")}
                  </p>
                )}
                {release.technical_notes && (
                  <p class="text-sm text-slate-700 mt-2">{release.technical_notes}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="mt-8 text-center">
      <a
        href="/vault/software"
        class="inline-flex items-center px-4 py-2 bg-red-600 text-white font-medium rounded hover:bg-red-700 transition-colors"
      >
        ← Back to Software
      </a>
    </div>
  </main>
</Layout>
