---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

const software = await getCollection("software");
const sortedSoftware = software.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Software - The Vault - Code Like It's 198x">
  <main class="container" style="padding-top: var(--space-2xl);">
    <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-sm);">Software</h1>
    <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: var(--space-2xl);">
      Notable applications, games, and programs that defined vintage computing.
    </p>

    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href="/vault">The Vault</a>
      <span class="separator">/</span>
      <span class="current">Software</span>
    </nav>

    <div class="vault-grid" style="grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));">
      {
        sortedSoftware.map((item) => (
          <div class="vault-card">
            <div class="vault-card-header">
              <h2 class="vault-card-title">{item.data.name}</h2>
              <span class="vault-card-badge software">{item.data.type}</span>
            </div>

            <div style="margin-bottom: var(--space-lg);">
              <p class="alphabetical-item-meta" style="margin-bottom: var(--space-sm);">
                <strong>Platform:</strong> {item.data.original_platform}
              </p>
              <p class="alphabetical-item-meta" style="margin-bottom: var(--space-sm);">
                <strong>Released:</strong>{" "}
                {item.data.original_release_date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              {item.data.original_developer && (
                <p class="alphabetical-item-meta" style="margin-bottom: var(--space-sm);">
                  <strong>Developer:</strong>{" "}
                  {item.data.original_developer.map((dev) => dev.name).join(", ")}
                </p>
              )}
            </div>

            <p
              class="vault-card-description"
              style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
            >
              {item.data.description}
            </p>

            <a href={`/vault/software/${item.slug}`} class="vault-card-link software">
              Learn More →
            </a>
          </div>
        ))
      }
    </div>

    {
      sortedSoftware.length === 0 && (
        <div class="text-center" style="padding: var(--space-4xl) 0;">
          <div style="color: var(--text-muted); font-size: 1.125rem; margin-bottom: var(--space-lg);">
            No software entries found.
          </div>
          <p style="color: var(--text-muted);">Software entries are being added to the vault.</p>
        </div>
      )
    }
  </main>
</Layout>
