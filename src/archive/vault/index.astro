---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// Fetch content from each directory
const companies = await getCollection("companies");
const people = await getCollection("people");
const systems = await getCollection("systems");
const events = await getCollection("events");
const software = await getCollection("software");

// Count entries
const stats = {
  companies: companies.length,
  people: people.length,
  systems: systems.length,
  events: events.length,
  software: software.length,
};
---

<Layout title="The Vault - Code Like It's 198x">
  <main class="container" style="padding-top: var(--space-2xl);">
    <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-sm);">The Vault</h1>
    <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: var(--space-2xl);">
      Explore the people, companies, systems, and events that shaped the computing revolution.
    </p>

    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <span class="current">The Vault</span>
    </nav>

    <div class="vault-grid">
      <div class="vault-card">
        <div class="vault-card-header">
          <h2 class="vault-card-title">People</h2>
          <span class="vault-card-badge people">
            {stats.people}
          </span>
        </div>
        <p class="vault-card-description">
          Engineers, entrepreneurs, and visionaries who created the technology we learn about.
        </p>
        <a href="/vault/people" class="vault-card-link people"> Browse People → </a>
      </div>

      <div class="vault-card">
        <div class="vault-card-header">
          <h2 class="vault-card-title">Companies</h2>
          <span class="vault-card-badge companies">
            {stats.companies}
          </span>
        </div>
        <p class="vault-card-description">
          The companies that manufactured the computers and processors that defined an era.
        </p>
        <a href="/vault/companies" class="vault-card-link companies"> Browse Companies → </a>
      </div>

      <div class="vault-card">
        <div class="vault-card-header">
          <h2 class="vault-card-title">Systems</h2>
          <span class="vault-card-badge systems">
            {stats.systems}
          </span>
        </div>
        <p class="vault-card-description">
          The vintage computing systems featured in our programming lessons.
        </p>
        <a href="/vault/systems" class="vault-card-link systems"> Browse Systems → </a>
      </div>

      <div class="vault-card">
        <div class="vault-card-header">
          <h2 class="vault-card-title">Timeline</h2>
          <span class="vault-card-badge events">
            {stats.events}
          </span>
        </div>
        <p class="vault-card-description">
          Key events in computing history and the world events that provided context.
        </p>
        <a href="/timeline" class="vault-card-link events"> View Timeline → </a>
      </div>

      <div class="vault-card">
        <div class="vault-card-header">
          <h2 class="vault-card-title">Software</h2>
          <span class="vault-card-badge software">
            {stats.software}
          </span>
        </div>
        <p class="vault-card-description">
          Notable applications, games, and programs that defined vintage computing.
        </p>
        <a href="/vault/software" class="vault-card-link software"> Browse Software → </a>
      </div>
    </div>

    <div class="vault-about">
      <h2>About The Vault</h2>
      <div class="vault-about-grid">
        <div class="vault-about-section">
          <h3>Historical Context</h3>
          <p>
            The Vault provides the historical and technical context behind the systems you're
            learning to program. Understanding the people who designed the processors, the companies
            that built the computers, and the events that shaped the industry enriches your learning
            experience.
          </p>
        </div>
        <div class="vault-about-section">
          <h3>Cross-References</h3>
          <p>
            Vault entries are cross-referenced throughout the lessons, providing deeper insight into
            the technologies and design decisions that made these vintage computers possible. Click
            on any name or company mentioned in lessons to learn more about their contributions.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>
