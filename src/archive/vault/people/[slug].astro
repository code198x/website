---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((person) => ({
    params: { slug: person.slug },
  }));
}

const person = await getEntry("people", Astro.params.slug);
if (!person) {
  throw new Error(`Person not found: ${Astro.params.slug}`);
}

const { Content } = await render(person);

// Format dates for display
const formatDate = (date: Date | string | undefined) => {
  if (!date) return null;
  const dateObj = typeof date === "string" ? new Date(date) : date;
  return dateObj.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const birthDate = formatDate(person.data.birth_date);
const deathDate = formatDate(person.data.death_date);
---

<Layout title={`${person.data.name} - People - The Vault - Code Like It's 198x`}>
  <main class="container" style="padding-top: var(--space-2xl);">
    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href="/vault">The Vault</a>
      <span class="separator">/</span>
      <a href="/vault/people">People</a>
      <span class="separator">/</span>
      <span class="current">{person.data.name}</span>
    </nav>

    <header style="margin-bottom: var(--space-2xl);">
      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);">
        {person.data.name}
      </h1>

      <div class="vault-detail-header">
        <div class="vault-detail-grid">
          <div class="vault-detail-section">
            <h2>Personal Details</h2>
            <dl class="vault-detail-list">
              {
                birthDate && (
                  <div class="vault-detail-item">
                    <dt class="vault-detail-label">Born:</dt>
                    <dd class="vault-detail-value">{birthDate}</dd>
                  </div>
                )
              }
              {
                deathDate && (
                  <div class="vault-detail-item">
                    <dt class="vault-detail-label">Died:</dt>
                    <dd class="vault-detail-value">{deathDate}</dd>
                  </div>
                )
              }
              <div class="vault-detail-item">
                <dt class="vault-detail-label">Nationality:</dt>
                <dd class="vault-detail-value">{person.data.nationality}</dd>
              </div>
            </dl>
          </div>

          <div class="vault-detail-section">
            <h2>Professional</h2>
            <dl class="vault-detail-list">
              <div>
                <dt class="vault-detail-label" style="margin-bottom: var(--space-xs);">
                  Occupation:
                </dt>
                <dd class="vault-detail-value">
                  {person.data.occupation.join(", ")}
                </dd>
              </div>
              {
                person.data.companies_founded && person.data.companies_founded.length > 0 && (
                  <div>
                    <dt class="vault-detail-label" style="margin-bottom: var(--space-xs);">
                      Founded:
                    </dt>
                    <dd class="vault-detail-value">
                      {person.data.companies_founded
                        .map((company) =>
                          typeof company === "string"
                            ? company
                            : `${company.company}${company.year ? ` (${company.year})` : ""}${company.role ? ` as ${company.role}` : ""}`
                        )
                        .join(", ")}
                    </dd>
                  </div>
                )
              }
              {
                person.data.companies_worked_for && person.data.companies_worked_for.length > 0 && (
                  <div>
                    <dt class="vault-detail-label" style="margin-bottom: var(--space-xs);">
                      Worked for:
                    </dt>
                    <dd class="vault-detail-value">
                      {person.data.companies_worked_for
                        .map((company) =>
                          typeof company === "string"
                            ? company
                            : `${company.company}${company.role ? ` (${company.role})` : ""}${company.start_year || company.end_year ? ` ${company.start_year || "?"}-${company.end_year || "present"}` : ""}`
                        )
                        .join(", ")}
                    </dd>
                  </div>
                )
              }
            </dl>
          </div>
        </div>

        {
          person.data.notable_contributions && person.data.notable_contributions.length > 0 && (
            <div class="vault-contributions">
              <h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-md); color: var(--text-primary);">
                Notable Contributions
              </h2>
              <div>
                {person.data.notable_contributions.map((contribution) => (
                  <div class="vault-contribution-card">
                    <div class="vault-contribution-title">
                      {typeof contribution === "string" ? contribution : contribution.contribution}
                      {typeof contribution === "object" && contribution.year && (
                        <span class="vault-contribution-year">({contribution.year})</span>
                      )}
                    </div>
                    {typeof contribution === "object" && contribution.context && (
                      <p class="vault-contribution-context">{contribution.context}</p>
                    )}
                    {typeof contribution === "object" && contribution.significance && (
                      <p class="vault-contribution-significance">{contribution.significance}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )
        }

        {
          person.data.awards && person.data.awards.length > 0 && (
            <div class="vault-contributions">
              <h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-md); color: var(--text-primary);">
                Awards & Recognition
              </h2>
              <div>
                {person.data.awards.map((award) => (
                  <div
                    class="vault-contribution-card"
                    style="display: flex; flex-direction: column; gap: var(--space-sm);"
                  >
                    <div class="vault-contribution-title">
                      {typeof award === "string" ? award : award.name}
                    </div>
                    {typeof award === "object" && (award.year || award.organization) && (
                      <div class="vault-contribution-context">
                        {award.organization && <span>{award.organization}</span>}
                        {award.organization && award.year && <span> • </span>}
                        {award.year && <span>{award.year}</span>}
                      </div>
                    )}
                    {typeof award === "object" && award.reason && (
                      <div
                        class="vault-contribution-significance"
                        style="color: var(--text-muted); font-style: italic;"
                      >
                        {award.reason}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>

    {
      person.data.external_links && person.data.external_links.length > 0 && (
        <div class="vault-external-links">
          <h2>External Resources</h2>
          <ul>
            {person.data.external_links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.title} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </main>
</Layout>
