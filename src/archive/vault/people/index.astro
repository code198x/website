---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import AlphabeticalList from "../../../components/AlphabeticalList.astro";
import { sortAlphabetically, groupByFirstLetter } from "../../../utils/helpers";

const people = await getCollection("people");
const groupedPeople = groupByFirstLetter(people.sort(sortAlphabetically));
---

<Layout title="People - The Vault - Code Like It's 198x">
  <main class="container" style="padding-top: var(--space-2xl);">
    <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-sm);">People</h1>
    <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: var(--space-2xl);">
      The engineers, entrepreneurs, and visionaries who created the technology that defined
      computing.
    </p>

    <nav class="breadcrumb" style="margin-bottom: var(--space-2xl);">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href="/vault">The Vault</a>
      <span class="separator">/</span>
      <span class="current">People</span>
    </nav>

    <AlphabeticalList title="People" groupedItems={groupedPeople} baseUrl="/vault/people" />
  </main>
</Layout>
