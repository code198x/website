---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

const systems = await getCollection("systems");
const sortedSystems = systems.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Systems - Vault">
  <main class="container" style="padding-top: var(--space-2xl);">
    <div style="margin-bottom: var(--space-2xl);">
      <nav class="breadcrumb" style="margin-bottom: var(--space-lg);">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/vault">Vault</a>
        <span class="separator">/</span>
        <span class="current">Systems</span>
      </nav>

      <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);">
        Computer Systems
      </h1>
      <p style="font-size: 1.125rem; color: var(--text-muted); max-width: 48rem;">
        Explore the technical specifications, history, and cultural impact of the iconic computer
        systems that defined the home computing revolution of the 1980s.
      </p>
    </div>

    <div class="vault-grid" style="grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));">
      {
        sortedSystems.map((system) => (
          <a
            href={`/vault/systems/${system.slug}`}
            class="system-card-link"
            style="display: block; text-decoration: none;"
          >
            <div class="vault-card" style="overflow: hidden; height: 100%;">
              <div style="height: 12rem; background-color: var(--bg-secondary); overflow: hidden; margin: calc(-1 * var(--space-xl)); margin-bottom: var(--space-lg);">
                <img
                  src={system.data.image}
                  alt={system.data.name}
                  style="width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-fast);"
                  class="system-card-image"
                />
              </div>
              <div>
                <h3 class="vault-card-title" style="margin-bottom: var(--space-sm);">
                  {system.data.name}
                </h3>
                <p class="vault-card-description" style="margin-bottom: var(--space-lg);">
                  {system.data.historical_significance?.slice(0, 120)}...
                </p>
                <div class="alphabetical-item-detail">
                  <div>
                    <strong>Released:</strong> {system.data.release_date.global.getFullYear()}
                  </div>
                  <div>
                    <strong>Manufacturer:</strong> {system.data.manufacturer}
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
