---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import MedalBadge from '../../components/MedalBadge.astro';

const allSystems = await getCollection('systems');

// Define the 68000 family systems
const system68000Slugs = [
  'commodore-amiga', 'atari-st', 'sega-genesis', 'snk-neo-geo', 'sharp-x68000',
  'macintosh-68k', 'sinclair-ql', 'atari-jaguar', 'philips-cd-i'
];

const systems = system68000Slugs
  .map(slug => allSystems.find(s => s.slug === slug))
  .filter(Boolean)
  .filter(s => s.data.status !== 'vault')
  .sort((a, b) => {
    const tierOrder = { platinum: 0, gold: 1, silver: 2, bronze: 3 };
    const tierA = tierOrder[a.data.medal_tier] ?? 4;
    const tierB = tierOrder[b.data.medal_tier] ?? 4;
    if (tierA !== tierB) return tierA - tierB;
    return (b.data.total_lessons || 0) - (a.data.total_lessons || 0);
  });

const totalLessons = systems.reduce((sum, s) => sum + (s.data.total_lessons || 0), 0);
const totalGames = systems.reduce((sum, s) => sum + (s.data.total_games || 0), 0);

// Group by medal tier
const platinum = systems.filter(s => s.data.medal_tier === 'platinum');
const gold = systems.filter(s => s.data.medal_tier === 'gold');
const silver = systems.filter(s => s.data.medal_tier === 'silver');
const bronze = systems.filter(s => s.data.medal_tier === 'bronze');
---

<Layout title="68000 Architecture Track | Code Like It's 198x">
  <main class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-green-400">
    <div class="container mx-auto px-4 py-12">
      <header class="mb-12">
        <div class="flex items-center gap-4 mb-4">
          <a href="/tracks/" class="text-gray-400 hover:text-green-400 transition">
            ← Back to Tracks
          </a>
        </div>
        <div class="flex items-center gap-6">
          <div class="text-6xl">🔸</div>
          <div>
            <h1 class="text-5xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-400">
              Motorola 68000 Family
            </h1>
            <p class="text-xl text-gray-300">
              16/32-bit powerhouse for graphics and multimedia
            </p>
          </div>
        </div>
      </header>

      <div class="grid md:grid-cols-4 gap-6 mb-12">
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{systems.length}</div>
          <div class="text-gray-400">Systems</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{totalLessons.toLocaleString()}</div>
          <div class="text-gray-400">Total Lessons</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{totalGames.toLocaleString()}</div>
          <div class="text-gray-400">Games to Build</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">1979-1994</div>
          <div class="text-gray-400">Era Covered</div>
        </div>
      </div>

      <div class="bg-gray-800 rounded-lg p-8 mb-12 border-2 border-gray-700">
        <h2 class="text-2xl font-bold mb-4 text-white">About the 68000 Architecture</h2>
        <div class="prose prose-invert max-w-none text-gray-300">
          <p class="mb-4">
            The Motorola 68000, introduced in 1979, bridged the gap between 8-bit and 32-bit computing. 
            With its 32-bit internal architecture and 16-bit data bus, the 68000 offered unprecedented 
            power for home computers, enabling advanced graphics, sound, and multitasking capabilities 
            that defined the 16-bit era.
          </p>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Key Characteristics</h3>
          <ul class="list-disc pl-6 space-y-2 mb-4">
            <li><strong>32-bit architecture:</strong> 32-bit registers and ALU with 16-bit external bus</li>
            <li><strong>Orthogonal instruction set:</strong> Most instructions work with all addressing modes</li>
            <li><strong>16 MB address space:</strong> 24-bit addressing for vast memory capabilities</li>
            <li><strong>Rich addressing modes:</strong> 14 addressing modes for flexible programming</li>
            <li><strong>Supervisor/User modes:</strong> Hardware support for operating systems</li>
            <li><strong>Clean architecture:</strong> Elegant design made it popular with programmers</li>
          </ul>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Register Architecture</h3>
          <ul class="list-disc pl-6 space-y-2 mb-4">
            <li><strong>Data registers:</strong> Eight 32-bit registers (D0-D7) for general use</li>
            <li><strong>Address registers:</strong> Eight 32-bit registers (A0-A7) for pointers</li>
            <li><strong>Stack pointers:</strong> A7 serves as USP (user) or SSP (supervisor)</li>
            <li><strong>Program counter:</strong> 32-bit PC with 24 bits used for addressing</li>
            <li><strong>Status register:</strong> Condition codes and system/interrupt level</li>
          </ul>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Notable Variants</h3>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>68000:</strong> Original 8 MHz version (Amiga 500, Atari ST, Mac 128K)</li>
            <li><strong>68008:</strong> 8-bit data bus version (Sinclair QL)</li>
            <li><strong>68010:</strong> Virtual memory support (some Unix workstations)</li>
            <li><strong>68020:</strong> Full 32-bit with cache (Amiga 1200, Mac II)</li>
            <li><strong>68030:</strong> Integrated MMU and cache (Amiga 3000, Mac SE/30)</li>
            <li><strong>68040:</strong> Integrated FPU, rival to Intel 486 (Mac Quadra)</li>
          </ul>
        </div>
      </div>

      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-white">Learning Path</h2>
        
        {platinum.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🏆</span>
              <span class="text-gray-300">Platinum Tier - Complete Mastery (4,096 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-2 gap-4">
              {platinum.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                    <span>{system.data.estimated_duration}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {gold.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🥇</span>
              <span class="text-gray-300">Gold Tier - Advanced Study (2,048 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-2 gap-4">
              {gold.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                    <span>{system.data.estimated_duration}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {silver.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🥈</span>
              <span class="text-gray-300">Silver Tier - Solid Foundation (1,024 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-3 gap-4">
              {silver.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {bronze.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🥉</span>
              <span class="text-gray-300">Bronze Tier - Quick Start (512 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-3 gap-4">
              {bronze.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="bg-gradient-to-r from-green-900 to-emerald-900 rounded-lg p-8 border-2 border-green-700">
        <h2 class="text-2xl font-bold mb-4 text-white">Recommended Learning Path</h2>
        <div class="space-y-4 text-gray-300">
          <div class="flex gap-4">
            <div class="text-2xl">1️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Begin with Atari ST</h3>
              <p class="text-sm">The ST's clean architecture and TOS operating system provide an excellent introduction to 68000 programming with straightforward hardware and good documentation.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">2️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Master the Amiga's Custom Chips</h3>
              <p class="text-sm">Learn advanced graphics and sound programming with the Amiga's Blitter, Copper, and Paula chips. Understand how custom hardware extends the 68000's capabilities.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">3️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Console Development with Genesis</h3>
              <p class="text-sm">Apply your skills to console game development, learning VDP programming, DMA transfers, and creating arcade-quality games on dedicated hardware.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">4️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Push Limits with Neo Geo</h3>
              <p class="text-sm">Experience professional arcade development with massive sprites, multiple scrolling layers, and the most powerful 68000-based gaming hardware ever created.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>