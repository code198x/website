---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSystems = await getCollection('systems');
const activeSystems = allSystems.filter(s => s.data.status !== 'vault');

// Group systems by CPU architecture
const architectures = {
  '6502': {
    name: 'MOS 6502 Family',
    description: 'The 8-bit processor that powered the home computer revolution',
    icon: '🔷',
    color: '#FF6B6B',
    systems: ['commodore-64', 'nintendo-entertainment-system', 'apple-ii', 'atari-2600', 'acorn-bbc-micro', 
              'commodore-vic-20', 'atari-800', 'acorn-electron', 'commodore-plus4', 'atari-7800',
              'nintendo-super-nintendo', 'apple-iigs', 'nec-pc-engine', 'atari-lynx', 'tangerine-oric-1']
  },
  'z80': {
    name: 'Zilog Z80 Family',
    description: 'The versatile processor that dominated gaming and business computing',
    icon: '🔶',
    color: '#4ECDC4',
    systems: ['sinclair-zx-spectrum', 'msx', 'amstrad-cpc', 'sega-master-system', 'nintendo-game-boy',
              'msx2', 'coleco-colecovision', 'sega-game-gear', 'miles-gordon-sam-coupe', 
              'enterprise-computers-enterprise-64', 'nec-pc-88', 'sharp-x1', 'microbee-systems-microbee',
              'trs-80-model-i', 'mattel-aquarius', 'coleco-adam', 'bally-astrocade', 'jupiter-cantab-ace']
  },
  '68000': {
    name: 'Motorola 68000 Family',
    description: '16/32-bit powerhouse for graphics and multimedia',
    icon: '🔸',
    color: '#95E77E',
    systems: ['commodore-amiga', 'atari-st', 'sega-genesis', 'snk-neo-geo', 'sharp-x68000',
              'macintosh-68k', 'sinclair-ql', 'atari-jaguar', 'philips-cd-i']
  },
  'x86': {
    name: 'Intel x86 Family',
    description: 'The architecture that became the PC standard',
    icon: '🔹',
    color: '#FFE66D',
    systems: ['ibm-pc-dos', 'tandy-1000', 'fujitsu-fm-towns']
  },
  'arm': {
    name: 'ARM Architecture',
    description: 'The RISC revolution that changed computing',
    icon: '💎',
    color: '#FF6B9D',
    systems: ['acorn-archimedes']
  },
  '6809': {
    name: 'Motorola 6809',
    description: 'Advanced 8-bit processor with 16-bit capabilities',
    icon: '🔻',
    color: '#C44569',
    systems: ['trs-80-coco', 'dragon-data-dragon-32', 'thomson-to7']
  },
  'other': {
    name: 'Other Architectures',
    description: 'Unique and specialized processors',
    icon: '🔺',
    color: '#A8DADC',
    systems: ['ti-994a', 'mattel-intellivision', 'fairlight-cmi', 'elektronika-bk', 
              'panasonic-3do', 'bandai-wonderswan', 'arcade-boards']
  }
};

// Get system data for each architecture
const architectureData = {};
for (const [key, arch] of Object.entries(architectures)) {
  architectureData[key] = {
    ...arch,
    systemData: arch.systems
      .map(slug => activeSystems.find(s => s.slug === slug))
      .filter(Boolean)
      .sort((a, b) => {
        // Sort by medal tier first (platinum > gold > silver > bronze)
        const tierOrder = { platinum: 0, gold: 1, silver: 2, bronze: 3 };
        const tierA = tierOrder[a.data.medal_tier] ?? 4;
        const tierB = tierOrder[b.data.medal_tier] ?? 4;
        if (tierA !== tierB) return tierA - tierB;
        // Then by total lessons
        return (b.data.total_lessons || 0) - (a.data.total_lessons || 0);
      })
  };
}

// Count total systems and lessons per architecture
const stats = {};
for (const [key, data] of Object.entries(architectureData)) {
  const systems = data.systemData;
  stats[key] = {
    systemCount: systems.length,
    totalLessons: systems.reduce((sum, s) => sum + (s.data.total_lessons || 0), 0),
    platinumCount: systems.filter(s => s.data.medal_tier === 'platinum').length,
    goldCount: systems.filter(s => s.data.medal_tier === 'gold').length
  };
}

const getMedalEmoji = (tier) => {
  switch(tier) {
    case 'platinum': return '🏆';
    case 'gold': return '🥇';
    case 'silver': return '🥈';
    case 'bronze': return '🥉';
    default: return '';
  }
};
---

<Layout title="Architecture Learning Tracks | Code Like It's 198x">
  <main class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-green-400">
    <div class="container mx-auto px-4 py-12">
      <header class="text-center mb-12">
        <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-500">
          Architecture Learning Tracks
        </h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Master assembly programming by CPU architecture. Skills learned on one system transfer directly to others with the same processor family.
        </p>
      </header>

      <div class="grid gap-8 mb-12">
        {Object.entries(architectureData).map(([key, arch]) => (
          <div class="bg-gray-800 rounded-lg border-2 border-gray-700 hover:border-gray-600 transition-all">
            <a href={`/tracks/${key}/`} class="block p-8">
              <div class="flex items-start gap-6">
                <div class="text-6xl" style={`color: ${arch.color}`}>
                  {arch.icon}
                </div>
                <div class="flex-1">
                  <h2 class="text-3xl font-bold mb-2 text-white">
                    {arch.name}
                  </h2>
                  <p class="text-gray-400 mb-4">
                    {arch.description}
                  </p>
                  
                  <div class="flex gap-6 mb-4 text-sm">
                    <span class="text-gray-300">
                      <strong>{stats[key].systemCount}</strong> systems
                    </span>
                    <span class="text-gray-300">
                      <strong>{stats[key].totalLessons.toLocaleString()}</strong> total lessons
                    </span>
                    {stats[key].platinumCount > 0 && (
                      <span class="text-gray-300">
                        <strong>{stats[key].platinumCount}</strong> 🏆 platinum
                      </span>
                    )}
                    {stats[key].goldCount > 0 && (
                      <span class="text-gray-300">
                        <strong>{stats[key].goldCount}</strong> 🥇 gold
                      </span>
                    )}
                  </div>

                  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
                    {arch.systemData.slice(0, 10).map(system => (
                      <div class="bg-gray-900 rounded px-3 py-2 text-xs flex items-center gap-2">
                        <span>{getMedalEmoji(system.data.medal_tier)}</span>
                        <span class="text-gray-300 truncate">{system.data.name || system.data.title}</span>
                      </div>
                    ))}
                    {arch.systemData.length > 10 && (
                      <div class="bg-gray-900 rounded px-3 py-2 text-xs text-gray-500 italic">
                        +{arch.systemData.length - 10} more
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      <div class="bg-gray-800 rounded-lg p-8 border-2 border-gray-700">
        <h2 class="text-2xl font-bold mb-4 text-white">Why Learn by Architecture?</h2>
        <div class="grid md:grid-cols-2 gap-6 text-gray-300">
          <div>
            <h3 class="text-lg font-semibold mb-2 text-green-400">🔄 Transferable Skills</h3>
            <p class="text-sm">
              Assembly programming skills transfer directly between systems with the same CPU. 
              Master 6502 on the C64, then apply those skills to NES, Apple II, and Atari development.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-2 text-green-400">📈 Progressive Learning</h3>
            <p class="text-sm">
              Start with simpler systems and progress to more complex ones within the same architecture. 
              Each system adds new challenges while building on familiar foundations.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-2 text-green-400">🎯 Focused Mastery</h3>
            <p class="text-sm">
              Deep dive into one processor family to truly understand its instruction set, 
              timing characteristics, and optimization techniques.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-2 text-green-400">🏗️ Architecture Understanding</h3>
            <p class="text-sm">
              Learn how different manufacturers implemented the same CPU in unique ways, 
              from memory mapping to custom chips and peripherals.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  a:hover h2 {
    @apply text-green-400;
  }
</style>