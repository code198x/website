---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import MedalBadge from '../../components/MedalBadge.astro';

const allSystems = await getCollection('systems');

// Define the Z80 family systems
const systemZ80Slugs = [
  'sinclair-zx-spectrum', 'msx', 'amstrad-cpc', 'sega-master-system', 'nintendo-game-boy',
  'msx2', 'coleco-colecovision', 'sega-game-gear', 'miles-gordon-sam-coupe', 
  'enterprise-computers-enterprise-64', 'nec-pc-88', 'sharp-x1', 'microbee-systems-microbee',
  'trs-80-model-i', 'mattel-aquarius', 'coleco-adam', 'bally-astrocade', 'jupiter-cantab-ace'
];

const systems = systemZ80Slugs
  .map(slug => allSystems.find(s => s.slug === slug))
  .filter(Boolean)
  .filter(s => s.data.status !== 'vault')
  .sort((a, b) => {
    const tierOrder = { platinum: 0, gold: 1, silver: 2, bronze: 3 };
    const tierA = tierOrder[a.data.medal_tier] ?? 4;
    const tierB = tierOrder[b.data.medal_tier] ?? 4;
    if (tierA !== tierB) return tierA - tierB;
    return (b.data.total_lessons || 0) - (a.data.total_lessons || 0);
  });

const totalLessons = systems.reduce((sum, s) => sum + (s.data.total_lessons || 0), 0);
const totalGames = systems.reduce((sum, s) => sum + (s.data.total_games || 0), 0);

// Group by medal tier
const platinum = systems.filter(s => s.data.medal_tier === 'platinum');
const gold = systems.filter(s => s.data.medal_tier === 'gold');
const silver = systems.filter(s => s.data.medal_tier === 'silver');
const bronze = systems.filter(s => s.data.medal_tier === 'bronze');
---

<Layout title="Z80 Architecture Track | Code Like It's 198x">
  <main class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-green-400">
    <div class="container mx-auto px-4 py-12">
      <header class="mb-12">
        <div class="flex items-center gap-4 mb-4">
          <a href="/tracks/" class="text-gray-400 hover:text-green-400 transition">
            ← Back to Tracks
          </a>
        </div>
        <div class="flex items-center gap-6">
          <div class="text-6xl">🔶</div>
          <div>
            <h1 class="text-5xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-yellow-400">
              Zilog Z80 Family
            </h1>
            <p class="text-xl text-gray-300">
              The versatile processor that dominated gaming and business computing
            </p>
          </div>
        </div>
      </header>

      <div class="grid md:grid-cols-4 gap-6 mb-12">
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{systems.length}</div>
          <div class="text-gray-400">Systems</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{totalLessons.toLocaleString()}</div>
          <div class="text-gray-400">Total Lessons</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{totalGames.toLocaleString()}</div>
          <div class="text-gray-400">Games to Build</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">1976-2001</div>
          <div class="text-gray-400">Era Covered</div>
        </div>
      </div>

      <div class="bg-gray-800 rounded-lg p-8 mb-12 border-2 border-gray-700">
        <h2 class="text-2xl font-bold mb-4 text-white">About the Z80 Architecture</h2>
        <div class="prose prose-invert max-w-none text-gray-300">
          <p class="mb-4">
            The Zilog Z80, released in 1976, became one of the most successful 8-bit processors ever created. 
            Designed by Federico Faggin (who also worked on the Intel 8080), the Z80 improved upon the 8080 
            with more registers, better interrupt handling, and additional instructions while maintaining 
            backward compatibility.
          </p>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Key Characteristics</h3>
          <ul class="list-disc pl-6 space-y-2 mb-4">
            <li><strong>Extended instruction set:</strong> 158 instructions including block operations</li>
            <li><strong>Dual register banks:</strong> Main and alternate sets for fast context switching</li>
            <li><strong>16-bit operations:</strong> Despite being 8-bit, excellent 16-bit support</li>
            <li><strong>Memory refresh:</strong> Built-in DRAM refresh circuitry</li>
            <li><strong>Versatile addressing:</strong> 10 different addressing modes</li>
            <li><strong>Index registers:</strong> IX and IY for structured data access</li>
          </ul>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Register Architecture</h3>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Main registers:</strong> A, F, B, C, D, E, H, L (plus shadow set A', F', B', C', D', E', H', L')</li>
            <li><strong>Index registers:</strong> IX, IY for indexed addressing</li>
            <li><strong>Special registers:</strong> I (interrupt), R (refresh), SP (stack), PC (program counter)</li>
            <li><strong>Flag register:</strong> Zero, Carry, Sign, Parity/Overflow, Half-carry, Add/Subtract</li>
          </ul>
        </div>
      </div>

      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-white">Learning Path</h2>
        
        {platinum.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🏆</span>
              <span class="text-gray-300">Platinum Tier - Complete Mastery (4,096 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-2 gap-4">
              {platinum.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                    <span>{system.data.estimated_duration}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {gold.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🥇</span>
              <span class="text-gray-300">Gold Tier - Advanced Study (2,048 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-2 gap-4">
              {gold.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                    <span>{system.data.estimated_duration}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {silver.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🥈</span>
              <span class="text-gray-300">Silver Tier - Solid Foundation (1,024 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-3 gap-4">
              {silver.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {bronze.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
              <span>🥉</span>
              <span class="text-gray-300">Bronze Tier - Quick Start (512 lessons each)</span>
            </h3>
            <div class="grid md:grid-cols-3 gap-4">
              {bronze.map(system => (
                <a href={`/systems/${system.slug}/`} class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all">
                  <div class="flex items-start justify-between mb-3">
                    <h4 class="text-lg font-bold text-white">{system.data.name || system.data.title}</h4>
                    <MedalBadge tier={system.data.medal_tier} size="small" />
                  </div>
                  <p class="text-sm text-gray-400 mb-3">{system.data.year} • {system.data.manufacturer}</p>
                  <div class="flex gap-4 text-xs text-gray-500">
                    <span>{system.data.total_lessons} lessons</span>
                    <span>{system.data.total_games} games</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="bg-gradient-to-r from-orange-900 to-yellow-900 rounded-lg p-8 border-2 border-orange-700">
        <h2 class="text-2xl font-bold mb-4 text-white">Recommended Learning Path</h2>
        <div class="space-y-4 text-gray-300">
          <div class="flex gap-4">
            <div class="text-2xl">1️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Start with ZX Spectrum</h3>
              <p class="text-sm">The Spectrum's simple architecture and massive software library make it ideal for learning Z80 fundamentals. Master the basics of Z80 assembly with immediate visual feedback.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">2️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Progress to MSX for Standards</h3>
              <p class="text-sm">Learn structured development with MSX's standardized hardware and BIOS routines. Perfect for understanding how to write portable Z80 code.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">3️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Master Gaming with Sega Systems</h3>
              <p class="text-sm">Apply your skills to the Master System and Game Gear, learning sprite handling, scrolling, and professional game development techniques.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">4️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Challenge Yourself with Game Boy</h3>
              <p class="text-sm">The custom Sharp LR35902 (Z80 variant) and unique display system provide the ultimate test of your Z80 optimization skills.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>