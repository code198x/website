---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import MedalBadge from "../../components/MedalBadge.astro";

const allSystems = await getCollection("systems");

// Define the 6502 family systems
const system6502Slugs = [
  "commodore-64",
  "nintendo-entertainment-system",
  "apple-ii",
  "atari-2600",
  "acorn-bbc-micro",
  "commodore-vic-20",
  "atari-800",
  "acorn-electron",
  "commodore-plus4",
  "atari-7800",
  "nintendo-super-nintendo",
  "apple-iigs",
  "nec-pc-engine",
  "atari-lynx",
  "tangerine-oric-1",
  "commodore-pet-2001",
  "apple-i",
  "mos-technology-kim-1",
];

const systems = system6502Slugs
  .map((slug) => allSystems.find((s) => s.slug === slug))
  .filter(Boolean)
  .filter((s) => s.data.status !== "vault")
  .sort((a, b) => {
    const tierOrder = { platinum: 0, gold: 1, silver: 2, bronze: 3 };
    const tierA = tierOrder[a.data.medal_tier] ?? 4;
    const tierB = tierOrder[b.data.medal_tier] ?? 4;
    if (tierA !== tierB) return tierA - tierB;
    return (b.data.total_lessons || 0) - (a.data.total_lessons || 0);
  });

const totalLessons = systems.reduce((sum, s) => sum + (s.data.total_lessons || 0), 0);
const totalGames = systems.reduce((sum, s) => sum + (s.data.total_games || 0), 0);

// Group by medal tier
const platinum = systems.filter((s) => s.data.medal_tier === "platinum");
const gold = systems.filter((s) => s.data.medal_tier === "gold");
const silver = systems.filter((s) => s.data.medal_tier === "silver");
const bronze = systems.filter((s) => s.data.medal_tier === "bronze");
---

<Layout title="6502 Architecture Track | Code Like It's 198x">
  <main class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-green-400">
    <div class="container mx-auto px-4 py-12">
      <header class="mb-12">
        <div class="flex items-center gap-4 mb-4">
          <a href="/tracks/" class="text-gray-400 hover:text-green-400 transition">
            ← Back to Tracks
          </a>
        </div>
        <div class="flex items-center gap-6">
          <div class="text-6xl">🔷</div>
          <div>
            <h1
              class="text-5xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400"
            >
              MOS 6502 Family
            </h1>
            <p class="text-xl text-gray-300">
              The 8-bit processor that powered the home computer revolution
            </p>
          </div>
        </div>
      </header>

      <div class="grid md:grid-cols-4 gap-6 mb-12">
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{systems.length}</div>
          <div class="text-gray-400">Systems</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{totalLessons.toLocaleString()}</div>
          <div class="text-gray-400">Total Lessons</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">{totalGames.toLocaleString()}</div>
          <div class="text-gray-400">Games to Build</div>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 border-2 border-gray-700">
          <div class="text-3xl font-bold text-white">1975-1995</div>
          <div class="text-gray-400">Era Covered</div>
        </div>
      </div>

      <div class="bg-gray-800 rounded-lg p-8 mb-12 border-2 border-gray-700">
        <h2 class="text-2xl font-bold mb-4 text-white">About the 6502 Architecture</h2>
        <div class="prose prose-invert max-w-none text-gray-300">
          <p class="mb-4">
            The MOS Technology 6502 and its variants revolutionized computing by providing an
            affordable yet powerful 8-bit processor. Originally designed by Chuck Peddle and
            released in 1975 at just $25 (compared to $300 for competing processors), the 6502
            democratized computing.
          </p>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Key Characteristics</h3>
          <ul class="list-disc pl-6 space-y-2 mb-4">
            <li>
              <strong>Simple instruction set:</strong> Only 56 instructions, making it easy to learn
            </li>
            <li>
              <strong>Zero page addressing:</strong> Fast access to the first 256 bytes of memory
            </li>
            <li><strong>Three registers:</strong> Accumulator (A), Index X, and Index Y</li>
            <li>
              <strong>Efficient design:</strong> Fewer transistors meant lower cost and power consumption
            </li>
            <li>
              <strong>Pipeline architecture:</strong> Instructions could overlap for better performance
            </li>
          </ul>
          <h3 class="text-xl font-semibold mb-2 text-green-400">Common Variants</h3>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>6502:</strong> Original processor (Apple II, Commodore PET, Atari 2600)</li>
            <li><strong>6502A:</strong> Faster version at 2MHz (BBC Micro, Acorn Electron)</li>
            <li><strong>6510:</strong> Added I/O ports (Commodore 64)</li>
            <li>
              <strong>2A03:</strong> Custom Nintendo version with sound generation removed (NES)
            </li>
            <li><strong>65C02:</strong> CMOS version with additional instructions (Apple IIc)</li>
            <li><strong>65816:</strong> 16-bit extension (Apple IIGS, Super Nintendo)</li>
          </ul>
        </div>
      </div>

      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-white">Learning Path</h2>

        {
          platinum.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
                <span>🏆</span>
                <span class="text-gray-300">
                  Platinum Tier - Complete Mastery (4,096 lessons each)
                </span>
              </h3>
              <div class="grid md:grid-cols-2 gap-4">
                {platinum.map((system) => (
                  <a
                    href={`/systems/${system.slug}/`}
                    class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all"
                  >
                    <div class="flex items-start justify-between mb-3">
                      <h4 class="text-lg font-bold text-white">
                        {system.data.name || system.data.title}
                      </h4>
                      <MedalBadge tier={system.data.medal_tier} size="small" />
                    </div>
                    <p class="text-sm text-gray-400 mb-3">
                      {system.data.year} • {system.data.manufacturer}
                    </p>
                    <div class="flex gap-4 text-xs text-gray-500">
                      <span>{system.data.total_lessons} lessons</span>
                      <span>{system.data.total_games} games</span>
                      <span>{system.data.estimated_duration}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          gold.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
                <span>🥇</span>
                <span class="text-gray-300">Gold Tier - Advanced Study (2,048 lessons each)</span>
              </h3>
              <div class="grid md:grid-cols-2 gap-4">
                {gold.map((system) => (
                  <a
                    href={`/systems/${system.slug}/`}
                    class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all"
                  >
                    <div class="flex items-start justify-between mb-3">
                      <h4 class="text-lg font-bold text-white">
                        {system.data.name || system.data.title}
                      </h4>
                      <MedalBadge tier={system.data.medal_tier} size="small" />
                    </div>
                    <p class="text-sm text-gray-400 mb-3">
                      {system.data.year} • {system.data.manufacturer}
                    </p>
                    <div class="flex gap-4 text-xs text-gray-500">
                      <span>{system.data.total_lessons} lessons</span>
                      <span>{system.data.total_games} games</span>
                      <span>{system.data.estimated_duration}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          silver.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
                <span>🥈</span>
                <span class="text-gray-300">
                  Silver Tier - Solid Foundation (1,024 lessons each)
                </span>
              </h3>
              <div class="grid md:grid-cols-3 gap-4">
                {silver.map((system) => (
                  <a
                    href={`/systems/${system.slug}/`}
                    class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all"
                  >
                    <div class="flex items-start justify-between mb-3">
                      <h4 class="text-lg font-bold text-white">
                        {system.data.name || system.data.title}
                      </h4>
                      <MedalBadge tier={system.data.medal_tier} size="small" />
                    </div>
                    <p class="text-sm text-gray-400 mb-3">
                      {system.data.year} • {system.data.manufacturer}
                    </p>
                    <div class="flex gap-4 text-xs text-gray-500">
                      <span>{system.data.total_lessons} lessons</span>
                      <span>{system.data.total_games} games</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          bronze.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
                <span>🥉</span>
                <span class="text-gray-300">Bronze Tier - Quick Start (512 lessons each)</span>
              </h3>
              <div class="grid md:grid-cols-3 gap-4">
                {bronze.map((system) => (
                  <a
                    href={`/systems/${system.slug}/`}
                    class="block bg-gray-900 rounded-lg p-6 border-2 border-gray-800 hover:border-green-400 transition-all"
                  >
                    <div class="flex items-start justify-between mb-3">
                      <h4 class="text-lg font-bold text-white">
                        {system.data.name || system.data.title}
                      </h4>
                      <MedalBadge tier={system.data.medal_tier} size="small" />
                    </div>
                    <p class="text-sm text-gray-400 mb-3">
                      {system.data.year} • {system.data.manufacturer}
                    </p>
                    <div class="flex gap-4 text-xs text-gray-500">
                      <span>{system.data.total_lessons} lessons</span>
                      <span>{system.data.total_games} games</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div
        class="bg-gradient-to-r from-blue-900 to-cyan-900 rounded-lg p-8 border-2 border-blue-700"
      >
        <h2 class="text-2xl font-bold mb-4 text-white">Recommended Learning Path</h2>
        <div class="space-y-4 text-gray-300">
          <div class="flex gap-4">
            <div class="text-2xl">1️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Start with Commodore 64 or Apple II</h3>
              <p class="text-sm">
                These systems have extensive documentation, active communities, and forgiving
                hardware that's perfect for learning 6502 assembly basics.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">2️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Move to NES for Game Development</h3>
              <p class="text-sm">
                Apply your 6502 skills to create games with sprites, scrolling, and advanced
                graphics techniques on dedicated gaming hardware.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">3️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Explore Atari 2600 for Extreme Optimization</h3>
              <p class="text-sm">
                Challenge yourself with racing the beam programming and learn how to squeeze maximum
                performance from minimal hardware.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="text-2xl">4️⃣</div>
            <div>
              <h3 class="font-semibold text-white">Graduate to 65816 Systems</h3>
              <p class="text-sm">
                Extend your skills to 16-bit programming with the Apple IIGS or Super Nintendo,
                building on your solid 6502 foundation.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
