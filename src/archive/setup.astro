---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

// Get all setup guides
const setupGuides = await getCollection("setup");
const sortedSetupGuides = setupGuides.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Development Setup - Code Like It's 198x">
  <Breadcrumb segments={[{ text: "Setup", href: "/setup" }]} />

  <div class="container" style="padding-top: var(--space-2xl);">
    <header class="text-center" style="margin-bottom: var(--space-4xl);">
      <h1
        class="text-brand-green"
        style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--space-lg);"
      >
        Development Environment Setup
      </h1>
      <p
        style="font-size: 1.25rem; color: var(--text-secondary); max-width: 50rem; margin: 0 auto;"
      >
        Get your development environment ready for authentic retro assembly programming. Choose your
        system and follow our comprehensive Docker-based setup guide.
      </p>
    </header>

    <!-- System Selection -->
    <div class="feature-card" style="margin-bottom: var(--space-2xl);">
      <h2
        style="font-size: 1.75rem; font-weight: 700; margin-bottom: var(--space-lg); color: var(--text-inverse);"
      >
        Choose Your System
      </h2>
      <div class="system-selector">
        {
          sortedSetupGuides.map((guide) => (
            <button class="system-btn" data-system={guide.data.system}>
              <div style="font-size: 2rem; margin-bottom: var(--space-sm);">
                {guide.data.system === "commodore-64" && "💾"}
                {guide.data.system === "zx-spectrum" && "🖥️"}
                {guide.data.system === "commodore-amiga" && "🎨"}
                {guide.data.system === "nintendo-entertainment-system" && "🎮"}
              </div>
              <div style="font-weight: 600;">
                {guide.data.title.replace(" Development Setup", "")}
              </div>
              <div style="font-size: 0.875rem; opacity: 0.8;">
                {guide.data.system === "commodore-64" && "6502 Assembly"}
                {guide.data.system === "zx-spectrum" && "Z80 Assembly"}
                {guide.data.system === "commodore-amiga" && "68000 Assembly"}
                {guide.data.system === "nintendo-entertainment-system" && "6502 Assembly"}
              </div>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Setup Content -->
    <div id="setup-content">
      <!-- Default content -->
      <div class="text-center text-muted" style="padding: var(--space-4xl) 0;">
        <div style="font-size: 3rem; margin-bottom: var(--space-lg);">👆</div>
        <p style="font-size: 1.25rem;">Select a system above to see setup instructions</p>
      </div>
    </div>

    <!-- Dynamic Setup Guides -->
    {
      sortedSetupGuides.map(async (guide) => {
        const { Content } = await guide.render();
        const systemClass =
          guide.data.system === "commodore-64"
            ? "system-c64"
            : guide.data.system === "zx-spectrum"
              ? "system-zx"
              : guide.data.system === "commodore-amiga"
                ? "system-amiga"
                : "system-nes";

        return (
          <div id={`${guide.data.system}-setup`} class="setup-section hidden">
            <div class={`system-guide ${systemClass}`}>
              <div class="prose">
                <Content />
              </div>
            </div>
          </div>
        );
      })
    }

    <!-- Quick Links -->
    <div
      class="feature-section text-brand-green"
      style="background: var(--c64-green-dark); color: var(--text-inverse);"
    >
      <h2
        style="font-size: 1.75rem; font-weight: 700; margin-bottom: var(--space-lg); color: var(--c64-green-light);"
      >
        Start Learning
      </h2>
      <p style="margin-bottom: var(--space-xl); color: var(--c64-green-lighter);">
        Once you've set up your development environment, you're ready to start learning!
      </p>
      <div class="learning-grid">
        <a href="/lessons/commodore-64/phase-1/tier-1" class="learning-card c64-card">
          <div style="font-size: 2rem; margin-bottom: var(--space-sm);">💾</div>
          <div style="font-weight: 600;">C64 Lessons</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Start Phase 1</div>
        </a>
        <a href="/lessons/zx-spectrum/phase-1/tier-1" class="learning-card zx-card">
          <div style="font-size: 2rem; margin-bottom: var(--space-sm);">🖥️</div>
          <div style="font-weight: 600;">ZX Spectrum Lessons</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Start Phase 1</div>
        </a>
        <a href="/lessons/commodore-amiga/phase-1/tier-1" class="learning-card amiga-card">
          <div style="font-size: 2rem; margin-bottom: var(--space-sm);">🎨</div>
          <div style="font-weight: 600;">Amiga Lessons</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Start Phase 1</div>
        </a>
        <a
          href="/lessons/nintendo-entertainment-system/phase-1/tier-1"
          class="learning-card nes-card"
        >
          <div style="font-size: 2rem; margin-bottom: var(--space-sm);">🎮</div>
          <div style="font-weight: 600;">NES Lessons</div>
          <div style="font-size: 0.875rem; opacity: 0.8;">Start Phase 1</div>
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // System selection functionality
  document.addEventListener("DOMContentLoaded", function () {
    const systemButtons = document.querySelectorAll(".system-btn");
    const setupSections = document.querySelectorAll(".setup-section");
    const setupContent = document.getElementById("setup-content");

    systemButtons.forEach((button) => {
      button.addEventListener("click", function () {
        const system = this.dataset.system;

        // Hide all sections
        setupSections.forEach((section) => {
          section.classList.add("hidden");
        });

        // Hide default content
        setupContent.style.display = "none";

        // Show selected section
        const selectedSection = document.getElementById(system + "-setup");
        if (selectedSection) {
          selectedSection.classList.remove("hidden");
        }

        // Update button states
        systemButtons.forEach((btn) => {
          btn.classList.remove("ring-2", "ring-white");
        });
        this.classList.add("ring-2", "ring-white");
      });
    });
  });
</script>
