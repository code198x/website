---
import Layout from "../../layouts/Layout.astro";
import PlatformCard from "../../components/PlatformCard.astro";
import MedalBadge from "../../components/MedalBadge.astro";
import { getCollection } from "astro:content";

// Get all systems and organize by medal tier
const allSystems = await getCollection("systems");

// Separate active curriculum platforms from vault (historical reference) systems
const activeSystems = allSystems.filter((s) => s.data.status !== "vault");
const vaultSystems = allSystems.filter((s) => s.data.status === "vault");

const platformsByTier = {
  platinum: activeSystems.filter((s) => s.data.medal_tier === "platinum"),
  gold: activeSystems.filter((s) => s.data.medal_tier === "gold"),
  silver: activeSystems.filter((s) => s.data.medal_tier === "silver"),
  bronze: activeSystems.filter((s) => s.data.medal_tier === "bronze"),
  unclassified: activeSystems.filter((s) => !s.data.medal_tier),
};

const tierInfo = {
  platinum: {
    title: "Platinum Platforms",
    description:
      "Complete mastery programs with 4,096 lessons each. Perfect for deep learning and professional development.",
    icon: "🏆",
    duration: "6-12 months per platform",
    color: "from-gray-100 to-gray-50",
  },
  gold: {
    title: "Gold Platforms",
    description:
      "Major platforms with 2,048 lessons each. Build professional skills in 3-6 months.",
    icon: "🥇",
    duration: "3-6 months per platform",
    color: "from-yellow-50 to-white",
  },
  silver: {
    title: "Silver Platforms",
    description:
      "Important regional platforms with 1,024 lessons each. Gain solid understanding in 6-12 weeks.",
    icon: "🥈",
    duration: "6-12 weeks per platform",
    color: "from-gray-50 to-white",
  },
  bronze: {
    title: "Bronze Platforms",
    description: "Historical curiosities with 512 lessons each. Quick exploration in 2-4 weeks.",
    icon: "🥉",
    duration: "2-4 weeks per platform",
    color: "from-orange-50 to-white",
  },
};
---

<Layout title="Choose Your Platform">
  <div class="container mx-auto px-4 py-8">
    {/* Hero Section */}
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Platform Roadmap</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-4">
        Our ambitious vision for teaching assembly programming across vintage platforms.
      </p>
      <div
        class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 max-w-2xl mx-auto mb-8"
      >
        <p class="text-sm text-yellow-800 dark:text-yellow-200">
          <strong>🚧 Note:</strong> This is our planned curriculum. Currently, we have sample lessons
          for C64, NES, and ZX Spectrum. We're actively developing content and seeking contributors.
        </p>
      </div>

      {/* Current Status */}
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-md">
          <div class="text-3xl font-bold text-green-600">3</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Systems with Content</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-md">
          <div class="text-3xl font-bold text-blue-600">~10</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Current Lessons</div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-md">
          <div class="text-3xl font-bold text-purple-600">64</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Planned Platforms</div>
        </div>
      </div>

      {/* Medal Tier Overview */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {
          Object.entries(tierInfo).map(([tier, info]) => (
            <a
              href={`#${tier}-section`}
              class="
            block p-4 
            bg-white dark:bg-gray-800 
            rounded-lg shadow-md 
            hover:shadow-lg transition-shadow
            border-2 border-transparent
            hover:border-current
          "
            >
              <MedalBadge tier={tier as any} size="medium" showLabel={false} />
              <div class="mt-2 font-medium">{info.title.split(" ")[0]}</div>
              <div class="text-xs text-gray-600 dark:text-gray-400 mt-1">{info.duration}</div>
            </a>
          ))
        }
      </div>
    </div>

    {/* Platform Sections by Tier */}
    {
      Object.entries(tierInfo).map(([tier, info]) => {
        const platforms = platformsByTier[tier as keyof typeof platformsByTier];
        if (!platforms || platforms.length === 0) return null;

        return (
          <section id={`${tier}-section`} class="mb-16">
            <div
              class={`
            bg-gradient-to-r ${info.color} 
            dark:from-gray-800 dark:to-gray-900
            rounded-t-2xl p-6 border-b-4
          `}
            >
              <div class="flex items-center gap-4 mb-3">
                <MedalBadge tier={tier as any} size="large" />
                <div>
                  <h2 class="text-2xl md:text-3xl font-bold">{info.title}</h2>
                  <p class="text-gray-600 dark:text-gray-400 mt-1">{info.description}</p>
                </div>
              </div>
            </div>

            <div
              class="
            bg-white dark:bg-gray-800 
            rounded-b-2xl shadow-lg p-6
          "
            >
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {platforms
                  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
                  .map((platform) => (
                    <PlatformCard platform={platform.data} />
                  ))}
              </div>
            </div>
          </section>
        );
      })
    }

    {/* Unclassified Platforms (temporary during migration) */}
    {
      platformsByTier.unclassified.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-bold mb-4">Other Platforms (Classification Pending)</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {platformsByTier.unclassified.map((platform) => (
              <PlatformCard platform={platform.data} />
            ))}
          </div>
        </section>
      )
    }

    {/* Vault Section - Historical Reference Systems */}
    {
      vaultSystems.length > 0 && (
        <section class="mb-16">
          <div
            class="
          bg-gradient-to-r from-purple-100 to-purple-50 
          dark:from-gray-800 dark:to-gray-900
          rounded-t-2xl p-6 border-b-4 border-purple-300 dark:border-purple-700
        "
          >
            <div class="flex items-center gap-4 mb-3">
              <div class="text-3xl">🗄️</div>
              <div>
                <h2 class="text-2xl md:text-3xl font-bold">The Vault</h2>
                <p class="text-gray-600 dark:text-gray-400 mt-1">
                  Historical reference systems preserved for computing history. These pioneering
                  machines laid the foundation for the personal computer revolution.
                </p>
              </div>
            </div>
          </div>

          <div
            class="
          bg-white dark:bg-gray-800 
          rounded-b-2xl shadow-lg p-6
        "
          >
            <div class="mb-4 p-4 bg-purple-50 dark:bg-purple-900/20 rounded-lg">
              <p class="text-sm text-gray-700 dark:text-gray-300">
                <strong>Note:</strong> These systems do not have full curriculum support. They are
                preserved here as important milestones in computing history, providing context for
                the evolution of the platforms we actively teach.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {vaultSystems
                .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
                .map((platform) => (
                  <PlatformCard platform={platform.data} isVault={true} />
                ))}
            </div>
          </div>
        </section>
      )
    }

    {/* Learning Paths Section */}
    <section class="mt-16 bg-gray-50 dark:bg-gray-900 rounded-2xl p-8">
      <h2 class="text-2xl font-bold mb-6">Recommended Learning Paths</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">🚀 Quick Explorer</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
            Complete 3 Bronze platforms in one summer
          </p>
          <div class="text-xs">Virtual Boy → Channel F → Jupiter ACE</div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">💼 Professional Path</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
            Master one Gold platform for career skills
          </p>
          <div class="text-xs">Sega Genesis (3-6 months)</div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">🏆 Ultimate Master</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
            Complete one Platinum platform for total expertise
          </p>
          <div class="text-xs">Commodore 64 (6-12 months)</div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">🔧 6502 Architecture Track</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
            Master one CPU across multiple platforms
          </p>
          <div class="text-xs">C64 → Apple II → NES → Atari 800</div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">🌍 World Tour</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">One platform from each region</p>
          <div class="text-xs">C64 (US) → Spectrum (UK) → MSX (Japan)</div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">📚 Historical Journey</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
            Follow computing evolution chronologically
          </p>
          <div class="text-xs">Atari 2600 → C64 → Amiga → SNES</div>
        </div>
      </div>
    </section>
  </div>
</Layout>
