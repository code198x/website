---
import Layout from './Layout.astro';
import PageFrame from '../components/PageFrame.astro';
import ReadingLayout from '../components/ReadingLayout.astro';
const {frontmatter} = Astro.props;
const {title, description, sheet = false} = frontmatter;
const links = [['/try/', 'Guide'], ['/try/parents-and-teachers/', 'Parents and teachers'], ['/try/session-sheet/', 'Session sheet'], ['/try/feedback/', 'Feedback']];
---
<Layout title={title} description={description} breadcrumbs={[{label:'Start Here',href:'/start-here/'},{label:'Try Code198x',href:'/try/'}]}>
  <PageFrame as="article" class:list={['first-session', {'session-sheet':sheet}]}>
    <header class="guide-heading"><h1>{title}</h1></header>
    <nav class="guide-navigation" aria-label="First session pack">
      {links.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}
    </nav>
    {sheet && <button type="button" class="print-sheet">Print session sheet</button>}
    <ReadingLayout id="first-session-reading"><div class="guide-prose"><slot /></div></ReadingLayout>
  </PageFrame>
</Layout>
<script>
function bindPrint(){for(const button of document.querySelectorAll<HTMLButtonElement>('.print-sheet:not([data-ready])')){button.dataset.ready='true';button.addEventListener('click',()=>window.print());}}
bindPrint();document.addEventListener('astro:page-load',bindPrint);
</script>
<style>
@layer legacy {
.first-session {color:var(--h-ink);font-family:var(--h-font-ui);}
.guide-heading {margin-bottom:24px;}
.guide-heading h1 {font:700 clamp(2rem,4vw,3.5rem)/1.1 var(--h-font-ui);letter-spacing:-.025em;text-wrap:balance;max-width:24ch;}
.guide-navigation {display:flex;flex-wrap:wrap;gap:8px 24px;border-block:1px solid var(--h-line);padding-block:8px;margin-bottom:32px;}
.guide-navigation a {display:inline-flex;align-items:center;min-height:44px;color:var(--h-ink);font-size:16px;text-underline-offset:4px;}
.guide-navigation a[aria-current='page'] {font-weight:700;}
.first-session :global(a:focus-visible),.print-sheet:focus-visible {outline:3px solid var(--h-spot);outline-offset:4px;}
.guide-prose {max-width:70ch;color:var(--h-ink-body);font:400 18px/1.7 var(--h-font-ui);overflow-wrap:anywhere;}
.guide-prose :global(p),.guide-prose :global(ul),.guide-prose :global(ol) {margin:0 0 24px;}
.guide-prose :global(li) {margin-block:8px;}
.guide-prose :global(h2) {font:700 28px/1.25 var(--h-font-ui);color:var(--h-ink);margin:40px 0 16px;letter-spacing:-.02em;text-wrap:balance;scroll-margin-top:120px;}
.guide-prose :global(a) {color:var(--h-ink);text-underline-offset:4px;}
.guide-prose :global(table) {width:100%;border-collapse:collapse;margin-block:24px;font-size:16px;}
.guide-prose :global(th),.guide-prose :global(td) {text-align:left;vertical-align:top;border-bottom:1px solid var(--h-line);padding:12px 8px;}
.guide-prose :global(code) {font-family:var(--h-font-mono);font-size:.9em;}
.print-sheet {font:600 16px/1.5 var(--h-font-ui);min-height:44px;padding:10px 16px;border:1px solid var(--h-ink);color:var(--h-ink);background:var(--h-ground);margin-bottom:24px;cursor:pointer;}
.session-sheet .guide-prose :global(.response) {min-height:64px;border-bottom:1px solid var(--h-line);margin-bottom:20px;}
.session-sheet .guide-prose :global(.lesson-addresses) {font-size:14px;}
@media(max-width:600px){.guide-prose :global(table){font-size:14px}.guide-prose :global(th),.guide-prose :global(td){padding:8px 4px}}
@media print {
 :global(body:has(.first-session) .breadcrumbs),:global(body:has(.first-session) .site-header),:global(body:has(.first-session) .footer){display:none!important;}
 .first-session {padding:0!important;max-width:none;}
 .guide-navigation,.print-sheet,.first-session :global(.reading-toc){display:none!important;}
 .first-session :global(.reading-layout){display:block;}
 .guide-prose {max-width:none;font-size:11pt;line-height:1.4;color:black;}
 .guide-prose :global(h2){font-size:15pt;break-after:avoid;margin:20pt 0 8pt;}
 .guide-prose :global(p){margin-bottom:10pt;orphans:3;widows:3;}
 .guide-prose :global(a[href^='http']::after){content:none!important;}
 .guide-heading h1 {font-size:24pt;}
 .guide-heading {margin-bottom:12pt;}
 .session-sheet .guide-prose {font-size:10pt;line-height:1.3;}
 .session-sheet .guide-prose :global(h2){font-size:12pt;margin:12pt 0 4pt;}
 .session-sheet .guide-prose :global(p){margin-bottom:6pt;}
 .session-sheet .guide-prose :global(.response){min-height:22pt;margin-bottom:6pt;break-inside:avoid;}
 .session-sheet .guide-prose :global(.lesson-addresses){font-size:8pt;break-inside:avoid;}
 .session-sheet .guide-prose :global(.sheet-links){display:none;}
}
}
</style>
