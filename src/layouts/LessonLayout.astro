---
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <slot />
</Layout>

<style>
  /* ============================================
     LESSON LAYOUT STYLES
     Individual lesson pages with content and navigation
     ============================================ */

  /* Lesson Content Wrapper */
  :global(.lesson-content-wrapper) {
    margin: 0 auto var(--space-4xl);
    padding: var(--space-3xl) var(--space-4xl);
    background: var(--gradient-subtle);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    max-width: 1200px;
    width: calc(100% - var(--space-xl));
  }

  /* Lesson Prose Content - Full width for lessons */
  :global(.lesson-prose) {
    max-width: 100%;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  /* Enhanced typography for lesson content */
  :global(.lesson-prose h1),
  :global(.lesson-prose h2),
  :global(.lesson-prose h3),
  :global(.lesson-prose h4),
  :global(.lesson-prose h5),
  :global(.lesson-prose h6) {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
  }

  :global(.lesson-prose h1) {
    font-size: 2.25rem;
    font-weight: var(--font-weight-bold);
    margin-top: 0;
    margin-bottom: var(--space-xl);
  }

  :global(.lesson-prose h2) {
    font-size: 1.875rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-sm);
    margin-top: var(--space-3xl);
  }

  :global(.lesson-prose h3) {
    font-size: 1.5rem;
    margin-top: var(--space-2xl);
  }

  :global(.lesson-prose h4) {
    font-size: 1.25rem;
  }

  :global(.lesson-prose p) {
    margin-bottom: var(--space-lg);
    line-height: 1.75;
  }

  :global(.lesson-prose ul) {
    list-style-type: disc;
    margin: var(--space-lg) 0;
    padding-left: var(--space-xl);
  }

  :global(.lesson-prose ol) {
    list-style-type: decimal;
    margin: var(--space-lg) 0;
    padding-left: var(--space-xl);
  }

  :global(.lesson-prose li) {
    margin-bottom: var(--space-sm);
    line-height: 1.7;
    color: var(--color-text);
  }

  :global(.lesson-prose li::marker) {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }

  :global(.lesson-prose blockquote) {
    border-left: 4px solid var(--color-primary);
    background: var(--gradient-light);
    padding: var(--space-lg) var(--space-xl);
    margin: var(--space-xl) 0;
    border-radius: var(--radius-md);
    font-style: italic;
    box-shadow: var(--shadow-sm);
  }

  /* Code styling for lessons */
  :global(.lesson-prose code) {
    background: var(--color-bg-secondary);
    padding: 3px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.925em;
    color: #e11d48;
    border: 1px solid var(--color-border-light);
  }

  :global(.lesson-prose pre) {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    overflow-x: auto;
    margin: var(--space-xl) 0;
    position: relative;
    box-shadow: var(--shadow-inner);
  }

  :global(.lesson-prose pre code) {
    background: transparent;
    border: none;
    color: var(--color-text);
    padding: 0;
  }

  /* Tables for lesson content */
  :global(.lesson-prose table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-xl) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  :global(.lesson-prose th),
  :global(.lesson-prose td) {
    padding: var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.lesson-prose th) {
    background: var(--color-bg-secondary);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  :global(.lesson-prose tr:last-child td) {
    border-bottom: none;
  }

  /* Images in lessons */
  :global(.lesson-prose img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    margin: var(--space-lg) 0;
  }

  /* Interactive elements */
  :global(.lesson-callout) {
    background: var(--gradient-primary-subtle);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
    position: relative;
  }

  :global(.lesson-callout::before) {
    content: "💡";
    position: absolute;
    top: var(--space-lg);
    left: var(--space-lg);
    font-size: 1.25rem;
  }

  :global(.lesson-callout-content) {
    margin-left: var(--space-xl);
  }

  :global(.lesson-warning) {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--color-danger);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
    position: relative;
  }

  :global(.lesson-warning::before) {
    content: "⚠️";
    position: absolute;
    top: var(--space-lg);
    left: var(--space-lg);
    font-size: 1.25rem;
  }

  :global(.lesson-warning-content) {
    margin-left: var(--space-xl);
  }

  /* Code execution examples */
  :global(.code-example) {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin: var(--space-xl) 0;
    overflow: hidden;
  }

  :global(.code-example-header) {
    background: var(--gradient-primary-subtle);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-dark);
  }

  :global(.code-example-content) {
    padding: var(--space-lg);
  }

  /* Learning Objectives Section */
  :global(.lesson-objectives-section) {
    margin: 0 auto var(--space-3xl);
    padding: var(--space-2xl);
    background: var(--gradient-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    max-width: 1200px;
    width: calc(100% - var(--space-xl));
  }

  :global(.lesson-objectives-header) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  :global(.lesson-objectives-icon) {
    font-size: 1.5rem;
  }

  :global(.lesson-objectives-title) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
  }

  :global(.lesson-objectives-list) {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  :global(.lesson-objectives-item) {
    position: relative;
    padding-left: var(--space-xl);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  :global(.lesson-objectives-item::before) {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: var(--font-weight-bold);
    font-size: 1.2rem;
  }

  /* Lesson navigation */
  :global(.lesson-nav-section) {
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-xl);
    max-width: 1200px;
  }

  :global(.lesson-nav) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  :global(.lesson-nav__link) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-xl);
    background: var(--gradient-subtle);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: var(--shadow-sm);
    flex: 1;
  }

  :global(.lesson-nav__link:hover) {
    transform: translateY(-4px) scale(1.02);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
    background: var(--gradient-primary-subtle);
  }

  :global(.lesson-nav__link span) {
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  :global(.lesson-nav__label) {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  :global(.lesson-nav__title) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    font-size: var(--font-size-base);
  }

  :global(.lesson-nav__link--next) {
    flex-direction: row-reverse;
    text-align: right;
  }

  :global(.lesson-nav__link--complete) {
    justify-content: center;
    background: var(--gradient-primary-subtle);
    border-color: var(--color-success);
  }

  :global(.lesson-nav__link--complete:hover) {
    border-color: var(--color-success-dark);
    transform: translateY(-6px) scale(1.03);
  }

  /* Progress indicator */
  :global(.lesson-progress) {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  :global(.lesson-progress-bar) {
    background: var(--color-border);
    height: 6px;
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-sm);
  }

  :global(.lesson-progress-fill) {
    background: var(--gradient-primary);
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  :global(.lesson-progress-text) {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-align: center;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    :global(.lesson-prose) {
      font-size: 1rem;
      line-height: 1.7;
    }

    :global(.lesson-prose h1) {
      font-size: 1.75rem;
    }

    :global(.lesson-prose h2) {
      font-size: 1.5rem;
    }

    :global(.lesson-prose h3) {
      font-size: 1.25rem;
    }

    :global(.lesson-callout),
    :global(.lesson-warning) {
      padding: var(--space-md);
    }

    :global(.lesson-callout-content),
    :global(.lesson-warning-content) {
      margin-left: var(--space-lg);
    }

    :global(.lesson-navigation) {
      flex-direction: column;
      gap: var(--space-md);
    }

    :global(.lesson-nav-button) {
      width: 100%;
      justify-content: center;
    }
  }
</style>