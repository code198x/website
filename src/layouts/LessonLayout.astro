---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import PrismLoader from '../components/PrismLoader.astro';

export interface Props {
  frontmatter: {
    title: string;
    platform?: string;
    system?: string;
    phase?: number;
    phase_number?: number;
    tier?: number;
    tier_number?: number;
    lesson?: number;
    lesson_number?: number;
    description?: string;
    difficulty?: string;
    estimated_duration?: string;
    programs?: Array<{
      number: number;
      title: string;
      code: string;
      explanation: string;
      language?: string;
    }>;
    challenges?: string[];
    common_problems?: Array<{
      problem: string;
      solution: string;
    }>;
    fun_fact?: string;
    next_lesson_preview?: string;
    download_links?: Array<{
      name: string;
      url: string;
      type: string;
    }>;
  };
}

const { frontmatter } = Astro.props;

// Determine if this is a Phase 0 lesson
const isPhase0 = frontmatter.phase === 0 || frontmatter.phase_number === 0;
const platform = frontmatter.platform || frontmatter.system || 'unknown';
const phase = frontmatter.phase || frontmatter.phase_number || 0;
const tier = frontmatter.tier || frontmatter.tier_number || 1;
const lesson = frontmatter.lesson || frontmatter.lesson_number || 1;

// Platform display names and languages
const platformInfo = {
  'c64': { 
    name: 'Commodore 64', 
    lang: 'basic',
    color: 'border-c64-blue',
    bgColor: 'bg-c64-blue/10',
    textColor: 'text-c64-blue'
  },
  'spectrum': { 
    name: 'ZX Spectrum', 
    lang: 'basic',
    color: 'border-spectrum-blue',
    bgColor: 'bg-spectrum-blue/10', 
    textColor: 'text-spectrum-blue'
  },
  'amiga': { 
    name: 'Commodore Amiga', 
    lang: 'amos',
    color: 'border-amiga-orange',
    bgColor: 'bg-amiga-orange/10',
    textColor: 'text-amiga-orange'
  },
  'bbcmicro': { 
    name: 'BBC Micro', 
    lang: 'basic',
    color: 'border-red-600',
    bgColor: 'bg-red-50',
    textColor: 'text-red-600'
  },
  'amstradcpc': { 
    name: 'Amstrad CPC', 
    lang: 'basic',
    color: 'border-green-600',
    bgColor: 'bg-green-50',
    textColor: 'text-green-600'
  },
  'appleii': { 
    name: 'Apple II', 
    lang: 'basic',
    color: 'border-blue-600',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-600'
  },
  'atarist': { 
    name: 'Atari ST', 
    lang: 'basic',
    color: 'border-gray-600',
    bgColor: 'bg-gray-50',
    textColor: 'text-gray-600'
  },
  'atari800': { 
    name: 'Atari 800', 
    lang: 'basic',
    color: 'border-red-700',
    bgColor: 'bg-red-50',
    textColor: 'text-red-700'
  },
  'ti994a': { 
    name: 'TI-99/4A', 
    lang: 'basic',
    color: 'border-blue-700',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-700'
  },
  'dragon': { 
    name: 'Dragon 32/64', 
    lang: 'basic',
    color: 'border-yellow-700',
    bgColor: 'bg-yellow-50',
    textColor: 'text-yellow-700'
  },
  'jupiterace': { 
    name: 'Jupiter ACE', 
    lang: 'forth',
    color: 'border-purple-600',
    bgColor: 'bg-purple-50',
    textColor: 'text-purple-600'
  }
};

const currentPlatform = platformInfo[platform as keyof typeof platformInfo] || {
  name: platform.toUpperCase(),
  lang: 'basic',
  color: 'border-gray-600',
  bgColor: 'bg-gray-50',
  textColor: 'text-gray-600'
};

// Navigation helpers
const prevLesson = lesson > 1 ? lesson - 1 : null;
const nextLesson = lesson < 16 ? lesson + 1 : null;

const title = isPhase0 ? 
  `${frontmatter.title} | ${currentPlatform.name} Phase ${phase} Tier ${tier}` :
  frontmatter.title;
---

<Layout title={title} description={frontmatter.description}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    
    <!-- Phase 0 Header -->
    {isPhase0 && (
      <div class={`mb-8 p-6 rounded-xl border-2 ${currentPlatform.color} ${currentPlatform.bgColor}`}>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h1 class={`text-2xl font-bold ${currentPlatform.textColor}`}>
              {currentPlatform.name} - Phase 0
            </h1>
            <p class="text-gray-600">
              Tier {tier} • Lesson {lesson}
            </p>
          </div>
          <div class="text-right">
            <div class={`text-3xl font-mono font-bold ${currentPlatform.textColor}`}>
              {String(lesson).padStart(2, '0')}
            </div>
            <div class="text-sm text-gray-500">of 16</div>
          </div>
        </div>
        
        <!-- Progress bar -->
        <div class="w-full bg-gray-200 rounded-full h-2">
          <div 
            class={`h-2 rounded-full ${currentPlatform.textColor.replace('text-', 'bg-')}`}
            style={`width: ${(lesson / 16) * 100}%`}
          ></div>
        </div>
      </div>
    )}

    <!-- Navigation breadcrumbs -->
    {isPhase0 && (
      <nav class="mb-6 text-sm">
        <ol class="flex items-center space-x-2 text-gray-500">
          <li><a href="/lessons" class="hover:text-gray-700">Lessons</a></li>
          <li class="before:content-['/'] before:mx-2">
            <a href={`/lessons/${platform}`} class="hover:text-gray-700">{currentPlatform.name}</a>
          </li>
          <li class="before:content-['/'] before:mx-2">
            <a href={`/lessons/${platform}/phase-0`} class="hover:text-gray-700">Phase 0</a>
          </li>
          <li class="before:content-['/'] before:mx-2">
            <a href={`/lessons/${platform}/phase-0/tier-${tier}`} class="hover:text-gray-700">Tier {tier}</a>
          </li>
          <li class="before:content-['/'] before:mx-2">
            <span class="text-gray-700">Lesson {lesson}</span>
          </li>
        </ol>
      </nav>
    )}

    <!-- Main content -->
    <article class="prose prose-lg max-w-none">
      <slot />
    </article>

    <!-- Phase 0 specific sections -->
    {isPhase0 && (
      <>
        <!-- What You Learned -->
        {frontmatter.programs && frontmatter.programs.length > 0 && (
          <section class="mt-12 p-6 bg-green-50 rounded-xl border border-green-200">
            <h2 class="text-xl font-bold text-green-800 mb-4">What You Learned</h2>
            <ul class="space-y-2">
              {frontmatter.programs.map(program => (
                <li class="flex items-start">
                  <span class="text-green-600 mr-2">✓</span>
                  <span>{program.title}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Try These Challenges -->
        {frontmatter.challenges && frontmatter.challenges.length > 0 && (
          <section class="mt-8 p-6 bg-blue-50 rounded-xl border border-blue-200">
            <h2 class="text-xl font-bold text-blue-800 mb-4">Try These Challenges</h2>
            <ul class="space-y-2">
              {frontmatter.challenges.map(challenge => (
                <li class="flex items-start">
                  <span class="text-blue-600 mr-2">□</span>
                  <span>{challenge}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Common Problems -->
        {frontmatter.common_problems && frontmatter.common_problems.length > 0 && (
          <section class="mt-8 p-6 bg-yellow-50 rounded-xl border border-yellow-200">
            <h2 class="text-xl font-bold text-yellow-800 mb-4">Common Problems</h2>
            <div class="space-y-4">
              {frontmatter.common_problems.map(item => (
                <div>
                  <h3 class="font-bold text-yellow-800">{item.problem}</h3>
                  <p class="text-yellow-700 mt-1">{item.solution}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Fun Fact -->
        {frontmatter.fun_fact && (
          <section class="mt-8 p-6 bg-purple-50 rounded-xl border border-purple-200">
            <h2 class="text-xl font-bold text-purple-800 mb-4">Fun Fact</h2>
            <p class="text-purple-700">{frontmatter.fun_fact}</p>
          </section>
        )}

        <!-- Download Links -->
        {frontmatter.download_links && frontmatter.download_links.length > 0 && (
          <section class="mt-8 p-6 bg-gray-50 rounded-xl border border-gray-200">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Download This Lesson</h2>
            <p class="text-gray-600 mb-4">Get the complete programs:</p>
            <div class="flex flex-wrap gap-3">
              {frontmatter.download_links.map(link => (
                <a 
                  href={link.url}
                  class={`px-4 py-2 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
                >
                  {link.name} (.{link.type})
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Navigation -->
        <div class="mt-12 flex justify-between items-center">
          <div>
            {prevLesson && (
              <a 
                href={`/lessons/${platform}/phase-0/tier-${tier}/lesson-${String(prevLesson).padStart(2, '0')}`}
                class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
              >
                ← Previous Lesson
              </a>
            )}
          </div>
          
          <div>
            <a 
              href={`/lessons/${platform}/phase-0/tier-${tier}`}
              class="px-6 py-3 rounded-lg font-medium text-gray-600 bg-gray-100 border border-gray-300 hover:bg-gray-200 transition-colors"
            >
              Back to Tier {tier}
            </a>
          </div>
          
          <div>
            {nextLesson ? (
              <a 
                href={`/lessons/${platform}/phase-0/tier-${tier}/lesson-${String(nextLesson).padStart(2, '0')}`}
                class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
              >
                Next Lesson →
              </a>
            ) : tier < 8 ? (
              <a 
                href={`/lessons/${platform}/phase-0/tier-${tier + 1}`}
                class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
              >
                Next Tier →
              </a>
            ) : (
              <a 
                href={`/lessons/${platform}/phase-1`}
                class={`inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors ${currentPlatform.textColor} ${currentPlatform.bgColor} border ${currentPlatform.color} hover:bg-opacity-20`}
              >
                Begin Phase 1 →
              </a>
            )}
          </div>
        </div>

        <!-- Next lesson preview -->
        {frontmatter.next_lesson_preview && (
          <div class="mt-8 p-4 bg-gray-100 rounded-lg border-l-4 border-gray-400">
            <h3 class="font-bold text-gray-700 mb-2">Next Lesson Preview</h3>
            <p class="text-gray-600">{frontmatter.next_lesson_preview}</p>
          </div>
        )}
      </>
    )}
  </div>

  <!-- Load Prism for syntax highlighting -->
  <PrismLoader />
  
  <!-- Custom styles for ASCII art and retro formatting -->
  <style>
    /* Preserve ASCII art formatting */
    article pre {
      font-family: 'Courier New', monospace;
      font-size: 0.875rem;
      line-height: 1.2;
      white-space: pre;
      overflow-x: auto;
      background: #1a1a1a;
      color: #00ff00;
      padding: 1rem;
      border-radius: 0.5rem;
      border: 2px solid #333;
    }
    
    /* ASCII art boxes */
    article pre:first-of-type {
      background: #000;
      color: #00ff41;
      text-align: center;
      font-weight: bold;
    }
    
    /* Code blocks with language */
    article pre[class*="language-"] {
      background: #2d2d2d;
      color: #f8f8f2;
    }
    
    /* BASIC syntax highlighting */
    .language-basic .token.keyword {
      color: #ff6b6b;
      font-weight: bold;
    }
    
    .language-basic .token.number {
      color: #4ecdc4;
    }
    
    .language-basic .token.string {
      color: #95e1d3;
    }
    
    /* Output formatting */
    article pre + pre {
      background: #000;
      color: #00ff00;
      margin-top: -0.5rem;
    }
  </style>
</Layout>