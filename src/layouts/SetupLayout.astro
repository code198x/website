---
import Layout from './Layout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getPlatformBySlug, getSpotColour } from '../lib/platforms';
import '../styles/setup.css';
interface Props { title: string; description: string; systemSlug?: string; alternative?: boolean }
const { title, description, systemSlug, alternative = false } = Astro.props;
const system = systemSlug ? await getPlatformBySlug(systemSlug) : undefined;
const breadcrumbs = [
  {label: 'Home', href: '/'},
  ...(system ? [{label: 'Setup', href: '/setup/'}, {label: system.data.name, ...(alternative ? {href: `/systems/${systemSlug}/getting-started/`} : {})}, ...(alternative ? [{label: 'Alternative tools'}] : [])] : [{label: 'Setup'}]),
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs} spotColor={getSpotColour(system)}>
  <slot name="opening" />
  <article class="setup-page">
    {Astro.slots.has('opening') ? <p class="setup-opening-lead">{description}</p> : <header class="setup-header"><h1>{title}</h1><p>{description}</p></header>}
    <div class="setup-reading">
      <aside class="setup-contents"><TableOfContents selector=".setup-content" platformColor="var(--h-spot-ink)" headingSelector="h2, h3:not(.tab-panel h3)" /></aside>
      <div class="setup-content"><slot /></div>
    </div>
  </article>
</Layout>
<script>
  import { initListings } from '../lib/lesson-listing';
  initListings();
  document.addEventListener('astro:page-load', () => initListings());
</script>

<style>
@layer legacy {
:global(main#main-content[data-site-frame]:has(> .setup-opening)) { max-width: none; }
.setup-opening-lead { font: var(--h-text-lead)/var(--h-lh-lead) var(--h-font-read); margin: 0 0 2.5rem; max-width: 65ch; }
}
</style>

<style>
@layer legacy {
:global(main#main-content[data-site-frame]:has(> .setup-opening) > .setup-page) { max-width: var(--site-frame-width); margin-inline: auto; min-width: 0; overflow-wrap: anywhere; }
}
</style>
