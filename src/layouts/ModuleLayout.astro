---
import { unitSlug } from '../lib/units';
/**
 * Game landing — presentation of module metadata and authored content.
 *
 * The conversion surface: inside a system, so the platform identity returns
 * (rainbow + scanline/pixel wash on the Spectrum; system-colour bar elsewhere).
 * Sell the game (the MDX body carries the pitch, "what it proves" and lineage —
 * author prose, not a fabricated schema), then put the "Begin Unit 1" CTA and the
 * tools where the eye lands, with the unit roadmap as the substance below.
 *
 * Everything structural is driven by existing data: units/phases from the units
 * collection (assembly has them; BASIC degrades to a flat list / no roadmap), and
 * tools from the platforms manifest. Track is carried in the URL throughout.
 */
import Layout from './Layout.astro';
import { getPlatformBySlug } from '../lib/platforms';
import { getUnitsEntry } from '../lib/units';
import { getModules } from '../lib/modules';
import { whiteSafeFill } from '../lib/contrast';

export interface Props {
  title: string;
  description?: string;
  system?: string;
  game?: number;
  gameName?: string;
  totalUnits?: number;
  heroImage?: string;
  heroAlt?: string;
  units?: Array<{ number: number; title: string; available: boolean; description?: string; thumbnail?: string }>;
  phases?: Array<{ name: string; description?: string; hours?: string; start: number; end: number }>;
}

const frontmatter = Astro.props.frontmatter || Astro.props;
const {
  title = 'Untitled Game',
  description = '',
  game = 1,
  gameName = '',
  heroImage = '',
  heroAlt = '',
  totalUnits: frontmatterTotalUnits = 8,
  units: frontmatterUnits = [],
  phases: frontmatterPhases = [],
} = frontmatter;

const currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
// Systems live under /systems/; sections do not. Drop the prefix so every
// positional read below means the same thing for both. Without this the reads
// silently return "systems" as the machine rather than failing.
if (pathParts[0] === 'systems') pathParts.shift();
const platformSlug = pathParts[0] || '';
const trackPath = pathParts[1] || 'assembly';
const moduleSlugFromPath = pathParts[2] || '';

const unitsEntry = await getUnitsEntry(platformSlug, trackPath as 'assembly' | 'basic' | 'amos' | 'blitz' | 'machine', moduleSlugFromPath);
// Canonical unit data only exists for tracks with a units-collection entry (assembly today).
// BASIC games carry their lessons as unit MDX without a units.yaml, so the layout must not
// invent counts for them — gate every count/progress/roadmap surface on this flag.
const hasUnitsData = !!unitsEntry;
const units = unitsEntry?.data.units ?? [];
const phases = unitsEntry?.data.phases ?? frontmatterPhases;
const totalUnits = units.length;
const getUnitsForPhase = (start: number, end: number) => units.filter(u => u.number >= start && u.number <= end);

const availableUnits = units.filter(u => u.available).length;
const progressPercent = totalUnits > 0 ? (availableUnits / totalUnits) * 100 : 0;
const languagePath = trackPath;

// Games catalogue status (drives "Begin" when there's no canonical units data, e.g. BASIC).
const catalogue = await getModules(platformSlug, trackPath as 'assembly' | 'basic' | 'amos' | 'blitz' | 'machine');
const catalogueGame = catalogue.find(g => g.slug === moduleSlugFromPath) ?? catalogue.find(g => g.number === game);
const gameLaunched = catalogueGame?.status === 'complete' || catalogueGame?.status === 'in-progress';

const platform = await getPlatformBySlug(platformSlug);
const systemColor = platform?.data.color ?? '#3b82f6';
// Brand colours are chosen for chrome, not as a bed for white text. Darken
// just enough that white passes AA on them; borders keep the raw colour.
const systemFill = whiteSafeFill(systemColor);
const platformName = platform?.data.shortName ?? platformSlug;
const isSpectrum = platformSlug === 'sinclair-zx-spectrum';

const TRACK_LABEL: Record<string, string> = { assembly: 'Assembly', basic: 'BASIC', amos: 'AMOS' };
const trackLabel = TRACK_LABEL[trackPath] ?? trackPath;
const cpuArch = (platform?.data.cpuArchitecture ?? '').toUpperCase();
const stamp = trackPath === 'basic' ? 'BASIC' : (cpuArch || trackLabel);

const displayGameName = gameName || title;
const gameNum = String(game).padStart(2, '0');
const firstUnitHref = `/systems/${platformSlug}/${languagePath}/${moduleSlugFromPath}/unit-01`;
const hasRoadmap = units.length > 0;
const beginnable = hasUnitsData ? Boolean(units[0]?.available) : gameLaunched;

// Tools from the manifest — honest per track
const tools = [
  platform?.data.emulator ? { k: 'Emulator', v: platform.data.emulator } : null,
  { k: 'Language', v: trackPath === 'basic' ? `${platformName} BASIC` : `${cpuArch} assembly` },
  trackPath !== 'basic' && platform?.data.assembler ? { k: 'Assembler', v: platform.data.assembler } : null,
  platform?.data.buildOutput ? { k: 'Output', v: platform.data.buildOutput } : null,
].filter(Boolean) as Array<{ k: string; v: string }>;
---

<Layout title={`${displayGameName} · ${platformName} ${trackLabel}`} platformColor={systemColor}>
  <div class="wrap" style={`--sys: ${systemColor}; --sys-fill: ${systemFill};`}>

    <!-- HERO with pixel-grid + scanline wash -->
    <section class={`hero ${isSpectrum ? 'spectrum' : ''}`}>
      <div class="in">
        <div class="k">
          <span class="eyebrow">{platformName} · {trackLabel}{game > 0 && ` · Game ${gameNum}`}</span>
          {stamp && <span class="stamp">{stamp}</span>}
          {hasUnitsData && totalUnits > 0 && <span class="liveunits">● {availableUnits} of {totalUnits} units live</span>}
        </div>
        <h1>{displayGameName}</h1>
        {isSpectrum
          ? <div class="rainbow bar"><div class="r"></div><div class="y"></div><div class="g"></div><div class="c"></div></div>
          : <div class="sysbar"></div>}
        {description && <p class="pitch">{description}</p>}
      </div>
    </section>

    <div class="grid">
      <!-- MAIN -->
      <div class="main">
        {heroImage && (
          <img src={heroImage} alt={heroAlt} class="hero-shot" />
        )}
        <div class="prose"><slot /></div>

        {hasRoadmap && (
          <section class="roadmap">
            <h2>Unit roadmap</h2>
            {phases.length > 0 ? (
              phases.map((phase, phaseIndex) => {
                const phaseUnits = getUnitsForPhase(phase.start, phase.end);
                if (phaseUnits.length === 0) return null;
                const phaseAvailableCount = phaseUnits.filter(u => u.available).length;
                const isComplete = phaseAvailableCount === phaseUnits.length;
                const isAvailable = phaseAvailableCount > 0;
                return (
                  <div class={`phase ${isAvailable ? 'on' : 'off'}`}>
                    <div class="phead">
                      <div class="pinfo">
                        <span class="pnum">Phase {phaseIndex + 1}</span>
                        <h3>{phase.name}</h3>
                        {phase.description && <p class="pdesc">{phase.description}</p>}
                      </div>
                      <div class="pmeta">
                        <span class="prange">Units {phase.start}–{phase.end}</span>
                        {isComplete && <span class="pstatus done">Complete</span>}
                        {!isComplete && isAvailable && <span class="pstatus part">{phaseAvailableCount}/{phaseUnits.length}</span>}
                        {phaseAvailableCount === 0 && <span class="pstatus soon">Soon</span>}
                      </div>
                    </div>
                    <div class="ulist">
                      {phaseUnits.map(unit => {
                        const href = `/systems/${platformSlug}/${languagePath}/${moduleSlugFromPath}/${unitSlug(unit)}`;
                        return unit.available ? (
                          <a href={href} class="ucard">
                            <span class="unum">{unit.number}</span>
                            <span class="utitle">{unit.title}</span>
                          </a>
                        ) : (
                          <div class="ucard locked" aria-label={`Unit ${unit.number}: ${unit.title} — coming soon`}>
                            <span class="unum">{unit.number}</span>
                            <span class="utitle">{unit.title}</span>
                            <span class="ustatus">Soon</span>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                );
              })
            ) : (
              <div class="ulist flat">
                {units.map(unit => {
                  const href = `/systems/${platformSlug}/${languagePath}/${moduleSlugFromPath}/${unitSlug(unit)}`;
                  return unit.available ? (
                    <a href={href} class="ucard">
                      <span class="unum">{unit.number}</span>
                      <span class="utitle">{unit.title}</span>
                    </a>
                  ) : (
                    <div class="ucard locked" aria-label={`Unit ${unit.number}: ${unit.title} — coming soon`}>
                      <span class="unum">{unit.number}</span>
                      <span class="utitle">{unit.title}</span>
                      <span class="ustatus">Soon</span>
                    </div>
                  );
                })}
              </div>
            )}
          </section>
        )}
      </div>

      <!-- SIDEBAR -->
      <aside class="side">
        <div class="card cta">
          <div class="eyebrow">Start building</div>
          <p class="cta-line">{beginnable
            ? 'Open Unit 1 and start with an empty screen. By its end you have built something real.'
            : 'This one is on the way. The units land here as they are written.'}</p>
          {beginnable && <a class="btn" href={firstUnitHref}>Begin Unit 1 →</a>}
          {hasUnitsData && totalUnits > 0 && (
            <>
              <div class="bar"><div class="fill" style={`width: ${progressPercent}%`}></div></div>
              <div class="progress">{availableUnits} / {totalUnits} units live</div>
            </>
          )}
        </div>

        {tools.length > 0 && (
          <div class="card">
            <div class="eyebrow">Tools you'll need</div>
            <ul class="tools">
              {tools.map(t => (
                <li><span class="k">{t.k}</span><span>{t.v}</span></li>
              ))}
            </ul>
          </div>
        )}

        <div class="card">
          <div class="eyebrow">More {platformName}</div>
          <p class="cta-line"><a class="ilink" href={`/systems/${platformSlug}`}>All {platformName} games →</a></p>
        </div>
      </aside>
    </div>
  </div>

  <style define:vars={{ systemColor }}>
    .wrap { --status-done: #146c34; max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-4) var(--gutter) var(--space-16); }
    :global(:root[data-theme="dark"]) .wrap { --status-done: #4ade80; }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme])) .wrap { --status-done: #4ade80; }
    }
    .eyebrow { font-family: var(--font-family-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); }


    /* hero with pixel-grid + scanline wash */
    .hero { position: relative; overflow: hidden; margin-top: var(--space-4); padding: var(--space-6) var(--space-6); border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky); background: var(--color-surface); }
    .hero.spectrum::before { content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(color-mix(in srgb, var(--sys) 6%, transparent) 1px, transparent 1px) 0 0/16px 16px,
                  linear-gradient(90deg, color-mix(in srgb, var(--sys) 6%, transparent) 1px, transparent 1px) 0 0/16px 16px; }
    .hero::after { content: ""; position: absolute; inset: 0; pointer-events: none;
      background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.03) 0 1px, transparent 1px 4px); }
    .hero .in { position: relative; z-index: 1; }
    .hero .k { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .hero h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(3.4rem, 8vw, 5.5rem); line-height: 0.82;
      /* Reserve the descender the tight line-height does not: Literata's ink
         drops ~0.33em past the box, which collided with the strapline. */
      padding-bottom: 0.25em; margin: var(--space-2) 0 0; color: var(--color-text); }
    .hero .pitch { font-size: 1rem; max-width: 64ch; margin: var(--space-3) 0 0; color: var(--color-text); }
    .stamp { display: inline-block; font-family: var(--font-family-mono); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
      border: 2px solid var(--color-text); color: var(--color-text); padding: 2px 8px; background: var(--color-surface); transform: rotate(-3deg); }
    .liveunits { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--ink); font-weight: 700; letter-spacing: 0.06em; }
    .rainbow.bar { display: flex; height: 9px; width: 200px; border: 1.5px solid var(--color-text); margin-top: var(--space-3); }
    .rainbow.bar div { flex: 1; }
    .rainbow .r { background: #cc0000; } .rainbow .y { background: #cccc00; } .rainbow .g { background: #00cc00; } .rainbow .c { background: #00cccc; }
    .sysbar { height: 9px; width: 200px; background: var(--sys); margin-top: var(--space-3); }

    .grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--space-8); margin-top: var(--space-6); align-items: start; }

    .hero-shot { display: block; width: 100%; height: auto; border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky); margin-bottom: var(--space-6);
      image-rendering: pixelated; image-rendering: crisp-edges; }

    /* MDX prose body */
    .prose { line-height: 1.7; }
    .prose :global(h2) { font-weight: 800; font-size: 1.3rem; margin: var(--space-8) 0 var(--space-3); color: var(--color-text); }
    .prose :global(h2:first-child) { margin-top: 0; }
    .prose :global(h3) { font-weight: 700; font-size: 1.1rem; margin: var(--space-6) 0 var(--space-3); color: var(--color-text); }
    .prose :global(p) { margin-bottom: var(--space-4); }
    .prose :global(ul), .prose :global(ol) { margin-bottom: var(--space-4); padding-left: var(--space-6); }
    .prose :global(li) { margin-bottom: var(--space-2); }
    .prose :global(img) { display: block; max-width: min(100%, 768px); height: auto; margin: var(--space-6) 0; border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky); image-rendering: pixelated; image-rendering: crisp-edges; }
    .prose :global(pre) { background: var(--color-code-bg); border: 1px solid var(--color-border); border-radius: 4px; padding: var(--space-4); overflow-x: auto; margin: var(--space-6) 0; }
    .prose :global(pre code) { color: var(--color-code-text); }
    .prose :global(code) { font-family: var(--font-family-mono); font-size: 0.9rem; }
    .prose :global(:not(pre) > code) { background: var(--color-surface); padding: 0.125rem 0.375rem; color: var(--ink); }

    /* roadmap */
    .roadmap { margin-top: var(--space-10); }
    .roadmap h2 { font-weight: 800; font-size: 1.3rem; margin: 0 0 var(--space-5); color: var(--color-text); }
    .phase { margin-bottom: var(--space-5); padding: var(--space-5); background: var(--color-surface); border: 2px solid var(--color-border); }
    .phase.on { border-color: var(--sys); border-width: 3px; box-shadow: var(--shadow-chunky); }
    .phead { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); margin-bottom: var(--space-4); }
    .pinfo { flex: 1; }
    .pnum { font-family: var(--font-family-mono); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-secondary); }
    .phase.on .pnum { color: var(--ink); }
    .pinfo h3 { font-size: 1.15rem; font-weight: 700; margin: var(--space-1) 0 0; color: var(--color-text); }
    .pdesc { font-size: 0.85rem; color: var(--color-text-secondary); margin: var(--space-1) 0 0; }
    .pmeta { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); flex-shrink: 0; }
    .prange { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); }
    .pstatus { font-family: var(--font-family-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 7px; border: 2px solid; }
    .pstatus.done { color: var(--status-done); border-color: var(--status-done); }
    .pstatus.part { color: var(--ink); border-color: var(--sys); }
    .pstatus.soon { color: var(--color-text-secondary); border-color: var(--color-border); }

    .ulist { display: flex; flex-direction: column; gap: var(--space-2); }
    .ucard { display: flex; align-items: center; gap: var(--space-3); background: var(--color-bg); border: 2px solid var(--color-border); padding: var(--space-3) var(--space-4); text-decoration: none; color: var(--color-text); transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base); }
    a.ucard:hover, a.ucard:focus-visible { border-color: var(--sys); transform: translate(-3px, -3px); box-shadow: 5px 5px 0 var(--sys); }
    .ucard.locked { opacity: 0.6; }
    .unum { font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; width: 1.75rem; height: 1.75rem; display: flex; align-items: center; justify-content: center; background: var(--sys-fill); color: #fff; flex-shrink: 0; }
    .ucard.locked .unum { background: var(--color-border); color: var(--color-text-secondary); }
    .utitle { font-size: 1rem; font-weight: 600; flex: 1; min-width: 0; }
    .ustatus { font-family: var(--font-family-mono); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-secondary); border: 1.5px solid var(--color-border); padding: 2px 6px; flex-shrink: 0; }

    /* sidebar */
    .side .card { border: 3px solid var(--color-border); background: var(--color-surface); padding: 14px 15px; margin-bottom: var(--space-4); }
    .side .card.cta { border-color: var(--sys); background: color-mix(in srgb, var(--sys) 8%, var(--color-surface)); box-shadow: var(--shadow-chunky); }
    .cta-line { font-size: 0.85rem; color: var(--color-text-secondary); margin: 6px 0 12px; line-height: 1.5; }
    .btn { font-family: var(--font-family-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 13px 16px; border: 3px solid var(--sys); background: var(--sys-fill); color: #fff; text-decoration: none; box-shadow: 4px 4px 0 color-mix(in srgb, var(--sys) 35%, transparent); display: block; text-align: center; transition: transform var(--transition-base), box-shadow var(--transition-base); }
    .btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 color-mix(in srgb, var(--sys) 35%, transparent); }
    .bar { height: 8px; border: 1.5px solid var(--color-text); margin-top: 12px; }
    .bar .fill { height: 100%; background: var(--sys); }
    .progress { font-family: var(--font-family-mono); font-size: 0.7rem; color: var(--color-text-secondary); margin-top: 6px; text-align: center; }
    .side .card.cta .eyebrow, .side .card.cta .cta-line, .side .card.cta .progress { color: var(--color-text); }
    .ilink { color: var(--ink); text-decoration: none; font-weight: 700; font-family: var(--font-family-mono); font-size: 0.78rem; }
    .tools { list-style: none; margin: 8px 0 0; padding: 0; font-size: 0.85rem; }
    .tools li { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-bottom: 1px dashed var(--color-border); }
    .tools li:last-child { border-bottom: 0; }
    .tools .k { font-family: var(--font-family-mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-secondary); align-self: center; }

    @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .side { order: 2; } }
  </style>
</Layout>
