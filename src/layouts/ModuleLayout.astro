---
/** System module overviews share the accepted roadmap and retain their authored body. */
import ModuleOverviewLayout from './ModuleOverviewLayout.astro';
const frontmatter=Astro.props.frontmatter || Astro.props;
const parts=Astro.url.pathname.split('/').filter(Boolean);
if(parts[0]==='systems')parts.shift();
const [platformSlug,track,moduleSlug]=parts;
---
<ModuleOverviewLayout title={frontmatter.gameName || frontmatter.title} description={frontmatter.description} platformSlug={platformSlug} track={track as 'assembly'|'basic'|'amos'|'blitz'|'machine'} moduleSlug={moduleSlug} heroImage={frontmatter.heroImage} heroAlt={frontmatter.heroAlt} heroCaption={frontmatter.heroCaption} estimatedTime={frontmatter.estimatedTime}>
<slot/>
</ModuleOverviewLayout>
