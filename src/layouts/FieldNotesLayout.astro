---
/**
 * FieldNotesLayout — chrome for a Field Notes essay (the narrative dev-diary).
 *
 * Same bones as FromTheMetalLayout so the two writing sections read as siblings:
 * mono kicker (per-post accent) → mono H1 → an italic standfirst (dek) → the
 * rendered body → a colophon. The per-post sign-off is authored in the MDX; the
 * colophon is constant (the AI declaration + the Substack cross-link that makes
 * the site the canonical home). Video figures come in via <FieldVideo>.
 */
import Layout from './Layout.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { title, description, dek, kicker, accent } = entry.data;
const { Content } = await render(entry);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Field Notes', href: '/field-notes' },
  { label: title },
];
---

<Layout title={`${title} | Field Notes`} description={description} breadcrumbs={breadcrumbs}>
  <article class="fn" style={`--accent: ${accent}`}>
    <p class="kicker">// {kicker} //</p>
    <h1>{title}</h1>
    <p class="dek">{dek}</p>

    <div class="body">
      <Content />
    </div>

    <footer class="colophon">
      <p>Field Notes is written by Steve Hill — one person building Code Like It's 198x
        in the open, with an AI assistant in the room and every technical claim checked
        against real hardware or the emulator. <a href="/about">More on how that works.</a></p>
      <p>New notes land here first, then in the <a href="https://code198x.substack.com/" rel="noopener">newsletter</a>.</p>
    </footer>
  </article>
</Layout>

<style>
  .fn {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-10) clamp(24px, 5vw, 40px) var(--space-16);
    font-family: var(--font-family-sans);
    color: var(--color-text);

    /* Contrast-safe rendering of the per-post accent when used as TEXT.
       A single hex can't clear WCAG AA on both the cream and the dark
       background, so we darken it toward black in light mode and lighten
       it toward white in dark mode (ratios tuned so the whole accent
       palette clears 4.5:1 on both). Decorative uses keep the raw --accent.
       This mirrors the platform-colour --ink-l/--ink-d split. */
    --accent-ink: color-mix(in srgb, var(--accent) 72%, black);
  }
  :global(:root[data-theme="dark"]) .fn { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .fn { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  }

  /* Title block */
  .kicker { font-family: var(--font-family-mono); font-size: 12px; font-weight: 600; letter-spacing: 2px; color: var(--accent-ink); margin: 0 0 18px; }
  .fn h1 { font-family: var(--font-family-read); font-weight: 700; font-size: clamp(34px, 6vw, 52px); line-height: 1.0; margin: 0 0 18px; text-wrap: balance; color: var(--color-text); }
  .dek { font-size: 20px; font-style: italic; line-height: 1.5; color: var(--color-text-secondary); margin: 0 0 40px; text-wrap: pretty; }

  /* Body prose (rendered MDX) */
  .body :global(h2) { font-family: var(--font-family-mono); font-weight: 700; font-size: 21px; letter-spacing: -0.2px; margin: 40px 0 16px; color: var(--color-text); }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(p) { font-size: 17px; line-height: 1.68; margin: 0 0 22px; text-wrap: pretty; }
  .body :global(em) { font-style: italic; color: var(--accent-ink); }
  .body :global(strong) { font-weight: 600; color: var(--color-text); }
  .body :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .body :global(a:hover) { color: var(--color-house-2); }

  /* The authored per-post sign-off (a trailing italic paragraph in the MDX) */
  .body :global(hr) { border: 0; border-top: 3px solid var(--color-border); margin: 40px 0 24px; }
  .body :global(hr + p) { font-size: 15px; font-style: italic; color: var(--color-text-secondary); }

  /* Inline code chip — scoped to inline code only (not the <code> inside a <pre>) */
  .body :global(:not(pre) > code) {
    font-family: var(--font-family-mono); font-size: 0.82em;
    background: var(--color-bg-secondary); border: 1px solid var(--color-border-light);
    padding: 2px 7px; border-radius: 4px;
  }

  /* Author-supplied still images (house-styled, crisp pixels) */
  .body :global(figure.still) { margin: 32px 0; }
  .body :global(figure.still img) { display: block; width: 100%; height: auto; border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky); image-rendering: pixelated; background: #000; }
  .body :global(figure.still figcaption) { font-family: var(--font-family-mono); font-size: 12.5px; line-height: 1.5; color: var(--color-text-secondary); margin-top: 10px; }

  /* Tables (the nop-sweep artifact) — house-styled */
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 28px 0; font-family: var(--font-family-mono); font-size: 13px; }
  .body :global(th), .body :global(td) { border: 2px solid var(--color-border); padding: 7px 11px; text-align: left; }
  .body :global(thead th) { background: var(--color-bg-secondary); font-weight: 700; color: var(--color-text); }
  .body :global(tbody strong) { color: var(--accent-ink); }

  /* Colophon */
  .colophon { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 3px solid var(--color-border); }
  .colophon p { font-family: var(--font-family-mono); font-size: 13px; line-height: 1.6; color: var(--color-text-secondary); margin: 0 0 10px; }
  .colophon p:last-child { margin-bottom: 0; }
  .colophon a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  @media print {
    .fn { max-width: none; padding: 0; }
    .fn h1, .body :global(h2) { break-after: avoid; }
    .body :global(figure), .body :global(pre), .body :global(table) { break-inside: avoid; }
    .body :global(p), .body :global(li) { orphans: 3; widows: 3; }
  }
</style>
