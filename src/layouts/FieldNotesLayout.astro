---
import EditorialArticleLayout from './EditorialArticleLayout.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { title, description, dek, accent } = entry.data;
const { Content } = await render(entry);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Field Notes', href: '/field-notes' },
  { label: title },
];
---

<EditorialArticleLayout masthead={false} pageTitle={`${title} | Field Notes`} description={description} breadcrumbs={breadcrumbs} series="field-notes" title={title} accent={accent} introduction={dek}>
  <Content />

    <footer class="colophon" slot="ending">
      <p>Field Notes is written by Steve Hill — one person building Code Like It's 198x
        in the open, with an AI assistant in the room and every technical claim checked
        against real hardware or the emulator. <a href="/about">More on how that works.</a></p>
      <p>New notes land here first, then in the <a href="https://code198x.substack.com/" rel="noopener">newsletter</a>.</p>
    </footer>
</EditorialArticleLayout>

<style>
  .colophon { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 3px solid var(--color-border); }
  .colophon p { font-family: var(--font-family-mono); font-size: 13px; line-height: 1.6; color: var(--color-text-secondary); margin: 0 0 10px; }
  .colophon p:last-child { margin-bottom: 0; }
  .colophon a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
</style>
