---
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <slot />
</Layout>

<style>
  /* ============================================
     TIER LAYOUT STYLES
     Tier pages with lesson lists and tier content
     ============================================ */

  /* Tier Content Wrapper - Full width control like Phase */
  :global(.lesson-content-wrapper) {
    margin: 0 auto var(--space-4xl);
    padding: var(--space-3xl) var(--space-4xl);
    background: var(--gradient-subtle);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    max-width: 1200px;
    width: calc(100% - var(--space-xl));
  }

  /* Tier Prose Content - Enhanced like Phase */
  :global(.lesson-prose) {
    max-width: 100%;
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  /* Typography for tier content */
  :global(.lesson-prose h1),
  :global(.lesson-prose h2),
  :global(.lesson-prose h3),
  :global(.lesson-prose h4) {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  :global(.lesson-prose h1) {
    font-size: 2.25rem;
    font-weight: var(--font-weight-bold);
    margin-top: 0;
  }

  :global(.lesson-prose h2) {
    font-size: 1.75rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-sm);
  }

  :global(.lesson-prose h3) {
    font-size: 1.375rem;
  }

  :global(.lesson-prose p) {
    margin-bottom: var(--space-md);
  }

  :global(.lesson-prose ul) {
    list-style-type: disc;
    margin: var(--space-lg) 0;
    padding-left: var(--space-xl);
  }

  :global(.lesson-prose ol) {
    list-style-type: decimal;
    margin: var(--space-lg) 0;
    padding-left: var(--space-xl);
  }

  :global(.lesson-prose li) {
    margin-bottom: var(--space-sm);
    line-height: 1.7;
    color: var(--color-text);
  }

  :global(.lesson-prose li::marker) {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }

  :global(.lesson-prose blockquote) {
    border-left: 4px solid var(--color-primary);
    background: var(--gradient-light);
    padding: var(--space-lg) var(--space-xl);
    margin: var(--space-xl) 0;
    border-radius: var(--radius-md);
    font-style: italic;
    box-shadow: var(--shadow-sm);
  }

  :global(.lesson-prose code) {
    background: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-accent);
    border: 1px solid var(--color-border-light);
  }

  :global(.lesson-prose pre) {
    background: var(--color-bg-secondary);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    overflow-x: auto;
    border: 1px solid var(--color-border-light);
    margin: var(--space-lg) 0;
    box-shadow: var(--shadow-inner);
  }

  :global(.lesson-prose pre code) {
    background: none;
    padding: 0;
    border: none;
    color: inherit;
  }

  /* Tier Lessons Section - Centered with max-width */
  :global(.tier-lessons-section) {
    margin: 0 auto var(--space-4xl);
    max-width: 1200px;
    padding: 0 var(--space-xl);
  }

  :global(.tier-lessons-header) {
    text-align: center;
    margin-bottom: var(--space-3xl);
    position: relative;
  }

  :global(.tier-lessons-header::before) {
    content: "";
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background: var(--gradient-primary);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  :global(.tier-lessons-title) {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  :global(.tier-lessons-description) {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.7;
    font-weight: var(--font-weight-medium);
  }

  /* Lesson Cards Grid - Enhanced spacing */
  :global(.tier-lesson-cards) {
    display: grid;
    gap: var(--space-xl);
  }

  /* Individual Lesson Card - Matching Phase styling */
  :global(.tier-lesson-card) {
    text-decoration: none;
    display: block;
    background: transparent;
    border-radius: var(--radius-xl);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
  }

  :global(.tier-lesson-card:hover) {
    text-decoration: none;
  }

  :global(.tier-lesson-card-layout) {
    display: flex;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 1px solid var(--color-border-light);
    position: relative;
  }

  :global(.tier-lesson-card:hover .tier-lesson-card-layout) {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-12px) scale(1.02);
    border-color: var(--color-primary);
  }

  :global(.tier-lesson-card-accent) {
    width: 6px;
    background: var(--gradient-primary);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
  }

  :global(.tier-lesson-card-accent::after) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-primary);
    opacity: 0;
    filter: blur(8px);
    transition: opacity 0.4s ease;
  }

  :global(.tier-lesson-card:hover .tier-lesson-card-accent) {
    width: 10px;
  }

  :global(.tier-lesson-card:hover .tier-lesson-card-accent::after) {
    opacity: 0.6;
  }

  :global(.tier-lesson-card-content) {
    flex: 1;
    padding: var(--space-2xl);
    background: var(--gradient-subtle);
    position: relative;
  }

  :global(.tier-lesson-card-content::before) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient-subtle);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  :global(.tier-lesson-card:hover .tier-lesson-card-content::before) {
    opacity: 0.02;
  }

  :global(.tier-lesson-card-header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  :global(.tier-lesson-card-main) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    flex: 1;
  }

  :global(.tier-lesson-card-number) {
    width: 56px;
    height: 56px;
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    font-weight: var(--font-weight-extrabold);
    box-shadow:
      var(--shadow-button);
    position: relative;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  :global(.tier-lesson-card-number::after) {
    content: "";
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
    filter: blur(8px);
  }

  :global(.tier-lesson-card:hover .tier-lesson-card-number::after) {
    opacity: 0.4;
  }

  :global(.tier-lesson-card-info) {
    flex: 1;
  }

  :global(.tier-lesson-card-title) {
    font-size: 1.25rem;
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin: 0 0 var(--space-md) 0;
    line-height: 1.2;
    transition: color 0.3s ease;
    letter-spacing: -0.025em;
  }

  :global(.tier-lesson-card:hover .tier-lesson-card-title) {
    color: var(--color-primary);
  }

  :global(.tier-lesson-card-description) {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-lg) 0;
    line-height: var(--line-height-relaxed);
    font-size: 0.975rem;
    max-width: 90%;
    font-weight: var(--font-weight-medium);
  }

  :global(.tier-lesson-card-badges) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  :global(.tier-lesson-badge) {
    padding: 8px 14px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: var(--color-text);
    white-space: nowrap;
    font-weight: var(--font-weight-semibold);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  :global(.tier-lesson-badge:hover) {
    background: var(--color-bg-tertiary);
    transform: translateY(-2px) scale(1.05);
    box-shadow: var(--shadow-md);
  }

  :global(.tier-lesson-badge.duration) {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  :global(.tier-lesson-badge.difficulty) {
    background: var(--color-bg-secondary);
    color: var(--color-warning);
    border: 1px solid var(--color-warning);
  }

  :global(.tier-lesson-badge.code) {
    background: var(--color-bg-secondary);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }

  :global(.tier-lesson-badge.exercise) {
    background: var(--color-bg-secondary);
    color: var(--color-success);
    border: 1px solid var(--color-success);
  }

  :global(.tier-lesson-card-footer) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  :global(.tier-lesson-card-action) {
    flex-shrink: 0;
  }

  :global(.tier-lesson-start-button) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background: var(--gradient-primary);
    color: white;
    text-decoration: none;
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-semibold);
    transition: all 0.3s ease;
    box-shadow: var(--shadow-md);
    border: 2px solid var(--color-primary);
    white-space: nowrap;
  }

  :global(.tier-lesson-card:hover .tier-lesson-start-button) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    background: var(--gradient-primary-hover);
    border-color: var(--color-primary-dark);
  }

  /* Game Project for Tiers - Centered with max-width */
  :global(.tier-game-project) {
    background: var(--gradient-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    margin: 0 auto var(--space-3xl);
    max-width: 1200px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 1px solid var(--color-border-light);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.tier-game-project:hover) {
    transform: translateY(-8px) scale(1.01);
    box-shadow: var(--shadow-elevated-hover);
    border-color: var(--color-primary);
  }

  :global(.tier-game-project-layout) {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    position: relative;
  }

  :global(.tier-game-project-icon) {
    background: var(--gradient-primary);
    color: white;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    flex-shrink: 0;
    box-shadow: var(--shadow-button-inset);
    position: relative;
    animation: pulse 3s infinite;
  }

  :global(.tier-game-project-icon::before) {
    content: "";
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
    filter: blur(12px);
  }

  :global(.tier-game-project:hover .tier-game-project-icon::before) {
    opacity: 0.5;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  :global(.tier-game-project-info) {
    flex: 1;
  }

  :global(.tier-game-project-title) {
    font-size: 1.75rem;
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary);
    margin: 0 0 var(--space-md) 0;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  :global(.tier-game-project-description) {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-xl) 0;
    line-height: 1.7;
    font-weight: var(--font-weight-medium);
    max-width: 90%;
  }

  :global(.tier-game-project-meta) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  :global(.tier-game-project-badge) {
    background: var(--color-bg-secondary);
    padding: 10px 16px;
    border-radius: var(--radius-full);
    font-size: 0.9375rem;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-weight: var(--font-weight-semibold);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.tier-game-project-badge:hover) {
    background: var(--color-bg-tertiary);
    transform: translateY(-2px) scale(1.05);
    box-shadow: var(--shadow-md);
  }

  /* Navigation Divider */
  :global(.nav-divider) {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-4xl);
    padding-top: var(--space-3xl);
  }

  /* Additional hover effects for tier sections */
  :global(.tier-lessons-section) {
    animation: fadeInUp 0.8s ease-out;
  }

  :global(.tier-content-section) {
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    :global(.lesson-content-wrapper) {
      padding: var(--space-xl) var(--space-lg);
      margin-bottom: var(--space-3xl);
      width: calc(100% - var(--space-md));
    }

    :global(.lesson-prose) {
      font-size: 1rem;
    }

    :global(.lesson-prose h1) {
      font-size: 1.75rem;
    }

    :global(.lesson-prose h2) {
      font-size: 1.5rem;
    }

    :global(.tier-lesson-card-content) {
      padding: var(--space-lg);
    }

    :global(.tier-lesson-card-header) {
      flex-direction: column;
      gap: var(--space-lg);
    }

    :global(.tier-lesson-card-main) {
      gap: var(--space-md);
    }

    :global(.tier-game-project-layout) {
      flex-direction: column;
      text-align: center;
    }
  }
</style>