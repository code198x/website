---
import Layout from "./Layout.astro";

// MDX files pass frontmatter via Astro.props.frontmatter
// Regular .astro files pass props directly
const frontmatter = Astro.props.frontmatter || Astro.props;

const {
  title = "Vault Entry",
  subtitle = "",
  summary = "",
  system_tags = [],
  tech_tags = [],
  people_tags = [],
  years = []
} = frontmatter;

const currentPath = Astro.url.pathname;
const isVaultIndex = currentPath === "/vault" || currentPath === "/vault/";
---

<Layout title={title} description={summary}>
  <article class="vault-entry">
    {!isVaultIndex && <a href="/vault" class="back-link">← Back to The Vault</a>}

    <header class="header">
      <h1 class="title">{title}</h1>
      {subtitle && <h2 class="subtitle">{subtitle}</h2>}
      {summary && <p class="summary">{summary}</p>}

      <div class="tags">
        {system_tags.map((t) => <span class="tag system">{t}</span>)}
        {tech_tags.map((t) => <span class="tag tech">{t}</span>)}
        {people_tags.map((t) => <span class="tag person">{t}</span>)}
        {years.length > 0 && (
          <span class="tag years">{years[0]}–{years[years.length - 1]}</span>
        )}
      </div>
    </header>

    <div class="content">
      <slot />
    </div>
  </article>

  <style>
    .vault-entry {
      max-width: 820px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-5);
    }
    .back-link {
      display: inline-block;
      margin-bottom: var(--space-4);
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--color-primary); }

    .title {
      margin: 0 0 var(--space-1) 0;
      line-height: 1.1;
    }
    .subtitle {
      font-weight: 500;
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-2) 0;
    }
    .summary {
      font-style: italic;
      color: var(--color-text-muted);
      margin: 0 0 var(--space-4) 0;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-5);
    }
    .tag {
      background: color-mix(in oklab, var(--color-surface) 85%, var(--color-bg) 15%);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: 0.2rem 0.6rem;
      font-size: 0.8rem;
      line-height: 1.4;
    }
    .tag.system { color: var(--color-primary); }
    .tag.tech { color: var(--color-accent); }
    .tag.person { color: var(--color-text-secondary); }
    .tag.years { color: var(--color-text-muted); }

    .content :global(p) { margin-bottom: var(--space-4); }
    .content :global(h2, h3) { margin-top: var(--space-6); }
    .content :global(blockquote) {
      border-left: 3px solid var(--color-border);
      padding-left: var(--space-3);
      color: var(--color-text-secondary);
      margin: var(--space-4) 0;
    }

    /* Tables inherit global styles from Layout.astro */
    .content :global(table) {
      /* Tables are already styled in global scope */
    }

    /* Media cues styling (for future screenshots/clips) */
    .content :global(> p) {
      /* no-op: keep lesson typography consistent */
    }

    @media (max-width: 768px) {
      .vault-entry { padding: var(--space-6) var(--space-4); }
    }
  </style>
</Layout>