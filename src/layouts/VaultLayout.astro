---
import Layout from "./Layout.astro";
import TableOfContents from "../components/TableOfContents.astro";

// MDX files pass frontmatter via Astro.props.frontmatter
// Regular .astro files pass props directly
const frontmatter = Astro.props.frontmatter || Astro.props;

const {
  title = "Vault Entry",
  subtitle = "",
  summary = "",
  system_tags = [],
  tech_tags = [],
  people_tags = [],
  years = []
} = frontmatter;

const currentPath = Astro.url.pathname;
const isVaultIndex = currentPath === "/vault" || currentPath === "/vault/";

// Determine category from path for "Browse" links
const pathParts = currentPath.split('/').filter(Boolean);
const category = pathParts[1] || ''; // e.g., 'hardware', 'people', 'games'

const allTags = [...system_tags, ...tech_tags, ...people_tags];
const hasMetadata = allTags.length > 0 || years.length > 0;
---

<Layout title={title} description={summary}>
  <div class="vault-container">
    {!isVaultIndex && <a href="/vault" class="back-link">← Back to The Vault</a>}

    <div class="vault-layout">
      <article class="vault-entry">
        <header class="header">
          <h1 class="title">{title}</h1>
          {subtitle && <h2 class="subtitle">{subtitle}</h2>}
          {summary && <p class="summary">{summary}</p>}

          <div class="tags tags-mobile">
            {system_tags.map((t) => <span class="tag system">{t}</span>)}
            {tech_tags.map((t) => <span class="tag tech">{t}</span>)}
            {people_tags.map((t) => <span class="tag person">{t}</span>)}
            {years.length > 0 && (
              <span class="tag years">{years[0]}–{years[years.length - 1]}</span>
            )}
          </div>
        </header>

        <div class="content">
          <slot />
        </div>
      </article>

      {!isVaultIndex && (
        <aside class="vault-sidebar">
          <div class="sidebar-section">
            <TableOfContents selector=".content" />
          </div>

          {hasMetadata && (
            <div class="sidebar-section">
              <h4 class="sidebar-title">Details</h4>
              {years.length > 0 && (
                <div class="sidebar-detail">
                  <span class="detail-label">Years</span>
                  <span class="detail-value">{years[0]}–{years[years.length - 1]}</span>
                </div>
              )}
              {allTags.length > 0 && (
                <div class="sidebar-tags">
                  {system_tags.map((t) => <span class="tag system">{t}</span>)}
                  {tech_tags.map((t) => <span class="tag tech">{t}</span>)}
                  {people_tags.map((t) => <span class="tag person">{t}</span>)}
                </div>
              )}
            </div>
          )}

          <div class="sidebar-section">
            <h4 class="sidebar-title">Browse The Vault</h4>
            <ul class="browse-links">
              <li><a href="/vault/hardware" class={category === 'hardware' ? 'active' : ''}>Hardware</a></li>
              <li><a href="/vault/people" class={category === 'people' ? 'active' : ''}>People</a></li>
              <li><a href="/vault/games" class={category === 'games' ? 'active' : ''}>Games</a></li>
              <li><a href="/vault/culture" class={category === 'culture' ? 'active' : ''}>Culture</a></li>
              <li><a href="/vault/techniques" class={category === 'techniques' ? 'active' : ''}>Techniques</a></li>
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>

  <style>
    .vault-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .back-link {
      display: inline-block;
      margin-bottom: var(--space-4);
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      text-decoration: none;
    }
    .back-link:hover,
    .back-link:focus-visible { color: var(--color-primary); }

    .back-link:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
      border-radius: 0.125rem;
    }

    /* Two-column layout */
    .vault-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    @media (min-width: 1024px) {
      .vault-layout {
        grid-template-columns: 1fr 250px;
      }
    }

    .vault-entry {
      min-width: 0;
    }

    .title {
      margin: 0 0 var(--space-1) 0;
      line-height: 1.1;
    }
    .subtitle {
      font-weight: 500;
      color: var(--color-text-secondary);
      margin: 0 0 var(--space-2) 0;
    }
    .summary {
      font-style: italic;
      color: var(--color-text-muted);
      margin: 0 0 var(--space-4) 0;
    }

    /* Tags in header (mobile only) */
    .tags-mobile {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-5);
    }

    @media (min-width: 1024px) {
      .tags-mobile {
        display: none;
      }
    }

    .tag {
      background: color-mix(in oklab, var(--color-surface) 85%, var(--color-bg) 15%);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: 0.2rem 0.6rem;
      font-size: 0.8rem;
      line-height: 1.4;
    }
    .tag.system { color: var(--color-primary); }
    .tag.tech { color: var(--color-accent); }
    .tag.person { color: var(--color-text-secondary); }
    .tag.years { color: var(--color-text-muted); }

    .content :global(p) { margin-bottom: var(--space-4); }
    .content :global(h2, h3) { margin-top: var(--space-6); }
    .content :global(blockquote) {
      border-left: 3px solid var(--color-border);
      padding-left: var(--space-3);
      color: var(--color-text-secondary);
      margin: var(--space-4) 0;
    }

    /* Code blocks break out wider */
    .content :global(pre) {
      margin-left: calc(-1 * var(--space-4));
      margin-right: calc(-1 * var(--space-4));
      padding: var(--space-4) var(--space-6);
      border-radius: 0;
    }

    @media (min-width: 1024px) {
      .content :global(pre) {
        margin-left: -2rem;
        margin-right: 0;
        padding-left: 2rem;
        padding-right: var(--space-4);
        border-radius: 0.5rem;
      }
    }

    /* Sidebar */
    .vault-sidebar {
      display: none;
    }

    @media (min-width: 1024px) {
      .vault-sidebar {
        display: block;
        position: sticky;
        top: calc(var(--nav-height) + var(--space-4));
        max-height: calc(100vh - var(--nav-height) - var(--space-8));
        overflow-y: auto;
      }
    }

    .sidebar-section {
      margin-bottom: var(--space-6);
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--color-border);
    }

    .sidebar-section:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .sidebar-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
      margin: 0 0 var(--space-3) 0;
    }

    .sidebar-detail {
      display: flex;
      justify-content: space-between;
      font-size: 0.875rem;
      margin-bottom: var(--space-2);
    }

    .detail-label {
      color: var(--color-text-secondary);
    }

    .detail-value {
      color: var(--color-text);
      font-weight: 500;
    }

    .sidebar-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }

    .browse-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .browse-links li {
      margin-bottom: var(--space-2);
    }

    .browse-links a {
      display: block;
      padding: var(--space-2) var(--space-3);
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      text-decoration: none;
      border-radius: 0.375rem;
      transition: all var(--transition-base);
    }

    .browse-links a:hover {
      background: var(--color-surface);
      color: var(--color-text);
    }

    .browse-links a.active {
      background: color-mix(in oklab, var(--color-primary) 15%, var(--color-surface) 85%);
      color: var(--color-primary);
      font-weight: 500;
    }

    @media (max-width: 768px) {
      .vault-container { padding: var(--space-6) var(--space-4); }
    }
  </style>
</Layout>
