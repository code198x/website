---
/**
 * Landing page for a cross-platform section's module (e.g. Foundations →
 * General Programming). It's the on-ramp before the on-ramp, so it earns real
 * presence: a hero with a ghost wordmark and a strong title block, the pitch
 * (the MDX body), and the units as a confident numbered grid in the house style
 * (square corners, 3px borders, chunky offset shadows). Branded from the
 * sections registry, with a theme-aware accent derived for dark mode. Units are
 * passed in from the route, derived from the unit pages.
 */
import Layout from './Layout.astro';
import { getSection } from '../lib/sections';

export interface Props {
  title: string;
  description?: string;
  units?: Array<{ number: number; title: string; href: string }>;
}

const frontmatter = Astro.props.frontmatter || Astro.props;
const { title = '', description = '', units = [] } = frontmatter;

const currentPath = Astro.url.pathname;
const sectionSlug = currentPath.split('/').filter(Boolean)[0] || '';
const section = getSection(sectionSlug);
const systemColor = section?.color ?? '#0d9488';
const sectionName = section?.name ?? sectionSlug;

const beginHref = units.length ? units[0].href : currentPath;
const beginNum = units.length ? units[0].number : 1;
---

<Layout title={`${title} — ${sectionName} | Code Like It's 198x`} platformColor={systemColor}>
  <div class="primer" style={`--sys: ${systemColor};`}>

    <!-- HERO -->
    <section class="hero">
      <div class="ghost" aria-hidden="true"><span>{sectionName}</span></div>
      <div class="in">
        <p class="eyebrow">{sectionName}</p>
        <h1>{title}</h1>
        <div class="rule"></div>
        {description && <p class="lede">{description}</p>}
        {units.length > 0 && (
          <a href={beginHref} class="begin">Begin — Unit {String(beginNum).padStart(2, '0')} →</a>
        )}
      </div>
    </section>

    <!-- PITCH (MDX body) -->
    <div class="body"><slot /></div>

    <!-- UNITS -->
    {units.length > 0 && (
      <section class="units" aria-label="Units">
        <h2 class="units-head">The units</h2>
        <ol class="unit-grid">
          {units.map((u) => (
            <li>
              <a href={u.href} class="unit">
                <span class="unum">{String(u.number).padStart(2, '0')}</span>
                <span class="utitle">{u.title}</span>
                <span class="go">Start →</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</Layout>

<style>
  .primer {
    --accent: var(--sys);
    --btn-bg: var(--sys);
    --btn-fg: #fff;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-16);
  }
  /* Dark mode: brighten the accent so it reads on a dark page (fixes the
     washed-out / uncoloured accents), and flip the CTA to dark-on-pale. */
  :global(:root[data-theme="dark"]) .primer {
    --accent: color-mix(in srgb, var(--sys) 64%, white);
    --btn-bg: color-mix(in srgb, var(--sys) 64%, white);
    --btn-fg: #15110d;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .primer {
      --accent: color-mix(in srgb, var(--sys) 64%, white);
      --btn-bg: color-mix(in srgb, var(--sys) 64%, white);
      --btn-fg: #15110d;
    }
  }

  /* hero */
  .hero { position: relative; overflow: hidden; margin-top: var(--space-4); padding: var(--space-8) 0 var(--space-6); }
  .ghost { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; pointer-events: none; overflow: hidden; z-index: 0; }
  .ghost span {
    font-family: var(--font-family-read); font-weight: 700;
    font-size: clamp(120px, 24vw, 280px); line-height: 0.7;
    color: var(--accent); opacity: 0.08; transform: rotate(-4deg);
    margin-right: -8px; white-space: nowrap;
  }
  .hero .in { position: relative; z-index: 1; }
  .eyebrow { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .hero h1 {
    font-family: var(--font-family-read); font-weight: 700;
    font-size: clamp(2.6rem, 7vw, 4.4rem); line-height: 0.9;
    margin: var(--space-2) 0 0; color: var(--color-text); max-width: 20ch;
  }
  .rule { height: 9px; width: 220px; max-width: 70%; background: var(--accent); position: relative; margin: var(--space-3) 0 0; }
  .rule::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 22%; background: var(--color-text); opacity: 0.22; }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 64ch; margin: var(--space-4) 0 0; color: var(--color-text); }
  .begin {
    display: inline-block; margin-top: var(--space-5);
    font-family: var(--font-family-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 12px 18px; border: 3px solid var(--color-text); background: var(--btn-bg); color: var(--btn-fg);
    box-shadow: var(--shadow-chunky); text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .begin:hover { transform: translate(-3px, -3px); box-shadow: 7px 7px 0 var(--color-text); }

  /* pitch */
  .body { line-height: 1.7; max-width: 70ch; margin-top: var(--space-8); }
  .body :global(h2) { margin-top: var(--space-6); margin-bottom: var(--space-2); }
  .body :global(p) { margin: var(--space-3) 0 0; color: var(--color-text); }
  .body :global(a) {
    color: var(--accent); font-weight: 600;
    text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 2px;
    transition: text-decoration-thickness var(--transition-base);
  }
  .body :global(a:hover) { text-decoration-thickness: 3px; }

  /* units */
  .units { margin-top: var(--space-10); }
  .units-head { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0 0 var(--space-4); }
  .units-head::before { content: ""; display: inline-block; width: 20px; height: 3px; background: var(--accent); vertical-align: middle; margin: -3px 11px 0 0; }
  .unit-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-4); }
  .unit {
    display: flex; flex-direction: column;
    border: 3px solid var(--color-text); background: var(--color-surface);
    box-shadow: var(--shadow-chunky); padding: var(--space-5);
    text-decoration: none; color: var(--color-text);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .unit:hover, .unit:focus-visible { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); outline: none; }
  .unum { font-family: var(--font-family-read); font-weight: 700; font-size: 2.4rem; line-height: 0.8; color: var(--accent); }
  .utitle { font-weight: 700; font-size: 1.05rem; line-height: 1.25; margin: var(--space-2) 0 0; flex: 1; }
  .go { font-family: var(--font-family-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; color: var(--accent); margin-top: var(--space-3); }

  @media (max-width: 640px) {
    .primer { padding: var(--space-4) var(--space-4) var(--space-12); }
  }
</style>
