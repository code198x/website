---
/**
 * Landing page for a cross-platform section's module (e.g. Foundations →
 * General Programming). Deliberately lighter than the game ModuleLayout: a
 * teaching primer has no hero, tools, or phase roadmap — just a pitch, a
 * "begin" CTA, and the list of units. Branded neutrally from the sections
 * registry. Units are passed in from the route, derived from the unit pages.
 */
import Layout from './Layout.astro';
import { getSection } from '../lib/sections';

export interface Props {
  title: string;
  description?: string;
  units?: Array<{ number: number; title: string; href: string }>;
}

const frontmatter = Astro.props.frontmatter || Astro.props;
const { title = '', description = '', units = [] } = frontmatter;

const currentPath = Astro.url.pathname;
const sectionSlug = currentPath.split('/').filter(Boolean)[0] || '';
const section = getSection(sectionSlug);
const systemColor = section?.color ?? '#64748b';
const sectionName = section?.name ?? sectionSlug;

const beginHref = units.length ? units[0].href : currentPath;
const beginNum = units.length ? units[0].number : 1;
---

<Layout title={`${title} - ${sectionName} | Code Like It's 198x`} platformColor={systemColor}>
  <div class="primer">
    <header class="primer-header">
      <p class="primer-eyebrow">{sectionName}</p>
      <h1 class="primer-title">{title}</h1>
      {description && <p class="primer-lede">{description}</p>}
      {units.length > 0 && (
        <a href={beginHref} class="primer-begin">Begin — Unit {beginNum} →</a>
      )}
    </header>

    <div class="primer-body">
      <slot />
    </div>

    {units.length > 0 && (
      <section class="primer-units" aria-label="Units">
        <h2 class="primer-units-heading">The units</h2>
        <ol class="primer-unit-list">
          {units.map((u) => (
            <li class="primer-unit">
              <a href={u.href} class="primer-unit-link">
                <span class="primer-unit-num">{String(u.number).padStart(2, '0')}</span>
                <span class="primer-unit-title">{u.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>

  <style define:vars={{ systemColor }}>
    .primer {
      max-width: 820px;
      margin: 0 auto;
      padding: var(--space-8, 3rem) var(--space-4, 1rem);
    }
    .primer-header {
      border-bottom: 2px solid var(--systemColor);
      padding-bottom: var(--space-6, 2rem);
      margin-bottom: var(--space-6, 2rem);
    }
    .primer-eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--systemColor);
      margin: 0 0 var(--space-2, 0.5rem);
    }
    .primer-title {
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.1;
      margin: 0 0 var(--space-3, 0.75rem);
    }
    .primer-lede {
      font-size: 1.15rem;
      line-height: 1.6;
      color: var(--color-text-muted, #555);
      margin: 0 0 var(--space-5, 1.5rem);
    }
    .primer-begin {
      display: inline-block;
      background: var(--systemColor);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      padding: 0.7rem 1.4rem;
      border-radius: 8px;
    }
    .primer-begin:hover { filter: brightness(1.1); }
    .primer-body {
      line-height: 1.7;
      margin-bottom: var(--space-8, 3rem);
    }
    .primer-body :global(h2) {
      margin-top: var(--space-6, 2rem);
    }
    .primer-units-heading {
      font-size: 1.4rem;
      margin: 0 0 var(--space-4, 1rem);
    }
    .primer-unit-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.4rem;
    }
    .primer-unit-link {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      text-decoration: none;
      color: inherit;
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--color-border, #e2e2e2);
      border-radius: 8px;
      transition: border-color 0.15s, background 0.15s;
    }
    .primer-unit-link:hover {
      border-color: var(--systemColor);
      background: color-mix(in srgb, var(--systemColor) 6%, transparent);
    }
    .primer-unit-num {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      color: var(--systemColor);
      min-width: 1.6rem;
    }
    .primer-unit-title { font-weight: 500; }
  </style>
</Layout>
