---
import '@198x-ui/tokens.css';
import '@198x-ui/fonts.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Search from '../components/Search.astro';
import Plate from '@198x-ui/components/Plate.astro';
import FamilyStrip from '@198x-ui/components/FamilyStrip.astro';
import { getActivePlatforms } from '../lib/platforms';
import { inkStyle } from '../lib/contrast';


// Get platforms for nav and footer
const platforms = await getActivePlatforms();

interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description?: string;
  image?: string;
  showNav?: boolean;
  platformColor?: string;
  breadcrumbs?: BreadcrumbItem[];
  currentLabel?: string;
}

const {
  title,
  description = "Learn assembly by building games on classic 8-bit and 16-bit systems",
  image = "/og-image.png",
  showNav = true,
  platformColor,
  breadcrumbs,
  currentLabel
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = "https://code198x.com";
const fullTitle = `${title} | Code Like It's 198x`;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en-GB" data-tint="code">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Code Like It's 198x" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme initialization (inline to prevent flash) -->
    <script is:inline>
      (function() {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        }
        // Apply on initial load
        applyTheme();
        // Re-apply after View Transitions page swap
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- View transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Navigation progress bar -->
    <style is:inline>
      #nav-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--color-primary, #3b82f6);
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
      }
      #nav-progress.loading {
        opacity: 1;
        animation: nav-progress-grow 8s cubic-bezier(0.2, 0.5, 0.1, 1) forwards;
      }
      #nav-progress.done {
        width: 100% !important;
        opacity: 0;
        transition: opacity 0.3s 0.1s;
      }
      @keyframes nav-progress-grow {
        0% { width: 0; }
        10% { width: 30%; }
        50% { width: 70%; }
        80% { width: 85%; }
        100% { width: 95%; }
      }
    </style>
    <script is:inline>
      (function() {
        var bar = document.createElement('div');
        bar.id = 'nav-progress';
        document.documentElement.appendChild(bar);

        document.addEventListener('astro:before-preparation', function() {
          bar.className = 'loading';
        });
        document.addEventListener('astro:after-swap', function() {
          bar.className = 'done';
          setTimeout(function() { bar.className = ''; }, 400);
        });
      })();
    </script>
  </head>
  <body style={platformColor ? `--platform-color: ${platformColor}; ${inkStyle(platformColor)}` : undefined}>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    {showNav && (
      <nav class="nav" aria-label="Primary">
        <div class="nav-container">
          <a href="/" class="nav-logo">
            <Plate prefix="code" project="code" size={14} label="Code Like It's 198x" />
          </a>

          <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-links">
            <span class="hamburger"></span>
          </button>

          <div class="nav-links" id="primary-links">
            <a href="/start-here" class={currentPath === '/start-here' ? 'active' : ''}>START HERE</a>
            <a href="/systems" class={currentPath === '/systems' || platforms.some(p => currentPath.includes(p.id)) ? 'active' : ''}>SYSTEMS</a>
            <a href="/vault" class={currentPath.includes('/vault') ? 'active' : ''}>VAULT</a>
            <a href="/about" class={currentPath === '/about' ? 'active' : ''}>ABOUT</a>
          </div>
          <Search />
          <ThemeToggle />
        </div>
      </nav>
    )}

    <Breadcrumbs platformColor={platformColor} items={breadcrumbs} currentLabel={currentLabel}>
      <Fragment slot="end"><slot name="breadcrumb-end" /></Fragment>
    </Breadcrumbs>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <Plate prefix="code" project="code" size={12} label="Code Like It's 198x" />
            </a>
            <p class="footer-tagline">Learn to program by building complete games on classic 8-bit and 16-bit systems.</p>
          </div>

          <div class="footer-links">
            <h2>Systems</h2>
            <ul>
              {platforms.map(p => (
                <li><a href={`/systems/${p.id}`}>{p.data.shortName}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-links">
            <h2>Resources</h2>
            <ul>
              <li><a href="/updates">What's New</a></li>
              <li><a href="/curriculum">Curriculum Map</a></li>
              <li><a href="/foundations">Foundations</a></li>
              <li><a href="/craft">The Craft</a></li>
              <li><a href="/from-the-metal">From the Metal</a></li>
              <li><a href="/field-notes">Field Notes</a></li>
              <li><a href="/standards">Sources & Standards</a></li>
              <li><a href="/vault">The Vault</a></li>
              <li><a href="/demoscene">Demoscene</a></li>
              <li><a href="/patterns">Pattern Library</a></li>
              <li><a href="/timeline">Timeline</a></li>
              <li><a href="/systems">Systems</a></li>
              <li><a href="/setup">Setup Guide</a></li>
            </ul>
          </div>

          <div class="footer-links">
            <h2>Community</h2>
            <ul>
              <li><a href="/contribute">Contribute</a></li>
              <li><a href="/colophon">Colophon</a></li>
              <li><a href="/press">Press</a></li>
              <li><a href="/teaching">For teachers</a></li>
              <li><a href="https://discord.gg/AdmEYQKWZb" target="_blank" rel="noopener">Discord</a></li>
              <li><a href="https://github.com/orgs/code198x/discussions" target="_blank" rel="noopener">GitHub Discussions</a></li>
              <li><a href="https://www.patreon.com/c/code_like_its_198x" target="_blank" rel="noopener">Patreon</a></li>
              <li><a href="https://code198x.substack.com/" target="_blank" rel="noopener">Newsletter</a></li>
              <li><a href="/rss.xml" class="rss-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <circle cx="6.18" cy="17.82" r="2.18"/>
                  <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/>
                </svg>
                RSS Feed
              </a></li>
            </ul>
          </div>
        </div>

        <div class="footer-family">
          <FamilyStrip
            hubHref="/family"
            siblings={[
              { name: 'Emu198x', href: 'https://github.com/emu198x' },
              { name: 'Asm198x', href: 'https://github.com/asm198x' },
              { name: 'Cat198x', href: 'https://github.com/cat198x' },
              { name: 'Build198x', href: 'https://github.com/build198x' },
            ]}
          />
        </div>

        <div class="footer-bottom">
          <p>© 2025–{new Date().getFullYear()} Code Like It's 198x</p>
          <p class="footer-credits">Open source • Made with care for retro computing</p>
          <p class="footer-rights">Original prose: <a href="/standards#licence">CC BY 4.0</a>. Code and third-party material have separate terms.</p>
          <p class="footer-rights">
            Games, artwork, logos and trademarks remain the property of their respective owners
            and are reproduced here to illustrate criticism and review.{' '}
            <a href="/standards#rights">Rights &amp; attribution</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<!-- Global reset. Astro scopes a component's styles to that component's own
     elements, so a `*` rule written in a scoped block covers this layout's
     markup and nothing any child component renders. The rules below have to
     be global to do the job they were written for. -->
<style is:global>
  /* Was declared scoped, so 190 of 310 elements on a unit page were still
     content-box — including containers whose padding was meant to inset their
     contents rather than widen them. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Form controls have never inherited the page font. Every button and input
     on the site was rendering in Arial against Nebula Sans. */
  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  /* display: block kills the descender gap under an image; max-width stops one
     overflowing its column. SVG is left inline on purpose — the icons here sit
     inside text and buttons, and blockifying them would move them. */
  img,
  picture,
  video,
  canvas {
    display: block;
    max-width: 100%;
  }

  svg {
    max-width: 100%;
  }

  /* Anything that can be jumped to clears the sticky bars above it. Without
     this a heading reached from the table of contents lands at the top of the
     window with the nav and the breadcrumb bar drawn over it — 100px of the
     page hidden, including the heading you asked for. --crumbs-height is
     published by Breadcrumbs; the fallback covers a page without it. */
  [id] {
    scroll-margin-top: calc(var(--nav-height) + var(--crumbs-height, 0px) + 1rem);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<style>
  /* ============================================
     Design Tokens - Simplified from archive
     ============================================ */
  :root {
    /* Shared roles resolve through House198x; component-specific machine ink
       and fill values remain derived by src/lib/contrast.ts. */
    --color-house: var(--h-ink);
    --color-house-2: var(--h-accent-ink);
    --color-house-tint: color-mix(in oklab, var(--h-accent) 10%, transparent);
    --color-primary: var(--h-accent-ink);
    --color-primary-dark: var(--h-accent-deep);
    --color-accent: var(--h-ink);
    --color-accent-dark: var(--h-accent-deep);

    /* Retro System Colors - These intentionally stay constant in dark mode */
    --c64-blue: #4a4dff;
    --c64-beige: #b8b5a3;
    --spectrum-red: #cc0000;
    --spectrum-rainbow: linear-gradient(90deg, #00FF00, #FFFF00, #00FFFF, #FF0000, #FF00FF);
    --nes-red: #e30613;
    --amiga-orange: #ff6600;

    /* Legacy aliases */
    --zx-magenta: #ff00ff;
    --zx-cyan: #00ffff;

    --color-bg: var(--h-page);
    --color-bg-secondary: var(--h-ground);
    --color-surface: var(--h-ground);
    --color-read: var(--h-page);
    --color-header-band: color-mix(in oklab, var(--h-ground) 88%, var(--h-page));
    --color-surface-translucent: color-mix(in oklab, var(--h-page) 94%, transparent);
    --paper-dot: color-mix(in oklab, var(--h-ink) 4%, transparent);
    --paper-dot-2: color-mix(in oklab, var(--h-ink) 2.5%, transparent);

    --color-text: var(--h-ink-body);
    --color-text-secondary: var(--h-ink-muted);
    --color-text-muted: var(--h-ink-muted);

    /* Default brand-ink (house brick) + white-safe button fill. Pages/components
       override --ink-l/--ink-d for their own brand colour; the --ink switch
       resolves the theme-correct one. */
    --ink-l: #ac482a;
    --ink-d: #e17b52;
    --btn-fill: var(--h-accent-deep);
    --color-border: var(--h-line);
    --color-border-light: var(--h-line-soft);

    /* Semantic Colors */
    --color-success: #22c55e;
    --color-success-muted: rgba(34, 197, 94, 0.15);
    --color-error: #ef4444;
    --color-error-muted: rgba(239, 68, 68, 0.1);
    --color-warning: #f59e0b;
    --color-warning-muted: rgba(245, 158, 11, 0.1);

    /* Diagrams in src/components/diagrams draw with these. They are SVG on a
       ground of their own, so they need a ground and an ink scale rather than
       the surface/text tokens the rest of the page uses. Each diagram keeps its
       own accent palette, because those carry meaning specific to it.

       The ground is transparent so a diagram sits on the page rather than in a
       panel on top of it. A diagram that needs a ground of its own — a pixel
       grid, where "no pixel" has to look like something — overrides this. */
    --diagram-bg: transparent;
    --diagram-ink: var(--color-text);
    --diagram-ink-dim: var(--color-text-secondary);
    --diagram-ink-faint: #8a8578;
    --diagram-rule: var(--color-border);
    --diagram-rule-faint: var(--color-border-light);

    /* Highlighting selects a matching light or dark palette. Keep the code
       surface with that palette: paper in light mode, terminal ground in dark. */
    --color-code-bg: light-dark(var(--color-surface), var(--h-code-bg));
    --color-code-text: light-dark(var(--color-text), var(--h-code-ink));

    /* Note/Callout Colors */
    --color-note-bg: var(--color-surface);
    --color-note-border: var(--color-primary);
    --color-note-text: var(--color-text);

    /* Difficulty Level Colors */
    --color-beginner: #10b981;
    --color-beginner-muted: rgba(16, 185, 129, 0.1);
    --color-intermediate: #3b82f6;
    --color-intermediate-muted: rgba(59, 130, 246, 0.1);
    --color-advanced: #a855f7;
    --color-advanced-muted: rgba(168, 85, 247, 0.1);

    --font-family-sans: var(--h-font-ui);
    --font-family-read: var(--h-font-read);
    --font-family-mono: var(--h-font-mono);

    --space-1: var(--h-space-1); --space-2: var(--h-space-2); --space-3: var(--h-space-3);
    --space-4: var(--h-space-4); --space-5: calc(var(--h-space-4) + var(--h-space-1));
    --space-6: var(--h-space-6); --space-8: var(--h-space-8); --space-10: calc(var(--h-space-8) + var(--h-space-2));
    --space-12: var(--h-space-12); --space-14: calc(var(--h-space-12) + var(--h-space-2));
    --space-16: var(--h-space-16); --space-20: calc(var(--h-space-16) + var(--h-space-4)); --space-24: var(--h-space-24);

    --shadow-sm: var(--h-lift-1);
    --shadow-md: var(--h-lift-1);
    --shadow-lg: var(--h-lift-2);
    --shadow-chunky: var(--h-lift-1);
    --shadow-chunky-hi: var(--h-lift-2);
    --transition-base: var(--h-rise) var(--h-ease);

    /* Layout */
    --container-max-width: 1440px;
    /* The inset every full-width bar uses: the nav, the breadcrumb trail and
       a unit's content. One value so they cannot drift apart. */
    --gutter: var(--h-inset);
    --nav-height: 4rem;
  }

  /* Dark Mode - via manual selection */
  :root[data-theme="dark"] {
    /* Semantic Colors - slightly brighter in dark mode */
    --color-success: #4ade80;
    --color-success-muted: rgba(74, 222, 128, 0.15);
    --color-error: #f87171;
    --color-error-muted: rgba(248, 113, 113, 0.1);
    --color-warning: #fbbf24;
    --color-warning-muted: rgba(251, 191, 36, 0.1);

    /* Diagram ink for the dark ground — the values the diagrams always had */
    --diagram-bg: transparent;
    --diagram-ink: #e0e0e0;
    --diagram-ink-dim: #aaa;
    --diagram-ink-faint: #666;
    --diagram-rule: #444;
    --diagram-rule-faint: #2b2419;

  }

  /* Dark Mode - via system preference (only when no manual selection) */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      /* Semantic Colors - slightly brighter in dark mode */
      --color-success: #4ade80;
      --color-success-muted: rgba(74, 222, 128, 0.15);
      --color-error: #f87171;
      --color-error-muted: rgba(248, 113, 113, 0.1);
      --color-warning: #fbbf24;
      --color-warning-muted: rgba(251, 191, 36, 0.1);

      /* Code blocks stay dark in both modes */
      --diagram-bg: transparent;
      --diagram-ink: #e0e0e0;
      --diagram-ink-dim: #aaa;
      --diagram-ink-faint: #666;
      --diagram-rule: #444;
      --diagram-rule-faint: #2b2419;

    }
  }

  /* ============================================
     Brand-ink: theme-aware accessible text colour
     Brand/platform colours used as small text must meet AA on the current
     theme's surface, but the same hex is too light on a light bg or too dark
     on a dark one. An ancestor sets --ink-l (light theme) and --ink-d (dark),
     each derived via accessibleInk() so a colour is nudged only as far as
     needed. The --ink var below resolves to the right one per theme, so any
     `color: var(--ink)` usage is automatically theme-correct. Fills, bars, and
     borders keep the raw brand colour. Falls back to --platform-color if inks
     aren't set, preserving prior behaviour.
     ============================================ */
  :global(*) {
    --ink: var(--ink-l, var(--platform-color));
    --chip-ink: var(--chip-ink-l, var(--ink));
  }
  :global(:root[data-theme="dark"] *) {
    --ink: var(--ink-d, var(--platform-color));
    --chip-ink: var(--chip-ink-d, var(--ink));
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme]) *) {
      --ink: var(--ink-d, var(--platform-color));
      --chip-ink: var(--chip-ink-d, var(--ink));
    }
  }
  :global(.brand-ink) {
    color: var(--ink);
  }

  /* ============================================
     Global Styles
     ============================================ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-family-sans);
    background-color: var(--color-bg);
    background-image:
      radial-gradient(var(--paper-dot) 1px, transparent 1.5px),
      radial-gradient(var(--paper-dot-2) 1px, transparent 1.6px);
    background-size: 5px 5px, 11px 11px;
    background-position: 0 0, 2px 3px;
    color: var(--color-text);
    line-height: var(--h-lh-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-size: var(--h-text-body);
    line-height: var(--h-lh-body);
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* Typography */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-family-sans);
    font-weight: 700;
    color: var(--h-ink);
    text-wrap: balance;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  h1 { font-size: var(--h-text-h1); line-height: var(--h-lh-h1); letter-spacing: var(--h-tr-h1); }
  h2 { font-size: var(--h-text-h2); line-height: var(--h-lh-h2); letter-spacing: var(--h-tr-h2); }
  h3 { font-size: var(--h-text-h3); line-height: var(--h-lh-h3); letter-spacing: var(--h-tr-h3); }
  h4 { font-size: var(--h-text-h4); line-height: var(--h-lh-h4); letter-spacing: var(--h-tr-h4); }
  h5, h6 { font-size: var(--h-text-small); line-height: var(--h-lh-small); }

  p {
    margin-bottom: var(--space-4);
  }

  /* Global, not scoped. Astro scopes a component's styles by default, so a
     bare `a` here compiled to `a[data-astro-cid-…]` and matched only links
     written in this file — never the ones inside MDX prose, which fell back
     to the browser's #0000EE. On the dark background that is 1.9:1, against
     the 4.5:1 WCAG AA needs for body text; the colour below is 5.75:1.

     A component that styles its own links still wins: a scoped rule carries
     an attribute selector and outranks this. It is the floor, not an
     override. */
  :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  :global(a:hover) {
    color: var(--color-primary-dark);
  }

  code {
    font-family: var(--font-family-mono);
    background: var(--color-surface);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;                  /* square — structural block */
    padding: var(--space-4);
    overflow-x: auto;
    margin: var(--space-4) 0;
  }

  pre code {
    background: none;
    padding: 0;
  }

  /* The mono face ships programming ligatures, which draw >= as an unkeyable
     single glyph. Listings here are meant to be typed character for character,
     so code shows the keystrokes rather than the typographic contraction.
     UnitLayout already does this for curriculum pages; this covers the rest. */
  :global(code),
  :global(pre) {
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "calt" 0;
  }

  /* ============================================
     Table Styles - Retro-inspired, readable
     ============================================ */
  :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;                  /* square — structural block */
    overflow: hidden;
    font-size: 0.95rem;
  }

  :global(thead) {
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--color-primary) 15%, var(--color-surface) 85%),
      color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%)
    );
    border-bottom: 2px solid var(--color-border);
  }

  :global(th) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
    letter-spacing: 0.025em;
  }

  :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  /* Zebra striping */
  :global(tbody tr:nth-child(even)) {
    background: color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%);
  }

  /* Hover effect */
  :global(tbody tr:hover) {
    background: color-mix(in oklab, var(--color-primary) 8%, var(--color-surface) 92%);
    transition: background var(--transition-base);
  }

  /* Last row no border */
  :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  /* Code/hex values in tables */
  :global(td code), :global(th code) {
    font-family: var(--font-family-mono);
    font-size: 0.875em;
    background: color-mix(in oklab, var(--color-bg) 50%, transparent 50%);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  /* Responsive tables */
  @media (max-width: 768px) {
    :global(table) {
      font-size: 0.875rem;
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    :global(th), :global(td) {
      padding: var(--space-2) var(--space-3);
    }

    /* Only nowrap for code/hex columns */
    :global(td code), :global(th code) {
      white-space: nowrap;
    }
  }

  /* ============================================
     Navigation
     ============================================ */
  .nav {
    background: var(--color-surface-translucent);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .nav-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--gutter);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo :global(.h-plate) {
    flex: 0 0 auto;
  }

  .nav-logo img {
    height: 32px;
    width: auto;
  }

  .logo-compact {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin-left: auto;
  }

  .nav-links a {
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
    position: relative;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.active {
    color: var(--color-primary);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
  }

  /* Hamburger Button - Hidden on Desktop */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-2);
    touch-action: manipulation;
    z-index: 101;
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    position: relative;
    transition: background var(--transition-base);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    left: 0;
    transition: transform var(--transition-base);
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  /* Hamburger animation when open */
  .nav-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .hamburger::before {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-toggle[aria-expanded="true"] .hamburger::after {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile/Tablet Navigation - hamburger menu for screens under 1024px */
  @media (max-width: 1024px) {
    :root {
      --gutter: var(--space-3);
    }

    .nav-container {
      gap: var(--space-2);
    }

    .logo-full {
      display: none;
    }

    .logo-compact {
      display: block;
      height: 36px;
    }

    /* Push all items after logo to the right */
    .nav-container > :global(.search-trigger) {
      margin-left: auto;
      order: 1;
    }

    .nav-container > :global(.theme-toggle) {
      order: 2;
    }

    .nav-toggle {
      display: block;
      order: 3;
    }

    .nav-links {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: var(--space-4);
      gap: 0;
      transform: translateY(-10px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0.25s;
      box-shadow: var(--shadow-lg);
    }

    .nav-links.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links a {
      padding: var(--space-3) var(--space-4);
      border-radius: 0;
      font-size: 1rem;
      /* Staggered animation for links */
      opacity: 0;
      transform: translateX(-10px);
      transition: background var(--transition-base),
                  color var(--transition-base),
                  opacity 0.2s ease,
                  transform 0.2s ease;
    }

    /* Staggered delays for each link */
    .nav-links.open a:nth-child(1) { transition-delay: 0.05s; }
    .nav-links.open a:nth-child(2) { transition-delay: 0.08s; }
    .nav-links.open a:nth-child(3) { transition-delay: 0.11s; }
    .nav-links.open a:nth-child(4) { transition-delay: 0.14s; }
    .nav-links.open a:nth-child(5) { transition-delay: 0.17s; }
    .nav-links.open a:nth-child(6) { transition-delay: 0.20s; }
    .nav-links.open a:nth-child(7) { transition-delay: 0.23s; }
    .nav-links.open a:nth-child(8) { transition-delay: 0.26s; }
    .nav-links.open a:nth-child(9) { transition-delay: 0.29s; }

    .nav-links.open a {
      opacity: 1;
      transform: translateX(0);
    }

    .nav-links a:hover {
      background: var(--color-bg-secondary);
    }

    .nav-links a.active {
      background: color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%);
    }

    .nav-links a.active::after {
      display: none;
    }

    .nav-logo {
      font-size: 1rem;
    }
  }

  /* ============================================
     Footer
     ============================================ */
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0 var(--space-8);
  }

  .footer-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    display: inline-flex;
    margin-bottom: var(--space-3);
  }

  .footer-tagline {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  .footer-links h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: var(--space-2);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rss-link svg {
    color: #f26522;
  }

  .footer-family {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .footer-family span {
    color: var(--color-text-secondary);
  }

  .footer-family a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color var(--transition-base);
  }

  .footer-family a:hover {
    color: var(--color-primary);
  }

  .footer-family-sep {
    opacity: 0.5;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-bottom p {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    margin: 0;
  }

  .footer-credits {
    font-size: 0.8125rem;
  }

  /* Standing rights notice — required on every public surface carrying imagery
     by 198x/decisions/publishing-third-party-imagery.md. Full-width so it reads
     as a statement rather than a footer credit sitting beside the copyright. */
  /* No opacity muting here: this is small text, and dimming it below
     --color-text-secondary is what failed AA in light theme. Same trap the
     footer credits fell into. */
  .footer-rights {
    flex-basis: 100%;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .footer-rights a {
    color: inherit;
    text-decoration: underline;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: none;
      text-align: center;
    }

    .footer-logo {
      margin-bottom: var(--space-2);
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-links h2 {
      margin-top: var(--space-2);
    }
  }

  /* ============================================
     Buttons
     ============================================ */
  :global(.btn) {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: 0;                  /* square — brand signature */
    font-weight: 600;
    text-decoration: none;
    touch-action: manipulation;
    transition: transform var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base), color var(--transition-base), border-color var(--transition-base);
    border: 3px solid transparent;
    box-shadow: var(--shadow-chunky);  /* chunky hard offset */
    cursor: pointer;
    text-align: center;
  }

  :global(.btn:hover),
  :global(.btn:focus-visible) {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-chunky-hi);
  }

  :global(.btn:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Primary filled button - platform fill (white-safe) via CSS variable, else
     house brick. --platform-fill is a darkened brand shade so white text meets
     AA; falls back to the theme's --btn-fill (house) when no platform class. */
  :global(.btn-primary) {
    background: var(--platform-fill, var(--btn-fill));
    color: white;
    border-color: var(--platform-fill, var(--btn-fill));
  }

  :global(.btn-primary:hover) {
    color: white;
  }

  /* Secondary outlined button - accessible ink text, raw brand border */
  :global(.btn-secondary) {
    background: var(--color-surface);
    color: var(--ink);
    border-color: var(--platform-color, var(--color-primary));
  }

  :global(.btn-secondary:hover) {
    background: var(--platform-fill, var(--btn-fill));
    color: white;
  }

  /* ============================================
     Utilities
     ============================================ */
  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .content-container {
    max-width: 65ch;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  /* Skip to content (accessibility) */
  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    z-index: 200;
  }

  .skip-to-content:focus {
    top: 0;
  }

  /* ============================================
     Keyboard Navigation Indicator
     ============================================ */
  /* Hide focus rings for mouse users, show for keyboard */
  :global(.using-mouse) *:focus {
    outline: none;
  }

  :global(.using-mouse) *:focus-visible {
    outline: none;
  }

  :global(:not(.using-mouse)) *:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ============================================
     Reduced Motion Support
     ============================================ */

  /* ============================================
     Print Styles
     ============================================ */
  @media print {
    .nav,
    .footer,
    .skip-to-content {
      display: none !important;
    }

    body {
      background: white !important;
      color: black !important;
    }

    main {
      padding: 0 !important;
    }

    a {
      color: black !important;
      text-decoration: underline !important;
    }

    a[href^="http"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #666;
    }

    pre, code {
      background: #f5f5f5 !important;
      border: 1px solid #ccc !important;
    }

    img {
      max-width: 100% !important;
    }
  }
</style>

<script>
  // Resolve the current shell on each event: Astro navigation replaces its
  // elements without re-running this bundled script.
  function setNavigationOpen(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const links = document.querySelector<HTMLElement>('.nav-links');
    toggle?.setAttribute('aria-expanded', String(open));
    links?.classList.toggle('open', open);
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const toggle = event.target.closest('.nav-toggle');
    if (toggle) {
      setNavigationOpen(toggle.getAttribute('aria-expanded') !== 'true');
    } else if (event.target.closest('.nav-links a') || !event.target.closest('.nav-links')) {
      setNavigationOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setNavigationOpen(false);
      toggle.focus();
    }
  });

  // Keyboard vs mouse navigation detection
  // Add .using-mouse class when mouse is used, remove when Tab is pressed
  document.addEventListener('mousedown', () => {
    document.documentElement.classList.add('using-mouse');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      document.documentElement.classList.remove('using-mouse');
    }
  });
</script>
