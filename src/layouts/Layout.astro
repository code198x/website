---
import '../styles/global.css';
import '../styles/prism-retro.css';
import '../styles/lessons.css';
import PrismLoader from '../components/PrismLoader.astro';

export interface Props {
  title: string;
  description?: string;
  isHomepage?: boolean;
  isDark?: boolean;
}

const { title, description = "Learn vintage computer programming with Code Like It's 198x - master classic systems like Commodore 64, ZX Spectrum, Amiga, and NES through hands-on lessons and projects.", isHomepage = false, isDark = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Code Like It's 198x</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Code Like It's 198x" />
    <meta property="og:image" content="/logo-stacked.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/logo-stacked.svg" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Oxanium:wght@700&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    
    <!-- Prism.js for syntax highlighting -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
  </head>
  <body class={isDark ? 'page-dark' : ''}>
    <div class="app-layout">
      <!-- Sidebar -->
      <aside class="sidebar" style="font-family: var(--font-heading)">
        <!-- Logo -->
        <div class="flex justify-center" style="margin-bottom: var(--space-2xl);">
          <a href="/">
            <img src="/logo-stacked.svg" alt="Code Like It's 198x" style="height: 8rem; width: auto;" />
          </a>
        </div>
        
        <!-- Navigation -->
        <nav class="nav-menu">
          <a href="/getting-started" class="nav-link">
            <span class="icon">🚀</span>
            Start Here
          </a>
          <a href="/lessons" class="nav-link">
            <span class="icon">📚</span>
            Lessons
          </a>
          <a href="/about" class="nav-link">
            <span class="icon">ℹ️</span>
            About
          </a>
        </nav>
        
        <!-- Copyright -->
        <div style="margin-top: auto; padding-top: var(--space-xl); border-top: 1px solid var(--c64-beige-darker);">
          <p class="text-small text-muted text-center">
            &copy; 2024 Code Like It's 198x
          </p>
        </div>
      </aside>

      <!-- Mobile header -->
      <header class="mobile-header" style="font-family: var(--font-heading)">
        <a href="/">
          <img src="/logo-stacked.svg" alt="Code Like It's 198x" style="height: 3rem; width: auto;" />
        </a>
        <button id="mobile-menu-button" style="padding: var(--space-md); border-radius: var(--radius-md); color: var(--text-secondary); border: none; background: none; cursor: pointer;">
          <svg style="width: 1.5rem; height: 1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        
        <!-- Mobile menu (hidden by default) -->
        <nav id="mobile-menu" class="hidden" style="position: absolute; top: 100%; left: 0; right: 0; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border-top: 1px solid var(--c64-beige-darker); box-shadow: var(--shadow-lg); padding: var(--space-lg);">
          <a href="/getting-started" class="nav-link block" style="margin-bottom: var(--space-xs);">
            🚀 Start Here
          </a>
          <a href="/lessons" class="nav-link block" style="margin-bottom: var(--space-xs);">
            📚 Lessons
          </a>
          <a href="/about" class="nav-link block">
            ℹ️ About
          </a>
        </nav>
      </header>

      <!-- Main content area -->
      <main class={`main-content ${isHomepage ? 'no-padding' : ''}`}>
        <slot />
      </main>
    </div>
    
    <!-- Load custom Prism language definitions -->
    <PrismLoader />
    
    <script>
      // Mobile menu toggle
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      
      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
        
        // Close menu when clicking on a link
        const mobileMenuLinks = mobileMenu.querySelectorAll('a');
        mobileMenuLinks.forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
          });
        });
      }
    </script>
  </body>
</html>

