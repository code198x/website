  /* ============================================
     Buttons
     ============================================ */
  :global(.btn) {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
    border: 2px solid transparent;
    cursor: pointer;
    text-align: center;
  }

  :global(.btn:hover),
  :global(.btn:focus-visible) {
    transform: translateY(-2px);
  }

  :global(.btn:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Primary filled button - uses platform color via CSS variable */
  :global(.btn-primary) {
    background: var(--platform-color, var(--color-primary));
    color: white;
    border-color: var(--platform-color, var(--color-primary));
  }

  :global(.btn-primary:hover) {
    box-shadow: var(--shadow-lg);
    color: white;
  }

  /* Secondary outlined button - uses platform color via CSS variable */
  :global(.btn-secondary) {
    background: var(--color-surface);
    color: var(--platform-color, var(--color-primary));
    border-color: var(--platform-color, var(--color-primary));
  }

  :global(.btn-secondary:hover) {
    background: var(--platform-color, var(--color-primary));
    color: white;
  }

  /* Platform-specific button colors - reference root tokens */
  :global(.btn-c64) { --platform-color: var(--c64-blue); }
  :global(.btn-spectrum) { --platform-color: var(--spectrum-red); }
  :global(.btn-nes) { --platform-color: var(--nes-red); }
  :global(.btn-amiga) { --platform-color: var(--amiga-orange); }

  /* ============================================
     Utilities
     ============================================ */
  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .content-container {
    max-width: 65ch;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  /* Skip to content (accessibility) */
  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    z-index: 200;
  }

  .skip-to-content:focus {
    top: 0;
  }

  /* ============================================
     Keyboard Navigation Indicator
     ============================================ */
  /* Hide focus rings for mouse users, show for keyboard */
  :global(.using-mouse) *:focus {
    outline: none;
  }

  :global(.using-mouse) *:focus-visible {
    outline: none;
  }

  :global(:not(.using-mouse)) *:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ============================================
     Reduced Motion Support
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
