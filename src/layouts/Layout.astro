---
import '../styles/fonts.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Search from '../components/Search.astro';
import { getActivePlatforms } from '../lib/platforms';
import { inkStyle } from '../lib/contrast';


// Get platforms for nav and footer
const platforms = await getActivePlatforms();

interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description?: string;
  image?: string;
  showNav?: boolean;
  platformColor?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "Learn assembly by building games on classic 8-bit and 16-bit systems",
  image = "/og-image.png",
  showNav = true,
  platformColor,
  breadcrumbs
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = "https://code198x.com";
const fullTitle = `${title} | Code Like It's 198x`;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Code Like It's 198x" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme initialization (inline to prevent flash) -->
    <script is:inline>
      (function() {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        }
        // Apply on initial load
        applyTheme();
        // Re-apply after View Transitions page swap
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- View transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Navigation progress bar -->
    <style is:inline>
      #nav-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--color-primary, #3b82f6);
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
      }
      #nav-progress.loading {
        opacity: 1;
        animation: nav-progress-grow 8s cubic-bezier(0.2, 0.5, 0.1, 1) forwards;
      }
      #nav-progress.done {
        width: 100% !important;
        opacity: 0;
        transition: opacity 0.3s 0.1s;
      }
      @keyframes nav-progress-grow {
        0% { width: 0; }
        10% { width: 30%; }
        50% { width: 70%; }
        80% { width: 85%; }
        100% { width: 95%; }
      }
    </style>
    <script is:inline>
      (function() {
        var bar = document.createElement('div');
        bar.id = 'nav-progress';
        document.documentElement.appendChild(bar);

        document.addEventListener('astro:before-preparation', function() {
          bar.className = 'loading';
        });
        document.addEventListener('astro:after-swap', function() {
          bar.className = 'done';
          setTimeout(function() { bar.className = ''; }, 400);
        });
      })();
    </script>
  </head>
  <body style={platformColor ? `--platform-color: ${platformColor}; ${inkStyle(platformColor)}` : undefined}>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    {showNav && (
      <nav class="nav">
        <div class="nav-container">
          <a href="/" class="nav-logo">
            <img src="/logo-horizontal.svg" alt="Code Like It's 198x" height="32" class="logo-full" />
            <img src="/logo-198x.svg" alt="Code Like It's 198x" height="36" class="logo-compact" />
          </a>

          <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
            <span class="hamburger"></span>
          </button>

          <div class="nav-links">
            <a href="/who-this-is-for" class={currentPath === '/who-this-is-for' ? 'active' : ''}>START HERE</a>
            <a href="/systems" class={currentPath === '/systems' || platforms.some(p => currentPath.includes(p.id)) ? 'active' : ''}>SYSTEMS</a>
            <a href="/vault" class={currentPath.includes('/vault') ? 'active' : ''}>VAULT</a>
            <a href="/about" class={currentPath === '/about' ? 'active' : ''}>ABOUT</a>
          </div>
          <Search />
          <ThemeToggle />
        </div>
      </nav>
    )}

    <Breadcrumbs platformColor={platformColor} items={breadcrumbs} />

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <img src="/logo-horizontal.svg" alt="Code Like It's 198x" height="28" />
            </a>
            <p class="footer-tagline">Learn to program by building complete games on classic 8-bit and 16-bit systems.</p>
          </div>

          <div class="footer-links">
            <h2>Systems</h2>
            <ul>
              {platforms.map(p => (
                <li><a href={`/systems/${p.id}`}>{p.data.shortName}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-links">
            <h2>Resources</h2>
            <ul>
              <li><a href="/updates">What's New</a></li>
              <li><a href="/curriculum">Curriculum Map</a></li>
              <li><a href="/foundations">Foundations</a></li>
              <li><a href="/craft">The Craft</a></li>
              <li><a href="/from-the-metal">From the Metal</a></li>
              <li><a href="/field-notes">Field Notes</a></li>
              <li><a href="/standards">Sources & Standards</a></li>
              <li><a href="/vault">The Vault</a></li>
              <li><a href="/demoscene">Demoscene</a></li>
              <li><a href="/patterns">Pattern Library</a></li>
              <li><a href="/timeline">Timeline</a></li>
              <li><a href="/systems">The Fleet</a></li>
              <li><a href="/setup">Setup Guide</a></li>
            </ul>
          </div>

          <div class="footer-links">
            <h2>Community</h2>
            <ul>
              <li><a href="/contribute">Contribute</a></li>
              <li><a href="/colophon">Colophon</a></li>
              <li><a href="/press">Press</a></li>
              <li><a href="/teaching">For teachers</a></li>
              <li><a href="https://discord.gg/AdmEYQKWZb" target="_blank" rel="noopener">Discord</a></li>
              <li><a href="https://github.com/orgs/code198x/discussions" target="_blank" rel="noopener">GitHub Discussions</a></li>
              <li><a href="https://www.patreon.com/c/code_like_its_198x" target="_blank" rel="noopener">Patreon</a></li>
              <li><a href="https://code198x.substack.com/" target="_blank" rel="noopener">Newsletter</a></li>
              <li><a href="/rss.xml" class="rss-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <circle cx="6.18" cy="17.82" r="2.18"/>
                  <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/>
                </svg>
                RSS Feed
              </a></li>
            </ul>
          </div>
        </div>

        <div class="footer-family">
          <span>Part of the <a href="/family">198x family</a>:</span>
          <a href="https://github.com/emu198x" target="_blank" rel="noopener">Emu198x</a>
          <span class="footer-family-sep">·</span>
          <a href="https://github.com/asm198x" target="_blank" rel="noopener">Asm198x</a>
          <span class="footer-family-sep">·</span>
          <a href="https://github.com/cat198x" target="_blank" rel="noopener">Cat198x</a>
          <span class="footer-family-sep">·</span>
          <a href="https://github.com/build198x" target="_blank" rel="noopener">Build198x</a>
        </div>

        <div class="footer-bottom">
          <p>© 2025–{new Date().getFullYear()} Code Like It's 198x</p>
          <p class="footer-credits">Open source • Made with care for retro computing</p>
          <p class="footer-rights">
            Games, artwork, logos and trademarks remain the property of their respective owners
            and are reproduced here to illustrate criticism and review.{' '}
            <a href="/standards#rights">Rights &amp; attribution</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ============================================
     Design Tokens - Simplified from archive
     ============================================ */
  :root {
    /* Core Colors — house brand: deep newsprint brown + brick (deliberately not a platform colour) */
    --color-house: #3a2c1f;
    --color-house-2: #b74d2d;
    --color-house-tint: rgba(192, 81, 47, 0.10);
    --color-primary: var(--color-house-2);   /* was generic blue #3b82f6 */
    --color-primary-dark: #a8401f;
    --color-accent: var(--color-house);
    --color-accent-dark: #2a2017;

    /* Retro System Colors - These intentionally stay constant in dark mode */
    --c64-blue: #4a4dff;
    --c64-beige: #b8b5a3;
    --spectrum-red: #cc0000;
    --spectrum-rainbow: linear-gradient(90deg, #00FF00, #FFFF00, #00FFFF, #FF0000, #FF00FF);
    --nes-red: #e30613;
    --amiga-orange: #ff6600;

    /* Legacy aliases */
    --zx-magenta: #ff00ff;
    --zx-cyan: #00ffff;

    /* Background Colors */
    --color-bg: #f4f1e8; /* Classic C64 beige */
    --color-bg-secondary: #ebe8df;
    --color-surface: #fdfcf7;
    --color-read: #fbf9f2; /* warm near-white reading column */
    --paper-dot: rgba(0, 0, 0, 0.04);   /* newsprint texture */
    --paper-dot-2: rgba(0, 0, 0, 0.025);

    /* Text Colors — contract: secondary = small informational text (AA ~7:1);
       muted = decorative / large-only, never small text */
    --color-text: #1e293b;
    --color-text-secondary: #475569;
    --color-text-muted: #606773;

    /* Default brand-ink (house brick) + white-safe button fill. Pages/components
       override --ink-l/--ink-d for their own brand colour; the --ink switch
       resolves the theme-correct one. */
    --ink-l: #ac482a;
    --ink-d: #e17b52;
    --btn-fill: #b74d2d;

    /* Border Colors */
    --color-border: #d6d3ca;
    --color-border-light: #e8e5dc;

    /* Semantic Colors */
    --color-success: #22c55e;
    --color-success-muted: rgba(34, 197, 94, 0.15);
    --color-error: #ef4444;
    --color-error-muted: rgba(239, 68, 68, 0.1);
    --color-warning: #f59e0b;
    --color-warning-muted: rgba(245, 158, 11, 0.1);

    /* Code Block Colors */
    --color-code-bg: #1e1e1e;
    --color-code-text: #d4d4d4;

    /* Note/Callout Colors */
    --color-note-bg: var(--color-surface);
    --color-note-border: var(--color-primary);
    --color-note-text: var(--color-text);

    /* Translucent Surfaces */
    --color-surface-translucent: rgba(253, 252, 247, 0.95);

    /* Difficulty Level Colors */
    --color-beginner: #10b981;
    --color-beginner-muted: rgba(16, 185, 129, 0.1);
    --color-intermediate: #3b82f6;
    --color-intermediate-muted: rgba(59, 130, 246, 0.1);
    --color-advanced: #a855f7;
    --color-advanced-muted: rgba(168, 85, 247, 0.1);

    /* Typography — the House198x roster, bundled in public/fonts and declared
       in styles/fonts.css. Three faces, three jobs, per §4 of
       198x/decisions/family-visual-identity.md. Self-hosted rather than fetched:
       Nebula Sans is not on Google Fonts, and fontsource carries a Latin-only
       cut, which would put a Cyrillic machine name in the reader's fallback
       sans beside headings that rendered correctly. */
    --font-family-sans: 'Nebula Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --font-family-read: Literata, Georgia, 'Times New Roman', serif;
    --font-family-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;

    /* Spacing */
    --space-1: 0.25rem;   /* 4px */
    --space-2: 0.5rem;    /* 8px */
    --space-3: 0.75rem;   /* 12px */
    --space-4: 1rem;      /* 16px */
    --space-5: 1.25rem;   /* 20px */
    --space-6: 1.5rem;    /* 24px */
    --space-8: 2rem;      /* 32px */
    --space-10: 2.5rem;   /* 40px */
    --space-12: 3rem;     /* 48px */
    --space-14: 3.5rem;   /* 56px */
    --space-16: 4rem;     /* 64px */
    --space-20: 5rem;     /* 80px */
    --space-24: 6rem;     /* 96px */

    /* Shadows */
    --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    --shadow-chunky: 4px 4px 0 rgb(0 0 0 / 0.18);    /* brutalist hard offset */
    --shadow-chunky-hi: 6px 6px 0 rgb(0 0 0 / 0.18);

    /* Transitions */
    --transition-base: 150ms cubic-bezier(0.4, 0, 0.2, 1);

    /* Layout */
    --container-max-width: 1280px;
    --nav-height: 4rem;
  }

  /* Dark Mode - via manual selection */
  :root[data-theme="dark"] {
    /* warm "ink on dark paper" — ratified over cool slate (see visual-direction-synthesis) */
    --color-house: #caa46f;
    --color-house-2: #e0744a;
    --color-house-tint: rgba(224, 116, 74, 0.14);
    --color-primary: var(--color-house-2);
    --color-primary-dark: #c0512f;
    --color-accent: var(--color-house);
    --color-accent-dark: #b98a4f;

    --color-bg: #1a1714;
    --color-bg-secondary: #221d16;
    --color-surface: #242019;
    --color-read: #211d17;
    --paper-dot: rgba(255, 255, 255, 0.03);   /* newsprint texture, inverted for dark */
    --paper-dot-2: rgba(255, 255, 255, 0.02);

    --color-text: #efe7d6;
    --color-text-secondary: #b9ad96;
    --color-text-muted: #b9ad96;

    /* White-safe primary-button fill for dark mode (house orange is too light
       for white text at full strength). */
    --btn-fill: #c85122;

    --color-border: #3a342a;
    --color-border-light: #4a4234;

    /* Semantic Colors - slightly brighter in dark mode */
    --color-success: #4ade80;
    --color-success-muted: rgba(74, 222, 128, 0.15);
    --color-error: #f87171;
    --color-error-muted: rgba(248, 113, 113, 0.1);
    --color-warning: #fbbf24;
    --color-warning-muted: rgba(251, 191, 36, 0.1);

    /* Code blocks stay dark in both modes */
    --color-code-bg: #15130f;
    --color-code-text: #e4ddcb;

    /* Translucent Surfaces */
    --color-surface-translucent: rgba(26, 23, 20, 0.92);

    --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.4);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4);
    --shadow-chunky: 4px 4px 0 #322a1c;       /* warm offset lighter than the page */
    --shadow-chunky-hi: 6px 6px 0 #3a3020;
  }

  /* Dark Mode - via system preference (only when no manual selection) */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      /* warm "ink on dark paper" — auto (system preference) */
      --color-house: #caa46f;
      --color-house-2: #e0744a;
      --color-house-tint: rgba(224, 116, 74, 0.14);
      --color-primary: var(--color-house-2);
      --color-primary-dark: #c0512f;
      --color-accent: var(--color-house);
      --color-accent-dark: #b98a4f;

      --color-bg: #1a1714;
      --color-bg-secondary: #221d16;
      --color-surface: #242019;
      --color-read: #211d17;
      --paper-dot: rgba(255, 255, 255, 0.03);
      --paper-dot-2: rgba(255, 255, 255, 0.02);

      --color-text: #efe7d6;
      --color-text-secondary: #b9ad96;
      --color-text-muted: #b9ad96;

      --btn-fill: #c85122;

      --color-border: #3a342a;
      --color-border-light: #4a4234;

      /* Semantic Colors - slightly brighter in dark mode */
      --color-success: #4ade80;
      --color-success-muted: rgba(74, 222, 128, 0.15);
      --color-error: #f87171;
      --color-error-muted: rgba(248, 113, 113, 0.1);
      --color-warning: #fbbf24;
      --color-warning-muted: rgba(251, 191, 36, 0.1);

      /* Code blocks stay dark in both modes */
      --color-code-bg: #15130f;
      --color-code-text: #e4ddcb;

      /* Translucent Surfaces */
      --color-surface-translucent: rgba(26, 23, 20, 0.92);

      --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.4);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4);
      --shadow-chunky: 4px 4px 0 #322a1c;
      --shadow-chunky-hi: 6px 6px 0 #3a3020;
    }
  }

  /* ============================================
     Brand-ink: theme-aware accessible text colour
     Brand/platform colours used as small text must meet AA on the current
     theme's surface, but the same hex is too light on a light bg or too dark
     on a dark one. An ancestor sets --ink-l (light theme) and --ink-d (dark),
     each derived via accessibleInk() so a colour is nudged only as far as
     needed. The --ink var below resolves to the right one per theme, so any
     `color: var(--ink)` usage is automatically theme-correct. Fills, bars, and
     borders keep the raw brand colour. Falls back to --platform-color if inks
     aren't set, preserving prior behaviour.
     ============================================ */
  :global(*) {
    --ink: var(--ink-l, var(--platform-color));
    --chip-ink: var(--chip-ink-l, var(--ink));
  }
  :global(:root[data-theme="dark"] *) {
    --ink: var(--ink-d, var(--platform-color));
    --chip-ink: var(--chip-ink-d, var(--ink));
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme]) *) {
      --ink: var(--ink-d, var(--platform-color));
      --chip-ink: var(--chip-ink-d, var(--ink));
    }
  }
  :global(.brand-ink) {
    color: var(--ink);
  }

  /* ============================================
     Global Styles
     ============================================ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-family-sans);
    background-color: var(--color-bg);
    background-image:
      radial-gradient(var(--paper-dot) 1px, transparent 1.5px),
      radial-gradient(var(--paper-dot-2) 1px, transparent 1.6px);
    background-size: 5px 5px, 11px 11px;
    background-position: 0 0, 2px 3px;
    color: var(--color-text);
    line-height: 1.6;
    font-size: 16px;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* Typography */
  h1, h2, h3, h4, h5, h6 {
    font-weight: 700;
    line-height: 1.2;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  h1 { font-size: 2.5rem; }
  h2 { font-size: 2rem; }
  h3 { font-size: 1.5rem; }
  h4 { font-size: 1.25rem; }
  h5 { font-size: 1.125rem; }
  h6 { font-size: 1rem; }

  p {
    margin-bottom: var(--space-4);
  }

  /* Global, not scoped. Astro scopes a component's styles by default, so a
     bare `a` here compiled to `a[data-astro-cid-…]` and matched only links
     written in this file — never the ones inside MDX prose, which fell back
     to the browser's #0000EE. On the dark background that is 1.9:1, against
     the 4.5:1 WCAG AA needs for body text; the colour below is 5.75:1.

     A component that styles its own links still wins: a scoped rule carries
     an attribute selector and outranks this. It is the floor, not an
     override. */
  :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  :global(a:hover) {
    color: var(--color-primary-dark);
  }

  code {
    font-family: var(--font-family-mono);
    background: var(--color-surface);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;                  /* square — structural block */
    padding: var(--space-4);
    overflow-x: auto;
    margin: var(--space-4) 0;
  }

  pre code {
    background: none;
    padding: 0;
  }

  /* The mono face ships programming ligatures, which draw >= as an unkeyable
     single glyph. Listings here are meant to be typed character for character,
     so code shows the keystrokes rather than the typographic contraction.
     UnitLayout already does this for curriculum pages; this covers the rest. */
  :global(code),
  :global(pre) {
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "calt" 0;
  }

  /* ============================================
     Table Styles - Retro-inspired, readable
     ============================================ */
  :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;                  /* square — structural block */
    overflow: hidden;
    font-size: 0.95rem;
  }

  :global(thead) {
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--color-primary) 15%, var(--color-surface) 85%),
      color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%)
    );
    border-bottom: 2px solid var(--color-border);
  }

  :global(th) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
    letter-spacing: 0.025em;
  }

  :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  /* Zebra striping */
  :global(tbody tr:nth-child(even)) {
    background: color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%);
  }

  /* Hover effect */
  :global(tbody tr:hover) {
    background: color-mix(in oklab, var(--color-primary) 8%, var(--color-surface) 92%);
    transition: background var(--transition-base);
  }

  /* Last row no border */
  :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  /* Code/hex values in tables */
  :global(td code), :global(th code) {
    font-family: var(--font-family-mono);
    font-size: 0.875em;
    background: color-mix(in oklab, var(--color-bg) 50%, transparent 50%);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  /* Responsive tables */
  @media (max-width: 768px) {
    :global(table) {
      font-size: 0.875rem;
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    :global(th), :global(td) {
      padding: var(--space-2) var(--space-3);
    }

    /* Only nowrap for code/hex columns */
    :global(td code), :global(th code) {
      white-space: nowrap;
    }
  }

  /* ============================================
     Navigation
     ============================================ */
  .nav {
    background: var(--color-surface-translucent);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .nav-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--space-4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 32px;
    width: auto;
  }

  .logo-compact {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin-left: auto;
  }

  .nav-links a {
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
    position: relative;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.active {
    color: var(--color-primary);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
  }

  /* Hamburger Button - Hidden on Desktop */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    z-index: 101;
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    position: relative;
    transition: background var(--transition-base);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    left: 0;
    transition: transform var(--transition-base);
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  /* Hamburger animation when open */
  .nav-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .hamburger::before {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-toggle[aria-expanded="true"] .hamburger::after {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile/Tablet Navigation - hamburger menu for screens under 1024px */
  @media (max-width: 1024px) {
    .nav-container {
      gap: var(--space-2);
      padding: 0 var(--space-3);
    }

    .logo-full {
      display: none;
    }

    .logo-compact {
      display: block;
      height: 36px;
    }

    /* Push all items after logo to the right */
    .nav-container > :global(.search-trigger) {
      margin-left: auto;
      order: 1;
    }

    .nav-container > :global(.theme-toggle) {
      order: 2;
    }

    .nav-toggle {
      display: block;
      order: 3;
    }

    .nav-links {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: var(--space-4);
      gap: 0;
      transform: translateY(-10px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0.25s;
      box-shadow: var(--shadow-lg);
    }

    .nav-links.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links a {
      padding: var(--space-3) var(--space-4);
      border-radius: 0;
      font-size: 1rem;
      /* Staggered animation for links */
      opacity: 0;
      transform: translateX(-10px);
      transition: background var(--transition-base),
                  color var(--transition-base),
                  opacity 0.2s ease,
                  transform 0.2s ease;
    }

    /* Staggered delays for each link */
    .nav-links.open a:nth-child(1) { transition-delay: 0.05s; }
    .nav-links.open a:nth-child(2) { transition-delay: 0.08s; }
    .nav-links.open a:nth-child(3) { transition-delay: 0.11s; }
    .nav-links.open a:nth-child(4) { transition-delay: 0.14s; }
    .nav-links.open a:nth-child(5) { transition-delay: 0.17s; }
    .nav-links.open a:nth-child(6) { transition-delay: 0.20s; }
    .nav-links.open a:nth-child(7) { transition-delay: 0.23s; }
    .nav-links.open a:nth-child(8) { transition-delay: 0.26s; }
    .nav-links.open a:nth-child(9) { transition-delay: 0.29s; }

    .nav-links.open a {
      opacity: 1;
      transform: translateX(0);
    }

    .nav-links a:hover {
      background: var(--color-bg-secondary);
    }

    .nav-links a.active {
      background: color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%);
    }

    .nav-links a.active::after {
      display: none;
    }

    .nav-logo {
      font-size: 1rem;
    }
  }

  /* ============================================
     Footer
     ============================================ */
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) var(--space-4) var(--space-8);
  }

  .footer-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .footer-logo img {
    height: 28px;
    width: auto;
    opacity: 0.9;
    transition: opacity var(--transition-base);
  }

  .footer-logo:hover img {
    opacity: 1;
  }

  .footer-tagline {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  .footer-links h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: var(--space-2);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rss-link svg {
    color: #f26522;
  }

  .footer-family {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .footer-family span {
    color: var(--color-text-secondary);
  }

  .footer-family a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color var(--transition-base);
  }

  .footer-family a:hover {
    color: var(--color-primary);
  }

  .footer-family-sep {
    opacity: 0.5;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-bottom p {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    margin: 0;
  }

  .footer-credits {
    font-size: 0.8125rem;
  }

  /* Standing rights notice — required on every public surface carrying imagery
     by 198x/decisions/publishing-third-party-imagery.md. Full-width so it reads
     as a statement rather than a footer credit sitting beside the copyright. */
  /* No opacity muting here: this is small text, and dimming it below
     --color-text-secondary is what failed AA in light theme. Same trap the
     footer credits fell into. */
  .footer-rights {
    flex-basis: 100%;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .footer-rights a {
    color: inherit;
    text-decoration: underline;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: none;
      text-align: center;
    }

    .footer-logo {
      margin-bottom: var(--space-2);
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-links h2 {
      margin-top: var(--space-2);
    }
  }

  /* ============================================
     Buttons
     ============================================ */
  :global(.btn) {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: 0;                  /* square — brand signature */
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
    border: 3px solid transparent;
    box-shadow: var(--shadow-chunky);  /* chunky hard offset */
    cursor: pointer;
    text-align: center;
  }

  :global(.btn:hover),
  :global(.btn:focus-visible) {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-chunky-hi);
  }

  :global(.btn:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Primary filled button - platform fill (white-safe) via CSS variable, else
     house brick. --platform-fill is a darkened brand shade so white text meets
     AA; falls back to the theme's --btn-fill (house) when no platform class. */
  :global(.btn-primary) {
    background: var(--platform-fill, var(--btn-fill));
    color: white;
    border-color: var(--platform-fill, var(--btn-fill));
  }

  :global(.btn-primary:hover) {
    color: white;
  }

  /* Secondary outlined button - accessible ink text, raw brand border */
  :global(.btn-secondary) {
    background: var(--color-surface);
    color: var(--ink);
    border-color: var(--platform-color, var(--color-primary));
  }

  :global(.btn-secondary:hover) {
    background: var(--platform-fill, var(--btn-fill));
    color: white;
  }

  /* ============================================
     Utilities
     ============================================ */
  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .content-container {
    max-width: 65ch;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  /* Skip to content (accessibility) */
  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    z-index: 200;
  }

  .skip-to-content:focus {
    top: 0;
  }

  /* ============================================
     Keyboard Navigation Indicator
     ============================================ */
  /* Hide focus rings for mouse users, show for keyboard */
  :global(.using-mouse) *:focus {
    outline: none;
  }

  :global(.using-mouse) *:focus-visible {
    outline: none;
  }

  :global(:not(.using-mouse)) *:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ============================================
     Reduced Motion Support
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ============================================
     Print Styles
     ============================================ */
  @media print {
    .nav,
    .footer,
    .skip-to-content {
      display: none !important;
    }

    body {
      background: white !important;
      color: black !important;
    }

    main {
      padding: 0 !important;
    }

    a {
      color: black !important;
      text-decoration: underline !important;
    }

    a[href^="http"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #666;
    }

    pre, code {
      background: #f5f5f5 !important;
      border: 1px solid #ccc !important;
    }

    img {
      max-width: 100% !important;
    }
  }
</style>

<script>
  // Mobile navigation toggle
  const navToggle = document.querySelector('.nav-toggle');
  const navLinks = document.querySelector('.nav-links');

  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', (!isExpanded).toString());
      navLinks.classList.toggle('open');
    });

    // Close menu when clicking a link
    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navToggle.setAttribute('aria-expanded', 'false');
        navLinks.classList.remove('open');
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!navToggle.contains(e.target as Node) && !navLinks.contains(e.target as Node)) {
        navToggle.setAttribute('aria-expanded', 'false');
        navLinks.classList.remove('open');
      }
    });
  }

  // Keyboard vs mouse navigation detection
  // Add .using-mouse class when mouse is used, remove when Tab is pressed
  document.addEventListener('mousedown', () => {
    document.documentElement.classList.add('using-mouse');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      document.documentElement.classList.remove('using-mouse');
    }
  });
</script>
