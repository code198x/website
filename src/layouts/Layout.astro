---
/**
 * The shell every page shares: head, nav, breadcrumb trail, footer and the
 * global rules underneath them.
 *
 * Governed by 198x/decisions/family-visual-identity.md (§4 palette and type,
 * §6 scale and motion, §7 the cell system: interface square on an 8px cell,
 * inverse video for "current" and nothing else, dark leading) and by
 * sibling-cross-promotion.md for the footer family strip. The approved concept
 * is Code198x/website-preview/public/concepts/ (home, lesson, systems).
 *
 * Two places where it departs from the concept, both deliberate:
 *
 * - The nav is docked, not a floating island. The breadcrumb bar, the unit
 *   contents rail and the run panel are sticky and stack under it at
 *   --nav-height; an island floating above a docked bar leaves a strip of page
 *   scrolling through the gap between them.
 * - The theme control is the kit's ThemeToggle, three visible radios, not the
 *   concept's cycling icon button. The kit explains why in its header; where
 *   the kit and the concept differ, the kit wins.
 */
import '@198x-ui/tokens.css';
import '../styles/tint.css';
import '@198x-ui/fonts.css';
import { ClientRouter } from 'astro:transitions';
import ThemeBoot from '@198x-ui/components/ThemeBoot.astro';
import ThemeToggle from '@198x-ui/components/ThemeToggle.astro';
import Plate from '@198x-ui/components/Plate.astro';
import FamilyStrip from '@198x-ui/components/FamilyStrip.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Search from '../components/Search.astro';
import { getActivePlatforms } from '../lib/platforms';
import { inkStyle } from '../lib/contrast';

// Get platforms for nav and footer
const platforms = await getActivePlatforms();

interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description?: string;
  image?: string;
  showNav?: boolean;
  platformColor?: string;
  breadcrumbs?: BreadcrumbItem[];
  currentLabel?: string;
  /** Keep the page out of search engines while leaving it reachable. */
  noindex?: boolean;
}

const {
  title,
  description = "Learn programming by building complete games on classic 8-bit and 16-bit systems, in the languages people used at the time.",
  image = "/og-image.png",
  showNav = true,
  platformColor,
  breadcrumbs,
  currentLabel,
  noindex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = "https://code198x.com";
const fullTitle = `${title} | Code Like It's 198x`;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

/* The build writes directories, so a page's path ends in a slash ("/about/").
   Compare without it, or a section is never current on its own page. */
const here = currentPath.replace(/\/+$/, '') || '/';
const within = (base: string) => here === base || here.startsWith(`${base}/`);

/* Current is inverse video (§7). The section's own page is the page itself;
   anything beneath it is "in" the section, which aria-current="true" says. */
const nav = [
  { label: 'START HERE', href: '/start-here', page: here === '/start-here', section: false },
  {
    label: 'SYSTEMS',
    href: '/systems',
    page: here === '/systems',
    section: within('/systems') || platforms.some((p) => here.includes(p.id)),
  },
  { label: 'VAULT', href: '/vault', page: here === '/vault', section: within('/vault') },
  { label: 'ABOUT', href: '/about', page: here === '/about', section: false },
].map((item) => ({
  ...item,
  current: item.page ? 'page' : item.section ? 'true' : undefined,
}));

const THEME_KEY = 'theme';
---

<!DOCTYPE html>
<html lang="en-GB" data-tint="code">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Code Like It's 198x" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- The reader's stored theme, applied before paint. The key is the one
         this site has always used, so a choice made before the kit's toggle
         arrived still holds. -->
    <ThemeBoot storageKey={THEME_KEY} />
    <!-- ThemeBoot runs once per document. A soft navigation swaps in the new
         page's <html> attributes, which carry no data-theme, so the stored
         choice is put back before the new page paints. -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      document.addEventListener('astro:after-swap', () => {
        try {
          const t = localStorage.getItem(key);
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch {}
      });
    </script>

    <!-- View transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Navigation progress: answers a click while the next page loads. -->
    <style is:inline>
      #nav-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--h-accent);
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
      }
      #nav-progress.loading {
        opacity: 1;
        animation: nav-progress-grow 8s cubic-bezier(0.2, 0.5, 0.1, 1) forwards;
      }
      #nav-progress.done {
        width: 100% !important;
        opacity: 0;
        transition: opacity 0.3s 0.1s;
      }
      @keyframes nav-progress-grow {
        0% { width: 0; }
        10% { width: 30%; }
        50% { width: 70%; }
        80% { width: 85%; }
        100% { width: 95%; }
      }
    </style>
    <script is:inline>
      (function() {
        var bar = document.createElement('div');
        bar.id = 'nav-progress';
        document.documentElement.appendChild(bar);

        document.addEventListener('astro:before-preparation', function() {
          bar.className = 'loading';
        });
        document.addEventListener('astro:after-swap', function() {
          bar.className = 'done';
          setTimeout(function() { bar.className = ''; }, 400);
        });
      })();
    </script>
  </head>
  <body style={platformColor ? `--platform-color: ${platformColor}; ${inkStyle(platformColor)}` : undefined}>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    {showNav && (
      <header class="site-header">
        <div class="site-bar">
          <Plate prefix="code" project="code" size={13} href="/" label="Code Like It's 198x" />

          <nav class="nav-links" aria-label="Primary">
            <ul>
              {nav.map((item) => (
                <li><a href={item.href} aria-current={item.current}>{item.label}</a></li>
              ))}
            </ul>
          </nav>

          <div class="site-tools">
            <Search />
            <div class="bar-theme" transition:persist="theme-bar">
              <ThemeToggle storageKey={THEME_KEY} />
            </div>
            <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
              <span aria-hidden="true"></span><span aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="site-menu" id="site-menu">
          <nav aria-label="Menu">
            <ul>
              {nav.map((item) => (
                <li><a href={item.href} aria-current={item.current}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="menu-theme" transition:persist="theme-menu">
            <ThemeToggle storageKey={THEME_KEY} showLabel />
          </div>
        </div>
      </header>
    )}

    <Breadcrumbs platformColor={platformColor} items={breadcrumbs} currentLabel={currentLabel}>
      <Fragment slot="end"><slot name="breadcrumb-end" /></Fragment>
    </Breadcrumbs>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-brand">
            <Plate prefix="code" project="code" size={16} href="/" label="Code Like It's 198x" />
            <p class="footer-tagline">Learn to program by building complete games on classic 8-bit and 16-bit systems.</p>
          </div>

          <div class="footer-links">
            <h2>Systems</h2>
            <ul>
              {platforms.map(p => (
                <li><a href={`/systems/${p.id}`}>{p.data.shortName}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-links">
            <h2>Resources</h2>
            <ul>
              <li><a href="/updates">What's New</a></li>
              <li><a href="/curriculum">Curriculum Map</a></li>
              <li><a href="/foundations">Foundations</a></li>
              <li><a href="/craft">The Craft</a></li>
              <li><a href="/from-the-metal">From the Metal</a></li>
              <li><a href="/field-notes">Field Notes</a></li>
              <li><a href="/standards">Sources & Standards</a></li>
              <li><a href="/vault">The Vault</a></li>
              <li><a href="/demoscene">Demoscene</a></li>
              <li><a href="/patterns">Pattern Library</a></li>
              <li><a href="/timeline">Timeline</a></li>
              <li><a href="/systems">Systems</a></li>
              <li><a href="/setup">Setup Guide</a></li>
            </ul>
          </div>

          <div class="footer-links">
            <h2>Community</h2>
            <ul>
              <li><a href="/contribute">Contribute</a></li>
              <li><a href="/colophon">Colophon</a></li>
              <li><a href="/press">Press</a></li>
              <li><a href="/teaching">For teachers</a></li>
              <li><a href="https://discord.gg/AdmEYQKWZb" target="_blank" rel="noopener">Discord</a></li>
              <li><a href="https://github.com/orgs/code198x/discussions" target="_blank" rel="noopener">GitHub Discussions</a></li>
              <li><a href="https://www.patreon.com/c/code_like_its_198x" target="_blank" rel="noopener">Patreon</a></li>
              <li><a href="https://code198x.substack.com/" target="_blank" rel="noopener">Newsletter</a></li>
              <li><a href="/rss.xml">RSS Feed</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-legal">
          <div class="footer-family">
            <FamilyStrip
              hubHref="/family"
              siblings={[
                { name: 'Emu198x', href: 'https://github.com/emu198x' },
                { name: 'Asm198x', href: 'https://github.com/asm198x' },
                { name: 'Cat198x', href: 'https://github.com/cat198x' },
                { name: 'Build198x', href: 'https://github.com/build198x' },
              ]}
            />
          </div>
          <p>© 2025–{new Date().getFullYear()} Code Like It's 198x</p>
          <p>Open source • Made with care for retro computing</p>
          <p>Original prose: <a href="/standards#licence">CC BY 4.0</a>. Code and third-party material have separate terms.</p>
          <!-- Standing rights notice, required on every public surface carrying
               imagery by 198x/decisions/publishing-third-party-imagery.md. -->
          <p>
            Games, artwork, logos and trademarks remain the property of their respective owners
            and are reproduced here to illustrate criticism and review.{' '}
            <a href="/standards#rights">Rights &amp; attribution</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<!-- Global rules. Astro scopes a component's styles to that component's own
     elements, so anything meant to reach page content, MDX prose or a child
     component has to be global. -->
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Form controls have never inherited the page font. */
  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  /* display: block kills the descender gap under an image; max-width stops one
     overflowing its column. SVG is left inline on purpose — the icons here sit
     inside text and buttons, and blockifying them would move them. */
  img,
  picture,
  video,
  canvas {
    display: block;
    max-width: 100%;
  }

  svg {
    max-width: 100%;
  }

  /* Anything that can be jumped to clears the sticky bars above it.
     --crumbs-height is published by Breadcrumbs; the fallback covers a page
     without it. */
  [id] {
    scroll-margin-top: calc(var(--nav-height) + var(--crumbs-height, 0px) + 1rem);
  }

  /* ---- Type roles (§4) -------------------------------------------------
     Nebula Sans is the interface and the default; pages set their reading
     prose in Literata through --font-family-read. JetBrains Mono for anything
     the machine said. Captions are Literata italic everywhere, photographs
     included. Element selectors only, so a component's own rule still wins. */
  code, kbd, samp, pre {
    font-family: var(--h-font-mono);
  }

  figcaption {
    font-family: var(--h-font-read);
    font-style: italic;
  }

  /* Headings break into balanced lines. Face, size and colour stay with each
     page: some headings sit on bands of their own colour and inherit it. */
  :where(h1, h2, h3, h4, h5, h6) {
    text-wrap: balance;
  }

  /* ---- Focus and selection -------------------------------------------
     One focus ring, keyboard only: :focus-visible already leaves pointer
     clicks alone. A component that draws its own ring keeps it. */
  :focus-visible {
    outline: 2px solid var(--h-accent);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--h-accent);
    color: var(--h-ink-on-accent);
  }

  /* ---- Links ---------------------------------------------------------
     The floor for every link, MDX prose included: the accent at ink strength
     (--h-accent-ink, never the fill). A component that styles its own links
     outranks this; it is the floor, not an override. */
  a {
    color: var(--h-accent-ink);
    text-decoration: none;
    text-underline-offset: 0.18em;
    transition: color var(--h-rise) var(--h-ease);
  }

  a:hover {
    color: var(--h-accent-deep);
  }

  /* The mono face ships programming ligatures, which draw >= as an unkeyable
     single glyph. Listings here are meant to be typed character for character,
     so code shows the keystrokes rather than the typographic contraction. */
  code,
  pre {
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "calt" 0;
  }

  /* ---- Buttons -------------------------------------------------------
     Page bodies still write <a class="btn btn-primary">. These match the
     kit's Button (square, on the 8px cell, flat at rest, a lift on hover and
     focus that rises fast and decays slowly) until each page moves to the
     component itself. */
  .btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--h-cell);
    min-height: calc(var(--h-cell) * 7);
    padding: calc(var(--h-cell) - 1px) calc(var(--h-cell) * 3 - 1px);
    border: 1px solid var(--h-line);
    border-radius: 0;
    background: var(--h-shell);
    color: var(--h-ink);
    font-family: var(--h-font-ui);
    font-size: var(--h-text-small);
    font-weight: var(--h-weight-minor);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    touch-action: manipulation;
    cursor: pointer;
    transition:
      box-shadow var(--h-decay) var(--h-ease),
      background-color var(--h-decay) var(--h-ease),
      border-color var(--h-decay) var(--h-ease),
      color var(--h-decay) var(--h-ease);
  }

  .btn:hover,
  .btn:focus-visible {
    box-shadow: var(--h-lift-1);
    background: var(--h-wash);
    color: var(--h-ink);
    text-decoration: none;
    transition-duration: var(--h-rise);
  }

  .btn:active { transform: translate(1px, 1px); }

  .btn-primary {
    background: var(--h-accent);
    border-color: var(--h-accent);
    color: var(--h-ink-on-accent);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: var(--h-accent-hover);
    border-color: var(--h-accent-hover);
    color: var(--h-ink-on-accent);
  }

  .btn-secondary {
    background: var(--h-shell);
    color: var(--h-ink);
  }

  .btn-sm {
    min-height: calc(var(--h-cell) * 5);
    padding: calc(var(--h-cell) * 0.5 - 1px) calc(var(--h-cell) * 2 - 1px);
    font-size: var(--h-text-micro);
  }

  /* ---- Tables -------------------------------------------------------- */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    overflow: hidden;
    font-size: 0.95rem;
  }

  thead {
    background: color-mix(in oklab, var(--h-ink) 6%, var(--color-surface));
    border-bottom: 2px solid var(--color-border);
  }

  th {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
    letter-spacing: 0.025em;
  }

  td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  tbody tr:nth-child(even) {
    background: color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%);
  }

  tbody tr:hover {
    background: var(--h-wash);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  td code, th code {
    font-family: var(--font-family-mono);
    font-size: 0.875em;
    background: color-mix(in oklab, var(--color-bg) 50%, transparent 50%);
    padding: 0.125rem 0.375rem;
    border-radius: 0;
  }

  @media (max-width: 768px) {
    table {
      font-size: 0.875rem;
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    th, td {
      padding: var(--space-2) var(--space-3);
    }

    td code, th code {
      white-space: nowrap;
    }
  }

  /* ---- Reduced motion (§6) -------------------------------------------
     Everything that moves is off when the reader asks; the kit zeroes its own
     rise and decay. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<style>
  /* ============================================
     Site tokens
     Roles resolve through the kit (_198x-ui/tokens.css). What stays here is
     what the kit does not own: the legacy names page bodies still use, the
     state colours, the diagram scale, and the frame's own measurements.
     Machine ink and fill values are derived by src/lib/contrast.ts and never
     written down.
     ============================================ */
  :root {
    --color-house: var(--h-ink);
    --color-house-2: var(--h-accent-ink);
    --color-house-tint: color-mix(in oklab, var(--h-accent) 10%, transparent);
    --color-primary: var(--h-accent-ink);
    --color-accent: var(--h-ink);

    --color-bg: var(--h-page);
    --color-bg-secondary: var(--h-ground);
    --color-surface: var(--h-ground);
    --color-read: var(--h-page);
    --color-header-band: color-mix(in oklab, var(--h-ground) 88%, var(--h-page));

    --color-text: var(--h-ink-body);
    --color-text-secondary: var(--h-ink-muted);
    --color-text-muted: var(--h-ink-muted);

    /* Default brand ink. Pages and components override --ink-l/--ink-d for
       their own machine colour; the --ink switch below resolves the theme's. */
    --ink-l: var(--h-accent-ink);
    --ink-d: var(--h-accent-ink);
    --btn-fill: var(--h-accent-deep);
    --color-border: var(--h-line);
    --color-border-light: var(--h-line-soft);

    /* State colours. Not part of the house palette; each pair is the light and
       the dark value, resolved by the kit's color-scheme. */
    --color-success: light-dark(#22c55e, #4ade80);
    --color-success-muted: light-dark(rgba(34, 197, 94, 0.15), rgba(74, 222, 128, 0.15));
    --color-error: light-dark(#ef4444, #f87171);
    --color-error-muted: light-dark(rgba(239, 68, 68, 0.1), rgba(248, 113, 113, 0.1));
    --color-warning: light-dark(#f59e0b, #fbbf24);
    --color-warning-muted: light-dark(rgba(245, 158, 11, 0.1), rgba(251, 191, 36, 0.1));

    /* Diagrams in src/components/diagrams draw with these. They sit on the page
       rather than in a panel; a diagram that needs a ground of its own (a pixel
       grid, where "no pixel" has to look like something) overrides it. The
       inks are the kit's, so they follow the theme without a dark block. */
    --diagram-bg: transparent;
    --diagram-ink: var(--color-text);
    --diagram-ink-dim: var(--color-text-secondary);
    --diagram-ink-faint: #8a8578;
    --diagram-rule: var(--color-border);
    --diagram-rule-faint: var(--color-border-light);

    /* Highlighting selects a matching light or dark palette. Keep the code
       surface with that palette: paper in light mode, terminal ground in dark. */
    --color-code-bg: light-dark(var(--color-surface), var(--h-code-bg));
    --color-code-text: light-dark(var(--color-text), var(--h-code-ink));

    --color-note-bg: var(--color-surface);
    --color-note-border: var(--color-primary);
    --color-note-text: var(--color-text);

    --font-family-sans: var(--h-font-ui);
    --font-family-read: var(--h-font-read);
    --font-family-mono: var(--h-font-mono);

    /* The hero step, §6. The kit's scale stops at display; the record added
       hero for the homepage headline on 2026-09-30. */
    --text-hero: 5rem;
    --lh-hero: calc(84 / 80);
    --tr-hero: -0.03em;

    --space-1: var(--h-space-1); --space-2: var(--h-space-2); --space-3: var(--h-space-3);
    --space-4: var(--h-space-4); --space-5: calc(var(--h-space-4) + var(--h-space-1));
    --space-6: var(--h-space-6); --space-8: var(--h-space-8); --space-10: calc(var(--h-space-8) + var(--h-space-2));
    --space-12: var(--h-space-12); --space-14: calc(var(--h-space-12) + var(--h-space-2));
    --space-16: var(--h-space-16); --space-20: calc(var(--h-space-16) + var(--h-space-4)); --space-24: var(--h-space-24);

    --shadow-sm: var(--h-lift-1);
    --shadow-md: var(--h-lift-1);
    --shadow-lg: var(--h-lift-2);
    --shadow-chunky: var(--h-lift-1);
    --shadow-chunky-hi: var(--h-lift-2);
    --transition-base: var(--h-rise) var(--h-ease);

    /* The frame. Wide enough for a 16-inch laptop (1728pt) to feel full; prose
       keeps its own measure inside. The gutter is the concept's, 16px at its
       narrowest. */
    --container-max-width: 1600px;
    --gutter: clamp(1rem, 4vw, 3rem);
    /* The nav bar: one cell of padding round a five-cell control row, plus its
       1px rule. Sticky bars below it stack from here. */
    --nav-height: calc(var(--h-cell) * 7 + 1px);
    /* The kit's own bars (FamilyStrip) inset by the same amount. */
    --h-inset: var(--gutter);

    /* The ambient light on the ground (§4: capped at 0.13 dark, 0.12 light). */
    --glow-a: light-dark(rgb(224 116 74 / 0.12), rgb(224 116 74 / 0.13));
    --glow-b: light-dark(rgb(200 81 34 / 0.07), rgb(200 81 34 / 0.10));
    --nav-bg: light-dark(rgb(252 251 248 / 0.78), rgb(13 12 10 / 0.72));
  }

  /* ============================================
     Brand ink: theme-aware accessible text colour.
     An ancestor sets --ink-l (light theme) and --ink-d (dark), each derived by
     accessibleInk() so a colour moves only as far as it must. light-dark()
     picks the one for the theme the kit's color-scheme says is showing, so it
     can never disagree with the tokens. Falls back to --platform-color when no
     inks are set.
     ============================================ */
  :global(*) {
    --ink: light-dark(var(--ink-l, var(--platform-color)), var(--ink-d, var(--platform-color)));
    --chip-ink: light-dark(var(--chip-ink-l, var(--ink-l, var(--platform-color))), var(--chip-ink-d, var(--ink-d, var(--platform-color))));
  }
  :global(.brand-ink) {
    color: var(--ink);
  }

  /* ============================================
     Ground and page
     ============================================ */
  html {
    font-family: var(--font-family-sans);
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: var(--h-lh-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: var(--h-text-body);
    line-height: var(--h-lh-body);
    background-color: var(--color-bg);
    overflow-x: clip;
  }

  /* Ambient light, fixed behind everything. It sits under the content, never
     over it: nothing is laid on a capture (§7). */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60rem 40rem at 85% -10%, var(--glow-a), transparent 60%),
      radial-gradient(50rem 36rem at -10% 110%, var(--glow-b), transparent 60%);
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* ============================================
     Skip link: the accent fill, as a button would carry it.
     ============================================ */
  .skip-to-content {
    position: absolute;
    top: 0;
    left: var(--gutter);
    z-index: 200;
    padding: var(--h-cell) calc(var(--h-cell) * 2);
    background: var(--h-accent);
    color: var(--h-ink-on-accent);
    font-size: var(--h-text-small);
    font-weight: var(--h-weight-minor);
    text-decoration: none;
    transform: translateY(-120%);
  }

  .skip-to-content:focus {
    transform: none;
  }

  /* ============================================
     Nav: a square bar on the cell (§7). Only "you are here" is inverse.
     ============================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-bar {
    box-sizing: border-box;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: var(--h-cell);
    padding: var(--h-cell) max(var(--gutter), calc((100% - var(--container-max-width)) / 2 + var(--gutter)));
    background: var(--nav-bg);
    border-bottom: 1px solid var(--h-line);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
  }

  .site-bar :global(.h-plate) {
    flex: none;
    margin-right: calc(var(--h-cell) * 2);
  }

  .nav-links ul,
  .site-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links ul {
    display: flex;
    gap: 0;
  }

  .nav-links a {
    display: grid;
    place-items: center;
    height: calc(var(--h-cell) * 5);
    padding: 0 calc(var(--h-cell) * 2);
    color: var(--h-ink-body);
    font-size: var(--h-text-micro);
    font-weight: var(--h-weight-minor);
    letter-spacing: 0.12em;
    line-height: 1;
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background: var(--h-wash-2);
    color: var(--h-ink);
    text-decoration: none;
  }

  /* Inverse video means current (§7), and switches instantly. */
  .nav-links a[aria-current],
  .site-menu a[aria-current] {
    background: var(--h-ink);
    color: var(--h-page);
  }

  .site-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--h-cell);
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: calc(var(--h-cell) * 5);
    height: calc(var(--h-cell) * 5);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--h-wash);
    color: var(--h-ink);
    cursor: pointer;
    touch-action: manipulation;
  }

  .nav-toggle:hover { background: var(--h-wash-2); }

  .nav-toggle span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--h-cell) * 2);
    height: 2px;
    margin-left: calc(var(--h-cell) * -1);
    background: currentColor;
  }

  .nav-toggle span:nth-child(1) { transform: translateY(-4px); }
  .nav-toggle span:nth-child(2) { transform: translateY(2px); }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(-1px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { transform: translateY(-1px) rotate(-45deg); }

  /* The menu: the whole window under the bar, opened and closed instantly. */
  .site-menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-links,
    .bar-theme {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    .site-menu.open {
      position: fixed;
      inset: var(--nav-height) 0 0 0;
      display: flex;
      flex-direction: column;
      gap: calc(var(--h-cell) * 4);
      padding: calc(var(--h-cell) * 4) var(--gutter);
      overflow-y: auto;
      background: var(--h-page);
    }

    .site-menu a {
      display: block;
      padding: var(--h-cell) calc(var(--h-cell) * 2);
      color: var(--h-ink);
      font-size: var(--h-text-h3);
      line-height: var(--h-lh-h3);
      font-weight: var(--h-weight-major);
      letter-spacing: var(--h-tr-h3);
      text-decoration: none;
    }

    .site-menu a:hover,
    .site-menu a:focus-visible {
      background: var(--h-wash-2);
    }
  }

  /* ============================================
     Footer
     ============================================ */
  .footer {
    margin-top: calc(var(--h-cell) * 8);
    padding: calc(var(--h-cell) * 10) 0 calc(var(--h-cell) * 6);
    border-top: 1px solid var(--h-line);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .footer-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: calc(var(--h-cell) * 4);
  }

  .footer-tagline {
    max-width: 30ch;
    margin: calc(var(--h-cell) * 2.5) 0 0;
    color: var(--h-ink-body);
  }

  .footer-links h2 {
    margin: 0 0 calc(var(--h-cell) * 2.5);
    color: var(--h-ink-muted);
    font-size: var(--h-text-micro);
    line-height: 1;
    font-weight: var(--h-weight-minor);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer-links ul {
    display: grid;
    gap: var(--h-cell);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--h-ink-body);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--h-ink);
    text-decoration: underline;
  }

  .footer-legal {
    display: grid;
    gap: var(--h-cell);
    margin-top: calc(var(--h-cell) * 8);
    padding-top: calc(var(--h-cell) * 4);
    border-top: 1px solid var(--h-line);
    color: var(--h-ink-muted);
    font-size: var(--h-text-micro);
    line-height: var(--h-lh-micro);
  }

  .footer-legal p {
    margin: 0;
  }

  /* Links in a line of text are underlined, so they are not told apart by
     colour alone (WCAG 1.4.1). */
  .footer-legal a {
    color: var(--h-ink-body);
    text-decoration: underline;
  }

  .footer-legal a:hover {
    color: var(--h-ink);
  }

  /* The kit's strip is a bar of its own; here it is the first line of the
     legal block, so it takes the block's type and drops its own rule. */
  .footer-family :global(.h-family) {
    padding: 0;
    border-top: 0;
    font-size: inherit;
    color: inherit;
  }

  .footer-legal .footer-family :global(.h-family a) {
    color: var(--h-ink-body);
    text-decoration: underline;
  }

  .footer-legal .footer-family :global(.h-family a:hover) {
    color: var(--h-ink);
  }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* ============================================
     Print
     ============================================ */
  @media print {
    .site-header,
    .footer,
    .skip-to-content {
      display: none !important;
    }

    body {
      background: white !important;
      color: black !important;
    }

    body::before {
      display: none;
    }

    main {
      padding: 0 !important;
    }

    a {
      color: black !important;
      text-decoration: underline !important;
    }

    a[href^="http"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #666;
    }

    pre, code {
      background: #f5f5f5 !important;
      border: 1px solid #ccc !important;
    }

    img {
      max-width: 100% !important;
    }
  }
</style>

<script>
  // The menu under 861px. Resolve the shell on each event: a soft navigation
  // replaces these elements without re-running this bundled script.
  function setMenuOpen(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const menu = document.querySelector<HTMLElement>('.site-menu');
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('open', open);
    // While the menu covers the page, the page behind it is out of reach.
    for (const el of document.querySelectorAll<HTMLElement>('body > :not(.site-header):not(script)')) {
      el.inert = open;
    }
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const toggle = event.target.closest('.nav-toggle');
    if (toggle) {
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    } else if (event.target.closest('.site-menu a')) {
      setMenuOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  // A page that grows past the breakpoint with the menu open closes it.
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
    if (e.matches) setMenuOpen(false);
  });

  // Each new page starts with the menu closed and nothing inert.
  document.addEventListener('astro:after-swap', () => setMenuOpen(false));
</script>
