---
// Mobile-first CSS foundation
import "../styles/main.css";
import Navigation from "../components/Navigation.astro";
import PrismLoader from "../components/PrismLoader.astro";
import GlobalSearchModal from "../components/GlobalSearchModal.astro";

export interface Props {
  title: string;
  description?: string;
  showBreadcrumb?: boolean;
  showSidebar?: boolean;
  isHomepage?: boolean;
  structuredData?: object;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title,
  description = "Learn vintage computer programming with Code Like It's 198x - master classic systems like Commodore 64, ZX Spectrum, Amiga, and NES through hands-on lessons and projects.",
  showBreadcrumb = false,
  showSidebar = false,
  isHomepage = false,
  structuredData,
  canonicalURL,
  ogImage = "/logo-stacked.svg"
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteURL = 'https://code198x.stevehill.xyz';
const fullCanonicalURL = canonicalURL || `${siteURL}${currentPath}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={fullCanonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Code Like It's 198x</title>

    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Code Like It's 198x" />
    <meta name="keywords" content="retro programming, vintage computers, assembly language, Commodore 64, ZX Spectrum, Amiga, NES, 8-bit programming, 16-bit programming, computer history" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonicalURL} />
    <meta property="og:title" content={`${title} | Code Like It's 198x`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Code Like It's 198x" />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Code Like It's 198x - Learn vintage computer programming" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullCanonicalURL} />
    <meta property="twitter:title" content={`${title} | Code Like It's 198x`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />
    <meta property="twitter:image:alt" content="Code Like It's 198x - Learn vintage computer programming" />

    <!-- Structured Data -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Oxanium:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- Styles -->

    <!-- Prism.js for syntax highlighting -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"
    ></script>
  </head>
  <body>
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    
    <!-- Modern Layout -->
    <div class="layout-modern">
      <!-- Navigation -->
      <Navigation currentPath={currentPath} />

      <!-- Global Search Modal -->
      <GlobalSearchModal />

      <!-- Main Layout Area -->
      <div class={`layout-container ${showSidebar ? 'layout-container--with-sidebar' : ''}`}>
        <!-- Optional Breadcrumb -->
        {showBreadcrumb && (
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <slot name="breadcrumb" />
          </nav>
        )}
        
        <!-- Content Grid -->
        <div class="content-grid">
          <!-- Main Content -->
          <main id="main-content" class={`content-main ${isHomepage ? 'no-padding' : ''}`}>
            <slot />
          </main>
          
          <!-- Optional Sidebar -->
          {showSidebar && (
            <aside class="content-sidebar">
              <div class="sidebar-sticky">
                <slot name="sidebar" />
              </div>
            </aside>
          )}
        </div>
      </div>
      
      <!-- Footer -->
      <footer class="layout-footer">
        <div class="footer-container">
          <div class="footer-grid">
            <!-- About Section -->
            <div class="footer-section">
              <a href="/" class="footer-logo" aria-label="Code Like It's 198x - Home">
                <img src="/logo-horizontal.svg" alt="Code Like It's 198x" />
              </a>
              <p class="footer-text">
                Learn assembly programming on classic systems through hands-on lessons
                and authentic development tools.
              </p>
              <div class="footer-social">
                <a href="https://github.com/code198x" aria-label="GitHub" class="social-link">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
                <a href="https://discord.gg/AdmEYQKWZb" aria-label="Discord" class="social-link">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
                  </svg>
                </a>
              </div>
            </div>
            
            <!-- Quick Links -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Learn</h4>
              <ul class="footer-links">
                <li><a href="/getting-started">Get Started</a></li>
                <li><a href="/lessons">All Lessons</a></li>
                <li><a href="/lessons#systems">By System</a></li>
                <li><a href="/getting-started#setup">Setup Guides</a></li>
              </ul>
            </div>
            
            <!-- Resources -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Resources</h4>
              <ul class="footer-links">
                <li><a href="/vault/hardware">All Systems</a></li>
                <li><a href="/vault">The Vault</a></li>
                <li><a href="/tools">Tools</a></li>
                <li><a href="/community">Community</a></li>
              </ul>
            </div>
            
            <!-- Systems -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Popular Systems</h4>
              <ul class="footer-links">
                <li><a href="/vault/hardware/commodore-64">Commodore 64</a></li>
                <li><a href="/vault/hardware/zx-spectrum">ZX Spectrum</a></li>
                <li><a href="/vault/hardware/nintendo-entertainment-system">NES</a></li>
                <li><a href="/vault/hardware/commodore-amiga">Amiga</a></li>
              </ul>
            </div>
          </div>
          
          <!-- Footer Bottom -->
          <div class="footer-bottom">
            <p class="footer-copyright">
              © 2025 Code Like It's 198x. Made with ❤️ for retro computing.
            </p>
            <nav class="footer-legal">
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="/sitemap.xml">Sitemap</a>
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <!-- Load custom Prism language definitions -->
    <PrismLoader />

  </body>
</html>
