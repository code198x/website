---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Learn vintage computer programming with Code198x - master classic systems like Commodore 64, ZX Spectrum, Amiga, and NES through hands-on lessons and projects." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Code198x</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Code198x" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <header class="bg-white shadow-sm border-b sticky top-0 z-50">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-8">
            <a href="/" class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold text-sm">198x</span>
              </div>
              <span class="text-xl font-bold text-gray-900">Code198x</span>
            </a>
            
            <nav class="hidden md:flex items-center space-x-6">
              <a href="/systems" class="text-gray-600 hover:text-gray-900 transition-colors">Systems</a>
              <a href="/lessons" class="text-gray-600 hover:text-gray-900 transition-colors">Lessons</a>
              <a href="/vault" class="text-gray-600 hover:text-gray-900 transition-colors">Vault</a>
              <a href="/timeline" class="text-gray-600 hover:text-gray-900 transition-colors">Timeline</a>
            </nav>
          </div>
          
          <div class="flex items-center space-x-4">
            <button class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="bg-white border-t mt-16">
      <div class="container mx-auto px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8">
          <div>
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold text-sm">198x</span>
              </div>
              <span class="text-xl font-bold text-gray-900">Code198x</span>
            </div>
            <p class="text-gray-600 text-sm">
              Learn vintage computer programming through hands-on lessons and interactive emulators.
            </p>
          </div>
          
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Systems</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li><a href="/systems/commodore-64" class="hover:text-gray-900">Commodore 64</a></li>
              <li><a href="/systems/zx-spectrum" class="hover:text-gray-900">ZX Spectrum</a></li>
              <li><a href="/systems/commodore-amiga" class="hover:text-gray-900">Commodore Amiga</a></li>
              <li><a href="/systems/nintendo-entertainment-system" class="hover:text-gray-900">Nintendo Entertainment System</a></li>
            </ul>
          </div>
          
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Learn</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li><a href="/lessons" class="hover:text-gray-900">All Lessons</a></li>
              <li><a href="/vault/people" class="hover:text-gray-900">People</a></li>
              <li><a href="/vault/companies" class="hover:text-gray-900">Companies</a></li>
              <li><a href="/vault/software" class="hover:text-gray-900">Software</a></li>
            </ul>
          </div>
          
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">About</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li><a href="/about" class="hover:text-gray-900">About Code198x</a></li>
              <li><a href="/timeline" class="hover:text-gray-900">Timeline</a></li>
              <li><a href="https://github.com/your-repo" class="hover:text-gray-900">GitHub</a></li>
            </ul>
          </div>
        </div>
        
        <div class="border-t pt-8 mt-8 text-center text-sm text-gray-600">
          <p>&copy; 2024 Code198x. Educational content for vintage computing enthusiasts.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

