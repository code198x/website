---
import "../styles/design-system.css";
import "../styles/modern-layout.css";
import "../styles/global.css";
import "../styles/prism-retro.css";
import "../styles/lessons.css";
import Navigation from "../components/Navigation.astro";
import PrismLoader from "../components/PrismLoader.astro";

export interface Props {
  title: string;
  description?: string;
  showBreadcrumb?: boolean;
  showSidebar?: boolean;
  isHomepage?: boolean;
}

const {
  title,
  description = "Learn vintage computer programming with Code Like It's 198x - master classic systems like Commodore 64, ZX Spectrum, Amiga, and NES through hands-on lessons and projects.",
  showBreadcrumb = false,
  showSidebar = false,
  isHomepage = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Code Like It's 198x</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Code Like It's 198x" />
    <meta property="og:image" content="/logo-stacked.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/logo-stacked.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Oxanium:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- Styles -->

    <!-- Prism.js for syntax highlighting -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"
    ></script>
  </head>
  <body>
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    
    <!-- Modern Layout -->
    <div class="layout-modern">
      <!-- Navigation -->
      <Navigation currentPath={currentPath} />

      <!-- Main Layout Area -->
      <div class={`layout-container ${showSidebar ? 'layout-container--with-sidebar' : ''}`}>
        <!-- Optional Breadcrumb -->
        {showBreadcrumb && (
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <slot name="breadcrumb" />
          </nav>
        )}
        
        <!-- Content Grid -->
        <div class="content-grid">
          <!-- Main Content -->
          <main id="main-content" class={`content-main ${isHomepage ? 'no-padding' : ''}`}>
            <slot />
          </main>
          
          <!-- Optional Sidebar -->
          {showSidebar && (
            <aside class="content-sidebar">
              <div class="sidebar-sticky">
                <slot name="sidebar" />
              </div>
            </aside>
          )}
        </div>
      </div>
      
      <!-- Footer -->
      <footer class="layout-footer">
        <div class="footer-container">
          <div class="footer-grid">
            <!-- About Section -->
            <div class="footer-section">
              <h3 class="footer-title">Code Like It's 198x</h3>
              <p class="footer-text">
                Learn assembly programming on classic systems through hands-on lessons
                and authentic development tools.
              </p>
              <div class="footer-social">
                <a href="https://github.com/code198x" aria-label="GitHub" class="social-link">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
              </div>
            </div>
            
            <!-- Quick Links -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Learn</h4>
              <ul class="footer-links">
                <li><a href="/getting-started">Get Started</a></li>
                <li><a href="/lessons">All Lessons</a></li>
                <li><a href="/lessons#systems">By System</a></li>
                <li><a href="/getting-started#setup">Setup Guides</a></li>
              </ul>
            </div>
            
            <!-- Resources -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Resources</h4>
              <ul class="footer-links">
                <li><a href="/systems">All Systems</a></li>
                <li><a href="/reference">Reference</a></li>
                <li><a href="/tools">Tools</a></li>
                <li><a href="/community">Community</a></li>
              </ul>
            </div>
            
            <!-- Systems -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Popular Systems</h4>
              <ul class="footer-links">
                <li><a href="/systems/commodore-64">Commodore 64</a></li>
                <li><a href="/systems/zx-spectrum">ZX Spectrum</a></li>
                <li><a href="/systems/nintendo-entertainment-system">NES</a></li>
                <li><a href="/systems/commodore-amiga">Amiga</a></li>
              </ul>
            </div>
          </div>
          
          <!-- Footer Bottom -->
          <div class="footer-bottom">
            <p class="footer-copyright">
              © 2025 Code Like It's 198x. Made with ❤️ for retro computing.
            </p>
            <nav class="footer-legal">
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="/sitemap.xml">Sitemap</a>
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <!-- Load custom Prism language definitions -->
    <PrismLoader />

  </body>
</html>
