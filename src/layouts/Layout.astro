---
import { ViewTransitions } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Search from '../components/Search.astro';
import { getActivePlatforms } from '../lib/platforms';

// Self-hosted fonts via fontsource
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

// Get platforms for nav and footer
const platforms = await getActivePlatforms();

interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description?: string;
  image?: string;
  showNav?: boolean;
  platformColor?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "Learn assembly by building games on classic 8-bit and 16-bit systems",
  image = "/og-image.png",
  showNav = true,
  platformColor,
  breadcrumbs
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = "https://code198x.stevehill.xyz";
const fullTitle = `${title} | Code Like It's 198x`;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Code Like It's 198x" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme initialization (inline to prevent flash) -->
    <script is:inline>
      (function() {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        }
        // Apply on initial load
        applyTheme();
        // Re-apply after View Transitions page swap
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- View transitions for smooth page navigation -->
    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    {showNav && (
      <nav class="nav">
        <div class="nav-container">
          <a href="/" class="nav-logo">
            <img src="/logo-horizontal.svg" alt="Code Like It's 198x" height="32" class="logo-full" />
            <img src="/logo-198x.svg" alt="Code Like It's 198x" height="36" class="logo-compact" />
          </a>

          <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
            <span class="hamburger"></span>
          </button>

          <div class="nav-links">
            <a href="/about" class={currentPath === '/about' ? 'active' : ''}>ABOUT</a>
            <a href="/systems" class={currentPath === '/systems' || platforms.some(p => currentPath.includes(p.id)) ? 'active' : ''}>SYSTEMS</a>
            <a href="/vault" class={currentPath.includes('/vault') ? 'active' : ''}>VAULT</a>
            <a href="/timeline" class={currentPath === '/timeline' ? 'active' : ''}>TIMELINE</a>
            <a href="/patterns" class={currentPath.includes('/patterns') ? 'active' : ''}>PATTERNS</a>
            <a href="/setup" class={currentPath === '/setup' ? 'active' : ''}>SETUP</a>
          </div>
          <Search />
          <ThemeToggle />
        </div>
      </nav>
    )}

    <Breadcrumbs platformColor={platformColor} items={breadcrumbs} />

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <img src="/logo-horizontal.svg" alt="Code Like It's 198x" height="28" />
            </a>
            <p class="footer-tagline">Learn assembly by building games on classic 8-bit and 16-bit systems.</p>
          </div>

          <div class="footer-links">
            <h4>Platforms</h4>
            <ul>
              {platforms.map(p => (
                <li><a href={`/${p.id}`}>{p.data.shortName}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-links">
            <h4>Resources</h4>
            <ul>
              <li><a href="/vault">The Vault</a></li>
              <li><a href="/patterns">Pattern Library</a></li>
              <li><a href="/timeline">Timeline</a></li>
              <li><a href="/setup">Setup Guide</a></li>
            </ul>
          </div>

          <div class="footer-links">
            <h4>Community</h4>
            <ul>
              <li><a href="https://discord.gg/AdmEYQKWZb" target="_blank" rel="noopener">Discord</a></li>
              <li><a href="https://github.com/orgs/code198x/discussions" target="_blank" rel="noopener">GitHub Discussions</a></li>
              <li><a href="https://www.patreon.com/c/code_like_its_198x" target="_blank" rel="noopener">Patreon</a></li>
              <li><a href="/rss.xml" class="rss-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <circle cx="6.18" cy="17.82" r="2.18"/>
                  <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/>
                </svg>
                RSS Feed
              </a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© 2025 Code Like It's 198x</p>
          <p class="footer-credits">Open source • Made with care for retro computing</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ============================================
     Design Tokens - Simplified from archive
     ============================================ */
  :root {
    /* Core Colors */
    --color-primary: #3b82f6;
    --color-primary-dark: #2563eb;
    --color-accent: #8b5cf6;
    --color-accent-dark: #7c3aed;

    /* Retro System Colors - These intentionally stay constant in dark mode */
    --c64-blue: #4a4dff;
    --c64-beige: #b8b5a3;
    --spectrum-red: #cc0000;
    --spectrum-rainbow: linear-gradient(90deg, #00FF00, #FFFF00, #00FFFF, #FF0000, #FF00FF);
    --nes-red: #e30613;
    --amiga-orange: #ff6600;

    /* Legacy aliases */
    --zx-magenta: #ff00ff;
    --zx-cyan: #00ffff;

    /* Background Colors */
    --color-bg: #f4f1e8; /* Classic C64 beige */
    --color-bg-secondary: #ebe8df;
    --color-surface: #fdfcf7;

    /* Text Colors */
    --color-text: #1e293b;
    --color-text-secondary: #64748b;
    --color-text-muted: #94a3b8;

    /* Border Colors */
    --color-border: #d6d3ca;
    --color-border-light: #e8e5dc;

    /* Semantic Colors */
    --color-success: #22c55e;
    --color-success-muted: rgba(34, 197, 94, 0.15);
    --color-error: #ef4444;
    --color-error-muted: rgba(239, 68, 68, 0.1);
    --color-warning: #f59e0b;
    --color-warning-muted: rgba(245, 158, 11, 0.1);

    /* Code Block Colors */
    --color-code-bg: #1e1e1e;
    --color-code-text: #d4d4d4;

    /* Note/Callout Colors */
    --color-note-bg: var(--color-surface);
    --color-note-border: var(--color-primary);
    --color-note-text: var(--color-text);

    /* Translucent Surfaces */
    --color-surface-translucent: rgba(253, 252, 247, 0.95);

    /* Difficulty Level Colors */
    --color-beginner: #10b981;
    --color-beginner-muted: rgba(16, 185, 129, 0.1);
    --color-intermediate: #3b82f6;
    --color-intermediate-muted: rgba(59, 130, 246, 0.1);
    --color-advanced: #a855f7;
    --color-advanced-muted: rgba(168, 85, 247, 0.1);

    /* Typography - using self-hosted variable fonts */
    --font-family-sans: 'Inter Variable', 'Inter', system-ui, -apple-system, sans-serif;
    --font-family-mono: 'JetBrains Mono Variable', 'JetBrains Mono', 'Courier New', monospace;

    /* Spacing */
    --space-1: 0.25rem;   /* 4px */
    --space-2: 0.5rem;    /* 8px */
    --space-3: 0.75rem;   /* 12px */
    --space-4: 1rem;      /* 16px */
    --space-5: 1.25rem;   /* 20px */
    --space-6: 1.5rem;    /* 24px */
    --space-8: 2rem;      /* 32px */
    --space-10: 2.5rem;   /* 40px */
    --space-12: 3rem;     /* 48px */
    --space-14: 3.5rem;   /* 56px */
    --space-16: 4rem;     /* 64px */
    --space-20: 5rem;     /* 80px */
    --space-24: 6rem;     /* 96px */

    /* Shadows */
    --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);

    /* Transitions */
    --transition-base: 150ms cubic-bezier(0.4, 0, 0.2, 1);

    /* Layout */
    --container-max-width: 1280px;
    --nav-height: 4rem;
  }

  /* Dark Mode - via manual selection */
  :root[data-theme="dark"] {
    --color-primary: #60a5fa;
    --color-primary-dark: #3b82f6;
    --color-accent: #a78bfa;
    --color-accent-dark: #8b5cf6;

    --color-bg: #0f172a;
    --color-bg-secondary: #151d30;
    --color-surface: #1e293b;

    --color-text: #f1f5f9;
    --color-text-secondary: #cbd5e1;
    --color-text-muted: #64748b;

    --color-border: #334155;
    --color-border-light: #475569;

    /* Semantic Colors - slightly brighter in dark mode */
    --color-success: #4ade80;
    --color-success-muted: rgba(74, 222, 128, 0.15);
    --color-error: #f87171;
    --color-error-muted: rgba(248, 113, 113, 0.1);
    --color-warning: #fbbf24;
    --color-warning-muted: rgba(251, 191, 36, 0.1);

    /* Code blocks stay dark in both modes */
    --color-code-bg: #1e1e1e;
    --color-code-text: #d4d4d4;

    /* Translucent Surfaces */
    --color-surface-translucent: rgba(30, 41, 59, 0.95);

    --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.2);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.2);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.2);
  }

  /* Dark Mode - via system preference (only when no manual selection) */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --color-primary: #60a5fa;
      --color-primary-dark: #3b82f6;
      --color-accent: #a78bfa;
      --color-accent-dark: #8b5cf6;

      --color-bg: #0f172a;
      --color-bg-secondary: #151d30;
      --color-surface: #1e293b;

      --color-text: #f1f5f9;
      --color-text-secondary: #cbd5e1;
      --color-text-muted: #64748b;

      --color-border: #334155;
      --color-border-light: #475569;

      /* Semantic Colors - slightly brighter in dark mode */
      --color-success: #4ade80;
      --color-success-muted: rgba(74, 222, 128, 0.15);
      --color-error: #f87171;
      --color-error-muted: rgba(248, 113, 113, 0.1);
      --color-warning: #fbbf24;
      --color-warning-muted: rgba(251, 191, 36, 0.1);

      /* Code blocks stay dark in both modes */
      --color-code-bg: #1e1e1e;
      --color-code-text: #d4d4d4;

      /* Translucent Surfaces */
      --color-surface-translucent: rgba(30, 41, 59, 0.95);

      --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.2);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.2);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.2);
    }
  }

  /* ============================================
     Global Styles
     ============================================ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-family-sans);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    font-size: 16px;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* Typography */
  h1, h2, h3, h4, h5, h6 {
    font-weight: 700;
    line-height: 1.2;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  h1 { font-size: 2.5rem; }
  h2 { font-size: 2rem; }
  h3 { font-size: 1.5rem; }
  h4 { font-size: 1.25rem; }
  h5 { font-size: 1.125rem; }
  h6 { font-size: 1rem; }

  p {
    margin-bottom: var(--space-4);
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  a:hover {
    color: var(--color-primary-dark);
  }

  code {
    font-family: var(--font-family-mono);
    background: var(--color-surface);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-4);
    overflow-x: auto;
    margin: var(--space-4) 0;
  }

  pre code {
    background: none;
    padding: 0;
  }

  /* ============================================
     Table Styles - Retro-inspired, readable
     ============================================ */
  :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    font-size: 0.95rem;
  }

  :global(thead) {
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--color-primary) 15%, var(--color-surface) 85%),
      color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%)
    );
    border-bottom: 2px solid var(--color-border);
  }

  :global(th) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.9rem;
    letter-spacing: 0.025em;
  }

  :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  /* Zebra striping */
  :global(tbody tr:nth-child(even)) {
    background: color-mix(in oklab, var(--color-bg) 30%, var(--color-surface) 70%);
  }

  /* Hover effect */
  :global(tbody tr:hover) {
    background: color-mix(in oklab, var(--color-primary) 8%, var(--color-surface) 92%);
    transition: background var(--transition-base);
  }

  /* Last row no border */
  :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  /* Code/hex values in tables */
  :global(td code), :global(th code) {
    font-family: var(--font-family-mono);
    font-size: 0.875em;
    background: color-mix(in oklab, var(--color-bg) 50%, transparent 50%);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  /* Responsive tables */
  @media (max-width: 768px) {
    :global(table) {
      font-size: 0.875rem;
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    :global(th), :global(td) {
      padding: var(--space-2) var(--space-3);
    }

    /* Only nowrap for code/hex columns */
    :global(td code), :global(th code) {
      white-space: nowrap;
    }
  }

  /* ============================================
     Navigation
     ============================================ */
  .nav {
    background: var(--color-surface-translucent);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .nav-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--space-4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 32px;
    width: auto;
  }

  .logo-compact {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin-left: auto;
  }

  .nav-links a {
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
    position: relative;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.active {
    color: var(--color-primary);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
  }

  /* Hamburger Button - Hidden on Desktop */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    z-index: 101;
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    position: relative;
    transition: background var(--transition-base);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    left: 0;
    transition: transform var(--transition-base);
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  /* Hamburger animation when open */
  .nav-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .hamburger::before {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-toggle[aria-expanded="true"] .hamburger::after {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile/Tablet Navigation - hamburger menu for screens under 1024px */
  @media (max-width: 1024px) {
    .nav-container {
      gap: var(--space-2);
      padding: 0 var(--space-3);
    }

    .logo-full {
      display: none;
    }

    .logo-compact {
      display: block;
      height: 36px;
    }

    /* Push all items after logo to the right */
    .nav-container > :global(.search-trigger) {
      margin-left: auto;
      order: 1;
    }

    .nav-container > :global(.theme-toggle) {
      order: 2;
    }

    .nav-toggle {
      display: block;
      order: 3;
    }

    .nav-links {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: var(--space-4);
      gap: 0;
      transform: translateY(-10px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0.25s;
      box-shadow: var(--shadow-lg);
    }

    .nav-links.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links a {
      padding: var(--space-3) var(--space-4);
      border-radius: 0.5rem;
      font-size: 1rem;
      /* Staggered animation for links */
      opacity: 0;
      transform: translateX(-10px);
      transition: background var(--transition-base),
                  color var(--transition-base),
                  opacity 0.2s ease,
                  transform 0.2s ease;
    }

    /* Staggered delays for each link */
    .nav-links.open a:nth-child(1) { transition-delay: 0.05s; }
    .nav-links.open a:nth-child(2) { transition-delay: 0.08s; }
    .nav-links.open a:nth-child(3) { transition-delay: 0.11s; }
    .nav-links.open a:nth-child(4) { transition-delay: 0.14s; }
    .nav-links.open a:nth-child(5) { transition-delay: 0.17s; }
    .nav-links.open a:nth-child(6) { transition-delay: 0.20s; }
    .nav-links.open a:nth-child(7) { transition-delay: 0.23s; }
    .nav-links.open a:nth-child(8) { transition-delay: 0.26s; }
    .nav-links.open a:nth-child(9) { transition-delay: 0.29s; }

    .nav-links.open a {
      opacity: 1;
      transform: translateX(0);
    }

    .nav-links a:hover {
      background: var(--color-bg-secondary);
    }

    .nav-links a.active {
      background: color-mix(in oklab, var(--color-primary) 10%, var(--color-surface) 90%);
    }

    .nav-links a.active::after {
      display: none;
    }

    .nav-logo {
      font-size: 1rem;
    }
  }

  /* ============================================
     Footer
     ============================================ */
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) var(--space-4) var(--space-8);
  }

  .footer-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand {
