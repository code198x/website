---
// Mobile-first CSS foundation
import "../styles/main.css";
import Navigation from "../components/Navigation.astro";
import PrismLoader from "../components/PrismLoader.astro";
import PerformanceDashboard from "../components/PerformanceDashboard.astro";
import Icon from "../components/Icon.astro";

export interface Props {
  title: string;
  description?: string;
  showBreadcrumb?: boolean;
  showSidebar?: boolean;
  isHomepage?: boolean;
  structuredData?: object;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title,
  description = "Learn vintage computer programming with Code Like It's 198x - master classic systems like Commodore 64, ZX Spectrum, Amiga, and NES through hands-on lessons and projects.",
  showBreadcrumb = false,
  showSidebar = false,
  isHomepage = false,
  structuredData,
  canonicalURL,
  ogImage = "/logo-stacked.svg",
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteURL = "https://code198x.stevehill.xyz";
const fullCanonicalURL = canonicalURL || `${siteURL}${currentPath}`;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteURL}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={fullCanonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Code Like It's 198x</title>

    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Code Like It's 198x" />
    <meta
      name="keywords"
      content="retro programming, vintage computers, assembly language, Commodore 64, ZX Spectrum, Amiga, NES, 8-bit programming, 16-bit programming, computer history"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonicalURL} />
    <meta property="og:title" content={`${title} | Code Like It's 198x`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Code Like It's 198x" />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Code Like It's 198x - Learn vintage computer programming"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullCanonicalURL} />
    <meta property="twitter:title" content={`${title} | Code Like It's 198x`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />
    <meta
      property="twitter:image:alt"
      content="Code Like It's 198x - Learn vintage computer programming"
    />

    <!-- Structured Data -->
    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Oxanium:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- Styles -->

    <!-- Prism.js for syntax highlighting - no theme, we use our own styles -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"
    ></script>
  </head>
  <body>
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <!-- Modern Layout -->
    <div class="layout-modern">
      <!-- Navigation -->
      <Navigation currentPath={currentPath} />

      <!-- Performance Dashboard (Development Only) -->
      {!import.meta.env.PROD && <PerformanceDashboard />}

      <!-- Main Layout Area -->
      <div class={`layout-container ${showSidebar ? "layout-container--with-sidebar" : ""}`}>
        <!-- Optional Breadcrumb -->
        {
          showBreadcrumb && (
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <slot name="breadcrumb" />
            </nav>
          )
        }

        <!-- Content Grid -->
        <div class="content-grid">
          <!-- Main Content -->
          <main id="main-content" class={`content-main ${isHomepage ? "no-padding" : ""}`}>
            <slot />
          </main>

          <!-- Optional Sidebar -->
          {
            showSidebar && (
              <aside class="content-sidebar">
                <div class="sidebar-sticky">
                  <slot name="sidebar" />
                </div>
              </aside>
            )
          }
        </div>
      </div>

      <!-- Footer -->
      <footer class="layout-footer">
        <div class="footer-container">
          <div class="footer-grid">
            <!-- About Section -->
            <div class="footer-section">
              <a href="/" class="footer-logo" aria-label="Code Like It's 198x - Home">
                <img src="/logo-horizontal.svg" alt="Code Like It's 198x" />
              </a>
              <p class="footer-text">
                Learn assembly programming on classic systems through hands-on lessons and authentic
                development tools.
              </p>
              <div class="footer-social">
                <a href="https://github.com/code198x" aria-label="GitHub" class="social-link">
                  <Icon name="github" size={20} />
                </a>
                <a href="https://discord.gg/AdmEYQKWZb" aria-label="Discord" class="social-link">
                  <Icon name="discord" size={20} />
                </a>
              </div>
            </div>

            <!-- Quick Links -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Learn</h4>
              <ul class="footer-links">
                <li><a href="/getting-started">Get Started</a></li>
                <li><a href="/lessons">All Lessons</a></li>
                <li><a href="/lessons#systems">By System</a></li>
                <li><a href="/getting-started#setup">Setup Guides</a></li>
              </ul>
            </div>

            <!-- Resources -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Resources</h4>
              <ul class="footer-links">
                <li><a href="/lessons#systems">All Systems</a></li>
                <li><a href="/vault">The Vault</a></li>
                <li><a href="/tools">Tools</a></li>
                <li><a href="/changelog">Changelog</a></li>
                <li><a href="/community">Community</a></li>
              </ul>
            </div>

            <!-- Systems -->
            <div class="footer-section">
              <h4 class="footer-subtitle">Popular Systems</h4>
              <ul class="footer-links">
                <li><a href="/lessons/commodore-64">Commodore 64</a></li>
                <li><a href="/lessons/sinclair-zx-spectrum">ZX Spectrum</a></li>
                <li><a href="/lessons/nintendo-entertainment-system">NES</a></li>
                <li><a href="/lessons/commodore-amiga">Amiga</a></li>
              </ul>
            </div>
          </div>

          <!-- Footer Bottom -->
          <div class="footer-bottom">
            <p class="footer-copyright">
              © 2025 Code Like It's 198x. Made with ❤️ for retro computing.
            </p>
            <nav class="footer-legal">
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="/sitemap">Sitemap</a>
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <!-- Load custom Prism language definitions -->
    <PrismLoader />

    <!-- Performance Monitoring -->
    <script>
      import("../scripts/performance-monitor.ts");
    </script>
  </body>
</html>
