---
import Sidebar from '@198x-ui/components/layout/Sidebar.astro';
import Figure from '../components/Figure.astro';
import {getModules} from '../lib/modules';
import {getCollection} from 'astro:content';
import PageMasthead from '../components/PageMasthead.astro';
import Layout from './Layout.astro';
import { getPlatformBySlug, getSpotColour } from '../lib/platforms';
import { getUnitsEntry, unitSlug } from '../lib/units';

interface Props {
  title: string;
  heroImage?:string;
  heroAlt?:string;
  heroCaption?:string;
  estimatedTime?:string;
  description?: string;
  entryAdvice?: { message: string; label: string; href: string; };
  platformSlug: string;
  track: 'assembly' | 'basic' | 'amos' | 'blitz' | 'machine';
  moduleSlug: string;
}
const { title, description, platformSlug, track, moduleSlug, entryAdvice, heroImage, heroAlt, heroCaption, estimatedTime } = Astro.props;
const platform = await getPlatformBySlug(platformSlug);
const entry = await getUnitsEntry(platformSlug, track, moduleSlug);
const authored=(await getCollection('unit-pages')).filter(unit=>unit.id.startsWith(`${platformSlug}/${track}/${moduleSlug}/`)).sort((a,b)=>(a.data.unit??0)-(b.data.unit??0));
const units = entry?.data.units ?? authored.map((unit,index)=>({number:unit.data.unit??index+1,title:unit.data.title,slug:unit.id.split('/').at(-1)!,available:true}));
const phases = entry?.data.phases ?? [];
const base = `/systems/${platformSlug}/${track}/${moduleSlug}`;
const hrefFor = (unit: { number: number; slug?: string }) => `${base}/${unitSlug(unit)}`;
const firstUnit = units[0]?.available ? units[0] : undefined;
const groups = phases.length
  ? phases.map(phase => ({ name: phase.name, units: units.filter(unit => unit.number >= phase.start && unit.number <= phase.end) }))
  : [{ name: '', units }];
const trackName = { assembly: 'Assembly', basic: 'BASIC', amos: 'AMOS', blitz: 'Blitz BASIC', machine: 'Machine' }[track];
const module=(await getModules(platformSlug,track)).find(item=>item.slug===moduleSlug);
const image=heroImage || module?.thumbnail;
---
<Layout title={`${title} · ${platform?.data.shortName ?? platformSlug} ${trackName}`} description={description} platformColor={platform?.data.color} spotColor={getSpotColour(platform)}>
  <article class="module-overview">
    <header class="overview-opening"><div>
      <h1>{title}</h1>
      <p class="module-facts">{platform?.data.shortName ?? platformSlug} · {trackName}</p>
      {(module?.tagline || description) && <p class="lead">{module?.tagline || description}</p>}
      <p class="module-facts">{units.length} units{estimatedTime && ` · ${estimatedTime}`}</p>
      <div class="entry-links">
      {firstUnit && <a class="start-link" href={hrefFor(firstUnit)}>Start with {firstUnit.title} <span aria-hidden="true">→</span></a>}
      {units.length > 0 && <a class="start-link" href="#lessons-title">Browse lessons</a>}
      </div>
      {entryAdvice && <p class="entry-advice">{entryAdvice.message} <a href={entryAdvice.href}>{entryAdvice.label} →</a></p>}
    </div>{image&&<div class="overview-evidence"><Figure src={image} alt={heroAlt || `${title} course capture`} caption={heroCaption || `${title} · ${platform?.data.shortName ?? platformSlug}`} /></div>}</header>
    {/* The lessons list keeps 440px beside the prose until the prose would be under 42%, about 900px wide. */}
    <Sidebar side="right" sideWidth="440px" contentMin="42%" space={16} noStretch class="overview">
      <div class="prose"><slot /></div>
      {units.length > 0 && <nav class="lessons" aria-labelledby="lessons-title">
        <h2 id="lessons-title">Current lessons</h2>
        {groups.filter(group => group.units.length).map(group => <section>
          {group.name && <h3>{group.name}</h3>}
          <ol role="list">
            {group.units.map(unit => <li value={unit.number}>
              {unit.available
                ? <a href={hrefFor(unit)}><span class="number"><span class="visually-hidden">Unit </span>{unit.number}<span class="visually-hidden">: </span></span><span>{unit.title}</span></a>
                : <span class="unavailable"><span class="number" aria-hidden="true">{unit.number}</span><span>{unit.title} <small>Not yet available</small></span></span>}
            </li>)}
          </ol>
        </section>)}
      </nav>}
    </Sidebar>
    <footer><a href={`/systems/${platformSlug}/${track}`}>Explore the {trackName} track <span aria-hidden="true">→</span></a> <a href={`/systems/${platformSlug}/getting-started`}>Setup guide →</a></footer>
  </article>
</Layout>
<style>@layer blocks {
  /* A module's overview: an opening beside its capture, the module's prose
     beside its list of lessons, then the way back to the track. */
  .module-overview { padding-bottom: var(--h-space-16); }
  @media print { .module-overview { padding: 0; } }

  .overview-opening {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center;
    margin: 0 0 40px; padding: 0 0 32px; border-bottom: 1px solid var(--h-line);
  }
  .overview-opening:not(:has(.overview-evidence)) { display: block; }
  .overview-evidence { min-width: 0; }
  @media (max-width: 1000px) { .overview-opening { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  @media (max-width: 600px) { .overview-opening { margin-bottom: 28px; } }

  h1 { margin: 0 0 24px; font: 700 clamp(56px, 7vw, 90px)/1 var(--h-font-ui); letter-spacing: -0.04em; color: var(--h-ink); }
  .module-facts { margin: 1em 0; font: 1rem/1.5 var(--h-font-ui); color: var(--h-ink-muted); }
  .lead { max-width: var(--reading-width); margin: 1em 0; font: 22px/1.6 var(--h-font-ui); color: var(--h-ink-body); }
  .entry-advice { max-width: var(--reading-width); color: var(--h-ink-body); }
  .entry-advice a { display: inline-block; min-height: 44px; padding-block: var(--h-space-2); }
  .entry-links { display: flex; flex-wrap: wrap; gap: var(--h-space-3) var(--h-space-6); }
  .start-link {
    display: inline-flex; gap: var(--h-space-3); align-items: center; min-height: 44px;
    font: 600 18px/1.6 var(--h-font-ui); color: var(--h-spot-ink);
  }
  #lessons-title { scroll-margin-top: 7rem; }

  .prose :global(p) { max-width: 70ch; margin: var(--h-space-4) 0; font: 20px/1.65 var(--h-font-ui); color: var(--h-ink-body); }
  .prose :global(h2) { margin: 0 0 var(--h-space-4); font: 700 var(--heading-h3-size)/var(--h-lh-h3) var(--h-font-ui); letter-spacing: var(--h-tr-h3); color: var(--h-ink); }
  .prose :global(h2:not(:first-child)) { margin-top: var(--space-10); }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; padding: var(--h-space-4); font-size: 0.9rem; line-height: 1.5; background: var(--h-ground); }
  .prose :global(pre code) { font-size: inherit; }
  .prose :global(a) { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .prose :global(table) { table-layout: auto; width: 100%; max-width: 100%; }
  .prose :global(:is(th, td)), .prose :global(:is(th, td) code) { white-space: normal; overflow-wrap: anywhere; }
  .prose :global(figure) { max-width: 100%; width: fit-content; }
  .prose :global(figcaption) { width: 100%; max-width: 100%; font-style: italic; }

  .lessons {
    min-width: 0; margin-top: 48px; padding: 32px 0 0 28px;
    border-top: 1px solid var(--h-line); border-left: 1px solid var(--h-line);
  }
  @media (max-width: 820px) { .lessons { padding: 28px 0 0; border-left: 0; } }
  .lessons h2 { margin: 0 0 var(--h-space-4); font: italic 900 2.5rem/1.15 var(--h-font-mag); color: var(--h-ink); }
  .lessons section { display: grid; grid-template-columns: 1fr 1.3fr; gap: 32px; }
  .lessons section:has(> ol:only-child) { display: block; }
  @media (max-width: 850px) { .lessons section { grid-template-columns: minmax(0, 1fr); } }
  .lessons section + section { margin-top: var(--h-space-6); }
  h3 { font-family: var(--h-font-ui); font-size: 1rem; line-height: 1.4; color: var(--h-ink); margin: var(--space-5) 0 var(--h-space-2); }
  ol { padding: 0; margin: 0; list-style: none; }
  li { border-bottom: 1px solid var(--h-line); }
  .unavailable { display: flex; gap: var(--h-space-3); align-items: baseline; min-height: 44px; padding: var(--h-space-3) 0; font-family: var(--h-font-ui); font-size: var(--h-text-small); line-height: 1.5; }
  .unavailable, small { color: var(--h-ink-muted); } small { display: block; }
  footer { display: flex; flex-wrap: wrap; gap: 24px; margin-top: var(--h-space-12); font-family: var(--h-font-ui); }
  footer a { display: inline-flex; align-items: center; min-height: 44px; }
}
@layer blocks {
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  li a { display: flex; gap: var(--h-space-3); align-items: baseline; min-height: 44px; padding: var(--h-space-3) 0; font-family: var(--h-font-ui); font-size: var(--h-text-small); line-height: 1.5; }
  li a { text-decoration: none; }
  @media (hover: hover) { li a:hover { text-decoration: underline; text-underline-offset: .15em; } }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .number { flex: 0 0 2ch; font-family: var(--h-font-ui); font-weight: 600; color: var(--h-spot-ink); font-variant-numeric: tabular-nums; }
}
</style>
