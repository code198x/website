---
import Layout from './Layout.astro';
import { getPlatformBySlug } from '../lib/platforms';
import { getUnitsEntry, unitSlug } from '../lib/units';

interface Props {
  title: string;
  description?: string;
  platformSlug: string;
  track: 'assembly' | 'basic' | 'amos' | 'blitz' | 'machine';
  moduleSlug: string;
}
const { title, description, platformSlug, track, moduleSlug } = Astro.props;
const platform = await getPlatformBySlug(platformSlug);
const entry = await getUnitsEntry(platformSlug, track, moduleSlug);
const units = entry?.data.units ?? [];
const phases = entry?.data.phases ?? [];
const base = `/systems/${platformSlug}/${track}/${moduleSlug}`;
const hrefFor = (unit: { number: number; slug?: string }) => `${base}/${unitSlug(unit)}`;
const firstUnit = units[0]?.available ? units[0] : undefined;
const groups = phases.length
  ? phases.map(phase => ({ name: phase.name, units: units.filter(unit => unit.number >= phase.start && unit.number <= phase.end) }))
  : [{ name: '', units }];
const trackName = { assembly: 'Assembly', basic: 'BASIC', amos: 'AMOS', blitz: 'Blitz BASIC', machine: 'Machine' }[track];
---
<Layout title={`${title} · ${platform?.data.shortName ?? platformSlug} ${trackName}`} description={description} platformColor={platform?.data.color}>
  <article class="page">
    <header>
      <p class="eyebrow">{platform?.data.shortName ?? platformSlug} · {trackName}</p>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <div class="entry-links">
      {firstUnit && <a class="start-link" href={hrefFor(firstUnit)}>Start with {firstUnit.title} <span aria-hidden="true">→</span></a>}
      {units.length > 0 && <a class="start-link" href="#lessons-title">Browse lessons</a>}
      </div>
    </header>
    <div class="overview">
      <div class="prose"><slot /></div>
      {units.length > 0 && <nav class="lessons" aria-labelledby="lessons-title">
        <h2 id="lessons-title">Current lessons</h2>
        {groups.filter(group => group.units.length).map(group => <section>
          {group.name && <h3>{group.name}</h3>}
          <ol role="list">
            {group.units.map(unit => <li value={unit.number}>
              {unit.available
                ? <a href={hrefFor(unit)} aria-label={`Unit ${unit.number}: ${unit.title}`}><span class="number" aria-hidden="true">{unit.number}</span><span>{unit.title}</span></a>
                : <span class="unavailable"><span class="number" aria-hidden="true">{unit.number}</span><span>{unit.title} <small>Not yet available</small></span></span>}
            </li>)}
          </ol>
        </section>)}
      </nav>}
    </div>
    <footer><a href={`/systems/${platformSlug}/${track}`}>Explore the {trackName} track <span aria-hidden="true">→</span></a></footer>
  </article>
</Layout>
<style>
  .page { max-width: var(--container-max-width); margin: 0 auto; padding: var(--space-10) var(--gutter) var(--space-16); }
  header { margin-bottom: var(--space-10); }
  .eyebrow { font-family: var(--font-family-sans); font-size: var(--h-text-small); color: var(--h-ink-muted); }
  h1 { font-family: var(--font-family-read); font-size: clamp(2.1rem, 5vw, 3.6rem); line-height: 1.08; color: var(--h-ink); margin: var(--space-3) 0 var(--space-6); text-wrap: balance; }
  .lead { font-family: var(--font-family-read); font-size: 1.2rem; line-height: 1.7; max-width: 65ch; color: var(--h-ink-body); }
  a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .entry-links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  #lessons-title { scroll-margin-top: 7rem; }
  .start-link { display: inline-flex; gap: var(--space-3); align-items: center; min-height: 44px; font-family: var(--font-family-sans); font-weight: 600; }
  .overview { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  .prose { min-width: 0; }
  .prose :global(h2), .lessons h2 { font-family: var(--font-family-sans); color: var(--h-ink); font-size: 1.4rem; line-height: 1.3; margin: 0 0 var(--space-4); }
  .prose :global(h2:not(:first-child)) { margin-top: var(--space-10); }
  .prose :global(p) { font-family: var(--font-family-read); color: var(--h-ink-body); max-width: 70ch; line-height: 1.7; margin: var(--space-4) 0; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; padding: var(--space-4); font-size: 0.9rem; line-height: 1.5; background: var(--color-surface); }
  .prose :global(pre code) { font-size: inherit; }
  .prose :global(a) { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .lessons { min-width: 0; }
  .lessons section + section { margin-top: var(--space-6); }
  h3 { font-family: var(--font-family-sans); font-size: 1rem; line-height: 1.4; color: var(--h-ink); margin: var(--space-5) 0 var(--space-2); }
  ol { padding: 0; margin: 0; list-style: none; }
  li { border-bottom: 1px solid var(--color-border); }
  li a, .unavailable { display: flex; gap: var(--space-3); align-items: baseline; min-height: 44px; padding: var(--space-3) 0; font-family: var(--font-family-sans); font-size: var(--h-text-small); line-height: 1.5; }
  li a { text-decoration: none; }
  @media (hover: hover) { li a:hover { text-decoration: underline; text-underline-offset: .15em; } }
  .number { flex: 0 0 2ch; color: var(--h-ink-muted); font-variant-numeric: tabular-nums; }
  .unavailable, small { color: var(--h-ink-muted); } small { display: block; }
  footer { margin-top: var(--space-12); font-family: var(--font-family-sans); }
  footer a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 900px) { .overview { grid-template-columns: 1fr; gap: var(--space-10); } }
</style>
