---
/** Accepted reading layout: a quiet lesson body, optional lesson navigation,
 * intact captures and native modal players. Existing author props and progress
 * hooks remain compatible with published lessons. */
import {getCollection} from 'astro:content';
import RunIt from '../components/RunIt.astro';
import RunPanel from '../components/RunPanel.astro';
import Layout from './Layout.astro';
import PageFrame from '../components/PageFrame.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Cluster from '../components/layout/Cluster.astro';
import LessonContents from '../components/LessonContents.astro';
import UnitSteps from '../components/UnitSteps.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import Eyebrow from '@198x-ui/components/Eyebrow.astro';
import Chip from '@198x-ui/components/Chip.astro';
import Shell from '@198x-ui/components/Shell.astro';
import { getPlatformBySlug, getSpotColour } from '../lib/platforms';
import { getSection } from '../lib/sections';
import { whiteSafeFill } from '../lib/contrast';
import '../styles/lesson.css';

export interface Props {
  title: string;
  description?: string;
  system?: string;
  game?: number;
  gameName?: string;
  unit?: number;
  inlinePlayer?: boolean;
  runItPlaced?: boolean;
  totalUnits?: number;
  nextLesson?: string;
  prevLesson?: string;
  nextTitle?: string;
  prevTitle?: string;
  overviewHref?: string;
  overviewLabel?: string;
  unitPaths?: string[];
  breadcrumbs?: { label: string; href?: string }[];
  headings?: { depth: number; slug: string; text: string }[];
}

// Access frontmatter from MDX
const frontmatter = Astro.props.frontmatter || Astro.props;

const {
  title = 'Untitled Unit',
  description = '',
  gameName = '',
  unit = 1,
  totalUnits = 8,
  nextLesson,
  prevLesson,
  nextTitle,
  prevTitle,
  overviewHref: customOverviewHref,
  overviewLabel,
  breadcrumbs,
  unitPaths: catalogueUnitPaths,
  headings = [],
} = frontmatter;

// Extract paths from URL
const currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
// Systems live under /systems/; sections do not. Drop the prefix so every
// positional read below means the same thing for both. Without this the reads
// silently return "systems" as the machine rather than failing.
if (pathParts[0] === 'systems') pathParts.shift();
const platformSlug = pathParts[0] || '';
const languagePath = pathParts[1] || 'assembly'; // assembly, basic, amos
const moduleSlug = pathParts[2] || '';

// Cross-platform sections (Foundations) sit one level shallower — section/module/unit —
// and brand neutrally: no platform colour, no "Game N", overview points at the module.
const section = getSection(platformSlug);
const sectionModuleSlug = languagePath; // for a section, the module is at index 1
const platform = section ? undefined : await getPlatformBySlug(platformSlug);
const systemColor = section?.color ?? platform?.data.color ?? '#3b82f6';
const systemFill = whiteSafeFill(systemColor);
const platformName = section?.name ?? platform?.data.shortName ?? platformSlug;
const overviewHref = customOverviewHref ?? (section
  ? `/${platformSlug}/${sectionModuleSlug}`
  : `/systems/${platformSlug}/${languagePath}/${moduleSlug}`);

const formatModuleName = (slug: string) => {
  // "game-01-starfield" -> "Starfield"
  return slug
    .replace(/^game-\d+-/, '')
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

const displayGameName = gameName || formatModuleName(section ? sectionModuleSlug : moduleSlug);

// The chips under the premise: the machine and the language, as the concept
// has them. A section is about no one machine, so it names itself.
const TRACKS: Record<string, string> = { assembly: 'Assembly', basic: 'BASIC', amos: 'AMOS', blitz: 'Blitz BASIC', machine: 'Machine code' };
const chips = section
  ? [section.name]
  : [platform?.data.name ?? platformName, TRACKS[languagePath] ?? formatModuleName(languagePath)];
const overviewText = overviewLabel ?? (section ? 'Primer overview' : 'Game overview');
const authoredUnits = await getCollection('unit-pages');
const rosterPaths = catalogueUnitPaths ?? authoredUnits.filter(item=>item.id.startsWith(`${platformSlug}/${languagePath}/${moduleSlug}/`)).sort((a,b)=>a.id.localeCompare(b.id)).map(item=>`/systems/${item.id}/`);
const lessonRoster = rosterPaths.map((href: string) => {
 const id=href.replace(/^\/systems\//,'').replace(/^\//,'').replace(/\/$/,'');
 const entry=authoredUnits.find(item=>item.id===id);
 return {href,title:entry?.data.title};
}).filter((item:{title?:string})=>item.title);
---

<Layout
  title={`Unit ${unit}: ${title} - ${displayGameName} - ${platformName}`}
  description={description || `Unit ${unit} of ${displayGameName} (${platformName}): ${title}.`}
  platformColor={systemColor}
  spotColor={getSpotColour(platform)}
  breadcrumbs={breadcrumbs}
  currentLabel={`Unit ${unit} of ${totalUnits}: ${title}`}
>
  <Fragment slot="breadcrumb-end">
    <UnitSteps
      unit={unit}
      totalUnits={totalUnits}
      label={`Unit ${unit} of ${totalUnits} in ${displayGameName}`}
      unitPaths={catalogueUnitPaths ?? Array.from({ length: totalUnits }, (_, i) =>
        currentPath.replace(/unit-\d+/, `unit-${String(i + 1).padStart(2, '0')}`)
      )}
    />
  </Fragment>

  <PageFrame opening="none" class="unit-container">
    <header class="lesson-head unit-header">
      <h1 class="unit-title">{title}</h1>
      {description && <p class="unit-description">{description}</p>}
      <Cluster as="ul" space={2} class="lesson-chips" aria-label="About this lesson">
        {chips.map((c) => <li><Chip>{c}</Chip></li>)}
      </Cluster>
    </header>

    <Sidebar sideWidth="16rem" contentMin="62%" noStretch class="unit-layout" style="--sidebar-space: clamp(1.5rem, 4vw, 3rem)">
      <aside class="unit-sidebar">
        {lessonRoster.length>0 && <details class="lesson-roster"><summary>{displayGameName} · {lessonRoster.length} lessons</summary><ol>{lessonRoster.map((item:{href:string;title:string},index:number)=><li><a href={item.href} aria-current={item.href.replace(/\/$/,'')===currentPath.replace(/\/$/,'')?'page':undefined}><span>{index+1}</span>{item.title}</a></li>)}</ol></details>}

        <LessonContents headings={headings} />
      </aside>
      <article class="unit-content">
        <slot />
        {!section && !frontmatter.inlinePlayer && !frontmatter.runItPlaced && <RunIt />}
      </article>
    </Sidebar>
    {!section && !frontmatter.inlinePlayer && <RunPanel rule={systemFill} />}

    <div class="unit-complete"><ProgressTracker unitPath={currentPath} platformColor={systemColor} /></div>

    <nav class="unit-navigation" aria-label="Units">
      {prevLesson && (
        <Shell href={prevLesson} class="nav-button nav-prev">
          <span class="nav-dir">Previous unit</span>
          {prevTitle && <span class="nav-title">{prevTitle}</span>}
        </Shell>
      )}
      <Shell href={overviewHref} class="nav-button nav-index">
        <span class="nav-dir">{overviewText}</span>
        <span class="nav-title">{displayGameName}</span>
      </Shell>
      {nextLesson && (
        <Shell href={nextLesson} class="nav-button nav-next">
          <span class="nav-dir">Next unit</span>
          {nextTitle && <span class="nav-title">{nextTitle}</span>}
        </Shell>
      )}
    </nav>
  </PageFrame>

  <script>
    import { initPredictions } from '../lib/lesson-predict';
    import { initListings } from '../lib/lesson-listing';
    // Fences have no component of their own to load this; the layout does.
    initListings();
    initPredictions();
    document.addEventListener('astro:page-load', () => { initListings(); initPredictions(); });

    // Raw Markdown screenshots (`![…](/images/…png)`) are captures too. They
    // render at the largest whole multiple of their stored size that fits the
    // column, never a fraction, and fit the column only when it is narrower
    // than the file (§7). Figure does the same through the kit's Screen.
    function fitRawCaptures() {
      for (const img of document.querySelectorAll<HTMLImageElement>('.unit-content p > img')) {
        const fit = () => {
          if (!img.naturalWidth) return;
          const avail = window.innerWidth;
          const k = Math.floor(avail / img.naturalWidth);
          img.style.width = `${Math.min(img.naturalWidth, avail)}px`;
          img.style.maxWidth='none';
          img.style.position='relative';
          img.style.left='50%';
          img.style.transform='translateX(-50%)';
          img.dataset.scale = String(Math.min(1,avail/img.naturalWidth));
        };
        if (img.complete) fit(); else img.addEventListener('load', fit, { once: true });
      }
    }
    fitRawCaptures();
    document.addEventListener('astro:page-load', fitRawCaptures);
    let t: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(t); t = setTimeout(fitRawCaptures, 100); });
  </script>

  <style>@layer blocks {
    /* ---- Header ------------------------------------------------------- */
    .lesson-head { padding-bottom: 32px; margin-bottom: 40px; border-bottom: 1px solid var(--h-ink); }
    .lesson-head > * { max-width: 1060px; }
    .unit-title {
      margin: 0;
      color: var(--h-ink);
      font: 700 clamp(3rem, 1rem + 5.33vw, 4rem)/1.1 var(--h-font-ui);
      letter-spacing: -0.025em;
      overflow-wrap: break-word;
    }
    .unit-description {
      margin: 24px 0;
      color: var(--h-ink-body);
      font: 1.25rem/1.6 var(--h-font-ui);
    }
    .lesson-chips { margin: 32px 0 0; padding: 0; list-style: none; }

    /* ---- Rail and article: a Sidebar; the rail sits above on a phone ---- */
    .unit-sidebar:not(:has(nav)) { display: none; }

    /* ---- Prose -------------------------------------------------------- */
    .unit-content {
      --measure: 40rem;
      margin-bottom: var(--h-space-12);
      color: var(--h-ink-body);
      line-height: var(--h-lh-body);
    }

    /* Text keeps a reading measure; listings, captures, diffs and run panels
       break out to the full column. */
    .unit-content > :global(:is(p, ul, ol, h2, h3, h4, blockquote, dl, .question, .sources)) {
      max-width: var(--measure);
    }

    /* Reading is Literata (§4): the serif separates reading from interface. */
    .unit-content :global(p), .unit-content :global(li) {
      font-family: var(--h-font-read);
      font-size: var(--h-text-body);
      line-height: var(--h-lh-body);
    }
    .unit-content :global(p) { margin: 0 0 var(--h-space-6); }
    .unit-content > :global(p:first-child) {
      color: var(--h-ink-body);
      font-size: var(--h-text-lead);
      line-height: var(--h-lh-lead);
    }
    .unit-content :global(strong) { color: var(--h-ink); font-weight: 600; }
    .unit-content :global(ul), .unit-content :global(ol) { margin: 0 0 var(--h-space-6); padding-left: var(--h-space-6); }
    .unit-content :global(li) { margin-bottom: var(--h-space-2); }

    /* Links in prose: the ink, marked by an accent underline, as the concept
       has them. The underline carries the distinction (WCAG 1.4.1). */
    .unit-content :global(:is(p, li, dd, td, blockquote) a) {
      color: var(--h-ink);
      text-decoration: underline;
      text-decoration-color: var(--h-accent-ink);
      text-decoration-thickness: 1.5px;
      text-underline-offset: 0.2em;
      transition: color var(--h-decay) var(--h-ease);
    }
    .unit-content :global(:is(p, li, dd, td, blockquote) a:hover), .unit-content :global(:is(p, li, dd, td, blockquote) a:focus-visible) {
      color: var(--h-accent-ink);
      transition-duration: var(--h-rise);
    }

    .unit-content :global(h2) {
      margin: calc(var(--h-cell) * 10) 0 var(--h-space-6);
      color: var(--h-ink);
      font-family: var(--h-font-ui);
      font-size: clamp(var(--h-text-h3), 3vw, var(--h-text-h2));
      line-height: var(--h-lh-h2);
      font-weight: var(--h-weight-major);
      letter-spacing: -0.025em;
    }
    .unit-content :global(h3) {
      margin: calc(var(--h-cell) * 6) 0 var(--h-space-4);
      color: var(--h-ink);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-h4);
      line-height: var(--h-lh-h4);
      font-weight: var(--h-weight-minor);
      letter-spacing: var(--h-tr-h4);
    }
    .unit-content :global(h4) {
      margin: var(--h-space-6) 0 var(--h-space-3);
      color: var(--h-ink);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-body);
      font-weight: var(--h-weight-minor);
    }

    /* Inline code: the machine's face, on a square wash (§7: interface). */
    .unit-content :global(:not(pre) > code) {
      padding: 0.1em 0.35em;
      border-radius: 0;
      background: var(--h-wash-2);
      color: var(--h-ink);
      font-family: var(--h-font-mono);
      font-size: 0.88em;
      font-variant-ligatures: none;
      font-feature-settings: "liga" 0, "calt" 0;
    }

    /* A keycap, wherever prose writes one: the kit's Kbd (§7: a key is an
       object, so it keeps a rounded cap). */
    .unit-content :global(kbd) {
      display: inline-block;
      min-width: 1.7em;
      margin: 0 0.1em;
      padding: 0.1em 0.45em 0.15em;
      border: 1px solid var(--h-line);
      border-radius: 0.4em;
      background: var(--h-ground);
      color: var(--h-ink);
      box-shadow: 0 2px 0 var(--h-line), inset 0 1px 0 var(--h-highlight);
      font: 700 0.8em/1.3 var(--h-font-mono);
      text-align: center;
      vertical-align: 0.08em;
      white-space: nowrap;
    }

    /* A disclosure in prose (a full listing, a checkpoint, an answer): the
       concept's answer control. The caret turns instantly, as a machine
       would; it is feedback, not motion (§6). */
    .unit-content > :global(details) {
      margin: var(--h-space-6) 0;
    }
    .unit-content > :global(details > summary) {
      display: inline-flex;
      align-items: center;
      gap: var(--h-cell);
      min-height: calc(var(--h-cell) * 5);
      max-width: var(--measure);
      color: var(--h-ink);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-small);
      font-weight: var(--h-weight-minor);
      list-style: none;
      cursor: pointer;
    }
    .unit-content > :global(details > summary::-webkit-details-marker) { display: none; }
    .unit-content > :global(details > summary::before) {
      content: "";
      flex: none;
      width: 0.45em;
      height: 0.45em;
      margin-right: 0.15em;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(-45deg);
    }
    .unit-content > :global(details[open] > summary::before) { transform: rotate(45deg); }
    .unit-content > :global(details > summary:hover) { color: var(--h-accent-ink); }
    .unit-content > :global(details[open] > :not(summary):first-of-type) { margin-top: var(--h-space-4); }

    /* A pull quote. */
    .unit-content :global(blockquote) {
      margin: var(--h-space-8) 0;
      padding-left: var(--h-space-6);
      border-left: 2px solid var(--h-line);
      color: var(--h-ink);
      font-family: var(--h-font-read);
      font-style: italic;
    }
    .unit-content :global(blockquote p) { margin: 0; font-size: var(--h-text-h4); line-height: var(--h-lh-h4); }

    .unit-content :global(hr) { margin: var(--h-space-12) 0; border: 0; border-top: 1px solid var(--h-line); }

    /* Raw Markdown screenshots: the kit Screen's bezel (§7: a screen is an
       object, round and dark in both themes). Sized by the script above. */
    .unit-content :global(p > img) {
      display: block;
      max-width: calc(100% - 1.2rem);
      height: auto;
      margin: 0.6rem;
      border-radius: 0.3rem;
      background: var(--h-screen-glass);
      box-shadow: 0 0 0 0.6rem var(--h-screen-bezel), 0 0 0 calc(0.6rem + 1px) var(--h-screen-rim), 0 0 60px 0 var(--h-screen-glow);
      image-rendering: pixelated;
    }
    .unit-content :global(p:has(> img:only-child)) { margin-block: var(--h-space-8); }

    /* ---- Pager: square panels (interface), the kit's lift on hover ----- */
    .unit-navigation {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: calc(var(--h-cell) * 2);
      margin-top: calc(var(--h-cell) * 10);
    }
    /* Marking a unit done sits at the end of it, with the way on. */
    .unit-complete { margin-top: calc(var(--h-cell) * 10); }
    .unit-complete + .unit-navigation { margin-top: calc(var(--h-cell) * 2); }
    .nav-dir {
      color: var(--h-ink-muted);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-micro);
      line-height: 1;
      letter-spacing: normal;
      text-transform: none;
    font-weight: 600;
  }
    .nav-title {
      color: var(--h-ink);
      font-family: var(--h-font-ui);
      font-size: var(--h-text-body);
      line-height: var(--h-lh-small);
      font-weight: var(--h-weight-minor);
    }

    @media (max-width: 767px) {
      .unit-navigation { grid-template-columns: minmax(0, 1fr); }
    }
}
/* Overrides of 198x-ui components stay outside the layers: the kit's own
   component styles are unlayered, and unlayered CSS beats every layer. */
.unit-navigation :global(.nav-button) { height: 100%; }
.unit-navigation :global(.nav-button .h-shell-core) {
      display: grid;
      align-content: start;
      gap: var(--h-cell);
      height: 100%;
    }
.unit-navigation :global(.nav-prev) { grid-column: 1; }
.unit-navigation :global(.nav-index) { grid-column: 2; }
.unit-navigation :global(.nav-next) { grid-column: 3; text-align: right; }

    @media (max-width: 767px) {
.unit-navigation :global(:is(.nav-prev, .nav-index, .nav-next)) { grid-column: 1; text-align: left; }
    }

    @media (max-width: 767px) {
.unit-navigation :global(.nav-next) { order: -1; }
    }
  </style>
</Layout>
