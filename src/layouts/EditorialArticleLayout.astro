---
import Layout, { type Props as SiteProps } from './Layout.astro';
import EditorialArticle, { type Props as ArticleProps } from '../components/EditorialArticle.astro';
interface Props extends ArticleProps {
  pageTitle: string;
  description: string;
  breadcrumbs: SiteProps['breadcrumbs'];
  masthead?: SiteProps['masthead'];
}
const { pageTitle, description, breadcrumbs, masthead, ...article } = Astro.props;
---
<Layout title={pageTitle} description={description} breadcrumbs={breadcrumbs} masthead={masthead}>
  <EditorialArticle {...article}>
    <slot name="metadata" slot="metadata" />
    <slot name="hero" slot="hero" />
    <slot />
    <slot name="ending" slot="ending" />
  </EditorialArticle>
</Layout>
