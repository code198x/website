---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  category: string;
  difficulty: string;
  lessonsAppearIn: string;
  system?: string;
}

// Access frontmatter from MDX
const frontmatter = Astro.props.frontmatter || Astro.props;

const {
  title = 'Untitled Pattern',
  category = 'Uncategorized',
  difficulty = 'Intermediate',
  lessonsAppearIn = '',
  system = 'C64'
} = frontmatter;

const systemColors = {
  'C64': '#4a4dff',
  'Spectrum': '#ff00ff',
  'NES': '#ff0000',
  'Amiga': '#ff8800'
};

const systemColor = systemColors[system] || '#3b82f6';

// Map difficulty to colors
const difficultyColors = {
  'Beginner': { bg: 'rgba(16, 185, 129, 0.1)', text: '#10b981' },
  'Intermediate': { bg: 'rgba(59, 130, 246, 0.1)', text: '#3b82f6' },
  'Advanced': { bg: 'rgba(168, 85, 247, 0.1)', text: '#a855f7' }
};

const difficultyColor = difficultyColors[difficulty] || difficultyColors['Intermediate'];

// Extract category path from URL for breadcrumb
const currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
const categorySlug = pathParts[pathParts.length - 2] || category.toLowerCase();
---

<Layout title={`${title} - C64 BASIC Pattern Library`}>
  <style define:vars={{ systemColor, difficultyBg: difficultyColor.bg, difficultyText: difficultyColor.text }}>
    .pattern-container {
      max-width: 900px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .pattern-header {
      margin-bottom: var(--space-8);
    }

    .pattern-breadcrumb {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .pattern-breadcrumb a {
      color: var(--systemColor);
      text-decoration: none;
      transition: opacity var(--transition-base);
    }

    .pattern-breadcrumb a:hover {
      opacity: 0.7;
      text-decoration: underline;
    }

    .separator {
      color: var(--color-text-tertiary);
    }

    .current {
      color: var(--color-text);
    }

    .pattern-meta {
      display: flex;
      gap: var(--space-4);
      flex-wrap: wrap;
      margin-bottom: var(--space-4);
    }

    .meta-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .category-badge {
      background: rgba(74, 77, 255, 0.1);
      color: var(--systemColor);
    }

    .difficulty-badge {
      background: var(--difficultyBg);
      color: var(--difficultyText);
    }

    .pattern-title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      color: var(--color-text);
      margin-bottom: var(--space-4);
      line-height: 1.2;
    }

    .lessons-reference {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      padding: var(--space-3) var(--space-4);
      background: var(--color-surface);
      border-left: 3px solid var(--systemColor);
      border-radius: 0.25rem;
      margin-bottom: var(--space-6);
    }

    .lessons-reference strong {
      color: var(--color-text);
    }

    .pattern-content {
      color: var(--color-text);
      line-height: 1.8;
    }

    .pattern-content :global(h2) {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text);
      margin-top: var(--space-12);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid var(--color-border);
    }

    .pattern-content :global(h3) {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-text);
      margin-top: var(--space-8);
      margin-bottom: var(--space-3);
    }

    .pattern-content :global(p) {
      margin-bottom: var(--space-4);
      color: var(--color-text-secondary);
    }

    .pattern-content :global(ul),
    .pattern-content :global(ol) {
      margin-bottom: var(--space-6);
      padding-left: var(--space-6);
    }

    .pattern-content :global(li) {
      margin-bottom: var(--space-2);
      color: var(--color-text-secondary);
    }

    .pattern-content :global(code) {
      background: var(--color-surface);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
      font-family: var(--font-family-mono);
      font-size: 0.9em;
      color: var(--systemColor);
    }

    .pattern-content :global(pre) {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: var(--space-4);
      margin-bottom: var(--space-6);
      overflow-x: auto;
      font-size: 0.875rem;
      line-height: 1.6;
    }

    .pattern-content :global(pre code) {
      background: none;
      padding: 0;
      color: #d4d4d4;
    }

    .pattern-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: var(--space-6);
      font-size: 0.9rem;
    }

    .pattern-content :global(th),
    .pattern-content :global(td) {
      padding: var(--space-3);
      text-align: left;
      border: 1px solid var(--color-border);
    }

    .pattern-content :global(th) {
      background: var(--color-surface);
      font-weight: 600;
      color: var(--color-text);
    }

    .pattern-content :global(td) {
      color: var(--color-text-secondary);
    }

    .pattern-content :global(blockquote) {
      border-left: 3px solid var(--systemColor);
      padding-left: var(--space-4);
      margin: var(--space-6) 0;
      color: var(--color-text-secondary);
      font-style: italic;
    }

    .pattern-content :global(strong) {
      color: var(--color-text);
      font-weight: 600;
    }

    .pattern-footer {
      margin-top: var(--space-12);
      padding-top: var(--space-8);
      border-top: 2px solid var(--color-border);
      text-align: center;
    }

    .back-link {
      display: inline-block;
      padding: var(--space-3) var(--space-6);
      background: var(--color-surface);
      border: 2px solid var(--systemColor);
      color: var(--systemColor);
      text-decoration: none;
      border-radius: 0.5rem;
      font-weight: 600;
      transition: all var(--transition-base);
    }

    .back-link:hover {
      background: var(--systemColor);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(74, 77, 255, 0.2);
    }

    @media (max-width: 768px) {
      .pattern-container {
        padding: var(--space-6) var(--space-3);
      }

      .pattern-title {
        font-size: 1.75rem;
      }

      .pattern-content :global(pre) {
        font-size: 0.75rem;
      }

      .pattern-content :global(table) {
        font-size: 0.8rem;
      }
    }
  </style>

  <div class="pattern-container">
    <!-- Pattern Header -->
    <header class="pattern-header">
      <div class="pattern-breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/commodore-64">Commodore 64</a>
        <span class="separator">/</span>
        <a href="/commodore-64/basic">BASIC</a>
        <span class="separator">/</span>
        <a href="/commodore-64/basic/patterns">Patterns</a>
        <span class="separator">/</span>
        <a href={`/commodore-64/basic/patterns/${categorySlug}`}>{category}</a>
        <span class="separator">/</span>
        <span class="current">{title}</span>
      </div>

      <div class="pattern-meta">
        <span class="meta-badge category-badge">
          {category}
        </span>
        <span class="meta-badge difficulty-badge">
          {difficulty}
        </span>
      </div>

      <h1 class="pattern-title">{title}</h1>

      {lessonsAppearIn && (
        <div class="lessons-reference">
          <strong>Appears in:</strong> {lessonsAppearIn}
        </div>
      )}
    </header>

    <!-- Pattern Content -->
    <article class="pattern-content">
      <slot />
    </article>

    <!-- Pattern Footer -->
    <footer class="pattern-footer">
      <a href="/commodore-64/basic/patterns" class="back-link">
        ← Back to Pattern Library
      </a>
    </footer>
  </div>
</Layout>
