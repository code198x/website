---
/**
 * A sibling project's page in the 198x family: the family opening, a back
 * link and strapline, the project's story as prose, and a closing call to its
 * GitHub organisation. The page supplies the prose; command snippets inside it
 * use `.snippet` with a `.snippet-label` and a `pre`.
 */
import type { AstroComponent } from '@lucide/astro';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import FamilyOpening from '../components/FamilyOpening.astro';
import GithubIcon from '../components/GithubIcon.astro';
import PageFrame from '../components/PageFrame.astro';
import Layout from './Layout.astro';

interface Props {
  /** The project's name, shown in the family opening. */
  name: string;
  title: string;
  description: string;
  /** One line under the back link saying what the project makes. */
  strapline: string;
  /** The project's status, such as "Active" or "New". */
  status: string;
  icon: AstroComponent;
  github: string;
  /** Where the full documentation lives, said in one sentence. */
  note: string;
}

const { name, title, description, strapline, status, icon: Icon, github, note } = Astro.props;
---

<Layout title={title} description={description}>
  <FamilyOpening title={name} />
  <PageFrame class="family-explainer" opening="none">
    <section class="intro">
      <a class="back label" href="/family"><ArrowLeft size={15} /> The 198x family</a>
      <p class="strapline">{strapline}</p>
    </section>

    <div class="prose">
      <slot />
    </div>

    <div class="cta">
      <span class:list={['status label pill', { active: status === 'Active' }]}><Icon size={16} /> {status}</span>
      <a class="cta-link" href={github} target="_blank" rel="noopener">
        <GithubIcon size={16} /> View on GitHub <ArrowRight size={15} />
      </a>
      <p class="cta-note">{note}</p>
    </div>
  </PageFrame>
</Layout>

<style>@layer blocks {
  .family-explainer { overflow-wrap: anywhere; }

  .intro {
    padding: var(--space-10) 0 var(--h-space-8);
    margin-bottom: 36px;
    border-bottom: 1px solid var(--h-line);
  }
  .back {
    display: inline-flex; align-items: center; gap: var(--h-space-1);
    margin-bottom: var(--h-space-6);
    color: var(--ink); text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .strapline {
    max-width: var(--reading-width); margin: 0;
    font: 400 22px/1.6 var(--h-font-ui); color: var(--h-ink-body);
  }

  .prose { max-width: var(--article-width); margin-inline: auto; }
  .prose :global(p) {
    margin: 0 0 var(--h-space-4);
    font: 400 20px/1.7 var(--h-font-ui); color: var(--h-ink-body);
  }
  .prose :global(.lead) {
    margin-bottom: var(--h-space-6);
    font-size: 1.15rem; color: var(--h-ink);
  }
  .prose :global(h2) { font-size: 1.4rem; color: var(--h-ink); margin: var(--h-space-8) 0 var(--h-space-3); }
  .prose :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 0.15em; }
  .prose :global(:not(pre) > code) {
    font-family: var(--h-font-mono); font-size: 0.88em;
    padding: 0.1em 0.3em; border-radius: 0.2em;
    color: var(--h-ink); background: var(--h-ground); border-color: var(--h-line);
  }

  .prose :global(.snippet) { margin: 0 0 var(--h-space-4); }
  .prose :global(.snippet-label) { color: var(--h-ink-muted); margin: 0 0 var(--h-space-2); }
  .prose :global(.snippet pre) {
    margin: 0; padding: var(--h-space-4); overflow-x: auto;
    background: var(--color-code-bg); color: var(--color-code-text); border-radius: 0.25rem;
    font-family: var(--h-font-mono); font-size: 0.82rem; line-height: 1.6;
  }
  .prose :global(.snippet pre:focus-visible) { outline: 2px solid var(--h-spot-ink); outline-offset: 2px; }

  .cta {
    margin-top: var(--space-10); padding-top: var(--h-space-8);
    border-top: 1px solid var(--h-line); text-align: center;
  }
  .status { margin-bottom: var(--h-space-4); color: var(--ink); }
  /* A project in active development reads green; anything else takes the accent. */
  .status.active { color: #166534; }
  .cta-link {
    display: flex; align-items: center; justify-content: center; gap: var(--h-space-2);
    font: 600 0.95rem/1.6 var(--h-font-ui); color: var(--ink); text-decoration: none;
    transition: gap var(--transition-base);
  }
  .cta-link:hover { gap: var(--h-space-3); }
  .cta-note { color: var(--h-ink-muted); font-size: 0.85rem; margin: var(--h-space-3) 0 0; }
}
</style>
