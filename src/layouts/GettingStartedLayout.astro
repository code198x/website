---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, description, system, systemSlug, accentColor = '#4a4dff' } = frontmatter;
---

<Layout title={title} description={description}>
  <article class="getting-started" style={`--accent-color: ${accentColor}`}>
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span class="separator">/</span>
      <a href={`/${systemSlug}`}>{system}</a>
      <span class="separator">/</span>
      <span class="current">Getting Started</span>
    </nav>

    <header class="header">
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
    </header>

    <div class="content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .getting-started {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  /* Breadcrumb */
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--accent-color);
  }

  .breadcrumb .separator {
    margin: 0 var(--space-2);
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--accent-color);
    font-weight: 500;
  }

  /* Header */
  .header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .header h1 {
    font-family: var(--font-family-mono);
    font-size: 2.5rem;
    margin: 0 0 var(--space-3) 0;
  }

  .description {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    margin: 0;
  }

  /* Content */
  .content {
    line-height: 1.7;
  }

  .content :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .content :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .content :global(p) {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .content :global(ul), .content :global(ol) {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content :global(li) {
    margin-bottom: var(--space-2);
  }

  .content :global(a) {
    color: var(--accent-color);
    text-decoration: none;
  }

  .content :global(a:hover) {
    text-decoration: underline;
  }

  /* Code blocks */
  .content :global(pre) {
    margin: var(--space-4) 0;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 0.5rem;
    padding: var(--space-4);
    overflow-x: auto;
  }

  .content :global(pre code) {
    color: #22c55e;
    background: none;
  }

  .content :global(code) {
    font-family: var(--font-family-mono);
    background: var(--color-surface);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  /* Tool cards */
  .content :global(.tool-card) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .content :global(.tool-card h3) {
    margin-top: 0;
    color: var(--accent-color);
  }

  /* Next step CTA */
  .content :global(.next-step) {
    background: linear-gradient(135deg, var(--accent-color) 0%, color-mix(in oklab, var(--accent-color) 70%, #7c70da) 100%);
    border-radius: 0.5rem;
    padding: var(--space-6);
    margin-top: var(--space-8);
    text-align: center;
  }

  .content :global(.next-step h2) {
    color: white;
    border: none;
    margin-top: 0;
    padding-bottom: 0;
  }

  .content :global(.next-step p) {
    color: rgba(255, 255, 255, 0.9);
  }

  .content :global(.next-step a) {
    display: inline-block;
    background: white;
    color: var(--accent-color);
    padding: var(--space-3) var(--space-6);
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    margin-top: var(--space-4);
  }

  .content :global(.next-step a:hover) {
    text-decoration: none;
    opacity: 0.95;
  }
</style>
