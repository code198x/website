---
import EditorialArticleLayout from './EditorialArticleLayout.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { title, description, lede, accent } = entry.data;
const { Content } = await render(entry);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'From the Metal', href: '/from-the-metal' },
  { label: title },
];
---

<EditorialArticleLayout pageTitle={`${title} | From the Metal`} description={description} breadcrumbs={breadcrumbs} series="from-the-metal" title={title} accent={accent} introduction={lede}>
  <Content />

    <div class="signoff" slot="ending">
      <span class="caret">&gt;</span>
      <span class="signoff-text">Every great programmer started with one instruction.</span>
    </div>
</EditorialArticleLayout>

<style>
  @layer legacy {
  .signoff { margin-top: var(--h-space-8); padding-top: var(--h-space-6); border-top: 3px solid var(--h-line); display: flex; align-items: center; gap: 12px; }
  .caret { font-family: var(--h-font-mono); font-size: 14px; color: var(--color-text); }
  .signoff-text { font-family: var(--font-family-read); font-size: 13px; letter-spacing: normal; color: var(--h-ink-muted); font-weight: 400;}
  }
</style>
