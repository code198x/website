---
/**
 * FromTheMetalLayout — the article chrome for a "From the Metal" essay.
 *
 * Mono kicker (per-article accent) → mono H1 → Inter lede → the rendered body →
 * the constant sign-off; site nav + breadcrumbs handle branding and back-nav. Built on
 * theme-aware tokens so the page works in light and dark; the only always-dark
 * element is the CodeFigure (a screen). The per-article accent arrives as an
 * inline --accent var. Print CSS overrides Layout.astro's global print rules so
 * the figures keep their colour on paper.
 */
import Layout from './Layout.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { title, description, lede, kicker, accent } = entry.data;
const { Content } = await render(entry);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'From the Metal', href: '/from-the-metal' },
  { label: title },
];
---

<Layout title={`${title} | From the Metal`} description={description} breadcrumbs={breadcrumbs}>
  <article class="ftm" style={`--accent: ${accent}`}>
    <p class="kicker">// {kicker} //</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>

    <div class="body">
      <Content />
    </div>

    <div class="signoff">
      <span class="caret">&gt;</span>
      <span class="signoff-text">Every great programmer started with one instruction.</span>
    </div>
  </article>
</Layout>

<style>
  .ftm {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-10) clamp(24px, 5vw, 40px) var(--space-16);
    font-family: var(--font-family-sans);
    color: var(--color-text);

    /* Contrast-safe rendering of the per-article accent when used as TEXT:
       darken toward black in light mode, lighten toward white in dark mode,
       so the whole accent palette clears WCAG AA on both backgrounds.
       Decorative uses keep the raw --accent. Mirrors --ink-l/--ink-d. */
    --accent-ink: color-mix(in srgb, var(--accent) 72%, black);
  }
  :global(:root[data-theme="dark"]) .ftm { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .ftm { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  }

  /* Title block */
  .kicker { font-family: var(--font-family-mono); font-size: 12px; font-weight: 600; letter-spacing: 2px; color: var(--accent-ink); margin: 0 0 18px; }
  .ftm h1 { font-family: var(--font-family-mono); font-weight: 700; font-size: clamp(30px, 5.2vw, 44px); line-height: 1.08; letter-spacing: -0.5px; margin: 0 0 22px; text-wrap: balance; color: var(--color-text); }
  .lede { font-size: 20px; line-height: 1.55; color: var(--color-text-secondary); margin: 0 0 40px; text-wrap: pretty; }

  /* Body prose (rendered MDX) */
  .body :global(h2) { font-family: var(--font-family-mono); font-weight: 700; font-size: 22px; letter-spacing: -0.2px; margin: 36px 0 16px; color: var(--color-text); }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(p) { font-size: 17px; line-height: 1.68; margin: 0 0 22px; text-wrap: pretty; }
  .body :global(em) { font-style: italic; color: var(--accent-ink); }
  .body :global(strong) { font-weight: 600; color: var(--color-text); }
  .body :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .body :global(a:hover) { color: var(--color-house-2); }

  /* Inline code chip — theme-aware so it survives dark mode. Scoped to inline
     code only (direct child of prose elements) so it never touches the <code>
     inside a CodeFigure's <pre>, which would otherwise paint a chip background
     per wrapped line. */
  .body :global(:not(pre) > code) {
    font-family: var(--font-family-mono);
    font-size: 0.82em;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    padding: 2px 7px;
    border-radius: 4px;
  }

  /* Closing callout — authored as a blockquote in the MDX */
  .body :global(blockquote) {
    margin: 40px 0 0;
    padding: 26px 28px;
    background: var(--color-surface);
    border: 3px solid var(--color-border-light);
    box-shadow: var(--shadow-chunky);
  }
  .body :global(blockquote p) { font-size: 18px; line-height: 1.6; margin: 0; text-wrap: pretty; }

  /* Sign-off */
  .signoff { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 3px solid var(--color-border); display: flex; align-items: center; gap: 12px; }
  .caret { font-family: var(--font-family-mono); font-size: 14px; color: var(--color-text); }
  .signoff-text { font-family: var(--font-family-mono); font-size: 13px; letter-spacing: 0.5px; color: var(--color-text-secondary); }

  /* Print: override Layout.astro's global white-bg print rules so the article
     prints as designed (paper page, figures keep their colour). */
  @media print {
    .ftm { max-width: none; padding: 0; }
    .ftm h1, .body :global(h2) { break-after: avoid; }
    .body :global(figure), .body :global(pre), .body :global(blockquote) { break-inside: avoid; }
    .body :global(p), .body :global(li) { orphans: 3; widows: 3; }
  }
</style>
