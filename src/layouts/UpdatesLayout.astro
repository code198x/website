---
/**
 * UpdatesLayout — chrome for a single What's New post.
 *
 * Deliberately lighter than FieldNotesLayout: a date, a title, an optional hero
 * screenshot, a short rendered body, and a CTA to the thing that shipped. The
 * long story of building it lives in Field Notes; a post can link to one.
 */
import Layout from './Layout.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { title, summary, accent, href, linkText, heroImage, heroAlt, pubDate } = entry.data;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: "What's New", href: '/updates' },
  { label: title },
];
---

<Layout title={`${title} | What's New`} description={summary} breadcrumbs={breadcrumbs}>
  <article class="upd" style={accent ? `--accent: ${accent}` : ''}>
    <p class="kicker">// WHAT'S NEW //</p>
    <time class="date" datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
    <h1>{title}</h1>

    {heroImage && (
      <figure class="hero">
        <img src={heroImage} alt={heroAlt ?? ''} loading="lazy" />
      </figure>
    )}

    <div class="body">
      <Content />
    </div>

    {href && (
      <p class="cta"><a class="btn btn-primary" href={href}>{linkText} →</a></p>
    )}

    <p class="back"><a href="/updates">← All updates</a></p>
  </article>
</Layout>

<style>
  .upd {
    max-width: 720px; margin: 0 auto;
    padding: var(--space-10) clamp(24px, 5vw, 40px) var(--space-16);
    color: var(--color-text);
    --accent: var(--color-house-2);
    --accent-ink: color-mix(in srgb, var(--accent) 72%, black);
  }
  :global(:root[data-theme="dark"]) .upd { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .upd { --accent-ink: color-mix(in srgb, var(--accent) 62%, white); }
  }

  .kicker { font-family: var(--font-family-mono); font-size: 12px; font-weight: 600; letter-spacing: 2px; color: var(--accent-ink); margin: 0; }
  .date { display: block; font-family: var(--font-family-mono); font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--color-text-secondary); margin: var(--space-3) 0 var(--space-2); }
  .upd h1 { font-family: var(--font-family-script); font-weight: 700; font-size: clamp(34px, 6vw, 52px); line-height: 1.0; margin: 0; text-wrap: balance; color: var(--color-text); }

  .hero { margin: var(--space-8) 0 0; }
  .hero img { display: block; width: 100%; height: auto; border: 3px solid var(--color-text); box-shadow: var(--shadow-chunky); image-rendering: pixelated; background: #000; }

  .body { margin-top: var(--space-8); }
  .body :global(p) { font-size: 17px; line-height: 1.68; margin: 0 0 22px; text-wrap: pretty; }
  .body :global(em) { font-style: italic; color: var(--accent-ink); }
  .body :global(strong) { font-weight: 600; color: var(--color-text); }
  .body :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .body :global(a:hover) { color: var(--color-house-2); }
  .body :global(:not(pre) > code) { font-family: var(--font-family-mono); font-size: 0.82em; background: var(--color-bg-secondary); border: 1px solid var(--color-border-light); padding: 2px 7px; border-radius: 4px; }

  .cta { margin: var(--space-8) 0 0; }
  .back { margin: var(--space-10) 0 0; font-family: var(--font-family-mono); font-size: 13px; }
  .back a { color: var(--accent-ink); text-decoration: none; }
  .back a:hover { text-decoration: underline; }
</style>
