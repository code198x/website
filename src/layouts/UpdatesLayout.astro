---
import EditorialArticleLayout from './EditorialArticleLayout.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { title, summary, accent, href, linkText, heroImage, heroAlt, pubDate } = entry.data;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: "What's New", href: '/updates' },
  { label: title },
];
---

<EditorialArticleLayout pageTitle={`${title} | What's New`} description={summary} breadcrumbs={breadcrumbs} series="updates" title={title} accent={accent}>
    <time slot="metadata" class="date" datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>

    <Fragment slot="hero">{heroImage && (
      <figure class="hero">
        <img src={heroImage} alt={heroAlt ?? ''} loading="lazy" />
      </figure>
    )}</Fragment>

    <Content />

    <Fragment slot="ending">{href && (
      <p class="cta"><a class="btn btn-primary" href={href}>{linkText} →</a></p>
    )}

    <p class="back"><a href="/updates">← All updates</a></p></Fragment>
</EditorialArticleLayout>

<style>@layer blocks {
  .date { display: block; font-family: var(--h-font-ui); font-size: 13px; font-weight: 600; letter-spacing: normal; text-transform: none; color: var(--h-ink-muted); margin: var(--h-space-3) 0 var(--h-space-2); }
  .hero { margin: var(--h-space-8) 0 0; }
  .hero img { display: block; width: 100%; height: auto; border: 3px solid var(--h-ink); image-rendering: pixelated; background: #000; }
  .cta { margin: var(--h-space-8) 0 0; }
  .back { margin: var(--space-10) 0 0; font-family: var(--h-font-ui); font-size: 13px; font-weight: 600; }
  .back a { color: var(--accent-ink); text-decoration: none; }
  .back a:hover { text-decoration: underline; }
}
</style>
