{
    "folders": [
        {
            "name": "🕹️ Code Like It's 198x",
            "path": "."
        },
        {
            "name": "🟤 Commodore 64",
            "path": "./projects/commodore-64"
        },
        {
            "name": "🌈 ZX Spectrum", 
            "path": "./projects/zx-spectrum"
        },
        {
            "name": "🎮 Nintendo Entertainment System",
            "path": "./projects/nintendo-entertainment-system"
        },
        {
            "name": "🟦 Commodore Amiga",
            "path": "./projects/commodore-amiga"
        },
        {
            "name": "📚 Examples",
            "path": "./examples"
        }
    ],
    "settings": {
        // Assembly language configuration
        "files.associations": {
            "*.asm": "asm-intel-x86-generic",
            "*.s": "asm-intel-x86-generic",
            "*.inc": "asm-intel-x86-generic",
            "*.cfg": "ini",
            "*.chr": "binary",
            "*.prg": "binary",
            "*.d64": "binary", 
            "*.tap": "binary",
            "*.tzx": "binary",
            "*.sna": "binary",
            "*.nes": "binary",
            "*.adf": "binary"
        },

        // Editor settings optimized for assembly
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.rulers": [40, 80],
        "editor.wordWrap": "off",
        "editor.fontFamily": "'Fira Code', 'JetBrains Mono', 'Courier New', monospace",
        "editor.fontLigatures": true,
        "editor.fontSize": 14,
        "editor.minimap.enabled": false,

        // Assembly-specific formatting
        "[asm-intel-x86-generic]": {
            "editor.tabSize": 8,
            "editor.insertSpaces": false,
            "editor.wordBasedSuggestions": false,
            "editor.quickSuggestions": {
                "other": false,
                "comments": false,
                "strings": false
            },
            "editor.suggest.showWords": false,
            "editor.semanticHighlighting.enabled": false
        },

        // File nesting for clean project view
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
            "*.asm": "${capture}.prg,${capture}.d64,${capture}.tap,${capture}.lst,${capture}.sym,${capture}.report.json",
            "*.s": "${capture},${capture}.adf,${capture}.lst,${capture}.report.json",
            "Makefile": "docker-compose.yml,Dockerfile*,.dockerignore",
            "README.md": "LICENSE,CONTRIBUTING.md,.gitignore,.editorconfig"
        },

        // Terminal configuration
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.cwd": "${workspaceFolder}",
        "terminal.integrated.fontSize": 13,

        // Search settings
        "search.exclude": {
            "**/build/**": true,
            "**/node_modules/**": true,
            "**/*.prg": true,
            "**/*.d64": true,
            "**/*.tap": true,
            "**/*.tzx": true,
            "**/*.sna": true,
            "**/*.nes": true,
            "**/*.adf": true,
            "**/*.chr": true
        },

        // Git configuration
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "git.autofetch": true,

        // Workbench appearance
        "workbench.colorTheme": "GitHub Dark Default",
        "workbench.iconTheme": "vscode-icons",
        "workbench.startupEditor": "readme",
        "workbench.tree.indent": 20,

        // Breadcrumbs
        "breadcrumbs.enabled": true,
        "breadcrumbs.showFiles": false,

        // Problems panel
        "problems.decorations.enabled": true,

        // Spell checking
        "cSpell.enabled": true,
        "cSpell.words": [
            "ACME", "VASM", "SjASMPlus", "NESASM", "Pasmo", "z80asm",
            "Commodore", "Amiga", "Spectrum", "Nintendo", "VICE", "UAE",
            "KERNAL", "PETSCII", "CHROUT", "BASIC", "Workbench", "Kickstart",
            "assembler", "bitplane", "raster", "sprite", "blitter", "copper",
            "nametable", "charset", "tilemap", "scanline", "framebuffer",
            "PPUCTRL", "PPUMASK", "PPUADDR", "PPUDATA", "PPUSTATUS",
            "OAMADDR", "OAMDATA", "OAMDMA", "vblank", "hblank",
            "DMACONR", "DMACON", "BLTCON", "BLTSIZE", "BLTMOD",
            "autoconfig", "chipset", "Paula", "Agnus", "Denise"
        ],

        // Language-specific settings
        "makefile.configureOnOpen": false,
        
        // Code formatting
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
    },

    "extensions": {
        "recommendations": [
            "13xforever.language-x86-64-assembly",
            "ms-vscode.cpptools",
            "ms-vscode.makefile-tools",
            "ms-vscode.hexeditor",
            "streetsidesoftware.code-spell-checker",
            "eamodio.gitlens",
            "github.github-vscode-theme",
            "vscode-icons-team.vscode-icons",
            "redhat.vscode-yaml",
            "davidanson.vscode-markdownlint"
        ]
    },

    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "🚀 Setup Development Environment",
                "type": "shell",
                "command": "make setup",
                "group": "build",
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                }
            }
        ]
    }
}